# Build storage layout for a Q25 build host.
#
# Adapted from the SableOS canonical storage profile. Everything lives under
# SABLE_BUILD_ROOT; override it to put the tree on a large disk.

export SABLE_BUILD_ROOT="${SABLE_BUILD_ROOT:-$HOME/sable-q25}"
export SABLE_BUILD_MIN_FREE_GIB="${SABLE_BUILD_MIN_FREE_GIB:-300}"

export SABLE_ANDROID_ROOT="${SABLE_ANDROID_ROOT:-$SABLE_BUILD_ROOT/android}"
export SABLE_APPS_OUT="${SABLE_APPS_OUT:-$SABLE_BUILD_ROOT/apps-out}"
export SABLE_EVIDENCE_ROOT="${SABLE_EVIDENCE_ROOT:-$SABLE_BUILD_ROOT/evidence}"
export SABLE_ARTIFACTS_ROOT="${SABLE_ARTIFACTS_ROOT:-$SABLE_BUILD_ROOT/artifacts}"
export SABLE_CCACHE_DIR="${SABLE_CCACHE_DIR:-$SABLE_BUILD_ROOT/ccache}"
