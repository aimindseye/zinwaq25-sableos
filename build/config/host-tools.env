# Host tool locations. Adapted from the SableOS canonical host-tool profile,
# reduced to what a Q25 build needs. Defaults use whatever is on PATH.

export SABLE_REPO_TOOL="${SABLE_REPO_TOOL:-repo}"
export SABLE_ADB="${SABLE_ADB:-adb}"
export SABLE_FASTBOOT="${SABLE_FASTBOOT:-fastboot}"
export SABLE_PYTHON="${SABLE_PYTHON:-python3}"

# Android SDK for building Sable apps with Gradle (scripts/build-apps.sh).
export ANDROID_HOME="${ANDROID_HOME:-$HOME/Android/Sdk}"
export SABLE_JDK="${SABLE_JDK:-${JAVA_HOME:-}}"

# Build jobs: one per core, but no more than the memory allows. The LineageOS
# build's largest steps (metalava, R8) need several GiB each, so 16 jobs on a
# 61 GiB host were killed for lack of memory (2026-11-12); 6 jobs passed. Each
# job gets SABLE_GIB_PER_JOB (default 9) GiB. Set SABLE_JOBS to override.
sable_default_jobs() {
    local cores mem_kib per_job by_mem
    cores="$(nproc 2>/dev/null || echo 8)"
    mem_kib="$(awk '/MemTotal/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)"
    per_job="${SABLE_GIB_PER_JOB:-9}"
    by_mem=$(( mem_kib / 1048576 / per_job ))
    (( by_mem >= 2 )) || by_mem=2
    (( by_mem < cores )) && echo "$by_mem" || echo "$cores"
}
export SABLE_JOBS="${SABLE_JOBS:-$(sable_default_jobs)}"
