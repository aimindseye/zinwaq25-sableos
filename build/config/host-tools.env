# Host tool locations. Adapted from the SableOS canonical host-tool profile,
# reduced to what a Q25 build needs. Defaults use whatever is on PATH.

export SABLE_REPO_TOOL="${SABLE_REPO_TOOL:-repo}"
export SABLE_ADB="${SABLE_ADB:-adb}"
export SABLE_FASTBOOT="${SABLE_FASTBOOT:-fastboot}"
export SABLE_PYTHON="${SABLE_PYTHON:-python3}"

# Android SDK for building Sable apps with Gradle (scripts/build-apps.sh).
export ANDROID_HOME="${ANDROID_HOME:-$HOME/Android/Sdk}"
export SABLE_JDK="${SABLE_JDK:-${JAVA_HOME:-}}"

export SABLE_JOBS="${SABLE_JOBS:-$(nproc 2>/dev/null || echo 8)}"
