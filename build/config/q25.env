# Zinwa Q25 source pins.
#
# Every upstream the Q25 build depends on is pinned here. Change a pin only in a
# reviewed commit, and record why in the commit message.

export SABLE_Q25_DEVICE=Q25
export SABLE_Q25_VENDOR=xelex
export SABLE_Q25_PROFILE_ID=zinwa-q25

# OS base: LineageOS manifest branch. The exact project revisions used for a
# build are captured by `repo manifest -r` into the evidence directory.
export SABLE_Q25_LINEAGE_MANIFEST_URL="${SABLE_Q25_LINEAGE_MANIFEST_URL:-https://github.com/LineageOS/android.git}"
export SABLE_Q25_LINEAGE_BRANCH="${SABLE_Q25_LINEAGE_BRANCH:-lineage-23.2}"

# Device projects (also pinned in manifests/local_manifests/sable_q25.xml;
# tests/run.sh checks the two agree).
export SABLE_Q25_DEVICE_TREE_REV=1f4e295b5b972bd5e5ea0ec01f8a87154973b464
export SABLE_Q25_KERNEL_REV=2a873a3511ee0eeead1442e60145093192a4535d
export SABLE_Q25_HARDWARE_MEDIATEK_REV=68f9be72a32bca66e7c63d69e9739b18f13c8b48
export SABLE_Q25_SEPOLICY_VNDR_REV=b1c50f4903504168e7bd0e32b44c72d139d38d09
export SABLE_Q25_VENDOR_BLOBS_REV=b8c2c8f90a211dbe16d14b198743e4ba8ea000e4

# Lunch target. The release config (bp4a for lineage-23.2) is read from
# vendor/lineage/vars/aosp_target_release after sync; set
# SABLE_Q25_TARGET_RELEASE to override.
export SABLE_Q25_LUNCH_PRODUCT=lineage_Q25
export SABLE_Q25_BUILD_VARIANT="${SABLE_Q25_BUILD_VARIANT:-userdebug}"

# Sable source used by scripts/import-sable-sources.sh.
export SABLE_Q25_SABLEOS_COMMIT=c538fc0e57e4592e11b27c93870b79ee48f7fbfc
# aimindseye/titan2-temp: newer product source (Keyboard provisioning P2,
# Reader v2 P5A-P5F, P1/P3/P4 reference sources) layered over sableos.
export SABLE_Q25_TITAN2_TEMP_COMMIT=7570470d1c5a27ef94ed4751f5ccb91af41761fe
