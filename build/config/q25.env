# Zinwa Q25 source pins.
#
# Every upstream the Q25 build depends on is pinned here. Change a pin only in a
# reviewed commit, and record why in the commit message.

export SABLE_Q25_DEVICE=Q25
export SABLE_Q25_VENDOR=xelex
export SABLE_Q25_PROFILE_ID=zinwa-q25

# OS base: LineageOS manifest branch. The exact project revisions used for a
# build are captured by `repo manifest -r` into the evidence directory.
export SABLE_Q25_LINEAGE_MANIFEST_URL="${SABLE_Q25_LINEAGE_MANIFEST_URL:-https://github.com/LineageOS/android.git}"
export SABLE_Q25_LINEAGE_BRANCH="${SABLE_Q25_LINEAGE_BRANCH:-lineage-24.0}"

# Device projects (also pinned in manifests/local_manifests/sable_q25.xml;
# tests/run.sh checks the two agree).
# lineage-24.0 heads on 2026-11-04 (SableOS 2.0 base, owner decision 2026-11-04). 24.0 splits
# the Q25 tree: shared MT6789 parts (sepolicy, fstab, recovery) moved to device/xelex/mt6789-common
# with its own vendor blobs.
export SABLE_Q25_DEVICE_TREE_REV=30bd335b7d384891f3a999b62230b1fa48ddd4df
export SABLE_Q25_DEVICE_COMMON_REV=fd308035cdbf58f5de46515fb0a0e97fe5453980
export SABLE_Q25_KERNEL_REV=2a873a3511ee0eeead1442e60145093192a4535d
export SABLE_Q25_HARDWARE_MEDIATEK_REV=32bd412433ef0d58c3484769d9789987407627fc
export SABLE_Q25_SEPOLICY_VNDR_REV=d76ed9b3f512decbb68f6641db86230aa595996e
export SABLE_Q25_VENDOR_BLOBS_REV=48eb52e55ff5398013c97d2fcbacce1a50584835
export SABLE_Q25_VENDOR_COMMON_BLOBS_REV=ec1f8b0d7665f0640530cded862f62aaf1f66d7b

# Lunch target. The release config (cp2a for lineage-24.0) is read from
# vendor/lineage/vars/aosp_target_release after sync; set
# SABLE_Q25_TARGET_RELEASE to override.
export SABLE_Q25_LUNCH_PRODUCT=lineage_Q25
# Build type: userdebug (default; debuggable, adb root works) or user (not debuggable).
# Choose per build with --variant on build/sable.sh.
export SABLE_Q25_BUILD_VARIANT="${SABLE_Q25_BUILD_VARIANT:-userdebug}"

# The SableOS release number this build is: names the files, the GitHub release and the
# tag. Choose per build with --version on build/sable.sh.
export SABLE_VERSION="${SABLE_VERSION:-2.0}"

# Optional 50 MP rear camera (product/q25/camera-50mp, from bellhopsw/q25-50mp
# at the commit below). Off until it has passed on a Q25: set YES to stage it.
export SABLE_Q25_CAMERA_50MP="${SABLE_Q25_CAMERA_50MP:-NO}"
export SABLE_Q25_CAMERA_50MP_SOURCE_COMMIT=caf855d5adc9578f3231f73947b6872b8786db8a

# microG (GmsCore, Companion) built into the image, Q4 and later (product/q25/microg,
# pinned in its prebuilts.tsv; docs/MICROG.md). Off by default from SableOS 2.0 (owner
# decision 2026-11-04: no Google by default, microG as a documented add-on installed
# with scripts/install-microg-addon.sh). Set YES to build it in as privileged apps;
# fetch the APKs first with NETWORK_FETCH_AUTHORIZED=YES bash scripts/fetch-microg.sh.
export SABLE_Q25_MICROG="${SABLE_Q25_MICROG:-NO}"

# Sable source used by scripts/import-sable-sources.sh.
export SABLE_Q25_SABLEOS_COMMIT=c538fc0e57e4592e11b27c93870b79ee48f7fbfc
# aimindseye/titan2-temp: newer product source (Keyboard provisioning P2,
# Reader v2 P5A-P5F, P1/P3/P4 reference sources) layered over sableos.
export SABLE_Q25_TITAN2_TEMP_COMMIT=7570470d1c5a27ef94ed4751f5ccb91af41761fe
