+internal class MediaBarAction(
+    val icon: ImageVector,
+    val label: String,
+    val onClick: () -> Unit,
+    val enabled: Boolean = true,
+    val active: Boolean = false,
+    /** When set, the button opens this menu instead of [onClick]. */
