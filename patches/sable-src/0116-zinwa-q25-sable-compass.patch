+package org.sableos.titan2.compass
+
+import android.app.Application
+import org.sableos.titan2.compass.core.CompassText
+import org.sableos.titan2.theme.bindTo
+
+/** Binds [CompassText] to the app's string resources once per process, so the phone's language is used. */
+class CompassApplication : Application() {
+    override fun onCreate() {
+        super.onCreate()
+        CompassText.t.bindTo(this)
+    }
+}
diff --git a/sable-src/apps/titan2/platform/compass/src/main/java/org/sableos/titan2/compass/android/CompassActivity.kt b/sable-src/apps/titan2/platform/compass/src/main/java/org/sableos/titan2/compass/android/CompassActivity.kt
new file mode 100644
index 0000000..2b07012
--- /dev/null
+++ b/sable-src/apps/titan2/platform/compass/src/main/java/org/sableos/titan2/compass/android/CompassActivity.kt
@@ -0,0 +1,333 @@
+package org.sableos.titan2.compass.android
+
+import android.Manifest
+import android.app.Activity
+import android.content.Context
+import android.content.pm.PackageManager
+import android.graphics.Typeface
+import android.hardware.GeomagneticField
+import android.hardware.Sensor
+import android.hardware.SensorEvent
+import android.hardware.SensorEventListener
+import android.hardware.SensorManager
+import android.location.Location
+import android.location.LocationManager
+import android.os.Bundle
+import android.view.Gravity
+import android.view.KeyEvent
+import android.view.View
+import android.view.WindowManager
+import android.widget.FrameLayout
+import android.widget.LinearLayout
+import android.widget.TextView
+import android.window.OnBackInvokedDispatcher
+import org.sableos.titan2.compass.core.Accuracy
+import org.sableos.titan2.compass.core.CompassText.t
+import org.sableos.titan2.compass.core.Heading
+import org.sableos.titan2.theme.SablePalette
+
+/**
+ * Sable Compass: the heading in degrees and words over a card that tilts with the phone. T turns true north on
+ * or off (it asks for a rough location the first time), C opens the calibration guide, H holds the reading,
+ * Back leaves. The screen stays on while it is open.
+ */
+class CompassActivity :
+    Activity(),
+    SensorEventListener {
+    private lateinit var palette: SablePalette
+    private lateinit var sensors: SensorManager
+    private lateinit var dial: DialView
+    private lateinit var number: TextView
+    private lateinit var word: TextView
+    private lateinit var mode: TextView
+    private lateinit var status: TextView
+    private lateinit var calibration: View
+    private lateinit var calibrationStatus: TextView
+
+    private val rotation = FloatArray(MATRIX)
+    private var gravity: FloatArray? = null
+    private var field: FloatArray? = null
+    private var shown: Double? = null
+    private var accuracy = Accuracy.UNRELIABLE
+    private var held = false
+    private var trueNorth = false
+    private var declination: Double? = null
+    private var locationDenied = false
+    private var usesVector = false
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        palette = SablePalette.read(this).also { it.applyTo(this) }
+        sensors = getSystemService(SensorManager::class.java)
+        trueNorth = prefs().getBoolean(KEY_TRUE_NORTH, false)
+        window.addFlags(WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON)
+        val pad = dp(PAD)
+        val body =
+            LinearLayout(this).apply {
+                orientation = LinearLayout.VERTICAL
+                setPadding(pad, pad, pad, pad)
+                setBackgroundColor(palette.window)
+            }
+        number = text(TITLE_SP, palette.text, bold = true).also(body::addView)
+        word = text(BODY_SP, palette.text).also(body::addView)
+        mode = text(SMALL_SP, palette.muted).also(body::addView)
+        dial = DialView(this, palette)
+        body.addView(dial, LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, 0, 1f))
+        status = text(SMALL_SP, palette.muted).also(body::addView)
+        body.addView(text(SMALL_SP, palette.muted).apply { text = t("hint") })
+        calibration = calibrationScreen()
+        setContentView(
+            FrameLayout(this).apply {
+                addView(body)
+                addView(calibration)
+            }
+        )
+        onBackInvokedDispatcher.registerOnBackInvokedCallback(
+            OnBackInvokedDispatcher.PRIORITY_DEFAULT
+        ) {
+            back()
+        }
+        if (trueNorth) locate()
+        show()
+    }
+
+    private fun calibrationScreen(): View {
+        val pad = dp(PAD)
+        val box =
+            LinearLayout(this).apply {
+                orientation = LinearLayout.VERTICAL
+                setPadding(pad, pad, pad, pad)
+                setBackgroundColor(palette.window)
+                visibility = View.GONE
+            }
+        box.addView(text(HEADING_SP, palette.text, bold = true).apply { text = t("calibrate") })
+        box.addView(text(BODY_SP, palette.text).apply { text = t("calibrate_body") })
+        box.addView(
+            Figure8View(this, palette),
+            LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, 0, 1f)
+        )
+        calibrationStatus = text(BODY_SP, palette.text, bold = true).also(box::addView)
+        box.addView(text(SMALL_SP, palette.muted).apply { text = t("calibrate_hint") })
+        return box
+    }
+
+    override fun onResume() {
+        super.onResume()
+        val vector = sensors.getDefaultSensor(Sensor.TYPE_ROTATION_VECTOR)
+        val magnet = sensors.getDefaultSensor(Sensor.TYPE_MAGNETIC_FIELD)
+        if (magnet == null) {
+            status.text = t("no_sensor")
+            return
+        }
+        // The magnetometer is always listened to, for its accuracy; the fused rotation vector gives the
+        // steadier heading where the phone has one, otherwise gravity and the field are combined here.
+        sensors.registerListener(this, magnet, SensorManager.SENSOR_DELAY_UI)
+        if (vector != null) {
+            sensors.registerListener(this, vector, SensorManager.SENSOR_DELAY_UI)
+        } else {
+            sensors.getDefaultSensor(Sensor.TYPE_ACCELEROMETER)?.let {
+                sensors.registerListener(this, it, SensorManager.SENSOR_DELAY_UI)
+            }
+        }
+        usesVector = vector != null
+    }
+
+    override fun onPause() {
+        sensors.unregisterListener(this)
+        super.onPause()
+    }
+
+    override fun onSensorChanged(event: SensorEvent) {
+        when (event.sensor.type) {
+            Sensor.TYPE_ROTATION_VECTOR -> SensorManager.getRotationMatrixFromVector(
+                rotation,
+                event.values
+            )
+
+            Sensor.TYPE_ACCELEROMETER -> {
+                gravity = event.values.clone()
+                if (!fromParts()) return
+            }
+
+            Sensor.TYPE_MAGNETIC_FIELD -> {
+                setAccuracy(event.accuracy)
+                field = event.values.clone()
+                if (usesVector || !fromParts()) return
+            }
+
+            else -> return
+        }
+        if (held) return
+        val facing = Heading.facing(rotation)
+        dial.squash = Heading.squash(Heading.tilt(rotation))
+        if (facing == null) {
+            status.text = t("flat_or_upright")
+            return
+        }
+        shown = Heading.smooth(shown, facing, SMOOTHING)
+        show()
+    }
+
+    /** Without a rotation vector: the rotation from gravity and the magnetic field, when both are in. */
+    private fun fromParts(): Boolean {
+        val g = gravity ?: return false
+        val m = field ?: return false
+        return SensorManager.getRotationMatrix(rotation, null, g, m)
+    }
+
+    override fun onAccuracyChanged(sensor: Sensor, status: Int) {
+        if (sensor.type == Sensor.TYPE_MAGNETIC_FIELD) setAccuracy(status)
+    }
+
+    private fun setAccuracy(status: Int) {
+        val next = Accuracy.of(status)
+        if (next == accuracy) return
+        accuracy = next
+        show()
+    }
+
+    private fun show() {
+        val magnetic = shown
+        val trueOffset = declination.takeIf { trueNorth }
+        val heading = magnetic?.let {
+            if (trueOffset !=
+                null
+            ) {
+                Heading.toTrue(it, trueOffset)
+            } else {
+                it
+            }
+        }
+        number.text = heading?.let { t("degrees", Heading.degrees(it)) } ?: "--"
+        number.setTextColor(if (accuracy.needsCalibration) palette.warn else palette.text)
+        word.text = heading?.let { t(Heading.word(it)) }.orEmpty()
+        mode.text =
+            (if (trueOffset != null) t("true_north") else t("magnetic")) + " · " + t(accuracy.key)
+        dial.trueNorth = trueOffset != null
+        if (heading != null) dial.heading = heading
+        status.text =
+            when {
+                held -> t("held")
+                trueNorth && locationDenied -> t("true_denied")
+                trueNorth && trueOffset == null -> t("true_waiting")
+                else -> ""
+            }
+        calibrationStatus.text =
+            if (accuracy == Accuracy.HIGH) t("calibrate_done") else t(accuracy.key)
+    }
+
+    override fun onKeyDown(keyCode: Int, event: KeyEvent): Boolean {
+        when (keyCode) {
+            KeyEvent.KEYCODE_T -> toggleTrueNorth()
+
+            KeyEvent.KEYCODE_C ->
+                calibration.visibility =
+                    if (calibration.visibility == View.VISIBLE) View.GONE else View.VISIBLE
+
+            KeyEvent.KEYCODE_H -> {
+                held = !held
+                show()
+            }
+
+            KeyEvent.KEYCODE_ESCAPE -> back()
+
+            else -> return super.onKeyDown(keyCode, event)
+        }
+        return true
+    }
+
+    private fun back() {
+        if (calibration.visibility == View.VISIBLE) calibration.visibility = View.GONE else finish()
+    }
+
+    private fun toggleTrueNorth() {
+        trueNorth = !trueNorth
+        prefs().edit().putBoolean(KEY_TRUE_NORTH, trueNorth).apply()
+        if (trueNorth) locate()
+        show()
+    }
+
+    /** A rough location, only to work out the declination on the phone. Asked for the first time it is needed. */
+    private fun locate() {
+        if (checkSelfPermission(Manifest.permission.ACCESS_COARSE_LOCATION) !=
+            PackageManager.PERMISSION_GRANTED
+        ) {
+            requestPermissions(
+                arrayOf(Manifest.permission.ACCESS_COARSE_LOCATION),
+                REQUEST_LOCATION
+            )
+            return
+        }
+        locationDenied = false
+        val manager = getSystemService(LocationManager::class.java) ?: return
+        try {
+            val known =
+                manager.getProviders(true)
+                    .mapNotNull { manager.getLastKnownLocation(it) }
+                    .maxByOrNull { it.time }
+            if (known != null) {
+                useLocation(known)
+                return
+            }
+            val provider =
+                listOf(
+                    LocationManager.FUSED_PROVIDER,
+                    LocationManager.NETWORK_PROVIDER,
+                    LocationManager.GPS_PROVIDER
+                )
+                    .firstOrNull { manager.isProviderEnabled(it) } ?: return
+            manager.getCurrentLocation(provider, null, mainExecutor) { it?.let(::useLocation) }
+        } catch (_: SecurityException) {
+            locationDenied = true
+        }
+    }
+
+    private fun useLocation(location: Location) {
+        declination =
+            GeomagneticField(
+                location.latitude.toFloat(),
+                location.longitude.toFloat(),
+                location.altitude.toFloat(),
+                System.currentTimeMillis()
+            ).declination.toDouble()
+        show()
+    }
+
+    override fun onRequestPermissionsResult(
+        requestCode: Int,
+        permissions: Array<String>,
+        results: IntArray
+    ) {
+        if (requestCode != REQUEST_LOCATION) return
+        if (results.firstOrNull() == PackageManager.PERMISSION_GRANTED) {
+            locate()
+        } else {
+            locationDenied = true
+            show()
+        }
+    }
+
+    private fun prefs() = getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+
+    private fun dp(value: Int) = (value * resources.displayMetrics.density).toInt()
+
+    private fun text(sp: Float, color: Int, bold: Boolean = false) = TextView(this).apply {
+        textSize = sp
+        setTextColor(color)
+        gravity = Gravity.CENTER_HORIZONTAL
+        if (bold) typeface = Typeface.DEFAULT_BOLD
+    }
+
+    private companion object {
+        const val MATRIX = 9
+        const val SMOOTHING = 0.2
+        const val REQUEST_LOCATION = 1
+        const val PREFS = "compass"
+        const val KEY_TRUE_NORTH = "true_north"
+        const val PAD = 12
+        const val TITLE_SP = 40f
+        const val HEADING_SP = 20f
+        const val BODY_SP = 16f
+        const val SMALL_SP = 12f
+    }
+}
diff --git a/sable-src/apps/titan2/platform/compass/src/main/java/org/sableos/titan2/compass/android/DialView.kt b/sable-src/apps/titan2/platform/compass/src/main/java/org/sableos/titan2/compass/android/DialView.kt
new file mode 100644
index 0000000..58277f9
--- /dev/null
+++ b/sable-src/apps/titan2/platform/compass/src/main/java/org/sableos/titan2/compass/android/DialView.kt
@@ -0,0 +1,162 @@
+package org.sableos.titan2.compass.android
+
+import android.content.Context
+import android.graphics.Canvas
+import android.graphics.Paint
+import android.graphics.Path
+import android.graphics.RectF
+import android.graphics.Typeface
+import android.view.View
+import kotlin.math.min
+import kotlin.math.sqrt
+import org.sableos.titan2.compass.core.CompassText.t
+import org.sableos.titan2.compass.core.Heading
+import org.sableos.titan2.theme.SablePalette
+
+/**
+ * The compass card: a disc that stays fixed to the world while the phone turns, with the direction faced
+ * under the mark at the top. Tilting the phone leans the disc, so held upright it is seen nearly edge-on with
+ * its rim showing, like a card in a liquid compass.
+ */
+class DialView(context: Context, private val palette: SablePalette) : View(context) {
+    private val density = resources.displayMetrics.density
+    private val fill = Paint(Paint.ANTI_ALIAS_FLAG).apply { style = Paint.Style.FILL }
+    private val line = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+        style = Paint.Style.STROKE
+        strokeCap = Paint.Cap.ROUND
+    }
+    private val label = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+        textAlign = Paint.Align.CENTER
+        typeface = Typeface.DEFAULT_BOLD
+    }
+    private val oval = RectF()
+    private val mark = Path()
+
+    /** Degrees clockwise from north that the user faces; the card turns the other way. */
+    var heading = 0.0
+        set(value) {
+            field = value
+            invalidate()
+        }
+
+    /** Height against width, from [Heading.squash]. */
+    var squash = 1.0
+        set(value) {
+            field = value
+            invalidate()
+        }
+
+    /** True north on: the north letter becomes the true-north mark. */
+    var trueNorth = false
+        set(value) {
+            field = value
+            invalidate()
+        }
+
+    override fun onDraw(canvas: Canvas) {
+        val cx = width / 2f
+        val cy = height / 2f
+        val r = min(width, height) / 2f * FACE
+        if (r <= 0f) return
+        val sq = squash.toFloat()
+        rim(canvas, cx, cy, r, sq)
+        canvas.save()
+        canvas.translate(cx, cy)
+        canvas.scale(1f, sq)
+        fill.color = palette.surface
+        canvas.drawCircle(0f, 0f, r, fill)
+        line.color = palette.muted
+        line.strokeWidth = density
+        canvas.drawCircle(0f, 0f, r, line)
+        canvas.rotate(-heading.toFloat())
+        ticks(canvas, r)
+        labels(canvas, r)
+        canvas.restore()
+        lubber(canvas, cx, cy - r * sq, r)
+    }
+
+    /** The disc's edge below its face, deeper the more it leans. */
+    private fun rim(canvas: Canvas, cx: Float, cy: Float, r: Float, sq: Float) {
+        val depth = r * RIM * sqrt(1f - sq * sq)
+        if (depth < 1f) return
+        fill.color = palette.focus
+        oval.set(cx - r, cy - r * sq + depth, cx + r, cy + r * sq + depth)
+        canvas.drawOval(oval, fill)
+        canvas.drawRect(cx - r, cy, cx + r, cy + depth, fill)
+    }
+
+    private fun ticks(canvas: Canvas, r: Float) {
+        for (deg in 0 until FULL step STEP) {
+            val major = deg % MAJOR == 0
+            val mid = deg % MID == 0
+            val len = r * if (major) {
+                LONG
+            } else if (mid) {
+                MEDIUM
+            } else {
+                SHORT
+            }
+            line.color = if (major) palette.text else palette.muted
+            line.strokeWidth = density * if (major) 2f else 1f
+            canvas.save()
+            canvas.rotate(deg.toFloat())
+            canvas.drawLine(0f, -r * INSET, 0f, -r * INSET + len, line)
+            canvas.restore()
+        }
+    }
+
+    private fun labels(canvas: Canvas, r: Float) {
+        for (deg in 0 until FULL step MAJOR) {
+            val cardinal = deg % QUARTER == 0
+            val text =
+                when (deg) {
+                    0 -> if (trueNorth) t("true_mark") else t("dial_n")
+                    QUARTER -> t("dial_e")
+                    2 * QUARTER -> t("dial_s")
+                    3 * QUARTER -> t("dial_w")
+                    else -> deg.toString()
+                }
+            label.textSize = r * if (cardinal) CARDINAL_TEXT else NUMBER_TEXT
+            label.color =
+                when {
+                    deg == 0 -> palette.danger
+                    cardinal -> palette.text
+                    else -> palette.muted
+                }
+            canvas.save()
+            canvas.rotate(deg.toFloat())
+            canvas.drawText(text, 0f, -r * LABEL_AT + label.textSize / 2, label)
+            canvas.restore()
+        }
+    }
+
+    /** The fixed mark at the top of the card that the heading is read against. */
+    private fun lubber(canvas: Canvas, x: Float, top: Float, r: Float) {
+        val w = r * MARK
+        mark.reset()
+        mark.moveTo(x - w, top - w * 2)
+        mark.lineTo(x + w, top - w * 2)
+        mark.lineTo(x, top + w / 2)
+        mark.close()
+        fill.color = palette.accent
+        canvas.drawPath(mark, fill)
+    }
+
+    private companion object {
+        const val FACE = 0.86f
+        const val RIM = 0.12f
+        const val FULL = 360
+        const val STEP = 5
+        const val MID = 10
+        const val MAJOR = 30
+        const val QUARTER = 90
+        const val INSET = 0.98f
+        const val LONG = 0.14f
+        const val MEDIUM = 0.09f
+        const val SHORT = 0.05f
+        const val LABEL_AT = 0.68f
+        const val CARDINAL_TEXT = 0.2f
+        const val NUMBER_TEXT = 0.11f
+        const val MARK = 0.06f
+    }
+}
diff --git a/sable-src/apps/titan2/platform/compass/src/main/java/org/sableos/titan2/compass/android/Figure8View.kt b/sable-src/apps/titan2/platform/compass/src/main/java/org/sableos/titan2/compass/android/Figure8View.kt
