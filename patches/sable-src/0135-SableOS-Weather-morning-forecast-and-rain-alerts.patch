index 0000000..6d3ad55
--- /dev/null
+++ b/sable-src/apps/r8/android/weather/src/main/java/org/sableos/weather/WeatherAlerts.kt
@@ -0,0 +1,117 @@
+package org.sableos.weather
+
+import org.sableos.weather.WeatherText.t
+import kotlin.math.roundToInt
+
+/** The two opt-in alerts, both off until turned on in Sable Weather. */
+internal data class AlertSettings(
+    val morning: Boolean = false,
+    val rain: Boolean = false,
+) {
+    val any: Boolean get() = morning || rain
+}
+
+/** What was last posted, so a forecast is sent once a day and a rain alert once per spell. */
+internal data class AlertMemory(
+    val morningDate: String? = null,
+    val rainAtEpochSeconds: Long = 0L,
+)
+
+/** A notification to post: a title and one line, both already in the phone's language. */
+internal sealed interface WeatherAlert {
+    val title: String
+    val text: String
+
+    data class Morning(
+        override val title: String,
+        override val text: String,
+        val date: String,
+    ) : WeatherAlert
+
+    data class RainSoon(
+        override val title: String,
+        override val text: String,
+    ) : WeatherAlert
+}
+
+/**
+ * Decides, after a background refresh, which alerts are due. Pure: the caller passes the phone's local date
+ * (yyyy-MM-dd) and hour, and the clock.
+ */
+internal object WeatherAlerts {
+    /** The morning forecast goes out on the first refresh in this window (the refresh runs every 3 hours). */
+    const val MORNING_FROM_HOUR = 6
+    const val MORNING_UNTIL_HOUR = 11
+
+    /** An hour this likely to be wet, within the next [RAIN_LOOKAHEAD_HOURS], raises a rain alert. */
+    const val RAIN_CHANCE = 60
+    const val RAIN_LOOKAHEAD_HOURS = 3
+
+    /** After a rain alert, another waits this long, so one wet afternoon is one alert. */
+    const val RAIN_QUIET_SECONDS = 6L * 60 * 60
+
+    fun due(
+        settings: AlertSettings,
+        memory: AlertMemory,
+        snapshot: WeatherSnapshot?,
+        localDate: String,
+        localHour: Int,
+        nowEpochSeconds: Long,
+    ): List<WeatherAlert> {
+        if (snapshot == null || snapshot.availability != WeatherAvailability.Live) return emptyList()
+        return listOfNotNull(
+            morning(snapshot, localDate, localHour).takeIf { settings.morning && memory.morningDate != localDate },
+            rainSoon(snapshot).takeIf {
+                settings.rain && nowEpochSeconds - memory.rainAtEpochSeconds >= RAIN_QUIET_SECONDS
+            },
+        )
+    }
+
+    fun morning(
+        snapshot: WeatherSnapshot,
+        localDate: String,
+        localHour: Int,
+    ): WeatherAlert.Morning? {
+        if (localHour !in MORNING_FROM_HOUR until MORNING_UNTIL_HOUR) return null
+        val today = snapshot.daily.firstOrNull { it.date == localDate } ?: return null
+        return WeatherAlert.Morning(
+            title = t("alert_today_in").format(snapshot.location.name),
+            text =
+                t("alert_today_line").format(
+                    conditionLabel(today.condition),
+                    today.high.roundToInt(),
+                    today.low.roundToInt(),
+                    today.precipitationProbability,
+                ),
+            date = localDate,
+        )
+    }
+
+    /** The first wet hour coming up, unless it is raining already (then the phone owner knows). */
+    fun rainSoon(snapshot: WeatherSnapshot): WeatherAlert.RainSoon? {
+        if (snapshot.current.condition in WET) return null
+        val hour =
+            snapshot.hourly.take(RAIN_LOOKAHEAD_HOURS).firstOrNull {
+                it.condition in WET || it.precipitationProbability >= RAIN_CHANCE
+            } ?: return null
+        return WeatherAlert.RainSoon(
+            title = t("alert_rain_soon_in").format(snapshot.location.name),
+            text = t("alert_rain_line").format(hour.time.substringAfter('T', hour.time), hour.precipitationProbability),
+        )
+    }
+
+    private val WET = setOf(WeatherCondition.Rain, WeatherCondition.Storm, WeatherCondition.Snow)
+}
+
+/** A condition in words, as the app and its alerts show it. */
+internal fun conditionLabel(condition: WeatherCondition): String =
+    when (condition) {
+        WeatherCondition.Clear -> "clear"
+        WeatherCondition.PartlyCloudy -> t("partly_cloudy")
+        WeatherCondition.Cloudy -> "cloudy"
+        WeatherCondition.Fog -> "fog"
+        WeatherCondition.Rain -> "rain"
+        WeatherCondition.Snow -> "snow"
+        WeatherCondition.Storm -> "storms"
+        WeatherCondition.Unknown -> t("conditions_unavailable")
+    }
diff --git a/sable-src/apps/r8/android/weather/src/main/java/org/sableos/weather/WeatherNotifier.kt b/sable-src/apps/r8/android/weather/src/main/java/org/sableos/weather/WeatherNotifier.kt
new file mode 100644
index 0000000..5d647a5
--- /dev/null
+++ b/sable-src/apps/r8/android/weather/src/main/java/org/sableos/weather/WeatherNotifier.kt
@@ -0,0 +1,130 @@
+package org.sableos.weather
+
+import android.Manifest
+import android.annotation.SuppressLint
+import android.app.Notification
+import android.app.NotificationChannel
+import android.app.NotificationManager
+import android.app.PendingIntent
+import android.content.Context
+import android.content.Intent
+import android.content.SharedPreferences
+import android.content.pm.PackageManager
+import android.os.Build
+import org.sableos.weather.WeatherText.t
+import java.time.LocalDateTime
+
+/** The alert switches and what was last posted, in Weather's private preferences. */
+internal class AlertStore(
+    private val preferences: SharedPreferences,
+) {
+    var settings: AlertSettings
+        get() = AlertSettings(preferences.getBoolean(KEY_MORNING, false), preferences.getBoolean(KEY_RAIN, false))
+        set(value) {
+            preferences
+                .edit()
+                .putBoolean(KEY_MORNING, value.morning)
+                .putBoolean(KEY_RAIN, value.rain)
+                .apply()
+        }
+
+    var memory: AlertMemory
+        get() = AlertMemory(preferences.getString(KEY_MORNING_DATE, null), preferences.getLong(KEY_RAIN_AT, 0L))
+        set(value) {
+            preferences
+                .edit()
+                .putString(KEY_MORNING_DATE, value.morningDate)
+                .putLong(KEY_RAIN_AT, value.rainAtEpochSeconds)
+                .apply()
+        }
+
+    private companion object {
+        const val KEY_MORNING = "alert_morning"
+        const val KEY_RAIN = "alert_rain"
+        const val KEY_MORNING_DATE = "alert_morning_date"
+        const val KEY_RAIN_AT = "alert_rain_at"
+    }
+}
+
+/**
+ * Posts the opt-in weather alerts after a background refresh. Each one opens Sable Weather. Nothing is posted
+ * while both switches are off or notifications are not allowed.
+ */
+internal object WeatherNotifier {
+    private const val CHANNEL_MORNING = "morning_forecast"
+    private const val CHANNEL_RAIN = "rain_alerts"
+    private const val ID_MORNING = 1
+    private const val ID_RAIN = 2
+
+    fun canPost(context: Context): Boolean {
+        val granted =
+            Build.VERSION.SDK_INT < Build.VERSION_CODES.TIRAMISU ||
+                context.checkSelfPermission(Manifest.permission.POST_NOTIFICATIONS) == PackageManager.PERMISSION_GRANTED
+        return granted && context.getSystemService(NotificationManager::class.java)?.areNotificationsEnabled() == true
+    }
+
+    // canPost() checks POST_NOTIFICATIONS first; lint only sees a check made in the same function.
+    @SuppressLint("MissingPermission")
+    fun afterRefresh(
+        context: Context,
+        store: AlertStore,
+        snapshot: WeatherSnapshot?,
+        nowEpochSeconds: Long = System.currentTimeMillis() / 1000,
+    ) {
+        val settings = store.settings
+        if (!settings.any || !canPost(context)) return
+        val now = LocalDateTime.now()
+        val alerts =
+            WeatherAlerts.due(settings, store.memory, snapshot, now.toLocalDate().toString(), now.hour, nowEpochSeconds)
+        if (alerts.isEmpty()) return
+        val manager = context.getSystemService(NotificationManager::class.java) ?: return
+        createChannels(manager)
+        var memory = store.memory
+        alerts.forEach { alert ->
+            when (alert) {
+                is WeatherAlert.Morning -> {
+                    manager.notify(ID_MORNING, build(context, CHANNEL_MORNING, alert))
+                    memory = memory.copy(morningDate = alert.date)
+                }
+
+                is WeatherAlert.RainSoon -> {
+                    manager.notify(ID_RAIN, build(context, CHANNEL_RAIN, alert))
+                    memory = memory.copy(rainAtEpochSeconds = nowEpochSeconds)
+                }
+            }
+        }
+        store.memory = memory
+    }
+
+    private fun createChannels(manager: NotificationManager) {
+        manager.createNotificationChannel(
+            NotificationChannel(CHANNEL_MORNING, t("alert_morning_forecast"), NotificationManager.IMPORTANCE_LOW),
+        )
+        manager.createNotificationChannel(
+            NotificationChannel(CHANNEL_RAIN, t("alert_rain_alerts"), NotificationManager.IMPORTANCE_DEFAULT),
+        )
+    }
+
+    private fun build(
+        context: Context,
+        channel: String,
+        alert: WeatherAlert,
+    ): Notification {
+        val open =
+            PendingIntent.getActivity(
+                context,
+                0,
+                Intent(context, MainActivity::class.java).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK),
+                PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT,
+            )
+        return Notification
+            .Builder(context, channel)
+            .setSmallIcon(R.drawable.ic_sable_weather_monochrome)
+            .setContentTitle(alert.title)
+            .setContentText(alert.text)
+            .setContentIntent(open)
+            .setAutoCancel(true)
+            .setCategory(Notification.CATEGORY_RECOMMENDATION)
+            .build()
+    }
+}
