+++ b/sable-src/apps/titan2/platform/spaces/src/test/java/org/sableos/titan2/spaces/SpacesTextTest.kt
@@ -0,0 +1,62 @@
+package org.sableos.titan2.spaces
+
+import java.io.File
+import javax.xml.parsers.DocumentBuilderFactory
+import org.junit.Assert.assertEquals
+import org.junit.Test
+import org.sableos.titan2.spaces.core.SpacesText
+
+/** The English lines in code and in `values/strings.xml` stay equal, and every translation fits them. */
+class SpacesTextTest {
+    private val res = File("src/main/res")
+
+    private fun strings(file: File): Map<String, String> {
+        val doc = DocumentBuilderFactory.newInstance().newDocumentBuilder().parse(file)
+        val nodes = doc.getElementsByTagName("string")
+        return (0 until nodes.length)
+            .map { nodes.item(it) }
+            .filter { it.attributes.getNamedItem("translatable")?.nodeValue != "false" }
+            .associate { node ->
+                val raw =
+                    node.textContent.let {
+                        if (it.length > 1 && it.startsWith('"') &&
+                            it.endsWith('"')
+                        ) {
+                            it.drop(1).dropLast(1)
+                        } else {
+                            it
+                        }
+                    }
+                node.attributes.getNamedItem("name").nodeValue to
+                    raw
+                        .replace("\\n", "\n")
+                        .replace("\\'", "'")
+                        .replace("\\\"", "\"")
+                        .replace("\\@", "@")
+                        .replace("\\\\", "\\")
+            }
+    }
+
+    private fun placeholders(s: String) = Regex("%\\d+\\$[sd]").findAll(s).map {
+        it.value
+    }.toSortedSet()
+
+    @Test
+    fun englishResourcesMatchTheCode() {
+        val english = strings(File(res, "values/strings.xml"))
+        SpacesText.EN.forEach { (key, text) -> assertEquals(key, text, english[key]) }
+    }
+
+    @Test
+    fun translationsHaveEveryKeyAndTheSamePlaceholders() {
+        res.listFiles { f ->
+            f.name.startsWith("values-") && File(f, "strings.xml").isFile
+        }.orEmpty().forEach { dir ->
+            val tr = strings(File(dir, "strings.xml"))
+            assertEquals(dir.name, SpacesText.EN.keys, tr.keys.intersect(SpacesText.EN.keys))
+            SpacesText.EN.forEach { (key, text) ->
+                assertEquals("${dir.name}/$key", placeholders(text), placeholders(tr.getValue(key)))
+            }
+        }
+    }
+}
diff --git a/sable-src/apps/titan2/platform/spaces/src/test/java/org/sableos/titan2/spaces/core/WorkSpaceTest.kt b/sable-src/apps/titan2/platform/spaces/src/test/java/org/sableos/titan2/spaces/core/WorkSpaceTest.kt
new file mode 100644
index 0000000..4220c3c
--- /dev/null
+++ b/sable-src/apps/titan2/platform/spaces/src/test/java/org/sableos/titan2/spaces/core/WorkSpaceTest.kt
@@ -0,0 +1,70 @@
+package org.sableos.titan2.spaces.core
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class WorkSpaceTest {
+    @Test
+    fun stateFollowsTheWorkSpaceThenWhetherAndroidAllowsOne() {
+        assertEquals(
+            SpaceState.Paused,
+            WorkSpace.state(hasWorkSpace = true, paused = true, allowed = false)
+        )
+        assertEquals(
+            SpaceState.On,
+            WorkSpace.state(hasWorkSpace = true, paused = false, allowed = false)
+        )
+        assertEquals(
+            SpaceState.None,
+            WorkSpace.state(hasWorkSpace = false, paused = false, allowed = true)
+        )
+        assertEquals(
+            SpaceState.NotAllowed,
+            WorkSpace.state(hasWorkSpace = false, paused = false, allowed = false)
+        )
+        SpaceState.entries.forEach { assertTrue(it.name, WorkSpace.detailKey(it) in SpacesText.EN) }
+    }
+
+    @Test
+    fun onlyPackageNamesAreAcceptedFromAnotherProfile() {
+        assertTrue(WorkSpace.isPackageName("com.slack"))
+        assertTrue(WorkSpace.isPackageName("org.sableos.titan2.keyboard"))
+        assertFalse(WorkSpace.isPackageName(null))
+        assertFalse(WorkSpace.isPackageName("slack"))
+        assertFalse(WorkSpace.isPackageName("com.slack/.Main"))
+        assertFalse(WorkSpace.isPackageName("com..slack"))
+        assertFalse(WorkSpace.isPackageName("a." + "b".repeat(300)))
+    }
+
+    @Test
+    fun theCallersLabelIsShortAndNeverEmpty() {
+        assertEquals("com.slack", WorkSpace.shownLabel("  ", "com.slack"))
+        assertEquals("com.slack", WorkSpace.shownLabel(null, "com.slack"))
+        assertEquals(80, WorkSpace.shownLabel("x".repeat(200), "com.slack").length)
+        assertEquals("Slack", WorkSpace.shownLabel(" Slack ", "com.slack"))
+    }
+
+    @Test
+    fun addableLeavesOutItselfAndAppsAlreadyInWorkSortedByName() {
+        val apps = listOf(
+            AppChoice("com.zoom", "zoom"),
+            AppChoice("org.sableos.titan2.spaces", "Sable Spaces"),
+            AppChoice("com.slack", "Slack"),
+            AppChoice("com.slack", "Slack"),
+            AppChoice("com.mail", "Mail"),
+            AppChoice("com.teams", "Teams")
+        )
+        val shown = WorkSpace.addable(apps, "org.sableos.titan2.spaces", setOf("com.teams"))
+        assertEquals(listOf("Mail", "Slack", "zoom"), shown.map { it.label })
+    }
+
+    @Test
+    fun moveStaysOnTheList() {
+        assertEquals(0, WorkSpace.move(0, -1, 3))
+        assertEquals(2, WorkSpace.move(2, 1, 3))
+        assertEquals(1, WorkSpace.move(0, 1, 3))
+        assertEquals(0, WorkSpace.move(5, 1, 0))
+    }
+}
