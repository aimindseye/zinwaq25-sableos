+    <uses-policies>
+        <wipe-data />
+    </uses-policies>
+</device-admin>
diff --git a/sable-src/apps/titan2/platform/spaces/src/test/java/org/sableos/titan2/spaces/SpacesTextTest.kt b/sable-src/apps/titan2/platform/spaces/src/test/java/org/sableos/titan2/spaces/SpacesTextTest.kt
