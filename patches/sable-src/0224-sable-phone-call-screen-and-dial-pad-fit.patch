--- a/sable-src/apps/titan2/platform/phone/src/main/java/org/sableos/phone/android/GridCells.kt
+++ b/sable-src/apps/titan2/platform/phone/src/main/java/org/sableos/phone/android/GridCells.kt
@@ -11,3 +11,9 @@ fun gridCell(ui: Ui, gap: Int): GridLayout.LayoutParams = GridLayout.LayoutParam
     val half = ui.dp(gap) / 2
     setMargins(half, half, half, half)
 }
+
+/** Like [gridCell], and the row shares the grid's height too, so a weighted grid fits any screen. */
+fun fittedGridCell(ui: Ui, gap: Int): GridLayout.LayoutParams = gridCell(ui, gap).apply {
+    rowSpec = GridLayout.spec(GridLayout.UNDEFINED, 1f)
+    height = 0
+}
