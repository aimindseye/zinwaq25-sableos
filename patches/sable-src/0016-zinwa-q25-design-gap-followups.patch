+        val plain = "2468".map { TypedKey(0, it.code) }
+        assertEquals(CaseResult.FAIL, TextEntryTest.check(digits, "2468", plain))
+        assertEquals(CaseResult.FAIL, TextEntryTest.check(digits, "2468", emptyList()))
