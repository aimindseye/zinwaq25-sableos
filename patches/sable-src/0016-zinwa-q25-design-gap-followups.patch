+/** Three-page Start keys: Alt+Left / Alt+Right (Fn+Left / Fn+Right on Fn keyboards). */
+object StartPages {
+    private const val KEYCODE_DPAD_LEFT = 21
+    private const val KEYCODE_DPAD_RIGHT = 22
