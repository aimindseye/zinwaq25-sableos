+        AspectProfile.Ratio4x3Letterbox -> RATIO_4_3
+        AspectProfile.FullscreenMedia -> FULLSCREEN
+        AspectProfile.SquareSafe -> DISPLAY_SIZE
+        else -> null
     }
 }
