+    /** -1 toward Glance, +1 toward Hub, or null when the key does not move pages. */
+    fun keyDelta(
+        keyCode: Int,
+        metaState: Int,
+    ): Int? {
+        if (metaState and (QuickBar.META_ALT_ON or QuickBar.META_FUNCTION_ON) == 0) return null
