From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SableOS <noreply@sableos.invalid>
Date: Thu, 19 Nov 2026 02:30:00 +0000
Subject: [PATCH] sable: log why Sable Keyboard shows or hides word suggestions

Diagnostic for "no candidate strip while typing": tag SableSuggest logs, per
cursor update, whether suggestions were allowed and for which language, what the
word lists gave (loaded or not, count) and what the strip was told to show
(mode, content). Lengths and flags only, never typed text.
`adb logcat -s SableSuggest`.
---
diff --git a/apps/titan2/platform/keyboard/src/main/java/org/sableos/titan2/keyboard/android/CompactStripView.kt b/apps/titan2/platform/keyboard/src/main/java/org/sableos/titan2/keyboard/android/CompactStripView.kt
index d2b98d4..c7522a9 100644
--- a/apps/titan2/platform/keyboard/src/main/java/org/sableos/titan2/keyboard/android/CompactStripView.kt
+++ b/apps/titan2/platform/keyboard/src/main/java/org/sableos/titan2/keyboard/android/CompactStripView.kt
@@ -97,6 +97,11 @@ class CompactStripView(
     }
 
     fun render(m: StripModel) {
+        // Diagnostic (SableSuggest): what the strip was told to show. No typed text.
+        android.util.Log.d(
+            "SableSuggest",
+            "render mode=${m.mode} visible=${m.visible} content=${m.content::class.simpleName}"
+        )
         visibility = if (m.visible) View.VISIBLE else View.GONE
         if (!m.visible) return
         status.removeAllViews()
diff --git a/apps/titan2/platform/keyboard/src/main/java/org/sableos/titan2/keyboard/android/SuggestionController.kt b/apps/titan2/platform/keyboard/src/main/java/org/sableos/titan2/keyboard/android/SuggestionController.kt
index 6561504..914f2e7 100644
--- a/apps/titan2/platform/keyboard/src/main/java/org/sableos/titan2/keyboard/android/SuggestionController.kt
+++ b/apps/titan2/platform/keyboard/src/main/java/org/sableos/titan2/keyboard/android/SuggestionController.kt
@@ -44,6 +44,12 @@ class SuggestionController(
     val holdOpen: Boolean get() = suggestions.isEmpty() && SystemClock.uptimeMillis() < holdUntil
 
     fun update(ic: InputConnection?, field: SuggestionField) {
+        // Diagnostic (SableSuggest): the gates the keyboard passed in. No typed text.
+        android.util.Log.d(
+            "SableSuggest",
+            "update allowed=${field.allowed} lang=${field.languageTag} " +
+                "learn=${field.learn} ic=${ic != null}"
+        )
         val old = suggestions
         suggestions = if (ic != null && field.allowed) compute(ic, field) else forget()
         if (suggestions.isNotEmpty()) {
@@ -82,13 +88,21 @@ class SuggestionController(
         if (field.learn && user != null) learn(user, words, before)
         lastBefore = before
         val midWord = ic.getTextAfterCursor(1, 0)?.firstOrNull()?.isLetterOrDigit() == true
-        return if ((words == null && emoji == null) || midWord) {
+        val result = if ((words == null && emoji == null) || midWord) {
             emptyList()
         } else {
             runCatching {
                 WordSuggester(words, emoji, user).suggest(before)
             }.getOrDefault(emptyList())
         }
+        // Diagnostic (SableSuggest): why a list is empty. Lengths and flags only, never text.
+        android.util.Log.d(
+            "SableSuggest",
+            "compute lang=$lang words=${words != null} emoji=${emoji != null} " +
+                "user=${user != null} before=${before.length} midWord=$midWord " +
+                "result=${result.size}"
+        )
+        return result
     }
 
     private fun learn(user: UserWords, words: WordList?, before: String) {
