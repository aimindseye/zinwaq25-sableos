@@ -0,0 +1,35 @@
+package org.sableos.assistant.core
+
+/**
+ * Hold-to-talk, the parts that are plain logic: the speech model to fetch, the recognizer's JSON,
+ * and where the heard words go. Recognition runs on the phone (Vosk); no sound leaves it.
+ */
+object Speech {
+    const val SAMPLE_RATE = 16_000f
+
+    /** Vosk's small English model (Apache-2.0), fetched once when the owner asks for it. */
+    const val MODEL_URL = "https://alphacephei.com/vosk/models/vosk-model-small-en-us-0.15.zip"
+    const val MODEL_MB = 40
+
+    /** The words in one of the recognizer's results, such as {"text": "good morning"}. */
+    fun textOf(json: String): String = (Json.at(Json.parse(json), "text") as? String).orEmpty().trim()
+
+    fun join(parts: List<String>): String = parts.map(String::trim).filter(String::isNotEmpty).joinToString(" ")
+
+    /** Heard words join what is already typed; they wait there to be read and sent. */
+    fun appendToDraft(
+        draft: String,
+        heard: String,
+    ): String = if (draft.isBlank()) heard else "${draft.trimEnd()} $heard"
+
+    /**
+     * Where a file of the model archive goes inside the model folder: the archive's own top
+     * folder is dropped. Null for the top folder itself and for any path that would leave the
+     * model folder.
+     */
+    fun entryPath(name: String): String? {
+        val parts = name.replace('\\', '/').split('/').filter(String::isNotEmpty)
+        val inside = parts.drop(1)
+        return if (inside.isEmpty() || inside.any { it == ".." || it == "." }) null else inside.joinToString("/")
+    }
+}
diff --git a/sable-src/apps/r8/android/assistant/src/main/java/org/sableos/assistant/platform/AssistantClient.kt b/sable-src/apps/r8/android/assistant/src/main/java/org/sableos/assistant/platform/AssistantClient.kt
new file mode 100644
index 0000000..dc595ce
--- /dev/null
+++ b/sable-src/apps/r8/android/assistant/src/main/java/org/sableos/assistant/platform/AssistantClient.kt
@@ -0,0 +1,79 @@
+package org.sableos.assistant.platform
+
+import org.sableos.assistant.core.ChatProtocol
+import org.sableos.assistant.core.ChatReply
+import java.io.IOException
+import java.net.HttpURLConnection
+import java.net.SocketTimeoutException
+import java.net.URI
+
+/** What a request ended in, before the screen words it. */
+sealed interface CallResult {
+    data class Ok(
+        val body: String,
+    ) : CallResult
+
+    data class HttpError(
+        val message: String,
+    ) : CallResult
+
+    data object Unreachable : CallResult
+
+    data object Timeout : CallResult
+}
+
+/**
+ * Plain HTTP to an OpenAI-style server: POST /chat/completions and GET /models. Blocking; call it
+ * off the main thread. Only the owner's question, the recent turns and the system prompt are sent.
+ */
+object AssistantClient {
+    private const val CONNECT_MS = 8_000
+    private const val READ_MS = 120_000
+    private const val HTTP_ERROR = 400
+
+    fun chat(
+        base: String,
+        apiKey: String,
+        body: String,
+    ): CallResult = call("$base/chat/completions", apiKey, body)
+
+    fun models(
+        base: String,
+        apiKey: String,
+    ): CallResult = call("$base/models", apiKey, null)
+
+    private fun call(
+        url: String,
+        apiKey: String,
+        body: String?,
+    ): CallResult {
+        val connection = URI(url).toURL().openConnection() as HttpURLConnection
+        return try {
+            connection.connectTimeout = CONNECT_MS
+            connection.readTimeout = READ_MS
+            connection.setRequestProperty("Accept", "application/json")
+            if (apiKey.isNotBlank()) connection.setRequestProperty("Authorization", "Bearer ${apiKey.trim()}")
+            if (body != null) {
+                connection.requestMethod = "POST"
+                connection.doOutput = true
+                connection.setRequestProperty("Content-Type", "application/json; charset=utf-8")
+                connection.outputStream.use { it.write(body.toByteArray(Charsets.UTF_8)) }
+            }
+            val code = connection.responseCode
+            val stream = if (code >= HTTP_ERROR) connection.errorStream else connection.inputStream
+            val text = stream?.bufferedReader(Charsets.UTF_8)?.use { it.readText() }.orEmpty()
+            if (code >= HTTP_ERROR) {
+                val reply = ChatProtocol.reply(text)
+                CallResult.HttpError(if (reply is ChatReply.Failed) "$code ${reply.message}" else "$code")
+            } else {
+                CallResult.Ok(text)
+            }
+        } catch (_: SocketTimeoutException) {
+            CallResult.Timeout
+        } catch (_: IOException) {
+            CallResult.Unreachable
+        } finally {
+            connection.disconnect()
+        }
+    }
+}
