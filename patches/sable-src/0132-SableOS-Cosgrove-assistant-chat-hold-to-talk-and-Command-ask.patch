+++ b/sable-src/apps/r8/android/assistant/src/test/java/org/sableos/assistant/AssistantTextTest.kt
@@ -0,0 +1,63 @@
+package org.sableos.assistant
+
+import org.junit.Assert.assertEquals
+import org.junit.Test
+import org.sableos.assistant.core.AssistantText
+import java.io.File
+import javax.xml.parsers.DocumentBuilderFactory
+
+/** The English lines in code and in `values/strings.xml` stay equal, and every translation fits them. */
+class AssistantTextTest {
+    private val res = File("src/main/res")
+
+    private fun strings(file: File): Map<String, String> {
+        val doc = DocumentBuilderFactory.newInstance().newDocumentBuilder().parse(file)
+        val nodes = doc.getElementsByTagName("string")
+        return (0 until nodes.length)
+            .map { nodes.item(it) }
+            .filter { it.attributes.getNamedItem("translatable")?.nodeValue != "false" }
+            .associate { node ->
+                val raw =
+                    node.textContent.let {
+                        if (it.length > 1 && it.startsWith('"') &&
+                            it.endsWith('"')
+                        ) {
+                            it.drop(1).dropLast(1)
+                        } else {
+                            it
+                        }
+                    }
+                node.attributes.getNamedItem("name").nodeValue to
+                    raw
+                        .replace("\\n", "\n")
+                        .replace("\\'", "'")
+                        .replace("\\\"", "\"")
+                        .replace("\\@", "@")
+                        .replace("\\\\", "\\")
+            }
+    }
+
+    private fun placeholders(s: String) = Regex("%\\d+\\$[sd]").findAll(s).map { it.value }.toSortedSet()
+
+    @Test
+    fun englishResourcesMatchTheCode() {
+        val english = strings(File(res, "values/strings.xml"))
+        AssistantText.EN.forEach { (key, text) -> assertEquals(key, text, english[key]) }
+    }
+
+    @Test
+    fun translationsHaveEveryKeyAndTheSamePlaceholders() {
+        res.listFiles { f -> f.name.startsWith("values-") && File(f, "strings.xml").isFile }.orEmpty().forEach { dir ->
+            val tr = strings(File(dir, "strings.xml"))
+            assertEquals(dir.name, AssistantText.EN.keys, tr.keys.intersect(AssistantText.EN.keys))
+            AssistantText.EN.forEach { (key, text) ->
+                assertEquals("${dir.name}/$key", placeholders(text), placeholders(tr.getValue(key)))
+            }
+        }
+    }
+
+    @Test
+    fun linesFillTheirArguments() {
+        assertEquals("Ask Cosgrove", AssistantText.t("message_hint", "Cosgrove"))
+    }
+}
diff --git a/sable-src/apps/r8/android/assistant/src/test/java/org/sableos/assistant/core/CoreTest.kt b/sable-src/apps/r8/android/assistant/src/test/java/org/sableos/assistant/core/CoreTest.kt
