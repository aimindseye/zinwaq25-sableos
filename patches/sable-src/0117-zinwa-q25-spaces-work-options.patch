diff --git a/sable-src/apps/titan2/platform/spaces/src/main/java/org/sableos/titan2/spaces/android/WorkOptionsActivity.kt b/sable-src/apps/titan2/platform/spaces/src/main/java/org/sableos/titan2/spaces/android/WorkOptionsActivity.kt
