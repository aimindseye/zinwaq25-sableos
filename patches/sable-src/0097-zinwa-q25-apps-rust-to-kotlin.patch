-fn mine_index(state: &MineState, x: usize, y: usize) -> Result<usize, &'static str> {
-    if x >= state.width || y >= state.height {
-        Err("ERR:OUT_OF_BOUNDS")
-    } else {
-        Ok(y * state.width + x)
-    }
-}
