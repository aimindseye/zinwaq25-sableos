-
-    let encoded = format!("{row},{col},{value}");
-
-    let operations = if operations.is_empty() {
-        encoded
-    } else {
-        format!("{operations};{encoded}")
-    };
-
-    format!("OK:{SUDOKU_PREFIX}:{puzzle}:{operations}")
-}
