+<?xml version="1.0" encoding="utf-8"?>
+<manifest xmlns:android="http://schemas.android.com/apk/res/android">
+    <!-- No permissions: notes stay in app storage, and export, import and share go through
+         the system file picker and share sheet only when the user asks. -->
+    <queries>
+        <provider android:authorities="org.sableos.appearance" />
+    </queries>
+    <application
+        android:allowBackup="false"
+        android:usesCleartextTraffic="false"
+        android:icon="@mipmap/ic_sable_notes"
+        android:roundIcon="@mipmap/ic_sable_notes_round"
+        android:label="Sable Notes"
+        android:supportsRtl="true"
+        android:theme="@android:style/Theme.Material.NoActionBar">
+        <activity
+            android:name=".MainActivity"
+            android:exported="true"
+            android:launchMode="singleTask"
+            android:windowSoftInputMode="adjustResize">
+            <intent-filter>
+                <action android:name="android.intent.action.MAIN" />
+                <category android:name="android.intent.category.LAUNCHER" />
+            </intent-filter>
+            <!-- Text shared from another app becomes a new note. -->
+            <intent-filter>
+                <action android:name="android.intent.action.SEND" />
+                <category android:name="android.intent.category.DEFAULT" />
+                <data android:mimeType="text/plain" />
+            </intent-filter>
+        </activity>
+    </application>
+</manifest>
diff --git a/sable-src/apps/r8/android/notes/src/main/java/org/sableos/notes/MainActivity.kt b/sable-src/apps/r8/android/notes/src/main/java/org/sableos/notes/MainActivity.kt
