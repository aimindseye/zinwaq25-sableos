+package org.sableos.messages.data
+
+import android.net.Uri
+
+/**
+ * Telephony provider columns and URIs. Most are Telephony.* constants; the MMS part/address
+ * paths and a few columns are spelled out because the SDK only exposes them on newer levels.
+ */
+internal object ProviderColumns {
+    val THREADS_URI: Uri = Uri.parse("content://mms-sms/conversations?simple=true")
+    val CANONICAL_ADDRESSES_URI: Uri = Uri.parse("content://mms-sms/canonical-addresses")
+
+    /** Everything the SMS/MMS provider notifies on; the observer watches its descendants. */
+    val MMS_SMS_ROOT: Uri = Uri.parse("content://mms-sms/")
+    val MMS_PART_URI: Uri = Uri.parse("content://mms/part")
+
+    fun mmsPartsOf(messageId: Long): Uri = Uri.parse("content://mms/$messageId/part")
+
+    fun mmsAddressesOf(messageId: Long): Uri = Uri.parse("content://mms/$messageId/addr")
+
+    fun mmsPart(partId: Long): Uri = Uri.parse("content://mms/part/$partId")
+
+    const val ID = "_id"
+    const val THREAD_RECIPIENT_IDS = "recipient_ids"
+
+    const val PART_MESSAGE_ID = "mid"
+    const val PART_CONTENT_TYPE = "ct"
+    const val PART_CONTENT_ID = "cid"
+    const val PART_CONTENT_LOCATION = "cl"
+    const val PART_NAME = "name"
+    const val PART_FILENAME = "fn"
+    const val PART_CHARSET = "chset"
+    const val PART_TEXT = "text"
+
+    const val ADDR_ADDRESS = "address"
+    const val ADDR_TYPE = "type"
+    const val ADDR_CHARSET = "charset"
+
+    /** Value Sable writes to retr_st when an announced MMS could not be downloaded. */
+    const val RETRIEVE_STATUS_FAILED = 0xC0
+}
diff --git a/sable-src/apps/r8/android/messages/src/main/java/org/sableos/messages/data/SmsSender.kt b/sable-src/apps/r8/android/messages/src/main/java/org/sableos/messages/data/SmsSender.kt
new file mode 100644
index 0000000..c9eb24b
--- /dev/null
+++ b/sable-src/apps/r8/android/messages/src/main/java/org/sableos/messages/data/SmsSender.kt
@@ -0,0 +1,227 @@
+package org.sableos.messages.data
+
+import android.Manifest
+import android.annotation.SuppressLint
+import android.app.PendingIntent
+import android.content.BroadcastReceiver
+import android.content.ContentValues
+import android.content.Context
+import android.content.Intent
+import android.content.pm.PackageManager
+import android.net.Uri
+import android.os.Build
+import android.provider.Telephony
+import android.telephony.SmsManager
+import android.telephony.SubscriptionManager
+import android.util.Log
+import org.sableos.messages.core.Addresses
+import org.sableos.messages.core.MessageStatus
+
+/** Whether this app holds the SMS role: then it, not the framework, writes sent and received texts. */
+fun Context.isDefaultSmsApp(): Boolean = Telephony.Sms.getDefaultSmsPackage(this) == packageName
+
+/** SmsManager for a subscription, or the default one when the id is invalid (as Sable Hub does). */
+fun Context.smsManagerFor(subscriptionId: Int): SmsManager =
+    when {
+        !SubscriptionManager.isValidSubscriptionId(subscriptionId) -> {
+            getSystemService(SmsManager::class.java)
+        }
+
+        Build.VERSION.SDK_INT >= Build.VERSION_CODES.S -> {
+            getSystemService(SmsManager::class.java).createForSubscriptionId(subscriptionId)
+        }
+
+        else -> {
+            legacySmsManager(subscriptionId)
+        }
+    }
+
+@Suppress("DEPRECATION")
+private fun legacySmsManager(subscriptionId: Int): SmsManager =
+    SmsManager.getSmsManagerForSubscriptionId(subscriptionId)
+
+/**
+ * Sends texts with SmsManager on the default SMS subscription (as Sable Hub does), split into
+ * parts when long. As the default SMS app it records the message in the outbox first and
+ * [SmsSentReceiver] moves it to sent or failed from the sent PendingIntents; otherwise the
+ * framework records it and Sable Messages must not.
+ */
+class SmsSender(
+    context: Context,
+) {
+    private val appContext = context.applicationContext
+
+    fun canSend(): Boolean =
+        appContext.checkSelfPermission(Manifest.permission.SEND_SMS) == PackageManager.PERMISSION_GRANTED
+
+    /** Sends [body] to [address]; returns the thread it belongs to. Call off the main thread. */
+    @SuppressLint("MissingPermission")
+    fun send(
+        address: String,
+        body: String,
+    ): Long {
+        val recipient = Addresses.normalize(address)
+        require(recipient.isNotEmpty()) { "Recipient is required." }
+        require(body.isNotBlank()) { "Message is empty." }
+        check(canSend()) { "SMS sending permission is not available." }
+        val threadId = Telephony.Threads.getOrCreateThreadId(appContext, setOf(recipient))
+        val subscriptionId = SubscriptionManager.getDefaultSmsSubscriptionId()
+        val messageUri =
+            if (appContext.isDefaultSmsApp()) {
+                recordOutbox(
+                    recipient,
+                    body,
+                    threadId,
+                    subscriptionId,
+                )
+            } else {
+                null
+            }
+        transmit(recipient, body, subscriptionId, messageUri)
+        return threadId
+    }
+
+    /** Sends a failed message again (default app: same provider row, back to the outbox). */
+    @SuppressLint("MissingPermission")
+    fun retry(
+        messageId: Long,
+        address: String,
+        body: String,
+    ) {
+        check(canSend()) { "SMS sending permission is not available." }
+        val subscriptionId = SubscriptionManager.getDefaultSmsSubscriptionId()
+        if (!appContext.isDefaultSmsApp()) {
+            transmit(address, body, subscriptionId, null)
+            return
+        }
+        val uri = Uri.withAppendedPath(Telephony.Sms.CONTENT_URI, messageId.toString())
+        val values =
+            ContentValues().apply {
+                put(Telephony.Sms.TYPE, MessageStatus.SMS_TYPE_OUTBOX)
+                put(Telephony.Sms.ERROR_CODE, 0)
+                put(Telephony.Sms.DATE, System.currentTimeMillis())
+            }
+        appContext.contentResolver.update(uri, values, null, null)
+        transmit(address, body, subscriptionId, uri)
+    }
+
+    private fun recordOutbox(
+        address: String,
+        body: String,
+        threadId: Long,
+        subscriptionId: Int,
+    ): Uri? {
+        val values =
+            ContentValues().apply {
+                put(Telephony.Sms.ADDRESS, address)
+                put(Telephony.Sms.BODY, body)
+                put(Telephony.Sms.DATE, System.currentTimeMillis())
+                put(Telephony.Sms.READ, 1)
+                put(Telephony.Sms.SEEN, 1)
+                put(Telephony.Sms.TYPE, MessageStatus.SMS_TYPE_OUTBOX)
+                put(Telephony.Sms.THREAD_ID, threadId)
+                put(Telephony.Sms.SUBSCRIPTION_ID, subscriptionId)
+            }
+        return runCatching { appContext.contentResolver.insert(Telephony.Sms.Outbox.CONTENT_URI, values) }
+            .onFailure { Log.w(TAG, "could not record the outgoing message", it) }
+            .getOrNull()
+    }
+
+    @SuppressLint("MissingPermission")
+    private fun transmit(
+        address: String,
+        body: String,
+        subscriptionId: Int,
+        messageUri: Uri?,
+    ) {
+        val manager = appContext.smsManagerFor(subscriptionId)
+        val parts = manager.divideMessage(body)
+        // Without a provider row of our own (not the default app) there is nothing to update.
+        val sentIntents = messageUri?.let { uri -> ArrayList(parts.indices.map { sentIntent(uri, it, parts.size) }) }
+        runCatching {
+            if (parts.size <= 1) {
+                manager.sendTextMessage(address, null, body, sentIntents?.first(), null)
+            } else {
+                manager.sendMultipartTextMessage(address, null, parts, sentIntents, null)
+            }
+        }.onFailure { error ->
+            Log.w(TAG, "SmsManager refused the message", error)
+            messageUri?.let { SmsSentReceiver.markFailed(appContext, it, MessageStatus.ERROR_GENERIC) }
+        }
+    }
+
+    private fun sentIntent(
+        messageUri: Uri,
+        part: Int,
+        parts: Int,
+    ): PendingIntent {
+        val intent =
+            Intent(appContext, SmsSentReceiver::class.java)
+                .setAction(SmsSentReceiver.ACTION_SENT)
+                .setData(messageUri)
+                .putExtra(SmsSentReceiver.EXTRA_PART, part)
+                .putExtra(SmsSentReceiver.EXTRA_PARTS, parts)
+        return PendingIntent.getBroadcast(
+            appContext,
+            part,
+            intent,
+            PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT,
+        )
+    }
+
+    private companion object {
+        const val TAG = "SableMessages"
+    }
+}
+
+/** Moves an outgoing message from the outbox to sent or failed as SmsManager reports each part. */
+class SmsSentReceiver : BroadcastReceiver() {
+    override fun onReceive(
+        context: Context,
+        intent: Intent,
+    ) {
+        if (intent.action != ACTION_SENT) return
+        val uri = intent.data ?: return
+        val part = intent.getIntExtra(EXTRA_PART, 0)
+        val parts = intent.getIntExtra(EXTRA_PARTS, 1)
+        val code = resultCode
+        finishInBackground { update(context, uri, code, isLastPart = part >= parts - 1) }
+    }
+
+    companion object {
+        const val ACTION_SENT = "org.sableos.messages.action.SMS_SENT"
+        const val EXTRA_PART = "part"
+        const val EXTRA_PARTS = "parts"
+        private const val TAG = "SableMessages"
+
+        fun update(
+            context: Context,
+            uri: Uri,
+            resultCode: Int,
+            isLastPart: Boolean,
+        ) {
+            val resolver = context.contentResolver
+            val current =
+                runCatching {
+                    resolver.query(uri, arrayOf(Telephony.Sms.TYPE), null, null, null)?.use { cursor ->
+                        if (cursor.moveToFirst()) cursor.getInt(0) else null
+                    }
+                }.getOrNull() ?: return
+            val next = MessageStatus.afterPartResult(current, resultCode, isLastPart)
+            if (next == current) return
+            val values =
+                ContentValues().apply {
+                    put(Telephony.Sms.TYPE, next)
+                    if (next == MessageStatus.SMS_TYPE_FAILED) put(Telephony.Sms.ERROR_CODE, resultCode)
+                }
+            runCatching { resolver.update(uri, values, null, null) }
+                .onFailure { Log.w(TAG, "could not update $uri", it) }
+        }
+
+        fun markFailed(
+            context: Context,
+            uri: Uri,
+            errorCode: Int,
+        ) = update(context, uri, errorCode, isLastPart = true)
+    }
+}
diff --git a/sable-src/apps/r8/android/messages/src/main/java/org/sableos/messages/receive/MessageNotifier.kt b/sable-src/apps/r8/android/messages/src/main/java/org/sableos/messages/receive/MessageNotifier.kt
new file mode 100644
index 0000000..bafeb29
--- /dev/null
+++ b/sable-src/apps/r8/android/messages/src/main/java/org/sableos/messages/receive/MessageNotifier.kt
@@ -0,0 +1,174 @@
+package org.sableos.messages.receive
+
+import android.app.Notification
+import android.app.NotificationChannel
+import android.app.NotificationManager
+import android.app.PendingIntent
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.Intent
+import android.graphics.drawable.Icon
+import android.provider.Telephony
+import org.sableos.messages.MainActivity
+import org.sableos.messages.R
+import org.sableos.messages.core.IncomingNotice
+import org.sableos.messages.data.ContactNames
+import org.sableos.messages.data.MessagesRepository
+import org.sableos.messages.data.finishInBackground
+
+/** The thread the user is looking at, so a text arriving in it does not also ring a notification. */
+object ForegroundThread {
+    @Volatile
+    var threadId: Long = NONE
+
+    const val NONE = -1L
+}
+
+/**
+ * New-message notifications, one per thread. The lock screen gets the public version (sender and
+ * body hidden) unless the user allowed sensitive content (VISIBILITY_PRIVATE).
+ */
+object MessageNotifier {
+    private const val CHANNEL_ID = "incoming_messages"
+    private const val TAG_THREAD = "thread"
+
+    fun notifyIncoming(
+        context: Context,
+        threadId: Long,
+        address: String,
+        body: String,
+    ) {
+        if (threadId == ForegroundThread.threadId) return
+        val manager = context.getSystemService(NotificationManager::class.java)
+        if (!manager.areNotificationsEnabled()) return
+        ensureChannel(context, manager)
+        val unread = unreadCount(context, threadId).coerceAtLeast(1)
+        val title = IncomingNotice.title(ContactNames(context).nameFor(address), address)
+        val open = openThreadIntent(context, threadId)
+        val publicVersion =
+            Notification
+                .Builder(context, CHANNEL_ID)
+                .setSmallIcon(R.drawable.ic_sable_messages_monochrome)
+                .setContentTitle(context.getString(R.string.app_name))
+                .setContentText(IncomingNotice.publicText(unread))
+                .setContentIntent(open)
+                .build()
+        val notification =
+            Notification
+                .Builder(context, CHANNEL_ID)
+                .setSmallIcon(R.drawable.ic_sable_messages_monochrome)
+                .setContentTitle(title)
+                .setContentText(body)
+                .setStyle(Notification.BigTextStyle().bigText(body))
+                .setCategory(Notification.CATEGORY_MESSAGE)
+                .setVisibility(Notification.VISIBILITY_PRIVATE)
+                .setPublicVersion(publicVersion)
+                .setNumber(unread)
+                .setWhen(System.currentTimeMillis())
+                .setShowWhen(true)
+                .setAutoCancel(true)
+                .setOnlyAlertOnce(false)
+                .setContentIntent(open)
+                .addAction(markReadAction(context, threadId))
+                .build()
+        manager.notify(TAG_THREAD, threadId.toInt(), notification)
+    }
+
+    fun cancel(
+        context: Context,
+        threadId: Long,
+    ) {
+        context.getSystemService(NotificationManager::class.java).cancel(TAG_THREAD, threadId.toInt())
+    }
+
+    private fun ensureChannel(
+        context: Context,
+        manager: NotificationManager,
+    ) {
+        if (manager.getNotificationChannel(CHANNEL_ID) != null) return
+        val channel =
+            NotificationChannel(
+                CHANNEL_ID,
+                context.getString(R.string.channel_incoming),
+                NotificationManager.IMPORTANCE_HIGH,
+            ).apply {
+                lockscreenVisibility = Notification.VISIBILITY_PRIVATE
+                enableLights(true)
+                enableVibration(true)
+            }
+        manager.createNotificationChannel(channel)
+    }
+
+    private fun unreadCount(
+        context: Context,
+        threadId: Long,
+    ): Int =
+        runCatching {
+            context.contentResolver
+                .query(
+                    Telephony.Sms.Inbox.CONTENT_URI,
+                    arrayOf(Telephony.Sms._ID),
+                    "${Telephony.Sms.THREAD_ID} = ? AND ${Telephony.Sms.READ} = 0",
+                    arrayOf(threadId.toString()),
+                    null,
+                )?.use { it.count } ?: 0
+        }.getOrDefault(0)
+
+    private fun openThreadIntent(
+        context: Context,
+        threadId: Long,
+    ): PendingIntent {
+        val intent =
+            Intent(context, MainActivity::class.java)
+                .setAction(MainActivity.ACTION_OPEN_THREAD)
+                .putExtra(MainActivity.EXTRA_THREAD_ID, threadId)
+                .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_SINGLE_TOP)
+        return PendingIntent.getActivity(
+            context,
+            threadId.toInt(),
+            intent,
+            PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT,
+        )
+    }
+
+    private fun markReadAction(
+        context: Context,
+        threadId: Long,
+    ): Notification.Action {
+        val intent =
+            Intent(context, NotificationActionReceiver::class.java)
+                .setAction(NotificationActionReceiver.ACTION_MARK_READ)
+                .putExtra(MainActivity.EXTRA_THREAD_ID, threadId)
+        val pending =
+            PendingIntent.getBroadcast(
+                context,
+                threadId.toInt(),
+                intent,
+                PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT,
+            )
+        return Notification.Action
+            .Builder(
+                Icon.createWithResource(context, R.drawable.ic_sable_messages_monochrome),
+                context.getString(R.string.action_mark_read),
+                pending,
+            ).build()
+    }
+}
+
+/** "Mark read" on a new-message notification. */
+class NotificationActionReceiver : BroadcastReceiver() {
+    override fun onReceive(
+        context: Context,
+        intent: Intent,
+    ) {
+        if (intent.action != ACTION_MARK_READ) return
+        val threadId = intent.getLongExtra(MainActivity.EXTRA_THREAD_ID, ForegroundThread.NONE)
+        if (threadId == ForegroundThread.NONE) return
+        MessageNotifier.cancel(context, threadId)
+        finishInBackground { MessagesRepository(context).markRead(threadId) }
+    }
+
+    companion object {
+        const val ACTION_MARK_READ = "org.sableos.messages.action.MARK_READ"
+    }
+}
