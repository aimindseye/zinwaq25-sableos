--- /dev/null
+++ b/sable-src/apps/r8/android/messages/src/main/java/org/sableos/messages/core/mms/MmsPduEncoder.kt
@@ -0,0 +1,49 @@
+package org.sableos.messages.core.mms
+
+import java.io.ByteArrayOutputStream
+
+/** Encodes the one PDU Sable Messages sends back to the MMSC after a download. */
+object MmsPduEncoder {
+    /**
+     * M-NotifyResp.ind telling the MMSC the message was retrieved (OMA-TS-MMS_ENC 6.2), so it
+     * does not send the notification again. Report-Allowed is "no": Sable sends no delivery
+     * reports.
+     */
+    fun notifyRespInd(
+        transactionId: String,
+        version: Int,
+    ): ByteArray {
+        val out = ByteArrayOutputStream()
+        out.write(MmsHeaders.MESSAGE_TYPE)
+        out.write(MmsHeaders.MESSAGE_TYPE_NOTIFYRESP_IND)
+        out.write(MmsHeaders.TRANSACTION_ID)
+        writeText(out, transactionId)
+        out.write(MmsHeaders.MMS_VERSION)
+        out.write(versionOctet(version))
+        out.write(MmsHeaders.STATUS)
+        out.write(MmsHeaders.STATUS_RETRIEVED)
+        out.write(MmsHeaders.REPORT_ALLOWED)
+        out.write(MmsHeaders.VALUE_NO)
+        return out.toByteArray()
+    }
+
+    /** The notification's version as a short integer; 1.2 when it gave none. */
+    private fun versionOctet(version: Int): Int =
+        if (version in 1 until PduReader.HIGH_BIT) {
+            version or PduReader.HIGH_BIT
+        } else {
+            MmsHeaders.VERSION_1_2
+        }
+
+    private fun writeText(
+        out: ByteArrayOutputStream,
+        text: String,
+    ) {
+        val bytes = text.toByteArray(Charsets.UTF_8)
+        if (bytes.isNotEmpty() && (bytes[0].toInt() and PduReader.BYTE_MASK) >= PduReader.HIGH_BIT) {
+            out.write(PduReader.TEXT_QUOTE)
+        }
+        out.write(bytes)
+        out.write(0)
+    }
+}
diff --git a/sable-src/apps/r8/android/messages/src/main/java/org/sableos/messages/core/mms/MmsPduParser.kt b/sable-src/apps/r8/android/messages/src/main/java/org/sableos/messages/core/mms/MmsPduParser.kt
new file mode 100644
index 0000000..7572003
--- /dev/null
+++ b/sable-src/apps/r8/android/messages/src/main/java/org/sableos/messages/core/mms/MmsPduParser.kt
@@ -0,0 +1,243 @@
+package org.sableos.messages.core.mms
+
+/**
+ * Parses M-Notification.ind and M-Retrieve.conf PDUs. Written for Sable Messages rather than
+ * copied from AOSP's com.google.android.mms (hidden platform API): it decodes the headers Sable
+ * stores and skips every other header generically, since all WSP values are self-delimiting.
+ */
+object MmsPduParser {
+    /** The parsed PDU, or null when [bytes] is not a well-formed MMS PDU. */
+    fun parse(bytes: ByteArray): MmsPdu? =
+        try {
+            parseOrThrow(bytes)
+        } catch (error: PduFormatException) {
+            lastError = error.message
+            null
+        }
+
+    /** Why the last [parse] returned null (for logs). */
+    @Volatile
+    var lastError: String? = null
+        private set
+
+    fun parseOrThrow(bytes: ByteArray): MmsPdu {
+        val reader = PduReader(bytes)
+        val headers = Headers()
+        while (reader.hasMore() && headers.contentType == null) {
+            readHeader(reader, headers)
+        }
+        val messageType = headers.messageType ?: throw PduFormatException("no message type")
+        return when (messageType) {
+            MmsHeaders.MESSAGE_TYPE_NOTIFICATION_IND -> {
+                val location = headers.contentLocation ?: throw PduFormatException("notification without location")
+                NotificationInd(
+                    transactionId = headers.transactionId,
+                    version = headers.version,
+                    from = headers.from.orEmpty(),
+                    subject = headers.subject,
+                    messageClass = headers.messageClass,
+                    messageSize = headers.messageSize ?: 0L,
+                    expirySeconds = headers.expiry,
+                    expiryAbsolute = headers.expiryAbsolute,
+                    contentLocation = location,
+                )
+            }
+
+            MmsHeaders.MESSAGE_TYPE_RETRIEVE_CONF -> {
+                retrieveConf(reader, headers)
+            }
+
+            else -> {
+                OtherPdu(messageType, headers.transactionId, headers.version)
+            }
+        }
+    }
+
+    private fun retrieveConf(
+        reader: PduReader,
+        headers: Headers,
+    ): RetrieveConf {
+        val type = headers.contentType ?: ContentType("application/octet-stream")
+        val parts =
+            when {
+                !reader.hasMore() -> emptyList()
+                type.isMultipart -> MultipartParser.parse(reader)
+                else -> listOf(PduPart(type, null, null, null, reader.remaining()))
+            }
+        return RetrieveConf(
+            transactionId = headers.transactionId,
+            version = headers.version,
+            messageId = headers.messageId,
+            dateSeconds = headers.date,
+            from = headers.from.orEmpty(),
+            to = headers.to,
+            cc = headers.cc,
+            subject = headers.subject,
+            messageClass = headers.messageClass,
+            priority = headers.priority,
+            contentType = type,
+            parts = parts,
+        )
+    }
+
+    private fun readHeader(
+        reader: PduReader,
+        headers: Headers,
+    ) {
+        val field = reader.peek()
+        if (field < PduReader.HIGH_BIT) {
+            // Application header: Token-text name, then a value Sable does not use.
+            reader.readTextString()
+            reader.skipValue()
+            return
+        }
+        reader.readByte()
+        when (field) {
+            MmsHeaders.MESSAGE_TYPE -> headers.messageType = reader.readByte()
+            MmsHeaders.TRANSACTION_ID -> headers.transactionId = reader.readTextString()
+            MmsHeaders.MMS_VERSION -> headers.version = reader.readIntegerValue().toInt()
+            MmsHeaders.MESSAGE_ID -> headers.messageId = reader.readTextString()
+            MmsHeaders.CONTENT_LOCATION -> headers.contentLocation = reader.readTextString()
+            MmsHeaders.DATE -> headers.date = reader.readLongInteger()
+            MmsHeaders.MESSAGE_SIZE -> headers.messageSize = reader.readLongInteger()
+            MmsHeaders.PRIORITY -> headers.priority = reader.readByte()
+            else -> readAddressingHeader(field, reader, headers)
+        }
+    }
+
+    private fun readAddressingHeader(
+        field: Int,
+        reader: PduReader,
+        headers: Headers,
+    ) {
+        when (field) {
+            MmsHeaders.FROM -> headers.from = readFrom(reader)
+            MmsHeaders.TO -> headers.to += cleanAddress(reader.readEncodedString())
+            MmsHeaders.CC -> headers.cc += cleanAddress(reader.readEncodedString())
+            MmsHeaders.SUBJECT -> headers.subject = reader.readEncodedString()
+            MmsHeaders.MESSAGE_CLASS -> headers.messageClass = readMessageClass(reader)
+            MmsHeaders.EXPIRY -> readExpiry(reader, headers)
+            MmsHeaders.CONTENT_TYPE -> headers.contentType = WspContentTypes.read(reader)
+            else -> reader.skipValue()
+        }
+    }
+
+    private fun readFrom(reader: PduReader): String {
+        val length = reader.readValueLength()
+        val spanEnd = reader.pos + length
+        val token = reader.readByte()
+        val address = if (token == MmsHeaders.ADDRESS_PRESENT) cleanAddress(reader.readEncodedString()) else ""
+        reader.pos = spanEnd
+        return address
+    }
+
+    private fun readExpiry(
+        reader: PduReader,
+        headers: Headers,
+    ) {
+        val length = reader.readValueLength()
+        val spanEnd = reader.pos + length
+        headers.expiryAbsolute = reader.readByte() == MmsHeaders.ABSOLUTE_TOKEN
+        headers.expiry = reader.readLongInteger()
+        reader.pos = spanEnd
+    }
+
+    private fun readMessageClass(reader: PduReader): String {
+        if (reader.peek() < PduReader.HIGH_BIT) return reader.readTextString()
+        return when (reader.readByte()) {
+            CLASS_PERSONAL -> "personal"
+            CLASS_ADVERTISEMENT -> "advertisement"
+            CLASS_INFORMATIONAL -> "informational"
+            else -> "auto"
+        }
+    }
+
+    /** "+15551234567/TYPE=PLMN" → "+15551234567". */
+    fun cleanAddress(raw: String): String = raw.substringBefore("/TYPE=").trim()
+
+    private const val CLASS_PERSONAL = 0x80
+    private const val CLASS_ADVERTISEMENT = 0x81
+    private const val CLASS_INFORMATIONAL = 0x82
+
+    private class Headers {
+        var messageType: Int? = null
+        var transactionId: String? = null
+        var version: Int = 0
+        var messageId: String? = null
+        var contentLocation: String? = null
+        var date: Long? = null
+        var messageSize: Long? = null
+        var priority: Int? = null
+        var from: String? = null
+        val to = mutableListOf<String>()
+        val cc = mutableListOf<String>()
+        var subject: String? = null
+        var messageClass: String? = null
+        var expiry: Long? = null
+        var expiryAbsolute: Boolean = false
+        var contentType: ContentType? = null
+    }
+}
+
+/** application/vnd.wap.multipart.* body (WAP-230-WSP section 8.5). */
+internal object MultipartParser {
+    private const val CONTENT_LOCATION = 0x8E
+    private const val CONTENT_ID = 0xC0
+    private const val CONTENT_DISPOSITION = 0xAE
+    private const val CONTENT_DISPOSITION_1_4 = 0xC5
+    private const val MAX_PARTS = 256
+
+    fun parse(reader: PduReader): List<PduPart> {
+        val count = reader.readUintvar()
+        if (count > MAX_PARTS) throw PduFormatException("$count parts")
+        return List(count.toInt()) { readPart(reader) }
+    }
+
+    private fun readPart(reader: PduReader): PduPart {
+        val headersLength = reader.readUintvar().toInt()
+        val dataLength = reader.readUintvar().toInt()
+        val headersEnd = reader.pos + headersLength
+        val type = WspContentTypes.read(reader)
+        var contentId: String? = null
+        var contentLocation: String? = null
+        var fileName: String? = null
+        while (reader.pos < headersEnd) {
+            when (val field = reader.peek()) {
+                CONTENT_LOCATION -> {
+                    reader.readByte()
+                    contentLocation = reader.readTextString()
+                }
+
+                CONTENT_ID -> {
+                    reader.readByte()
+                    contentId = reader.readTextString().removePrefix("<").removeSuffix(">")
+                }
+
+                CONTENT_DISPOSITION, CONTENT_DISPOSITION_1_4 -> {
+                    reader.readByte()
+                    fileName = readDispositionFileName(reader) ?: fileName
+                }
+
+                else -> {
+                    if (field < PduReader.HIGH_BIT) reader.readTextString() else reader.readByte()
+                    reader.skipValue()
+                }
+            }
+        }
+        reader.pos = headersEnd
+        return PduPart(type, contentId, contentLocation, fileName, reader.readBytes(dataLength))
+    }
+
+    private fun readDispositionFileName(reader: PduReader): String? {
+        if (reader.peek() > PduReader.LENGTH_QUOTE) {
+            reader.skipValue()
+            return null
+        }
+        val length = reader.readValueLength()
+        val spanEnd = reader.pos + length
+        reader.skipValue() // form-data / attachment / inline
+        val name = WspContentTypes.readParameters(reader, spanEnd).name
+        reader.pos = spanEnd
+        return name
+    }
+}
diff --git a/sable-src/apps/r8/android/messages/src/main/java/org/sableos/messages/core/mms/PduReader.kt b/sable-src/apps/r8/android/messages/src/main/java/org/sableos/messages/core/mms/PduReader.kt
new file mode 100644
index 0000000..183f0fc
--- /dev/null
+++ b/sable-src/apps/r8/android/messages/src/main/java/org/sableos/messages/core/mms/PduReader.kt
@@ -0,0 +1,176 @@
+package org.sableos.messages.core.mms
+
+import java.nio.charset.Charset
+
+/** A malformed or truncated WSP/MMS PDU. */
+class PduFormatException(
+    message: String,
+) : IllegalArgumentException(message)
+
+/**
+ * WSP primitive decoding (WAP-230-WSP section 8.4) used by MMS PDUs (OMA-TS-MMS_ENC). Every value
+ * is self-delimiting, so unknown headers are skipped without knowing their meaning.
+ */
+internal class PduReader(
+    private val data: ByteArray,
+    var pos: Int = 0,
+    val end: Int = data.size,
+) {
+    fun hasMore(): Boolean = pos < end
+
+    fun peek(): Int {
+        ensure(1)
+        return data[pos].toInt() and BYTE_MASK
+    }
+
+    fun readByte(): Int {
+        ensure(1)
+        return data[pos++].toInt() and BYTE_MASK
+    }
+
+    fun readBytes(count: Int): ByteArray {
+        if (count < 0) throw PduFormatException("negative length $count")
+        ensure(count)
+        val out = data.copyOfRange(pos, pos + count)
+        pos += count
+        return out
+    }
+
+    /** Unsigned variable-length integer: 7 bits per octet, high bit set on all but the last. */
+    fun readUintvar(): Long {
+        var value = 0L
+        repeat(MAX_UINTVAR_OCTETS) {
+            val octet = readByte()
+            value = (value shl SEVEN_BITS) or (octet and LOW_SEVEN_BITS).toLong()
+            if (octet and HIGH_BIT == 0) return value
+        }
+        throw PduFormatException("uintvar longer than $MAX_UINTVAR_OCTETS octets")
+    }
+
+    /** Value-length: a short length (0-30) or LENGTH_QUOTE followed by a uintvar. */
+    fun readValueLength(): Int {
+        val first = readByte()
+        val length =
+            when {
+                first <= MAX_SHORT_LENGTH -> first.toLong()
+                first == LENGTH_QUOTE -> readUintvar()
+                else -> throw PduFormatException("not a value length: $first")
+            }
+        if (length > end - pos) throw PduFormatException("length $length past the end")
+        return length.toInt()
+    }
+
+    /** Long-integer: short length then that many big-endian octets. */
+    fun readLongInteger(): Long {
+        val count = readByte()
+        if (count > MAX_SHORT_LENGTH ||
+            count > Long.SIZE_BYTES
+        ) {
+            throw PduFormatException("long integer of $count octets")
+        }
+        var value = 0L
+        repeat(count) { value = (value shl Byte.SIZE_BITS) or readByte().toLong() }
+        return value
+    }
+
+    /** Integer-value: a short integer (one octet with the high bit set) or a long integer. */
+    fun readIntegerValue(): Long =
+        if (peek() and HIGH_BIT !=
+            0
+        ) {
+            (readByte() and LOW_SEVEN_BITS).toLong()
+        } else {
+            readLongInteger()
+        }
+
+    /** Text-string, Token-text or Quoted-string: optional quote octet, then octets up to NUL. */
+    fun readTextString(): String {
+        if (peek() == TEXT_QUOTE || peek() == QUOTED_STRING) pos++
+        val start = pos
+        while (pos < end && data[pos].toInt() != 0) pos++
+        if (pos >= end) throw PduFormatException("unterminated text string")
+        val text = String(data, start, pos - start, Charsets.UTF_8)
+        pos++
+        return text
+    }
+
+    /** Skips any WSP value: short-integer, value-length-prefixed data or text. */
+    fun skipValue() {
+        val first = peek()
+        when {
+            first <= MAX_SHORT_LENGTH || first == LENGTH_QUOTE -> pos += readValueLength()
+            first < HIGH_BIT -> readTextString()
+            else -> pos++
+        }
+    }
+
+    private fun ensure(count: Int) {
+        if (count > end - pos) throw PduFormatException("truncated PDU at $pos")
+    }
+
+    companion object {
+        const val BYTE_MASK = 0xFF
+        const val HIGH_BIT = 0x80
+        const val LOW_SEVEN_BITS = 0x7F
+        const val SEVEN_BITS = 7
+        const val MAX_UINTVAR_OCTETS = 5
+        const val MAX_SHORT_LENGTH = 30
+        const val LENGTH_QUOTE = 31
+        const val TEXT_QUOTE = 0x7F
+        const val QUOTED_STRING = 0x22
+    }
+}
+
+/** The rest of the PDU (a single-part body). */
+internal fun PduReader.remaining(): ByteArray = readBytes(end - pos)
+
+/**
+ * Encoded-string-value: a Text-string, or a value length, a charset (MIBenum) and the text. The
+ * length bounds the text, so UTF-16 text with NUL octets decodes too.
+ */
+internal fun PduReader.readEncodedString(): String {
+    if (peek() > PduReader.LENGTH_QUOTE) return readTextString()
+    val length = readValueLength()
+    val spanEnd = pos + length
+    val charset = readIntegerValue().toInt()
+    val raw = readBytes(spanEnd - pos)
+    val quoted = raw.isNotEmpty() && (raw[0].toInt() and PduReader.BYTE_MASK) == PduReader.TEXT_QUOTE
+    val text = if (quoted) raw.copyOfRange(1, raw.size) else raw
+    return String(text.dropLastWhile { it.toInt() == 0 }.toByteArray(), MmsCharsets.forMib(charset))
+}
+
+/** IANA MIBenum charsets that MMS uses (WAP-230-WSP Table 42 and OMA MMS conformance). */
+object MmsCharsets {
+    const val UTF_8 = 106
+    private val names =
+        mapOf(
+            3 to "US-ASCII",
+            4 to "ISO-8859-1",
+            5 to "ISO-8859-2",
+            6 to "ISO-8859-3",
+            7 to "ISO-8859-4",
+            8 to "ISO-8859-5",
+            9 to "ISO-8859-6",
+            10 to "ISO-8859-7",
+            11 to "ISO-8859-8",
+            12 to "ISO-8859-9",
+            17 to "Shift_JIS",
+            18 to "EUC-JP",
+            38 to "EUC-KR",
+            106 to "UTF-8",
+            113 to "GBK",
+            1000 to "UTF-16BE",
+            1013 to "UTF-16BE",
+            1014 to "UTF-16LE",
+            1015 to "UTF-16",
+            2025 to "GB2312",
+            2026 to "Big5",
+        )
+
+    /** The charset for an MIBenum, UTF-8 when unknown or unsupported (0 = "any charset"). */
+    fun forMib(mib: Int): Charset =
+        names[mib]
+            ?.takeIf { Charset.isSupported(it) }
+            ?.let { Charset.forName(it) }
+            ?: Charsets.UTF_8
+}
diff --git a/sable-src/apps/r8/android/messages/src/main/java/org/sableos/messages/core/mms/WspContentTypes.kt b/sable-src/apps/r8/android/messages/src/main/java/org/sableos/messages/core/mms/WspContentTypes.kt
new file mode 100644
