+    @Test
+    fun utf16EncodedStringWithNulOctets() {
+        val text = "Hé".toByteArray(Charsets.UTF_16BE)
+        val subject =
+            Pdu()
+                .octets(1 + 2 + text.size + 2, 0x02, 0x03, 0xF7)
+                .bytes(text)
+                .octets(0, 0)
+                .build()
+        val pdu =
+            Pdu()
+                .octets(0x8C, 0x84, 0x96)
+                .bytes(subject)
+                .octets(0x84, 0x83)
+                .build()
+        assertEquals("Hé", (MmsPduParser.parse(pdu) as RetrieveConf).subject)
+    }
