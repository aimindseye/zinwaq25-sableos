diff --git a/sable-src/src/android/shared/sabledesign/src/main/java/org/sableos/design/SableMiniPlayerPolicy.kt b/sable-src/src/android/shared/sabledesign/src/main/java/org/sableos/design/SableMiniPlayerPolicy.kt
