+        assertTrue(titan.first { it.action == CameraAction.NextMode }.keys.startsWith("→"))
+    }
+
+    // ---- hint dock ------------------------------------------------------------------------------
+
+    @Test fun hintDockKeysResolveToTheirActionsInEveryMode() {
