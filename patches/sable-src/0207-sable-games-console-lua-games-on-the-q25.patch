+++ b/sable-src/apps/r8/android/games/src/console/AndroidManifest.xml
@@ -0,0 +1,25 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Sable Games Console: games written in Lua, run in a sandbox (no internet, no files, no other apps).
+     It reads the motion sensor only while a tilt game or the levelling screen shows, and adds games
+     from a folder the owner picks in the system's folder picker, so it needs no permissions. -->
+<manifest xmlns:android="http://schemas.android.com/apk/res/android"
+    xmlns:tools="http://schemas.android.com/tools">
+    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />
+
+    <application>
+        <!-- The single-game launcher activity from main/ is replaced by the console's. -->
+        <activity
+            android:name="org.sableos.games.MainActivity"
+            tools:node="remove" />
+        <activity
+            android:name="org.sableos.games.console.ConsoleActivity"
+            android:exported="true"
+            android:launchMode="singleTask"
+            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation">
+            <intent-filter>
+                <action android:name="android.intent.action.MAIN" />
+                <category android:name="android.intent.category.LAUNCHER" />
+            </intent-filter>
+        </activity>
+    </application>
+</manifest>
