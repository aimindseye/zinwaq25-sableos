+                                    calendar = cursor.getString(UPCOMING_CALENDAR).orEmpty(),
+                                ),
+                            )
+                        }
+                    }
+                }.orEmpty()
+        } catch (_: SecurityException) {
+            emptyList()
+        } catch (_: IllegalArgumentException) {
+            emptyList()
