From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SableOS <noreply@sableos.invalid>
Date: Wed, 18 Nov 2026 17:00:00 +0000
Subject: [PATCH] cosgrove: keep the API path (/v1) of a Custom server address

A Custom server at https://host:8443/v1 got GET /models (404) because
normalize() dropped a trailing /v1 for every provider. Custom now keeps the
path as typed, and Ollama gets exactly one /v1 (ServerAddress.withSingleV1).
Same change as the sable-src tree edit merged in PR #100, so a re-import
keeps it.
---
diff --git a/sable-src/apps/r8/android/assistant/src/main/java/org/sableos/assistant/core/Provider.kt b/sable-src/apps/r8/android/assistant/src/main/java/org/sableos/assistant/core/Provider.kt
index 69d38bd..0915ff8 100644
--- a/sable-src/apps/r8/android/assistant/src/main/java/org/sableos/assistant/core/Provider.kt
+++ b/sable-src/apps/r8/android/assistant/src/main/java/org/sableos/assistant/core/Provider.kt
@@ -35,7 +35,10 @@ data class AssistantSettings(
     val apiKey: String = "",
     val model: String = "",
 ) {
-    /** The API base the requests go to, or why there is none yet. */
+    /**
+     * The API base the requests go to, or why there is none yet. Ollama gets exactly one /v1; a
+     * Custom server keeps the full API base path as entered (/v1, /api/v1, /openai/v1).
+     */
     fun base(): ApiBase {
         val chosen = provider
         val port = if (chosen == AssistantProvider.Ollama) ServerAddress.OLLAMA_PORT else null
@@ -45,7 +48,7 @@ data class AssistantSettings(
             chosen.hostedBase != null -> ApiBase.Ready(chosen.hostedBase)
             normalized == null -> ApiBase.Problem(SetupProblem.NoAddress)
             !ServerAddress.allowed(normalized) -> ApiBase.Problem(SetupProblem.PlainHttpOutside)
-            chosen == AssistantProvider.Ollama -> ApiBase.Ready("$normalized/v1")
+            chosen == AssistantProvider.Ollama -> ApiBase.Ready(ServerAddress.withSingleV1(normalized))
             else -> ApiBase.Ready(normalized)
         }
     }
diff --git a/sable-src/apps/r8/android/assistant/src/main/java/org/sableos/assistant/core/ServerAddress.kt b/sable-src/apps/r8/android/assistant/src/main/java/org/sableos/assistant/core/ServerAddress.kt
index 7bcfd3b..d4ff6e5 100644
--- a/sable-src/apps/r8/android/assistant/src/main/java/org/sableos/assistant/core/ServerAddress.kt
+++ b/sable-src/apps/r8/android/assistant/src/main/java/org/sableos/assistant/core/ServerAddress.kt
@@ -11,7 +11,12 @@ import java.net.URI
 object ServerAddress {
     const val OLLAMA_PORT = 11434
 
-    /** "scheme://host[:port][/path]" without a trailing slash or /v1, or null when it is not an address. */
+    private const val V1 = "/v1"
+
+    /**
+     * "scheme://host[:port][/path]" without a trailing slash, or null when it is not an address.
+     * The path is kept as typed: a Custom server's API base may be /v1, /api/v1 or /openai/v1.
+     */
     fun normalize(
         input: String,
         defaultPort: Int? = null,
@@ -23,11 +28,7 @@ object ServerAddress {
         val host = uri?.host
         if (uri == null || scheme !in WEB_SCHEMES || host.isNullOrEmpty()) return null
         val port = if (uri.port > 0) uri.port else defaultPort
-        val path =
-            uri.rawPath
-                .orEmpty()
-                .trimEnd('/')
-                .removeSuffix("/v1")
+        val path = uri.rawPath.orEmpty().trimEnd('/')
         return buildString {
             append(scheme).append("://").append(host)
             if (port != null) append(':').append(port)
@@ -35,6 +36,9 @@ object ServerAddress {
         }
     }
 
+    /** The Ollama API base for a [normalized] address: exactly one /v1, whether or not it was typed. */
+    fun withSingleV1(normalized: String): String = normalized.removeSuffix(V1) + V1
+
     /** Whether Cosgrove may talk to [normalized]: https anywhere, plain http only on the owner's network. */
     fun allowed(normalized: String): Boolean {
         val uri = runCatching { URI(normalized) }.getOrNull() ?: return false
diff --git a/sable-src/apps/r8/android/assistant/src/test/java/org/sableos/assistant/core/CoreTest.kt b/sable-src/apps/r8/android/assistant/src/test/java/org/sableos/assistant/core/CoreTest.kt
index a416c01..9ec0a7f 100644
--- a/sable-src/apps/r8/android/assistant/src/test/java/org/sableos/assistant/core/CoreTest.kt
+++ b/sable-src/apps/r8/android/assistant/src/test/java/org/sableos/assistant/core/CoreTest.kt
@@ -11,9 +11,11 @@ class CoreTest {
     @Test
     fun addressesAreNormalizedTheWayPeopleTypeThem() {
         assertEquals("http://192.168.1.20:11434", ServerAddress.normalize("192.168.1.20", ServerAddress.OLLAMA_PORT))
-        assertEquals("http://192.168.1.20:11434", ServerAddress.normalize(" http://192.168.1.20:11434/v1/ ", 1))
+        assertEquals("http://192.168.1.20:11434/v1", ServerAddress.normalize(" http://192.168.1.20:11434/v1/ ", 1))
         assertEquals("http://pc.local:1234", ServerAddress.normalize("pc.local:1234"))
-        assertEquals("https://llm.example.org/api", ServerAddress.normalize("https://llm.example.org/api/v1"))
+        assertEquals("https://llm.example.org/api/v1", ServerAddress.normalize("https://llm.example.org/api/v1"))
+        assertEquals("https://llm.example.org/api/v1", ServerAddress.normalize("https://llm.example.org/api/v1/"))
+        assertEquals("https://box.ts.net:8443/v1", ServerAddress.normalize("https://box.ts.net:8443/v1"))
         assertNull(ServerAddress.normalize(""))
         assertNull(ServerAddress.normalize("ftp://x"))
         assertNull(ServerAddress.normalize("192.168 .1.2"))
@@ -42,6 +44,41 @@ class CoreTest {
         assertFalse(ollama.missingKey())
     }
 
+    @Test
+    fun ollamaGetsExactlyOneV1() {
+        val ollama = AssistantSettings(provider = AssistantProvider.Ollama)
+        val expected = ApiBase.Ready("http://192.168.1.20:11434/v1")
+        listOf(
+            "192.168.1.20",
+            "192.168.1.20:11434",
+            "http://192.168.1.20:11434/",
+            "192.168.1.20:11434/v1",
+            "http://192.168.1.20:11434/v1/",
+        ).forEach { assertEquals(it, expected, ollama.copy(address = it).base()) }
+        assertEquals(
+            ApiBase.Ready("https://box.ts.net:8443/v1"),
+            ollama.copy(address = "https://box.ts.net:8443/v1").base(),
+        )
+    }
+
+    @Test
+    fun customKeepsItsFullApiBasePath() {
+        val custom = AssistantSettings(provider = AssistantProvider.Custom)
+        listOf(
+            "https://box.ts.net:8443/v1" to "https://box.ts.net:8443/v1",
+            "https://box.ts.net:8443/v1/" to "https://box.ts.net:8443/v1",
+            "https://llm.example.org/api/v1" to "https://llm.example.org/api/v1",
+            "https://llm.example.org/openai/v1/" to "https://llm.example.org/openai/v1",
+            "https://box.ts.net:8443" to "https://box.ts.net:8443",
+            "http://pc.local:1234/v1" to "http://pc.local:1234/v1",
+        ).forEach { (typed, base) -> assertEquals(typed, ApiBase.Ready(base), custom.copy(address = typed).base()) }
+        // The requests the client builds from that base: GET <base>/models and POST <base>/chat/completions.
+        val ready = custom.copy(address = "https://box.ts.net:8443/v1").base() as ApiBase.Ready
+        assertEquals("https://box.ts.net:8443/v1/models", "${ready.url}/models")
+        assertEquals("https://box.ts.net:8443/v1/chat/completions", "${ready.url}/chat/completions")
+        assertEquals(ApiBase.Problem(SetupProblem.PlainHttpOutside), custom.copy(address = "http://8.8.8.8/v1").base())
+    }
+
     @Test
     fun theChatBodyCarriesThePersonaAndTheLatestTurns() {
         val turns = (1..25).map { ChatTurn(fromOwner = it % 2 == 1, text = "line \"$it\"\n") }
