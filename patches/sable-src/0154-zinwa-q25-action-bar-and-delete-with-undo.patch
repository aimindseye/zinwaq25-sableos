+    }
+
+    @Test
+    fun theOverflowTakesTheLastSlot() {
+        assertEquals(listOf("a") to listOf("b", "c"), SableActionBarLayout.split(listOf("a", "b", "c")))
+        assertEquals(emptyList<String>() to listOf("a", "b"), SableActionBarLayout.split(listOf("a", "b"), inline = 1))
+    }
+}
