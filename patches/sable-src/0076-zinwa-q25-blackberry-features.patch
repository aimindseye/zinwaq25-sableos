+<?xml version="1.0" encoding="utf-8"?>
+<!-- Sound Profiles: BlackBerry sound profiles. Picking one sets the ringer, Do Not Disturb, the ring
+     and notification volumes, vibration, the notification light and the profile's own tones. No
+     network, no background work: the app and the Quick Settings tile change settings only when the
+     user picks a profile. Do Not Disturb access is granted by default
+     (product/common/overlay/SableFrameworkOverlay/res/values/sable_profiles.xml); system settings
+     access comes with the preinstalled app, or the user allows it once. -->
+<manifest xmlns:android="http://schemas.android.com/apk/res/android"
+    xmlns:tools="http://schemas.android.com/tools">
+
+    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
+    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions" />
+
+    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
+
+    <application
+        android:allowBackup="false"
+        android:usesCleartextTraffic="false"
+        android:icon="@mipmap/ic_sable_profiles"
+        android:roundIcon="@mipmap/ic_sable_profiles_round"
+        android:label="@string/app_name"
+        android:supportsRtl="true"
+        android:theme="@android:style/Theme.DeviceDefault">
+        <activity
+            android:name=".android.SoundProfilesActivity"
+            android:exported="true"
+            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|smallestScreenSize|screenLayout|uiMode">
+            <intent-filter>
+                <action android:name="android.intent.action.MAIN" />
+                <category android:name="android.intent.category.LAUNCHER" />
+            </intent-filter>
+            <!-- Long-press on the Sound profile tile. -->
+            <intent-filter>
+                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
+            </intent-filter>
+        </activity>
+
+        <service
+            android:name=".android.SoundProfileTileService"
+            android:exported="true"
+            android:icon="@drawable/ic_sound_profile"
+            android:label="Sound profile"
+            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
+            <intent-filter>
+                <action android:name="android.service.quicksettings.action.QS_TILE" />
+            </intent-filter>
+        </service>
+    </application>
+</manifest>
