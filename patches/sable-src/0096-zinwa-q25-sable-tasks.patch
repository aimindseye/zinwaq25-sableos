diff --git a/sable-src/apps/r8/android/tasks/src/main/java/org/sableos/tasks/core/TaskRecord.kt b/sable-src/apps/r8/android/tasks/src/main/java/org/sableos/tasks/core/TaskRecord.kt
new file mode 100644
