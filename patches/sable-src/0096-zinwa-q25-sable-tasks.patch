diff --git a/sable-src/apps/r8/android/tasks/src/main/java/org/sableos/tasks/platform/TaskPlatform.kt b/sable-src/apps/r8/android/tasks/src/main/java/org/sableos/tasks/platform/TaskPlatform.kt
new file mode 100644
