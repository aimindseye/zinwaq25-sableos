--- /dev/null
+++ b/sable-src/apps/r8/android/tasks/src/main/java/org/sableos/tasks/core/TaskRecord.kt
@@ -0,0 +1,56 @@
+package org.sableos.tasks.core
+
+import java.time.ZoneId
+import java.util.UUID
+
+enum class TaskPriority { Low, Normal, High }
+
+enum class TaskRepeat { Never, Daily, Weekly, Monthly }
+
+/**
+ * One task, kept in app storage only: no account, no Calendar entry, no sync. Ported from TenSeven
+ * Tasks (aimindseye/tenseven-launcher, Apache-2.0). A follow-up made from a Hub notification keeps
+ * the source app's package and a one-way digest of its key, never the notification's text.
+ */
+data class TaskRecord(
+    val id: String = UUID.randomUUID().toString(),
+    val title: String,
+    val details: String = "",
+    val completed: Boolean = false,
+    val dueAtEpochMs: Long? = null,
+    val remindAtEpochMs: Long? = null,
+    val zoneId: String = ZoneId.systemDefault().id,
+    val priority: TaskPriority = TaskPriority.Normal,
+    val repeat: TaskRepeat = TaskRepeat.Never,
+    val originPackage: String? = null,
+    val originToken: String? = null,
+    val updatedAtEpochMs: Long = System.currentTimeMillis(),
+) {
+    init {
+        require(UUID_PATTERN.matches(id)) { "Invalid task ID" }
+        require(title.isNotBlank() && title.length <= MAX_TITLE) { "Task title is required" }
+        require(details.length <= MAX_DETAILS) { "Task details too long" }
+        require(dueAtEpochMs == null || dueAtEpochMs >= 0) { "Invalid due date" }
+        require(remindAtEpochMs == null || remindAtEpochMs >= 0) { "Invalid reminder date" }
+        require(updatedAtEpochMs >= 0) { "Invalid update time" }
+        require(originPackage == null || (originPackage.isNotBlank() && originPackage.length <= MAX_TITLE))
+        require(originToken == null || originToken.matches(TOKEN_PATTERN))
+        ZoneId.of(zoneId)
+    }
+
+    companion object {
+        const val MAX_TITLE = 240
+        const val MAX_DETAILS = 16_000
+        private val UUID_PATTERN = Regex("[0-9a-f-]{36}")
+        private val TOKEN_PATTERN = Regex("[0-9a-f]{64}")
+
+        /** A task from shared text: the first line is the title, the rest the details. */
+        fun fromSharedText(text: String): TaskRecord? {
+            val trimmed = text.trim()
+            if (trimmed.isEmpty()) return null
+            val title = trimmed.lineSequence().first().trim().take(MAX_TITLE)
+            val details = trimmed.substringAfter('\n', "").trim().take(MAX_DETAILS)
+            return TaskRecord(title = title, details = details)
+        }
+    }
+}
diff --git a/sable-src/apps/r8/android/tasks/src/main/java/org/sableos/tasks/core/TaskRepository.kt b/sable-src/apps/r8/android/tasks/src/main/java/org/sableos/tasks/core/TaskRepository.kt
new file mode 100644
index 0000000..b31292c
--- /dev/null
+++ b/sable-src/apps/r8/android/tasks/src/main/java/org/sableos/tasks/core/TaskRepository.kt
@@ -0,0 +1,98 @@
+package org.sableos.tasks.core
+
+import java.security.MessageDigest
+
+/** Where reminders are scheduled; Android's inexact alarms on the phone, a recorder in tests. */
+interface TaskScheduler {
+    fun cancel(id: String)
+
+    fun schedule(task: TaskRecord)
+}
+
+/**
+ * Tasks and their reminders, independent of any screen. Ported from TenSeven Tasks: the file is
+ * written before alarms change, so a failed write never cancels a reminder that was set.
+ */
+class TaskRepository(
+    private val store: TaskStore,
+    private val scheduler: TaskScheduler,
+    private val now: () -> Long = System::currentTimeMillis,
+) {
+    fun list(): List<TaskRecord> = store.list()
+
+    fun find(id: String): TaskRecord? = list().firstOrNull { it.id == id }
+
+    fun save(task: TaskRecord) {
+        store.save(task)
+        scheduler.cancel(task.id)
+        scheduler.schedule(task)
+    }
+
+    fun delete(id: String) {
+        scheduler.cancel(id)
+        store.delete(id)
+    }
+
+    /** Done (or not done again). A repeating dated task moves to its next occurrence instead. */
+    fun complete(task: TaskRecord): TaskRecord {
+        val next =
+            if (!task.completed && task.repeat != TaskRepeat.Never &&
+                (task.dueAtEpochMs != null || task.remindAtEpochMs != null)
+            ) {
+                task.copy(
+                    dueAtEpochMs = TaskSchedule.advanceAfter(task.dueAtEpochMs, task.repeat, task.zoneId, now()),
+                    remindAtEpochMs = TaskSchedule.advanceAfter(task.remindAtEpochMs, task.repeat, task.zoneId, now()),
+                    updatedAtEpochMs = now(),
+                )
+            } else {
+                task.copy(completed = !task.completed, updatedAtEpochMs = now())
+            }
+        save(next)
+        return next
+    }
+
+    /** Reminder again in an hour (the notification's Snooze 1 hour). */
+    fun snooze(task: TaskRecord): TaskRecord {
+        val next = task.copy(remindAtEpochMs = now() + TaskSchedule.SNOOZE_MILLIS, updatedAtEpochMs = now())
+        save(next)
+        return next
+    }
+
+    /**
+     * A follow-up for one Hub notification, made only when the user asks. Keeps the source app's package
+     * and a SHA-256 of package and key, never the key or the notification's text; asking again for the
+     * same notification updates the open follow-up instead of adding another.
+     */
+    fun followUp(
+        packageName: String,
+        notificationKey: String,
+        title: String,
+        remindAt: Long?,
+    ): TaskRecord {
+        val token = digest(packageName + "\n" + notificationKey)
+        val existing = list().firstOrNull { !it.completed && it.originToken == token }
+        val task =
+            existing?.copy(remindAtEpochMs = remindAt, updatedAtEpochMs = now())
+                ?: TaskRecord(
+                    title = title.take(TaskRecord.MAX_TITLE),
+                    remindAtEpochMs = remindAt,
+                    originPackage = packageName,
+                    originToken = token,
+                    updatedAtEpochMs = now(),
+                )
+        save(task)
+        return task
+    }
+
+    fun rescheduleAll() = list().forEach { scheduler.schedule(it) }
+
+    private fun digest(value: String): String =
+        MessageDigest
+            .getInstance("SHA-256")
+            .digest(value.toByteArray(Charsets.UTF_8))
+            .joinToString("") { "%02x".format(it.toInt() and BYTE_MASK) }
+
+    private companion object {
+        const val BYTE_MASK = 0xFF
+    }
+}
diff --git a/sable-src/apps/r8/android/tasks/src/main/java/org/sableos/tasks/core/TaskSchedule.kt b/sable-src/apps/r8/android/tasks/src/main/java/org/sableos/tasks/core/TaskSchedule.kt
new file mode 100644
index 0000000..dc7dd6d
--- /dev/null
+++ b/sable-src/apps/r8/android/tasks/src/main/java/org/sableos/tasks/core/TaskSchedule.kt
@@ -0,0 +1,131 @@
+package org.sableos.tasks.core
+
+import java.time.Instant
+import java.time.ZoneId
+
+/** The quick reminder times in the editor and on a focused row. */
+enum class ReminderPreset { LaterToday, ThisEvening, TomorrowMorning }
+
+/** List sections, in order. Overdue is past due (or past a reminder) and not done. */
+enum class TaskGroup { Overdue, Today, Tomorrow, ThisWeek, Later, NoDate, Done }
+
+/** Time-zone-aware scheduling, ported from TenSeven Tasks. Reminders are inexact, never exact alarms. */
+object TaskSchedule {
+    const val MORNING_HOUR = 9
+    const val EVENING_HOUR = 18
+    const val LATER_TODAY_HOURS = 2L
+    const val SNOOZE_MILLIS = 60 * 60 * 1000L
+    private const val MAX_STEPS = 4000
+    private const val WEEK_DAYS = 7L
+
+    fun nextOccurrence(
+        epochMs: Long?,
+        repeat: TaskRepeat,
+        zoneName: String,
+    ): Long? {
+        if (epochMs == null || repeat == TaskRepeat.Never) return epochMs
+        val at = Instant.ofEpochMilli(epochMs).atZone(ZoneId.of(zoneName))
+        val shifted =
+            when (repeat) {
+                TaskRepeat.Daily -> at.plusDays(1)
+                TaskRepeat.Weekly -> at.plusWeeks(1)
+                TaskRepeat.Monthly -> at.plusMonths(1)
+                TaskRepeat.Never -> at
+            }
+        return shifted.toInstant().toEpochMilli()
+    }
+
+    /** The first occurrence after [nowMs]; completing a future occurrence still moves to the next one. */
+    fun advanceAfter(
+        epochMs: Long?,
+        repeat: TaskRepeat,
+        zoneName: String,
+        nowMs: Long,
+    ): Long? {
+        val previous = epochMs ?: return null
+        if (repeat == TaskRepeat.Never) return previous
+        var next = nextOccurrence(previous, repeat, zoneName) ?: return null
+        // Bounded, so a corrupt years-old record cannot loop for ever.
+        repeat(MAX_STEPS) {
+            if (next > nowMs) return next
+            next = nextOccurrence(next, repeat, zoneName) ?: return null
+        }
+        return next
+    }
+
+    fun preset(
+        preset: ReminderPreset,
+        now: Instant,
+        zone: ZoneId,
+    ): Long {
+        val local = now.atZone(zone)
+        val at =
+            when (preset) {
+                ReminderPreset.LaterToday -> {
+                    val later = local.plusHours(LATER_TODAY_HOURS)
+                    if (later.toLocalDate() != local.toLocalDate()) {
+                        local.toLocalDate().plusDays(1).atTime(MORNING_HOUR, 0).atZone(zone)
+                    } else {
+                        later
+                    }
+                }
+
+                ReminderPreset.ThisEvening -> {
+                    val today = local.toLocalDate().atTime(EVENING_HOUR, 0).atZone(zone)
+                    if (today.toInstant() > now) today else today.plusDays(1)
+                }
+
+                ReminderPreset.TomorrowMorning -> {
+                    local.toLocalDate().plusDays(1).atTime(MORNING_HOUR, 0).atZone(zone)
+                }
+            }
+        return at.toInstant().toEpochMilli()
+    }
+
+    fun group(
+        task: TaskRecord,
+        now: Instant,
+        zone: ZoneId,
+    ): TaskGroup {
+        if (task.completed) return TaskGroup.Done
+        val nowMs = now.toEpochMilli()
+        val due = task.dueAtEpochMs
+        val remind = task.remindAtEpochMs
+        if ((due != null && due < nowMs) || (due == null && remind != null && remind < nowMs)) return TaskGroup.Overdue
+        val anchor = due ?: remind ?: return TaskGroup.NoDate
+        val date = Instant.ofEpochMilli(anchor).atZone(zone).toLocalDate()
+        val today = now.atZone(zone).toLocalDate()
+        return when {
+            !date.isAfter(today) -> TaskGroup.Today
+            date == today.plusDays(1) -> TaskGroup.Tomorrow
+            !date.isAfter(today.plusDays(WEEK_DAYS)) -> TaskGroup.ThisWeek
+            else -> TaskGroup.Later
+        }
+    }
+
+    /** Sections in order, each sorted by its date (undated by last edit); done ones only when [withDone]. */
+    fun sections(
+        tasks: List<TaskRecord>,
+        withDone: Boolean,
+        now: Instant,
+        zone: ZoneId,
+    ): List<Pair<TaskGroup, List<TaskRecord>>> {
+        val grouped = tasks.groupBy { group(it, now, zone) }
+        return TaskGroup.entries
+            .filter { it != TaskGroup.Done || withDone }
+            .mapNotNull { section ->
+                grouped[section]
+                    ?.sortedWith(
+                        compareBy<TaskRecord> { it.dueAtEpochMs ?: it.remindAtEpochMs ?: Long.MAX_VALUE }
+                            .thenByDescending { it.priority }
+                            .thenByDescending { it.updatedAtEpochMs },
+                    )?.let { section to it }
+            }
+    }
+
+    /** Tasks whose reminder has come and that are not done: what Start and the reminder line count. */
+    fun dueReminders(
+        tasks: List<TaskRecord>,
+        nowMs: Long,
+    ): List<TaskRecord> = tasks.filter { !it.completed && it.remindAtEpochMs != null && it.remindAtEpochMs <= nowMs }
+}
diff --git a/sable-src/apps/r8/android/tasks/src/main/java/org/sableos/tasks/core/TaskStore.kt b/sable-src/apps/r8/android/tasks/src/main/java/org/sableos/tasks/core/TaskStore.kt
new file mode 100644
index 0000000..231b032
--- /dev/null
+++ b/sable-src/apps/r8/android/tasks/src/main/java/org/sableos/tasks/core/TaskStore.kt
@@ -0,0 +1,104 @@
+package org.sableos.tasks.core
+
+import java.io.File
+import java.io.InputStream
+import java.nio.file.AtomicMoveNotSupportedException
+import java.nio.file.Files
+import java.nio.file.StandardCopyOption
+import java.util.Properties
+import java.util.UUID
+
+/**
+ * One file per task in app storage, written atomically (temporary file, then a move), so a failed write
+ * never loses the old copy. Ported from TenSeven Tasks; the format name is Sable's own.
+ */
+class TaskStore(
+    private val directory: File,
+) {
+    fun list(): List<TaskRecord> =
+        directory
+            .listFiles { file -> file.isFile && file.name.endsWith(SUFFIX) }
+            .orEmpty()
+            .mapNotNull { file ->
+                runCatching { decode(file.name.removeSuffix(SUFFIX), file.inputStream().use(::loadProperties)) }.getOrNull()
+            }.sortedWith(compareBy<TaskRecord> { it.completed }.thenByDescending { it.updatedAtEpochMs })
+
+    @Synchronized
+    fun save(task: TaskRecord) {
+        directory.mkdirs()
+        val destination = file(task.id)
+        val temporary = File(directory, task.id + ".tmp-" + UUID.randomUUID())
+        temporary.outputStream().use { properties(task).store(it, "Sable Tasks v1") }
+        try {
+            try {
+                Files.move(
+                    temporary.toPath(),
+                    destination.toPath(),
+                    StandardCopyOption.ATOMIC_MOVE,
+                    StandardCopyOption.REPLACE_EXISTING,
+                )
+            } catch (_: AtomicMoveNotSupportedException) {
+                Files.move(temporary.toPath(), destination.toPath(), StandardCopyOption.REPLACE_EXISTING)
+            }
+        } finally {
+            if (temporary.exists()) Files.delete(temporary.toPath())
+        }
+    }
+
+    fun delete(id: String) {
+        Files.deleteIfExists(file(id).toPath())
+    }
+
+    private fun file(id: String): File {
+        require(ID.matches(id)) { "Invalid task ID" }
+        return File(directory, "$id$SUFFIX")
+    }
+
+    private fun decode(
+        id: String,
+        props: Properties,
+    ): TaskRecord {
+        require(props.getProperty("format") == FORMAT && props.getProperty("version") == "1")
+
+        fun optionalLong(key: String): Long? = props.getProperty(key)?.takeIf(String::isNotBlank)?.toLong()
+        return TaskRecord(
+            id = id,
+            title = props.getProperty("title") ?: error("Missing task title"),
+            details = props.getProperty("details", ""),
+            completed = props.getProperty("completed") == "true",
+            dueAtEpochMs = optionalLong("dueAt"),
+            remindAtEpochMs = optionalLong("remindAt"),
+            zoneId = props.getProperty("zone", "UTC"),
+            priority = TaskPriority.valueOf(props.getProperty("priority", TaskPriority.Normal.name)),
+            repeat = TaskRepeat.valueOf(props.getProperty("repeat", TaskRepeat.Never.name)),
+            originPackage = props.getProperty("originPackage")?.takeIf(String::isNotBlank),
+            originToken = props.getProperty("originToken")?.takeIf(String::isNotBlank),
+            updatedAtEpochMs = props.getProperty("updatedAt", "0").toLong(),
+        )
+    }
+
+    private fun properties(task: TaskRecord) =
+        Properties().apply {
+            setProperty("format", FORMAT)
+            setProperty("version", "1")
+            setProperty("title", task.title)
+            setProperty("details", task.details)
+            setProperty("completed", task.completed.toString())
+            setProperty("dueAt", task.dueAtEpochMs?.toString().orEmpty())
+            setProperty("remindAt", task.remindAtEpochMs?.toString().orEmpty())
+            setProperty("zone", task.zoneId)
+            setProperty("priority", task.priority.name)
+            setProperty("repeat", task.repeat.name)
+            setProperty("updatedAt", task.updatedAtEpochMs.toString())
+            setProperty("originPackage", task.originPackage.orEmpty())
+            setProperty("originToken", task.originToken.orEmpty())
+        }
+
+    private fun loadProperties(stream: InputStream): Properties = Properties().apply { load(stream) }
+
+    private companion object {
+        const val FORMAT = "sable-task"
+        const val SUFFIX = ".task"
+        val ID = Regex("[0-9a-f-]{36}")
+    }
+}
