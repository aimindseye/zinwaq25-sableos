+def patch_colours(theme: pathlib.Path) -> None:
+    """The Sable colours, dark and light, in place of ConnectBot's and of Android's wallpaper colours."""
+    text = theme.read_text(encoding="utf-8")
+    start = text.find("private val lightScheme = lightColorScheme(")
+    end = text.find("\n@Composable\nfun ConnectBotTheme(")
+    if start < 0 or end < start:
+        fail("SABLE_TERMINAL_COLOURS=FAIL_ANCHOR")
+    schemes = (
+        "// SableOS: the Sable colours (sable-src/apps/r8/connectbot/apply_sable_flavor.py).\n"
+        f"private val lightScheme = {sable_scheme('lightColorScheme', SABLE_LIGHT, '')}\n\n"
+        f"private val darkScheme = {sable_scheme('darkColorScheme', SABLE_DARK, '')}\n"
+    )
+    theme.write_text(text[:start] + schemes + text[end:], encoding="utf-8")
+    replace_once(theme, "    dynamicColor: Boolean = true,\n", "    dynamicColor: Boolean = false,\n", "SABLE_TERMINAL_NO_DYNAMIC_COLOUR")
+
