+private enum class CellHighlight { SELECTED, PEER, NONE }
+
+private fun cellHighlight(
+    row: Int,
+    col: Int,
+    selectedRow: Int,
+    selectedCol: Int,
+): CellHighlight =
+    when {
+        row == selectedRow && col == selectedCol -> CellHighlight.SELECTED
+        row == selectedRow || col == selectedCol -> CellHighlight.PEER
+        else -> CellHighlight.NONE
+    }
+
+@Composable
+private fun RowScope.SudokuCell(
+    row: Int,
+    col: Int,
+    cell: Char,
+    highlight: CellHighlight,
+    onSelect: (Int, Int) -> Unit,
+) {
+    val given = isGiven(row, col)
+    val selected = highlight == CellHighlight.SELECTED
+
+    val container =
+        when {
+            selected -> {
+                MaterialTheme.colorScheme.primary
+            }
+
+            highlight == CellHighlight.PEER -> {
+                MaterialTheme.colorScheme.surfaceVariant
+            }
+
+            else -> {
+                MaterialTheme.colorScheme.surface
+            }
+        }
+    val content =
+        when {
+            selected -> {
+                MaterialTheme.colorScheme.onPrimary
+            }
+
+            given -> {
+                MaterialTheme.colorScheme.onSurface
+            }
+
+            else -> {
+                MaterialTheme.colorScheme.primary
+            }
+        }
+
+    Surface(
+        onClick = { onSelect(row, col) },
+        modifier =
+            Modifier
+                .weight(1f)
+                .aspectRatio(1f),
+        shape = RectangleShape,
+        color = container,
+        contentColor = content,
+        border =
+            BorderStroke(
+                0.5.dp,
+                MaterialTheme.colorScheme.outlineVariant,
+            ),
+        tonalElevation = 0.dp,
+    ) {
+        Box(
+            contentAlignment = Alignment.Center,
+        ) {
+            Text(
+                text =
+                    if (cell == '0') {
+                        ""
+                    } else {
+                        cell.toString()
+                    },
+                style = MaterialTheme.typography.titleMedium,
+                fontWeight =
+                    if (given) {
+                        FontWeight.Bold
+                    } else {
+                        FontWeight.Medium
+                    },
+            )
+        }
+    }
