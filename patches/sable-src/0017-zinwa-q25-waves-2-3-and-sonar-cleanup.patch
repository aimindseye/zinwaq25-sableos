diff --git a/sable-src/apps/r8/mail/src/main/java/com/fsck/k9/activity/SableMailKeymap.kt b/sable-src/apps/r8/mail/src/main/java/com/fsck/k9/activity/SableMailKeymap.kt
new file mode 100644
index 0000000..8d76f5a
--- /dev/null
+++ b/sable-src/apps/r8/mail/src/main/java/com/fsck/k9/activity/SableMailKeymap.kt
@@ -0,0 +1,197 @@
+package com.fsck.k9.activity
+
+import android.view.KeyEvent
+
+/**
+ * Sable Mail single-key commands (MAIL_CALENDAR_PRODUCTIVITY_UX.md, "Shared keyboard contract").
+ *
+ * Copied into the Thunderbird checkout by apps/r8/mail/apply_sable_flavor.py. It replaces the
+ * upstream K-9 hotkeys, whose J/K/N/P directions, S (select) and V (archive) disagree with the
+ * Sable contract. The Q25 keyboard has Alt, Shift, Sym and letters but no Fn or Ctrl, so
+ * symbols are matched on the typed character and Ctrl+Enter send is also Alt+Enter.
+ */
+enum class SableMailCommand {
+    COMPOSE,
+    TOP,
+    NEXT,
+    PREVIOUS,
+    REPLY,
+    REPLY_ALL,
+    FORWARD,
+    DELETE,
+    SEARCH,
+    VIEW_MODE,
+    PAGE_DOWN,
+    PAGE_UP,
+    BACK,
+
+    // Upstream K-9 actions kept on keys the Sable contract leaves free.
+    ARCHIVE,
+    SELECT,
+    TOGGLE_FLAG,
+    MOVE,
+    COPY,
+    TOGGLE_READ,
+    REVERSE_SORT,
+}
+
+/** Compose-screen keys: Ctrl+Enter (Alt+Enter on the Q25) sends, Esc cancels. */
+enum class SableComposeCommand {
+    SEND,
+    CANCEL,
+}
+
+/** A key-down reduced to what the keymap needs, so the mapping is testable on the JVM. */
+data class SableMailKeyPress(
+    val keyCode: Int,
+    /** The character the key produces with the current meta state, or null. */
+    val char: Char? = null,
+    val shift: Boolean = false,
+    val alt: Boolean = false,
+    val ctrl: Boolean = false,
+    val repeatCount: Int = 0,
+) {
+    companion object {
+        fun from(event: KeyEvent): SableMailKeyPress {
+            val unicode = event.getUnicodeChar(event.metaState)
+            return SableMailKeyPress(
+                keyCode = event.keyCode,
+                char = if (unicode > 0) unicode.toChar() else null,
+                shift = event.isShiftPressed,
+                alt = event.isAltPressed,
+                ctrl = event.isCtrlPressed || event.isMetaPressed,
+                repeatCount = event.repeatCount,
+            )
+        }
+    }
+}
+
+/** How the message list moves its keyboard focus. */
+enum class SableListMove {
+    NEXT,
+    PREVIOUS,
+    PAGE_DOWN,
+    PAGE_UP,
+    TOP,
+}
+
+object SableMailKeymap {
+    /**
+     * Maps one key-down in the message list or reader to a command, or null when the key is left to
+     * the focused view (and, for [upstreamFallbackAllowed] keys, to upstream handling).
+     *
+     * @param textInputActive a text field (search) has focus: TEXT_INPUT_ALWAYS_WINS, only Esc is taken.
+     */
+    fun command(
+        press: SableMailKeyPress,
+        textInputActive: Boolean,
+    ): SableMailCommand? {
+        val command =
+            when {
+                press.keyCode == KeyEvent.KEYCODE_ESCAPE -> SableMailCommand.BACK
+                textInputActive || press.ctrl -> null
+                // On the Q25 `/` is typed with Alt or Sym, so it is matched on the character.
+                press.char == '/' -> SableMailCommand.SEARCH
+                // Any other Alt chord types a symbol, which is not a command.
+                press.alt -> null
+                press.keyCode == KeyEvent.KEYCODE_SPACE ->
+                    if (press.shift) SableMailCommand.PAGE_UP else SableMailCommand.PAGE_DOWN
+                press.keyCode == KeyEvent.KEYCODE_DEL || press.keyCode == KeyEvent.KEYCODE_FORWARD_DEL ->
+                    SableMailCommand.DELETE.takeIf { !press.shift }
+                press.shift -> null
+                else -> LETTERS[press.keyCode]
+            }
+        // Holding a key repeats only movement and paging; a held D must not delete twice.
+        return command?.takeIf { press.repeatCount == 0 || it in REPEATABLE }
+    }
+
+    /**
+     * Keys the Sable map does not own that may still reach the upstream handler: volume-key and
+     * Left/Right message navigation in the reader. Upstream letter hotkeys never run.
+     */
+    fun upstreamFallbackAllowed(
+        press: SableMailKeyPress,
+        textInputActive: Boolean,
+    ): Boolean =
+        !textInputActive &&
+            !press.ctrl &&
+            !press.alt &&
+            !press.shift &&
+            press.keyCode in UPSTREAM_KEYS
+
+    /** Compose screen: Ctrl+Enter or Alt+Enter sends (MAIL_CTRL_ENTER_SEND), Esc cancels. */
+    fun composeCommand(press: SableMailKeyPress): SableComposeCommand? =
+        when {
+            press.repeatCount > 0 -> null
+            press.keyCode == KeyEvent.KEYCODE_ESCAPE -> SableComposeCommand.CANCEL
+            (press.keyCode == KeyEvent.KEYCODE_ENTER || press.keyCode == KeyEvent.KEYCODE_NUMPAD_ENTER) &&
+                (press.ctrl || press.alt) -> SableComposeCommand.SEND
+            else -> null
+        }
+
+    /**
+     * Adapter position the message list focuses for [move], or null for an empty list.
+     *
+     * @param focused the focused position, or -1 when no row has focus.
+     */
+    fun listTarget(
+        move: SableListMove,
+        focused: Int,
+        firstVisible: Int,
+        lastVisible: Int,
+        itemCount: Int,
+    ): Int? {
+        if (itemCount <= 0) return null
+        val anchor = if (focused >= 0) focused else firstVisible.coerceAtLeast(0)
+        val page = (lastVisible - firstVisible).coerceAtLeast(1)
+        val target =
+            when (move) {
+                SableListMove.TOP -> 0
+                SableListMove.NEXT -> if (focused >= 0) focused + 1 else anchor
+                SableListMove.PREVIOUS -> if (focused >= 0) focused - 1 else anchor
+                SableListMove.PAGE_DOWN -> anchor + page
+                SableListMove.PAGE_UP -> anchor - page
+            }
+        return target.coerceIn(0, itemCount - 1)
+    }
+
+    private val LETTERS =
+        mapOf(
+            KeyEvent.KEYCODE_C to SableMailCommand.COMPOSE,
+            KeyEvent.KEYCODE_T to SableMailCommand.TOP,
+            KeyEvent.KEYCODE_J to SableMailCommand.NEXT,
+            KeyEvent.KEYCODE_N to SableMailCommand.NEXT,
+            KeyEvent.KEYCODE_K to SableMailCommand.PREVIOUS,
+            KeyEvent.KEYCODE_P to SableMailCommand.PREVIOUS,
+            KeyEvent.KEYCODE_R to SableMailCommand.REPLY,
+            KeyEvent.KEYCODE_A to SableMailCommand.REPLY_ALL,
+            KeyEvent.KEYCODE_F to SableMailCommand.FORWARD,
+            KeyEvent.KEYCODE_D to SableMailCommand.DELETE,
+            KeyEvent.KEYCODE_S to SableMailCommand.SEARCH,
+            KeyEvent.KEYCODE_V to SableMailCommand.VIEW_MODE,
+            KeyEvent.KEYCODE_O to SableMailCommand.VIEW_MODE,
+            KeyEvent.KEYCODE_E to SableMailCommand.ARCHIVE,
+            KeyEvent.KEYCODE_X to SableMailCommand.SELECT,
+            KeyEvent.KEYCODE_G to SableMailCommand.TOGGLE_FLAG,
+            KeyEvent.KEYCODE_M to SableMailCommand.MOVE,
+            KeyEvent.KEYCODE_Y to SableMailCommand.COPY,
+            KeyEvent.KEYCODE_Z to SableMailCommand.TOGGLE_READ,
+            KeyEvent.KEYCODE_I to SableMailCommand.REVERSE_SORT,
+        )
+
+    private val REPEATABLE =
+        setOf(
+            SableMailCommand.NEXT,
+            SableMailCommand.PREVIOUS,
+            SableMailCommand.PAGE_DOWN,
+            SableMailCommand.PAGE_UP,
+        )
+
+    private val UPSTREAM_KEYS =
+        setOf(
+            KeyEvent.KEYCODE_VOLUME_UP,
+            KeyEvent.KEYCODE_VOLUME_DOWN,
+            KeyEvent.KEYCODE_DPAD_LEFT,
+            KeyEvent.KEYCODE_DPAD_RIGHT,
+        )
+}
diff --git a/sable-src/apps/r8/mail/src/test/java/com/fsck/k9/activity/SableMailKeymapTest.kt b/sable-src/apps/r8/mail/src/test/java/com/fsck/k9/activity/SableMailKeymapTest.kt
new file mode 100644
index 0000000..8b33368
--- /dev/null
+++ b/sable-src/apps/r8/mail/src/test/java/com/fsck/k9/activity/SableMailKeymapTest.kt
@@ -0,0 +1,152 @@
+package com.fsck.k9.activity
+
+import android.view.KeyEvent
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class SableMailKeymapTest {
+    private fun press(
+        keyCode: Int,
+        char: Char? = null,
+        shift: Boolean = false,
+        alt: Boolean = false,
+        ctrl: Boolean = false,
+        repeat: Int = 0,
+    ) = SableMailKeyPress(keyCode, char, shift, alt, ctrl, repeat)
+
+    private fun cmd(
+        press: SableMailKeyPress,
+        typing: Boolean = false,
+    ) = SableMailKeymap.command(press, textInputActive = typing)
+
+    @Test
+    fun sharedContractKeys() {
+        assertEquals(SableMailCommand.COMPOSE, cmd(press(KeyEvent.KEYCODE_C, 'c')))
+        assertEquals(SableMailCommand.TOP, cmd(press(KeyEvent.KEYCODE_T, 't')))
+        assertEquals(SableMailCommand.NEXT, cmd(press(KeyEvent.KEYCODE_J, 'j')))
+        assertEquals(SableMailCommand.NEXT, cmd(press(KeyEvent.KEYCODE_N, 'n')))
+        assertEquals(SableMailCommand.PREVIOUS, cmd(press(KeyEvent.KEYCODE_K, 'k')))
+        assertEquals(SableMailCommand.PREVIOUS, cmd(press(KeyEvent.KEYCODE_P, 'p')))
+        assertEquals(SableMailCommand.REPLY, cmd(press(KeyEvent.KEYCODE_R, 'r')))
+        assertEquals(SableMailCommand.DELETE, cmd(press(KeyEvent.KEYCODE_D, 'd')))
+        assertEquals(SableMailCommand.DELETE, cmd(press(KeyEvent.KEYCODE_DEL)))
+        assertEquals(SableMailCommand.DELETE, cmd(press(KeyEvent.KEYCODE_FORWARD_DEL)))
+        assertEquals(SableMailCommand.SEARCH, cmd(press(KeyEvent.KEYCODE_S, 's')))
+        assertEquals(SableMailCommand.SEARCH, cmd(press(KeyEvent.KEYCODE_SLASH, '/')))
+        assertEquals(SableMailCommand.VIEW_MODE, cmd(press(KeyEvent.KEYCODE_V, 'v')))
+        assertEquals(SableMailCommand.BACK, cmd(press(KeyEvent.KEYCODE_ESCAPE)))
+        assertNull("Enter opens the focused row natively", cmd(press(KeyEvent.KEYCODE_ENTER)))
+    }
+
+    @Test
+    fun replyAllAndForward() {
+        assertEquals(SableMailCommand.REPLY_ALL, cmd(press(KeyEvent.KEYCODE_A, 'a')))
+        assertEquals(SableMailCommand.FORWARD, cmd(press(KeyEvent.KEYCODE_F, 'f')))
+    }
+
+    @Test
+    fun upstreamActionsKeptOnFreeKeys() {
+        assertEquals(SableMailCommand.ARCHIVE, cmd(press(KeyEvent.KEYCODE_E, 'e')))
+        assertEquals(SableMailCommand.SELECT, cmd(press(KeyEvent.KEYCODE_X, 'x')))
+        assertEquals(SableMailCommand.TOGGLE_FLAG, cmd(press(KeyEvent.KEYCODE_G, 'g')))
+        assertEquals(SableMailCommand.MOVE, cmd(press(KeyEvent.KEYCODE_M, 'm')))
+        assertEquals(SableMailCommand.COPY, cmd(press(KeyEvent.KEYCODE_Y, 'y')))
+        assertEquals(SableMailCommand.TOGGLE_READ, cmd(press(KeyEvent.KEYCODE_Z, 'z')))
+        assertEquals(SableMailCommand.VIEW_MODE, cmd(press(KeyEvent.KEYCODE_O, 'o')))
+        assertEquals(SableMailCommand.REVERSE_SORT, cmd(press(KeyEvent.KEYCODE_I, 'i')))
+    }
+
+    @Test
+    fun spaceIsExplicitPaging() {
+        assertEquals(SableMailCommand.PAGE_DOWN, cmd(press(KeyEvent.KEYCODE_SPACE, ' ')))
+        assertEquals(SableMailCommand.PAGE_UP, cmd(press(KeyEvent.KEYCODE_SPACE, ' ', shift = true)))
+    }
+
+    @Test
+    fun slashTypedWithAltOrSymStillSearches() {
+        assertEquals(SableMailCommand.SEARCH, cmd(press(KeyEvent.KEYCODE_O, '/', alt = true)))
+    }
+
+    @Test
+    fun otherAltShiftAndCtrlChordsAreNotCommands() {
+        assertNull(cmd(press(KeyEvent.KEYCODE_R, '3', alt = true)))
+        assertNull(cmd(press(KeyEvent.KEYCODE_D, 'D', shift = true)))
+        assertNull(cmd(press(KeyEvent.KEYCODE_C, 'c', ctrl = true)))
+        assertNull(cmd(press(KeyEvent.KEYCODE_DEL, shift = true)))
+    }
+
+    @Test
+    fun textInputAlwaysWins() {
+        listOf(
+            press(KeyEvent.KEYCODE_D, 'd'),
+            press(KeyEvent.KEYCODE_DEL),
+            press(KeyEvent.KEYCODE_SPACE, ' '),
+            press(KeyEvent.KEYCODE_J, 'j'),
+            press(KeyEvent.KEYCODE_SLASH, '/'),
+            press(KeyEvent.KEYCODE_C, 'c'),
+        ).forEach { assertNull("$it while typing", cmd(it, typing = true)) }
+        assertEquals(SableMailCommand.BACK, cmd(press(KeyEvent.KEYCODE_ESCAPE), typing = true))
+        assertFalse(SableMailKeymap.upstreamFallbackAllowed(press(KeyEvent.KEYCODE_DPAD_LEFT), textInputActive = true))
+    }
+
+    @Test
+    fun heldKeysRepeatOnlyMovementAndPaging() {
+        assertNull(cmd(press(KeyEvent.KEYCODE_D, 'd', repeat = 1)))
+        assertNull(cmd(press(KeyEvent.KEYCODE_DEL, repeat = 3)))
+        assertNull(cmd(press(KeyEvent.KEYCODE_C, 'c', repeat = 1)))
+        assertEquals(SableMailCommand.NEXT, cmd(press(KeyEvent.KEYCODE_J, 'j', repeat = 4)))
+        assertEquals(SableMailCommand.PAGE_DOWN, cmd(press(KeyEvent.KEYCODE_SPACE, ' ', repeat = 2)))
+    }
+
+    @Test
+    fun onlyVolumeAndLeftRightReachUpstream() {
+        assertTrue(SableMailKeymap.upstreamFallbackAllowed(press(KeyEvent.KEYCODE_VOLUME_UP), false))
+        assertTrue(SableMailKeymap.upstreamFallbackAllowed(press(KeyEvent.KEYCODE_DPAD_RIGHT), false))
+        // Upstream J = previous and S = select disagree with the Sable contract, so they never run.
+        assertFalse(SableMailKeymap.upstreamFallbackAllowed(press(KeyEvent.KEYCODE_J, 'j'), false))
+        assertFalse(SableMailKeymap.upstreamFallbackAllowed(press(KeyEvent.KEYCODE_S, 's'), false))
+        assertFalse(SableMailKeymap.upstreamFallbackAllowed(press(KeyEvent.KEYCODE_Q, 'q'), false))
+    }
+
+    @Test
+    fun composeSendAndCancel() {
+        assertEquals(
+            SableComposeCommand.SEND,
+            SableMailKeymap.composeCommand(press(KeyEvent.KEYCODE_ENTER, ctrl = true)),
+        )
+        assertEquals(
+            SableComposeCommand.SEND,
+            SableMailKeymap.composeCommand(press(KeyEvent.KEYCODE_ENTER, alt = true)),
+        )
+        assertNull(SableMailKeymap.composeCommand(press(KeyEvent.KEYCODE_ENTER)))
+        assertNull(SableMailKeymap.composeCommand(press(KeyEvent.KEYCODE_ENTER, alt = true, repeat = 1)))
+        assertEquals(SableComposeCommand.CANCEL, SableMailKeymap.composeCommand(press(KeyEvent.KEYCODE_ESCAPE)))
+        assertNull(SableMailKeymap.composeCommand(press(KeyEvent.KEYCODE_D, 'd')))
+    }
+
+    @Test
+    fun listTargets() {
+        // 20 rows, rows 5..12 visible, row 7 focused.
+        fun target(
+            move: SableListMove,
+            focused: Int = 7,
+        ) = SableMailKeymap.listTarget(move, focused, firstVisible = 5, lastVisible = 12, itemCount = 20)
+        assertEquals(8, target(SableListMove.NEXT))
+        assertEquals(6, target(SableListMove.PREVIOUS))
+        assertEquals(14, target(SableListMove.PAGE_DOWN))
+        assertEquals(0, target(SableListMove.PAGE_UP))
+        assertEquals(0, target(SableListMove.TOP))
+        // Nothing focused: the first move lands on the first visible row.
+        assertEquals(5, target(SableListMove.NEXT, focused = -1))
+        assertEquals(5, target(SableListMove.PREVIOUS, focused = -1))
+        assertEquals(12, target(SableListMove.PAGE_DOWN, focused = -1))
+        // Clamped at both ends; empty list has no target.
+        assertEquals(19, SableMailKeymap.listTarget(SableListMove.NEXT, 19, 15, 19, 20))
+        assertEquals(19, SableMailKeymap.listTarget(SableListMove.PAGE_DOWN, 18, 15, 19, 20))
+        assertEquals(0, SableMailKeymap.listTarget(SableListMove.PREVIOUS, 0, 0, 4, 20))
+        assertNull(SableMailKeymap.listTarget(SableListMove.TOP, -1, -1, -1, 0))
+    }
+}
