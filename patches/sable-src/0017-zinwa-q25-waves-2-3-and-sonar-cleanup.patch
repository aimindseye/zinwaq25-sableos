+                if (event.type == KeyEventType.KeyDown) onSend()
+                true
+            }
+
+            ComposerEnterAction.Swallow -> {
+                true
+            }
+
+            ComposerEnterAction.Newline,
+            ComposerEnterAction.PassThrough,
+            -> {
+                false
+            }
+        }
+    }
