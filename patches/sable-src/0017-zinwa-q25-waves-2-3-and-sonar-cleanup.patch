+            snapshot = snapshot,
+            conversation = conversation,
+            statusMessage = state.statusMessage,
+            onStatus = { state.statusMessage = it },
+            onBack = onBack,
+            onDial = { number -> state.dial(number, actions.onDial) },
+            actions = actions,
