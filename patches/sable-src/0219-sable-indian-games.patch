+            "Lucia",
+            "Diego",
+            "Liam",
+            "Emma",
+            "Noah",
+            "Olivia",
+            "Jack",
+            "Chloe",
+            "Chen",
+            "Mei",
+            "Haru",
+            "Yuki",
+            "Jin",
+            "Min-ji",
+            "Amara",
+            "Kofi",
+            "Zola",
+            "Tunde",
+            "Nia",
+            "Sipho",
+            "Omar",
+            "Layla",
+            "Yusuf",
+            "Fatima",
+            "Karim",
+            "Noor",
+            "Ivan",
+            "Katya",
+            "Lars",
+            "Freya",
+            "Marco",
+            "Giulia",
+            "Elena",
+            "Pavel",
+            "Anika",
+            "Mia",
+            "Leo",
+            "Zara",
+        )
+
+    /** [count] different names, none of them in [exclude]. */
+    fun pick(
+        random: Random,
+        count: Int,
+        exclude: Set<String> = emptySet(),
+    ): List<String> = POOL.filter { it !in exclude }.shuffled(random).take(count)
+
+    fun size(): Int = POOL.size
