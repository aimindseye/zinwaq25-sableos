+    }
+
+    @Test
+    fun rummyJokerCanCompleteAnImpureSequenceButNotThePureOne() {
+        val hand =
+            listOf(
+                c(4, 1),
+                c(5, 1),
+                c(6, 1),
+                c(10, 0),
+                jokerCard(),
+                c(12, 0),
+                c(9, 3),
+                c(9, 2),
