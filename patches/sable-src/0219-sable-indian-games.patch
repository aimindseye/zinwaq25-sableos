+    @Test
+    fun snakesAndLaddersJumpAndNeedAnExactFinish() {
+        val g = SnakesGame.start(listOf("You", "Maria"))
+        assertEquals(25, g.move(4).pos[0])
+        val onSnake = g.copy(pos = listOf(52, 0)).move(6)
