+                            optionsFor = null
+                        },
+                    ).filterIndexed { i, _ -> !(i == 0 && index == 0) && !(i == 1 && index == draft.glanceWidgets.lastIndex) },
+                )
+            }
+        }
+        item(key = "glance-add") {
