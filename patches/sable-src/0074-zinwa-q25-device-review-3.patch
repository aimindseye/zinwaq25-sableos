     /** Milliseconds from [nowMillisOfDay] to the next midnight, when the date line changes. */
     fun millisToMidnight(nowMillisOfDay: Long): Long = (DAY_MS - nowMillisOfDay.mod(DAY_MS)).coerceAtLeast(1L)
 
