From 0586bce10329a64f02e610e9abfdaa7f9f5a7b51 Mon Sep 17 00:00:00 2001
From: SableOS <noreply@sableos.invalid>
Date: Wed, 14 Oct 2026 23:14:29 +0000
Subject: [PATCH 1041/1042] SableOS: pure Browser keyboard model

The Sable Browser key model (BROWSER_WEBVIEW_UX) for a keyboard with
Alt, Shift and Sym but no Ctrl or Fn key, such as the Zinwa Q25. The
design's Ctrl chords map to Alt; Ctrl still works on an external
keyboard.

* Before the page sees a key, only chords: Alt+L address bar, Alt+T
  new tab, Alt+F find, Alt+R reload, Alt+Left back, Alt+Right forward.
* Once the page has declined a key: L address bar, T new tab, F or /
  find (/ is Alt+G on the Q25), B back, Space and Shift+Space page
  down and up, Move Home and Move End top and bottom.
* Nothing fires while a text field (web form, address bar, find) has
  focus. Only paging repeats when held.

Pure Java (sable/SableBrowserKeys.java), so Android.bp also compiles
Java sources. Host tests live in the SableOS Q25 repository under
tests/java/stock-apps/Jelly.
---
 app/Android.bp                                |   1 +
 .../jelly/sable/SableBrowserKeys.java         | 166 ++++++++++++++++++
 2 files changed, 167 insertions(+)
 create mode 100644 app/src/main/java/org/lineageos/jelly/sable/SableBrowserKeys.java

diff --git a/app/Android.bp b/app/Android.bp
index 1500f12..cc58038 100644
--- a/app/Android.bp
+++ b/app/Android.bp
@@ -12,6 +12,7 @@ android_app {
 
     srcs: [
         "src/main/java/**/*.kt",
+        "src/main/java/**/*.java",
     ],
     resource_dirs: ["src/main/res"],
     asset_dirs: ["src/main/assets"],
diff --git a/app/src/main/java/org/lineageos/jelly/sable/SableBrowserKeys.java b/app/src/main/java/org/lineageos/jelly/sable/SableBrowserKeys.java
new file mode 100644
index 0000000..e9a1ccc
--- /dev/null
+++ b/app/src/main/java/org/lineageos/jelly/sable/SableBrowserKeys.java
@@ -0,0 +1,166 @@
+/*
+ * SPDX-FileCopyrightText: The SableOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.jelly.sable;
+
+/**
+ * The Browser keyboard model for a keyboard with Alt, Shift and Sym but no Ctrl or Fn key
+ * (BROWSER_WEBVIEW_UX "Recommended Browser key model"; the design's Ctrl/Fn chords map to Alt,
+ * and Ctrl still works on an external keyboard). Pure Java so it can be tested on the host.
+ *
+ * <p>Two stages, matching where WebView lets the app see a key:
+ *
+ * <ul>
+ *   <li>{@link #beforePage}: before the page sees the key (WebViewClient.shouldOverrideKeyEvent).
+ *       Only Alt (or Ctrl) chords: Alt+L address, Alt+T new tab, Alt+F find, Alt+R reload,
+ *       Alt+Left back, Alt+Right forward.
+ *   <li>{@link #afterPage}: after the page declined the key (WebViewClient.onUnhandledKeyEvent),
+ *       or when no page has focus. Single keys: L address, T new tab, F or / find, B back,
+ *       Space and Shift+Space page down and up, Move Home and Move End top and bottom.
+ * </ul>
+ *
+ * <p>Input guard (TEXT_INPUT_ALWAYS_WINS, WEB_FORM_INPUT_NOT_HIJACKED): nothing here fires while
+ * a text field (a web form, the address bar or find) has focus. On this keyboard Alt+letter types
+ * the letter's symbol, so an Alt chord never fires while typing either. A page that handles a key
+ * itself keeps it: single keys are only looked at once the page has declined them.
+ */
+public final class SableBrowserKeys {
+
+    /** What a key does. */
+    public enum Action {
+        /** Focus the address bar and select its text. */
+        FOCUS_ADDRESS,
+        /** Open a new tab (private when the current one is private). */
+        NEW_TAB,
+        /** Open find in page. */
+        FIND,
+        /** Go back one page, if there is one. */
+        BACK,
+        /** Go forward one page, if there is one. */
+        FORWARD,
+        /** Reload the page. */
+        RELOAD,
+        /** Move the page one block down. */
+        PAGE_DOWN,
+        /** Move the page one block up. */
+        PAGE_UP,
+        /** Go to the top of the page. */
+        TOP,
+        /** Go to the bottom of the page. */
+        BOTTOM,
+        /** Not a Browser shortcut: leave the key alone. */
+        NONE
+    }
+
+    // android.view.KeyEvent key codes (mirrored so this class stays pure Java).
+    static final int KEYCODE_DPAD_LEFT = 21;
+    static final int KEYCODE_DPAD_RIGHT = 22;
+    static final int KEYCODE_B = 30;
+    static final int KEYCODE_F = 34;
+    static final int KEYCODE_L = 40;
+    static final int KEYCODE_R = 46;
+    static final int KEYCODE_T = 48;
+    static final int KEYCODE_SPACE = 62;
+    static final int KEYCODE_SLASH = 76;
+    static final int KEYCODE_MOVE_HOME = 122;
+    static final int KEYCODE_MOVE_END = 123;
+
+    private SableBrowserKeys() {}
+
+    /**
+     * A key before the page has seen it.
+     *
+     * @param keyCode the KeyEvent key code
+     * @param alt Alt is held
+     * @param ctrl Ctrl is held (external keyboards)
+     * @param shift Shift is held
+     * @param meta Meta is held
+     * @param editing a text field has focus (web form, address bar or find)
+     */
+    public static Action beforePage(
+            int keyCode, boolean alt, boolean ctrl, boolean shift, boolean meta, boolean editing) {
+        if (editing || meta || shift || alt == ctrl) {
+            // Exactly one of Alt and Ctrl: Alt+Ctrl chords are not ours.
+            return Action.NONE;
+        }
+        switch (keyCode) {
+            case KEYCODE_L:
+                return Action.FOCUS_ADDRESS;
+            case KEYCODE_T:
+                return Action.NEW_TAB;
+            case KEYCODE_F:
+                return Action.FIND;
+            case KEYCODE_R:
+                return Action.RELOAD;
+            case KEYCODE_DPAD_LEFT:
+                return Action.BACK;
+            case KEYCODE_DPAD_RIGHT:
+                return Action.FORWARD;
+            default:
+                return Action.NONE;
+        }
+    }
+
+    /**
+     * A key the page did not handle, or a key while no page has focus.
+     *
+     * @param keyCode the KeyEvent key code
+     * @param unicodeChar the character the key produces with its modifiers, 0 if none (on this
+     *     keyboard "/" is Alt+G)
+     * @param alt Alt is held
+     * @param ctrl Ctrl is held
+     * @param shift Shift is held
+     * @param meta Meta is held
+     * @param editing a text field has focus
+     */
+    public static Action afterPage(
+            int keyCode,
+            int unicodeChar,
+            boolean alt,
+            boolean ctrl,
+            boolean shift,
+            boolean meta,
+            boolean editing) {
+        if (editing || ctrl || meta) {
+            return Action.NONE;
+        }
+        if (unicodeChar == '/' || (keyCode == KEYCODE_SLASH && !alt && !shift)) {
+            return Action.FIND;
+        }
+        if (alt) {
+            return Action.NONE;
+        }
+        if (keyCode == KEYCODE_SPACE) {
+            return shift ? Action.PAGE_UP : Action.PAGE_DOWN;
+        }
+        if (shift) {
+            return Action.NONE;
+        }
+        switch (keyCode) {
+            case KEYCODE_L:
+                return Action.FOCUS_ADDRESS;
+            case KEYCODE_T:
+                return Action.NEW_TAB;
+            case KEYCODE_F:
+                return Action.FIND;
+            case KEYCODE_B:
+                return Action.BACK;
+            case KEYCODE_MOVE_HOME:
+                return Action.TOP;
+            case KEYCODE_MOVE_END:
+                return Action.BOTTOM;
+            default:
+                return Action.NONE;
+        }
+    }
+
+    /**
+     * Whether a held key repeats the action. Only paging repeats; every other action runs once
+     * per press, so a held key never opens a row of tabs.
+     */
+    public static boolean repeats(Action action) {
+        return action == Action.PAGE_DOWN || action == Action.PAGE_UP;
+    }
+}
