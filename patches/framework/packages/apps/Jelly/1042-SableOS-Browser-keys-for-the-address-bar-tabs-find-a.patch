+    // SableOS: Browser keys. Alt chords are looked at before the page; single keys only once the
+    // page has declined them, so a page's own shortcuts and every text field keep their keys.
+    override fun shouldOverrideKeyEvent(view: WebView, event: KeyEvent) =
+        (context as? WebViewExtActivity)?.onBrowserKey(view, event, beforePage = true) == true ||
+                super.shouldOverrideKeyEvent(view, event)
+
+    override fun onUnhandledKeyEvent(view: WebView, event: KeyEvent) {
+        val activity = context as? WebViewExtActivity
+        if (activity?.onBrowserKey(view, event, beforePage = false) == true) {
+            return
+        }
+        super.onUnhandledKeyEvent(view, event)
+    }
