+    // SableOS: Browser keyboard model (sable/SableBrowserKeys.java). Keys the page saw come
+    // through WebClient; this covers keys while no page has focus.
+    override fun onKeyDown(keyCode: Int, event: KeyEvent): Boolean {
+        if (currentFocus !is WebView &&
+            (onBrowserKey(null, event, beforePage = true) ||
+                    onBrowserKey(null, event, beforePage = false))
+        ) {
+            return true
+        }
+        return super.onKeyDown(keyCode, event)
+    }
+
+    override fun onBrowserKey(view: WebView?, event: KeyEvent, beforePage: Boolean): Boolean {
+        if (customView != null || !::webView.isInitialized) {
+            // A fullscreen video owns its keys.
+            return false
+        }
+        val editing = view?.onCheckIsTextEditor() ?: (currentFocus?.onCheckIsTextEditor() == true)
+        val action = when (beforePage) {
+            true -> SableBrowserKeys.beforePage(
+                event.keyCode, event.isAltPressed, event.isCtrlPressed,
+                event.isShiftPressed, event.isMetaPressed, editing
+            )
+
+            false -> SableBrowserKeys.afterPage(
+                event.keyCode, event.getUnicodeChar(event.metaState), event.isAltPressed,
+                event.isCtrlPressed, event.isShiftPressed, event.isMetaPressed, editing
+            )
+        }
+        if (action == SableBrowserKeys.Action.NONE) {
+            return false
+        }
+        // The release and the repeats of a shortcut are consumed too; only paging repeats.
+        if (event.action == KeyEvent.ACTION_DOWN &&
+            (event.repeatCount == 0 || SableBrowserKeys.repeats(action))
+        ) {
+            runBrowserAction(action)
+        }
+        return true
+    }
+
+    private fun runBrowserAction(action: SableBrowserKeys.Action) {
+        when (action) {
+            SableBrowserKeys.Action.FOCUS_ADDRESS -> if (appBarLayout.isVisible) {
+                urlBarLayout.focusUrlBar()
+            }
+
+            SableBrowserKeys.Action.NEW_TAB -> openInNewTab(this, null, incognito)
+            SableBrowserKeys.Action.FIND -> if (appBarLayout.isVisible) {
+                showSearch()
+            }
+
+            SableBrowserKeys.Action.BACK -> if (webView.canGoBack()) {
+                webView.goBack()
+            }
+
+            SableBrowserKeys.Action.FORWARD -> if (webView.canGoForward()) {
+                webView.goForward()
+            }
+
+            SableBrowserKeys.Action.RELOAD -> webView.reload()
+            SableBrowserKeys.Action.PAGE_DOWN -> webView.pageDown(false)
+            SableBrowserKeys.Action.PAGE_UP -> webView.pageUp(false)
+            SableBrowserKeys.Action.TOP -> webView.pageUp(true)
+            SableBrowserKeys.Action.BOTTOM -> webView.pageDown(true)
+            SableBrowserKeys.Action.NONE -> Unit
+        }
+    }
