+package org.lineageos.jelly.sable
+
+/**
+ * SableOS: reader mode, link mode and the block position, as small scripts run in the page with
+ * WebView.evaluateJavascript (they need the page's JavaScript setting on).
+ *
+ * Reader mode rebuilds the page from its own headings, paragraphs, lists, quotes, code and images
+ * (the article or main element when there is one), in one readable column, with every attribute
+ * except href, src and alt dropped. It adds nothing from outside the page and sends nothing
+ * anywhere; R again reloads the original page.
+ */
+object SableReader {
+    const val READER_ON = """(function(){
+var root=document.querySelector('article')||document.querySelector('main')||document.body;
+if(!root)return 'none';
+var keep={'H1':1,'H2':1,'H3':1,'H4':1,'P':1,'LI':1,'PRE':1,'BLOCKQUOTE':1,'IMG':1};
+var nodes=root.querySelectorAll('h1,h2,h3,h4,p,li,pre,blockquote,img');
+var out=document.createElement('div');out.id='sable-reader';
+var h=document.createElement('h1');h.textContent=document.title||location.hostname;out.appendChild(h);
+var s=document.createElement('div');s.className='src';s.textContent=location.hostname+' · simplified reader';out.appendChild(s);
+var n=0;
+for(var i=0;i<nodes.length;i++){var e=nodes[i];
+ if(!keep[e.tagName])continue;
+ if(e.parentElement&&e.parentElement.closest('p,li,pre,blockquote'))continue;
+ if(e.tagName!=='IMG'&&!(e.textContent||'').trim())continue;
+ var c=e.cloneNode(true);
+ var all=[c].concat([].slice.call(c.querySelectorAll('*')));
+ all.forEach(function(x){[].slice.call(x.attributes).forEach(function(a){
+  if(a.name!=='href'&&a.name!=='src'&&a.name!=='alt')x.removeAttribute(a.name);});
+  if(x.tagName==='SCRIPT'||x.tagName==='STYLE'||x.tagName==='IFRAME')x.remove();});
+ out.appendChild(c);n++;}
+if(n<2)return 'none';
+document.head.innerHTML='<meta name="viewport" content="width=device-width,initial-scale=1">'+
+'<style>body{margin:0;padding:16px;font:18px/1.55 sans-serif;max-width:40em;color:#e8eaed;background:#0b0f14}'+
+'#sable-reader .src{color:#9aa4ad;font-size:14px;margin-bottom:12px}img{max-width:100%;height:auto}'+
+'a{color:#7cc8ff}a:focus{outline:2px solid #7cc8ff;outline-offset:2px}pre{white-space:pre-wrap}'+
+'blockquote{border-left:2px solid #445;margin:0;padding-left:12px}'+
+'@media (prefers-color-scheme: light){body{color:#111;background:#fff}#sable-reader .src{color:#555}a{color:#0b57d0}}</style>';
+document.body.innerHTML='';document.body.appendChild(out);window.scrollTo(0,0);
+return 'on';})()"""
+
+    /** Moves focus to the next (or previous) visible link and scrolls it to the middle. */
+    fun linkScript(next: Boolean) = """(function(next){
+if(!document.getElementById('sable-link-style')){var st=document.createElement('style');st.id='sable-link-style';
+st.textContent='a:focus{outline:2px solid #7cc8ff !important;outline-offset:2px}';(document.head||document.body).appendChild(st);}
+var a=[].slice.call(document.querySelectorAll('a[href]')).filter(function(e){var r=e.getBoundingClientRect();return r.width>0&&r.height>0;});
+if(!a.length)return 0;
+var i=a.indexOf(document.activeElement);
+if(i<0){i=0;for(var k=0;k<a.length;k++){if(a[k].getBoundingClientRect().top>=0){i=k;break;}}if(!next)i=i-1;}
+else{i=next?i+1:i-1;}
+i=(i%a.length+a.length)%a.length;a[i].focus();a[i].scrollIntoView({block:'center'});return i+1;})($next)"""
+
+    /** "block/blocks" of the page, one block being one screen. */
+    const val POSITION = """(function(){var h=window.innerHeight||1;
+var t=Math.max(1,Math.ceil(document.documentElement.scrollHeight/h));
+var b=Math.min(t,Math.floor((window.scrollY+1)/h)+1);return b+'/'+t;})()"""
+
+    /** Parses the "b/t" string POSITION returns (WebView hands it back JSON quoted). */
+    fun parsePosition(result: String?): Pair<Int, Int>? {
+        val parts = result?.trim('"')?.split('/') ?: return null
+        val block = parts.getOrNull(0)?.toIntOrNull() ?: return null
+        val blocks = parts.getOrNull(1)?.toIntOrNull() ?: return null
+        return block to blocks
+    }
+}
diff --git a/app/src/main/java/org/lineageos/jelly/sable/SableTabs.kt b/app/src/main/java/org/lineageos/jelly/sable/SableTabs.kt
new file mode 100644
index 0000000..fec52c8
--- /dev/null
+++ b/app/src/main/java/org/lineageos/jelly/sable/SableTabs.kt
@@ -0,0 +1,58 @@
+/*
+ * SPDX-FileCopyrightText: The SableOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.jelly.sable
+
+import android.app.Activity
+import android.app.ActivityManager
+import android.os.Build
+import org.lineageos.jelly.utils.IntentUtils
+
+/**
+ * SableOS: Browser tabs. Each Jelly tab is its own document task (documentLaunchMode="always"),
+ * so the tab list is this app's task list: switching moves a task to the front and closing
+ * finishes and removes it. Nothing is stored outside Android's own task list.
+ */
+object SableTabs {
+    data class Tab(
+        val taskId: Int,
+        val title: String?,
+        val incognito: Boolean,
+        val current: Boolean,
+        val appTask: ActivityManager.AppTask,
+    )
+
+    /** This app's browser tabs, in the order they were opened. */
+    fun list(activity: Activity): List<Tab> {
+        val activityManager = activity.getSystemService(ActivityManager::class.java) ?: return emptyList()
+        return activityManager.appTasks.mapNotNull { appTask ->
+            val info = runCatching { appTask.taskInfo }.getOrNull() ?: return@mapNotNull null
+            val taskId = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) info.taskId else info.persistentId
+            val title = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {
+                info.taskDescription?.label?.toString()
+            } else {
+                null
+            }
+            val incognito = info.baseIntent?.getBooleanExtra(IntentUtils.EXTRA_INCOGNITO, false) == true
+            Tab(taskId, title, incognito, taskId == activity.taskId, appTask)
+        }.sortedBy { it.taskId }
+    }
+
+    /** Switch to the next (or previous) tab; returns false when there is no other tab. */
+    fun switchAdjacent(activity: Activity, next: Boolean): Boolean {
+        val tabs = list(activity)
+        val target = SableBrowserKeys.adjacentTab(tabs.map { it.taskId }.toIntArray(), activity.taskId, next)
+        val tab = tabs.firstOrNull { it.taskId == target } ?: return false
+        return runCatching { tab.appTask.moveToFront() }.isSuccess
+    }
+
+    fun switchTo(tab: Tab) {
+        runCatching { tab.appTask.moveToFront() }
+    }
+
+    fun close(tab: Tab) {
+        runCatching { tab.appTask.finishAndRemoveTask() }
+    }
+}
