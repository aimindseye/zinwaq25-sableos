+    /** The tab grid (state 3): two columns, current tab focused, private tabs without titles. */
+    private fun showSableTabGrid() {
+        sableTabGrid?.dismiss()
+        val tabs = SableTabs.list(this)
+        if (tabs.isEmpty()) return
+        val grid = LinearLayout(this).apply {
+            orientation = LinearLayout.VERTICAL
+            val pad = (16 * resources.displayMetrics.density).toInt()
+            setPadding(pad, pad / 2, pad, 0)
+        }
+        var currentCard: View? = null
+        tabs.chunked(2).forEach { pair ->
+            val row = LinearLayout(this).apply {
+                orientation = LinearLayout.HORIZONTAL
+                isBaselineAligned = false
+            }
+            pair.forEach { tab ->
+                val card = layoutInflater.inflate(R.layout.sable_start_card, row, false)
+                val margin = (6 * resources.displayMetrics.density).toInt()
+                card.layoutParams = LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f)
+                    .apply { setMargins(margin, margin, margin, margin) }
+                bindSableTabCard(card, tab)
+                card.setOnClickListener {
+                    sableTabGrid?.dismiss()
+                    if (!tab.current) SableTabs.switchTo(tab)
+                }
+                card.setOnKeyListener { _, _, event ->
+                    val action = SableBrowserKeys.tabGrid(
+                        event.keyCode, event.isAltPressed, event.isCtrlPressed,
+                        event.isShiftPressed, event.isMetaPressed
+                    )
+                    if (action != SableBrowserKeys.Action.CLOSE_TAB) return@setOnKeyListener false
+                    if (event.action == KeyEvent.ACTION_DOWN && event.repeatCount == 0) {
+                        sableTabGrid?.dismiss()
+                        if (tab.current) finishAndRemoveTask() else {
+                            SableTabs.close(tab)
+                            showSableTabGrid()
+                        }
+                    }
+                    true
+                }
+                if (tab.current) currentCard = card
+                row.addView(card)
+            }
+            if (pair.size == 1) {
+                row.addView(View(this), LinearLayout.LayoutParams(0, 0, 1f))
+            }
+            grid.addView(row)
+        }
+        grid.addView(TextView(this).apply {
+            text = getString(R.string.sable_tabs_hint)
+            val pad = (6 * resources.displayMetrics.density).toInt()
+            setPadding(pad, pad, pad, pad)
+        })
+        val scroll = ScrollView(this).apply { addView(grid) }
+        sableTabGrid = AlertDialog.Builder(this)
