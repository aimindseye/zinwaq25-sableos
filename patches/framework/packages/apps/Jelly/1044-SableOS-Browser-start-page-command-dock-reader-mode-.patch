+    /** Start page while this tab has no page; the dock hint follows start, page or reader. */
+    private fun updateSableChrome() {
+        val chromeShown = !isFullscreenPwa && customView == null
+        val noPage = webView.url.isNullOrEmpty() || webView.url == "about:blank"
+        val showStart = chromeShown && noPage
+        if (showStart && !sableStartPage.isVisible && currentFocus !is TextView) {
+            sableStartPage.post { sableStartPage.requestFocus(View.FOCUS_DOWN) }
+        }
+        sableStartPage.isVisible = showStart
+        sableDock.isVisible = chromeShown
+        val readerOn = sableReaderUrl != null && sableReaderUrl == webView.url
+        val mode = when {
+            showStart -> SableBrowserKeys.Mode.START
+            readerOn -> SableBrowserKeys.Mode.READER
+            else -> SableBrowserKeys.Mode.PAGE
+        }
+        val position = sableReaderPosition
+        sableDockHint.text = SableBrowserKeys.hint(mode, position?.first ?: 0, position?.second ?: 0)
+    }
+
+    private fun toggleSableReader() {
+        if (sableReaderUrl != null && sableReaderUrl == webView.url) {
+            sableReaderUrl = null
+            sableReaderPosition = null
+            webView.reload()
+            updateSableChrome()
+            return
+        }
+        if (!webView.settings.javaScriptEnabled) {
+            Toast.makeText(this, R.string.sable_reader_unavailable, Toast.LENGTH_SHORT).show()
+            return
+        }
+        val pageUrl = webView.url ?: return
+        webView.evaluateJavascript(SableReader.READER_ON) { result ->
+            if (result?.trim('"') == "on" && webView.url == pageUrl) {
+                sableReaderUrl = pageUrl
+                refreshSableReaderPosition()
+                updateSableChrome()
+            }
+        }
+    }
+
+    private fun refreshSableReaderPosition() {
+        if (sableReaderUrl == null || sableReaderUrl != webView.url) return
+        // After the page has moved: pageDown/pageUp animate, so ask once they settle.
+        webView.postDelayed({
+            webView.evaluateJavascript(SableReader.POSITION) { result ->
+                sableReaderPosition = SableReader.parsePosition(result)
+                updateSableChrome()
+            }
+        }, SABLE_POSITION_DELAY_MS)
+    }
+
+    private fun sableLinkMode(next: Boolean) {
+        if (!webView.settings.javaScriptEnabled) return
+        webView.requestFocus()
+        webView.evaluateJavascript(SableReader.linkScript(next)) { result ->
+            if (result == "0") {
+                Toast.makeText(this, R.string.sable_no_links, Toast.LENGTH_SHORT).show()
+            }
+        }
+    }
