     /**
-     * Whether a held key repeats the action. Only paging repeats; every other action runs once
-     * per press, so a held key never opens a row of tabs.
+     * A key on a focused tab in the tab grid. Enter and the arrows keep their meaning (switch,
+     * move); D, Del or Alt+W (Ctrl+W) close the focused tab.
+     */
+    public static Action tabGrid(int keyCode, boolean alt, boolean ctrl, boolean shift, boolean meta) {
+        if (meta || shift) {
+            return Action.NONE;
+        }
+        if (keyCode == KEYCODE_W) {
+            return (alt != ctrl) ? Action.CLOSE_TAB : Action.NONE;
+        }
+        if (alt || ctrl) {
+            return Action.NONE;
+        }
+        switch (keyCode) {
+            case KEYCODE_D:
+            case KEYCODE_DEL:
+            case KEYCODE_FORWARD_DEL:
+                return Action.CLOSE_TAB;
+            default:
+                return Action.NONE;
+        }
+    }
+
+    /**
+     * Whether a held key repeats the action. Only paging and link moves repeat; every other
+     * action runs once per press, so a held key never opens or closes a row of tabs.
      */
     public static boolean repeats(Action action) {
-        return action == Action.PAGE_DOWN || action == Action.PAGE_UP;
+        return action == Action.PAGE_DOWN
+                || action == Action.PAGE_UP
+                || action == Action.LINK_NEXT
+                || action == Action.LINK_PREVIOUS;
+    }
+
+    /**
+     * The tab to switch to from {@code current}: tabs are kept in the order they were opened
+     * ({@code tabIds} ascending task ids) and the step wraps around. Returns -1 when there is no
+     * other tab.
+     */
+    public static int adjacentTab(int[] tabIds, int current, boolean next) {
+        if (tabIds == null || tabIds.length < 2) {
+            return -1;
+        }
+        final int[] sorted = tabIds.clone();
+        java.util.Arrays.sort(sorted);
+        int index = java.util.Arrays.binarySearch(sorted, current);
+        if (index < 0) {
+            // The current tab is not listed: start from where it would be.
+            final int insertion = -index - 1;
+            index = next ? insertion - 1 : insertion;
+        }
+        final int n = sorted.length;
+        final int target = ((next ? index + 1 : index - 1) % n + n) % n;
+        return sorted[target] == current ? -1 : sorted[target];
+    }
+
+    /**
+     * The command dock hint line for a mode (artifact states 1 and 2). In reader mode
+     * {@code block} and {@code blocks} give the "2/8" position; 0 leaves it out.
+     */
+    public static String hint(Mode mode, int block, int blocks) {
+        switch (mode) {
+            case START:
+                return "[Alt+T New] [Alt+W Close] [Alt+← Back] [Alt+→ Fwd] [Alt+A Tabs]";
+            case READER: {
+                final String position = (block > 0 && blocks > 0)
+                        ? "Reader " + Math.min(block, blocks) + "/" + blocks + " · "
+                        : "Reader · ";
+                return position
+                        + "[Space] next block · [Shift+Space] previous · [/] find"
+                        + " · [T] top · [L] link mode · [R] exit";
+            }
+            case PAGE:
+            default:
+                return "[/] find · [R] reader · [L] links · [T/B] top/bottom"
+                        + " · [Alt+A] tabs · [Alt+W] close";
+        }
     }
