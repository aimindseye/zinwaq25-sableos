 import com.android.contacts.common.widget.SelectPhoneAccountDialogFragment;
 import com.android.dialer.R;
@@ -666,6 +668,60 @@ public class InCallActivity extends TransactionSafeFragmentActivity
     return super.onOptionsItemSelected(item);
   }
 
+  /** SableOS: true from the Space press that answered a call until its release. */
+  private boolean sableAnswerKeyDown;
+
+  @Override
+  public boolean dispatchKeyEvent(KeyEvent event) {
+    // Before the view hierarchy, so a focused Decline control never takes the Space press.
+    if (event.getKeyCode() == KeyEvent.KEYCODE_SPACE && handleSableAnswerKey(event)) {
+      return true;
+    }
+    return super.dispatchKeyEvent(event);
+  }
+
+  /** SableOS: Space answers a ringing call (see SableInCallKeys.decideIncoming). */
+  private boolean handleSableAnswerKey(KeyEvent event) {
+    if (sableAnswerKeyDown) {
+      // Swallow the repeats and release of the press that answered, so they cannot reach a
+      // control of the in-call screen that replaces the answer screen.
+      if (event.getAction() == KeyEvent.ACTION_UP) {
+        sableAnswerKeyDown = false;
+      }
+      return true;
+    }
+    if (event.getAction() != KeyEvent.ACTION_DOWN) {
+      return false;
+    }
+    CallList callList = CallList.getInstance();
+    DialerCall incoming = callList.getIncomingCall();
+    boolean ringingAlone =
+        incoming != null
+            && callList.getOutgoingOrActive() == null
+            && callList.getBackgroundCall() == null;
+    if (!ringingAlone) {
+      return false;
+    }
+    boolean spaceAnswers =
+        PreferenceManager.getDefaultSharedPreferences(createDeviceProtectedStorageContext())
+            .getBoolean(
+                SableInCallKeys.PREF_SPACE_ANSWERS, SableInCallKeys.DEFAULT_SPACE_ANSWERS);
+    if (SableInCallKeys.decideIncoming(
+            event.getKeyCode(),
+            event.getMetaState(),
+            event.getRepeatCount(),
+            ringingAlone,
+            spaceAnswers)
+        != SableInCallKeys.Action.ANSWER) {
+      return false;
+    }
+    LogUtil.i("InCallActivity.handleSableAnswerKey", "Space answers " + incoming);
+    // Same as the green CALL key (InCallPresenter.handleCallKey): answer as audio.
+    incoming.answer(VideoProfile.STATE_AUDIO_ONLY);
+    sableAnswerKeyDown = true;
+    return true;
+  }
+
   @Override
   public boolean onKeyUp(int keyCode, KeyEvent event) {
     DialpadFragment dialpadFragment = getDialpadFragment();
