diff --git a/java/com/android/dialer/sable/SableInCallKeys.java b/java/com/android/dialer/sable/SableInCallKeys.java
index 0bec7f702..b70b51e5a 100644
--- a/java/com/android/dialer/sable/SableInCallKeys.java
+++ b/java/com/android/dialer/sable/SableInCallKeys.java
@@ -23,7 +23,11 @@ package com.android.dialer.sable;
  * <ul>
  *   <li>M toggles mute, S toggles the speaker, D opens the dialpad.
  *   <li>Only during a call that is active, on hold or dialling out: never on the incoming-call
- *       screen, where keys must not answer or reject anything.
+ *       screen, where no letter answers or rejects anything.
+ *   <li>Space answers a ringing call ({@link #decideIncoming}) when it is the only call and the
+ *       "Space answers calls" setting is on (the default). With another call in progress (call
+ *       waiting) the on-screen choice decides. Space never hangs up: ending a call is unchanged
+ *       (the red key per platform policy, and the on-screen End button).
  *   <li>Only while the dialpad is hidden: with it open, letters are DTMF digits (W E R = 1 2 3 on
  *       a phone-pad keyboard) and keep that meaning.
  *   <li>Held keys and any key with Shift, Alt, Sym, Ctrl, Meta or Fn keep the upstream meaning.
@@ -37,9 +41,18 @@ public final class SableInCallKeys {
     NONE,
     TOGGLE_MUTE,
     TOGGLE_SPEAKER,
-    SHOW_DIALPAD
+    SHOW_DIALPAD,
+    ANSWER
   }
 
+  /** Dialer preference (device-protected default SharedPreferences): Space answers calls. */
+  public static final String PREF_SPACE_ANSWERS = "sable_space_answers";
+
+  /** Space answers by default: the Q25 is keyboard-first, and Space never ends a call. */
+  public static final boolean DEFAULT_SPACE_ANSWERS = true;
+
+  public static final int KEYCODE_SPACE = 62;
+
   public static final int KEYCODE_D = 32;
   public static final int KEYCODE_M = 41;
   public static final int KEYCODE_S = 47;
@@ -77,4 +90,24 @@ public final class SableInCallKeys {
         return Action.NONE;
     }
   }
+
+  /**
+   * Space on the incoming-call screen. {@code ringingAlone} is true when a call is ringing and no
+   * other call is active, on hold or dialling out.
+   */
+  public static Action decideIncoming(
+      int keyCode,
+      int metaState,
+      int repeatCount,
+      boolean ringingAlone,
+      boolean spaceAnswers) {
+    if (keyCode != KEYCODE_SPACE
+        || !ringingAlone
+        || !spaceAnswers
+        || repeatCount > 0
+        || (metaState & ANY_MODIFIER) != 0) {
+      return Action.NONE;
+    }
+    return Action.ANSWER;
+  }
 }
