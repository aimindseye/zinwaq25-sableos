diff --git a/java/com/android/dialer/theme/hidden/res/drawable/sable_focus_outline.xml b/java/com/android/dialer/theme/hidden/res/drawable/sable_focus_outline.xml
new file mode 100644
index 0000000..f9176ee
--- /dev/null
+++ b/java/com/android/dialer/theme/hidden/res/drawable/sable_focus_outline.xml
@@ -0,0 +1,32 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+  Copyright (C) 2026 The SableOS Project
+  SPDX-License-Identifier: Apache-2.0
+-->
+<!-- Focus state only: transparent unless the view is focused (or activated, as for the
+     selected item of a list in selection mode). -->
+<selector xmlns:android="http://schemas.android.com/apk/res/android">
+  <item android:state_window_focused="false" android:state_activated="false">
+    <color android:color="@android:color/transparent"/>
+  </item>
+  <item android:state_focused="true">
+    <inset android:inset="@dimen/sable_focus_inset">
+      <shape android:shape="rectangle">
+        <solid android:color="@color/sable_accent_container"/>
+        <stroke android:width="@dimen/sable_focus_stroke" android:color="@color/sable_accent"/>
+        <corners android:radius="@dimen/sable_row_radius"/>
+      </shape>
+    </inset>
+  </item>
+  <item android:state_activated="true">
+    <inset android:inset="@dimen/sable_focus_inset">
+      <shape android:shape="rectangle">
+        <solid android:color="@color/sable_accent_container"/>
+        <corners android:radius="@dimen/sable_row_radius"/>
+      </shape>
+    </inset>
+  </item>
+  <item>
+    <color android:color="@android:color/transparent"/>
+  </item>
+</selector>
diff --git a/java/com/android/dialer/theme/hidden/res/drawable/sable_selectable_item.xml b/java/com/android/dialer/theme/hidden/res/drawable/sable_selectable_item.xml
