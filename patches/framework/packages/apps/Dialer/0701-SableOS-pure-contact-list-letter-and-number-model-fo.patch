+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.dialer.sable;
+
+import java.text.Normalizer;
+import java.util.Locale;
+
+/**
+ * Letter navigation over the section index the list already has.
+ *
+ * <p>Sable's alphabet rail and the A-Z keys read the ContactsProvider address-book index
+ * (section titles and counts) that the upstream list carries. This class builds no index of
+ * its own and never reads contact data: it only maps a letter to list positions inside the
+ * existing sections. Pure Java so it can be tested on the host.
+ */
+public final class SableAlphabetIndex {
+
+  /** Letters shown on the rail, in order. */
+  public static final String RAIL_LETTERS = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
+
+  /** Returned when no position matches. */
+  public static final int NO_POSITION = -1;
+
+  private static final SableAlphabetIndex EMPTY =
+      new SableAlphabetIndex(new int[0], new int[0], new int[0]);
+
+  // Parallel arrays, one entry per section: bucket key code point, first list position, size.
+  private final int[] keys;
+  private final int[] starts;
+  private final int[] sizes;
+
+  private SableAlphabetIndex(int[] keys, int[] starts, int[] sizes) {
+    this.keys = keys;
+    this.starts = starts;
+    this.sizes = sizes;
+  }
+
+  /** An index with no sections. */
+  public static SableAlphabetIndex empty() {
+    return EMPTY;
+  }
+
+  /**
+   * From section titles and per-section counts (Contacts.EXTRA_ADDRESS_BOOK_INDEX_TITLES and
+   * _COUNTS). {@code listOffset} is the list position of the first indexed row, for example 1
+   * when an "add contact" row comes first.
+   */
+  public static SableAlphabetIndex fromCounts(String[] titles, int[] counts, int listOffset) {
+    if (titles == null || counts == null) {
+      return EMPTY;
+    }
+    int n = Math.min(titles.length, counts.length);
+    int[] keys = new int[n];
+    int[] starts = new int[n];
+    int[] sizes = new int[n];
+    int position = Math.max(0, listOffset);
+    for (int i = 0; i < n; i++) {
+      int count = Math.max(0, counts[i]);
+      keys[i] = bucketKey(titles[i]);
+      starts[i] = position;
+      sizes[i] = count;
+      position += count;
+    }
+    return new SableAlphabetIndex(keys, starts, sizes);
+  }
+
+  /**
+   * From section titles and each section's first position relative to the indexed partition
+   * (a SectionIndexer), plus the number of rows in that partition.
+   */
+  public static SableAlphabetIndex fromPositions(
+      Object[] titles, int[] positions, int total, int listOffset) {
+    if (titles == null || positions == null) {
+      return EMPTY;
+    }
+    int n = Math.min(titles.length, positions.length);
+    int[] keys = new int[n];
+    int[] starts = new int[n];
+    int[] sizes = new int[n];
+    int offset = Math.max(0, listOffset);
+    for (int i = 0; i < n; i++) {
+      int start = Math.max(0, positions[i]);
+      int end = i + 1 < n ? positions[i + 1] : total;
+      keys[i] = bucketKey(titles[i] == null ? null : String.valueOf(titles[i]));
+      starts[i] = offset + start;
+      sizes[i] = Math.max(0, end - start);
+    }
+    return new SableAlphabetIndex(keys, starts, sizes);
+  }
+
+  /**
+   * The letter a section title files under: its first letter, upper-cased, without accents
+   * ("é" files under "E"). Titles that do not start with a letter (favorites star, "#", digits,
+   * the blank "…" section) return 0 and are never jump targets.
+   */
+  public static int bucketKey(String title) {
+    if (title == null) {
+      return 0;
+    }
+    String trimmed = title.trim();
+    if (trimmed.isEmpty()) {
+      return 0;
+    }
+    int first = trimmed.codePointAt(0);
+    if (!Character.isLetter(first)) {
+      return 0;
+    }
+    String base = Normalizer.normalize(new String(Character.toChars(first)), Normalizer.Form.NFD);
+    int letter = base.codePointAt(0);
+    if (!Character.isLetter(letter)) {
+      letter = first;
+    }
+    return new String(Character.toChars(letter)).toUpperCase(Locale.ROOT).codePointAt(0);
+  }
+
+  /** Normalizes a typed character the same way as section titles; 0 if it is not a letter. */
+  public static int keyOf(int codePoint) {
+    if (!Character.isValidCodePoint(codePoint) || !Character.isLetter(codePoint)) {
+      return 0;
+    }
+    return bucketKey(new String(Character.toChars(codePoint)));
+  }
+
+  /** Number of sections. */
+  public int sectionCount() {
+    return keys.length;
+  }
+
+  /** True when at least one row files under {@code codePoint}. */
+  public boolean hasLetter(int codePoint) {
+    return firstPosition(codePoint) != NO_POSITION;
+  }
+
+  /** The first list position filed under {@code codePoint}, or {@link #NO_POSITION}. */
+  public int firstPosition(int codePoint) {
+    int key = keyOf(codePoint);
+    if (key == 0) {
+      return NO_POSITION;
+    }
+    for (int i = 0; i < keys.length; i++) {
+      if (keys[i] == key && sizes[i] > 0) {
+        return starts[i];
+      }
+    }
+    return NO_POSITION;
+  }
+
+  /** True when {@code position} lies in a section filed under {@code codePoint}. */
+  public boolean isInBucket(int codePoint, int position) {
+    int key = keyOf(codePoint);
+    if (key == 0) {
+      return false;
+    }
+    for (int i = 0; i < keys.length; i++) {
+      if (keys[i] == key && position >= starts[i] && position < starts[i] + sizes[i]) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  /**
+   * Where pressing {@code codePoint} moves focus. From outside the letter's rows it goes to the
+   * first row; from a row under that letter it goes to the next one, wrapping to the first, so
+   * pressing the same letter again cycles through the bucket. {@link #NO_POSITION} when nothing
+   * files under the letter (focus must then stay where it is).
+   */
+  public int nextJump(int codePoint, int currentPosition) {
+    int key = keyOf(codePoint);
+    if (key == 0) {
+      return NO_POSITION;
+    }
+    int first = NO_POSITION;
+    boolean inBucket = false;
+    for (int i = 0; i < keys.length; i++) {
+      if (keys[i] != key || sizes[i] <= 0) {
+        continue;
+      }
+      if (first == NO_POSITION) {
+        first = starts[i];
+      }
+      int end = starts[i] + sizes[i];
+      if (currentPosition >= starts[i] && currentPosition < end) {
+        inBucket = true;
+        if (currentPosition + 1 < end) {
+          return currentPosition + 1;
+        }
+      } else if (inBucket && starts[i] > currentPosition) {
+        // The letter continues in a later section (for example "A" then "Ä" in some locales).
+        return starts[i];
+      }
+    }
+    return first;
+  }
+}
