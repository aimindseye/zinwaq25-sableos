+ * limitations under the License.
+ */
+
+package com.android.dialer.sable;
+
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.Map;
+
+/**
+ * Bounded, read-only, in-memory map from contact id to the number shown under the contact's
+ * name in the list.
+ *
+ * <p>ContactsProvider stays the owner of contact data. The map is filled from one read-only
+ * query of the provider's Phone rows each time the list loads, is never written back, never
+ * persisted and only feeds the list subtitle. It is not an index: section headers, the rail and
+ * search keep using the provider's own results. Pure Java so it can be tested on the host.
+ */
+public final class SablePreferredNumbers {
+
+  /** Most contacts kept; rows for further contacts are ignored. */
+  public static final int MAX_CONTACTS = 5000;
+
+  /** Most provider rows read, passed to the query as its limit. */
+  public static final int MAX_ROWS = 20000;
+
+  /** Longest number kept, in characters; longer values are not shown. */
+  public static final int MAX_NUMBER_LENGTH = 64;
+
+  private static final SablePreferredNumbers EMPTY =
+      new SablePreferredNumbers(Collections.<Long, Entry>emptyMap(), false);
+
+  /** The chosen number for one contact, with its type label (may be empty). */
+  public static final class Entry {
+    public final String number;
+    public final String label;
+    final int rank;
+
+    Entry(String number, String label, int rank) {
+      this.number = number;
+      this.label = label;
+      this.rank = rank;
+    }
+  }
+
+  private final Map<Long, Entry> entries;
+  private final boolean truncated;
+
+  private SablePreferredNumbers(Map<Long, Entry> entries, boolean truncated) {
+    this.entries = entries;
+    this.truncated = truncated;
+  }
+
+  /** A map with no numbers. */
+  public static SablePreferredNumbers empty() {
+    return EMPTY;
+  }
+
+  /** The number to show for {@code contactId}, or null. */
+  public Entry get(long contactId) {
+    return entries.get(contactId);
+  }
+
+  /** The number text to show for {@code contactId}, or null. */
+  public String numberFor(long contactId) {
+    Entry entry = entries.get(contactId);
+    return entry == null ? null : entry.number;
+  }
+
+  /** Number of contacts with a number. */
+  public int size() {
+    return entries.size();
+  }
+
+  /** True when the row or contact bound was reached, so some contacts show no subtitle. */
+  public boolean isTruncated() {
+    return truncated;
+  }
+
+  /**
+   * Rank of a Phone row: the default number (IS_SUPER_PRIMARY) first, then the account's
+   * primary number (IS_PRIMARY), then any other.
+   */
+  static int rank(boolean superPrimary, boolean primary) {
+    return superPrimary ? 2 : primary ? 1 : 0;
+  }
+
+  /** Collects provider rows into a bounded map. Not thread-safe; use on one thread. */
+  public static final class Builder {
+    private final int maxContacts;
+    private final int maxRows;
+    private final HashMap<Long, Entry> entries = new HashMap<>();
+    private int rows;
+    private boolean truncated;
+
+    public Builder() {
+      this(MAX_CONTACTS, MAX_ROWS);
+    }
+
+    public Builder(int maxContacts, int maxRows) {
+      this.maxContacts = Math.max(0, maxContacts);
+      this.maxRows = Math.max(0, maxRows);
+    }
+
+    /**
+     * Offers one Phone row. For each contact the highest-ranked row wins; among rows of equal
+     * rank the first one offered wins, so rows sorted by the provider's _ID give a stable
+     * choice. Blank or over-long numbers are skipped. Returns false once the row bound is
+     * reached and the caller should stop reading.
+     */
+    public boolean offer(
+        long contactId, String number, String label, boolean superPrimary, boolean primary) {
+      if (rows >= maxRows) {
+        truncated = true;
+        return false;
+      }
+      rows++;
+      String clean = SableSubtitle.cleanNumber(number);
+      if (clean == null || clean.length() > MAX_NUMBER_LENGTH) {
+        return true;
+      }
+      int rank = rank(superPrimary, primary);
+      Entry existing = entries.get(contactId);
+      if (existing == null) {
+        if (entries.size() >= maxContacts) {
+          truncated = true;
+          return true;
+        }
+        entries.put(contactId, new Entry(clean, SableSubtitle.cleanLabel(label), rank));
+      } else if (rank > existing.rank) {
+        entries.put(contactId, new Entry(clean, SableSubtitle.cleanLabel(label), rank));
+      }
+      return true;
+    }
+
+    /** An immutable snapshot of what was collected. */
+    public SablePreferredNumbers build() {
+      if (entries.isEmpty() && !truncated) {
+        return EMPTY;
+      }
+      return new SablePreferredNumbers(
+          Collections.unmodifiableMap(new HashMap<>(entries)), truncated);
+    }
+  }
+}
