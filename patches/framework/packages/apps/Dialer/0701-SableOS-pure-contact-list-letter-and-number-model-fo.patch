+
+package com.android.dialer.sable;
+
+/**
+ * Text of the line under a contact's name: "Mobile · +1 555 0101". Pure Java.
+ *
+ * <p>The number is wrapped in Unicode left-to-right isolates so it reads correctly next to a
+ * right-to-left label, and is shown as the provider stored it (no reformatting, no lookups).
+ */
+public final class SableSubtitle {
+
+  /** Separator between the type label and the number. */
+  public static final String SEPARATOR = " · ";
+
+  /** Longest label kept, in characters; longer custom labels are cut with an ellipsis. */
+  public static final int MAX_LABEL_LENGTH = 24;
+
+  private static final char LRI = '⁦';
+  private static final char PDI = '⁩';
+
+  private SableSubtitle() {}
+
+  /** Trims and collapses whitespace; null when nothing visible is left. */
+  public static String cleanNumber(String number) {
+    String collapsed = collapse(number);
+    if (collapsed == null) {
+      return null;
+    }
+    for (int i = 0; i < collapsed.length(); i++) {
+      if (Character.isLetterOrDigit(collapsed.charAt(i))) {
+        return collapsed;
+      }
+    }
+    return null;
+  }
+
+  /** Trims, collapses and bounds a type label; empty when there is none. */
+  public static String cleanLabel(String label) {
+    String collapsed = collapse(label);
+    if (collapsed == null) {
+      return "";
+    }
+    if (collapsed.length() > MAX_LABEL_LENGTH) {
+      int end = MAX_LABEL_LENGTH - 1;
+      if (Character.isHighSurrogate(collapsed.charAt(end - 1))) {
+        end--;
+      }
+      return collapsed.substring(0, end).trim() + "…";
+    }
+    return collapsed;
+  }
+
+  /**
+   * The subtitle for a label and number, or null when there is no number (the row then shows
+   * the name only).
+   */
+  public static String format(String label, String number) {
+    String cleanNumber = cleanNumber(number);
+    if (cleanNumber == null) {
+      return null;
+    }
+    String isolated = LRI + cleanNumber + PDI;
+    String cleanLabel = cleanLabel(label);
+    return cleanLabel.isEmpty() ? isolated : cleanLabel + SEPARATOR + isolated;
+  }
+
+  private static String collapse(String text) {
+    if (text == null) {
+      return null;
+    }
+    StringBuilder out = new StringBuilder(text.length());
+    boolean space = false;
+    for (int i = 0; i < text.length(); i++) {
+      char c = text.charAt(i);
+      if (Character.isWhitespace(c) || Character.isSpaceChar(c) || Character.isISOControl(c)) {
+        space = out.length() > 0;
+      } else {
+        if (space) {
+          out.append(' ');
+          space = false;
+        }
+        out.append(c);
+      }
+    }
+    return out.length() == 0 ? null : out.toString();
+  }
+}
