+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.dialer.sable;
+
+/**
+ * What a typed character does on a contact list (CONTACTS_PEOPLE_UX "Physical keyboard alphabet
+ * shortcuts"). Pure Java.
+ *
+ * <ul>
+ *   <li>A letter, with search inactive and no Ctrl/Alt/Meta held, jumps focus to the letter's
+ *       rows (repeating cycles). It never calls, messages, opens or edits anyone.
+ *   <li>"/" opens search with an empty query, when the surface has a search to open.
+ *   <li>Everything else keeps the upstream meaning (in Contacts: start a search with that
+ *       character, so digits still search numbers).
+ *   <li>While search or selection is active nothing here applies: the text field owns letters.
+ * </ul>
+ */
+public final class SableListKeys {
+
+  /** The decision for one key press. */
+  public enum Action {
+    /** Move focus to the letter's rows. */
+    JUMP,
+    /** Open search with an empty query. */
+    OPEN_SEARCH,
+    /** Consume the key and do nothing (a held letter or "/"). */
+    IGNORE,
+    /** Not ours: leave the key to the upstream handling. */
+    UPSTREAM
+  }
+
+  private SableListKeys() {}
+
+  /**
+   * @param codePoint the character the key produces (KeyEvent.getUnicodeChar), 0 if none
+   * @param commandModifier Ctrl, Alt or Meta is held (Alt/Sym/Fn characters are for text fields)
+   * @param repeat the key is auto-repeating (held down)
+   * @param searchActive search is open, so letters are query text
+   * @param selectionActive multi-select mode is active
+   * @param canOpenSearch the surface can open its search from here
+   */
+  public static Action decide(
+      int codePoint,
+      boolean commandModifier,
+      boolean repeat,
+      boolean searchActive,
+      boolean selectionActive,
+      boolean canOpenSearch) {
+    if (searchActive || selectionActive || commandModifier || codePoint <= 0) {
+      return Action.UPSTREAM;
+    }
+    if (codePoint == '/') {
+      if (!canOpenSearch) {
+        return Action.UPSTREAM;
+      }
+      return repeat ? Action.IGNORE : Action.OPEN_SEARCH;
+    }
+    if (Character.isValidCodePoint(codePoint) && Character.isLetter(codePoint)) {
+      // A held letter must not race through the list or fall through to type-to-search;
+      // one press is one step.
+      return repeat ? Action.IGNORE : Action.JUMP;
+    }
+    return Action.UPSTREAM;
+  }
+}
