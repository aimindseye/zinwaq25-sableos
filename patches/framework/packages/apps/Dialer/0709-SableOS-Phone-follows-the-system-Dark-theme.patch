+  /**
+   * Sable: the call screen is always dark (white text on the call background, as upstream), so
+   * its resources resolve as in the Dark theme even while the rest of Phone is light.
+   */
+  @Override
+  protected void attachBaseContext(Context base) {
+    Configuration config = new Configuration(base.getResources().getConfiguration());
+    config.uiMode =
+        (config.uiMode & ~Configuration.UI_MODE_NIGHT_MASK) | Configuration.UI_MODE_NIGHT_YES;
+    super.attachBaseContext(base.createConfigurationContext(config));
+  }
