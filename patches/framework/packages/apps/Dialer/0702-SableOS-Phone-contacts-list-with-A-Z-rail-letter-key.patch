+  /**
+   * Sable: the A-Z rail at the end edge and the letter keys. Both use the address-book index
+   * the adapter already carries; nothing here reads or writes contact data.
+   */
+  private void installSableAlphabetRail(FrameLayout container) {
+    sableRail =
+        new SableAlphabetRail(
+            getContext(), letter -> getString(R.string.sable_alphabet_jump_to, letter));
+    sableRail.setListener(codePoint -> sableJump(codePoint, false));
+    sableRail.setVisibility(View.GONE);
+    container.addView(sableRail, SableAlphabetRail.frameParams(getContext()));
+    container.addOnUnhandledKeyEventListener((v, event) -> onSableKey(event));
+    updateSableAlphabetRail();
+  }
+
+  private boolean isSableRailShown() {
+    return sableRail != null && sableRail.getVisibility() == View.VISIBLE;
+  }
+
+  private void updateSableAlphabetRail() {
+    if (sableRail == null) {
+      return;
+    }
+    boolean show = adapter != null && adapter.hasContacts();
+    sableRail.setAvailable(show ? adapter.getSableIndex() : SableAlphabetIndex.empty());
+    sableRail.setVisibility(show ? View.VISIBLE : View.GONE);
+    int end = show ? sableRail.getLayoutParams().width : 0;
+    recyclerView.setPaddingRelative(
+        recyclerView.getPaddingStart(),
+        recyclerView.getPaddingTop(),
+        end,
+        recyclerView.getPaddingBottom());
+    if (show) {
+      fastScroller.setVisibility(View.GONE);
+    }
+  }
+
+  private boolean onSableKey(KeyEvent event) {
+    if (event.getAction() != KeyEvent.ACTION_DOWN || !isVisible() || adapter == null) {
+      return false;
+    }
+    int unicode = event.getUnicodeChar();
+    if ((unicode & KeyCharacterMap.COMBINING_ACCENT) != 0) {
+      return false;
+    }
+    SableListKeys.Action action =
+        SableListKeys.decide(
+            unicode,
+            event.isCtrlPressed() || event.isAltPressed() || event.isMetaPressed(),
+            event.getRepeatCount() > 0,
+            /* searchActive= */ false,
+            /* selectionActive= */ false,
+            /* canOpenSearch= */ false);
+    switch (action) {
+      case JUMP:
+        sableJump(unicode, true);
+        return true;
+      case IGNORE:
+        return true;
+      default:
+        return false;
+    }
+  }
+
+  /**
+   * Moves to the rows filed under {@code codePoint}. From the keyboard, pressing the same letter
+   * again cycles through them and focus follows; it never opens or calls the contact.
+   */
+  private void sableJump(int codePoint, boolean fromKeyboard) {
+    if (adapter == null) {
+      return;
+    }
+    SableAlphabetIndex index = adapter.getSableIndex();
+    int current = sableLastJump;
+    View focused = recyclerView.getFocusedChild();
+    if (focused != null) {
+      current = recyclerView.getChildAdapterPosition(focused);
+    }
+    int target =
+        fromKeyboard ? index.nextJump(codePoint, current) : index.firstPosition(codePoint);
+    if (target == SableAlphabetIndex.NO_POSITION) {
+      int key = SableAlphabetIndex.keyOf(codePoint);
+      String letter = new String(Character.toChars(key == 0 ? codePoint : key));
+      String message = getString(R.string.sable_alphabet_no_contacts, letter);
+      if (sableToast != null) {
+        sableToast.cancel();
+      }
+      sableToast = Toast.makeText(getContext(), message, Toast.LENGTH_SHORT);
+      sableToast.show();
+      return;
+    }
+    sableLastJump = target;
+    manager.scrollToPositionWithOffset(target, 0);
+    if (fromKeyboard) {
+      recyclerView.post(
+          () -> {
+            RecyclerView.ViewHolder holder = recyclerView.findViewHolderForAdapterPosition(target);
+            if (holder != null) {
+              View row = holder.itemView.findViewById(R.id.click_target);
+              (row != null ? row : holder.itemView).requestFocus();
+            }
+          });
+    }
   }
 
