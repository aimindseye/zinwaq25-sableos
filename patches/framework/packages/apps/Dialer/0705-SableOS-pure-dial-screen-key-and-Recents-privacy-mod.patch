+package com.android.dialer.sable;
+
+/**
+ * Hardware keys on the dial screen (SABLE_PHONE_DIALER_UX "Physical keyboard dialing") for
+ * keyboards without a number row, such as the Zinwa Q25. Pure Java.
+ *
+ * <ul>
+ *   <li>The Alt layer types digits anywhere on the dial screen: Alt+W E R S D F Z X C = 1-9 and
+ *       the key map's Alt 0, read from the event's own character ({@code getUnicodeChar()} with
+ *       its meta state), else, for Alt+W E R S D F Z X C, by key code.
+ *   <li>While the dial pad has focus (the number field or an on-screen key), the plain phone-pad
+ *       letters W E R S D F Z X C are 1-9 by key code, as on the lock screen PIN pad. This does
+ *       not depend on the key character map, which a keyboard layout overlay may replace.
+ *   <li>Number row, numpad, {@code *}, {@code #} and {@code +} keys keep their characters.
+ *   <li>Shift with a letter is never a digit; Ctrl, Meta and Fn chords are shortcuts, never
+ *       digits. A held key types once.
+ * </ul>
+ *
+ * Key codes and meta masks mirror android.view.KeyEvent (stable public ABI); the host test pins
+ * them.
+ */
+public final class SableDialpadKeys {
+  public static final int KEYCODE_0 = 7;
+  public static final int KEYCODE_9 = 16;
+  public static final int KEYCODE_STAR = 17;
+  public static final int KEYCODE_POUND = 18;
+  public static final int KEYCODE_PLUS = 81;
+  public static final int KEYCODE_NUMPAD_0 = 144;
+  public static final int KEYCODE_NUMPAD_9 = 153;
+
+  /** W E R S D F Z X C: 1-9 on a BlackBerry-style phone pad. */
+  static final int[] PHONE_PAD_KEYCODES = {51, 33, 46, 47, 32, 34, 54, 52, 31};
+
+  public static final int META_SHIFT_MASK = 0xc1;
+  public static final int META_ALT_MASK = 0x32;
+  public static final int META_SYM_ON = 0x4;
+  public static final int META_FUNCTION_ON = 0x8;
+  public static final int META_CTRL_MASK = 0x7000;
+  public static final int META_META_MASK = 0x70000;
+
+  private static final int SHORTCUT_MODIFIERS = META_FUNCTION_ON | META_CTRL_MASK | META_META_MASK;
+
+  private SableDialpadKeys() {}
+
+  /**
+   * The dial character a key types, or 0 for none.
+   *
+   * @param unicodeChar {@code KeyEvent.getUnicodeChar()} (meta state applied)
+   * @param dialpadFocused whether focus is in the dial pad (number field or an on-screen key)
+   */
+  public static char dialChar(int keyCode, int unicodeChar, int metaState, boolean dialpadFocused) {
+    if ((metaState & SHORTCUT_MODIFIERS) != 0) {
+      return 0;
+    }
+    boolean shift = (metaState & META_SHIFT_MASK) != 0;
+    if (keyCode >= KEYCODE_NUMPAD_0 && keyCode <= KEYCODE_NUMPAD_9) {
+      return (char) ('0' + keyCode - KEYCODE_NUMPAD_0);
+    }
+    if (!shift && keyCode >= KEYCODE_0 && keyCode <= KEYCODE_9 && unicodeChar == 0) {
+      return (char) ('0' + keyCode - KEYCODE_0);
+    }
+    if (keyCode == KEYCODE_STAR) {
+      return '*';
+    }
+    if (keyCode == KEYCODE_POUND) {
+      return '#';
+    }
+    if (keyCode == KEYCODE_PLUS) {
+      return '+';
+    }
+    if (isDialChar(unicodeChar)) {
+      return (char) unicodeChar;
+    }
+    if ((metaState & (META_SHIFT_MASK | META_SYM_ON)) != 0) {
+      return 0;
+    }
+    // Alt+letter is the Q25 digit layer even when a layout overlay dropped the key map's Alt
+    // digits; a plain letter is a digit only inside the dial pad.
+    boolean alt = (metaState & META_ALT_MASK) != 0;
+    if (alt || dialpadFocused) {
+      for (int i = 0; i < PHONE_PAD_KEYCODES.length; i++) {
+        if (PHONE_PAD_KEYCODES[i] == keyCode) {
+          return (char) ('1' + i);
+        }
+      }
+    }
+    return 0;
+  }
+
+  /**
+   * Whether a key on the Phone main screen (dial pad closed, no text field focused) opens the
+   * dial pad with its character: digits, {@code *} and {@code #} from the Alt layer, number row
+   * or numpad. Plain letters never do (they stay list navigation and search), nor does a held
+   * key.
+   */
+  public static boolean opensDialpad(int keyCode, int unicodeChar, int metaState, int repeatCount) {
+    if (repeatCount > 0) {
+      return false;
+    }
+    char c = dialChar(keyCode, unicodeChar, metaState, false);
+    return c != 0 && c != '+';
+  }
+
+  /** The android.view.KeyEvent key code that types {@code c} into the dial pad, or 0. */
+  public static int keyCodeFor(char c) {
+    if (c >= '0' && c <= '9') {
+      return KEYCODE_0 + (c - '0');
+    }
+    switch (c) {
+      case '*':
+        return KEYCODE_STAR;
+      case '#':
+        return KEYCODE_POUND;
+      case '+':
+        return KEYCODE_PLUS;
+      default:
+        return 0;
+    }
+  }
+
+  private static boolean isDialChar(int c) {
+    return (c >= '0' && c <= '9') || c == '*' || c == '#' || c == '+';
+  }
+}
