+package com.android.dialer.sable;
+
+/**
+ * Recents privacy (SABLE_PHONE_DIALER_UX "Recents and missed calls", RECENTS_PRIVACY). Pure Java.
+ *
+ * <p>While the device is locked or Sable private mode is on (the switch lives in Sable Hub >
+ * Connected apps and is read from Hub's read-only {@code org.sableos.hub.privacy} provider), the
+ * Recents list shows the call type, date and a generic "Contact hidden" line instead of names,
+ * numbers, locations, photos, account lines and voicemail transcripts. Calling back still works:
+ * only what is shown changes, never the call log.
+ *
+ * <p>When Hub is not installed there is no private mode (off). A provider that answers with a
+ * value other than 0 or 1 counts as on (fail closed).
+ */
+public final class SableRecentsPrivacy {
+  /** content://org.sableos.hub.privacy/state, column private_mode (0 or 1). */
+  public static final String PROVIDER_AUTHORITY = "org.sableos.hub.privacy";
+
+  public static final String STATE_PATH = "state";
+  public static final String COLUMN_PRIVATE_MODE = "private_mode";
+
+  private SableRecentsPrivacy() {}
+
+  /**
+   * Private mode from the provider's answer: {@code null} when Hub or its row is absent (off),
+   * otherwise the {@code private_mode} value.
+   */
+  public static boolean privateMode(Integer providerValue) {
+    if (providerValue == null) {
+      return false;
+    }
+    return providerValue != 0;
+  }
+
+  /** Whether Recents rows hide who called. */
+  public static boolean hideDetails(boolean deviceLocked, boolean privateMode) {
+    return deviceLocked || privateMode;
+  }
+}
