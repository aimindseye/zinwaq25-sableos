   /** Requests updates to the data to be shown. */
+  /**
+   * Sable: reads the lock state and Sable private mode (Hub's read-only provider) off the main
+   * thread and applies Recents privacy. Without Hub there is no private mode.
+   */
+  private void sableRefreshRecentsPrivacy() {
+    final Context appContext = requireContext().getApplicationContext();
+    final Handler main = new Handler(Looper.getMainLooper());
+    new Thread(
+            () -> {
+              KeyguardManager keyguard = appContext.getSystemService(KeyguardManager.class);
+              boolean locked = keyguard == null || keyguard.isDeviceLocked();
+              boolean hide =
+                  SableRecentsPrivacy.hideDetails(locked, sablePrivateMode(appContext));
+              main.post(
+                  () -> {
+                    if (isAdded() && adapter != null) {
+                      adapter.setSableHideDetails(hide);
+                    }
+                  });
+            },
+            "SableRecentsPrivacy")
+        .start();
+  }
+
+  private static boolean sablePrivateMode(Context context) {
+    Uri uri =
+        new Uri.Builder()
+            .scheme("content")
+            .authority(SableRecentsPrivacy.PROVIDER_AUTHORITY)
+            .appendPath(SableRecentsPrivacy.STATE_PATH)
+            .build();
+    try (Cursor cursor = context.getContentResolver().query(uri, null, null, null, null)) {
+      if (cursor == null || !cursor.moveToFirst()) {
+        return SableRecentsPrivacy.privateMode(null);
+      }
+      int column = cursor.getColumnIndex(SableRecentsPrivacy.COLUMN_PRIVATE_MODE);
+      return SableRecentsPrivacy.privateMode(column < 0 ? 1 : cursor.getInt(column));
+    } catch (RuntimeException e) {
+      // Hub absent or refusing us: no private mode is known.
+      LogUtil.w("CallLogFragment.sablePrivateMode", "Sable private mode unavailable");
+      return SableRecentsPrivacy.privateMode(null);
+    }
+  }
