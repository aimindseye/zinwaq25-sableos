+  /**
+   * Sable: a hardware key that types a dial character while the dial pad has focus (the number
+   * field or an on-screen key) goes through {@link #keyPressed} like a touch, with its tone,
+   * which stops on release. Alt+W E R S D F Z X C and, here, plain W E R S D F Z X C are 1-9
+   * ({@link SableDialpadKeys}). A held key types once.
+   */
+  private boolean sableDialKey(int keyCode, KeyEvent event) {
+    final char dialChar =
+        SableDialpadKeys.dialChar(
+            keyCode, event.getUnicodeChar(), event.getMetaState(), /* dialpadFocused= */ true);
+    if (dialChar == 0) {
+      return false;
+    }
+    if (event.getAction() == KeyEvent.ACTION_DOWN) {
+      if (event.getRepeatCount() == 0) {
+        keyPressed(SableDialpadKeys.keyCodeFor(dialChar));
+      }
+    } else if (event.getAction() == KeyEvent.ACTION_UP) {
+      stopTone();
+    }
+    return true;
+  }
+
   /**
