+  /**
+   * Sable: on the main screen (dial pad closed, no text field focused), a digit from the Alt
+   * layer, number row or numpad opens the dial pad with that digit, through the same dial intent
+   * other apps use. Plain letters keep their list meaning.
+   */
+  @Override
+  public boolean dispatchKeyEvent(KeyEvent event) {
+    if (event.getAction() == KeyEvent.ACTION_DOWN
+        && SableDialpadKeys.opensDialpad(
+            event.getKeyCode(), event.getUnicodeChar(), event.getMetaState(), event.getRepeatCount())
+        && !(getCurrentFocus() instanceof EditText)) {
+      View dialpad = findViewById(R.id.dialpad_view);
+      if (dialpad == null || !dialpad.isShown()) {
+        char dialChar =
+            SableDialpadKeys.dialChar(
+                event.getKeyCode(), event.getUnicodeChar(), event.getMetaState(), false);
+        startActivity(
+            new Intent(Intent.ACTION_DIAL, Uri.fromParts("tel", String.valueOf(dialChar), null))
+                .setClass(this, MainActivity.class));
+        return true;
+      }
+    }
+    return super.dispatchKeyEvent(event);
+  }
