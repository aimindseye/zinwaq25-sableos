+package com.android.dialer.sable;
+
+import java.util.Map;
+import java.util.TreeMap;
+
+/**
+ * BlackBerry speed dial: each letter A-Z can hold one number. Holding the letter on the Phone main
+ * screen, or on Sable Start's home, calls it; holding a letter with no number offers to assign one.
+ * Pure Java: the held-key rule and the stored form.
+ *
+ * <p>The list lives in Phone. Sable Start learns which letters are assigned from a read-only
+ * provider that returns letters only, never numbers or names, and asks Phone to place the call, so
+ * Start needs no call permission. Both are behind a signature permission.
+ *
+ * <p>Key codes and meta masks mirror android.view.KeyEvent (stable public ABI).
+ */
+public final class SableSpeedDial {
+  public static final String AUTHORITY = "org.sableos.dialer.speeddial";
+  public static final String PERMISSION = "org.sableos.permission.SPEED_DIAL";
+  public static final String ACTION_SPEED_DIAL = "org.sableos.dialer.action.SPEED_DIAL";
+  public static final String EXTRA_LETTER = "org.sableos.dialer.extra.LETTER";
+  public static final String COLUMN_LETTER = "letter";
+
+  public static final int KEYCODE_A = 29;
+  public static final int KEYCODE_Z = 54;
+
+  /** Shift, Alt, Sym, Fn, Ctrl and Meta: a chord is never a speed dial. */
+  public static final int CHORD_META = 0xc1 | 0x32 | 0x4 | 0x8 | 0x7000 | 0x70000;
+
+  private SableSpeedDial() {}
+
+  /** One assignment: the number to call and the name shown beside the letter. */
+  public static final class Entry {
+    public final String number;
+    public final String label;
+
+    public Entry(String number, String label) {
+      this.number = number;
+      this.label = label;
+    }
+
+    @Override
+    public boolean equals(Object o) {
+      return o instanceof Entry
+          && ((Entry) o).number.equals(number)
+          && ((Entry) o).label.equals(label);
+    }
+
+    @Override
+    public int hashCode() {
+      return number.hashCode() * 31 + label.hashCode();
+    }
+
+    @Override
+    public String toString() {
+      return label + " " + number;
+    }
+  }
+
+  /**
+   * The letter a key press holds, or 0: a plain A-Z key (no modifier) on its first auto-repeat,
+   * which Android sends once the key has been held for the long-press time.
+   */
+  public static char heldLetter(int keyCode, int metaState, int repeatCount) {
+    if (repeatCount != 1 || (metaState & CHORD_META) != 0) {
+      return 0;
+    }
+    return letterForKey(keyCode);
+  }
+
+  /** The letter of an A-Z key code, or 0. */
+  public static char letterForKey(int keyCode) {
+    return keyCode >= KEYCODE_A && keyCode <= KEYCODE_Z ? (char) ('a' + keyCode - KEYCODE_A) : 0;
+  }
+
+  /** The letter as stored, a-z, or 0 for anything else. */
+  public static char normalize(char c) {
+    char lower = Character.toLowerCase(c);
+    return lower >= 'a' && lower <= 'z' ? lower : 0;
+  }
+
+  /** Reads the stored list: one {@code letter TAB number TAB label} per line; bad lines skipped. */
+  public static Map<Character, Entry> parse(String stored) {
+    Map<Character, Entry> out = new TreeMap<>();
+    if (stored == null) {
+      return out;
+    }
+    for (String line : stored.split("\n")) {
+      String[] f = line.split("\t", -1);
+      if (f.length != 3 || f[0].length() != 1) {
+        continue;
+      }
+      char letter = normalize(f[0].charAt(0));
+      String number = f[1].trim();
+      if (letter != 0 && !number.isEmpty()) {
+        out.put(letter, new Entry(number, clean(f[2]).isEmpty() ? number : clean(f[2])));
+      }
+    }
+    return out;
+  }
+
+  /** Writes the list in {@link #parse}'s form, A to Z. */
+  public static String format(Map<Character, Entry> entries) {
+    StringBuilder sb = new StringBuilder();
+    for (Map.Entry<Character, Entry> e : new TreeMap<>(entries).entrySet()) {
+      if (sb.length() > 0) {
+        sb.append('\n');
+      }
+      sb.append(e.getKey()).append('\t').append(clean(e.getValue().number)).append('\t')
+          .append(clean(e.getValue().label));
+    }
+    return sb.toString();
+  }
+
+  /** Names and numbers never carry the separators of the stored form. */
+  private static String clean(String s) {
+    return s == null ? "" : s.replace('\t', ' ').replace('\n', ' ').trim();
+  }
+}
