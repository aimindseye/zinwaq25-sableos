+package com.android.dialer.sable;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import java.util.Map;
+
+/** Phone's speed dial list, in its own preferences file (SableSpeedDial's stored form). */
+public final class SableSpeedDialStore {
+  private static final String FILE = "sable_speed_dial";
+  private static final String KEY = "entries";
+
+  private final SharedPreferences prefs;
+
+  public SableSpeedDialStore(Context context) {
+    prefs = context.getApplicationContext().getSharedPreferences(FILE, Context.MODE_PRIVATE);
+  }
+
+  public Map<Character, SableSpeedDial.Entry> load() {
+    return SableSpeedDial.parse(prefs.getString(KEY, ""));
+  }
+
+  public SableSpeedDial.Entry get(char letter) {
+    return load().get(SableSpeedDial.normalize(letter));
+  }
+
+  public void put(char letter, SableSpeedDial.Entry entry) {
+    Map<Character, SableSpeedDial.Entry> all = load();
+    all.put(SableSpeedDial.normalize(letter), entry);
+    save(all);
+  }
+
+  public void remove(char letter) {
+    Map<Character, SableSpeedDial.Entry> all = load();
+    all.remove(SableSpeedDial.normalize(letter));
+    save(all);
+  }
+
+  private void save(Map<Character, SableSpeedDial.Entry> all) {
+    prefs.edit().putString(KEY, SableSpeedDial.format(all)).apply();
+  }
+}
