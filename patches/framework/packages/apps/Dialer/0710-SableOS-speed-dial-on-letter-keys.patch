+package com.android.dialer.sable;
+
+import android.app.Activity;
+import android.content.Intent;
+import android.os.Bundle;
+import com.android.dialer.callintent.CallInitiationType;
+import com.android.dialer.callintent.CallIntentBuilder;
+import com.android.dialer.precall.PreCall;
+
+/**
+ * Speed dial a letter: calls its number through Phone's normal call path (SIM choice and
+ * emergency handling included), or, with no number on the letter, opens the speed dial list to
+ * assign one. No window of its own. Callers outside Phone (Sable Start) need {@link
+ * SableSpeedDial#PERMISSION}.
+ */
+public final class SableSpeedDialCallActivity extends Activity {
+  @Override
+  protected void onCreate(Bundle savedInstanceState) {
+    super.onCreate(savedInstanceState);
+    String extra = getIntent().getStringExtra(SableSpeedDial.EXTRA_LETTER);
+    char letter =
+        extra != null && extra.length() == 1 ? SableSpeedDial.normalize(extra.charAt(0)) : 0;
+    if (letter != 0) {
+      SableSpeedDial.Entry entry = new SableSpeedDialStore(this).get(letter);
+      if (entry != null) {
+        PreCall.start(
+            this, new CallIntentBuilder(entry.number, CallInitiationType.Type.SPEED_DIAL));
+      } else {
+        startActivity(
+            new Intent(this, SableSpeedDialActivity.class)
+                .putExtra(SableSpeedDial.EXTRA_LETTER, String.valueOf(letter)));
+      }
+    }
+    finish();
+  }
+}
