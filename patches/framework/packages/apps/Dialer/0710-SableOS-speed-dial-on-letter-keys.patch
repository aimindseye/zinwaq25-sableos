+package com.android.dialer.sable;
+
+import android.app.AlertDialog;
+import android.content.Intent;
+import android.database.Cursor;
+import android.net.Uri;
+import android.os.Bundle;
+import android.provider.ContactsContract.CommonDataKinds.Phone;
+import android.view.KeyEvent;
+import android.widget.ArrayAdapter;
+import android.widget.ListView;
+import android.widget.Toast;
+import androidx.appcompat.app.AppCompatActivity;
+import com.android.dialer.R;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * The speed dial list, A to Z (Phone menu > Speed dial, or holding a letter with no number). Enter
+ * on a letter picks a contact's number for it; on an assigned letter it offers call, change and
+ * remove. Works with the keyboard and trackpad alone: a letter key moves to its row.
+ */
+public final class SableSpeedDialActivity extends AppCompatActivity {
+  private static final int PICK = 1;
+
+  private SableSpeedDialStore store;
+  private ArrayAdapter<String> adapter;
+  private ListView list;
+  private char picking;
+  /** Opened by holding an unassigned letter: done once that letter is set. */
+  private boolean fromHold;
+
+  @Override
+  protected void onCreate(Bundle savedInstanceState) {
+    super.onCreate(savedInstanceState);
+    setTitle(R.string.sable_speed_dial_title);
+    store = new SableSpeedDialStore(this);
+    list = new ListView(this);
+    adapter = new ArrayAdapter<>(this, android.R.layout.simple_list_item_1, new ArrayList<>());
+    list.setAdapter(adapter);
+    list.setOnItemClickListener((parent, view, position, id) -> onLetter((char) ('a' + position)));
+    setContentView(list);
+    refresh();
+    String extra = getIntent().getStringExtra(SableSpeedDial.EXTRA_LETTER);
+    char held =
+        extra != null && extra.length() == 1 ? SableSpeedDial.normalize(extra.charAt(0)) : 0;
+    if (held != 0 && savedInstanceState == null) {
+      fromHold = true;
+      list.setSelection(held - 'a');
+      Toast.makeText(
+              this,
+              getString(R.string.sable_speed_dial_unassigned, upper(held)),
+              Toast.LENGTH_LONG)
+          .show();
+      pick(held);
+    }
+  }
+
+  @Override
+  public boolean onKeyDown(int keyCode, KeyEvent event) {
+    char letter = SableSpeedDial.letterForKey(keyCode);
+    boolean plain = (event.getMetaState() & SableSpeedDial.CHORD_META) == 0;
+    if (letter != 0 && plain && event.getRepeatCount() == 0) {
+      list.requestFocus();
+      list.setSelection(letter - 'a');
+      return true;
+    }
+    return super.onKeyDown(keyCode, event);
+  }
+
+  private void refresh() {
+    Map<Character, SableSpeedDial.Entry> all = store.load();
+    List<String> rows = new ArrayList<>();
+    for (char c = 'a'; c <= 'z'; c++) {
+      SableSpeedDial.Entry e = all.get(c);
+      String detail =
+          e == null
+              ? getString(R.string.sable_speed_dial_not_set)
+              : e.label.equals(e.number) ? e.number : e.label + " · " + e.number;
+      rows.add(upper(c) + "    " + detail);
+    }
+    adapter.clear();
+    adapter.addAll(rows);
+  }
+
+  private void onLetter(char letter) {
+    SableSpeedDial.Entry entry = store.get(letter);
+    if (entry == null) {
+      pick(letter);
+      return;
+    }
+    String[] choices = {
+      getString(R.string.sable_speed_dial_call),
+      getString(R.string.sable_speed_dial_change),
+      getString(R.string.sable_speed_dial_remove)
+    };
+    new AlertDialog.Builder(this)
+        .setTitle(upper(letter) + " · " + entry.label)
+        .setItems(
+            choices,
+            (dialog, which) -> {
+              if (which == 0) {
+                startActivity(
+                    new Intent(this, SableSpeedDialCallActivity.class)
+                        .putExtra(SableSpeedDial.EXTRA_LETTER, String.valueOf(letter)));
+              } else if (which == 1) {
+                pick(letter);
+              } else {
+                store.remove(letter);
+                refresh();
+              }
+            })
+        .show();
+  }
+
+  private void pick(char letter) {
+    picking = letter;
+    startActivityForResult(new Intent(Intent.ACTION_PICK, Phone.CONTENT_URI), PICK);
+  }
+
+  @Override
+  protected void onActivityResult(int requestCode, int resultCode, Intent data) {
+    super.onActivityResult(requestCode, resultCode, data);
+    if (requestCode != PICK) {
+      return;
+    }
+    Uri uri = data == null ? null : data.getData();
+    SableSpeedDial.Entry entry = resultCode == RESULT_OK && uri != null ? read(uri) : null;
+    if (entry != null) {
+      store.put(picking, entry);
+      refresh();
+      Toast.makeText(
+              this,
+              getString(R.string.sable_speed_dial_assigned, upper(picking), entry.label),
+              Toast.LENGTH_SHORT)
+          .show();
+    } else if (resultCode == RESULT_OK) {
+      Toast.makeText(this, R.string.sable_speed_dial_no_number, Toast.LENGTH_SHORT).show();
+    }
+    if (fromHold) {
+      finish();
+    }
+  }
+
+  private SableSpeedDial.Entry read(Uri uri) {
+    String[] projection = {Phone.NUMBER, Phone.DISPLAY_NAME};
+    try (Cursor c = getContentResolver().query(uri, projection, null, null, null)) {
+      if (c == null || !c.moveToFirst() || c.getString(0) == null) {
+        return null;
+      }
+      String name = c.getString(1);
+      return new SableSpeedDial.Entry(c.getString(0), name == null ? c.getString(0) : name);
+    } catch (SecurityException | IllegalArgumentException e) {
+      return null;
+    }
+  }
+
+  private static String upper(char c) {
+    return String.valueOf(Character.toUpperCase(c));
+  }
+}
