@@ -112,6 +120,48 @@ public class SableFmBridgeService extends Service implements FmListener {
         mBound = bindService(fm, mConnection, BIND_AUTO_CREATE);
     }
 
+    @Override
+    public int onStartCommand(Intent intent, int flags, int startId) {
+        if (intent != null && ACTION_STOP_RECORD.equals(intent.getAction())) {
+            FmService service = mService;
+            if (service != null && service.getRecorderState() == FmRecorder.STATE_RECORDING) {
+                service.stopRecordingAsync();
+            }
+        }
+        return START_NOT_STICKY;
+    }
+
+    /** "mm:ss" with "Recording in progress" and a Stop button, in place of the playing notification. */
+    private void showRecordingNotification() {
+        FmService service = mService;
+        if (service == null) {
+            return;
+        }
+        NotificationManager manager = getSystemService(NotificationManager.class);
+        if (manager.getNotificationChannel(RECORD_CHANNEL_ID) == null) {
+            NotificationChannel channel = new NotificationChannel(RECORD_CHANNEL_ID,
+                    getString(R.string.channel_record_name), NotificationManager.IMPORTANCE_LOW);
+            channel.setDescription(getString(R.string.channel_record_description));
+            channel.setLockscreenVisibility(Notification.VISIBILITY_PUBLIC);
+            manager.createNotificationChannel(channel);
+        }
+        Intent stop = new Intent(ACTION_STOP_RECORD).setClass(this, SableFmBridgeService.class);
+        PendingIntent stopIntent = PendingIntent.getService(this, 0, stop,
+                PendingIntent.FLAG_UPDATE_CURRENT | PendingIntent.FLAG_IMMUTABLE);
+        long seconds = service.getRecordTime() / 1000;
+        Notification notification = new Notification.Builder(this, RECORD_CHANNEL_ID)
+                .setContentTitle(String.format(Locale.ROOT, "%02d:%02d", seconds / 60, seconds % 60))
+                .setContentText(getText(R.string.record_notification_message))
+                .setSmallIcon(R.mipmap.ic_launcher)
+                .setShowWhen(false)
+                .setOngoing(true)
+                .setVisibility(Notification.VISIBILITY_PUBLIC)
+                .addAction(R.drawable.btn_fm_rec_stop_enabled, getText(R.string.stop_record),
+                        stopIntent)
+                .build();
+        service.showRecordingNotification(notification);
+    }
+
     @Override
     public IBinder onBind(Intent intent) {
         return mMessenger.getBinder();
