+++ b/src/com/android/fmradio/FmService.java
@@ -224,6 +224,9 @@ public class FmService extends Service implements FmRecorder.OnRecorderStateChan
     private String mRtTextString = "";
     // Notification target class name
     private String mTargetClassName = "com.android.fmradio.FmMainActivity";
+    // SableOS: set by SableFmBridgeService while Sable Media drives the radio, so the
