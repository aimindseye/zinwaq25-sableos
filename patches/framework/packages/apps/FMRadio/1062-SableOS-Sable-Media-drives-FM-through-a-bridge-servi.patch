+            aIntent.addCategory(Intent.CATEGORY_LAUNCHER);
+            aIntent.setClassName(getPackageName(), mTargetClassName);
+        }
         aIntent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
-        aIntent.setClassName(getPackageName(), mTargetClassName);
         PendingIntent pAIntent = PendingIntent.getActivity(
                 mContext, 0, aIntent, PendingIntent.FLAG_IMMUTABLE);
 
@@ -2924,6 +2932,15 @@ public class FmService extends Service implements FmRecorder.OnRecorderStateChan
      * Set notification class name
      * @param clsName The target class name of activity
      */
+    /**
+     * SableOS: the activity the playing notification opens, or null for FmMainActivity.
+     *
+     * @param intent explicit activity intent, copied when the notification is built
+     */
+    public void setExternalContentIntent(Intent intent) {
+        mExternalContentIntent = intent == null ? null : new Intent(intent);
+    }
+
     public void setNotificationClsName(String clsName) {
         mTargetClassName = clsName;
     }
diff --git a/src/com/android/fmradio/SableFmBridgeService.java b/src/com/android/fmradio/SableFmBridgeService.java
new file mode 100644
index 0000000..b16dcdd
--- /dev/null
+++ b/src/com/android/fmradio/SableFmBridgeService.java
@@ -0,0 +1,315 @@
