 /**
  * Lets Sable Media drive the FM tuner. The MediaTek FM chip is reached through
@@ -59,6 +62,18 @@ public class SableFmBridgeService extends Service implements FmListener {
     private boolean mBound;
     private int mLastEvent;
     private boolean mLastOk = true;
+    // SableOS: a recording started through this bridge, saved as soon as the recorder goes idle.
+    private boolean mBridgeRecording;
+    private String mLastRecordFile = "";
+    private final Runnable mRecordTick = new Runnable() {
+        @Override
+        public void run() {
+            broadcastState();
+            if (mBridgeRecording) {
+                mHandler.postDelayed(this, 1000);
+            }
+        }
+    };
 
     private final ServiceConnection mConnection = new ServiceConnection() {
         @Override
@@ -207,6 +222,20 @@ public class SableFmBridgeService extends Service implements FmListener {
             case SableFmProtocol.MSG_SET_MUTE:
                 service.setMuteAsync(msg.arg1 != 0);
                 break;
+            case SableFmProtocol.MSG_RECORD_START:
+                if (service.getPowerStatus() == FmService.POWER_UP
+                        && service.getRecorderState() != FmRecorder.STATE_RECORDING) {
+                    mBridgeRecording = true;
+                    service.startRecordingAsync();
+                    mHandler.removeCallbacks(mRecordTick);
+                    mHandler.postDelayed(mRecordTick, 1000);
+                }
+                break;
+            case SableFmProtocol.MSG_RECORD_STOP:
+                if (service.getRecorderState() == FmRecorder.STATE_RECORDING) {
+                    service.stopRecordingAsync();
+                }
+                break;
             default:
                 break;
         }
@@ -231,13 +260,32 @@ public class SableFmBridgeService extends Service implements FmListener {
                 ok = true;
                 break;
         }
+        final int recorderState = flag == FmListener.LISTEN_RECORDSTATE_CHANGED
+                ? bundle.getInt(FmListener.KEY_RECORDING_STATE) : -1;
         mHandler.post(() -> {
+            if (recorderState == FmRecorder.STATE_IDLE) {
+                saveBridgeRecording();
+            }
             mLastEvent = flag;
             mLastOk = ok;
             broadcastState();
         });
     }
 
+    /** The recorder stopped (stop, power off or error): keep what was recorded. */
+    private void saveBridgeRecording() {
+        FmService service = mService;
+        if (!mBridgeRecording || service == null) {
+            return;
+        }
+        mBridgeRecording = false;
+        String name = FmRecorder.RECORDING_FILE_PREFIX + " "
+                + FmUtils.formatStation(service.getFrequency()) + " "
+                + new SimpleDateFormat("yyyy-MM-dd HH.mm.ss", Locale.ROOT).format(new Date());
+        service.saveRecordingAsync(name);
+        mLastRecordFile = name;
+    }
+
     private Bundle state() {
         Bundle b = new Bundle();
         FmService service = mService;
@@ -246,6 +294,10 @@ public class SableFmBridgeService extends Service implements FmListener {
         if (service == null) {
             return b;
         }
+        b.putBoolean(SableFmProtocol.KEY_RECORDING,
+                service.getRecorderState() == FmRecorder.STATE_RECORDING);
+        b.putLong(SableFmProtocol.KEY_RECORD_MS, service.getRecordTime());
+        b.putString(SableFmProtocol.KEY_RECORD_FILE, mLastRecordFile);
         b.putBoolean(SableFmProtocol.KEY_POWERED, service.getPowerStatus() == FmService.POWER_UP);
         b.putInt(SableFmProtocol.KEY_STATION, service.getFrequency());
         b.putBoolean(SableFmProtocol.KEY_ANTENNA, service.isAntennaAvailable());
