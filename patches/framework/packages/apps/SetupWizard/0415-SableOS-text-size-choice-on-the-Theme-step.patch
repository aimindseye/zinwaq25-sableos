+package org.lineageos.setupwizard.sable;
+
+/**
+ * The Sable text size choice: Small, Medium, Large and Larger. Pure Java.
+ *
+ * <p>Each choice is an Android font scale (Settings.System.FONT_SCALE). Larger (1.3) is the
+ * biggest size SableOS lays out and tests on a 411 dp square screen; Android's own Font size
+ * slider stays available for bigger text. Settings > Display > Text size uses the same values
+ * (com.android.settings.sable.SableTextSize).
+ */
+public final class SableTextSize {
+    /** Font scales in choice order: Small, Medium, Large, Larger. */
+    public static final float[] SCALES = {0.9f, 1.0f, 1.15f, 1.3f};
+
+    /** The choice for a fresh install. */
+    public static final int DEFAULT_INDEX = 1;
+
+    /** How far a stored scale may be from a choice and still count as it. */
+    private static final float MATCH = 0.01f;
+
+    private SableTextSize() {}
+
+    /** The choice for a font scale, or -1 when the scale is not one of the four (custom). */
+    public static int indexOf(float scale) {
+        if (Float.isNaN(scale)) {
+            return -1;
+        }
+        for (int i = 0; i < SCALES.length; i++) {
+            if (Math.abs(SCALES[i] - scale) < MATCH) {
+                return i;
+            }
+        }
+        return -1;
+    }
+
+    /** The font scale for a choice; an index out of range gives Medium. */
+    public static float scaleAt(int index) {
+        return index >= 0 && index < SCALES.length ? SCALES[index] : SCALES[DEFAULT_INDEX];
+    }
+}
