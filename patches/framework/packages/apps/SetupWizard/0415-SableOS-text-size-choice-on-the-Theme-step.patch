 class ThemeSettingsActivity : BaseSetupWizardActivity() {
@@ -73,6 +75,37 @@ class ThemeSettingsActivity : BaseSetupWizardActivity() {
         }
 
         setBlackThemeRevealed(isNight)
+        bindSableTextSize()
+    }
+
+    /**
+     * SableOS: Small, Medium, Large or Larger text, written to Settings.System.FONT_SCALE. A
+     * scale set elsewhere (Android's Font size slider) checks nothing and is named as custom.
+     * The page is recreated by the configuration change and binds again from the new scale.
+     */
+    private fun bindSableTextSize() {
+        val group = findViewById<RadioGroup>(R.id.sable_text_size_group) ?: return
+        val title = findViewById<TextView>(R.id.sable_text_size_title)
+        val scale = Settings.System.getFloat(contentResolver, Settings.System.FONT_SCALE, 1f)
+        val index = SableTextSize.indexOf(scale)
+        if (index >= 0) {
+            group.check(TEXT_SIZE_IDS[index])
+        } else {
+            title?.text = getString(R.string.sable_text_size_custom, "%.2f".format(scale))
+        }
+        group.setOnCheckedChangeListener { _, checkedId ->
+            val chosen = TEXT_SIZE_IDS.indexOf(checkedId)
+            if (chosen < 0) return@setOnCheckedChangeListener
+            try {
+                Settings.System.putFloat(
+                    contentResolver,
+                    Settings.System.FONT_SCALE,
+                    SableTextSize.scaleAt(chosen),
+                )
+            } catch (e: SecurityException) {
+                Log.w(TAG, "could not set the text size", e)
+            }
+        }
     }
 
     override fun onResume() {
@@ -173,6 +206,15 @@ class ThemeSettingsActivity : BaseSetupWizardActivity() {
     companion object {
         private const val TAG = "ThemeSettingsActivity"
 
+        // SableOS: the text size buttons, in SableTextSize.SCALES order.
+        private val TEXT_SIZE_IDS =
+            intArrayOf(
+                R.id.sable_text_size_small,
+                R.id.sable_text_size_medium,
+                R.id.sable_text_size_large,
+                R.id.sable_text_size_larger,
+            )
+
         // Both taken from the preview artwork's viewport, see theme_preview_qs.xml.
         private const val PREVIEW_WIDTH = 412f
         private const val PREVIEW_CORNER_RADIUS = 28f
