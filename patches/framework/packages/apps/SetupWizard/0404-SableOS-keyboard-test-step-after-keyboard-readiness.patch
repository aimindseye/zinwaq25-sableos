+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.setupwizard.widget;
+
+import android.content.Context;
+import android.util.AttributeSet;
+import android.view.KeyEvent;
+import android.widget.EditText;
+
+/**
+ * The keyboard test field (SableOS IR-014). It reports each key down before the IME sees it,
+ * so modifier keys (Shift, Alt, Sym) register even when the IME consumes them, and then
+ * behaves exactly like an EditText.
+ */
+public class SableKeyTestField extends EditText {
+
+    /** Receives key downs before the IME; it must not consume them. */
+    public interface KeyObserver {
+        void onKeyDownPreIme(KeyEvent event);
+    }
+
+    private KeyObserver mObserver;
+
+    public SableKeyTestField(Context context) {
+        super(context);
+    }
+
+    public SableKeyTestField(Context context, AttributeSet attrs) {
+        super(context, attrs);
+    }
+
+    public SableKeyTestField(Context context, AttributeSet attrs, int defStyleAttr) {
+        super(context, attrs, defStyleAttr);
+    }
+
+    public void setKeyObserver(KeyObserver observer) {
+        mObserver = observer;
+    }
+
+    @Override
+    public boolean onKeyPreIme(int keyCode, KeyEvent event) {
+        final KeyObserver observer = mObserver;
+        if (observer != null && event.getAction() == KeyEvent.ACTION_DOWN
+                && event.getRepeatCount() == 0) {
+            observer.onKeyDownPreIme(event);
+        }
+        return super.onKeyPreIme(keyCode, event);
+    }
+}
