diff --git a/src/org/lineageos/setupwizard/SableKeyboardTestActivity.java b/src/org/lineageos/setupwizard/SableKeyboardTestActivity.java
new file mode 100644
index 00000000..91bbfa64
--- /dev/null
+++ b/src/org/lineageos/setupwizard/SableKeyboardTestActivity.java
@@ -0,0 +1,178 @@
+/*
+ * SPDX-FileCopyrightText: The SableOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.setupwizard;
+
+import android.annotation.Nullable;
+import android.content.Intent;
+import android.content.res.ColorStateList;
+import android.os.Bundle;
+import android.provider.Settings;
+import android.text.Editable;
+import android.text.TextWatcher;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.view.inputmethod.EditorInfo;
+import android.widget.GridLayout;
+import android.widget.TextView;
+
+import com.android.settingslib.Utils;
+
+import org.lineageos.setupwizard.sable.SableKeyTest;
+import org.lineageos.setupwizard.sable.SableKeyTest.Check;
+import org.lineageos.setupwizard.sable.SableKeyTest.State;
+import org.lineageos.setupwizard.widget.SableKeyTestField;
+
+import java.util.EnumMap;
+import java.util.Map;
+
+/**
+ * SableOS keyboard test step (IR-014, SETUP_WIZARD_FIRST_BOOT_UX "Keyboard verification"),
+ * after the keyboard readiness step and before Wi-Fi. The user types a sentence and each kind
+ * of key (letters, Shift capitals, numbers, Alt, Sym, Space, Backspace) is ticked as it
+ * registers. Enter continues, Skip and Next are always available, and the on-screen keyboard
+ * and accessibility settings are offered as the recovery path. Nothing typed is stored.
+ */
+public class SableKeyboardTestActivity extends BaseSetupWizardActivity {
+    private static final float ROW_MIN_HEIGHT_DP = 28f;
+
+    private final SableKeyTest mTest = new SableKeyTest();
+    private final Map<Check, TextView> mRows = new EnumMap<>(Check.class);
+    private SableKeyTestField mField;
+    private TextView mProgress;
+    private ColorStateList mWaitingColor;
+    private ColorStateList mPassColor;
+    private CharSequence mBefore = "";
+
+    @Override
+    protected void onCreate(@Nullable Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        getGlifLayout().setDescriptionText(getString(R.string.sable_key_test_summary));
+        setNextAllowed(true);
+
+        mProgress = findViewById(R.id.sable_key_test_progress);
+        mPassColor = Utils.getColorAccent(this);
+        buildRows(findViewById(R.id.sable_key_test_checks));
+
+        mField = findViewById(R.id.sable_key_test_field);
+        mField.setKeyObserver(event -> {
+            if (mTest.onKeyDown(event.getKeyCode(), event.getMetaState())) render();
+        });
+        mField.addTextChangedListener(new TextWatcher() {
+            @Override
+            public void beforeTextChanged(CharSequence s, int start, int count, int after) {
+                mBefore = s.subSequence(start, start + count).toString();
+            }
+
+            @Override
+            public void onTextChanged(CharSequence s, int start, int before, int count) {
+                if (mTest.onReplace(mBefore, s.subSequence(start, start + count))) render();
+                mBefore = "";
+            }
+
+            @Override
+            public void afterTextChanged(Editable s) {}
+        });
+        // The IME's Next/Done action continues, the same as Enter on the physical keys.
+        mField.setOnEditorActionListener((v, actionId, event) -> {
+            if (actionId == EditorInfo.IME_ACTION_NEXT || actionId == EditorInfo.IME_ACTION_DONE) {
+                onNavigateNext();
+                return true;
+            }
+            return false;
+        });
+
+        SableLinks.bind(this, findViewById(R.id.sable_key_test_soft),
+                new Intent(Settings.ACTION_HARD_KEYBOARD_SETTINGS),
+                new Intent(Settings.ACTION_INPUT_METHOD_SETTINGS));
+        SableLinks.bind(this, findViewById(R.id.sable_key_test_accessibility),
+                new Intent(Settings.ACTION_ACCESSIBILITY_SETTINGS));
+        render();
+    }
+
+    @Override
+    protected void onResume() {
+        super.onResume();
+        // Typing works at once: the first key goes into the field, not into finding focus.
+        if (getCurrentFocus() == null) mField.requestFocus();
+    }
+
+    private void buildRows(GridLayout grid) {
+        for (Check check : SableKeyTest.checks()) {
+            final TextView row = new TextView(this);
+            row.setMinHeight(Math.round(TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_DIP,
+                    ROW_MIN_HEIGHT_DP, getResources().getDisplayMetrics())));
+            row.setGravity(Gravity.CENTER_VERTICAL);
+            final GridLayout.LayoutParams lp = new GridLayout.LayoutParams(
+                    GridLayout.spec(GridLayout.UNDEFINED),
+                    GridLayout.spec(GridLayout.UNDEFINED, 1f));
+            lp.width = 0;
+            grid.addView(row, lp);
+            if (mWaitingColor == null) mWaitingColor = row.getTextColors();
+            mRows.put(check, row);
+        }
+    }
+
+    private void render() {
+        for (Check check : SableKeyTest.checks()) {
+            final TextView row = mRows.get(check);
+            final String label = getString(labelOf(check));
+            final State state = mTest.state(check);
+            final int text;
+            final int spoken;
+            switch (state) {
+                case PASS:
+                    text = R.string.sable_key_test_row_pass;
+                    spoken = R.string.sable_key_test_row_pass_spoken;
+                    break;
+                case PRESSED:
+                    text = R.string.sable_key_test_row_pressed;
+                    spoken = R.string.sable_key_test_row_pressed_spoken;
+                    break;
+                case WAITING:
+                default:
+                    text = R.string.sable_key_test_row_waiting;
+                    spoken = R.string.sable_key_test_row_waiting_spoken;
+                    break;
+            }
+            row.setText(getString(text, label));
+            row.setContentDescription(getString(spoken, label));
+            row.setTextColor(state == State.PASS ? mPassColor : mWaitingColor);
+        }
+        mProgress.setText(mTest.allPassed()
+                ? getString(R.string.sable_key_test_all)
+                : getString(R.string.sable_key_test_progress, mTest.passedCount(),
+                        SableKeyTest.checks().size()));
+    }
+
+    private static int labelOf(Check check) {
+        switch (check) {
+            case LETTERS: return R.string.sable_key_test_letters;
+            case CAPITALS: return R.string.sable_key_test_capitals;
+            case NUMBERS: return R.string.sable_key_test_numbers;
+            case ALT: return R.string.sable_key_test_alt;
+            case SYM: return R.string.sable_key_test_sym;
+            case SPACE: return R.string.sable_key_test_space;
+            case BACKSPACE:
+            default:
+                return R.string.sable_key_test_backspace;
+        }
+    }
+
+    @Override
+    protected int getLayoutResId() {
+        return R.layout.sable_keyboard_test_page;
+    }
+
+    @Override
+    protected int getTitleResId() {
+        return R.string.setup_sable_keyboard_test;
+    }
+
+    @Override
+    protected int getIconResId() {
+        return R.drawable.ic_sable_keyboard_setup;
+    }
+}
diff --git a/src/org/lineageos/setupwizard/SableLinks.java b/src/org/lineageos/setupwizard/SableLinks.java
