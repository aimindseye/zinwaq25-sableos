--- /dev/null
+++ b/src/org/lineageos/setupwizard/SableLinks.java
@@ -0,0 +1,49 @@
+/*
+ * SPDX-FileCopyrightText: The SableOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.setupwizard;
+
+import android.app.Activity;
+import android.content.Intent;
+import android.util.Log;
+import android.view.View;
+import android.widget.Button;
+
+/**
+ * Links from SableOS setup steps to system screens (IR-014). A link is shown only when one of
+ * its screens exists on this build, so a step never offers a dead button; opening it can never
+ * fail the step.
+ */
+final class SableLinks {
+    private static final String TAG = "SableLinks";
+
+    private SableLinks() {}
+
+    /**
+     * Shows {@code button} when one of {@code candidates} resolves and makes it open the first
+     * that does; hides it otherwise.
+     *
+     * @return true when the button is shown
+     */
+    static boolean bind(Activity activity, Button button, Intent... candidates) {
+        for (Intent target : candidates) {
+            if (target == null || target.resolveActivity(activity.getPackageManager()) == null) {
+                continue;
+            }
+            button.setVisibility(View.VISIBLE);
+            button.setOnClickListener(v -> {
+                try {
+                    activity.startActivity(target);
+                } catch (RuntimeException e) {
+                    Log.w(TAG, "could not open " + target, e);
+                }
+            });
+            return true;
+        }
+        button.setVisibility(View.GONE);
+        button.setOnClickListener(null);
+        return false;
+    }
+}
diff --git a/src/org/lineageos/setupwizard/sable/SableKeyTest.java b/src/org/lineageos/setupwizard/sable/SableKeyTest.java
new file mode 100644
index 00000000..a26bfcf0
--- /dev/null
+++ b/src/org/lineageos/setupwizard/sable/SableKeyTest.java
@@ -0,0 +1,196 @@
+/*
+ * SPDX-FileCopyrightText: The SableOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.setupwizard.sable;
+
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.EnumMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * The setup keyboard test (SableOS IR-014, SETUP_WIZARD_FIRST_BOOT_UX "Keyboard
+ * verification"): the user types a sentence and each kind of key shows as registered.
+ * Pure Java: the activity feeds it the key events the test field sees before the IME and
+ * the text that reaches the field, and shows {@link #state} for each {@link Check}.
+ *
+ * <p>The Zinwa Q25 has no Fn key, so the layers checked are Shift, Alt and Sym. A modifier
+ * key alone shows as {@link State#PRESSED}; its layer passes when a character typed with it
+ * reaches the field. Text that arrives without key events (on-screen keyboard, a symbol
+ * picker) still passes Letters, Capitals, Numbers, Space and Backspace. Nothing typed is
+ * kept: the model only remembers which checks passed.
+ */
+public final class SableKeyTest {
+
+    public enum Check { LETTERS, CAPITALS, NUMBERS, ALT, SYM, SPACE, BACKSPACE }
+
+    public enum State {
+        /** Nothing registered yet. */
+        WAITING,
+        /** The modifier key registered; no character typed with it yet. */
+        PRESSED,
+        /** Registered. */
+        PASS
+    }
+
+    /** Which modifier the next typed character is credited to. */
+    private enum Armed { NONE, ALT, SYM }
+
+    // Public Android key codes and meta flags (android.view.KeyEvent).
+    public static final int KEYCODE_SPACE = 62;
+    public static final int KEYCODE_ALT_LEFT = 57;
+    public static final int KEYCODE_ALT_RIGHT = 58;
+    public static final int KEYCODE_SHIFT_LEFT = 59;
+    public static final int KEYCODE_SHIFT_RIGHT = 60;
+    public static final int KEYCODE_SYM = 63;
+    public static final int KEYCODE_DEL = 67;
+    public static final int KEYCODE_FORWARD_DEL = 112;
+    public static final int KEYCODE_CAPS_LOCK = 115;
+    public static final int META_SHIFT_ON = 0x1;
+    public static final int META_ALT_ON = 0x2;
+    public static final int META_SYM_ON = 0x4;
+    public static final int META_CAPS_LOCK_ON = 0x100000;
+
+    private static final List<Check> ORDER = Collections.unmodifiableList(
+            Arrays.asList(Check.values()));
+
+    private final Map<Check, State> mStates = new EnumMap<>(Check.class);
+    private Armed mArmed = Armed.NONE;
+
+    public SableKeyTest() {
+        reset();
+    }
+
+    /** The checks in display order. */
+    public static List<Check> checks() {
+        return ORDER;
+    }
+
+    public void reset() {
+        for (Check c : Check.values()) mStates.put(c, State.WAITING);
+        mArmed = Armed.NONE;
+    }
+
+    public State state(Check check) {
+        return mStates.get(check);
+    }
+
+    public int passedCount() {
+        int n = 0;
+        for (State s : mStates.values()) {
+            if (s == State.PASS) n++;
+        }
+        return n;
+    }
+
+    public boolean allPassed() {
+        return passedCount() == ORDER.size();
+    }
+
+    /**
+     * A key down the test field saw before the IME.
+     *
+     * @return true when a check changed state
+     */
+    public boolean onKeyDown(int keyCode, int metaState) {
+        switch (keyCode) {
+            case KEYCODE_ALT_LEFT:
+            case KEYCODE_ALT_RIGHT:
+                mArmed = Armed.ALT;
+                return press(Check.ALT);
+            case KEYCODE_SYM:
+                mArmed = Armed.SYM;
+                return press(Check.SYM);
+            case KEYCODE_SHIFT_LEFT:
+            case KEYCODE_SHIFT_RIGHT:
+            case KEYCODE_CAPS_LOCK:
+                return press(Check.CAPITALS);
+            case KEYCODE_DEL:
+            case KEYCODE_FORWARD_DEL:
+                return pass(Check.BACKSPACE);
+            default:
+                break;
+        }
+        // A key held with a modifier: credit the character it produces to that layer.
+        if ((metaState & META_SYM_ON) != 0) {
+            mArmed = Armed.SYM;
+        } else if ((metaState & META_ALT_ON) != 0) {
+            mArmed = Armed.ALT;
+        }
+        return false;
+    }
+
+    /**
+     * One edit of the field: {@code before} was replaced by {@code after}. An IME that
+     * rewrites its composing word reports the whole word again, so only what follows the
+     * common prefix counts as typed.
+     *
+     * @return true when a check changed state
+     */
+    public boolean onReplace(CharSequence before, CharSequence after) {
+        final String b = before == null ? "" : before.toString();
+        final String a = after == null ? "" : after.toString();
+        int prefix = 0;
+        final int max = Math.min(a.length(), b.length());
+        while (prefix < max && a.charAt(prefix) == b.charAt(prefix)) prefix++;
+        if (prefix > 0 && Character.isHighSurrogate(a.charAt(prefix - 1))) prefix--;
+        return onText(a.substring(prefix), b.length() - prefix);
+    }
+
+    /**
+     * Text that reached the field.
+     *
+     * @param inserted the characters added (may be empty)
+     * @param removedCount how many characters were removed
+     * @return true when a check changed state
+     */
+    public boolean onText(CharSequence inserted, int removedCount) {
+        boolean changed = false;
+        if (removedCount > 0 && (inserted == null || inserted.length() == 0)) {
+            changed |= pass(Check.BACKSPACE);
+        }
+        if (inserted == null) return changed;
+        final String s = inserted.toString();
+        for (int i = 0; i < s.length(); ) {
+            final int c = s.codePointAt(i);
+            i += Character.charCount(c);
+            changed |= onChar(c);
+        }
+        return changed;
+    }
+
+    private boolean onChar(int c) {
+        boolean changed = false;
+        final Armed armed = mArmed;
+        mArmed = Armed.NONE;
+        if (Character.isLetter(c)) {
+            changed |= pass(Check.LETTERS);
+            if (Character.isUpperCase(c)) changed |= pass(Check.CAPITALS);
+            // A letter means the modifier did not apply; it gets no credit.
+            return changed;
+        }
+        if (Character.isSpaceChar(c) || c == '\t') {
+            return pass(Check.SPACE);
+        }
+        if (Character.isDigit(c)) changed |= pass(Check.NUMBERS);
+        if (Character.isISOControl(c)) return changed;
+        if (armed == Armed.ALT) changed |= pass(Check.ALT);
+        if (armed == Armed.SYM) changed |= pass(Check.SYM);
+        return changed;
+    }
+
+    private boolean press(Check check) {
+        if (mStates.get(check) != State.WAITING) return false;
+        mStates.put(check, State.PRESSED);
+        return true;
+    }
+
+    private boolean pass(Check check) {
+        if (mStates.get(check) == State.PASS) return false;
+        mStates.put(check, State.PASS);
+        return true;
+    }
+}
