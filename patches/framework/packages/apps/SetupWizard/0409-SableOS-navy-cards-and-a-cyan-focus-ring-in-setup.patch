diff --git a/res/drawable/sable_setup_focus_ring.xml b/res/drawable/sable_setup_focus_ring.xml
new file mode 100644
index 0000000..1227f6e
--- /dev/null
+++ b/res/drawable/sable_setup_focus_ring.xml
@@ -0,0 +1,19 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+     SPDX-FileCopyrightText: The SableOS Project
+     SPDX-License-Identifier: Apache-2.0
+-->
+<!-- The SableOS keyboard focus ring: a 3dp outline while focused, nothing otherwise. Used as a
+     view foreground, so it replaces the platform's grey focus highlight. -->
+<selector xmlns:android="http://schemas.android.com/apk/res/android">
+    <item android:state_focused="true">
+        <shape android:shape="rectangle">
+            <solid android:color="@android:color/transparent" />
+            <stroke
+                android:width="@dimen/sable_setup_focus_width"
+                android:color="@color/sable_setup_focus" />
+            <corners android:radius="@dimen/sable_setup_focus_radius" />
+        </shape>
+    </item>
+    <item android:drawable="@android:color/transparent" />
+</selector>
