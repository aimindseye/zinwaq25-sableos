diff --git a/src/org/lineageos/setupwizard/sable/SableFocusRing.java b/src/org/lineageos/setupwizard/sable/SableFocusRing.java
new file mode 100644
index 0000000..e43a9b4
--- /dev/null
+++ b/src/org/lineageos/setupwizard/sable/SableFocusRing.java
@@ -0,0 +1,48 @@
+/*
+ * SPDX-FileCopyrightText: The SableOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.setupwizard.sable;
+
+import android.app.Activity;
+import android.util.Log;
+import android.view.View;
+import android.widget.AbsListView;
+
+import org.lineageos.setupwizard.R;
+
+/**
+ * The SableOS keyboard focus ring on every setup step (setup design: cyan ring on the focused
+ * control). When a view takes focus and has no foreground of its own, it gets
+ * {@code @drawable/sable_setup_focus_ring}, which draws only while the view is focused. The
+ * colour comes from {@code @color/sable_setup_focus}, which SableSetupWizardOverlay sets.
+ *
+ * <p>It never blocks a step: any failure leaves the platform focus highlight.
+ */
+public final class SableFocusRing {
+    private static final String TAG = "SableFocusRing";
+
+    private SableFocusRing() {}
+
+    public static void install(Activity activity) {
+        try {
+            final View decor = activity.getWindow().getDecorView();
+            decor.getViewTreeObserver().addOnGlobalFocusChangeListener(
+                    (oldFocus, newFocus) -> mark(activity, newFocus));
+            mark(activity, activity.getCurrentFocus());
+        } catch (RuntimeException e) {
+            Log.w(TAG, "focus ring not installed; using the platform highlight", e);
+        }
+    }
+
+    private static void mark(Activity activity, View view) {
+        // Lists draw focus on their rows; a ring around the whole list would hide which row.
+        if (view == null || view.getForeground() != null || view instanceof AbsListView) return;
+        try {
+            view.setForeground(activity.getDrawable(R.drawable.sable_setup_focus_ring));
+        } catch (RuntimeException e) {
+            Log.w(TAG, "could not mark " + view, e);
+        }
+    }
+}
