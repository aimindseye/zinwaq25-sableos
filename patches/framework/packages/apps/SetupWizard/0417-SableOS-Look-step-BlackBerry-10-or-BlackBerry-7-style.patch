diff --git a/app/src/main/java/org/lineageos/setupwizard/SableLookActivity.java b/app/src/main/java/org/lineageos/setupwizard/SableLookActivity.java
new file mode 100644
index 0000000..761dc90
--- /dev/null
+++ b/app/src/main/java/org/lineageos/setupwizard/SableLookActivity.java
@@ -0,0 +1,79 @@
+/*
+ * SPDX-FileCopyrightText: The SableOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.setupwizard;
+
+import android.annotation.Nullable;
+import android.content.Intent;
+import android.os.Bundle;
+import android.os.Process;
+import android.provider.Settings;
+import android.widget.RadioGroup;
+
+import lineageos.providers.LineageSettings;
+
+import org.lineageos.setupwizard.base.BaseSetupWizardActivity;
+import org.lineageos.setupwizard.sable.SableLook;
+
+/**
+ * SableOS Look step, before Theme: BlackBerry 10 style or BlackBerry 7 style
+ * ({@link SableLook}). Next asks Sable Start for the home style and turns pure black on, which
+ * the Theme step then shows and can change. Nothing restarts; Start shows the look when setup
+ * ends, and each part stays its own setting afterwards.
+ */
+public class SableLookActivity extends BaseSetupWizardActivity {
+    private static final int[] IDS = {
+        R.id.sable_look_bb10, R.id.sable_look_bb7,
+    };
+
+    private RadioGroup group;
+
+    @Override
+    protected void onCreate(@Nullable Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        getGlifLayout().setDescriptionText(getString(R.string.sable_look_summary));
+        group = findViewById(R.id.sable_look_group);
+        group.check(IDS[SableLook.lookOf(
+                Settings.Secure.getString(getContentResolver(), SableLook.SETTING))]);
+        setNextAllowed(true);
+    }
+
+    @Override
+    protected void onNextPressed() {
+        final int look = lookChecked();
+        Settings.Secure.putString(getContentResolver(), SableLook.SETTING, SableLook.valueOf(look));
+        LineageSettings.Secure.putInt(getContentResolver(),
+                LineageSettings.Secure.BERRY_BLACK_THEME, 1);
+        sendBroadcastAsUser(new Intent(SableLook.ACTION_SET_LOOK)
+                .setPackage(SableLook.START_PACKAGE)
+                .putExtra(SableLook.EXTRA_LOOK, SableLook.valueOf(look))
+                .addFlags(Intent.FLAG_INCLUDE_STOPPED_PACKAGES | Intent.FLAG_RECEIVER_FOREGROUND),
+                Process.myUserHandle());
+        super.onNextPressed();
+    }
+
+    private int lookChecked() {
+        final int checked = group.getCheckedRadioButtonId();
+        for (int i = 0; i < IDS.length; i++) {
+            if (IDS[i] == checked) return i;
+        }
+        return SableLook.BB10;
+    }
+
+    @Override
+    protected int getLayoutResId() {
+        return R.layout.sable_look_page;
+    }
+
+    @Override
+    protected int getTitleResId() {
+        return R.string.setup_sable_look;
+    }
+
+    @Override
+    protected int getIconResId() {
+        return R.drawable.ic_sable_look;
+    }
+}
diff --git a/app/src/main/java/org/lineageos/setupwizard/sable/SableLook.java b/app/src/main/java/org/lineageos/setupwizard/sable/SableLook.java
new file mode 100644
index 0000000..f0687eb
--- /dev/null
+++ b/app/src/main/java/org/lineageos/setupwizard/sable/SableLook.java
@@ -0,0 +1,44 @@
+/*
+ * SPDX-FileCopyrightText: The SableOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.setupwizard.sable;
+
+/**
+ * The Look step: BlackBerry 10 style or BlackBerry 7 style. Pure Java.
+ *
+ * <p>Sable Start takes the home style (org.sableos.start.action.SET_LOOK, StartLook in Start);
+ * setup itself turns pure black on, which the Theme step after it shows and can still change.
+ * There is no Plain look (owner decision 2026-11-05). Display density and the notification light
+ * are build settings and do not change here.
+ */
+public final class SableLook {
+    public static final int BB10 = 0;
+    public static final int BB7 = 1;
+
+    /** Sable Start's request and its receiver's package. */
+    public static final String ACTION_SET_LOOK = "org.sableos.start.action.SET_LOOK";
+    public static final String EXTRA_LOOK = "look";
+    public static final String START_PACKAGE = "org.sableos.launcher";
+
+    /** Settings.Secure key that remembers the choice, so the step shows it when revisited. */
+    public static final String SETTING = "sable_look";
+
+    private static final String[] VALUES = {"bb10", "bb7"};
+
+    private SableLook() {}
+
+    /** The value sent to Start and stored. */
+    public static String valueOf(int look) {
+        return look >= 0 && look < VALUES.length ? VALUES[look] : VALUES[BB10];
+    }
+
+    /** A remembered value, or BlackBerry 10 style (the default home) for a missing or unknown one. */
+    public static int lookOf(String stored) {
+        for (int i = 0; i < VALUES.length; i++) {
+            if (VALUES[i].equals(stored)) return i;
+        }
+        return BB10;
+    }
+}
