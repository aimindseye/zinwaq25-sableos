+    /**
+     * SableOS: the "Step n of N" line of the owner flow ([SableSteps]), or null on screens
+     * without a number and in the secondary-user and work-profile flows.
+     */
+    protected val sableStepText: CharSequence?
+        get() =
+            try {
+                if (!SetupWizardUtils.isOwner() || SetupWizardUtils.isManagedProfile(this)) {
+                    null
+                } else {
+                    val networkStep =
+                        (SetupWizardUtils.hasWifi(this) || SetupWizardUtils.hasTelephony(this)) &&
+                            !SetupWizardUtils.isNetworkConnectedToInternetViaEthernet(this)
+                    SableSteps.position(SableSteps.sectionOf(javaClass.simpleName), networkStep)
+                        ?.let { getString(R.string.sable_step, it[0], it[1]) }
+                }
+            } catch (e: RuntimeException) {
+                Log.w(TAG, "could not work out the setup step", e)
+                null
+            }
+
+    /**
+     * Shows [sableStepText] in the layout's `sable_step` line, else in a line added above the
+     * Glif header title. Never fails the step.
+     */
+    private fun showSableStep() {
+        try {
+            val text = sableStepText ?: return
+            var line = findViewById<TextView>(R.id.sable_step)
+            if (line == null) {
+                val root = findViewById<View>(R.id.setup_wizard_layout) as? GlifLayout ?: return
+                val header = root.headerTextView ?: return
+                val parent = header.parent as? ViewGroup ?: return
+                line =
+                    TextView(this).apply {
+                        id = R.id.sable_step
+                        setTextAppearance(R.style.SableSetupStep)
+                    }
+                parent.addView(
+                    line,
+                    parent.indexOfChild(header),
+                    ViewGroup.LayoutParams(
+                        ViewGroup.LayoutParams.MATCH_PARENT,
+                        ViewGroup.LayoutParams.WRAP_CONTENT,
+                    ),
+                )
+            }
+            line.text = text
+            line.visibility = View.VISIBLE
+        } catch (e: RuntimeException) {
+            Log.w(TAG, "could not show the setup step", e)
+        }
+    }
+
     protected val template: SetupTemplate by lazy {
