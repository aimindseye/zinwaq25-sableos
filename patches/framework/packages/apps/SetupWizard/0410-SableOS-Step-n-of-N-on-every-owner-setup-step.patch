+    /**
+     * SableOS: the "Step n of N" line of the owner flow ({@link SableSteps}), or null on
+     * screens without a number and in the secondary-user and work-profile flows.
+     */
+    protected CharSequence getSableStepText() {
+        try {
+            if (!SetupWizardUtils.isOwner() || SetupWizardUtils.isManagedProfile(this)) {
+                return null;
+            }
+            final boolean networkStep = (SetupWizardUtils.hasWifi(this)
+                    || SetupWizardUtils.hasTelephony(this))
+                    && !SetupWizardUtils.isNetworkConnectedToInternetViaEthernet(this);
+            final int[] position = SableSteps.position(
+                    SableSteps.sectionOf(getClass().getSimpleName()), networkStep);
+            return position == null ? null
+                    : getString(R.string.sable_step, position[0], position[1]);
+        } catch (RuntimeException e) {
+            Log.w(TAG, "could not work out the setup step", e);
+            return null;
+        }
+    }
+
+    /**
+     * Shows {@link #getSableStepText} in the layout's {@code sable_step} line, else in a line
+     * added above the Glif header title. Never fails the step.
+     */
+    private void showSableStep() {
+        try {
+            final CharSequence text = getSableStepText();
+            if (text == null) return;
+            TextView line = findViewById(R.id.sable_step);
+            if (line == null) {
+                final View root = findViewById(R.id.setup_wizard_layout);
+                if (!(root instanceof GlifLayout)) return;
+                final TextView header = ((GlifLayout) root).getHeaderTextView();
+                if (header == null || !(header.getParent() instanceof ViewGroup)) return;
+                final ViewGroup parent = (ViewGroup) header.getParent();
+                line = new TextView(this);
+                line.setId(R.id.sable_step);
+                line.setTextAppearance(R.style.SableSetupStep);
+                parent.addView(line, parent.indexOfChild(header), new ViewGroup.LayoutParams(
+                        ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+            }
+            line.setText(text);
+            line.setVisibility(View.VISIBLE);
+        } catch (RuntimeException e) {
+            Log.w(TAG, "could not show the setup step", e);
+        }
+    }
+
     protected GlifLayout getGlifLayout() {
         return requireViewById(R.id.setup_wizard_layout);
     }
