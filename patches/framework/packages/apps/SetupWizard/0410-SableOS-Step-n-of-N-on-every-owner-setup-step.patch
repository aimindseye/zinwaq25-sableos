+/*
+ * SPDX-FileCopyrightText: The SableOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.setupwizard.sable;
+
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.Map;
+
+/**
+ * The "Step n of N" line of the owner setup flow (setup design: "First boot · step 3 of 8").
+ * Pure Java.
+ *
+ * <p>The flow has eight steps: Welcome, Language, Wi-Fi, Privacy, Theme, Date and location,
+ * Screen lock, Ready. Screens that only appear on some phones or in some states (keyboard
+ * help, SIM missing, recovery update, navigation, restore once validated) belong to the step
+ * they sit in and show its number, so the count never changes while the user moves through
+ * setup. When the phone has no Wi-Fi or mobile network step (no Wi-Fi and no telephony, or
+ * online through Ethernet) the flow has seven steps.
+ */
+public final class SableSteps {
+    public static final int WELCOME = 1;
+    public static final int LANGUAGE = 2;
+    public static final int WIFI = 3;
+    public static final int PRIVACY = 4;
+    public static final int THEME = 5;
+    public static final int DEVICE = 6;
+    public static final int LOCK = 7;
+    public static final int READY = 8;
+    public static final int TOTAL = READY;
+
+    private static final Map<String, Integer> SECTIONS;
+
+    static {
+        final Map<String, Integer> m = new HashMap<>();
+        m.put("WelcomeActivity", WELCOME);
+        m.put("LocaleActivity", LANGUAGE);
+        m.put("SableKeyboardActivity", LANGUAGE);
+        m.put("SableKeyboardTestActivity", LANGUAGE);
+        m.put("SimMissingActivity", WIFI);
+        m.put("NetworkSetupActivity", WIFI);
+        m.put("SablePrivacyActivity", PRIVACY);
+        m.put("ThemeSettingsActivity", THEME);
+        m.put("DateTimeActivity", DEVICE);
+        m.put("RestoreIntroActivity", DEVICE);
+        m.put("LocationSettingsActivity", DEVICE);
+        m.put("UpdateRecoveryActivity", DEVICE);
+        m.put("BiometricActivity", LOCK);
+        m.put("ScreenLockActivity", LOCK);
+        m.put("NavigationSettingsActivity", LOCK);
+        m.put("FinishActivity", READY);
+        SECTIONS = Collections.unmodifiableMap(m);
+    }
+
+    private SableSteps() {}
+
+    /**
+     * @param activity the step activity's simple class name
+     * @return its step, or 0 for screens without a number (Bluetooth, device extras)
+     */
+    public static int sectionOf(String activity) {
+        final Integer s = activity == null ? null : SECTIONS.get(activity);
+        return s == null ? 0 : s;
+    }
+
+    /**
+     * @param section a step from {@link #sectionOf}
+     * @param networkStep whether the flow has its Wi-Fi step
+     * @return {n, N} to show, or null for no line
+     */
+    public static int[] position(int section, boolean networkStep) {
+        if (section < WELCOME || section > TOTAL) return null;
+        if (networkStep) return new int[] {section, TOTAL};
+        // Without the Wi-Fi step, a SIM screen is part of Language and later steps move up.
+        return new int[] {section >= WIFI ? section - 1 : section, TOTAL - 1};
+    }
+}
