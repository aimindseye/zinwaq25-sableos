+/*
+ * SPDX-FileCopyrightText: The SableOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.setupwizard;
+
+import android.annotation.Nullable;
+import android.content.Intent;
+import android.os.Bundle;
+import android.provider.Settings;
+
+/**
+ * SableOS privacy step (SETUP_WIZARD_FIRST_BOOT_UX "Privacy posture"), after Wi-Fi: a short,
+ * read-only summary of Sable's privacy defaults (no analytics, provider-owned accounts, the
+ * Hub boundary, per-app network access, lock screen notifications, restore) with links to the
+ * Settings screens that control them. It changes no setting and Next is always enabled.
+ */
+public class SablePrivacyActivity extends BaseSetupWizardActivity {
+
+    /** Settings > Apps > Network access (Settings patch 0603). */
+    static final String ACTION_NETWORK_MANAGER = "org.sableos.settings.NETWORK_MANAGER";
+    /** Settings > Lock screen, else Settings > Notifications (both hold lock screen privacy). */
+    static final String ACTION_LOCK_SCREEN_SETTINGS = "android.settings.LOCK_SCREEN_SETTINGS";
+    static final String ACTION_NOTIFICATION_SETTINGS = "android.settings.NOTIFICATION_SETTINGS";
+
+    @Override
+    protected void onCreate(@Nullable Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        getGlifLayout().setDescriptionText(getString(R.string.sable_privacy_summary));
+        setNextAllowed(true);
+
+        SableLinks.bind(this, findViewById(R.id.sable_privacy_network_link),
+                new Intent(ACTION_NETWORK_MANAGER));
+        SableLinks.bind(this, findViewById(R.id.sable_privacy_lock_screen_link),
+                new Intent(ACTION_LOCK_SCREEN_SETTINGS),
+                new Intent(ACTION_NOTIFICATION_SETTINGS));
+        SableLinks.bind(this, findViewById(R.id.sable_privacy_settings_link),
+                new Intent(Settings.ACTION_PRIVACY_SETTINGS));
+    }
+
+    @Override
+    protected int getLayoutResId() {
+        return R.layout.sable_privacy_page;
+    }
+
+    @Override
+    protected int getTitleResId() {
+        return R.string.setup_sable_privacy;
+    }
+
+    @Override
+    protected int getIconResId() {
+        return R.drawable.ic_sable_privacy;
+    }
+}
