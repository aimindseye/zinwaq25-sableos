-    private static void apply(PackageManager pm, int choice) {
-        final Map<String, Boolean> plan = SableAppSet.plan(choice, installed(pm));
+    private static void apply(PackageManager pm, Map<String, Boolean> plan) {
         for (Map.Entry<String, Boolean> entry : plan.entrySet()) {
             final int state = entry.getValue()
                     ? PackageManager.COMPONENT_ENABLED_STATE_DEFAULT
diff --git a/app/src/main/java/org/lineageos/setupwizard/sable/SableAppSet.java b/app/src/main/java/org/lineageos/setupwizard/sable/SableAppSet.java
index c7aca37..af908c7 100644
--- a/app/src/main/java/org/lineageos/setupwizard/sable/SableAppSet.java
+++ b/app/src/main/java/org/lineageos/setupwizard/sable/SableAppSet.java
@@ -143,6 +143,38 @@ public final class SableAppSet {
         return plan;
     }
 
+    /**
+     * The apps the step lets the user switch one by one: the Recommended and Optional Sable apps
+     * the phone has, in tier order. Core apps are not listed, so they cannot be switched off.
+     */
+    public static List<String> customizable(Set<String> installed) {
+        final List<String> apps = new java.util.ArrayList<>();
+        for (String app : RECOMMENDED) if (installed.contains(app)) apps.add(app);
+        for (String app : OPTIONAL) if (installed.contains(app)) apps.add(app);
+        return apps;
+    }
+
+    /**
+     * Like {@link #plan(int, Set)}, then each customizable app in {@code wanted} is set on (true)
+     * or off (false); a turned-off app turns its installed stock counterpart on. An entry for a
+     * Core or an uninstalled app is ignored.
+     */
+    public static Map<String, Boolean> plan(
+            int choice, Set<String> installed, Map<String, Boolean> wanted) {
+        final Map<String, Boolean> plan = plan(choice, installed);
+        for (String app : customizable(installed)) {
+            final Boolean want = wanted.get(app);
+            if (want == null) continue;
+            plan.put(app, want);
+            if (!want) {
+                for (String twin : twinsOf(app)) {
+                    if (installed.contains(twin)) plan.put(twin, true);
+                }
+            }
+        }
+        return plan;
+    }
+
     /** A remembered choice, or Full Sable for a missing or unknown value. */
     public static int choiceOf(String stored) {
         if ("essentials".equals(stored)) return ESSENTIALS;
