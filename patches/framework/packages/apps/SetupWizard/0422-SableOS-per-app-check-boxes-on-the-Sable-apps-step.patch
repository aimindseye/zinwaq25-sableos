 .../setupwizard/sable/SableAppSet.java        | 32 ++++++++++
 app/src/main/res/layout/sable_apps_page.xml   | 11 ++++
 app/src/main/res/values/sable_strings.xml     |  3 +-
 4 files changed, 104 insertions(+), 6 deletions(-)

diff --git a/app/src/main/java/org/lineageos/setupwizard/SableAppsActivity.java b/app/src/main/java/org/lineageos/setupwizard/SableAppsActivity.java
