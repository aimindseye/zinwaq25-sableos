 import java.util.Map;
 import java.util.Set;
 
@@ -32,25 +35,77 @@ public class SableAppsActivity extends BaseSetupWizardActivity {
     };
 
     private RadioGroup group;
+    private Set<String> installed;
+    /** One check box per app the step lets the user switch (Recommended and Optional). */
+    private final Map<String, CheckBox> boxes = new LinkedHashMap<>();
 
     @Override
     protected void onCreate(@Nullable Bundle savedInstanceState) {
         super.onCreate(savedInstanceState);
         getGlifLayout().setDescriptionText(getString(R.string.sable_apps_summary));
         group = findViewById(R.id.sable_apps_group);
-        final int stored = SableAppSet.choiceOf(
-                Settings.Secure.getString(getContentResolver(), SableAppSet.SETTING));
+        final String remembered =
+                Settings.Secure.getString(getContentResolver(), SableAppSet.SETTING);
+        final int stored = SableAppSet.choiceOf(remembered);
         group.check(IDS[stored]);
+        final PackageManager pm = getPackageManager();
+        installed = installed(pm);
+        final LinearLayout list = findViewById(R.id.sable_apps_list);
+        for (String app : SableAppSet.customizable(installed)) {
+            final CheckBox box = new CheckBox(this);
+            box.setText(labelOf(pm, app));
+            box.setMinHeight((int) (48 * getResources().getDisplayMetrics().density));
+            boxes.put(app, box);
+            list.addView(box);
+        }
+        // Revisited: show what is on now. First time: the chosen set's defaults.
+        final Map<String, Boolean> shown = SableAppSet.plan(stored, installed);
+        for (Map.Entry<String, CheckBox> entry : boxes.entrySet()) {
+            final String app = entry.getKey();
+            entry.getValue().setChecked(remembered != null ? isOn(pm, app) : shown.get(app));
+        }
+        // Picking another set puts its defaults back in the list.
+        group.setOnCheckedChangeListener((g, id) -> {
+            final Map<String, Boolean> defaults = SableAppSet.plan(choiceChecked(), installed);
+            for (Map.Entry<String, CheckBox> entry : boxes.entrySet()) {
+                final Boolean on = defaults.get(entry.getKey());
+                entry.getValue().setChecked(on == null || on);
+            }
+        });
         setNextAllowed(true);
     }
 
+    private static boolean isOn(PackageManager pm, String app) {
+        try {
+            final int state = pm.getApplicationEnabledSetting(app);
+            return state == PackageManager.COMPONENT_ENABLED_STATE_DEFAULT
+                    || state == PackageManager.COMPONENT_ENABLED_STATE_ENABLED;
+        } catch (IllegalArgumentException e) {
+            return true;
+        }
+    }
+
+    private static CharSequence labelOf(PackageManager pm, String app) {
+        try {
+            return pm.getApplicationLabel(
+                    pm.getApplicationInfo(app, PackageManager.MATCH_DISABLED_COMPONENTS));
+        } catch (PackageManager.NameNotFoundException e) {
+            return app;
+        }
+    }
+
     @Override
     protected void onNextPressed() {
         final int choice = choiceChecked();
         Settings.Secure.putString(getContentResolver(), SableAppSet.SETTING,
                 SableAppSet.storedValueOf(choice));
         final PackageManager pm = getPackageManager();
-        new Thread(() -> apply(pm, choice), "SableApps").start();
+        final Map<String, Boolean> wanted = new LinkedHashMap<>();
+        for (Map.Entry<String, CheckBox> entry : boxes.entrySet()) {
+            wanted.put(entry.getKey(), entry.getValue().isChecked());
+        }
+        final Map<String, Boolean> plan = SableAppSet.plan(choice, installed, wanted);
+        new Thread(() -> apply(pm, plan), "SableApps").start();
         super.onNextPressed();
     }
 
@@ -63,8 +118,7 @@ public class SableAppsActivity extends BaseSetupWizardActivity {
     }
 
