+/*
+ * SPDX-FileCopyrightText: The SableOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.setupwizard.sable;
+
+import android.app.Activity;
+import android.util.Log;
+import android.view.KeyEvent;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.EditText;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Applies {@link SableKeyPolicy} to a setup step's view hierarchy (SableOS IR-014).
+ *
+ * <p>It never blocks a step: any failure falls back to the platform's normal key handling,
+ * and keys the policy does not claim are left untouched.
+ */
+public final class SableKeyFocus {
+    private static final String TAG = "SableKeyFocus";
+
+    private SableKeyFocus() {}
+
+    /**
+     * @param primary the step's primary (forward) action, or null if none is shown
+     * @param onPrimary runs the primary action
+     * @return true when the key was handled here and must not be dispatched further
+     */
+    public static boolean dispatch(Activity activity, KeyEvent event, View primary,
+            Runnable onPrimary) {
+        try {
+            return dispatchUnchecked(activity, event, primary, onPrimary);
+        } catch (RuntimeException e) {
+            Log.w(TAG, "keyboard focus helper failed; using platform handling", e);
+            return false;
+        }
+    }
+
+    private static boolean dispatchUnchecked(Activity activity, KeyEvent event, View primary,
+            Runnable onPrimary) {
+        if (event.getAction() != KeyEvent.ACTION_DOWN) return false;
+        final View root = activity.findViewById(android.R.id.content);
+        if (!(root instanceof ViewGroup)) return false;
+
+        final List<View> controls = focusables((ViewGroup) root);
+        final View focused = activity.getCurrentFocus();
+        final int focusedIndex = focused == null ? -1 : controls.indexOf(focused);
+        final SableKeyPolicy.Focus focus;
+        if (focusedIndex < 0) {
+            focus = SableKeyPolicy.Focus.NONE;
+        } else if (focused instanceof EditText) {
+            focus = SableKeyPolicy.Focus.TEXT;
+        } else {
+            focus = SableKeyPolicy.Focus.CONTROL;
+        }
+
+        final boolean primaryAvailable = primary != null && primary.isShown()
+                && primary.isEnabled();
+        final SableKeyPolicy.Decision decision = SableKeyPolicy.decide(
+                SableKeyPolicy.kindOf(event.getKeyCode(), event.getUnicodeChar()),
+                focus,
+                SableKeyPolicy.hasCommandModifier(event.getMetaState()),
+                event.getRepeatCount() > 0,
+                focus == SableKeyPolicy.Focus.TEXT && isLastText(controls, focusedIndex),
+                primaryAvailable);
+
+        switch (decision) {
+            case CONSUME:
+                return true;
+            case FOCUS_INITIAL: {
+                final List<SableKeyPolicy.Candidate> kinds = new ArrayList<>();
+                for (View v : controls) {
+                    kinds.add(v instanceof EditText ? SableKeyPolicy.Candidate.TEXT
+                            : v == primary ? SableKeyPolicy.Candidate.PRIMARY
+                            : SableKeyPolicy.Candidate.CONTROL);
+                }
+                return focusAt(controls, SableKeyPolicy.initialIndex(kinds));
+            }
+            case FOCUS_FIRST:
+                return focusAt(controls, 0);
+            case FOCUS_LAST:
+                return focusAt(controls, controls.size() - 1);
+            case SUBMIT_PRIMARY:
+                if (onPrimary == null) return false;
+                onPrimary.run();
+                return true;
+            case PASS:
+            default:
+                return false;
+        }
+    }
+
+    private static boolean focusAt(List<View> controls, int index) {
+        if (index < 0 || index >= controls.size()) return false;
+        // requestFocusFromTouch leaves touch mode, so the focus highlight becomes visible.
+        return controls.get(index).requestFocusFromTouch();
+    }
+
+    private static boolean isLastText(List<View> controls, int index) {
+        for (int i = index + 1; i < controls.size(); i++) {
+            if (controls.get(i) instanceof EditText) return false;
+        }
+        return true;
+    }
+
+    private static List<View> focusables(ViewGroup root) {
+        // All focusables, not only touch-mode ones: the first key may arrive while still in touch mode.
+        final ArrayList<View> all = new ArrayList<>();
+        root.addFocusables(all, View.FOCUS_FORWARD, View.FOCUSABLES_ALL);
+        final List<View> out = new ArrayList<>(all.size());
+        for (View v : all) {
+            if (v.isShown() && v.isEnabled()) out.add(v);
+        }
+        return out;
+    }
+}
