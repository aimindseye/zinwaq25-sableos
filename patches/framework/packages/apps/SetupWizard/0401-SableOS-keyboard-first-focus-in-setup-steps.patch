+++ b/src/org/lineageos/setupwizard/sable/SableKeyPolicy.java
@@ -0,0 +1,174 @@
+/*
+ * SPDX-FileCopyrightText: The SableOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.setupwizard.sable;
+
+import java.util.List;
+
+/**
+ * Keyboard-first decisions for one setup step (SableOS IR-014), ported from the Sable
+ * setup flow reference model. Pure Java: no android.* types, so it is unit-tested off-device.
+ *
+ * <p>The policy only adds what the platform's own focus handling lacks on a hardware
+ * keyboard: a first key press with nothing focused lands on the step's initial control
+ * instead of doing nothing, MoveHome/MoveEnd jump to the first/last control, a held
+ * Enter/Space/Tab does not repeat an action, and Enter in the last text field runs the
+ * step's primary action. Everything else (arrows, Tab, Enter on a button, Back/Escape,
+ * text keys in a field, system Home, PageUp/PageDown, Ctrl/Meta shortcuts) is passed
+ * through unchanged, so the policy can never block a step.
+ */
+public final class SableKeyPolicy {
+
+    private SableKeyPolicy() {}
+
+    /** Normalized key meaning (same vocabulary as the Sable normalized key contract). */
+    public enum Kind {
+        UP, DOWN, LEFT, RIGHT, ACTIVATE, SPACE, BACK, ESCAPE, MOVE_HOME, MOVE_END,
+        PAGE_UP, PAGE_DOWN, TAB, BACKSPACE, PRINTABLE, OTHER
+    }
+
+    /** What owns focus when the key arrives. */
+    public enum Focus { NONE, TEXT, CONTROL }
+
+    /** What the host should do with the key. */
+    public enum Decision {
+        /** Leave the key to the platform (view focus search, IME, Back handling). */
+        PASS,
+        /** Swallow the key and do nothing (held-key repeat of a one-shot key). */
+        CONSUME,
+        /** Focus the step's initial control and make focus visible. */
+        FOCUS_INITIAL,
+        FOCUS_FIRST,
+        FOCUS_LAST,
+        /** Run the step's primary action (Next/Start). */
+        SUBMIT_PRIMARY
+    }
+
+    /** A focusable control as the policy sees it, in focus order. */
+    public enum Candidate { TEXT, PRIMARY, CONTROL }
+
+    // Public Android key codes and meta flags (android.view.KeyEvent); no device scan codes.
+    public static final int KEYCODE_HOME = 3;
+    public static final int KEYCODE_BACK = 4;
+    public static final int KEYCODE_DPAD_UP = 19;
+    public static final int KEYCODE_DPAD_DOWN = 20;
+    public static final int KEYCODE_DPAD_LEFT = 21;
+    public static final int KEYCODE_DPAD_RIGHT = 22;
+    public static final int KEYCODE_DPAD_CENTER = 23;
+    public static final int KEYCODE_TAB = 61;
+    public static final int KEYCODE_SPACE = 62;
+    public static final int KEYCODE_ENTER = 66;
+    public static final int KEYCODE_DEL = 67;
+    public static final int KEYCODE_PAGE_UP = 92;
+    public static final int KEYCODE_PAGE_DOWN = 93;
+    public static final int KEYCODE_ESCAPE = 111;
+    public static final int KEYCODE_MOVE_HOME = 122;
+    public static final int KEYCODE_MOVE_END = 123;
+    public static final int KEYCODE_NUMPAD_ENTER = 160;
+    public static final int META_CTRL_ON = 0x1000;
+    public static final int META_META_ON = 0x10000;
+
+    public static Kind kindOf(int keyCode, int unicodeChar) {
+        switch (keyCode) {
+            case KEYCODE_DPAD_UP: return Kind.UP;
+            case KEYCODE_DPAD_DOWN: return Kind.DOWN;
+            case KEYCODE_DPAD_LEFT: return Kind.LEFT;
+            case KEYCODE_DPAD_RIGHT: return Kind.RIGHT;
+            case KEYCODE_DPAD_CENTER:
+            case KEYCODE_ENTER:
+            case KEYCODE_NUMPAD_ENTER: return Kind.ACTIVATE;
+            case KEYCODE_SPACE: return Kind.SPACE;
+            case KEYCODE_BACK: return Kind.BACK;
+            case KEYCODE_ESCAPE: return Kind.ESCAPE;
+            case KEYCODE_HOME: return Kind.OTHER;
+            case KEYCODE_MOVE_HOME: return Kind.MOVE_HOME;
+            case KEYCODE_MOVE_END: return Kind.MOVE_END;
+            case KEYCODE_PAGE_UP: return Kind.PAGE_UP;
+            case KEYCODE_PAGE_DOWN: return Kind.PAGE_DOWN;
+            case KEYCODE_TAB: return Kind.TAB;
+            case KEYCODE_DEL: return Kind.BACKSPACE;
+            default:
+                return isPrintable(unicodeChar) ? Kind.PRINTABLE : Kind.OTHER;
+        }
+    }
+
+    public static boolean hasCommandModifier(int metaState) {
+        return (metaState & (META_CTRL_ON | META_META_ON)) != 0;
+    }
+
+    /**
+     * @param lastTextField the focused text field is the last text field of the step
+     * @param primaryAvailable the step has a visible, enabled primary action
+     */
+    public static Decision decide(Kind kind, Focus focus, boolean commandModifier,
+            boolean repeat, boolean lastTextField, boolean primaryAvailable) {
+        if (commandModifier) return Decision.PASS;
+        switch (kind) {
+            case OTHER:
+            case PAGE_UP:
+            case PAGE_DOWN:
+            case BACK:
+            case ESCAPE:
+                // System Home, paging and Back/Escape keep their platform meaning.
+                return Decision.PASS;
+            default:
+                break;
+        }
+        if (focus == Focus.TEXT) {
+            if (kind == Kind.ACTIVATE) {
+                if (repeat) return Decision.CONSUME;
+                return lastTextField && primaryAvailable ? Decision.SUBMIT_PRIMARY : Decision.PASS;
+            }
+            // Text keys, cursor keys and Tab stay with the field and the IME.
+            return Decision.PASS;
+        }
+        if (repeat && (kind == Kind.ACTIVATE || kind == Kind.SPACE || kind == Kind.TAB)) {
+            return Decision.CONSUME;
+        }
+        if (focus == Focus.NONE) {
+            switch (kind) {
+                case MOVE_HOME: return Decision.FOCUS_FIRST;
+                case MOVE_END: return Decision.FOCUS_LAST;
+                case UP:
+                case DOWN:
+                case LEFT:
+                case RIGHT:
+                case TAB:
+                case ACTIVATE:
+                case SPACE:
+                    // First key with nothing focused: show where focus is instead of acting.
+                    return Decision.FOCUS_INITIAL;
+                default:
+                    return Decision.PASS;
+            }
+        }
+        switch (kind) {
+            case MOVE_HOME: return Decision.FOCUS_FIRST;
+            case MOVE_END: return Decision.FOCUS_LAST;
+            default: return Decision.PASS;
+        }
+    }
+
+    /**
+     * Initial focus of a step: its first text field so typing works at once, else its
+     * primary action, else its first control. Returns -1 for a step with no controls.
+     */
+    public static int initialIndex(List<Candidate> candidates) {
+        int primary = -1;
+        for (int i = 0; i < candidates.size(); i++) {
+            if (candidates.get(i) == Candidate.TEXT) return i;
+            if (primary < 0 && candidates.get(i) == Candidate.PRIMARY) primary = i;
+        }
+        if (primary >= 0) return primary;
+        return candidates.isEmpty() ? -1 : 0;
+    }
+
+    private static boolean isPrintable(int unicode) {
+        if (unicode <= 0 || unicode > Character.MAX_VALUE) return false;
+        if ((unicode & 0x80000000) != 0) return false;
+        char c = (char) unicode;
+        return !Character.isISOControl(c) && !Character.isWhitespace(c);
+    }
+}
