From: SableOS <noreply@sableos.invalid>
Date: Wed, 21 Oct 2026 13:05:08 +0000
Subject: [PATCH] SableOS: Restore hidden until validated (fail-closed)

SETUP_WIZARD_FIRST_BOOT_UX: RESTORE_IMPORT_FAIL_CLOSED=YES, "If restore
is not ready, the screen should say so and continue with a clean setup
path rather than pretending restore exists" (owner decision: hidden
until validated).

RestoreIntroActivity, the step every script reaches for Seedvault
restore (owner, secondary user and work profile), now skips itself
unless @bool/sable_restore_validated is true. It is false here, and is
meant to be set only with an on-device QUALIFICATION pass. While hidden
the step never enables Next, never opens Seedvault and is not reopened
on the way back. The script entries stay, so validating restore is a
one-value change.

The Privacy step's restore paragraph is the small note: "Restore and
import: fail-closed until validated. Restoring a backup stays off on
this phone until it has been tested, so setup always starts clean.
SableOS keeps no copy of your data."

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01UvjoefgeNVBxmkGXzTTNYS
---
 .../java/org/lineageos/setupwizard/backup/RestoreIntroActivity.kt    | 24 ++++++++++++++++++++++++
 app/src/main/res/values/sable_config.xml                             | 11 +++++++++++
 app/src/main/res/values/sable_strings.xml                            |  2 +-
 3 files changed, 36 insertions(+), 1 deletion(-)

diff --git a/app/src/main/java/org/lineageos/setupwizard/backup/RestoreIntroActivity.kt b/app/src/main/java/org/lineageos/setupwizard/backup/RestoreIntroActivity.kt
index e496ace..9e77359 100644
--- a/app/src/main/java/org/lineageos/setupwizard/backup/RestoreIntroActivity.kt
+++ b/app/src/main/java/org/lineageos/setupwizard/backup/RestoreIntroActivity.kt
@@ -10,14 +10,24 @@ import android.content.Intent
 import android.os.Bundle
 import androidx.activity.result.ActivityResult
 import com.google.android.setupcompat.util.ResultCodes.RESULT_ACTIVITY_NOT_FOUND
+import com.google.android.setupcompat.util.ResultCodes.RESULT_SKIP
 import org.lineageos.setupwizard.ACTION_RESTORE_FROM_BACKUP
 import org.lineageos.setupwizard.R
 import org.lineageos.setupwizard.base.SubBaseActivity
 
 class RestoreIntroActivity : SubBaseActivity() {
 
+    /** SableOS: fail-closed; set by sable_restore_validated, never by the user. */
+    private var sableRestoreHidden = true
+
     override fun onCreate(savedInstanceState: Bundle?) {
+        sableRestoreHidden = !isSableRestoreValidated()
         super.onCreate(savedInstanceState)
+        if (sableRestoreHidden) {
+            // Restore and import stay hidden until validated; setup continues clean.
+            finishAction(RESULT_SKIP)
+            return
+        }
         setDescriptionText(getString(R.string.intro_restore_subtitle, getString(R.string.os_name)))
         setNextText(R.string.intro_restore_button)
     }
@@ -33,10 +43,24 @@ class RestoreIntroActivity : SubBaseActivity() {
     }
 
     override fun onStartSubactivity() {
+        if (sableRestoreHidden) return
         setNextAllowed(true)
     }
 
+    override fun onNextIntentResult(activityResult: ActivityResult) {
+        // Never reopen the restore screen on the way back while it is hidden.
+        if (!sableRestoreHidden) super.onNextIntentResult(activityResult)
+    }
+
+    private fun isSableRestoreValidated(): Boolean =
+        try {
+            resources.getBoolean(R.bool.sable_restore_validated)
+        } catch (e: RuntimeException) {
+            false
+        }
+
     override fun onNextPressed() {
+        if (sableRestoreHidden) return
         launchRestore()
     }
 
diff --git a/app/src/main/res/values/sable_config.xml b/app/src/main/res/values/sable_config.xml
new file mode 100644
index 0000000..3017d14
--- /dev/null
+++ b/app/src/main/res/values/sable_config.xml
@@ -0,0 +1,11 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+     SPDX-FileCopyrightText: The SableOS Project
+     SPDX-License-Identifier: Apache-2.0
+-->
+<resources>
+    <!-- SableOS (SETUP_WIZARD_FIRST_BOOT_UX RESTORE_IMPORT_FAIL_CLOSED): the Restore step stays
+         hidden until backup restore is validated on this device. Set true only with a
+         QUALIFICATION pass. -->
+    <bool name="sable_restore_validated">false</bool>
+</resources>
diff --git a/app/src/main/res/values/sable_strings.xml b/app/src/main/res/values/sable_strings.xml
index f9425d7..b4ab399 100644
--- a/app/src/main/res/values/sable_strings.xml
+++ b/app/src/main/res/values/sable_strings.xml
@@ -69,7 +69,7 @@
     <string name="sable_privacy_network_link">Network access</string>
     <string name="sable_privacy_lock_screen"><b>Lock screen.</b> While the phone is locked, notifications show only their app and count. Their content stays hidden until you unlock, unless you choose to show it.</string>
     <string name="sable_privacy_lock_screen_link">Lock screen notifications</string>
-    <string name="sable_privacy_restore"><b>Restore.</b> Restoring a backup uses Android’s own backup app. SableOS keeps no copy of your backup.</string>
+    <string name="sable_privacy_restore"><b>Restore and import: fail-closed until validated.</b> Restoring a backup stays off on this phone until it has been tested, so setup always starts clean. SableOS keeps no copy of your data.</string>
     <string name="sable_privacy_settings_link">Privacy settings</string>
 
     <!-- SableOS Sable accent on the Theme step (KF-B). Labels match Settings > Display > Accent. -->
