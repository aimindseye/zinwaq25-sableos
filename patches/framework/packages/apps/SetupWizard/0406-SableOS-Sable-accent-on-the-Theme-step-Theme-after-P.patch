 class ThemeSettingsActivity : BaseSetupWizardActivity() {
@@ -67,6 +75,64 @@ class ThemeSettingsActivity : BaseSetupWizardActivity() {
         setBlackThemeRevealed(isNight)
     }
 
+    override fun onResume() {
+        super.onResume()
+        // SableOS: re-read after returning from Settings > Display > Accent.
+        bindSableAccent()
+    }
+
+    /**
+     * SableOS: shows the Sable accent stored in the org.sableos.appearance authority and links
+     * to Settings > Display > Accent. Setup is not one of the authority's writers, so the
+     * accent is changed there, never written from here. Hidden when the authority is absent.
+     */
+    private fun bindSableAccent() {
+        val current = findViewById<TextView>(R.id.sable_accent_current) ?: return
+        val note = findViewById<View>(R.id.sable_accent_note) ?: return
+        val change = findViewById<Button>(R.id.sable_accent_change) ?: return
+        val index = SableAccent.indexOf(readSableAccent())
+        val labels = resources.getStringArray(R.array.sable_accent_entries)
+        if (index < 0 || index >= labels.size) {
+            current.visibility = View.GONE
+            note.visibility = View.GONE
+            change.visibility = View.GONE
+            return
+        }
+        current.text = getString(R.string.sable_theme_accent_current, labels[index])
+        current.visibility = View.VISIBLE
+        note.visibility = View.VISIBLE
+        val args = Bundle()
+        args.putString(SableAccent.EXTRA_FRAGMENT_ARG_KEY, SableAccent.SETTINGS_PREFERENCE_KEY)
+        SableLinks.bind(
+            this,
+            change,
+            Intent(Settings.ACTION_DISPLAY_SETTINGS)
+                .putExtra(SableAccent.EXTRA_FRAGMENT_ARG_KEY, SableAccent.SETTINGS_PREFERENCE_KEY)
+                .putExtra(SableAccent.EXTRA_SHOW_FRAGMENT_ARGUMENTS, args),
+        )
+    }
+
+    /** The stored accent value, or null when the authority is absent or unreadable. */
+    private fun readSableAccent(): String? =
+        try {
+            contentResolver
+                .query(
+                    Uri.parse(SableAccent.CONTENT_URI),
+                    arrayOf(SableAccent.COLUMN_ACCENT),
+                    null,
+                    null,
+                    null,
+                )
+                ?.use { cursor ->
+                    if (!cursor.moveToFirst()) return null
+                    val column = cursor.getColumnIndex(SableAccent.COLUMN_ACCENT)
+                    if (column < 0) null else cursor.getString(column)
+                }
+        } catch (e: RuntimeException) {
+            Log.w(TAG, "could not read the Sable accent", e)
+            null
+        }
+
