diff --git a/app/src/main/java/org/lineageos/setupwizard/sable/SableAccent.java b/app/src/main/java/org/lineageos/setupwizard/sable/SableAccent.java
new file mode 100644
index 0000000..c514286
--- /dev/null
+++ b/app/src/main/java/org/lineageos/setupwizard/sable/SableAccent.java
@@ -0,0 +1,52 @@
+/*
+ * SPDX-FileCopyrightText: The SableOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.setupwizard.sable;
+
+/**
+ * The Sable accent as the setup Theme step reads it (SableOS KF-B). Pure Java.
+ *
+ * <p>The accent lives in the {@code org.sableos.appearance} authority hosted by Settings
+ * (Settings patch 0101, SableAppearancePolicy). That provider is readable by anyone but only
+ * Settings, Sable Start and App display compatibility may write it, so setup never writes
+ * the accent: it shows the stored one and opens Settings > Display at the Accent row, the
+ * one place that changes it. Light/dark stays with UiModeManager, which the authority
+ * reports as "follow-system".
+ */
+public final class SableAccent {
+
+    private SableAccent() {}
+
+    public static final String AUTHORITY = "org.sableos.appearance";
+    public static final String CONTENT_URI = "content://" + AUTHORITY + "/appearance";
+    public static final String COLUMN_ACCENT = "accent";
+
+    /** Values in display order; equal to SableAppearancePolicy.ACCENTS in Settings. */
+    private static final String[] VALUES = {"blue", "green", "purple", "orange", "slate"};
+
+    /** Settings > Display > Accent preference key (Settings patch 0101). */
+    public static final String SETTINGS_PREFERENCE_KEY = "sable_accent";
+    /** SettingsActivity extras that scroll to and highlight one preference. */
+    public static final String EXTRA_FRAGMENT_ARG_KEY = ":settings:fragment_args_key";
+    public static final String EXTRA_SHOW_FRAGMENT_ARGUMENTS = ":settings:show_fragment_args";
+
+    /** Number of accents; the label array in resources has the same length and order. */
+    public static int count() {
+        return VALUES.length;
+    }
+
+    /**
+     * Index of a stored accent value for its label, or -1 when the value is missing or not a
+     * Sable preset (the step then shows no accent rather than guessing).
+     */
+    public static int indexOf(String value) {
+        if (value == null) return -1;
+        final String v = value.trim();
+        for (int i = 0; i < VALUES.length; i++) {
+            if (VALUES[i].equals(v)) return i;
+        }
+        return -1;
+    }
+}
