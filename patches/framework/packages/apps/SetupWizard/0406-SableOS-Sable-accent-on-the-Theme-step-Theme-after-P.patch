@@ -33,6 +44,55 @@ public class ThemeSettingsActivity extends BaseSetupWizardActivity {
         });
     }
 
+    @Override
+    protected void onResume() {
+        super.onResume();
+        // SableOS: re-read after returning from Settings > Display > Accent.
+        bindSableAccent();
+    }
+
+    /**
+     * SableOS: shows the Sable accent stored in the org.sableos.appearance authority and links
+     * to Settings > Display > Accent. Setup is not one of the authority's writers, so the
+     * accent is changed there, never written from here. Hidden when the authority is absent.
+     */
+    private void bindSableAccent() {
+        final TextView current = findViewById(R.id.sable_accent_current);
+        final View note = findViewById(R.id.sable_accent_note);
+        final Button change = findViewById(R.id.sable_accent_change);
+        if (current == null || note == null || change == null) return;
+        final int index = SableAccent.indexOf(readSableAccent());
+        final String[] labels = getResources().getStringArray(R.array.sable_accent_entries);
+        if (index < 0 || index >= labels.length) {
+            current.setVisibility(View.GONE);
+            note.setVisibility(View.GONE);
+            change.setVisibility(View.GONE);
+            return;
+        }
+        current.setText(getString(R.string.sable_theme_accent_current, labels[index]));
+        current.setVisibility(View.VISIBLE);
+        note.setVisibility(View.VISIBLE);
+        final Bundle args = new Bundle();
+        args.putString(SableAccent.EXTRA_FRAGMENT_ARG_KEY, SableAccent.SETTINGS_PREFERENCE_KEY);
+        SableLinks.bind(this, change, new Intent(Settings.ACTION_DISPLAY_SETTINGS)
+                .putExtra(SableAccent.EXTRA_FRAGMENT_ARG_KEY, SableAccent.SETTINGS_PREFERENCE_KEY)
+                .putExtra(SableAccent.EXTRA_SHOW_FRAGMENT_ARGUMENTS, args));
+    }
+
+    /** The stored accent value, or null when the authority is absent or unreadable. */
+    @Nullable
+    private String readSableAccent() {
+        try (Cursor cursor = getContentResolver().query(Uri.parse(SableAccent.CONTENT_URI),
+                new String[] {SableAccent.COLUMN_ACCENT}, null, null, null)) {
+            if (cursor == null || !cursor.moveToFirst()) return null;
+            final int column = cursor.getColumnIndex(SableAccent.COLUMN_ACCENT);
+            return column < 0 ? null : cursor.getString(column);
+        } catch (RuntimeException e) {
+            Log.w(TAG, "could not read the Sable accent", e);
+            return null;
+        }
+    }
+
