diff --git a/app/src/main/java/org/lineageos/setupwizard/SableAppsActivity.java b/app/src/main/java/org/lineageos/setupwizard/SableAppsActivity.java
new file mode 100644
index 0000000..3ebadf5
--- /dev/null
+++ b/app/src/main/java/org/lineageos/setupwizard/SableAppsActivity.java
@@ -0,0 +1,105 @@
+/*
+ * SPDX-FileCopyrightText: The SableOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.setupwizard;
+
+import android.annotation.Nullable;
+import android.content.pm.PackageManager;
+import android.os.Bundle;
+import android.provider.Settings;
+import android.util.Log;
+import android.widget.RadioGroup;
+
+import org.lineageos.setupwizard.base.BaseSetupWizardActivity;
+import org.lineageos.setupwizard.sable.SableAppSet;
+
+import java.util.HashSet;
+import java.util.Map;
+import java.util.Set;
+
+/**
+ * SableOS Sable apps step, after Theme: Full Sable, Essentials or Stock Android
+ * ({@link SableAppSet}). Apps left out are disabled for this user, never uninstalled, and come
+ * back from Settings, Apps. Next applies the choice; the step shows the last choice when
+ * revisited, and choosing Full Sable again turns every Sable app back on.
+ */
+public class SableAppsActivity extends BaseSetupWizardActivity {
+    private static final String TAG = "SableApps";
+    private static final int[] IDS = {
+        R.id.sable_apps_full, R.id.sable_apps_essentials, R.id.sable_apps_stock,
+    };
+
+    private RadioGroup group;
+
+    @Override
+    protected void onCreate(@Nullable Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        getGlifLayout().setDescriptionText(getString(R.string.sable_apps_summary));
+        group = findViewById(R.id.sable_apps_group);
+        final int stored = SableAppSet.choiceOf(
+                Settings.Secure.getString(getContentResolver(), SableAppSet.SETTING));
+        group.check(IDS[stored]);
+        setNextAllowed(true);
+    }
+
+    @Override
+    protected void onNextPressed() {
+        final int choice = choiceChecked();
+        Settings.Secure.putString(getContentResolver(), SableAppSet.SETTING,
+                SableAppSet.storedValueOf(choice));
+        final PackageManager pm = getPackageManager();
+        new Thread(() -> apply(pm, choice), "SableApps").start();
+        super.onNextPressed();
+    }
+
+    private int choiceChecked() {
+        final int checked = group.getCheckedRadioButtonId();
+        for (int i = 0; i < IDS.length; i++) {
+            if (IDS[i] == checked) return i;
+        }
+        return SableAppSet.FULL;
+    }
+
+    /** Disables or re-enables each installed app for this user; never uninstalls anything. */
+    private static void apply(PackageManager pm, int choice) {
+        final Map<String, Boolean> plan = SableAppSet.plan(choice, installed(pm));
+        for (Map.Entry<String, Boolean> entry : plan.entrySet()) {
+            final int state = entry.getValue()
+                    ? PackageManager.COMPONENT_ENABLED_STATE_DEFAULT
+                    : PackageManager.COMPONENT_ENABLED_STATE_DISABLED_USER;
+            try {
+                if (pm.getApplicationEnabledSetting(entry.getKey()) != state) {
+                    pm.setApplicationEnabledSetting(entry.getKey(), state, 0);
+                }
+            } catch (IllegalArgumentException | SecurityException e) {
+                Log.w(TAG, "could not change " + entry.getKey(), e);
+            }
+        }
+    }
+
+    private static Set<String> installed(PackageManager pm) {
+        final Set<String> names = new HashSet<>();
+        for (android.content.pm.ApplicationInfo info : pm.getInstalledApplications(
+                PackageManager.MATCH_DISABLED_COMPONENTS)) {
+            names.add(info.packageName);
+        }
+        return names;
+    }
+
+    @Override
+    protected int getLayoutResId() {
+        return R.layout.sable_apps_page;
+    }
+
+    @Override
+    protected int getTitleResId() {
+        return R.string.setup_sable_apps;
+    }
+
+    @Override
+    protected int getIconResId() {
+        return R.drawable.ic_sable_apps;
+    }
+}
diff --git a/app/src/main/java/org/lineageos/setupwizard/sable/SableAppSet.java b/app/src/main/java/org/lineageos/setupwizard/sable/SableAppSet.java
new file mode 100644
index 0000000..53fbd7d
--- /dev/null
+++ b/app/src/main/java/org/lineageos/setupwizard/sable/SableAppSet.java
@@ -0,0 +1,171 @@
+/*
+ * SPDX-FileCopyrightText: The SableOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.setupwizard.sable;
+
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+/**
+ * Which apps the Sable apps step leaves on: Full Sable, Essentials or Stock Android. Pure Java.
+ *
+ * <p>Apps are only ever disabled for the user, never uninstalled, and Settings, Apps brings any
+ * of them back. A LineageOS app is never disabled here: Full Sable leaves the stock apps as they
+ * are, and Essentials and Stock Android turn a stock app back on where the Sable app it stands in
+ * for is turned off.
+ *
+ * <ul>
+ *   <li><b>Full Sable</b>: every Sable app on.
+ *   <li><b>Essentials</b>: Keyboard, Start, Setup, Tools, Hub, Messages, Camera and Vault; the
+ *       other Sable apps off.
+ *   <li><b>Stock Android</b>: the LineageOS app where the phone has one; a Sable app is turned
+ *       off when it has no stock counterpart or its counterpart is installed, so Messages stays
+ *       on when the image has no other SMS app.
+ * </ul>
+ *
+ * <p>Start (the home screen), Keyboard (the Q25 keyboard's input method), Setup, Display Compat
+ * and the speech engine and screen reader are never turned off by this step.
+ */
+public final class SableAppSet {
+    public static final int FULL = 0;
+    public static final int ESSENTIALS = 1;
+    public static final int STOCK = 2;
+
+    /** Settings.Secure key that remembers the choice, so the step shows it when revisited. */
+    public static final String SETTING = "sable_app_set";
+
+    /** Never turned off: home, input, setup itself, display compatibility and accessibility. */
+    public static final Set<String> ALWAYS = set(
+            "org.sableos.launcher",
+            "org.sableos.titan2.keyboard",
+            "org.sableos.titan2.setup",
+            "org.sableos.titan2.displaycompat",
+            "org.sableos.speech",
+            "org.sableos.textreader");
+
+    /** The Essentials set (owner decision): Keyboard, Start, Setup, Tools, Hub, Messages, Camera, Vault. */
+    public static final Set<String> ESSENTIAL = set(
+            "org.sableos.launcher",
+            "org.sableos.titan2.keyboard",
+            "org.sableos.titan2.setup",
+            "org.sableos.tools",
+            "org.sableos.hub",
+            "org.sableos.messages",
+            "org.sableos.titan2.camera",
+            "org.sableos.titan2.vault");
+
+    /** Every other Sable app the image may hold. */
+    public static final List<String> OPTIONAL = Collections.unmodifiableList(Arrays.asList(
+            "org.sableos.titan2.profiles",
+            "org.sableos.titan2.spaces",
+            "org.sableos.titan2.printtogo",
+            "org.sableos.titan2.compass",
+            "org.sableos.titan2.radiodiag",
+            "org.sableos.calculator",
+            "org.sableos.sudoku",
+            "org.sableos.minesweeper",
+            "org.sableos.game2048",
+            "org.sableos.bricks",
+            "org.sableos.snake",
+            "org.sableos.blocks",
+            "org.sableos.reversi",
+            "org.sableos.solitaire",
+            "org.sableos.mahjong",
+            "org.sableos.words",
+            "org.sableos.media",
+            "org.sableos.weather",
+            "org.sableos.calendar",
+            "org.sableos.notes",
+            "org.sableos.tasks",
+            "org.sableos.browser",
+            "org.sableos.reader",
+            "org.sableos.mail",
+            "org.sableos.terminal"));
+
+    /** The LineageOS apps a Sable app stands in for. */
+    private static final Map<String, List<String>> STOCK_TWINS;
+
+    static {
+        final Map<String, List<String>> m = new LinkedHashMap<>();
+        m.put("org.sableos.messages", Collections.singletonList("com.android.messaging"));
+        m.put("org.sableos.calendar", Collections.singletonList("org.lineageos.etar"));
+        m.put("org.sableos.media", Collections.singletonList("org.lineageos.twelve"));
+        m.put("org.sableos.calculator", Collections.singletonList("com.android.calculator2"));
+        m.put("org.sableos.titan2.camera", Collections.singletonList("org.lineageos.aperture"));
+        m.put("org.sableos.browser", Collections.singletonList("org.lineageos.jelly"));
+        STOCK_TWINS = Collections.unmodifiableMap(m);
+    }
+
+    private SableAppSet() {}
+
+    /** The stock apps that stand in for {@code sablePackage}, possibly none. */
+    public static List<String> twinsOf(String sablePackage) {
+        final List<String> twins = STOCK_TWINS.get(sablePackage);
+        return twins == null ? Collections.<String>emptyList() : twins;
+    }
+
+    /**
+     * @param choice {@link #FULL}, {@link #ESSENTIALS} or {@link #STOCK}
+     * @param installed the packages installed for the user (enabled or not)
+     * @return package to on (true) or off (false), in a stable order, for installed packages only;
+     *     a package missing from the map is left as it is
+     */
+    public static Map<String, Boolean> plan(int choice, Set<String> installed) {
+        final Map<String, Boolean> plan = new LinkedHashMap<>();
+        for (String app : sableApps()) {
+            if (!installed.contains(app)) continue;
+            final boolean on = keepsOn(choice, app, installed);
+            plan.put(app, on);
+            if (!on) {
+                // Its stock counterpart takes over, so it must be on.
+                for (String twin : twinsOf(app)) {
+                    if (installed.contains(twin)) plan.put(twin, true);
+                }
+            }
+        }
+        return plan;
+    }
+
+    /** A remembered choice, or Full Sable for a missing or unknown value. */
+    public static int choiceOf(String stored) {
+        if ("essentials".equals(stored)) return ESSENTIALS;
+        if ("stock".equals(stored)) return STOCK;
+        return FULL;
+    }
+
+    /** The value stored for a choice. */
+    public static String storedValueOf(int choice) {
+        if (choice == ESSENTIALS) return "essentials";
+        if (choice == STOCK) return "stock";
+        return "full";
+    }
+
+    private static boolean keepsOn(int choice, String app, Set<String> installed) {
+        if (ALWAYS.contains(app) || choice == FULL) return true;
+        if (choice == ESSENTIALS) return ESSENTIAL.contains(app);
+        // Stock Android: off unless the app stands in for stock apps the phone does not have.
+        final List<String> twins = twinsOf(app);
+        if (twins.isEmpty()) return false;
+        for (String twin : twins) {
+            if (installed.contains(twin)) return false;
+        }
+        return true;
+    }
+
+    private static List<String> sableApps() {
+        final List<String> all = new java.util.ArrayList<>(ESSENTIAL);
+        for (String app : ALWAYS) if (!all.contains(app)) all.add(app);
+        all.addAll(OPTIONAL);
+        return all;
+    }
+
+    private static Set<String> set(String... packages) {
+        return Collections.unmodifiableSet(new java.util.LinkedHashSet<>(Arrays.asList(packages)));
+    }
+}
