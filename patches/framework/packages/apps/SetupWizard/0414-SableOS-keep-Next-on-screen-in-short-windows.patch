@@ -126,7 +126,9 @@
                 android:textAppearance="@style/SableSetupStep" />
         </LinearLayout>
 
+        <!-- SableOS: the id lets a short window pin this bar under the scroll view. -->
         <LinearLayout
+            android:id="@+id/sable_button_bar"
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:orientation="horizontal"
