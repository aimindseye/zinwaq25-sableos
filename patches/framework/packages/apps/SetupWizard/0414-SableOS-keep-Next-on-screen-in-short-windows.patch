@@ -369,6 +373,50 @@ abstract class BaseSetupWizardActivity : AppCompatActivity() {
         }
     }
 
+    /**
+     * SableOS: on a short window ([SableShortWindow]) a page's own button bar (Welcome's Start)
+     * moves out of the Glif scroll view to sit under it, so Start is always on screen, and the
+     * header icon and logo are hidden and the title made smaller. The footer bar's Next already
+     * sits under the scroll view. Never fails the step.
+     */
+    private fun fitShortWindow() {
+        try {
+            if (!SableShortWindow.isShort(resources.configuration.screenHeightDp)) return
+            val layout = findViewById<View>(R.id.setup_wizard_layout) as? GlifLayout ?: return
+            hideById(layout, resources.getIdentifier("sud_layout_icon", "id", packageName))
+            hideById(layout, R.id.brand_logo)
+            layout.headerTextView?.textSize = SableShortWindow.TITLE_SP
+            val bar = findViewById<View>(R.id.sable_button_bar) ?: return
+            val scroll =
+                layout.findViewById<View>(
+                    resources.getIdentifier("sud_scroll_view", "id", packageName)
+                ) as? ScrollView ?: return
+            val column = scroll.parent as? LinearLayout ?: return
+            val barParent = bar.parent as? ViewGroup ?: return
+            if (column.orientation != LinearLayout.VERTICAL) return
+            barParent.removeView(bar)
+            scroll.layoutParams =
+                LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, 0, 1f)
+            val pad = Math.round(8 * resources.displayMetrics.density)
+            bar.setPadding(pad * 2, pad / 2, pad * 2, pad / 2)
+            column.addView(
+                bar,
+                column.indexOfChild(scroll) + 1,
+                LinearLayout.LayoutParams(
+                    ViewGroup.LayoutParams.MATCH_PARENT,
+                    ViewGroup.LayoutParams.WRAP_CONTENT,
+                ),
+            )
+        } catch (e: RuntimeException) {
+            Log.w(TAG, "could not fit setup to the short window", e)
+        }
+    }
+
+    private fun hideById(root: View, id: Int) {
+        if (id == 0 || id == View.NO_ID) return
+        root.findViewById<View>(id)?.visibility = View.GONE
+    }
+
     protected val template: SetupTemplate by lazy {
         when (val root = requireViewById<View>(R.id.setup_wizard_layout)) {
             is GlifLayout -> GlifTemplate(root)
diff --git a/app/src/main/java/org/lineageos/setupwizard/sable/SableShortWindow.java b/app/src/main/java/org/lineageos/setupwizard/sable/SableShortWindow.java
new file mode 100644
index 0000000..762d0fd
--- /dev/null
+++ b/app/src/main/java/org/lineageos/setupwizard/sable/SableShortWindow.java
@@ -0,0 +1,30 @@
+/*
+ * SPDX-FileCopyrightText: The SableOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.setupwizard.sable;
+
+/**
+ * Setup on a short window, such as the Zinwa Q25's 411 dp square screen. Pure Java.
+ *
+ * <p>Every setup page sits inside the Glif layout's scroll view, below its header (icon, title,
+ * description). On a short window that header and the page together run past the bottom, so Next
+ * or Start scrolls off screen. In a short window the page's button bar is pinned under the scroll
+ * view, the header icon and the welcome/finish logo are hidden and the header title is smaller.
+ * The decision follows the window height, never the device model.
+ */
+public final class SableShortWindow {
+    /** Below this height (dp) a window is short; the same limit Sable apps use. */
+    public static final int SHORT_MAX_HEIGHT_DP = 600;
+
+    /** Header title size (sp) in a short window. */
+    public static final float TITLE_SP = 22f;
+
+    private SableShortWindow() {}
+
+    /** True for a window under {@link #SHORT_MAX_HEIGHT_DP}; an unknown height (0 or less) is not. */
+    public static boolean isShort(int heightDp) {
+        return heightDp > 0 && heightDp < SHORT_MAX_HEIGHT_DP;
+    }
+}
