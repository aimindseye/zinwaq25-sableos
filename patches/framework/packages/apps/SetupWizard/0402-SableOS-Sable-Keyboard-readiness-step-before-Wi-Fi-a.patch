diff --git a/src/org/lineageos/setupwizard/SableKeyboardActivity.java b/src/org/lineageos/setupwizard/SableKeyboardActivity.java
new file mode 100644
index 00000000..ca67a89d
--- /dev/null
+++ b/src/org/lineageos/setupwizard/SableKeyboardActivity.java
@@ -0,0 +1,157 @@
+/*
+ * SPDX-FileCopyrightText: The SableOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.setupwizard;
+
+import android.annotation.Nullable;
+import android.content.ComponentName;
+import android.content.Intent;
+import android.content.pm.PackageManager;
+import android.os.Bundle;
+import android.provider.Settings;
+import android.util.Log;
+import android.view.View;
+import android.view.inputmethod.InputMethodInfo;
+import android.view.inputmethod.InputMethodManager;
+import android.widget.Button;
+import android.widget.TextView;
+
+import org.lineageos.setupwizard.sable.SableKeyboardState;
+import org.lineageos.setupwizard.sable.SableKeyboardState.Availability;
+import org.lineageos.setupwizard.sable.SableKeyboardState.Offer;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * SableOS keyboard readiness step (IR-014), placed before Wi-Fi and screen lock so the
+ * user knows whether the physical keys will type passwords and PINs. It only reads state
+ * and opens system screens the user confirms in; Next is always enabled.
+ */
+public class SableKeyboardActivity extends BaseSetupWizardActivity {
+    private static final String TAG = "SableKeyboardActivity";
+
+    private TextView mStatus;
+    private Button mOffer;
+
+    @Override
+    protected void onCreate(@Nullable Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        getGlifLayout().setDescriptionText(getString(R.string.sable_keyboard_summary));
+        mStatus = findViewById(R.id.sable_keyboard_status);
+        mOffer = findViewById(R.id.sable_keyboard_offer);
+        setNextAllowed(true);
+    }
+
+    @Override
+    protected void onResume() {
+        super.onResume();
+        // Re-read after returning from the picker or keyboard settings.
+        refresh();
+    }
+
+    private void refresh() {
+        final Availability availability = readAvailability();
+        mStatus.setText(statusText(availability));
+        bindOffer(SableKeyboardState.offer(availability));
+        setNextAllowed(SableKeyboardState.canContinue(availability));
+    }
+
+    private Availability readAvailability() {
+        try {
+            boolean installed;
+            try {
+                getPackageManager().getPackageInfo(SableKeyboardState.PACKAGE, 0);
+                installed = true;
+            } catch (PackageManager.NameNotFoundException e) {
+                installed = false;
+            }
+            final InputMethodManager imm = getSystemService(InputMethodManager.class);
+            List<String> enabled = null;
+            if (imm != null) {
+                enabled = new ArrayList<>();
+                for (InputMethodInfo info : imm.getEnabledInputMethodList()) {
+                    enabled.add(info.getId());
+                }
+            }
+            final String selected = Settings.Secure.getString(getContentResolver(),
+                    Settings.Secure.DEFAULT_INPUT_METHOD);
+            return SableKeyboardState.classify(true, installed, enabled, selected);
+        } catch (RuntimeException e) {
+            Log.w(TAG, "could not read input method state", e);
+            return SableKeyboardState.classify(false, false, null, null);
+        }
+    }
+
+    private int statusText(Availability availability) {
+        switch (availability) {
+            case SABLE_SELECTED: return R.string.sable_keyboard_selected;
+            case SABLE_ENABLED_NOT_SELECTED: return R.string.sable_keyboard_not_selected;
+            case SABLE_NOT_ENABLED: return R.string.sable_keyboard_not_enabled;
+            case UNAVAILABLE: return R.string.sable_keyboard_unavailable;
+            case UNKNOWN:
+            default:
+                return R.string.sable_keyboard_unknown;
+        }
+    }
+
+    private void bindOffer(Offer offer) {
+        final Intent target;
+        final int label;
+        switch (offer) {
+            case KEYBOARD_SETTINGS:
+                target = new Intent(Intent.ACTION_MAIN).setComponent(new ComponentName(
+                        SableKeyboardState.PACKAGE, SableKeyboardState.SETTINGS_CLASS));
+                label = R.string.sable_keyboard_offer_settings;
+                break;
+            case INPUT_SETTINGS:
+                target = new Intent(Settings.ACTION_INPUT_METHOD_SETTINGS);
+                label = R.string.sable_keyboard_offer_enable;
+                break;
+            case PICK_KEYBOARD:
+                target = null;
+                label = R.string.sable_keyboard_offer_pick;
+                break;
+            case NONE:
+            default:
+                mOffer.setVisibility(View.GONE);
+                return;
+        }
+        if (target != null && target.resolveActivity(getPackageManager()) == null) {
+            // Only offer screens that exist on this build.
+            mOffer.setVisibility(View.GONE);
+            return;
+        }
+        mOffer.setText(label);
+        mOffer.setVisibility(View.VISIBLE);
+        mOffer.setOnClickListener(v -> {
+            try {
+                if (target == null) {
+                    final InputMethodManager imm = getSystemService(InputMethodManager.class);
+                    if (imm != null) imm.showInputMethodPicker();
+                } else {
+                    startActivity(target);
+                }
+            } catch (RuntimeException e) {
+                Log.w(TAG, "could not open keyboard screen", e);
+            }
+        });
+    }
+
+    @Override
+    protected int getLayoutResId() {
+        return R.layout.sable_keyboard_page;
+    }
+
+    @Override
+    protected int getTitleResId() {
+        return R.string.setup_sable_keyboard;
+    }
+
+    @Override
+    protected int getIconResId() {
+        return R.drawable.ic_sable_keyboard_setup;
+    }
+}
diff --git a/src/org/lineageos/setupwizard/sable/SableKeyboardState.java b/src/org/lineageos/setupwizard/sable/SableKeyboardState.java
new file mode 100644
index 00000000..b58852fb
--- /dev/null
+++ b/src/org/lineageos/setupwizard/sable/SableKeyboardState.java
@@ -0,0 +1,96 @@
+/*
+ * SPDX-FileCopyrightText: The SableOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.setupwizard.sable;
+
+import java.util.List;
+
+/**
+ * Sable Keyboard readiness for the setup keyboard step (SableOS IR-014). Pure Java: the
+ * activity reads the platform state and this class decides what to say and offer.
+ *
+ * <p>The step is informational: every state can continue. Sable Keyboard when it is the
+ * selected input method; otherwise the user can pick it, enable it, or go on with whatever
+ * keyboard the device has. Nothing here writes a setting.
+ */
+public final class SableKeyboardState {
+
+    private SableKeyboardState() {}
+
+    public static final String PACKAGE = "org.sableos.titan2.keyboard";
+    public static final String IME_CLASS = PACKAGE + ".android.SableImeService";
+    public static final String SETTINGS_CLASS = PACKAGE + ".android.KeyboardSettingsActivity";
+
+    public enum Availability {
+        /** Sable Keyboard is the selected input method. */
+        SABLE_SELECTED,
+        /** Enabled but another input method is selected. */
+        SABLE_ENABLED_NOT_SELECTED,
+        /** Installed but not enabled as an input method. */
+        SABLE_NOT_ENABLED,
+        /** Not installed on this build. */
+        UNAVAILABLE,
+        /** The input method state could not be read. */
+        UNKNOWN
+    }
+
+    /** The one extra action the step offers besides Next. */
+    public enum Offer { KEYBOARD_SETTINGS, PICK_KEYBOARD, INPUT_SETTINGS, NONE }
+
+    /** True for "pkg/.Cls", "pkg/pkg.Cls" and surrounding whitespace forms of Sable's IME id. */
+    public static boolean isSableIme(String id) {
+        if (id == null) return false;
+        final String clean = id.trim();
+        final int slash = clean.indexOf('/');
+        if (slash <= 0 || slash == clean.length() - 1) return false;
+        final String pkg = clean.substring(0, slash);
+        String cls = clean.substring(slash + 1);
+        if (cls.startsWith(".")) cls = pkg + cls;
+        return PACKAGE.equals(pkg) && IME_CLASS.equals(cls);
+    }
+
+    /**
+     * @param readOk the input method state was read without error
+     * @param installed the Sable Keyboard package is installed
+     * @param enabledIds ids of the enabled input methods (may be null when unreadable)
+     * @param selectedId the selected input method id (Settings.Secure.DEFAULT_INPUT_METHOD)
+     */
+    public static Availability classify(boolean readOk, boolean installed,
+            List<String> enabledIds, String selectedId) {
+        if (!readOk) return Availability.UNKNOWN;
+        if (!installed) return Availability.UNAVAILABLE;
+        if (isSableIme(selectedId)) return Availability.SABLE_SELECTED;
+        if (enabledIds == null) return Availability.UNKNOWN;
+        for (String id : enabledIds) {
+            if (isSableIme(id)) return Availability.SABLE_ENABLED_NOT_SELECTED;
+        }
+        return Availability.SABLE_NOT_ENABLED;
+    }
+
+    public static Offer offer(Availability availability) {
+        switch (availability) {
+            case SABLE_SELECTED: return Offer.KEYBOARD_SETTINGS;
+            case SABLE_ENABLED_NOT_SELECTED: return Offer.PICK_KEYBOARD;
+            case SABLE_NOT_ENABLED: return Offer.INPUT_SETTINGS;
+            case UNKNOWN: return Offer.PICK_KEYBOARD;
+            case UNAVAILABLE:
+            default:
+                return Offer.NONE;
+        }
+    }
+
+    /** Setup never stops here: every state may continue. */
+    public static boolean canContinue(Availability availability) {
+        return true;
+    }
+
+    /**
+     * A physical keyboard never forces the on-screen keyboard open; without one, the
+     * on-screen keyboard is always offered.
+     */
+    public static boolean showSoftOnFocus(boolean physicalKeyboard) {
+        return !physicalKeyboard;
+    }
+}
