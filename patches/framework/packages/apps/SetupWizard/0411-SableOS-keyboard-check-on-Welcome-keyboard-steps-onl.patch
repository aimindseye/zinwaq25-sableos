@@ -0,0 +1,53 @@
+/*
+ * SPDX-FileCopyrightText: The SableOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.setupwizard.sable;
+
+/**
+ * The keyboard check on the Welcome screen (setup design: "Check physical keyboard · Type A 7 @
+ * then press Enter"). Pure Java.
+ *
+ * <p>A letter, a digit (Alt+Z on the Q25) and a symbol (Alt or Sym) show that the keys type
+ * all three layers before Wi-Fi passwords and the PIN. Spaces are ignored and the letter may
+ * be either case. When the check passes, the full keyboard test step is left out; when it is
+ * skipped or does not pass, the full test follows as the recovery path.
+ */
+public final class SableQuickCheck {
+
+    public enum Result {
+        /** Nothing typed: Start continues and the full keyboard test follows. */
+        EMPTY,
+        /** "A 7 @" typed: the keys work. */
+        PASS,
+        /** Something else typed: say so and stay on Welcome. */
+        MISMATCH
+    }
+
+    /** Setup-wide flag (SetupWizardApp settings bundle): the Welcome check passed. */
+    public static final String KEY_PASSED = "sable_keyboard_check_passed";
+
+    private static final String TARGET = "a7@";
+
+    private SableQuickCheck() {}
+
+    public static Result evaluate(CharSequence typed) {
+        if (typed == null) return Result.EMPTY;
+        final StringBuilder sb = new StringBuilder();
+        final String s = typed.toString();
+        for (int i = 0; i < s.length(); ) {
+            final int c = s.codePointAt(i);
+            i += Character.charCount(c);
+            if (Character.isWhitespace(c) || Character.isSpaceChar(c)) continue;
+            sb.appendCodePoint(Character.toLowerCase(c));
+        }
+        if (sb.length() == 0) return Result.EMPTY;
+        return TARGET.contentEquals(sb) ? Result.PASS : Result.MISMATCH;
+    }
+
+    /** The full keyboard test step shows only when the Welcome check did not pass. */
+    public static boolean showFullTest(boolean welcomePassed) {
+        return !welcomePassed;
+    }
+}
