+
+package com.android.settings.applications.sable;
+
+import android.app.settings.SettingsEnums;
+import android.content.Context;
+import android.os.Bundle;
+import android.view.View;
+import android.widget.Toast;
+
+import androidx.preference.ListPreference;
+import androidx.preference.MultiSelectListPreference;
+import androidx.preference.Preference;
+import androidx.preference.PreferenceCategory;
+import androidx.preference.SwitchPreferenceCompat;
+
+import com.android.settings.R;
+import com.android.settings.SettingsPreferenceFragment;
+import com.android.settings.applications.sable.model.PackageSet;
+import com.android.settings.applications.sable.model.StudentSchedule;
+import com.android.settings.search.BaseSearchIndexProvider;
+import com.android.settingslib.search.SearchIndexable;
+import com.android.settingslib.utils.ThreadUtils;
+
+import java.time.DayOfWeek;
+import java.time.format.TextStyle;
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Locale;
+import java.util.Set;
+import java.util.TreeSet;
+
+/**
+ * Student mode (Mobile Manager &gt; Student mode; also org.sableos.settings.STUDENT_MODE and
+ * the configuration page of its entry in Settings &gt; Modes): a switch for now, the time
+ * window (days, start, end; half-hour steps, keyboard-friendly lists) and the allow list. See
+ * {@link SableStudentMode}.
+ */
+@SearchIndexable
+public class SableStudentModeFragment extends SettingsPreferenceFragment
+        implements Preference.OnPreferenceChangeListener {
+    private static final String KEY_SWITCH = "sable_student_switch";
+    private static final String KEY_SCHEDULE = "sable_student_schedule";
+    private static final String KEY_DAYS = "sable_student_days";
+    private static final String KEY_START = "sable_student_start";
+    private static final String KEY_END = "sable_student_end";
+    private static final String KEY_ALLOWED = "sable_student_allowed";
+    private static final String PREFIX_ALLOW = "sable_student_allow:";
+    private static final int STEP_MINUTES = 30;
+
+    private SwitchPreferenceCompat mSwitch;
+    private SwitchPreferenceCompat mScheduleSwitch;
+    private MultiSelectListPreference mDays;
+    private ListPreference mStart;
+    private ListPreference mEnd;
+    private PreferenceCategory mAllowed;
+    private SableAppListKeyboard mKeyboard;
+    private int mLoadGeneration;
+
+    /** One load, off the main thread. */
+    private static final class Loaded {
+        final boolean active;
+        final boolean scheduleOn;
+        final StudentSchedule schedule;
+        final Set<String> allowed;
+        final List<SableAppControls.LauncherApp> apps;
+
+        Loaded(boolean active, boolean scheduleOn, StudentSchedule schedule,
+                Set<String> allowed, List<SableAppControls.LauncherApp> apps) {
+            this.active = active;
+            this.scheduleOn = scheduleOn;
+            this.schedule = schedule;
+            this.allowed = allowed;
+            this.apps = apps;
+        }
+    }
+
+    @Override
+    public int getMetricsCategory() {
+        return SettingsEnums.NOTIFICATION_ZEN_MODE_AUTOMATION;
+    }
+
+    @Override
+    public void onCreate(Bundle icicle) {
+        super.onCreate(icicle);
+        addPreferencesFromResource(R.xml.sable_student_mode);
+        mSwitch = findPreference(KEY_SWITCH);
+        mScheduleSwitch = findPreference(KEY_SCHEDULE);
+        mDays = findPreference(KEY_DAYS);
+        mStart = findPreference(KEY_START);
+        mEnd = findPreference(KEY_END);
+        mAllowed = findPreference(KEY_ALLOWED);
+        final Locale locale = Locale.getDefault();
+        final CharSequence[] dayNames = new CharSequence[7];
+        final CharSequence[] dayValues = new CharSequence[7];
+        for (int d = 1; d <= 7; d++) {
+            dayNames[d - 1] = DayOfWeek.of(d).getDisplayName(TextStyle.FULL, locale);
+            dayValues[d - 1] = Integer.toString(d);
+        }
+        mDays.setEntries(dayNames);
+        mDays.setEntryValues(dayValues);
+        final int steps = StudentSchedule.MINUTES_PER_DAY / STEP_MINUTES;
+        final CharSequence[] times = new CharSequence[steps];
+        final CharSequence[] timeValues = new CharSequence[steps];
+        for (int i = 0; i < steps; i++) {
+            times[i] = StudentSchedule.clock(i * STEP_MINUTES);
+            timeValues[i] = Integer.toString(i * STEP_MINUTES);
+        }
+        for (ListPreference p : new ListPreference[] {mStart, mEnd}) {
+            p.setEntries(times);
+            p.setEntryValues(timeValues);
+        }
+        for (Preference p : new Preference[] {mSwitch, mScheduleSwitch, mDays, mStart, mEnd}) {
+            p.setOnPreferenceChangeListener(this);
+        }
+    }
+
+    @Override
+    public void onViewCreated(View view, Bundle savedInstanceState) {
+        super.onViewCreated(view, savedInstanceState);
+        mKeyboard = SableAppListKeyboard.attach(this, getListView(), getMetricsCategory());
+    }
+
+    @Override
+    public void onDestroyView() {
+        if (mKeyboard != null) {
+            mKeyboard.detach();
+            mKeyboard = null;
+        }
+        super.onDestroyView();
+    }
+
+    @Override
+    public void onResume() {
+        super.onResume();
+        load();
+    }
+
+    private void load() {
+        final Context context = getPrefContext().getApplicationContext();
+        final int generation = ++mLoadGeneration;
+        ThreadUtils.postOnBackgroundThread(() -> {
+            SableAppSuspender.reconcile(context);
+            final Set<String> neverPause = SableAppControls.protectedPackages(context);
+            final List<SableAppControls.LauncherApp> apps = new ArrayList<>();
+            for (SableAppControls.LauncherApp app : SableAppControls.launcherApps(context, true)) {
+                if (!neverPause.contains(app.packageName)) {
+                    apps.add(app);
+                }
+            }
+            final Loaded loaded = new Loaded(SableStudentMode.isActive(context),
+                    SableStudentMode.scheduleEnabled(context), SableStudentMode.schedule(context),
+                    SableAppControls.readSet(context, SableAppControls.KEY_STUDENT_ALLOW), apps);
+            ThreadUtils.postOnMainThread(() -> {
+                if (generation == mLoadGeneration && isAdded()) {
+                    show(loaded);
+                }
+            });
+        });
+    }
+
+    private void show(Loaded loaded) {
+        mSwitch.setChecked(loaded.active);
+        mScheduleSwitch.setChecked(loaded.scheduleOn);
+        mScheduleSwitch.setSummary(window(getPrefContext(), loaded.schedule));
+        final Set<String> days = new HashSet<>();
+        for (int d : loaded.schedule.days) {
+            days.add(Integer.toString(d));
+        }
+        mDays.setValues(days);
+        mDays.setSummary(daysText(getPrefContext(), loaded.schedule));
+        mStart.setValue(Integer.toString(roundToStep(loaded.schedule.startMinute)));
+        mStart.setSummary(StudentSchedule.clock(loaded.schedule.startMinute));
+        mEnd.setValue(Integer.toString(roundToStep(loaded.schedule.endMinute)));
+        mEnd.setSummary(endText(getPrefContext(), loaded.schedule));
+        for (Preference p : new Preference[] {mDays, mStart, mEnd}) {
+            p.setEnabled(loaded.scheduleOn);
+        }
+        mAllowed.removeAll();
+        for (SableAppControls.LauncherApp app : loaded.apps) {
+            final SwitchPreferenceCompat pref = new SwitchPreferenceCompat(getPrefContext());
+            pref.setKey(PREFIX_ALLOW + app.packageName);
+            pref.setTitle(app.label);
+            if (app.icon != null) {
+                pref.setIcon(app.icon);
+            }
+            pref.setPersistent(false);
+            final boolean allowed = loaded.allowed.contains(app.packageName);
+            pref.setChecked(allowed);
+            pref.setSummary(allowed ? R.string.sable_student_app_allowed
+                    : R.string.sable_student_app_paused);
+            pref.setOnPreferenceChangeListener(this);
+            mAllowed.addPreference(pref);
+        }
+        if (mAllowed.getPreferenceCount() == 0) {
+            final Preference empty = new Preference(getPrefContext());
+            empty.setTitle(R.string.sable_app_controls_empty);
+            empty.setSelectable(false);
+            mAllowed.addPreference(empty);
+        }
+    }
+
+    private static int roundToStep(int minute) {
+        return (minute / STEP_MINUTES) * STEP_MINUTES;
+    }
+
+    static String daysText(Context context, StudentSchedule s) {
+        if (s.days.isEmpty()) {
+            return context.getString(R.string.sable_student_no_days);
+        }
+        if (s.isWeekdays()) {
+            return context.getString(R.string.sable_student_weekdays);
+        }
+        final List<String> names = new ArrayList<>();
+        for (int d : s.days) {
+            names.add(DayOfWeek.of(d).getDisplayName(TextStyle.SHORT, Locale.getDefault()));
+        }
+        return String.join(", ", names);
+    }
+
+    private static String endText(Context context, StudentSchedule s) {
+        final String clock = StudentSchedule.clock(s.endMinute);
+        return s.overnight() ? context.getString(R.string.sable_student_next_day, clock) : clock;
+    }
+
+    /** "Weekdays 08:00-17:00". */
+    static String window(Context context, StudentSchedule s) {
+        return context.getString(R.string.sable_student_window, daysText(context, s),
+                StudentSchedule.clock(s.startMinute), StudentSchedule.clock(s.endMinute));
+    }
+
+    @Override
+    public boolean onPreferenceChange(Preference preference, Object newValue) {
+        final Context context = getPrefContext().getApplicationContext();
+        final String key = preference.getKey();
+        Runnable work = null;
+        if (KEY_SWITCH.equals(key) && newValue instanceof Boolean) {
+            final boolean on = (Boolean) newValue;
+            work = () -> {
+                if (!SableStudentMode.setActive(context, on, false)) {
+                    ThreadUtils.postOnMainThread(() -> {
+                        if (isAdded()) {
+                            Toast.makeText(getPrefContext(), R.string.sable_student_error,
+                                    Toast.LENGTH_SHORT).show();
+                        }
+                    });
+                }
+            };
+        } else if (KEY_SCHEDULE.equals(key) && newValue instanceof Boolean) {
+            final boolean on = (Boolean) newValue;
+            work = () -> SableStudentMode.setSchedule(context,
+                    on ? SableStudentMode.schedule(context) : null);
+        } else if (KEY_DAYS.equals(key) && newValue instanceof Set) {
+            final Set<Integer> days = new TreeSet<>();
+            for (Object o : (Set<?>) newValue) {
+                try {
+                    days.add(Integer.parseInt(String.valueOf(o)));
+                } catch (NumberFormatException e) {
+                    // Not one of our values.
+                }
+            }
+            work = () -> SableStudentMode.setSchedule(context,
+                    SableStudentMode.schedule(context).withDays(days));
+        } else if ((KEY_START.equals(key) || KEY_END.equals(key)) && newValue instanceof String) {
+            final int minute;
+            try {
+                minute = Integer.parseInt((String) newValue);
+            } catch (NumberFormatException e) {
+                return false;
+            }
+            final boolean start = KEY_START.equals(key);
+            work = () -> {
+                final StudentSchedule s = SableStudentMode.schedule(context);
+                SableStudentMode.setSchedule(context,
+                        start ? s.withStart(minute) : s.withEnd(minute));
+            };
+        } else if (key != null && key.startsWith(PREFIX_ALLOW) && newValue instanceof Boolean) {
+            final String pkg = key.substring(PREFIX_ALLOW.length());
+            final boolean allow = (Boolean) newValue;
+            work = () -> {
+                SableAppControls.writeSet(context, SableAppControls.KEY_STUDENT_ALLOW,
+                        PackageSet.with(SableAppControls.readSet(context,
+                                SableAppControls.KEY_STUDENT_ALLOW), pkg, allow));
+                SableAppSuspender.reconcile(context);
+            };
+        }
+        if (work == null) {
+            return false;
+        }
+        final Runnable job = work;
+        ThreadUtils.postOnBackgroundThread(() -> {
+            job.run();
+            ThreadUtils.postOnMainThread(() -> {
+                if (isAdded()) {
+                    load();
+                }
+            });
+        });
+        return false; // load() shows what is now stored and what Android now holds
+    }
+
+    public static final BaseSearchIndexProvider SEARCH_INDEX_DATA_PROVIDER =
+            new BaseSearchIndexProvider(R.xml.sable_student_mode);
+}
