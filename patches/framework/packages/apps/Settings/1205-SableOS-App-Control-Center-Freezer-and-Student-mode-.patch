+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.settings.applications.sable;
+
+import android.app.settings.SettingsEnums;
+import android.content.Context;
+import android.content.pm.ApplicationInfo;
+import android.content.pm.PackageManager;
+import android.os.Bundle;
+import android.view.View;
+import android.widget.Toast;
+
+import androidx.preference.Preference;
+import androidx.preference.PreferenceCategory;
+import androidx.preference.SwitchPreferenceCompat;
+
+import com.android.settings.R;
+import com.android.settings.SettingsPreferenceFragment;
+import com.android.settings.search.BaseSearchIndexProvider;
+import com.android.settingslib.search.SearchIndexable;
+import com.android.settingslib.utils.ThreadUtils;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Set;
+
+/**
+ * Freezer (Mobile Manager &gt; Freezer): one switch per launcher app (and per app the
+ * Freezer hid). On freezes the app through {@link SableFreezer}; hiding a frozen app is in the
+ * App Control Center. Apps the phone needs are not listed.
+ */
+@SearchIndexable
+public class SableFreezerFragment extends SettingsPreferenceFragment
+        implements Preference.OnPreferenceChangeListener {
+    private static final String KEY_APPS = "sable_freezer_apps";
+    private static final String PREFIX = "sable_freeze:";
+
+    private PreferenceCategory mApps;
+    private SableAppListKeyboard mKeyboard;
+    private int mLoadGeneration;
+
+    /** One app row. */
+    private static final class AppData {
+        final SableAppControls.LauncherApp app;
+        final boolean frozen;
+        final boolean hidden;
+
+        AppData(SableAppControls.LauncherApp app, boolean frozen, boolean hidden) {
+            this.app = app;
+            this.frozen = frozen;
+            this.hidden = hidden;
+        }
+    }
+
+    @Override
+    public int getMetricsCategory() {
+        return SettingsEnums.MANAGE_APPLICATIONS;
+    }
+
+    @Override
+    public void onCreate(Bundle icicle) {
+        super.onCreate(icicle);
+        addPreferencesFromResource(R.xml.sable_freezer);
+        mApps = findPreference(KEY_APPS);
+    }
+
+    @Override
+    public void onViewCreated(View view, Bundle savedInstanceState) {
+        super.onViewCreated(view, savedInstanceState);
+        mKeyboard = SableAppListKeyboard.attach(this, getListView(), getMetricsCategory());
+    }
+
+    @Override
+    public void onDestroyView() {
+        if (mKeyboard != null) {
+            mKeyboard.detach();
+            mKeyboard = null;
+        }
+        super.onDestroyView();
+    }
+
+    @Override
+    public void onResume() {
+        super.onResume();
+        load();
+    }
+
+    private void load() {
+        final Context context = getPrefContext().getApplicationContext();
+        final int generation = ++mLoadGeneration;
+        ThreadUtils.postOnBackgroundThread(() -> {
+            SableAppSuspender.reconcile(context);
+            final Set<String> frozen = SableFreezer.frozen(context);
+            final Set<String> hidden = SableFreezer.hiddenBySettings(context);
+            final Set<String> neverPause = SableAppControls.protectedPackages(context);
+            final List<AppData> apps = new ArrayList<>();
+            for (SableAppControls.LauncherApp app : SableAppControls.launcherApps(context, true)) {
+                if (!neverPause.contains(app.packageName)) {
+                    apps.add(new AppData(app, frozen.contains(app.packageName), false));
+                }
+            }
+            // Hidden apps have no launcher entry; list them so they can be unfrozen here.
+            final PackageManager pm = context.getPackageManager();
+            for (String pkg : hidden) {
+                try {
+                    final ApplicationInfo ai = pm.getApplicationInfo(pkg,
+                            PackageManager.ApplicationInfoFlags.of(
+                                    PackageManager.MATCH_UNINSTALLED_PACKAGES));
+                    final CharSequence label = ai.loadLabel(pm);
+                    apps.add(new AppData(new SableAppControls.LauncherApp(pkg,
+                            label == null ? pkg : label.toString(), ai.uid, null),
+                            frozen.contains(pkg), true));
+                } catch (PackageManager.NameNotFoundException e) {
+                    // Removed meanwhile.
+                }
+            }
+            ThreadUtils.postOnMainThread(() -> {
+                if (generation == mLoadGeneration && isAdded()) {
+                    show(apps);
+                }
+            });
+        });
+    }
+
+    private void show(List<AppData> apps) {
+        mApps.removeAll();
+        for (AppData data : apps) {
+            final SwitchPreferenceCompat pref = new SwitchPreferenceCompat(getPrefContext());
+            pref.setKey(PREFIX + data.app.packageName);
+            pref.setTitle(data.app.label);
+            if (data.app.icon != null) {
+                pref.setIcon(data.app.icon);
+            }
+            pref.setPersistent(false);
+            pref.setChecked(data.frozen);
+            if (data.frozen) {
+                pref.setSummary(data.hidden ? R.string.sable_freezer_app_frozen_hidden
+                        : R.string.sable_freezer_app_frozen);
+            }
+            pref.setOnPreferenceChangeListener(this);
+            mApps.addPreference(pref);
+        }
+        if (mApps.getPreferenceCount() == 0) {
+            final Preference empty = new Preference(getPrefContext());
+            empty.setTitle(R.string.sable_app_controls_empty);
+            empty.setSelectable(false);
+            mApps.addPreference(empty);
+        }
+    }
+
+    @Override
+    public boolean onPreferenceChange(Preference preference, Object newValue) {
+        final String key = preference.getKey();
+        if (key == null || !key.startsWith(PREFIX) || !(newValue instanceof Boolean)) {
+            return false;
+        }
+        final String pkg = key.substring(PREFIX.length());
+        final boolean freeze = (Boolean) newValue;
+        final Context context = getPrefContext().getApplicationContext();
+        ThreadUtils.postOnBackgroundThread(() -> {
+            final boolean ok = SableFreezer.setFrozen(context, pkg, freeze);
+            ThreadUtils.postOnMainThread(() -> {
+                if (!isAdded()) {
+                    return;
+                }
+                if (!ok) {
+                    Toast.makeText(getPrefContext(), R.string.sable_acc_action_failed,
+                            Toast.LENGTH_SHORT).show();
+                }
+                load();
+            });
+        });
+        return false; // load() shows what Android now holds
+    }
+
+    /** The Freezer row summary in Mobile Manager. */
+    static String summary(Context context, int frozen) {
+        return frozen == 0 ? context.getString(R.string.sable_freezer_none)
+                : context.getResources().getQuantityString(R.plurals.sable_freezer_count,
+                        frozen, frozen);
+    }
+
+    public static final BaseSearchIndexProvider SEARCH_INDEX_DATA_PROVIDER =
+            new BaseSearchIndexProvider(R.xml.sable_freezer);
+}
