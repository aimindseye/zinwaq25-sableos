@@ -2065,25 +2065,68 @@
                 android:value="@string/menu_key_apps"/>
         </activity>
 
-        <!-- SableOS: the "Focus mode" button of Android's dialog for an app Focus mode paused.
-             Android only offers it when the suspending package (Settings) has an activity for
-             this action guarded by exactly this permission. -->
+        <!-- SableOS: App Control Center (Mobile Manager). -->
+        <activity
+            android:name="Settings$SableAppControlCenterActivity"
+            android:exported="true"
+            android:label="@string/sable_acc_title">
+            <intent-filter>
+                <action android:name="org.sableos.settings.APP_CONTROLS" />
+                <category android:name="android.intent.category.DEFAULT" />
