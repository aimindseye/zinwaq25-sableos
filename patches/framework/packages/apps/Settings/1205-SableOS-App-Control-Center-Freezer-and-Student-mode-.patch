+package com.android.settings.applications.sable;
+
+import android.content.Context;
+import android.content.pm.ApplicationInfo;
+import android.content.pm.PackageManager;
+import android.os.UserHandle;
+import android.util.Log;
+
+import com.android.settings.applications.sable.model.PackageSet;
+
+import java.util.Set;
+
+/**
+ * Freezer (MOBILE_MANAGER_APP_CONTROLS_UX "Freezer"): a frozen app is suspended with
+ * {@code setPackagesSuspended} through {@link SableAppSuspender} until the user unfreezes it,
+ * so it cannot open, run its activities or show notifications; its data stays. A frozen app
+ * the user installed can also be hidden from the launcher with Android's per-user hidden
+ * setting ({@code setApplicationHiddenSettingAsUser}); Settings only ever unhides what it hid.
+ * Apps the phone needs are never frozen, and system apps are never hidden.
+ */
+final class SableFreezer {
+    private static final String TAG = "SableFreezer";
+
+    private SableFreezer() {
+    }
+
+    static Set<String> frozen(Context context) {
+        return SableAppControls.readSet(context, SableAppControls.KEY_FROZEN);
+    }
+
+    static Set<String> hiddenBySettings(Context context) {
+        return SableAppControls.readSet(context, SableAppControls.KEY_HIDDEN);
+    }
+
+    /** Whether the app may be frozen (not one the phone needs). */
+    static boolean canFreeze(Context context, String pkg) {
+        return PackageSet.isValidPackageName(pkg)
+                && !SableAppControls.protectedPackages(context).contains(pkg);
+    }
+
+    /**
+     * Freezes or unfreezes {@code pkg}; unfreezing also shows it again if Settings hid it.
+     * Returns false when Android refused to suspend it.
+     */
+    static boolean setFrozen(Context context, String pkg, boolean frozen) {
+        if (frozen && !canFreeze(context, pkg)) {
+            return false;
+        }
+        if (!frozen && hiddenBySettings(context).contains(pkg)) {
+            setHidden(context, pkg, false);
+        }
+        SableAppControls.writeSet(context, SableAppControls.KEY_FROZEN,
+                PackageSet.with(frozen(context), pkg, frozen));
+        final Set<String> refused = SableAppSuspender.reconcile(context);
+        if (frozen && refused.contains(pkg)) {
+            SableAppControls.writeSet(context, SableAppControls.KEY_FROZEN,
+                    PackageSet.with(frozen(context), pkg, false));
+            return false;
+        }
+        return true;
+    }
+
+    /** True for an app that is not part of the system image. */
+    static boolean userInstalled(ApplicationInfo ai) {
+        return ai != null && (ai.flags & ApplicationInfo.FLAG_SYSTEM) == 0
+                && (ai.flags & ApplicationInfo.FLAG_UPDATED_SYSTEM_APP) == 0;
+    }
+
+    /** Whether Android hides the app for this user now. */
+    static boolean isHidden(Context context, String pkg) {
+        try {
+            return context.getPackageManager().getApplicationHiddenSettingAsUser(pkg,
+                    UserHandle.of(UserHandle.myUserId()));
+        } catch (RuntimeException e) {
+            return false;
+        }
+    }
+
+    /**
+     * Hides a frozen, user-installed app from the launcher, or shows it again. Returns false
+     * when it is not allowed or Android refused.
+     */
+    static boolean setHidden(Context context, String pkg, boolean hidden) {
+        final PackageManager pm = context.getPackageManager();
+        if (hidden) {
+            final ApplicationInfo ai;
+            try {
+                ai = pm.getApplicationInfo(pkg, PackageManager.ApplicationInfoFlags.of(0));
+            } catch (PackageManager.NameNotFoundException e) {
+                return false;
+            }
+            if (!userInstalled(ai) || !frozen(context).contains(pkg) || !canFreeze(context, pkg)) {
+                return false;
+            }
+        } else if (!hiddenBySettings(context).contains(pkg)) {
+            return false;
+        }
+        boolean ok;
+        try {
+            ok = pm.setApplicationHiddenSettingAsUser(pkg, hidden,
+                    UserHandle.of(UserHandle.myUserId()));
+        } catch (RuntimeException e) {
+            Log.e(TAG, "Cannot " + (hidden ? "hide " : "show ") + pkg, e);
+            ok = false;
+        }
+        // An app removed meanwhile cannot be shown again: forget it either way.
+        if (ok || !hidden) {
+            SableAppControls.writeSet(context, SableAppControls.KEY_HIDDEN,
+                    PackageSet.with(hiddenBySettings(context), pkg, hidden));
+        }
+        return ok;
+    }
+}
