+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.settings.applications.sable;
+
+import android.app.settings.SettingsEnums;
+import android.content.ActivityNotFoundException;
+import android.content.Context;
+import android.content.Intent;
+import android.content.pm.ApplicationInfo;
+import android.content.pm.PackageManager;
+import android.graphics.drawable.Drawable;
+import android.net.NetworkPolicyManager;
+import android.net.Uri;
+import android.os.Bundle;
+import android.os.UserHandle;
+import android.provider.Settings;
+import android.text.TextUtils;
+import android.util.IconDrawableFactory;
+import android.util.Log;
+import android.view.View;
+import android.widget.Toast;
+
+import androidx.appcompat.app.AlertDialog;
+import androidx.preference.ListPreference;
+import androidx.preference.Preference;
+import androidx.preference.PreferenceCategory;
+
+import com.android.settings.R;
+import com.android.settings.SettingsPreferenceFragment;
+import com.android.settings.applications.sable.model.AppControlRows;
+import com.android.settings.applications.sable.model.AppSuspensions;
+import com.android.settings.applications.sable.model.NetworkAccessPolicy;
+import com.android.settings.fuelgauge.BatteryOptimizeUtils;
+import com.android.settings.search.BaseSearchIndexProvider;
+import com.android.settingslib.search.SearchIndexable;
+import com.android.settingslib.utils.ThreadUtils;
+
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.Set;
+import java.util.TreeSet;
+
+/**
+ * App Control Center (MOBILE_MANAGER_APP_CONTROLS_UX section 1): every launcher app (and the
+ * apps the Freezer hid) with its network access, background mode and paused state, read from
+ * Android's own stores, and filters. Enter on an app opens its actions: Freeze or Unfreeze,
+ * Hide or Show (frozen apps the user installed), Network access, App security &amp; privacy
+ * and App info. Also org.sableos.settings.APP_CONTROLS and the button of Android's dialog for
+ * an app Settings paused (that app is scrolled into view).
+ */
+@SearchIndexable
+public class SableAppControlCenterFragment extends SettingsPreferenceFragment
+        implements Preference.OnPreferenceChangeListener {
+    private static final String TAG = "SableAppControlCenter";
+    private static final String KEY_FILTER = "sable_acc_filter";
+    private static final String KEY_APPS = "sable_acc_apps";
+    private static final String PREFIX = "sable_acc:";
+
+    private ListPreference mFilter;
+    private PreferenceCategory mApps;
+    private SableAppListKeyboard mKeyboard;
+    private final List<AppControlRows.Row> mRows = new ArrayList<>();
+    private final Map<String, Drawable> mIcons = new HashMap<>();
+    private Set<String> mNeverPause = new TreeSet<>();
+    private int mLoadGeneration;
+    private String mScrollTo;
+
+    /** One load, read off the main thread. */
+    private static final class Loaded {
+        final List<AppControlRows.Row> rows;
+        final Map<String, Drawable> icons;
+        final Set<String> neverPause;
+
+        Loaded(List<AppControlRows.Row> rows, Map<String, Drawable> icons,
+                Set<String> neverPause) {
+            this.rows = rows;
+            this.icons = icons;
+            this.neverPause = neverPause;
+        }
+    }
+
+    @Override
+    public int getMetricsCategory() {
+        return SettingsEnums.MANAGE_APPLICATIONS;
+    }
+
+    @Override
+    public void onCreate(Bundle icicle) {
+        super.onCreate(icicle);
+        addPreferencesFromResource(R.xml.sable_app_control_center);
+        mFilter = findPreference(KEY_FILTER);
+        mFilter.setPersistent(false);
+        mFilter.setOnPreferenceChangeListener(this);
+        if (mFilter.getValue() == null) {
+            mFilter.setValue(AppControlRows.Filter.ALL.name());
+        }
+        mApps = findPreference(KEY_APPS);
+        final Intent intent = getActivity() == null ? null : getActivity().getIntent();
+        if (intent != null && Intent.ACTION_SHOW_SUSPENDED_APP_DETAILS.equals(
+                intent.getAction())) {
+            mScrollTo = intent.getStringExtra(Intent.EXTRA_PACKAGE_NAME);
+        }
+    }
+
+    @Override
+    public void onViewCreated(View view, Bundle savedInstanceState) {
+        super.onViewCreated(view, savedInstanceState);
+        mKeyboard = SableAppListKeyboard.attach(this, getListView(), getMetricsCategory());
+    }
+
+    @Override
+    public void onDestroyView() {
+        if (mKeyboard != null) {
+            mKeyboard.detach();
+            mKeyboard = null;
+        }
+        super.onDestroyView();
+    }
+
+    @Override
+    public void onResume() {
+        super.onResume();
+        load();
+    }
+
+    private void load() {
+        final Context context = getPrefContext().getApplicationContext();
+        final int generation = ++mLoadGeneration;
+        ThreadUtils.postOnBackgroundThread(() -> {
+            // Also catches up if a mode ended while Settings was not told.
+            SableAppSuspender.reconcile(context);
+            final Loaded loaded = loadRows(context);
+            ThreadUtils.postOnMainThread(() -> {
+                if (generation == mLoadGeneration && isAdded()) {
+                    show(loaded);
+                }
+            });
+        });
+    }
+
+    private static Loaded loadRows(Context context) {
+        final PackageManager pm = context.getPackageManager();
+        final NetworkPolicyManager npm = NetworkPolicyManager.from(context);
+        final NetworkAccessPolicy.Masks masks = new NetworkAccessPolicy.Masks(
+                NetworkPolicyManager.POLICY_REJECT_ALL,
+                NetworkPolicyManager.POLICY_REJECT_CELLULAR,
+                NetworkPolicyManager.POLICY_REJECT_WIFI,
+                NetworkPolicyManager.POLICY_REJECT_VPN,
+                NetworkPolicyManager.POLICY_REJECT_METERED_BACKGROUND);
+        final Map<String, AppSuspensions.Reason> reasons =
+                SableAppSuspender.heldReasons(context);
+        final Set<String> packages = new TreeSet<>();
+        for (SableAppControls.LauncherApp app : SableAppControls.launcherApps(context, false)) {
+            packages.add(app.packageName);
+        }
+        packages.addAll(SableFreezer.hiddenBySettings(context));
+        final IconDrawableFactory iconFactory = IconDrawableFactory.newInstance(context);
+        final List<AppControlRows.Row> rows = new ArrayList<>();
+        final Map<String, Drawable> icons = new HashMap<>();
+        for (String pkg : packages) {
+            final ApplicationInfo ai;
+            try {
+                ai = pm.getApplicationInfo(pkg, PackageManager.ApplicationInfoFlags.of(
+                        PackageManager.MATCH_UNINSTALLED_PACKAGES));
+            } catch (PackageManager.NameNotFoundException e) {
+                continue;
+            }
+            final CharSequence label = ai.loadLabel(pm);
+            boolean suspended = false;
+            try {
+                suspended = pm.isPackageSuspended(pkg);
+            } catch (PackageManager.NameNotFoundException | RuntimeException e) {
+                // Treated as not paused.
+            }
+            rows.add(new AppControlRows.Row(pkg, label == null ? null : label.toString(),
+                    network(npm, masks, ai.uid), background(context, ai.uid, pkg),
+                    AppControlRows.paused(suspended, reasons.get(pkg)),
+                    SableFreezer.isHidden(context, pkg), SableFreezer.userInstalled(ai)));
+            icons.put(pkg, iconFactory.getBadgedIcon(ai));
+        }
+        return new Loaded(rows, icons, SableAppControls.protectedPackages(context));
+    }
+
+    private static AppControlRows.Network network(NetworkPolicyManager npm,
+            NetworkAccessPolicy.Masks masks, int uid) {
+        int policy = 0;
+        try {
+            policy = npm.getUidPolicy(uid);
+        } catch (RuntimeException e) {
+            Log.w(TAG, "Cannot read network policy for " + uid, e);
+        }
+        final NetworkAccessPolicy.State s =
+                NetworkAccessPolicy.evaluate(policy, UserHandle.isApp(uid), masks);
+        switch (s.summary) {
+            case BLOCKED:
+                return AppControlRows.Network.BLOCKED;
+            case NOT_MANAGEABLE:
+                return AppControlRows.Network.NOT_MANAGEABLE;
+            case PARTIAL:
+                return s.blockedCellular || s.blockedWifi || s.blockedVpn
+                        || s.backgroundDataRestricted
+                        ? AppControlRows.Network.PARTIAL : AppControlRows.Network.ALLOWED;
+            default:
+                return AppControlRows.Network.ALLOWED;
+        }
+    }
+
+    private static AppControlRows.Background background(Context context, int uid, String pkg) {
+        try {
+            switch (new BatteryOptimizeUtils(context, uid, pkg).getAppOptimizationMode()) {
+                case BatteryOptimizeUtils.MODE_RESTRICTED:
+                    return AppControlRows.Background.RESTRICTED;
+                case BatteryOptimizeUtils.MODE_UNRESTRICTED:
+                    return AppControlRows.Background.UNRESTRICTED;
+                case BatteryOptimizeUtils.MODE_OPTIMIZED:
+                    return AppControlRows.Background.OPTIMIZED;
+                default:
+                    return AppControlRows.Background.UNKNOWN;
+            }
+        } catch (RuntimeException e) {
+            return AppControlRows.Background.UNKNOWN;
+        }
+    }
+
+    private void show(Loaded loaded) {
+        mRows.clear();
+        mRows.addAll(loaded.rows);
+        mIcons.clear();
+        mIcons.putAll(loaded.icons);
+        mNeverPause = loaded.neverPause;
+        render();
+        if (mScrollTo != null) {
+            scrollToPreference(PREFIX + mScrollTo);
+            mScrollTo = null;
+        }
+    }
+
+    private AppControlRows.Filter filter() {
+        try {
+            return AppControlRows.Filter.valueOf(mFilter.getValue());
+        } catch (IllegalArgumentException | NullPointerException e) {
+            return AppControlRows.Filter.ALL;
+        }
+    }
+
+    private void render() {
+        final AppControlRows.Filter filter = filter();
+        final List<AppControlRows.Row> shown =
+                AppControlRows.filter(mRows, filter, Locale.getDefault());
+        mFilter.setSummary(mFilter.getEntry() + getString(R.string.sable_acc_separator)
+                + getResources().getQuantityString(R.plurals.sable_acc_count, shown.size(),
+                        shown.size()));
+        mApps.removeAll();
+        if (shown.isEmpty()) {
+            final Preference empty = new Preference(getPrefContext());
+            empty.setTitle(R.string.sable_app_controls_empty);
+            empty.setSelectable(false);
+            mApps.addPreference(empty);
+            return;
+        }
+        for (AppControlRows.Row row : shown) {
+            final Preference pref = new Preference(getPrefContext());
+            pref.setKey(PREFIX + row.packageName);
+            pref.setTitle(row.label);
+            pref.setSummary(summary(row));
+            final Drawable icon = mIcons.get(row.packageName);
+            if (icon != null) {
+                pref.setIcon(icon);
+            }
+            pref.setPersistent(false);
+            mApps.addPreference(pref);
+        }
+    }
+
+    /** "network allowed · background unrestricted · frozen · hidden from launcher". */
+    private String summary(AppControlRows.Row row) {
+        final List<String> parts = new ArrayList<>();
+        switch (row.network) {
+            case BLOCKED:
+                parts.add(getString(R.string.sable_acc_network_blocked));
+                break;
+            case PARTIAL:
+                parts.add(getString(R.string.sable_acc_network_partial));
+                break;
+            case NOT_MANAGEABLE:
+                parts.add(getString(R.string.sable_acc_network_fixed));
+                break;
+            default:
+                parts.add(getString(R.string.sable_acc_network_allowed));
+                break;
+        }
+        switch (row.background) {
+            case RESTRICTED:
+                parts.add(getString(R.string.sable_acc_background_restricted));
+                break;
+            case UNRESTRICTED:
+                parts.add(getString(R.string.sable_acc_background_unrestricted));
+                break;
+            case OPTIMIZED:
+                parts.add(getString(R.string.sable_acc_background_optimized));
+                break;
+            default:
+                break;
+        }
+        switch (row.paused) {
+            case FROZEN:
+                parts.add(getString(R.string.sable_acc_paused_frozen));
+                break;
+            case STUDENT:
+                parts.add(getString(R.string.sable_acc_paused_student));
+                break;
+            case FOCUS:
+                parts.add(getString(R.string.sable_acc_paused_focus));
+                break;
+            case OTHER:
+                parts.add(getString(R.string.sable_acc_paused_other));
+                break;
+            default:
+                break;
+        }
+        if (row.hidden) {
+            parts.add(getString(R.string.sable_acc_hidden));
+        }
+        return TextUtils.join(getString(R.string.sable_acc_separator), parts);
+    }
+
+    @Override
+    public boolean onPreferenceChange(Preference preference, Object newValue) {
+        if (preference == mFilter && newValue instanceof String) {
+            mFilter.setValue((String) newValue);
+            render();
+        }
+        return false;
+    }
+
+    @Override
+    public boolean onPreferenceTreeClick(Preference preference) {
+        final String key = preference.getKey();
+        if (key != null && key.startsWith(PREFIX)) {
+            final String pkg = key.substring(PREFIX.length());
+            for (AppControlRows.Row row : mRows) {
+                if (row.packageName.equals(pkg)) {
+                    showActions(row);
+                    return true;
+                }
+            }
+        }
+        return super.onPreferenceTreeClick(preference);
+    }
+
+    private enum Action { FREEZE, UNFREEZE, HIDE, UNHIDE, NETWORK, SECURITY, INFO }
+
+    private void showActions(AppControlRows.Row row) {
+        final boolean protectedApp = mNeverPause.contains(row.packageName);
+        final List<Action> actions = new ArrayList<>();
+        final List<CharSequence> labels = new ArrayList<>();
+        if (row.frozen()) {
+            add(actions, labels, Action.UNFREEZE, R.string.sable_acc_action_unfreeze);
+        } else if (!protectedApp && row.paused != AppControlRows.Paused.OTHER) {
+            add(actions, labels, Action.FREEZE, R.string.sable_acc_action_freeze);
+        }
+        if (AppControlRows.canHide(row, protectedApp)) {
+            if (row.hidden) {
+                add(actions, labels, Action.UNHIDE, R.string.sable_acc_action_unhide);
+            } else {
+                add(actions, labels, Action.HIDE, R.string.sable_acc_action_hide);
+            }
+        }
+        add(actions, labels, Action.NETWORK, R.string.sable_acc_action_network);
+        add(actions, labels, Action.SECURITY, R.string.sable_acc_action_security);
+        add(actions, labels, Action.INFO, R.string.sable_acc_action_info);
+        new AlertDialog.Builder(getPrefContext())
+                .setTitle(row.label)
+                .setItems(labels.toArray(new CharSequence[0]),
+                        (dialog, which) -> run(row, actions.get(which)))
+                .setNegativeButton(android.R.string.cancel, null)
+                .show();
+    }
+
+    private void add(List<Action> actions, List<CharSequence> labels, Action a, int label) {
+        actions.add(a);
+        labels.add(getString(label));
+    }
+
+    private void run(AppControlRows.Row row, Action action) {
+        final Context context = getPrefContext().getApplicationContext();
+        switch (action) {
+            case FREEZE:
+            case UNFREEZE:
+            case HIDE:
+            case UNHIDE:
+                ThreadUtils.postOnBackgroundThread(() -> {
+                    final boolean ok;
+                    if (action == Action.FREEZE || action == Action.UNFREEZE) {
+                        ok = SableFreezer.setFrozen(context, row.packageName,
+                                action == Action.FREEZE);
+                    } else {
+                        ok = SableFreezer.setHidden(context, row.packageName,
+                                action == Action.HIDE);
+                    }
+                    ThreadUtils.postOnMainThread(() -> {
+                        if (!isAdded()) {
+                            return;
+                        }
+                        if (!ok) {
+                            Toast.makeText(getPrefContext(), R.string.sable_acc_action_failed,
+                                    Toast.LENGTH_SHORT).show();
+                        }
+                        load();
+                    });
+                });
+                break;
+            case NETWORK:
+                open(new Intent(getPrefContext(),
+                        com.android.settings.Settings.SableNetworkManagerActivity.class));
+                break;
+            case SECURITY:
+                open(new Intent(getPrefContext(),
+                        com.android.settings.Settings.SableAppSecurityActivity.class)
+                        .setAction("org.sableos.settings.APP_SECURITY")
+                        .setData(Uri.fromParts("package", row.packageName, null)));
+                break;
+            default:
+                open(new Intent(Settings.ACTION_APPLICATION_DETAILS_SETTINGS)
+                        .setData(Uri.fromParts("package", row.packageName, null)));
+                break;
+        }
+    }
+
+    private void open(Intent intent) {
+        try {
+            startActivity(intent);
+        } catch (ActivityNotFoundException | SecurityException e) {
+            Log.w(TAG, "Cannot open " + intent, e);
+        }
+    }
+
+    public static final BaseSearchIndexProvider SEARCH_INDEX_DATA_PROVIDER =
+            new BaseSearchIndexProvider(R.xml.sable_app_control_center);
+}
