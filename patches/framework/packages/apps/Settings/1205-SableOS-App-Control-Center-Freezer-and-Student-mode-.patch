+
+package com.android.settings.applications.sable;
+
+import android.app.AlarmManager;
+import android.app.AutomaticZenRule;
+import android.app.NotificationManager;
+import android.app.PendingIntent;
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.Intent;
+import android.net.Uri;
+import android.service.notification.Condition;
+import android.service.notification.ZenPolicy;
+import android.util.Log;
+
+import com.android.settings.R;
+import com.android.settings.applications.sable.model.FocusModePolicy;
+import com.android.settings.applications.sable.model.StudentSchedule;
+
+import java.time.LocalDateTime;
+import java.time.ZoneId;
+import java.util.Map;
+
+/**
+ * Student mode (MOBILE_MANAGER_APP_CONTROLS_UX "Student / Focus"), built on Focus mode's
+ * machinery: a second AutomaticZenRule owned by Settings with the same notification policy
+ * (so it is in Settings &gt; Modes and Quick Settings), plus an allow list and a time window.
+ * While it is on, every launcher app that is not on the allow list (and not one the phone
+ * needs) is paused through {@link SableAppSuspender}.
+ *
+ * <p>The window ({@link StudentSchedule}) is kept by Settings: an exact alarm at the next
+ * boundary turns the mode on or off as Settings, and the alarm is set again on boot and when
+ * the time or time zone changes ({@link SableStudentModeReceiver}). Turning the mode off by
+ * hand inside the window lasts until the next boundary. It is a local self-control, not
+ * parental control: it can be turned off at any time and filters no websites.
+ */
+public final class SableStudentMode {
+    private static final String TAG = "SableStudentMode";
+    private static final String CONDITION_PATH = "sable_student";
+    /** Alarm action, delivered only to SableStudentModeReceiver (explicit component). */
+    static final String ACTION_SCHEDULE = "org.sableos.settings.action.STUDENT_SCHEDULE";
+
+    private SableStudentMode() {
+    }
+
+    static Uri conditionId(Context context) {
+        return new Uri.Builder().scheme(Condition.SCHEME)
+                .authority(context.getPackageName())
+                .appendPath(CONDITION_PATH)
+                .build();
+    }
+
+    /** The id of Settings' Student rule, or null when it does not exist. */
+    static String findRuleId(Context context) {
+        final NotificationManager nm = context.getSystemService(NotificationManager.class);
+        if (nm == null) {
+            return null;
+        }
+        final Uri condition = conditionId(context);
+        try {
+            final Map<String, AutomaticZenRule> rules = nm.getAutomaticZenRules();
+            if (rules == null) {
+                return null;
+            }
+            for (Map.Entry<String, AutomaticZenRule> e : rules.entrySet()) {
+                if (e.getValue() != null && condition.equals(e.getValue().getConditionId())) {
+                    return e.getKey();
+                }
+            }
+        } catch (RuntimeException e) {
+            Log.w(TAG, "Cannot read modes", e);
+        }
+        return null;
+    }
+
+    /** Creates the Student rule if it is missing; returns its id or null on failure. */
+    static String ensureRule(Context context) {
+        final String existing = findRuleId(context);
+        if (existing != null) {
+            return existing;
+        }
+        final NotificationManager nm = context.getSystemService(NotificationManager.class);
+        if (nm == null) {
+            return null;
+        }
+        final ZenPolicy policy = new ZenPolicy.Builder()
+                .allowPriorityChannels(FocusModePolicy.Spec.ALLOW_PRIORITY_CHANNELS)
+                .allowAlarms(FocusModePolicy.Spec.ALLOW_ALARMS)
+                .allowMedia(FocusModePolicy.Spec.ALLOW_MEDIA)
+                .allowSystem(FocusModePolicy.Spec.ALLOW_SYSTEM)
+                .allowReminders(FocusModePolicy.Spec.ALLOW_REMINDERS)
+                .allowEvents(FocusModePolicy.Spec.ALLOW_EVENTS)
+                .allowRepeatCallers(FocusModePolicy.Spec.ALLOW_REPEAT_CALLERS)
+                .allowCalls(FocusModePolicy.Spec.ALLOW_CALLS
+                        ? ZenPolicy.PEOPLE_TYPE_ANYONE : ZenPolicy.PEOPLE_TYPE_NONE)
+                .allowMessages(FocusModePolicy.Spec.ALLOW_MESSAGES
+                        ? ZenPolicy.PEOPLE_TYPE_ANYONE : ZenPolicy.PEOPLE_TYPE_NONE)
+                .allowConversations(FocusModePolicy.Spec.ALLOW_CONVERSATIONS
+                        ? ZenPolicy.CONVERSATION_SENDERS_ANYONE
+                        : ZenPolicy.CONVERSATION_SENDERS_NONE)
+                .build();
+        final AutomaticZenRule rule = new AutomaticZenRule.Builder(
+                context.getString(R.string.sable_student_title), conditionId(context))
+                .setConfigurationActivity(new ComponentName(context,
+                        com.android.settings.Settings.SableStudentModeActivity.class))
+                .setType(AutomaticZenRule.TYPE_OTHER)
+                .setInterruptionFilter(NotificationManager.INTERRUPTION_FILTER_PRIORITY)
+                .setZenPolicy(policy)
+                .setManualInvocationAllowed(true)
+                .build();
+        try {
+            return nm.addAutomaticZenRule(rule);
+        } catch (RuntimeException e) {
+            Log.e(TAG, "Cannot create Student mode", e);
+            return null;
+        }
+    }
+
+    /** Whether Student mode is on now. */
+    static boolean isActive(Context context) {
+        final String id = findRuleId(context);
+        if (id == null) {
+            return false;
+        }
+        try {
+            return context.getSystemService(NotificationManager.class)
+                    .getAutomaticZenRuleState(id) == Condition.STATE_TRUE;
+        } catch (RuntimeException e) {
+            Log.w(TAG, "Cannot read the Student mode state", e);
+            return false;
+        }
+    }
+
+    /**
+     * Turns Student mode on or off and pauses or releases apps; {@code fromSchedule} marks a
+     * window boundary rather than a user action. Returns false when Android refused.
+     */
+    static boolean setActive(Context context, boolean active, boolean fromSchedule) {
+        final String id = active ? ensureRule(context) : findRuleId(context);
+        if (id != null) {
+            try {
+                context.getSystemService(NotificationManager.class).setAutomaticZenRuleState(id,
+                        new Condition(conditionId(context), "",
+                                active ? Condition.STATE_TRUE : Condition.STATE_FALSE,
+                                fromSchedule ? Condition.SOURCE_SCHEDULE
+                                        : Condition.SOURCE_USER_ACTION));
+            } catch (RuntimeException e) {
+                Log.e(TAG, "Cannot change Student mode", e);
+                return false;
+            }
+        } else if (active) {
+            return false;
+        }
+        SableAppSuspender.reconcile(context, SableFocusMode.isActive(context), active);
+        return true;
+    }
+
+    static StudentSchedule schedule(Context context) {
+        return StudentSchedule.parse(
+                SableAppControls.readString(context, SableAppControls.KEY_STUDENT_SCHEDULE));
+    }
+
+    /** Whether the user turned the window on (it starts off: nothing runs until chosen). */
+    static boolean scheduleEnabled(Context context) {
+        return SableAppControls.readString(context, SableAppControls.KEY_STUDENT_SCHEDULE)
+                != null;
+    }
+
+    /** Stores the window (null turns it off) and re-arms the alarm. */
+    static void setSchedule(Context context, StudentSchedule schedule) {
+        SableAppControls.writeString(context, SableAppControls.KEY_STUDENT_SCHEDULE,
+                schedule == null ? null : schedule.format());
+        applySchedule(context, true);
+    }
+
+    /**
+     * Brings the mode to what the window says when {@code enforceNow} (a boundary, boot, a time
+     * change or a new window), then arms the alarm for the next boundary.
+     */
+    static void applySchedule(Context context, boolean enforceNow) {
+        final AlarmManager alarms = context.getSystemService(AlarmManager.class);
+        final PendingIntent pi = PendingIntent.getBroadcast(context, 0,
+                new Intent(ACTION_SCHEDULE).setClass(context, SableStudentModeReceiver.class),
+                PendingIntent.FLAG_IMMUTABLE | PendingIntent.FLAG_UPDATE_CURRENT);
+        if (alarms != null) {
+            alarms.cancel(pi);
+        }
+        if (!scheduleEnabled(context)) {
+            return;
+        }
+        final StudentSchedule s = schedule(context);
+        final ZoneId zone = ZoneId.systemDefault();
+        final LocalDateTime now = LocalDateTime.now(zone);
+        if (enforceNow && s.isActive(now) != isActive(context)) {
+            setActive(context, s.isActive(now), true);
+        }
+        final LocalDateTime next = s.nextChange(now);
+        if (next == null || alarms == null) {
+            return;
+        }
+        final long at = next.atZone(zone).toInstant().toEpochMilli();
+        try {
+            alarms.setExactAndAllowWhileIdle(AlarmManager.RTC_WAKEUP, at, pi);
+        } catch (SecurityException e) {
+            Log.w(TAG, "Exact alarm refused; using an inexact one", e);
+            alarms.setAndAllowWhileIdle(AlarmManager.RTC_WAKEUP, at, pi);
+        }
+    }
+}
