+            <meta-data android:name="com.android.settings.FRAGMENT_CLASS"
+                android:value="com.android.settings.applications.sable.SableAppControlCenterFragment" />
+            <meta-data android:name="com.android.settings.HIGHLIGHT_MENU_KEY"
+                android:value="@string/menu_key_apps"/>
+        </activity>
+
+        <!-- SableOS: the "App controls" button of Android's dialog for an app Settings paused
+             (Freezer, Student mode or Focus mode). Android only offers it when the suspending
+             package (Settings) has an activity for this action guarded by exactly this
+             permission. Opens the App Control Center at that app. -->
         <activity-alias
             android:name="SableFocusModeSuspendedAppDetails"
-            android:targetActivity="Settings$SableFocusModeActivity"
+            android:targetActivity="Settings$SableAppControlCenterActivity"
             android:exported="true"
             android:permission="android.permission.SEND_SHOW_SUSPENDED_APP_DETAILS"
-            android:label="@string/sable_focus_title">
+            android:label="@string/sable_acc_title">
             <intent-filter>
                 <action android:name="android.intent.action.SHOW_SUSPENDED_APP_DETAILS" />
                 <category android:name="android.intent.category.DEFAULT" />
             </intent-filter>
             <meta-data android:name="com.android.settings.FRAGMENT_CLASS"
-                android:value="com.android.settings.applications.sable.SableFocusModeFragment" />
+                android:value="com.android.settings.applications.sable.SableAppControlCenterFragment" />
             <meta-data android:name="com.android.settings.HIGHLIGHT_MENU_KEY"
                 android:value="@string/menu_key_apps"/>
         </activity-alias>
 
+        <!-- SableOS: Student mode. Also the configuration activity of its entry in
+             Settings > Modes. -->
+        <activity
+            android:name="Settings$SableStudentModeActivity"
+            android:exported="true"
+            android:label="@string/sable_student_title">
+            <intent-filter>
+                <action android:name="org.sableos.settings.STUDENT_MODE" />
+                <category android:name="android.intent.category.DEFAULT" />
+            </intent-filter>
+            <meta-data android:name="com.android.settings.FRAGMENT_CLASS"
+                android:value="com.android.settings.applications.sable.SableStudentModeFragment" />
+            <meta-data android:name="com.android.settings.HIGHLIGHT_MENU_KEY"
+                android:value="@string/menu_key_apps"/>
+        </activity>
+
+        <!-- SableOS: Student mode window boundaries (explicit alarm), boot and clock changes. -->
+        <receiver
+            android:name=".applications.sable.SableStudentModeReceiver"
+            android:exported="false">
+            <intent-filter>
+                <action android:name="android.intent.action.BOOT_COMPLETED" />
+                <action android:name="android.intent.action.TIME_SET" />
+                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
+            </intent-filter>
+        </receiver>
+
         <!-- SableOS: Focus mode started or ended (from anywhere): pause or release the chosen
