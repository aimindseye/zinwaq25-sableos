+package com.android.settings.applications.sable;
+
+import android.content.Context;
+import android.content.pm.PackageManager;
+import android.content.pm.SuspendDialogInfo;
+import android.util.Log;
+
+import com.android.settings.R;
+import com.android.settings.applications.sable.model.AppSuspensions;
+import com.android.settings.applications.sable.model.FocusModePolicy;
+import com.android.settings.applications.sable.model.StudentSchedule;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.TreeMap;
+
+/**
+ * The one place Settings suspends and releases apps (see {@link AppSuspensions}): Freezer,
+ * Student mode and Focus mode together. Android keeps one suspension per suspending package,
+ * so the three must agree; an app is released only when none of them wants it, and only
+ * packages Settings suspended itself are ever released. Called whenever a mode starts or
+ * ends, a Freezer or allow-list choice changes, and when the Mobile Manager pages are shown.
+ */
+final class SableAppSuspender {
+    private static final String TAG = "SableAppSuspender";
+    private static final Object LOCK = new Object();
+
+    private SableAppSuspender() {
+    }
+
+    /** Reconciles with the modes' current states; returns the packages Android refused. */
+    static Set<String> reconcile(Context context) {
+        return reconcile(context, SableFocusMode.isActive(context),
+                SableStudentMode.isActive(context));
+    }
+
+    /**
+     * Suspends what Freezer, Student mode (while {@code studentActive}) and Focus mode (while
+     * {@code focusActive}) want and releases the rest of what Settings holds. Returns the
+     * packages Android refused to suspend.
+     */
+    static Set<String> reconcile(Context context, boolean focusActive, boolean studentActive) {
+        synchronized (LOCK) {
+            final Set<String> held = SableAppControls.readSet(context,
+                    SableAppControls.KEY_FOCUS_HELD);
+            final Map<String, AppSuspensions.Reason> targets =
+                    targets(context, focusActive, studentActive);
+            final Set<String> neverPause = SableAppControls.protectedPackages(context);
+            final FocusModePolicy.Plan plan = AppSuspensions.plan(targets, held, neverPause);
+            if (plan.isEmpty()) {
+                return Collections.emptySet();
+            }
+            final PackageManager pm = context.getPackageManager();
+            final Set<String> failedSuspend = new HashSet<>();
+            final Set<String> failedRelease = new HashSet<>();
+            if (!plan.suspend.isEmpty()) {
+                // One dialog for every reason: Android keeps one suspension per suspender, and
+                // its button opens the App Control Center, which says why each app is paused.
+                final SuspendDialogInfo dialog = new SuspendDialogInfo.Builder()
+                        .setTitle(R.string.sable_focus_suspended_title)
+                        .setMessage(R.string.sable_focus_suspended_message)
+                        .setNeutralButtonText(R.string.sable_focus_suspended_button)
+                        .setNeutralButtonAction(SuspendDialogInfo.BUTTON_ACTION_MORE_DETAILS)
+                        .build();
+                failedSuspend.addAll(apply(pm, plan.suspend, true, dialog));
+            }
+            if (!plan.release.isEmpty()) {
+                failedRelease.addAll(apply(pm, plan.release, false, null));
+            }
+            SableAppControls.writeSet(context, SableAppControls.KEY_FOCUS_HELD,
+                    FocusModePolicy.heldAfter(held, plan, failedSuspend, failedRelease));
+            return failedSuspend;
+        }
+    }
+
+    /** What Settings wants suspended now, each with its strongest reason. */
+    static Map<String, AppSuspensions.Reason> targets(Context context, boolean focusActive,
+            boolean studentActive) {
+        final Set<String> neverPause = SableAppControls.protectedPackages(context);
+        Set<String> studentBlocked = Collections.emptySet();
+        if (studentActive) {
+            final List<String> launcher = new ArrayList<>();
+            for (SableAppControls.LauncherApp app
+                    : SableAppControls.launcherApps(context, false)) {
+                launcher.add(app.packageName);
+            }
