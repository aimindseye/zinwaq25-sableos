+package com.android.settings.applications.sable.model;
+
+import java.util.Set;
+
+/**
+ * App lock (PRIVATE_SPACE_DUAL_APPS_WORK_PROFILE_UX: an extra unlock gate over chosen apps).
+ *
+ * <p>LineageOS 23.2 has no platform hook that stops an app's activity from starting until the
+ * device credential is confirmed. Settings cannot gate other apps' launches by itself: package
+ * suspension would also hide the app's notifications and stop its alarms, and re-locking after
+ * screen off would need a process that Settings does not keep running. So the choices are
+ * recorded and the page says plainly that they are not enforced
+ * ({@link #PLATFORM_ENFORCEMENT}), the same way App display compatibility never claims more
+ * than its backend applies. Private Space is the enforced alternative and the page links to it.
+ */
+public final class AppLockPolicy {
+
+    /** What the platform does with the chosen apps. */
+    public enum Enforcement {
+        /** Choices are stored; opening a chosen app does not ask for anything. */
+        NOT_ENFORCED,
+        /** A platform gate asks for the device credential before a chosen app opens. */
+        ENFORCED
+    }
+
+    /** What the App lock row and page header say. */
+    public enum Status {
+        /** No app chosen. */
+        NONE_CHOSEN,
+        /** Apps chosen, but nothing locks them. Never shown as "locked". */
+        CHOSEN_NOT_ENFORCED,
+        /** Apps chosen and the platform gate is active. */
+        LOCKED
+    }
+
+    /** LineageOS 23.2 with the current Sable patch set: no launch gate exists. */
+    public static final Enforcement PLATFORM_ENFORCEMENT = Enforcement.NOT_ENFORCED;
+
+    private AppLockPolicy() {}
+
+    public static Status status(int chosenCount, Enforcement enforcement) {
+        if (chosenCount <= 0) {
+            return Status.NONE_CHOSEN;
+        }
+        return enforcement == Enforcement.ENFORCED ? Status.LOCKED : Status.CHOSEN_NOT_ENFORCED;
+    }
+
+    /**
+     * Whether an app may be chosen: it has a launcher entry, and it is not one of the apps the
+     * phone needs to stay usable and recoverable (Settings, the home app, the dialer, the
+     * keyboard, the system UI), which the Android layer passes in {@code protectedPackages}.
+     */
+    public static boolean isEligible(String packageName, boolean hasLauncherActivity,
+            Set<String> protectedPackages) {
+        return PackageSet.isValidPackageName(packageName)
+                && hasLauncherActivity
+                && (protectedPackages == null || !protectedPackages.contains(packageName));
+    }
+}
