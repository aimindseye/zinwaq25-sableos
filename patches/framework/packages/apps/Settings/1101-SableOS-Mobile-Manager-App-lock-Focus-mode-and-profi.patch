+package com.android.settings.applications.sable.model;
+
+import java.util.Collection;
+import java.util.Collections;
+import java.util.Set;
+import java.util.TreeSet;
+
+/**
+ * A stored set of package names (App lock choices, Focus mode pause choices and the packages
+ * Focus mode actually paused). Stored as one comma-separated string; anything that is not a
+ * well-formed package name is dropped on read, so a damaged value never names a package.
+ */
+public final class PackageSet {
+
+    private PackageSet() {}
+
+    /** True for a well-formed Android package name: two or more Java-identifier segments. */
+    public static boolean isValidPackageName(String name) {
+        if (name == null || name.isEmpty() || name.length() > 255) {
+            return false;
+        }
+        int segments = 0;
+        boolean segmentStart = true;
+        for (int i = 0; i < name.length(); i++) {
+            final char c = name.charAt(i);
+            if (c == '.') {
+                if (segmentStart) {
+                    return false;
+                }
+                segmentStart = true;
+                continue;
+            }
+            final boolean letter = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z');
+            final boolean digit = c >= '0' && c <= '9';
+            if (segmentStart) {
+                if (!letter) {
+                    return false;
+                }
+                segments++;
+                segmentStart = false;
+            } else if (!letter && !digit && c != '_') {
+                return false;
+            }
+        }
+        return !segmentStart && segments >= 2;
+    }
+
+    /** The packages in a stored value, sorted; null or empty is the empty set. */
+    public static Set<String> parse(String stored) {
+        final Set<String> out = new TreeSet<>();
+        if (stored == null || stored.isEmpty()) {
+            return out;
+        }
+        for (String part : stored.split(",")) {
+            final String name = part.trim();
+            if (isValidPackageName(name)) {
+                out.add(name);
+            }
+        }
+        return out;
+    }
+
+    /** The stored form: sorted, de-duplicated, valid names only; empty for none. */
+    public static String format(Collection<String> packages) {
+        if (packages == null || packages.isEmpty()) {
+            return "";
+        }
+        final StringBuilder sb = new StringBuilder();
+        for (String name : new TreeSet<>(packages)) {
+            if (!isValidPackageName(name)) {
+                continue;
+            }
+            if (sb.length() > 0) {
+                sb.append(',');
+            }
+            sb.append(name);
+        }
+        return sb.toString();
+    }
+
+    /** A copy of {@code set} with {@code pkg} added ({@code on}) or removed. */
+    public static Set<String> with(Set<String> set, String pkg, boolean on) {
+        final Set<String> out = new TreeSet<>(set == null ? Collections.emptySet() : set);
+        if (on) {
+            if (isValidPackageName(pkg)) {
+                out.add(pkg);
+            }
+        } else {
+            out.remove(pkg);
+        }
+        return out;
+    }
+
+    /** The members of {@code set} that are also in {@code keep}. */
+    public static Set<String> retain(Set<String> set, Collection<String> keep) {
+        final Set<String> out = new TreeSet<>(set == null ? Collections.emptySet() : set);
+        if (keep == null) {
+            out.clear();
+        } else {
+            out.retainAll(keep);
+        }
+        return out;
+    }
+}
