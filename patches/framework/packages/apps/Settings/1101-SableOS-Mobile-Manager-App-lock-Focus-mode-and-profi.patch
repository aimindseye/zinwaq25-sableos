+
+package com.android.settings.applications.sable.model;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.Test;
+
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+import java.util.TreeSet;
+
+/** Mobile Manager: stored package sets, App lock, Focus mode and the profile rows. */
+public class AppControlsModelTest {
+
+    private static Set<String> set(String... names) {
+        return new TreeSet<>(Arrays.asList(names));
+    }
+
+    // --- PackageSet ---
+
+    @Test
+    public void packageNamesAreValidated() {
+        assertTrue(PackageSet.isValidPackageName("com.example.app"));
+        assertTrue(PackageSet.isValidPackageName("org.sableos.tools_2"));
+        assertFalse(PackageSet.isValidPackageName("example"));
+        assertFalse(PackageSet.isValidPackageName("com..example"));
+        assertFalse(PackageSet.isValidPackageName(".com.example"));
+        assertFalse(PackageSet.isValidPackageName("com.example."));
+        assertFalse(PackageSet.isValidPackageName("com.1example"));
+        assertFalse(PackageSet.isValidPackageName("com.exa mple"));
+        assertFalse(PackageSet.isValidPackageName(null));
