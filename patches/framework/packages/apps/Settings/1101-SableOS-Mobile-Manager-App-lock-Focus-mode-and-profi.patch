+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.settings.applications.sable.model;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.Set;
+import java.util.TreeSet;
+
+/**
+ * Focus mode (MOBILE_MANAGER_APP_CONTROLS_UX: the adult self-discipline variant).
+ *
+ * <p>Focus mode is an ordinary Android mode (an AutomaticZenRule that Settings owns), so it
+ * shows up in Modes, Quick Settings and the lock screen like any other mode, and Android's
+ * own notification policy does the silencing. Nothing here keeps a second notification
+ * filter:
+ * <ul>
+ *   <li>The mode lets through only apps whose notification channels may interrupt
+ *       (Android's "priority apps": channel bypass-DND, the store Settings &gt; Modes &gt;
+ *       Apps writes) plus alarms, media and repeat callers ({@link Spec}).</li>
+ *   <li>"Allow" on an app switches bypass on for its channels; that is Android's per-app
+ *       choice, so it also applies to other modes that let priority apps through. The page
+ *       says so.</li>
+ *   <li>Apps chosen to pause are suspended with the platform's package-suspension API while
+ *       the mode is on and released when it ends ({@link #plan}). Only packages Settings
+ *       suspended itself are released, so other suspenders (a device admin, another
+ *       wellbeing app) are never undone.</li>
+ * </ul>
+ */
+public final class FocusModePolicy {
+
+    /** The mode's notification policy (ZenPolicy), read by the Android layer. */
+    public static final class Spec {
+        public static final boolean ALLOW_PRIORITY_CHANNELS = true;
+        public static final boolean ALLOW_ALARMS = true;
+        public static final boolean ALLOW_MEDIA = true;
+        public static final boolean ALLOW_REPEAT_CALLERS = true;
+        public static final boolean ALLOW_CALLS = false;
+        public static final boolean ALLOW_MESSAGES = false;
+        public static final boolean ALLOW_CONVERSATIONS = false;
+        public static final boolean ALLOW_REMINDERS = false;
+        public static final boolean ALLOW_EVENTS = false;
+        public static final boolean ALLOW_SYSTEM = false;
+
+        private Spec() {}
+    }
+
+    /** One notification channel of an app, as the allow switch sees it. */
+    public static final class Channel {
+        /** Not blocked (importance is not NONE) and the app's notifications are on. */
+        public final boolean shown;
+        /** Currently allowed to interrupt modes (bypass DND). */
+        public final boolean bypass;
+        /** The user may change it (not locked by a critical device function). */
+        public final boolean configurable;
+        /** A conversation channel; conversations are chosen per person, not here. */
+        public final boolean conversation;
+
+        public Channel(boolean shown, boolean bypass, boolean configurable,
+                boolean conversation) {
+            this.shown = shown;
+            this.bypass = bypass;
+            this.configurable = configurable;
+            this.conversation = conversation;
+        }
+    }
+
+    /** Whether an app's notifications get through Focus mode. */
+    public enum Interrupts {
+        /** Every shown channel may interrupt: the switch is on. */
+        ALL,
+        /** Some channels may interrupt (chosen per channel in Android's page). */
+        SOME,
+        /** None may interrupt. */
+        NONE,
+        /** No channel the switch could change (no channels, all blocked or locked). */
+        NOT_CHANGEABLE
+    }
+
+    /** What to suspend and release, and what Settings holds suspended afterwards. */
+    public static final class Plan {
+        public final Set<String> suspend;
+        public final Set<String> release;
+
+        Plan(Set<String> suspend, Set<String> release) {
+            this.suspend = Collections.unmodifiableSet(suspend);
+            this.release = Collections.unmodifiableSet(release);
+        }
+
+        public boolean isEmpty() {
+            return suspend.isEmpty() && release.isEmpty();
+        }
+    }
+
+    private FocusModePolicy() {}
+
+    public static Interrupts interrupts(List<Channel> channels) {
+        int shown = 0;
+        int bypassing = 0;
+        int configurable = 0;
+        if (channels != null) {
+            for (Channel c : channels) {
+                if (c == null || c.conversation || !c.shown) {
+                    continue;
+                }
+                shown++;
+                if (c.bypass) {
+                    bypassing++;
+                }
+                if (c.configurable) {
+                    configurable++;
+                }
+            }
+        }
+        if (shown == 0) {
+            return Interrupts.NOT_CHANGEABLE;
+        }
+        if (bypassing == shown) {
+            return Interrupts.ALL;
+        }
+        if (bypassing > 0) {
+            return Interrupts.SOME;
+        }
+        return configurable > 0 ? Interrupts.NONE : Interrupts.NOT_CHANGEABLE;
+    }
+
+    /**
+     * The channels the allow switch changes (indexes into {@code channels}): every shown,
+     * configurable, non-conversation channel whose bypass differs from {@code allow}. The same
+     * rule as the "all notifications" switch on Android's per-app Modes page.
+     */
+    public static List<Integer> channelsToChange(List<Channel> channels, boolean allow) {
+        final List<Integer> out = new ArrayList<>();
+        if (channels == null) {
+            return out;
+        }
+        for (int i = 0; i < channels.size(); i++) {
+            final Channel c = channels.get(i);
+            if (c != null && c.shown && c.configurable && !c.conversation && c.bypass != allow) {
+                out.add(i);
+            }
+        }
+        return out;
+    }
+
+    /**
+     * Whether an app may be paused: valid name, has a launcher entry, and is not one of the
+     * apps the phone needs (Settings, home, dialer, SMS app, keyboard, system UI) that the
+     * Android layer passes in {@code neverPause}. The platform refuses some of these anyway;
+     * leaving them out keeps the list honest.
+     */
+    public static boolean canPause(String packageName, boolean hasLauncherActivity,
+            Set<String> neverPause) {
+        return PackageSet.isValidPackageName(packageName)
+                && hasLauncherActivity
+                && (neverPause == null || !neverPause.contains(packageName));
+    }
+
+    /**
+     * The suspension changes that make the platform match the mode.
+     *
+     * @param active whether Focus mode is on now
+     * @param chosen the apps the user chose to pause
+     * @param pausedBySettings the apps Settings suspended and has not released yet
+     * @param neverPause apps that must never be suspended (also releases them if held)
+     */
+    public static Plan plan(boolean active, Set<String> chosen, Set<String> pausedBySettings,
+            Set<String> neverPause) {
+        final Set<String> held = new TreeSet<>(
+                pausedBySettings == null ? Collections.emptySet() : pausedBySettings);
+        final Set<String> target = new TreeSet<>();
+        if (active && chosen != null) {
+            for (String pkg : chosen) {
+                if (PackageSet.isValidPackageName(pkg)
+                        && (neverPause == null || !neverPause.contains(pkg))) {
+                    target.add(pkg);
+                }
+            }
+        }
+        final Set<String> suspend = new TreeSet<>(target);
+        suspend.removeAll(held);
+        final Set<String> release = new TreeSet<>(held);
+        release.removeAll(target);
+        return new Plan(suspend, release);
+    }
+
+    /**
+     * What Settings holds suspended after applying {@code plan}, given the packages the
+     * platform refused to suspend or to release. A refused release stays held so the next
+     * reconcile tries again; a refused suspend is not held.
+     */
+    public static Set<String> heldAfter(Set<String> pausedBySettings, Plan plan,
+            Set<String> failedSuspend, Set<String> failedRelease) {
+        final Set<String> out = new TreeSet<>(
+                pausedBySettings == null ? Collections.emptySet() : pausedBySettings);
+        for (String pkg : plan.suspend) {
+            if (failedSuspend == null || !failedSuspend.contains(pkg)) {
+                out.add(pkg);
+            }
+        }
+        for (String pkg : plan.release) {
+            if (failedRelease == null || !failedRelease.contains(pkg)) {
+                out.remove(pkg);
+            }
+        }
+        return out;
+    }
+
+    /**
+     * The mode state carried by an AUTOMATIC_ZEN_RULE_STATUS_CHANGED broadcast, or null when
+     * the status does not say (the Android layer then reads the rule's state instead).
+     */
+    public static Boolean activeFromStatus(int status, int activated, int deactivated,
+            int disabled, int removed) {
+        if (status == activated) {
+            return Boolean.TRUE;
+        }
+        if (status == deactivated || status == disabled || status == removed) {
+            return Boolean.FALSE;
+        }
+        return null;
+    }
+}
