+package com.android.settings.applications.sable.model;
+
+/**
+ * Private Space, Dual Apps and Work profile rows (PRIVATE_SPACE_DUAL_APPS_WORK_PROFILE_UX).
+ *
+ * <p>All three are Android profiles (ANDROID_PROFILE_MODEL=KEEP, APK_COPY_HACK=NO): Private
+ * Space is the private profile, Dual Apps is the clone profile, Work is a managed profile.
+ * Settings only shows their state and opens Android's own setup and settings pages; it never
+ * creates a profile without the user going through those pages (NO_SILENT_PROFILE_CREATION).
+ */
+public final class ProfileSpaces {
+
+    public enum PrivateSpace {
+        /** The platform cannot add a private profile and none exists. */
+        UNAVAILABLE,
+        /** Can be set up; opening the row starts Android's setup after the screen lock. */
+        NOT_SET_UP,
+        LOCKED,
+        UNLOCKED
+    }
+
+    public enum DualApps {
+        /** The clone page is turned off in this build (config or device config). */
+        UNAVAILABLE,
+        /** The page is on but this build allows no installed app to be cloned. */
+        NO_ELIGIBLE_APPS,
+        /** At least one installed app can be cloned or already is. */
+        AVAILABLE
+    }
+
+    public enum WorkProfile {
+        /** No work profile; one is created by a work app or an IT admin, not here. */
+        NONE,
+        ON,
+        PAUSED
+    }
+
+    private ProfileSpaces() {}
+
+    public static PrivateSpace privateSpace(boolean canAdd, boolean exists, boolean locked) {
+        if (exists) {
+            return locked ? PrivateSpace.LOCKED : PrivateSpace.UNLOCKED;
+        }
+        return canAdd ? PrivateSpace.NOT_SET_UP : PrivateSpace.UNAVAILABLE;
+    }
+
+    /**
+     * @param pageEnabled the platform clone page is enabled
+     * @param eligibleInstalled installed apps on the build's cloneable list
+     * @param cloned apps already cloned
+     */
+    public static DualApps dualApps(boolean pageEnabled, int eligibleInstalled, int cloned) {
+        if (!pageEnabled) {
+            return DualApps.UNAVAILABLE;
+        }
+        return eligibleInstalled > 0 || cloned > 0 ? DualApps.AVAILABLE
+                : DualApps.NO_ELIGIBLE_APPS;
+    }
+
+    public static WorkProfile workProfile(boolean exists, boolean quietMode) {
+        if (!exists) {
+            return WorkProfile.NONE;
+        }
+        return quietMode ? WorkProfile.PAUSED : WorkProfile.ON;
+    }
+
+    /** Whether a row opens something; unavailable rows stay visible but explain why. */
+    public static boolean opens(PrivateSpace state) {
+        return state != PrivateSpace.UNAVAILABLE;
+    }
+
+    public static boolean opens(DualApps state) {
+        return state == DualApps.AVAILABLE;
+    }
+
+    public static boolean opens(WorkProfile state) {
+        return state != WorkProfile.NONE;
+    }
+}
