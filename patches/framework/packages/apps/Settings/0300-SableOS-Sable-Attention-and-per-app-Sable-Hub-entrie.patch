+package com.android.settings.notification.app;
+
+import android.content.Context;
+import android.content.Intent;
+import android.provider.Settings;
+
+import androidx.preference.Preference;
+
+import com.android.settings.core.PreferenceControllerMixin;
+
+/**
+ * Per-app notification page link to Sable Hub's Hub and Attention settings for this app
+ * (Include in Hub, Hub priority, preview, history, and profile-supported attention outputs).
+ * Delivery policy stays on this Android page; Hub stores none of it.
+ */
+public class SableHubAppPreferenceController extends NotificationPreferenceController
+        implements PreferenceControllerMixin {
+
+    private static final String KEY = "sable_hub_attention";
+    private static final String HUB_PACKAGE = "org.sableos.hub";
+    private static final String ACTION_APP_SETTINGS =
+            "org.sableos.hub.action.APP_NOTIFICATION_SETTINGS";
+    private static final String EXTRA_APP_UID = "app_uid";
+
+    public SableHubAppPreferenceController(Context context) {
+        super(context, null);
+    }
+
+    @Override
+    public String getPreferenceKey() {
+        return KEY;
+    }
+
+    @Override
+    public boolean isAvailable() {
+        if (!super.isAvailable() || HUB_PACKAGE.equals(mAppRow.pkg)) {
+            return false;
+        }
+        return mContext.getPackageManager().resolveActivity(intent(), 0) != null;
+    }
+
+    @Override
+    boolean isIncludedInFilter() {
+        return false;
+    }
+
+    @Override
+    public void updateState(Preference preference) {
+        if (preference.getParent() != null) {
+            preference.getParent().setVisible(true);
+        }
+        if (mAppRow != null) {
+            preference.setIntent(intent()
+                    .putExtra(Settings.EXTRA_APP_PACKAGE, mAppRow.pkg)
+                    .putExtra(EXTRA_APP_UID, mAppRow.uid));
+        }
+    }
+
+    private Intent intent() {
+        return new Intent(ACTION_APP_SETTINGS).setPackage(HUB_PACKAGE);
+    }
+}
