+package com.android.settings.notification;
+
+import android.content.Context;
+import android.content.Intent;
+
+import com.android.settings.core.BasePreferenceController;
+
+/**
+ * Settings > Notifications > Sable Attention. Shown only when Sable Hub, which owns the Sable
+ * Attention screen, is installed. The screen itself lists only profile-supported outputs and
+ * links back here for anything Android owns.
+ */
+public class SableAttentionPreferenceController extends BasePreferenceController {
+
+    static final String HUB_PACKAGE = "org.sableos.hub";
+    static final String ACTION_ATTENTION_SETTINGS = "org.sableos.hub.action.ATTENTION_SETTINGS";
+
+    public SableAttentionPreferenceController(Context context, String preferenceKey) {
+        super(context, preferenceKey);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        Intent intent = new Intent(ACTION_ATTENTION_SETTINGS).setPackage(HUB_PACKAGE);
+        return mContext.getPackageManager().resolveActivity(intent, 0) != null
+                ? AVAILABLE : UNSUPPORTED_ON_DEVICE;
+    }
+}
