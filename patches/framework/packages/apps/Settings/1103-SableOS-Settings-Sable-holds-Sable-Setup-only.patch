-                    // Mobile Manager is indexed once, from Settings > Apps.
-                    keys.add(KEY_MOBILE_MANAGER);
-                    return keys;
+                protected boolean isPageSearchEnabled(Context context) {
+                    return SableLinks.anyAvailable(context);
                 }
