+package com.android.settings.sable;
+
+import android.app.settings.SettingsEnums;
+import android.content.Context;
+import android.os.Bundle;
+import android.view.View;
+
+import com.android.settings.R;
+import com.android.settings.applications.sable.SableAppListKeyboard;
+import com.android.settings.dashboard.DashboardFragment;
+import com.android.settings.search.BaseSearchIndexProvider;
+import com.android.settingslib.search.SearchIndexable;
+
+/**
+ * Settings > Sable (KEYBOARD_FIRST_SETTINGS_UX): links to Sable Start (home layout, quick bar),
+ * Sable Hub, Sable Tools diagnostics and App display compatibility. The settings stay owned by
+ * those apps; this page only opens them. Rows of absent apps are hidden and not indexed, and the
+ * page is left out of search when none is installed.
+ */
+@SearchIndexable
+public class SableSettingsFragment extends DashboardFragment {
+    private static final String TAG = "SableSettings";
+
+    private SableAppListKeyboard mKeyboard;
+
+    @Override
+    public int getMetricsCategory() {
+        return SettingsEnums.SETTINGS_SYSTEM_CATEGORY;
+    }
+
+    @Override
+    protected String getLogTag() {
+        return TAG;
+    }
+
+    @Override
+    protected int getPreferenceScreenResId() {
+        return R.xml.sable_settings;
+    }
+
+    @Override
+    public void onViewCreated(View view, Bundle savedInstanceState) {
+        super.onViewCreated(view, savedInstanceState);
+        mKeyboard = SableAppListKeyboard.attach(this, getListView(), getMetricsCategory());
+    }
+
+    @Override
+    public void onDestroyView() {
+        if (mKeyboard != null) {
+            mKeyboard.detach();
+            mKeyboard = null;
+        }
+        super.onDestroyView();
+    }
+
+    public static final BaseSearchIndexProvider SEARCH_INDEX_DATA_PROVIDER =
+            new BaseSearchIndexProvider(R.xml.sable_settings) {
+                @Override
+                protected boolean isPageSearchEnabled(Context context) {
+                    return SableLinks.anyAvailable(context);
+                }
+            };
+}
