diff --git a/src/com/android/settings/sable/SableDisplayCompatAppPreferenceController.java b/src/com/android/settings/sable/SableDisplayCompatAppPreferenceController.java
new file mode 100644
index 0000000..61d4291
--- /dev/null
+++ b/src/com/android/settings/sable/SableDisplayCompatAppPreferenceController.java
@@ -0,0 +1,95 @@
