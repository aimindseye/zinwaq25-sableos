+
+package com.android.settings.sable;
+
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.Intent;
+import android.content.pm.ActivityInfo;
+import android.content.pm.ResolveInfo;
+import android.net.Uri;
+
+import java.util.List;
+
+/**
+ * Intents from Settings into the Sable apps that own some system settings (Sable Start, Sable
+ * Hub, Sable Tools, App display compatibility). Each link is resolved to an explicit component
+ * in that app's own package, so a missing app hides the row and no other app can answer.
+ */
+public final class SableLinks {
+    public static final String START_PACKAGE = "org.sableos.launcher";
+    /** Opens Sable Start's quick bar editor (SableStartActivity). */
+    public static final String ACTION_EDIT_QUICK_BAR = "org.sableos.start.action.EDIT_QUICK_BAR";
+    public static final String HUB_PACKAGE = "org.sableos.hub";
+    public static final String TOOLS_PACKAGE = "org.sableos.tools";
+    public static final String ACTION_OPEN_TOOL = "org.sableos.tools.action.OPEN_TOOL";
+    public static final String EXTRA_TOOL = "org.sableos.tools.extra.TOOL";
+    public static final String TOOL_HARDWARE_TESTS = "HARDWARE_TESTS";
+    public static final String DISPLAY_COMPAT_PACKAGE = "org.sableos.titan2.displaycompat";
+    /** Opens one app's profile in App display compatibility; data is {@code package:<name>}. */
+    public static final String ACTION_APP_DISPLAY_PROFILE =
+            "org.sableos.titan2.displaycompat.action.APP_PROFILE";
+
+    public static final String KEY_START = "sable_start";
+    public static final String KEY_QUICK_BAR = "sable_start_quick_bar";
+    public static final String KEY_HUB = "sable_hub";
+    public static final String KEY_DIAGNOSTICS = "sable_tools_diagnostics";
+    public static final String KEY_HARDWARE_TESTS = "sable_tools_hardware_tests";
+    public static final String KEY_DISPLAY_COMPAT = "sable_display_compat";
+    /** Settings > Display > App display compatibility. */
+    public static final String KEY_DISPLAY_COMPAT_DISPLAY = "sable_display_compat_display";
+
+    /** The rows of Settings > Sable, in page order. */
+    public static final String[] SABLE_PAGE_KEYS = {
+            KEY_START, KEY_QUICK_BAR, KEY_HUB, KEY_DIAGNOSTICS, KEY_HARDWARE_TESTS,
+            KEY_DISPLAY_COMPAT,
+    };
+
+    private SableLinks() {
+    }
+
+    /** The unresolved intent for a row key, or null for an unknown key. */
+    static Intent intentFor(String key) {
+        if (key == null) {
+            return null;
+        }
+        switch (key) {
+            case KEY_START:
+                return new Intent(Intent.ACTION_MAIN).addCategory(Intent.CATEGORY_HOME)
+                        .setPackage(START_PACKAGE);
+            case KEY_QUICK_BAR:
+                return new Intent(ACTION_EDIT_QUICK_BAR).setPackage(START_PACKAGE);
+            case KEY_HUB:
+                return launcher(HUB_PACKAGE);
+            case KEY_DIAGNOSTICS:
+                return launcher(TOOLS_PACKAGE);
+            case KEY_HARDWARE_TESTS:
+                return new Intent(ACTION_OPEN_TOOL).setPackage(TOOLS_PACKAGE)
+                        .putExtra(EXTRA_TOOL, TOOL_HARDWARE_TESTS);
+            case KEY_DISPLAY_COMPAT:
+            case KEY_DISPLAY_COMPAT_DISPLAY:
+                return launcher(DISPLAY_COMPAT_PACKAGE);
+            default:
+                return null;
+        }
+    }
+
+    /**
+     * The intent for a row key with an explicit component, or null when the owning app is not
+     * installed (or has no activity for it).
+     */
+    public static Intent resolve(Context context, String key) {
+        return resolveIntent(context, intentFor(key));
+    }
+
+    /** The App display compatibility page for one package, or null when unavailable. */
+    public static Intent appDisplayProfile(Context context, String packageName) {
+        final Intent intent = new Intent(ACTION_APP_DISPLAY_PROFILE)
+                .setPackage(DISPLAY_COMPAT_PACKAGE)
+                .setData(Uri.fromParts("package", packageName, null));
+        return resolveIntent(context, intent);
+    }
+
+    /** True when at least one row of Settings > Sable has its app installed. */
+    public static boolean anyAvailable(Context context) {
+        for (String key : SABLE_PAGE_KEYS) {
+            if (resolve(context, key) != null) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private static Intent launcher(String packageName) {
+        return new Intent(Intent.ACTION_MAIN).addCategory(Intent.CATEGORY_LAUNCHER)
+                .setPackage(packageName);
+    }
+
+    private static Intent resolveIntent(Context context, Intent intent) {
+        if (context == null || intent == null) {
+            return null;
+        }
+        final List<ResolveInfo> matches =
+                context.getPackageManager().queryIntentActivities(intent, 0);
+        if (matches == null) {
+            return null;
+        }
+        for (ResolveInfo ri : matches) {
+            final ActivityInfo ai = ri.activityInfo;
+            if (ai != null && ai.exported && intent.getPackage().equals(ai.packageName)) {
+                return new Intent(intent).setComponent(new ComponentName(ai.packageName, ai.name));
+            }
+        }
+        return null;
+    }
+}
