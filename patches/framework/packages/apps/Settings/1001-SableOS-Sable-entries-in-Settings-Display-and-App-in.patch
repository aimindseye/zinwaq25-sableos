+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.settings.sable;
+
+import android.content.ActivityNotFoundException;
+import android.content.Context;
+import android.content.Intent;
+import android.content.pm.PackageInfo;
+import android.os.Process;
+import android.os.UserHandle;
+import android.text.TextUtils;
+import android.util.Log;
+
+import androidx.preference.Preference;
+
+import com.android.settings.applications.appinfo.AppInfoPreferenceControllerBase;
+
+/**
+ * App info &gt; Display compatibility (APP_DISPLAY_COMPATIBILITY_PROFILES_UX APP_INFO_PATH):
+ * opens this app's profile in App display compatibility. Shown only when that app is installed
+ * and answers its per-app action, and only for launcher apps of this user (the ones it can
+ * profile); never for App display compatibility itself.
+ */
+public class SableDisplayCompatAppPreferenceController extends AppInfoPreferenceControllerBase {
+    private static final String TAG = "SableDisplayCompatApp";
+
+    public SableDisplayCompatAppPreferenceController(Context context, String preferenceKey) {
+        super(context, preferenceKey);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return SableLinks.appDisplayProfile(mContext, mContext.getPackageName()) != null
+                ? AVAILABLE : UNSUPPORTED_ON_DEVICE;
+    }
+
+    @Override
+    public void updateState(Preference preference) {
+        if (preference != null) {
+            preference.setVisible(packageName() != null);
+        }
+    }
+
+    @Override
+    public boolean handlePreferenceTreeClick(Preference preference) {
+        if (!TextUtils.equals(preference.getKey(), getPreferenceKey())) {
+            return false;
+        }
+        final String pkg = packageName();
+        final Intent intent = pkg == null ? null : SableLinks.appDisplayProfile(mContext, pkg);
+        if (intent == null) {
+            preference.setVisible(false);
+            return true;
+        }
+        try {
+            // The page's own activity: Back returns here.
+            preference.getContext().startActivity(intent);
+        } catch (ActivityNotFoundException | SecurityException e) {
+            Log.w(TAG, "Cannot open App display compatibility for " + pkg, e);
+        }
+        return true;
+    }
+
+    /** The app's package when it can have a profile here, else null. */
+    private String packageName() {
+        // getAppEntry() is package-private in AppInfoDashboardFragment; getPackageInfo() is public.
+        final PackageInfo info = mParent == null ? null : mParent.getPackageInfo();
+        if (info == null || info.applicationInfo == null) {
+            return null;
+        }
+        final String pkg = info.packageName;
+        if (pkg == null || SableLinks.DISPLAY_COMPAT_PACKAGE.equals(pkg)) {
+            return null;
+        }
+        if (!UserHandle.getUserHandleForUid(info.applicationInfo.uid)
+                .equals(Process.myUserHandle())) {
+            return null; // App display compatibility profiles apps of its own user only
+        }
+        return mContext.getPackageManager().getLaunchIntentForPackage(pkg) != null ? pkg : null;
+    }
+}
