+import android.content.ActivityNotFoundException;
+import android.content.Context;
+import android.content.Intent;
+import android.text.TextUtils;
+import android.util.Log;
+
+import androidx.preference.Preference;
+
+import com.android.settings.core.BasePreferenceController;
+
+/**
+ * A row that opens a Sable app (see {@link SableLinks}, keyed by the preference key). The row is
+ * hidden, and left out of Settings search, when the app is not installed.
+ */
+public class SableLinkPreferenceController extends BasePreferenceController {
+    private static final String TAG = "SableLinkPref";
+
+    public SableLinkPreferenceController(Context context, String preferenceKey) {
+        super(context, preferenceKey);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return SableLinks.resolve(mContext, getPreferenceKey()) != null
+                ? AVAILABLE : UNSUPPORTED_ON_DEVICE;
+    }
+
+    @Override
+    public boolean handlePreferenceTreeClick(Preference preference) {
+        if (!TextUtils.equals(preference.getKey(), getPreferenceKey())) {
+            return false;
+        }
+        // Resolved again on click: the app may have been removed while the page was open.
+        final Intent intent = SableLinks.resolve(mContext, getPreferenceKey());
+        if (intent == null) {
+            preference.setVisible(false);
+            return true;
+        }
+        try {
+            // The page's own activity: Back returns here.
+            preference.getContext().startActivity(intent);
+        } catch (ActivityNotFoundException | SecurityException e) {
+            Log.w(TAG, "Cannot open " + getPreferenceKey(), e);
+        }
+        return true;
+    }
+}
