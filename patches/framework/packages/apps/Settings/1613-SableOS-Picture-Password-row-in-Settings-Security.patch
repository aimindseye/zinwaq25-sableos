From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SableOS <noreply@sableos.invalid>
Date: Fri, 6 Nov 2026 22:00:00 +0000
Subject: [PATCH] SableOS: Picture Password row in Settings > Security

Picture Password was only on the Sable page. It now also sits in Settings >
Security and privacy, right after Lock screen peek, and opens the same
SystemUI setup (org.sableos.keyguard.action.PICTURE_PASSWORD, frameworks/base
0320) to set it up, change it or turn it off.
---
 res/xml/security_dashboard_settings.xml | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/res/xml/security_dashboard_settings.xml b/res/xml/security_dashboard_settings.xml
--- a/res/xml/security_dashboard_settings.xml
+++ b/res/xml/security_dashboard_settings.xml
@@ -51,6 +51,16 @@
             settings:keywords="@string/sable_lock_peek_keywords"
             settings:controller="com.android.settings.sable.SableLockPeekPreferenceController" />
 
+        <!-- SableOS: Picture Password, also on the Sable page (SystemUI, frameworks/base 0320). -->
+        <Preference
+            android:key="sable_picture_password_security"
+            android:title="@string/sable_page_picture_password_title"
+            android:summary="@string/sable_page_picture_password_summary">
+            <intent
+                android:action="org.sableos.keyguard.action.PICTURE_PASSWORD"
+                android:targetPackage="com.android.systemui" />
+        </Preference>
+
         <com.android.settingslib.RestrictedPreference
             android:key="fingerprint_settings"
             android:title="@string/security_settings_fingerprint_preference_title"
-- 
