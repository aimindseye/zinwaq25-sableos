+package com.android.settings.sable;
+
+import android.content.Context;
+import android.os.SystemProperties;
+
+import androidx.preference.ListPreference;
+import androidx.preference.Preference;
+
+import com.android.settings.core.BasePreferenceController;
+
+import java.io.File;
+
+/**
+ * Settings > System > Keyboard > Trackpad (Zinwa Q25): Keys moves between items like arrow keys,
+ * Pointer moves a cursor. Settings only stores the choice in persist.sys.sable.trackpad; init
+ * writes the keyboard driver's switch (sable-trackpad.rc), which no app may write. Shown only
+ * where the driver has the switch.
+ */
+public class SableTrackpadPreferenceController extends BasePreferenceController
+        implements Preference.OnPreferenceChangeListener {
+
+    static final String PROP = "persist.sys.sable.trackpad";
+    static final String KEYS = "keys";
+    static final String POINTER = "pointer";
+    private static final String SWITCH = "/proc/q20_switch_key_mouse";
+
+    public SableTrackpadPreferenceController(Context context, String preferenceKey) {
+        super(context, preferenceKey);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return new File(SWITCH).exists() ? AVAILABLE : UNSUPPORTED_ON_DEVICE;
+    }
+
+    static String mode() {
+        return POINTER.equals(SystemProperties.get(PROP, KEYS)) ? POINTER : KEYS;
+    }
+
+    @Override
+    public void updateState(Preference preference) {
+        super.updateState(preference);
+        if (preference instanceof ListPreference) {
+            ListPreference list = (ListPreference) preference;
+            list.setValue(mode());
+            list.setSummary(list.getEntry());
+        }
+    }
+
+    @Override
+    public boolean onPreferenceChange(Preference preference, Object newValue) {
+        String value = String.valueOf(newValue);
+        if (!KEYS.equals(value) && !POINTER.equals(value)) {
+            return false;
+        }
+        SystemProperties.set(PROP, value);
+        updateState(preference);
+        return true;
+    }
+}
