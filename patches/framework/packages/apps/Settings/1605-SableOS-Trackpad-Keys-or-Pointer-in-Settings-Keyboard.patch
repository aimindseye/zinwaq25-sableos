+<resources>
+    <!-- Settings > System > Keyboard: the trackpad mode row and its dialog title. -->
+    <string name="sable_trackpad_title">Trackpad</string>
+    <!-- Trackpad mode: the trackpad moves focus like arrow keys (BlackBerry style, the default). -->
+    <string name="sable_trackpad_keys">Keys: moves between items</string>
+    <!-- Trackpad mode: the trackpad moves an on-screen pointer; clicking taps where it points. -->
+    <string name="sable_trackpad_pointer">Pointer: moves a cursor</string>
+    <!-- Search keywords for the trackpad mode row. -->
+    <string name="keywords_sable_trackpad">trackpad, touchpad, mouse, pointer, cursor, arrow keys</string>
+
+    <string-array name="sable_trackpad_mode_entries">
+        <item>@string/sable_trackpad_keys</item>
+        <item>@string/sable_trackpad_pointer</item>
+    </string-array>
+    <!-- persist.sys.sable.trackpad values read by system_ext/etc/init/sable-trackpad.rc. -->
+    <string-array name="sable_trackpad_mode_values" translatable="false">
+        <item>keys</item>
+        <item>pointer</item>
+    </string-array>
+</resources>
diff --git a/res/xml/keyboard_settings.xml b/res/xml/keyboard_settings.xml
index 7579bdd..d1ac1ef 100644
--- a/res/xml/keyboard_settings.xml
+++ b/res/xml/keyboard_settings.xml
@@ -72,6 +72,17 @@
         settings:keywords="@string/keywords_sable_keyboard_backlight"
         settings:controller="com.android.settings.sable.SableKeyboardBacklightPreferenceController" />
 
+    <!-- SableOS: trackpad mode (Zinwa Q25), shown where the keyboard driver has the switch. -->
+    <ListPreference
+        android:key="sable_trackpad_mode"
+        android:title="@string/sable_trackpad_title"
+        android:entries="@array/sable_trackpad_mode_entries"
+        android:entryValues="@array/sable_trackpad_mode_values"
+        android:dialogTitle="@string/sable_trackpad_title"
+        android:persistent="false"
+        settings:keywords="@string/keywords_sable_trackpad"
+        settings:controller="com.android.settings.sable.SableTrackpadPreferenceController" />
+
     <!-- SableOS: Keyboard firmware (also *#*#1122#*#*), where the keyboard driver has the
          stock firmware-upgrade switch. -->
     <Preference
diff --git a/src/com/android/settings/sable/SableTrackpadPreferenceController.java b/src/com/android/settings/sable/SableTrackpadPreferenceController.java
new file mode 100644
