+package com.android.settings.sable;
+
+import android.content.Context;
+import android.os.SystemProperties;
+
+import androidx.preference.Preference;
+import androidx.preference.TwoStatePreference;
+
+import com.android.settings.core.BasePreferenceController;
+
+/**
+ * Settings > Display > Double-tap to wake (Zinwa Q25). Settings only stores the choice in
+ * persist.sys.sable.dt2w (1 or 0); init copies it to the touch driver's wake_gesture module
+ * parameter (sable-dt2w.rc, kernel patch 0903). Shown only where the product sets
+ * ro.sable.double_tap_wake. Off by default.
+ */
+public class SableDoubleTapWakePreferenceController extends BasePreferenceController
+        implements Preference.OnPreferenceChangeListener {
+
+    static final String PROP = "persist.sys.sable.dt2w";
+    static final String SUPPORTED = "ro.sable.double_tap_wake";
+
+    public SableDoubleTapWakePreferenceController(Context context, String preferenceKey) {
+        super(context, preferenceKey);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return SystemProperties.getBoolean(SUPPORTED, false) ? AVAILABLE : UNSUPPORTED_ON_DEVICE;
+    }
+
+    static boolean isOn() {
+        return SystemProperties.getBoolean(PROP, false);
+    }
+
+    @Override
+    public void updateState(Preference preference) {
+        super.updateState(preference);
+        if (preference instanceof TwoStatePreference) {
+            ((TwoStatePreference) preference).setChecked(isOn());
+        }
+    }
+
+    @Override
+    public boolean onPreferenceChange(Preference preference, Object newValue) {
+        SystemProperties.set(PROP, Boolean.TRUE.equals(newValue) ? "1" : "0");
+        return true;
+    }
+}
