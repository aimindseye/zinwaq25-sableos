 .../settings/SettingsPreferenceFragment.java  | 18 +++++
 .../sable/SableAppListKeyboard.java           | 11 +++
 .../fuelgauge/sable/SableFocusDecoration.java | 68 ++++++++++++++++---
 4 files changed, 106 insertions(+), 11 deletions(-)
 create mode 100644 res/values/sable_focus_ids.xml

