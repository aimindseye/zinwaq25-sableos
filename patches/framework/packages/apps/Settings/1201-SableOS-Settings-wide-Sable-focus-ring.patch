diff --git a/src/com/android/settings/fuelgauge/sable/SableFocusDecoration.java b/src/com/android/settings/fuelgauge/sable/SableFocusDecoration.java
index 0582bb2..9ae44e1 100644
--- a/src/com/android/settings/fuelgauge/sable/SableFocusDecoration.java
+++ b/src/com/android/settings/fuelgauge/sable/SableFocusDecoration.java
@@ -18,6 +18,7 @@ package com.android.settings.fuelgauge.sable;
 
 import android.content.Context;
 import android.graphics.Canvas;
+import android.graphics.Color;
 import android.graphics.Paint;
 import android.graphics.RectF;
 import android.view.View;
@@ -28,12 +29,22 @@ import androidx.recyclerview.widget.RecyclerView;
 import com.android.settings.R;
 
 /**
- * High-contrast focus ring for the focused Settings row: a stroke in the primary text color
- * (not the accent color alone), so keyboard focus is visible on any theme. Redraws on every
- * global focus change.
+ * The Sable focus ring for the focused Settings row (KEYBOARD_FIRST_SETTINGS_UX, approved
+ * design): an accent fill behind the row content plus a solid accent border, so keyboard focus
+ * reads at a glance on the 720x720 screen in light and dark themes. Drawn over the row (rows
+ * have opaque backgrounds), the fill is translucent so the title and summary stay legible.
+ * Hidden in touch mode. Redraws on every global focus change.
+ *
+ * <p>One ring per list: {@link #installOn} is idempotent, so the Settings-wide install in
+ * SettingsPreferenceFragment and page-level keyboard helpers (Battery, the Sable lists) can
+ * both ask for it.
  */
-final class SableFocusDecoration extends RecyclerView.ItemDecoration {
-    private final Paint mPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+public final class SableFocusDecoration extends RecyclerView.ItemDecoration {
+    /** Fill alpha (0-255) of the accent behind the focused row. */
+    static final int FILL_ALPHA = 0x47;
+
+    private final Paint mStroke = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint mFill = new Paint(Paint.ANTI_ALIAS_FLAG);
     private final RectF mRect = new RectF();
     private final float mInset;
     private final float mRadius;
@@ -42,21 +53,55 @@ final class SableFocusDecoration extends RecyclerView.ItemDecoration {
 
     SableFocusDecoration(Context context, RecyclerView list) {
         mList = list;
-        mPaint.setStyle(Paint.Style.STROKE);
-        mPaint.setStrokeWidth(
+        final int accent = SableRangeSelectorView.color(context, android.R.attr.colorAccent);
+        mStroke.setStyle(Paint.Style.STROKE);
+        mStroke.setStrokeWidth(
                 context.getResources().getDimension(R.dimen.sable_battery_focus_stroke));
-        mPaint.setColor(SableRangeSelectorView.color(context, android.R.attr.textColorPrimary));
+        mStroke.setColor(accent);
+        mFill.setStyle(Paint.Style.FILL);
+        mFill.setColor(Color.argb(FILL_ALPHA, Color.red(accent), Color.green(accent),
+                Color.blue(accent)));
         mInset = context.getResources().getDimension(R.dimen.sable_battery_focus_inset);
         mRadius = context.getResources().getDimension(R.dimen.sable_battery_focus_radius);
         mFocusListener = (oldFocus, newFocus) -> mList.invalidate();
     }
 
+    /**
+     * Puts the ring on {@code list} unless it already has one. Returns the new ring, which the
+     * caller owns and removes with {@link #uninstall(SableFocusDecoration)}, or null when there
+     * is no list or another owner's ring is already there (so nobody removes a ring they did
+     * not install).
+     */
+    public static SableFocusDecoration installOn(RecyclerView list) {
+        if (list == null || list.getTag(R.id.sable_focus_ring) != null) {
+            return null;
+        }
+        final SableFocusDecoration ring = new SableFocusDecoration(list.getContext(), list);
+        ring.install();
+        return ring;
+    }
+
+    /** Removes {@code ring} from its list if it is still the list's ring. */
+    public static void uninstall(SableFocusDecoration ring) {
+        if (ring != null) {
+            ring.uninstall();
+        }
+    }
+
     void install() {
+        if (mList.getTag(R.id.sable_focus_ring) != null) {
+            return;
+        }
+        mList.setTag(R.id.sable_focus_ring, this);
         mList.addItemDecoration(this);
         mList.getViewTreeObserver().addOnGlobalFocusChangeListener(mFocusListener);
     }
 
     void uninstall() {
+        if (mList.getTag(R.id.sable_focus_ring) != this) {
+            return;
+        }
+        mList.setTag(R.id.sable_focus_ring, null);
         mList.removeItemDecoration(this);
         if (mList.getViewTreeObserver().isAlive()) {
             mList.getViewTreeObserver().removeOnGlobalFocusChangeListener(mFocusListener);
@@ -66,14 +111,15 @@ final class SableFocusDecoration extends RecyclerView.ItemDecoration {
     @Override
     public void onDrawOver(Canvas c, RecyclerView parent, RecyclerView.State state) {
         final View focused = parent.getFocusedChild();
-        // Rows only: inner widgets (range group, chart) draw their own focus state.
+        // Rows only: inner widgets (range group, chart, hub cards) draw their own focus state.
         if (focused == null || !focused.isFocused() || parent.isInTouchMode()) {
             return;
         }
-        final float half = mPaint.getStrokeWidth() / 2f;
+        final float half = mStroke.getStrokeWidth() / 2f;
         mRect.set(focused.getLeft() + mInset + half, focused.getTop() + mInset + half,
                 focused.getRight() - mInset - half, focused.getBottom() - mInset - half);
         mRect.offset(focused.getTranslationX(), focused.getTranslationY());
-        c.drawRoundRect(mRect, mRadius, mRadius, mPaint);
+        c.drawRoundRect(mRect, mRadius, mRadius, mFill);
+        c.drawRoundRect(mRect, mRadius, mRadius, mStroke);
     }
 }
