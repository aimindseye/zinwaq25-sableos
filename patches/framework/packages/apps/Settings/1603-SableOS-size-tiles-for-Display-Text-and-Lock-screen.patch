+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.settings.sable;
+
+import android.content.Context;
+import android.os.RemoteException;
+import android.os.UserHandle;
+import android.util.Log;
+import android.view.Display;
+import android.view.IWindowManager;
+import android.view.WindowManagerGlobal;
+
+import androidx.preference.Preference;
+
+import com.android.settings.R;
+import com.android.settings.core.BasePreferenceController;
+import com.android.settingslib.utils.ThreadUtils;
+
+/**
+ * Settings > Display > Display size: five "A" tiles (Smaller to Larger) around the panel's own
+ * density, from {@link SableSizes}. Default clears the forced density; the others force it for the
+ * current user, as Android's Display size and text page does. A density set elsewhere selects no
+ * tile and is named as custom.
+ */
+public class SableDisplaySizePreferenceController extends BasePreferenceController
+        implements Preference.OnPreferenceChangeListener {
+    private static final String TAG = "SableDisplaySizePref";
+
+    public SableDisplaySizePreferenceController(Context context, String preferenceKey) {
+        super(context, preferenceKey);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return initialDensity() > 0 ? AVAILABLE : UNSUPPORTED_ON_DEVICE;
+    }
+
+    @Override
+    public void updateState(Preference preference) {
+        super.updateState(preference);
+        if (!(preference instanceof SableSizeTilesPreference)) {
+            return;
+        }
+        SableSizeTilesPreference tiles = (SableSizeTilesPreference) preference;
+        int index = SableSizes.displayIndexOf(initialDensity(), baseDensity());
+        tiles.setSelectedIndex(index);
+        tiles.setSummary(index >= 0
+                ? tiles.getSelectedName()
+                : mContext.getString(R.string.sable_display_size_custom));
+    }
+
+    @Override
+    public boolean onPreferenceChange(Preference preference, Object newValue) {
+        if (!(newValue instanceof Integer)) {
+            return false;
+        }
+        int index = (Integer) newValue;
+        int initial = initialDensity();
+        if (initial <= 0 || index < 0 || index >= SableSizes.displayStepCount()) {
+            return false;
+        }
+        int density = SableSizes.displayDensity(initial, index);
+        int userId = UserHandle.myUserId();
+        ThreadUtils.postOnBackgroundThread(() -> {
+            try {
+                IWindowManager wm = WindowManagerGlobal.getWindowManagerService();
+                if (index == SableSizes.DISPLAY_DEFAULT_INDEX) {
+                    wm.clearForcedDisplayDensityForUser(Display.DEFAULT_DISPLAY, userId);
+                } else {
+                    wm.setForcedDisplayDensityForUser(Display.DEFAULT_DISPLAY, density, userId);
+                }
+            } catch (RemoteException | SecurityException e) {
+                Log.w(TAG, "could not set the display size", e);
+            }
+        });
+        if (preference instanceof SableSizeTilesPreference) {
+            SableSizeTilesPreference tiles = (SableSizeTilesPreference) preference;
+            preference.setSummary(tiles.getNames()[index]);
+        }
+        return true;
+    }
+
+    private static int initialDensity() {
+        try {
+            return WindowManagerGlobal.getWindowManagerService()
+                    .getInitialDisplayDensity(Display.DEFAULT_DISPLAY);
+        } catch (RemoteException e) {
+            return -1;
+        }
+    }
+
+    private static int baseDensity() {
+        try {
+            return WindowManagerGlobal.getWindowManagerService()
+                    .getBaseDisplayDensity(Display.DEFAULT_DISPLAY);
+        } catch (RemoteException e) {
+            return -1;
+        }
+    }
+}
