+
+package com.android.settings.sable;
+
+import android.content.Context;
+import android.provider.Settings;
+import android.util.Log;
+
+import androidx.preference.Preference;
+
+import com.android.settings.core.BasePreferenceController;
+
+/**
+ * Settings > Display > Lock screen size: Small, Default, Large or Larger, stored in
+ * Settings.Secure {@link SableSizes#LOCK_SETTING}. SystemUI reads it each time the lock screen or
+ * the PIN bouncer shows: it sizes the PIN keys and digits (up to what fits the screen) and the
+ * locked glance's text.
+ */
+public class SableLockScreenSizePreferenceController extends BasePreferenceController
+        implements Preference.OnPreferenceChangeListener {
+    private static final String TAG = "SableLockSizePref";
+
+    public SableLockScreenSizePreferenceController(Context context, String preferenceKey) {
+        super(context, preferenceKey);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return AVAILABLE;
+    }
+
+    @Override
+    public void updateState(Preference preference) {
+        super.updateState(preference);
+        if (!(preference instanceof SableSizeTilesPreference)) {
+            return;
+        }
+        SableSizeTilesPreference tiles = (SableSizeTilesPreference) preference;
+        tiles.setSelectedIndex(SableSizes.lockLevel(Settings.Secure.getInt(
+                mContext.getContentResolver(), SableSizes.LOCK_SETTING,
+                SableSizes.LOCK_DEFAULT_LEVEL)));
+        tiles.setSummary(tiles.getSelectedName());
+    }
+
+    @Override
+    public boolean onPreferenceChange(Preference preference, Object newValue) {
+        if (!(newValue instanceof Integer)) {
+            return false;
+        }
+        int level = (Integer) newValue;
+        if (level < 0 || level >= SableSizes.LOCK_LEVELS) {
+            return false;
+        }
+        boolean stored;
+        try {
+            stored = Settings.Secure.putInt(mContext.getContentResolver(),
+                    SableSizes.LOCK_SETTING, level);
+        } catch (SecurityException | IllegalArgumentException e) {
+            Log.w(TAG, "could not set the lock screen size", e);
+            stored = false;
+        }
+        if (stored && preference instanceof SableSizeTilesPreference) {
+            preference.setSummary(((SableSizeTilesPreference) preference).getNames()[level]);
+        }
+        return stored;
+    }
+}
diff --git a/src/com/android/settings/sable/SableSizeTilesPreference.java b/src/com/android/settings/sable/SableSizeTilesPreference.java
new file mode 100644
index 0000000..5ebe5c8
