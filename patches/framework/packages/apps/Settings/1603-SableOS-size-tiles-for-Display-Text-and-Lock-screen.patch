+ */
+
+package com.android.settings.sable;
+
+import android.content.Context;
+import android.content.res.ColorStateList;
+import android.content.res.TypedArray;
+import android.graphics.drawable.GradientDrawable;
+import android.util.AttributeSet;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.view.View;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+
+import androidx.preference.Preference;
+import androidx.preference.PreferenceViewHolder;
+
+import com.android.settings.R;
+
+/**
+ * A row of "A" tiles, small to large, for one size choice (BB10's size picker). Each tile can be
+ * focused with the trackpad or arrow keys and chosen with Enter, Space or a tap; the chosen tile is
+ * filled with the accent. The tile names come from {@code android:entries}; the change listener
+ * receives the chosen index as an Integer and the controller writes the setting.
+ */
+public class SableSizeTilesPreference extends Preference {
+    private CharSequence[] mNames = new CharSequence[0];
+    private int mSelected = -1;
+
+    public SableSizeTilesPreference(Context context, AttributeSet attrs) {
+        super(context, attrs);
+        setLayoutResource(R.layout.sable_size_tiles_preference);
+        setSelectable(false);
+        TypedArray a = context.obtainStyledAttributes(attrs, new int[] {android.R.attr.entries});
+        CharSequence[] names = a.getTextArray(0);
+        a.recycle();
+        if (names != null) {
+            mNames = names;
+        }
+    }
+
+    public CharSequence[] getNames() {
+        return mNames;
+    }
+
+    /** The chosen tile, or -1 for none (a custom value). */
+    public void setSelectedIndex(int index) {
+        if (mSelected != index) {
+            mSelected = index;
+            notifyChanged();
+        }
+    }
+
+    public int getSelectedIndex() {
+        return mSelected;
+    }
+
+    /** The name of the chosen tile, or null. */
+    public CharSequence getSelectedName() {
+        return mSelected >= 0 && mSelected < mNames.length ? mNames[mSelected] : null;
+    }
+
+    @Override
+    public void onBindViewHolder(PreferenceViewHolder holder) {
+        super.onBindViewHolder(holder);
+        holder.itemView.setFocusable(false);
+        holder.itemView.setClickable(false);
+        LinearLayout row = (LinearLayout) holder.findViewById(R.id.sable_size_tiles);
+        row.removeAllViews();
+        Context context = getContext();
+        float density = context.getResources().getDisplayMetrics().density;
+        int accent = color(context, android.R.attr.colorAccent);
+        int outline = color(context, android.R.attr.textColorSecondary);
+        int count = mNames.length;
+        for (int i = 0; i < count; i++) {
+            final int index = i;
+            boolean chosen = i == mSelected;
+            TextView tile = new TextView(context);
+            tile.setText(R.string.sable_size_tile_glyph);
+            tile.setGravity(Gravity.CENTER);
+            tile.setTextSize(TypedValue.COMPLEX_UNIT_SP, SableSizes.tileTextSp(i, count));
+            tile.setTextColor(chosen ? accent : outline);
+            tile.setIncludeFontPadding(false);
+            GradientDrawable shape = new GradientDrawable();
+            shape.setCornerRadius(8 * density);
+            shape.setStroke(Math.round((chosen ? 2 : 1) * density),
+                    ColorStateList.valueOf(chosen ? accent : outline));
+            shape.setColor((accent & 0x00FFFFFF) | (chosen ? 0x33000000 : 0));
+            tile.setBackground(shape);
+            tile.setFocusable(true);
+            tile.setClickable(true);
+            tile.setSelected(chosen);
+            tile.setContentDescription(chosen
+                    ? context.getString(R.string.sable_size_tile_chosen, mNames[i])
+                    : mNames[i]);
+            tile.setOnClickListener(v -> choose(index));
+            LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(
+                    0, Math.round(48 * density), 1f);
+            int margin = Math.round(3 * density);
+            lp.setMargins(margin, 0, margin, 0);
+            row.addView(tile, lp);
+        }
+    }
+
+    private void choose(int index) {
+        if (index != mSelected && callChangeListener(index)) {
+            setSelectedIndex(index);
+        }
+    }
+
+    private static int color(Context context, int attr) {
+        TypedArray a = context.obtainStyledAttributes(new int[] {attr});
+        int value = a.getColor(0, 0xFF888888);
+        a.recycle();
+        return value;
+    }
+}
diff --git a/src/com/android/settings/sable/SableSizes.java b/src/com/android/settings/sable/SableSizes.java
new file mode 100644
index 0000000..9d44e4b
--- /dev/null
+++ b/src/com/android/settings/sable/SableSizes.java
@@ -0,0 +1,84 @@
+/*
+ * Copyright (C) 2026 The SableOS Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.settings.sable;
+
+/**
+ * Sable's Display size and Lock screen size steps, shown as rows of "A" tiles. Pure Java.
+ *
+ * <p>Display size has five steps around the panel's own density (the Q25's 280, 411 dp square):
+ * Smaller, Small, Default, Large and Larger. Default clears any forced density, so `wm density`
+ * shows no override. Lock screen size has four levels, stored in Settings.Secure
+ * {@link #LOCK_SETTING} and read by SystemUI's keyguard (com.android.keyguard.sable.SableLockSize,
+ * which keeps the same scales).
+ */
+public final class SableSizes {
+    /** Density scales for Display size, smallest first; index 2 is the panel's own density. */
+    static final float[] DISPLAY_SCALES = {0.86f, 0.93f, 1.0f, 1.07f, 1.14f};
+
+    public static final int DISPLAY_DEFAULT_INDEX = 2;
+
+    /** Settings.Secure key for Lock screen size: 0 Small, 1 Default, 2 Large, 3 Larger. */
+    public static final String LOCK_SETTING = "sable_lock_screen_size";
+
+    public static final int LOCK_LEVELS = 4;
+
+    public static final int LOCK_DEFAULT_LEVEL = 1;
+
+    private SableSizes() {}
+
+    public static int displayStepCount() {
+        return DISPLAY_SCALES.length;
+    }
+
+    /** The density for a Display size step; out of range gives the panel's own density. */
+    public static int displayDensity(int initialDensity, int index) {
+        if (index < 0 || index >= DISPLAY_SCALES.length) {
+            return initialDensity;
+        }
+        return Math.round(initialDensity * DISPLAY_SCALES[index]);
+    }
+
+    /** The step for a density, or -1 when it is none of the five (set elsewhere: custom). */
+    public static int displayIndexOf(int initialDensity, int density) {
+        if (initialDensity <= 0 || density <= 0) {
+            return -1;
+        }
+        for (int i = 0; i < DISPLAY_SCALES.length; i++) {
+            if (Math.abs(displayDensity(initialDensity, i) - density) <= 1) {
+                return i;
+            }
+        }
+        return -1;
+    }
+
+    /** A stored Lock screen size, or Default when out of range. */
+    public static int lockLevel(int stored) {
+        return stored >= 0 && stored < LOCK_LEVELS ? stored : LOCK_DEFAULT_LEVEL;
+    }
+
+    /**
+     * Text size of the "A" on tile {@code index} of {@code count}, in sp: 12 sp for the first,
+     * up to 26 sp for the last, so the row reads as small to large.
+     */
+    public static float tileTextSp(int index, int count) {
+        if (count <= 1) {
+            return 18f;
+        }
+        int clamped = Math.max(0, Math.min(index, count - 1));
+        return 12f + 14f * clamped / (count - 1);
+    }
+}
diff --git a/src/com/android/settings/sable/SableTextSizePreferenceController.java b/src/com/android/settings/sable/SableTextSizePreferenceController.java
