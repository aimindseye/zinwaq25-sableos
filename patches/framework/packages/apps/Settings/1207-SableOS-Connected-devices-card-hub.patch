+<!-- Connected devices hub card: outlined card; focused (keyboard) gets the Sable focus ring,
+     an accent fill plus a 2dp accent border, as everywhere else in Settings. -->
+<selector xmlns:android="http://schemas.android.com/apk/res/android">
+    <item android:state_focused="true">
+        <shape android:shape="rectangle">
+            <corners android:radius="12dp" />
+            <solid android:color="@color/sable_hub_card_focus_fill" />
+            <stroke android:width="2dp" android:color="?android:attr/colorAccent" />
+        </shape>
+    </item>
+    <item android:state_pressed="true">
+        <shape android:shape="rectangle">
+            <corners android:radius="12dp" />
+            <solid android:color="@color/sable_hub_card_focus_fill" />
+            <stroke android:width="1dp" android:color="@color/sable_hub_card_outline" />
+        </shape>
+    </item>
+    <item>
+        <shape android:shape="rectangle">
+            <corners android:radius="12dp" />
+            <stroke android:width="1dp" android:color="@color/sable_hub_card_outline" />
+        </shape>
+    </item>
+</selector>
