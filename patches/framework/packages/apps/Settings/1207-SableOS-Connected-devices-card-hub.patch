+package com.android.settings.connecteddevice.sable;
+
+import android.app.settings.SettingsEnums;
+import android.bluetooth.BluetoothAdapter;
+import android.bluetooth.BluetoothDevice;
+import android.bluetooth.BluetoothManager;
+import android.content.ActivityNotFoundException;
+import android.content.Context;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.content.pm.PackageManager;
+import android.hardware.usb.UsbManager;
+import android.nfc.NfcAdapter;
+import android.os.Environment;
+import android.os.storage.StorageManager;
+import android.os.storage.StorageVolume;
+import android.provider.Settings;
+import android.util.Log;
+
+import androidx.preference.Preference;
+import androidx.preference.PreferenceScreen;
+
+import com.android.settings.R;
+import com.android.settings.applications.sable.model.ConnectedHubCards;
+import com.android.settings.connecteddevice.usb.UsbDetailsFragment;
+import com.android.settings.core.BasePreferenceController;
+import com.android.settings.core.SubSettingLauncher;
+import com.android.settings.wfd.WifiDisplaySettings;
+
+import java.util.Set;
+
+/**
+ * Fills the Connected devices card hub (CONNECTIVITY_OTG_NFC_CAST_COMPATIBILITY_UX section
+ * 1) from Android's own state each time the page resumes, and opens Android's pages: USB
+ * preferences (connected to a computer), Storage (USB drives, eject), Bluetooth, NFC and
+ * Cast. It changes nothing itself: every switch stays on its own page.
+ */
+public class SableConnectedHubPreferenceController extends BasePreferenceController
+        implements SableConnectedHubPreference.OnCardClickListener {
+    private static final String TAG = "SableConnectedHub";
+
+    private SableConnectedHubPreference mPreference;
+
+    public SableConnectedHubPreferenceController(Context context, String preferenceKey) {
+        super(context, preferenceKey);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return AVAILABLE_UNSEARCHABLE;
+    }
+
+    @Override
+    public void displayPreference(PreferenceScreen screen) {
+        super.displayPreference(screen);
+        mPreference = screen.findPreference(getPreferenceKey());
+        if (mPreference != null) {
+            mPreference.setOnCardClickListener(this);
+        }
+    }
+
+    @Override
+    public void updateState(Preference preference) {
+        super.updateState(preference);
+        if (!(preference instanceof SableConnectedHubPreference)) {
+            return;
+        }
+        final ConnectedHubCards.Facts facts = readFacts();
+        final SableConnectedHubPreference hub = (SableConnectedHubPreference) preference;
+        for (ConnectedHubCards.Card card : ConnectedHubCards.Card.values()) {
+            final ConnectedHubCards.Result r = ConnectedHubCards.evaluate(card, facts);
+            hub.setCard(r, statusText(r));
+        }
+    }
+
+    private CharSequence statusText(ConnectedHubCards.Result r) {
+        switch (r.status) {
+            case NOT_ON_PHONE:
+                return mContext.getString(R.string.sable_hub_not_on_phone);
+            case OFF:
+                return mContext.getString(R.string.sable_hub_off);
+            case CONNECTED:
+                return mContext.getResources().getQuantityString(R.plurals.sable_hub_connected,
+                        r.count, r.count);
+            case USB_COMPUTER:
+                return mContext.getString(R.string.sable_hub_usb_computer);
+            case USB_DRIVE:
+                return mContext.getResources().getQuantityString(R.plurals.sable_hub_usb_drive,
+                        r.count, r.count);
+            case USB_DEVICE:
+                return mContext.getString(R.string.sable_hub_usb_device);
+            case USB_NONE:
+                return mContext.getString(R.string.sable_hub_usb_none);
+            default:
+                return r.card == ConnectedHubCards.Card.CAST
+                        ? mContext.getString(R.string.sable_hub_cast_ready)
+                        : mContext.getString(R.string.sable_hub_on);
+        }
+    }
+
+    private ConnectedHubCards.Facts readFacts() {
+        final ConnectedHubCards.Facts f = new ConnectedHubCards.Facts();
+        final PackageManager pm = mContext.getPackageManager();
+        try {
+            final Intent usb = mContext.registerReceiver(null,
+                    new IntentFilter(UsbManager.ACTION_USB_STATE));
+            f.usbToComputer = usb != null && usb.getBooleanExtra(UsbManager.USB_CONNECTED, false);
+            final UsbManager um = mContext.getSystemService(UsbManager.class);
+            f.usbHostDevices = um == null || um.getDeviceList() == null ? 0
+                    : um.getDeviceList().size();
+        } catch (RuntimeException e) {
+            Log.w(TAG, "Cannot read USB state", e);
+        }
+        try {
+            final StorageManager sm = mContext.getSystemService(StorageManager.class);
+            if (sm != null) {
+                for (StorageVolume v : sm.getStorageVolumes()) {
+                    if (v.isRemovable() && !v.isPrimary()
+                            && Environment.MEDIA_MOUNTED.equals(v.getState())) {
+                        f.usbDrivesMounted++;
+                    }
+                }
+            }
+        } catch (RuntimeException e) {
+            Log.w(TAG, "Cannot read storage volumes", e);
+        }
+        f.bluetoothSupported = pm.hasSystemFeature(PackageManager.FEATURE_BLUETOOTH);
+        if (f.bluetoothSupported) {
+            try {
+                final BluetoothManager bm = mContext.getSystemService(BluetoothManager.class);
+                final BluetoothAdapter adapter = bm == null ? null : bm.getAdapter();
+                f.bluetoothOn = adapter != null && adapter.isEnabled();
+                if (f.bluetoothOn) {
+                    final Set<BluetoothDevice> bonded = adapter.getBondedDevices();
+                    if (bonded != null) {
+                        for (BluetoothDevice d : bonded) {
+                            if (d.isConnected()) {
+                                f.bluetoothConnected++;
+                            }
+                        }
+                    }
+                }
+            } catch (RuntimeException e) {
+                Log.w(TAG, "Cannot read Bluetooth state", e);
+            }
+        }
+        try {
+            final NfcAdapter nfc = NfcAdapter.getDefaultAdapter(mContext);
+            f.nfcSupported = nfc != null;
+            f.nfcOn = nfc != null && nfc.isEnabled();
+        } catch (RuntimeException e) {
+            Log.w(TAG, "Cannot read NFC state", e);
+        }
+        try {
+            f.castSupported = WifiDisplaySettings.isAvailable(mContext);
+        } catch (RuntimeException e) {
+            f.castSupported = false;
+        }
+        return f;
+    }
+
+    @Override
+    public void onCardClick(ConnectedHubCards.Result result) {
+        switch (result.target) {
+            case USB_PREFERENCES:
+                new SubSettingLauncher(uiContext())
+                        .setDestination(UsbDetailsFragment.class.getName())
+                        .setTitleRes(R.string.usb_preference)
+                        .setSourceMetricsCategory(
+                                SettingsEnums.SETTINGS_CONNECTED_DEVICE_CATEGORY)
+                        .launch();
+                return;
+            case STORAGE:
+                open(new Intent(Settings.ACTION_INTERNAL_STORAGE_SETTINGS));
+                return;
+            case BLUETOOTH:
+                open(new Intent(Settings.ACTION_BLUETOOTH_SETTINGS));
+                return;
+            case NFC:
+                open(new Intent(Settings.ACTION_NFC_SETTINGS));
+                return;
+            case CAST:
+                open(new Intent(Settings.ACTION_CAST_SETTINGS));
+                return;
+            default:
+                return;
+        }
+    }
+
+    /** The page's own context, so opened pages stack on Settings and Back returns here. */
+    private Context uiContext() {
+        return mPreference != null ? mPreference.getContext() : mContext;
+    }
+
+    private void open(Intent intent) {
+        try {
+            uiContext().startActivity(intent.setPackage(mContext.getPackageName()));
+        } catch (ActivityNotFoundException | SecurityException e) {
+            Log.w(TAG, "Cannot open " + intent, e);
+        }
+    }
+}
