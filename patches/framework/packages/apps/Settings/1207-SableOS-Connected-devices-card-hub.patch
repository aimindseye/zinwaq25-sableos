+package com.android.settings.applications.sable.model;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.Test;
+
+/** Connected devices card hub: status and target of each card. */
+public class ConnectedHubCardsTest {
+
+    private static ConnectedHubCards.Result eval(ConnectedHubCards.Card c,
+            ConnectedHubCards.Facts f) {
+        return ConnectedHubCards.evaluate(c, f);
+    }
+
+    @Test
+    public void usbPrefersAMountedDrive() {
+        final ConnectedHubCards.Facts f = new ConnectedHubCards.Facts();
+        assertEquals(ConnectedHubCards.Status.USB_NONE, eval(ConnectedHubCards.Card.USB, f).status);
+        f.usbHostDevices = 1;
+        assertEquals(ConnectedHubCards.Status.USB_DEVICE,
+                eval(ConnectedHubCards.Card.USB, f).status);
+        f.usbToComputer = true;
+        assertEquals(ConnectedHubCards.Target.USB_PREFERENCES,
+                eval(ConnectedHubCards.Card.USB, f).target);
+        f.usbDrivesMounted = 2;
+        final ConnectedHubCards.Result r = eval(ConnectedHubCards.Card.USB, f);
+        assertEquals(ConnectedHubCards.Status.USB_DRIVE, r.status);
+        assertEquals(2, r.count);
+        assertEquals(ConnectedHubCards.Target.STORAGE, r.target);
+    }
+
+    @Test
+    public void missingHardwareOpensNothing() {
+        final ConnectedHubCards.Facts f = new ConnectedHubCards.Facts();
+        for (ConnectedHubCards.Card c : new ConnectedHubCards.Card[] {
+                ConnectedHubCards.Card.BLUETOOTH, ConnectedHubCards.Card.NFC,
+                ConnectedHubCards.Card.CAST}) {
+            final ConnectedHubCards.Result r = eval(c, f);
+            assertEquals(ConnectedHubCards.Status.NOT_ON_PHONE, r.status);
+            assertFalse(r.opens());
+        }
+        assertTrue(eval(ConnectedHubCards.Card.USB, null).opens());
+    }
+
+    @Test
+    public void bluetoothAndNfcStates() {
+        final ConnectedHubCards.Facts f = new ConnectedHubCards.Facts();
+        f.bluetoothSupported = true;
+        f.nfcSupported = true;
+        f.castSupported = true;
+        assertEquals(ConnectedHubCards.Status.OFF,
+                eval(ConnectedHubCards.Card.BLUETOOTH, f).status);
+        f.bluetoothOn = true;
+        assertEquals(ConnectedHubCards.Status.ON,
+                eval(ConnectedHubCards.Card.BLUETOOTH, f).status);
+        f.bluetoothConnected = 1;
+        assertEquals(ConnectedHubCards.Status.CONNECTED,
+                eval(ConnectedHubCards.Card.BLUETOOTH, f).status);
+        assertEquals(ConnectedHubCards.Status.OFF, eval(ConnectedHubCards.Card.NFC, f).status);
+        f.nfcOn = true;
+        assertEquals(ConnectedHubCards.Target.NFC, eval(ConnectedHubCards.Card.NFC, f).target);
+        assertEquals(ConnectedHubCards.Target.CAST, eval(ConnectedHubCards.Card.CAST, f).target);
+    }
+}
