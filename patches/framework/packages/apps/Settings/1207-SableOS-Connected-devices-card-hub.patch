+
+package com.android.settings.applications.sable.model;
+
+/**
+ * The Connected devices card hub (CONNECTIVITY_OTG_NFC_CAST_COMPATIBILITY_UX section 1: USB /
+ * OTG, Bluetooth, NFC, Cast): what each card says and where it goes, from facts the Android
+ * layer reads. Hardware the phone lacks shows as such and opens nothing ("hardware gates");
+ * every action is explicit, nothing is exported or switched from the hub itself.
+ */
+public final class ConnectedHubCards {
+
+    /** The four cards, in focus order (two rows of two). */
+    public enum Card { USB, BLUETOOTH, NFC, CAST }
+
+    /** What a card shows. */
+    public enum Status {
+        /** The phone has no such hardware or service. */
+        NOT_ON_PHONE,
+        OFF,
+        /** On, nothing connected. */
+        ON,
+        /** On with {@link Result#count} devices connected. */
+        CONNECTED,
+        /** USB: connected to a computer (USB preferences apply). */
+        USB_COMPUTER,
+        /** USB: a drive is mounted (OTG). */
+        USB_DRIVE,
+        /** USB: a device such as a keyboard or mouse is attached (OTG). */
+        USB_DEVICE,
+        /** USB: nothing attached. */
+        USB_NONE
+    }
+
+    /** The page a card opens. */
+    public enum Target { NONE, USB_PREFERENCES, STORAGE, BLUETOOTH, NFC, CAST }
+
+    /** What the Android layer read. */
+    public static final class Facts {
+        public boolean usbToComputer;
+        public int usbDrivesMounted;
+        public int usbHostDevices;
+        public boolean bluetoothSupported;
+        public boolean bluetoothOn;
+        public int bluetoothConnected;
+        public boolean nfcSupported;
+        public boolean nfcOn;
+        public boolean castSupported;
+    }
+
+    /** One card's state. */
+    public static final class Result {
+        public final Card card;
+        public final Status status;
+        public final int count;
+        public final Target target;
+
+        Result(Card card, Status status, int count, Target target) {
+            this.card = card;
+            this.status = status;
+            this.count = count;
+            this.target = target;
+        }
+
+        /** Whether Enter does anything. */
+        public boolean opens() {
+            return target != Target.NONE;
+        }
+    }
+
+    private ConnectedHubCards() {}
+
+    public static Result evaluate(Card card, Facts f) {
+        final Facts facts = f == null ? new Facts() : f;
+        switch (card) {
+            case USB:
+                // A drive is what the user most likely came for (Files: copy, move, eject).
+                if (facts.usbDrivesMounted > 0) {
+                    return new Result(card, Status.USB_DRIVE, facts.usbDrivesMounted,
+                            Target.STORAGE);
+                }
+                if (facts.usbToComputer) {
+                    return new Result(card, Status.USB_COMPUTER, 0, Target.USB_PREFERENCES);
+                }
+                if (facts.usbHostDevices > 0) {
+                    return new Result(card, Status.USB_DEVICE, facts.usbHostDevices,
+                            Target.STORAGE);
+                }
+                return new Result(card, Status.USB_NONE, 0, Target.STORAGE);
+            case BLUETOOTH:
+                if (!facts.bluetoothSupported) {
+                    return new Result(card, Status.NOT_ON_PHONE, 0, Target.NONE);
+                }
+                if (!facts.bluetoothOn) {
+                    return new Result(card, Status.OFF, 0, Target.BLUETOOTH);
+                }
+                return facts.bluetoothConnected > 0
+                        ? new Result(card, Status.CONNECTED, facts.bluetoothConnected,
+                                Target.BLUETOOTH)
+                        : new Result(card, Status.ON, 0, Target.BLUETOOTH);
+            case NFC:
+                if (!facts.nfcSupported) {
+                    return new Result(card, Status.NOT_ON_PHONE, 0, Target.NONE);
+                }
+                return new Result(card, facts.nfcOn ? Status.ON : Status.OFF, 0, Target.NFC);
+            default:
+                return facts.castSupported
+                        ? new Result(card, Status.ON, 0, Target.CAST)
+                        : new Result(card, Status.NOT_ON_PHONE, 0, Target.NONE);
+        }
+    }
+}
