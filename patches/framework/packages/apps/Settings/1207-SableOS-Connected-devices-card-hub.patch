+package com.android.settings.connecteddevice.sable;
+
+import android.content.Context;
+import android.util.AttributeSet;
+import android.view.View;
+import android.widget.TextView;
+
+import androidx.preference.Preference;
+import androidx.preference.PreferenceViewHolder;
+
+import com.android.settings.R;
+import com.android.settings.applications.sable.model.ConnectedHubCards;
+
+import java.util.EnumMap;
+import java.util.Map;
+
+/**
+ * The Connected devices card hub row: four cards (USB / OTG, Bluetooth, NFC, Cast). The row
+ * itself is not a focus target; each card is, so arrows move between cards and Enter opens
+ * one. A card for hardware the phone lacks says so and is not focusable.
+ */
+public class SableConnectedHubPreference extends Preference {
+
+    /** Called when a card that opens something is activated. */
+    public interface OnCardClickListener {
+        void onCardClick(ConnectedHubCards.Result result);
+    }
+
+    private final Map<ConnectedHubCards.Card, ConnectedHubCards.Result> mResults =
+            new EnumMap<>(ConnectedHubCards.Card.class);
+    private final Map<ConnectedHubCards.Card, CharSequence> mStatus =
+            new EnumMap<>(ConnectedHubCards.Card.class);
+    private OnCardClickListener mListener;
+
+    public SableConnectedHubPreference(Context context, AttributeSet attrs) {
+        super(context, attrs);
+        setLayoutResource(R.layout.sable_connected_hub);
+        setSelectable(false);
+        setPersistent(false);
+    }
+
+    public SableConnectedHubPreference(Context context) {
+        this(context, null);
+    }
+
+    void setOnCardClickListener(OnCardClickListener listener) {
+        mListener = listener;
+    }
+
+    void setCard(ConnectedHubCards.Result result, CharSequence status) {
+        mResults.put(result.card, result);
+        mStatus.put(result.card, status);
+        notifyChanged();
+    }
+
+    @Override
+    public void onBindViewHolder(PreferenceViewHolder holder) {
+        super.onBindViewHolder(holder);
+        holder.itemView.setFocusable(false);
+        holder.itemView.setClickable(false);
+        bind(holder.findViewById(R.id.sable_hub_usb), ConnectedHubCards.Card.USB,
+                R.string.sable_hub_usb);
+        bind(holder.findViewById(R.id.sable_hub_bluetooth), ConnectedHubCards.Card.BLUETOOTH,
+                R.string.sable_hub_bluetooth);
+        bind(holder.findViewById(R.id.sable_hub_nfc), ConnectedHubCards.Card.NFC,
+                R.string.sable_hub_nfc);
+        bind(holder.findViewById(R.id.sable_hub_cast), ConnectedHubCards.Card.CAST,
+                R.string.sable_hub_cast);
+    }
+
+    private void bind(View card, ConnectedHubCards.Card which, int titleRes) {
+        if (card == null) {
+            return;
+        }
+        final CharSequence title = getContext().getText(titleRes);
+        final CharSequence status = mStatus.get(which);
+        final ConnectedHubCards.Result result = mResults.get(which);
+        ((TextView) card.findViewById(R.id.sable_hub_card_title)).setText(title);
+        ((TextView) card.findViewById(R.id.sable_hub_card_status)).setText(
+                status == null ? "" : status);
+        card.setContentDescription(getContext().getString(R.string.sable_hub_card_description,
+                title, status == null ? "" : status));
+        final boolean opens = result != null && result.opens();
+        card.setFocusable(opens);
+        card.setClickable(opens);
+        card.setAlpha(opens ? 1f : 0.6f);
+        card.setOnClickListener(opens ? v -> {
+            if (mListener != null) {
+                mListener.onCardClick(result);
+            }
+        } : null);
+    }
+}
