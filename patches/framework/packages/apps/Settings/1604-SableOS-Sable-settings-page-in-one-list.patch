+    <!-- Settings > Sable rows, after BlackBerry 10's settings list: a title and one-line summary. -->
+    <string name="sable_page_display_title">Display</string>
+    <string name="sable_page_display_summary">Display size, text size, lock screen size, accent</string>
+    <string name="sable_page_home_title">Home screen</string>
+    <string name="sable_page_home_summary">Home apps, quick bar, widgets</string>
+    <string name="sable_page_home_style_title">Home style</string>
