+package com.android.settings.sable;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Pure rules for Settings > Connected devices > Sable Audio (no android.* imports, unit-tested
+ * off the device). The int values are android.bluetooth.BluetoothCodecConfig's: codec types,
+ * sample rate and bit depth flags, and LDAC's quality in codec-specific value 1.
+ */
+public final class SableAudioCodecs {
+    public static final int SBC = 0;
+    public static final int AAC = 1;
+    public static final int APTX = 2;
+    public static final int APTX_HD = 3;
+    public static final int LDAC = 4;
+    public static final int LC3 = 5;
+    public static final int OPUS = 6;
+
+    /** Best first, as the picker lists them. */
+    public static final int[] CODEC_ORDER = {LDAC, OPUS, LC3, APTX_HD, APTX, AAC, SBC};
+    /** Sample rate flags, highest first. */
+    public static final int[] RATE_FLAGS = {32, 16, 8, 4, 2, 1};
+    /** Bit depth flags, highest first. */
+    public static final int[] BITS_FLAGS = {4, 2, 1};
+    /** LDAC quality values for codec-specific value 1, best first. */
+    public static final long[] LDAC_QUALITY = {1000L, 1001L, 1002L, 1003L};
+
+    private SableAudioCodecs() {
+    }
+
+    public static String codecName(int type) {
+        switch (type) {
+            case SBC: return "SBC";
+            case AAC: return "AAC";
+            case APTX: return "aptX";
+            case APTX_HD: return "aptX HD";
+            case LDAC: return "LDAC";
+            case LC3: return "LC3";
+            case OPUS: return "Opus";
+            default: return "?";
+        }
+    }
+
+    /** "44.1 kHz" for a sample rate flag, or "" for none. */
+    public static String rateLabel(int flag) {
+        switch (flag) {
+            case 1: return "44.1 kHz";
+            case 2: return "48 kHz";
+            case 4: return "88.2 kHz";
+            case 8: return "96 kHz";
+            case 16: return "176.4 kHz";
+            case 32: return "192 kHz";
+            default: return "";
+        }
+    }
+
+    /** "24-bit" for a bit depth flag, or "" for none. */
+    public static String bitsLabel(int flag) {
+        switch (flag) {
+            case 1: return "16-bit";
+            case 2: return "24-bit";
+            case 4: return "32-bit";
+            default: return "";
+        }
+    }
+
+    /** The flags of {@code order} that are set in {@code mask}, in that order. */
+    public static int[] flagsIn(int mask, int[] order) {
+        List<Integer> out = new ArrayList<>();
+        for (int flag : order) {
+            if ((mask & flag) != 0) {
+                out.add(flag);
+            }
+        }
+        int[] result = new int[out.size()];
+        for (int i = 0; i < result.length; i++) {
+            result[i] = out.get(i);
+        }
+        return result;
+    }
+
+    /** The highest flag of {@code order} set in {@code mask}, or 0. */
+    public static int highest(int mask, int[] order) {
+        int[] flags = flagsIn(mask, order);
+        return flags.length > 0 ? flags[0] : 0;
+    }
+
+    /** The codec types of {@code available}, best first, each once. */
+    public static int[] sortCodecs(int[] available) {
+        List<Integer> out = new ArrayList<>();
+        for (int type : CODEC_ORDER) {
+            for (int a : available) {
+                if (a == type && !out.contains(type)) {
+                    out.add(type);
+                }
+            }
+        }
+        int[] result = new int[out.size()];
+        for (int i = 0; i < result.length; i++) {
+            result[i] = out.get(i);
+        }
+        return result;
+    }
+
+    /** Index of the LDAC quality in {@link #LDAC_QUALITY}; anything unknown counts as best effort. */
+    public static int ldacIndex(long specific1) {
+        for (int i = 0; i < LDAC_QUALITY.length; i++) {
+            if (LDAC_QUALITY[i] == specific1) {
+                return i;
+            }
+        }
+        return LDAC_QUALITY.length - 1;
+    }
+}
