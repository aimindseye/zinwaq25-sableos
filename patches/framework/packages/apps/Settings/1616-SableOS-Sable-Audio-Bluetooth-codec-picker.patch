+package com.android.settings.sable;
+
+import android.app.Activity;
+import android.app.AlertDialog;
+import android.bluetooth.BluetoothA2dp;
+import android.bluetooth.BluetoothAdapter;
+import android.bluetooth.BluetoothCodecConfig;
+import android.bluetooth.BluetoothCodecStatus;
+import android.bluetooth.BluetoothDevice;
+import android.bluetooth.BluetoothManager;
+import android.bluetooth.BluetoothProfile;
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.os.Bundle;
+import android.os.SystemProperties;
+import android.util.TypedValue;
+import android.view.ViewGroup;
+import android.widget.LinearLayout;
+import android.widget.ScrollView;
+import android.widget.TextView;
+
+import com.android.settings.R;
+
+import java.util.List;
+
+/**
+ * Settings > Connected devices > Sable Audio (2.0 plan, "Bluetooth codec picker"): the codec,
+ * sample rate, bit depth and LDAC quality of the Bluetooth headphones playing now, HD audio for
+ * that device, and the hardware offload fallback. Only what the headphones and the phone both
+ * offer is listed. Every row works with the trackpad and Enter. Settings holds
+ * BLUETOOTH_PRIVILEGED, which these A2DP calls need.
+ */
+public class SableAudioActivity extends Activity {
+
+    static final String OFFLOAD_SUPPORTED = "ro.bluetooth.a2dp_offload.supported";
+    static final String OFFLOAD_DISABLED = "persist.bluetooth.a2dp_offload.disabled";
+
+    private BluetoothAdapter mAdapter;
+    private BluetoothA2dp mA2dp;
+    private LinearLayout mRows;
+
+    private final BluetoothProfile.ServiceListener mListener = new BluetoothProfile.ServiceListener() {
+        @Override
+        public void onServiceConnected(int profile, BluetoothProfile proxy) {
+            mA2dp = (BluetoothA2dp) proxy;
+            refresh();
+        }
+
+        @Override
+        public void onServiceDisconnected(int profile) {
+            mA2dp = null;
+            refresh();
+        }
+    };
+
+    private final BroadcastReceiver mChanged = new BroadcastReceiver() {
+        @Override
+        public void onReceive(Context context, Intent intent) {
+            refresh();
+        }
+    };
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        setTitle(R.string.sable_audio_title);
+        mRows = new LinearLayout(this);
+        mRows.setOrientation(LinearLayout.VERTICAL);
+        int pad = dp(16);
+        mRows.setPadding(0, pad / 2, 0, pad);
+        ScrollView scroll = new ScrollView(this);
+        scroll.addView(mRows);
+        setContentView(scroll);
+
+        BluetoothManager manager = getSystemService(BluetoothManager.class);
+        mAdapter = manager != null ? manager.getAdapter() : null;
+        if (mAdapter != null) {
+            mAdapter.getProfileProxy(this, mListener, BluetoothProfile.A2DP);
+        }
+        IntentFilter filter = new IntentFilter(BluetoothA2dp.ACTION_CODEC_CONFIG_CHANGED);
+        filter.addAction(BluetoothA2dp.ACTION_ACTIVE_DEVICE_CHANGED);
+        filter.addAction(BluetoothA2dp.ACTION_CONNECTION_STATE_CHANGED);
+        registerReceiver(mChanged, filter, Context.RECEIVER_EXPORTED);
+        refresh();
+    }
+
+    @Override
+    protected void onDestroy() {
+        unregisterReceiver(mChanged);
+        if (mAdapter != null && mA2dp != null) {
+            mAdapter.closeProfileProxy(BluetoothProfile.A2DP, mA2dp);
+        }
+        super.onDestroy();
+    }
+
+    private BluetoothDevice activeDevice() {
+        if (mAdapter == null || mA2dp == null) return null;
+        List<BluetoothDevice> active = mAdapter.getActiveDevices(BluetoothProfile.A2DP);
+        return active.isEmpty() ? null : active.get(0);
+    }
+
+    private void refresh() {
+        mRows.removeAllViews();
+        BluetoothDevice device = activeDevice();
+        BluetoothCodecStatus status = device != null ? mA2dp.getCodecStatus(device) : null;
+        BluetoothCodecConfig current = status != null ? status.getCodecConfig() : null;
+        if (device == null || current == null) {
+            row(getString(R.string.sable_audio_no_device), null, null);
+        } else {
+            String name = device.getAlias();
+            row(getString(R.string.sable_audio_device), name != null ? name : device.getAddress(),
+                    null);
+            addHdRow(device);
+            addCodecRows(device, status, current);
+        }
+        addOffloadRow();
+        TextView hint = new TextView(this);
+        hint.setText(R.string.sable_audio_hint);
+        hint.setTextSize(TypedValue.COMPLEX_UNIT_SP, 13);
+        hint.setPadding(dp(16), dp(12), dp(16), 0);
+        mRows.addView(hint);
+    }
+
+    private void addHdRow(BluetoothDevice device) {
+        if (mA2dp.isOptionalCodecsSupported(device) != BluetoothA2dp.OPTIONAL_CODECS_SUPPORTED) {
+            return;
+        }
+        final boolean on = mA2dp.isOptionalCodecsEnabled(device)
+                == BluetoothA2dp.OPTIONAL_CODECS_PREF_ENABLED;
+        row(getString(R.string.sable_audio_hd),
+                getString(on ? R.string.sable_audio_on : R.string.sable_audio_off), () -> {
+                    mA2dp.setOptionalCodecsEnabled(device, on
+                            ? BluetoothA2dp.OPTIONAL_CODECS_PREF_DISABLED
+                            : BluetoothA2dp.OPTIONAL_CODECS_PREF_ENABLED);
+                    if (on) {
+                        mA2dp.disableOptionalCodecs(device);
+                    } else {
+                        mA2dp.enableOptionalCodecs(device);
+                    }
+                    mRows.postDelayed(this::refresh, 500);
+                });
+    }
+
+    private void addCodecRows(BluetoothDevice device, BluetoothCodecStatus status,
+            BluetoothCodecConfig current) {
+        final List<BluetoothCodecConfig> selectable = status.getCodecsSelectableCapabilities();
+        int[] types = new int[selectable.size()];
+        for (int i = 0; i < types.length; i++) types[i] = selectable.get(i).getCodecType();
+        final int[] codecs = SableAudioCodecs.sortCodecs(types);
+        String[] names = new String[codecs.length];
+        int checked = -1;
+        for (int i = 0; i < codecs.length; i++) {
+            names[i] = SableAudioCodecs.codecName(codecs[i]);
+            if (codecs[i] == current.getCodecType()) checked = i;
+        }
+        final int codecChecked = checked;
+        row(getString(R.string.sable_audio_codec),
+                SableAudioCodecs.codecName(current.getCodecType()),
+                () -> choose(R.string.sable_audio_codec, names, codecChecked, which -> {
+                    BluetoothCodecConfig picked = capsFor(selectable, codecs[which]);
+                    if (picked == null) return;
+                    apply(device, codecs[which],
+                            SableAudioCodecs.highest(picked.getSampleRate(),
+                                    SableAudioCodecs.RATE_FLAGS),
+                            SableAudioCodecs.highest(picked.getBitsPerSample(),
+                                    SableAudioCodecs.BITS_FLAGS),
+                            codecs[which] == SableAudioCodecs.LDAC
+                                    ? current.getCodecSpecific1() : 0L, picked.getChannelMode());
+                }));
+
+        final BluetoothCodecConfig caps = capsFor(selectable, current.getCodecType());
+        if (caps == null) return;
+        final int[] rates = SableAudioCodecs.flagsIn(caps.getSampleRate(),
+                SableAudioCodecs.RATE_FLAGS);
+        if (rates.length > 1) {
+            String[] labels = new String[rates.length];
+            int at = -1;
+            for (int i = 0; i < rates.length; i++) {
+                labels[i] = SableAudioCodecs.rateLabel(rates[i]);
+                if (rates[i] == current.getSampleRate()) at = i;
+            }
+            final int rateChecked = at;
+            row(getString(R.string.sable_audio_rate),
+                    SableAudioCodecs.rateLabel(current.getSampleRate()),
+                    () -> choose(R.string.sable_audio_rate, labels, rateChecked, which ->
+                            apply(device, current.getCodecType(), rates[which],
+                                    current.getBitsPerSample(), current.getCodecSpecific1(),
+                                    current.getChannelMode())));
+        }
+        final int[] bits = SableAudioCodecs.flagsIn(caps.getBitsPerSample(),
+                SableAudioCodecs.BITS_FLAGS);
+        if (bits.length > 1) {
+            String[] labels = new String[bits.length];
+            int at = -1;
+            for (int i = 0; i < bits.length; i++) {
+                labels[i] = SableAudioCodecs.bitsLabel(bits[i]);
+                if (bits[i] == current.getBitsPerSample()) at = i;
+            }
+            final int bitsChecked = at;
+            row(getString(R.string.sable_audio_bits),
+                    SableAudioCodecs.bitsLabel(current.getBitsPerSample()),
+                    () -> choose(R.string.sable_audio_bits, labels, bitsChecked, which ->
+                            apply(device, current.getCodecType(), current.getSampleRate(),
+                                    bits[which], current.getCodecSpecific1(),
+                                    current.getChannelMode())));
+        }
+        if (current.getCodecType() == SableAudioCodecs.LDAC) {
+            final String[] labels = {
+                    getString(R.string.sable_audio_ldac_high),
+                    getString(R.string.sable_audio_ldac_normal),
+                    getString(R.string.sable_audio_ldac_low),
+                    getString(R.string.sable_audio_ldac_adaptive)};
+            final int at = SableAudioCodecs.ldacIndex(current.getCodecSpecific1());
+            row(getString(R.string.sable_audio_ldac), labels[at],
+                    () -> choose(R.string.sable_audio_ldac, labels, at, which ->
+                            apply(device, current.getCodecType(), current.getSampleRate(),
+                                    current.getBitsPerSample(),
+                                    SableAudioCodecs.LDAC_QUALITY[which],
+                                    current.getChannelMode())));
+        }
+    }
+
+    private static BluetoothCodecConfig capsFor(List<BluetoothCodecConfig> selectable, int type) {
+        for (BluetoothCodecConfig c : selectable) {
+            if (c.getCodecType() == type) return c;
+        }
+        return null;
+    }
+
+    private void apply(BluetoothDevice device, int type, int rate, int bits, long specific1,
+            int channelModes) {
+        int channel = (channelModes & BluetoothCodecConfig.CHANNEL_MODE_STEREO) != 0
+                ? BluetoothCodecConfig.CHANNEL_MODE_STEREO
+                : BluetoothCodecConfig.CHANNEL_MODE_MONO;
+        BluetoothCodecConfig config = new BluetoothCodecConfig.Builder()
+                .setCodecType(type)
+                .setCodecPriority(BluetoothCodecConfig.CODEC_PRIORITY_HIGHEST)
+                .setSampleRate(rate)
+                .setBitsPerSample(bits)
+                .setChannelMode(channel)
+                .setCodecSpecific1(specific1)
+                .build();
+        mA2dp.setCodecConfigPreference(device, config);
+        mRows.postDelayed(this::refresh, 500);
+    }
+
+    private void addOffloadRow() {
+        if (!SystemProperties.getBoolean(OFFLOAD_SUPPORTED, false)) return;
+        final boolean disabled = SystemProperties.getBoolean(OFFLOAD_DISABLED, false);
+        row(getString(R.string.sable_audio_offload),
+                getString(disabled ? R.string.sable_audio_offload_off
+                        : R.string.sable_audio_offload_on), () -> {
+                    SystemProperties.set(OFFLOAD_DISABLED, Boolean.toString(!disabled));
+                    refresh();
+                });
+    }
+
+    private interface Pick {
+        void picked(int which);
+    }
+
+    private void choose(int title, String[] items, int checked, Pick pick) {
+        new AlertDialog.Builder(this)
+                .setTitle(title)
+                .setSingleChoiceItems(items, checked, (dialog, which) -> {
+                    dialog.dismiss();
+                    pick.picked(which);
+                })
+                .setNegativeButton(android.R.string.cancel, null)
+                .show();
+    }
+
+    private void row(String title, String summary, Runnable action) {
+        LinearLayout row = new LinearLayout(this);
+        row.setOrientation(LinearLayout.VERTICAL);
+        row.setPadding(dp(16), dp(10), dp(16), dp(10));
+        TextView t = new TextView(this);
+        t.setText(title);
+        t.setTextSize(TypedValue.COMPLEX_UNIT_SP, 17);
+        row.addView(t);
+        if (summary != null) {
+            TextView s = new TextView(this);
+            s.setText(summary);
+            s.setTextSize(TypedValue.COMPLEX_UNIT_SP, 14);
+            s.setAlpha(0.7f);
+            row.addView(s);
+        }
+        if (action != null) {
+            TypedValue bg = new TypedValue();
+            getTheme().resolveAttribute(android.R.attr.selectableItemBackground, bg, true);
+            row.setBackgroundResource(bg.resourceId);
+            row.setFocusable(true);
+            row.setClickable(true);
+            row.setOnClickListener(v -> action.run());
+        }
+        mRows.addView(row, new LinearLayout.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+    }
+
+    private int dp(int v) {
+        return Math.round(v * getResources().getDisplayMetrics().density);
+    }
+}
