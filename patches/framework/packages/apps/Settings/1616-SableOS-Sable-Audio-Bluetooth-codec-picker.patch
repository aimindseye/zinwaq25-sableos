+<resources>
+    <!-- SableOS Settings > Connected devices > Sable Audio: Bluetooth codec choices for the connected headphones. -->
+    <string name="sable_audio_title">Sable Audio</string>
+    <!-- Summary of the Sable Audio row in Connected devices. -->
+    <string name="sable_audio_summary">Bluetooth codec, sample rate and quality</string>
+    <!-- Search keywords for Sable Audio. -->
+    <string name="keywords_sable_audio">bluetooth, codec, ldac, aac, opus, lc3, sample rate, bit depth, audio quality, hd audio, offload</string>
+    <!-- Shown when no Bluetooth headphones or speaker is playing. -->
+    <string name="sable_audio_no_device">Connect Bluetooth headphones or a speaker to choose its codec.</string>
+    <!-- Row: the Bluetooth device the choices apply to. -->
+    <string name="sable_audio_device">Headphones</string>
+    <!-- Row: HD audio (the codecs beyond SBC) for this device. -->
+    <string name="sable_audio_hd">HD audio</string>
+    <!-- Row: the codec in use. -->
+    <string name="sable_audio_codec">Codec</string>
+    <!-- Row: the sample rate in use. -->
+    <string name="sable_audio_rate">Sample rate</string>
+    <!-- Row: the bit depth in use. -->
+    <string name="sable_audio_bits">Bit depth</string>
+    <!-- Row: LDAC's playback quality. -->
+    <string name="sable_audio_ldac">LDAC quality</string>
+    <!-- LDAC quality choices, in the order of SableAudioCodecs.LDAC_QUALITY. -->
+    <string name="sable_audio_ldac_high">Best audio (990 kbps)</string>
+    <string name="sable_audio_ldac_normal">Balanced (660 kbps)</string>
+    <string name="sable_audio_ldac_low">Best connection (330 kbps)</string>
+    <string name="sable_audio_ldac_adaptive">Adaptive</string>
+    <!-- Row: turn Bluetooth audio hardware offload off when audio stutters; needs a restart. -->
+    <string name="sable_audio_offload">Hardware offload</string>
+    <!-- Summary when offload is on. -->
+    <string name="sable_audio_offload_on">On. Turn off if Bluetooth audio stutters</string>
+    <!-- Summary when offload is off. -->
+    <string name="sable_audio_offload_off">Off. Restart the phone after changing this</string>
+    <!-- On / Off states. -->
+    <string name="sable_audio_on">On</string>
+    <string name="sable_audio_off">Off</string>
+    <!-- Hint line at the bottom of Sable Audio. -->
+    <string name="sable_audio_hint">Enter changes a row. The headphones must support a codec for it to be offered.</string>
+</resources>
