+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.settings.fuelgauge.sable.model;
+
+import java.time.Instant;
+import java.time.LocalDate;
+import java.time.Period;
+import java.time.ZoneId;
+
+/** Maps {@link HealthFact}s to {@link FactText}s and summarizes a {@link HealthReport}. */
+public final class HealthFactPresenter {
+    private HealthFactPresenter() {}
+
+    /**
+     * Text for one fact. {@code shutdownDeciC} is the platform's battery shutdown temperature
+     * (0 if unknown); {@code zone} and {@code nowMillis} are used for date rows.
+     */
+    public static FactText present(HealthFact f, int shutdownDeciC, ZoneId zone,
+            long nowMillis) {
+        if (!f.isAvailable()) {
+            switch (f.reason()) {
+                case UNSUPPORTED:
+                    return new FactText(FactText.Template.NOT_SUPPORTED, null, null);
+                case NOT_QUALIFIED:
+                    return new FactText(FactText.Template.NOT_QUALIFIED, null, null);
+                case IMPLAUSIBLE:
+                    return new FactText(FactText.Template.IMPLAUSIBLE, null, null);
+                default:
+                    return new FactText(FactText.Template.NOT_REPORTED, null, null);
+            }
+        }
+        final FactSource s = f.source();
+        final FactConfidence c = f.confidence();
+        switch (f.kind()) {
+            case MAXIMUM_CAPACITY:
+            case DESIGN_CAPACITY:
+            case CHARGE_COUNTER:
+                return new FactText(FactText.Template.CAPACITY_MAH, s, c,
+                        CapacityMath.uahToMah(f.value()));
+            case CAPACITY_HEALTH:
+                return new FactText(FactText.Template.CAPACITY_PERCENT, s, c, f.value());
+            case CYCLE_COUNT:
+                return new FactText(FactText.Template.CYCLES, s, c, f.value());
+            case TEMPERATURE:
+                return new FactText(FactText.Template.TEMPERATURE, s, c, f.value(),
+                        TemperatureClass.classify(f.value(), shutdownDeciC).ordinal());
+            case HEALTH_STATUS:
+                return new FactText(FactText.Template.HEALTH_STATUS, s, c, f.value());
+            case MANUFACTURING_DATE: {
+                final LocalDate d = toDate(f.value(), zone);
+                return new FactText(FactText.Template.MONTH_YEAR, s, c, d.getYear(),
+                        d.getMonthValue());
+            }
+            case FIRST_USE_DATE: {
+                final LocalDate d = toDate(f.value(), zone);
+                final LocalDate now = toDate(nowMillis / 1000L, zone);
+                final Period age = coarseAge(d, now);
+                return new FactText(FactText.Template.MONTH_YEAR_WITH_AGE, s, c, d.getYear(),
+                        d.getMonthValue(), age.getYears(), age.getMonths());
+            }
+            default:
+                return new FactText(FactText.Template.NOT_REPORTED, null, null);
+        }
+    }
+
+    /**
+     * Whole years and months between two trusted dates, never negative. Month precision only:
+     * the design forbids a precise battery age.
+     */
+    public static Period coarseAge(LocalDate from, LocalDate to) {
+        if (to.isBefore(from)) {
+            return Period.ZERO;
+        }
+        final Period p = Period.between(from.withDayOfMonth(1), to.withDayOfMonth(1));
+        return Period.of(p.getYears(), p.getMonths(), 0);
+    }
+
+    private static LocalDate toDate(long epochSec, ZoneId zone) {
+        return Instant.ofEpochSecond(epochSec).atZone(zone).toLocalDate();
+    }
+
+    /** Summary line for the Battery overview "Battery health" row. */
+    public enum OverviewSummary {
+        /** args: percent. "Maximum capacity N%". */
+        CAPACITY_PERCENT,
+        /** "Partial data · temperature available". */
+        PARTIAL_TEMPERATURE,
+        /** "Partial data". */
+        PARTIAL,
+        /** "Not reported by this device". */
+        NONE
+    }
+
+    public static OverviewSummary overview(HealthReport report) {
+        if (report.fact(FactKind.CAPACITY_HEALTH).isAvailable()) {
+            return OverviewSummary.CAPACITY_PERCENT;
+        }
+        switch (report.coverage()) {
+            case NONE:
+                return OverviewSummary.NONE;
+            default:
+                return report.fact(FactKind.TEMPERATURE).isAvailable()
+                        ? OverviewSummary.PARTIAL_TEMPERATURE : OverviewSummary.PARTIAL;
+        }
+    }
+}
