+package com.android.settings.fuelgauge.sable.model;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+
+/**
+ * Top system consumers for the Battery overview "Battery usage" row, built from Android's own
+ * BatteryUsageStats (no Sable profiler). All shares use one denominator: the device-wide
+ * consumed power of the same accounting window. Different windows can't be mixed because a
+ * summary is built from exactly one window.
+ */
+public final class UsageSummary {
+    /** One power component of the device-wide aggregate consumer. */
+    public static final class Component {
+        public final int componentId;
+        public final double consumedPower;
+
+        public Component(int componentId, double consumedPower) {
+            this.componentId = componentId;
+            this.consumedPower = consumedPower;
+        }
+    }
+
+    /** One rendered share. */
+    public static final class Share {
+        public final int componentId;
+        public final int percent;
+
+        Share(int componentId, int percent) {
+            this.componentId = componentId;
+            this.percent = percent;
+        }
+
+        @Override
+        public String toString() {
+            return componentId + ":" + percent + "%";
+        }
+    }
+
+    public final long windowStartMillis;
+    public final long windowEndMillis;
+    public final List<Share> shares;
+
+    private UsageSummary(long start, long end, List<Share> shares) {
+        windowStartMillis = start;
+        windowEndMillis = end;
+        this.shares = Collections.unmodifiableList(shares);
+    }
+
+    /**
+     * Builds the summary, or returns null when the window or the total is unusable (the row
+     * then keeps Android's default summary instead of showing invented numbers).
+     *
+     * @param totalPower device-wide consumed power for the window (the denominator)
+     * @param max maximum number of shares, e.g. 2
+     * @param minPercent shares below this whole percent are dropped
+     */
+    public static UsageSummary build(long windowStartMillis, long windowEndMillis,
+            double totalPower, List<Component> components, int max, int minPercent) {
+        if (windowStartMillis <= 0 || windowEndMillis <= windowStartMillis
+                || !(totalPower > 0) || Double.isInfinite(totalPower)) {
+            return null;
+        }
+        final List<Component> sorted = new ArrayList<>();
+        for (Component c : components) {
+            if (c.consumedPower > 0 && !Double.isNaN(c.consumedPower)
+                    && !Double.isInfinite(c.consumedPower)) {
+                sorted.add(c);
+            }
+        }
+        sorted.sort((a, b) -> {
+            final int byPower = Double.compare(b.consumedPower, a.consumedPower);
+            return byPower != 0 ? byPower : Integer.compare(a.componentId, b.componentId);
+        });
+        final List<Share> out = new ArrayList<>();
+        for (Component c : sorted) {
+            if (out.size() >= max) {
+                break;
+            }
+            final double ratio = Math.min(1.0, c.consumedPower / totalPower);
+            final int pct = (int) Math.round(ratio * 100.0);
+            if (pct >= minPercent) {
+                out.add(new Share(c.componentId, pct));
+            }
+        }
+        return new UsageSummary(windowStartMillis, windowEndMillis, out);
+    }
+}
