+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.settings.fuelgauge.sable.model;
+
+/**
+ * Deterministic list focus targets for MoveHome / MoveEnd / PageUp / PageDown (Up/Down are left
+ * to the platform's focus search). Works on a focusability mask in adapter order.
+ */
+public final class ListFocusNavigator {
+    private ListFocusNavigator() {}
+
+    /** Target index for {@code key}, or -1 when the key is not handled or nothing is focusable. */
+    public static int target(NavKey key, boolean[] focusable, int current, int pageSize) {
+        final int n = focusable.length;
+        final int page = Math.max(1, pageSize);
+        switch (key) {
+            case MOVE_HOME:
+                return firstFrom(focusable, 0, 1);
+            case MOVE_END:
+                return firstFrom(focusable, n - 1, -1);
+            case PAGE_DOWN: {
+                if (current < 0) {
+                    return firstFrom(focusable, 0, 1);
+                }
+                final int t = firstFrom(focusable, Math.min(n - 1, current + page), -1);
+                // Never move backwards on PageDown; fall forward if needed.
+                if (t > current) {
+                    return t;
+                }
+                final int next = firstFrom(focusable, Math.min(n - 1, current + 1), 1);
+                return next > current ? next : -1;
+            }
+            case PAGE_UP: {
+                if (current < 0) {
+                    return firstFrom(focusable, n - 1, -1);
+                }
+                final int t = firstFrom(focusable, Math.max(0, current - page), 1);
+                if (t >= 0 && t < current) {
+                    return t;
+                }
+                final int prev = firstFrom(focusable, Math.max(0, current - 1), -1);
+                return prev >= 0 && prev < current ? prev : -1;
+            }
+            default:
+                return -1;
+        }
+    }
+
+    private static int firstFrom(boolean[] focusable, int start, int step) {
+        for (int i = start; i >= 0 && i < focusable.length; i += step) {
+            if (focusable[i]) {
+                return i;
+            }
+        }
+        return -1;
+    }
+}
