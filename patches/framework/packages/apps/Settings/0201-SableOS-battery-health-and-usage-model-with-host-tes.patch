diff --git a/src/com/android/settings/fuelgauge/sable/model/SegmentedRangeGroup.java b/src/com/android/settings/fuelgauge/sable/model/SegmentedRangeGroup.java
new file mode 100644
index 0000000..06b5d8d
--- /dev/null
+++ b/src/com/android/settings/fuelgauge/sable/model/SegmentedRangeGroup.java
@@ -0,0 +1,154 @@
+/*
+ * Copyright (C) 2026 The SableOS Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
