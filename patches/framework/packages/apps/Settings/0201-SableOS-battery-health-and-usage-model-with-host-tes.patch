+package com.android.settings.fuelgauge.sable.model;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * SableBatteryProfile (BATTERY_HEALTH_USAGE_UX section 16): what one device profile has proven
+ * about its battery. Loaded from data, never from device-model branches in code. Every key
+ * defaults to {@link Capability#UNKNOWN}; profiles never inherit another device's evidence.
+ */
+public final class BatteryCapabilityProfile {
+    public static final String KEY_HEALTH_CAPACITY = "health_capacity_supported";
+    public static final String KEY_HEALTH_CYCLE_COUNT = "health_cycle_count_supported";
+    public static final String KEY_HEALTH_TEMPERATURE = "health_temperature_supported";
+    public static final String KEY_HEALTH_STATUS = "health_status_supported";
+    public static final String KEY_HEALTH_CHARGE_COUNTER = "health_charge_counter_supported";
+    public static final String KEY_HEALTH_MANUFACTURING_DATE =
+            "health_manufacturing_date_supported";
+    public static final String KEY_HEALTH_FIRST_USE_DATE = "health_first_use_date_supported";
+    public static final String KEY_USAGE_PLATFORM_ACCOUNTING =
+            "usage_platform_accounting_supported";
+    public static final String KEY_CHARGE_LIMIT = "charge_limit_supported";
+    public static final String KEY_CHARGE_LIMIT_VALUES = "charge_limit_values";
+    public static final String KEY_ADAPTIVE_CHARGING = "adaptive_charging_supported";
+    public static final String KEY_SCHEDULED_CHARGING = "scheduled_charging_supported";
+    public static final String KEY_THERMAL_PROTECTION_STATUS =
+            "thermal_protection_status_supported";
+    public static final String KEY_BACKEND_PROVENANCE = "backend_provenance";
+    public static final String KEY_MUTABLE_BACKEND_QUALIFIED = "mutable_backend_qualified";
+    public static final String KEY_SPEC_DESIGN_CAPACITY_MAH = "spec_design_capacity_mah";
+    public static final String KEY_PROFILE_ID = "profile_id";
+    public static final String KEY_SCHEMA = "schema";
+    public static final String KEY_EVIDENCE = "evidence";
+
+    /** Every tri-state capability key of the schema. */
+    public static final List<String> CAPABILITY_KEYS = Collections.unmodifiableList(
+            java.util.Arrays.asList(KEY_HEALTH_CAPACITY, KEY_HEALTH_CYCLE_COUNT,
+                    KEY_HEALTH_TEMPERATURE, KEY_HEALTH_STATUS, KEY_HEALTH_CHARGE_COUNTER,
+                    KEY_HEALTH_MANUFACTURING_DATE, KEY_HEALTH_FIRST_USE_DATE,
+                    KEY_USAGE_PLATFORM_ACCOUNTING, KEY_CHARGE_LIMIT, KEY_ADAPTIVE_CHARGING,
+                    KEY_SCHEDULED_CHARGING, KEY_THERMAL_PROTECTION_STATUS));
+
+    /** The only schema version this code understands. */
+    public static final int SCHEMA_VERSION = 1;
+
+    /** No profile: everything unknown, nothing qualified. */
+    public static final BatteryCapabilityProfile EMPTY =
+            new BatteryCapabilityProfile("", new HashMap<>(), Collections.emptyList(), "NONE",
+                    false, 0, Collections.emptyList());
+
+    private final String mProfileId;
+    private final Map<String, Capability> mCapabilities;
+    private final List<Integer> mChargeLimitValues;
+    private final String mBackendProvenance;
+    private final boolean mMutableBackendQualified;
+    private final int mSpecDesignCapacityMah;
+    private final List<String> mWarnings;
+
+    BatteryCapabilityProfile(String profileId, Map<String, Capability> capabilities,
+            List<Integer> chargeLimitValues, String backendProvenance,
+            boolean mutableBackendQualified, int specDesignCapacityMah, List<String> warnings) {
+        mProfileId = profileId;
+        mCapabilities = Collections.unmodifiableMap(new HashMap<>(capabilities));
+        mChargeLimitValues = Collections.unmodifiableList(new ArrayList<>(chargeLimitValues));
+        mBackendProvenance = backendProvenance;
+        mMutableBackendQualified = mutableBackendQualified;
+        mSpecDesignCapacityMah = specDesignCapacityMah;
+        mWarnings = Collections.unmodifiableList(new ArrayList<>(warnings));
+    }
+
+    public String profileId() {
+        return mProfileId;
+    }
+
+    /** The capability for a schema key; UNKNOWN for keys the profile does not set. */
+    public Capability capability(String key) {
+        final Capability c = mCapabilities.get(key);
+        return c == null ? Capability.UNKNOWN : c;
+    }
+
+    /** Charge-limit percentages the backend supports; empty unless proven. */
+    public List<Integer> chargeLimitValues() {
+        return mChargeLimitValues;
+    }
+
+    /** Free-text provenance of a charging backend, NONE when there is none. */
+    public String backendProvenance() {
+        return mBackendProvenance;
+    }
+
+    /** True only when a profile explicitly records a qualified mutable backend. */
+    public boolean mutableBackendQualified() {
+        return mMutableBackendQualified;
+    }
+
+    /**
+     * Rated capacity from the vendor specification in mAh, or 0. Documentation and a sanity
+     * reference only: it is never shown as a measured value.
+     */
+    public int specDesignCapacityMah() {
+        return mSpecDesignCapacityMah;
+    }
+
+    /** Parse problems; each one made the affected key fall back to its fail-closed default. */
+    public List<String> warnings() {
+        return mWarnings;
+    }
+
+    public boolean isEmpty() {
+        return mProfileId.isEmpty();
+    }
+}
