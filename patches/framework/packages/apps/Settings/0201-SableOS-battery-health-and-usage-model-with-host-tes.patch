+/** Why a battery health fact is unavailable. Every reason renders as an honest "not shown" row. */
+public enum UnavailableReason {
+    /** The fact is available; no reason. */
+    NONE,
+    /** Android did not report the value (missing, sentinel or zero where zero means unknown). */
+    NOT_REPORTED,
+    /** The device profile records that this device does not provide the fact. */
+    UNSUPPORTED,
+    /**
