+
+package com.android.settings.fuelgauge.sable.model;
+
+import java.util.Objects;
+
+/** One locally retained battery sample: no app or user data, only battery state. */
+public final class HistorySample {
+    /** Temperature marker for "not reported". */
+    public static final int NO_TEMPERATURE = Integer.MIN_VALUE;
+    /** Level marker for "not reported". */
+    public static final int NO_LEVEL = -1;
+
+    public final long timeMillis;
+    public final int levelPercent;
+    public final int temperatureDeciC;
+    public final boolean charging;
+
+    public HistorySample(long timeMillis, int levelPercent, int temperatureDeciC,
+            boolean charging) {
+        this.timeMillis = timeMillis;
+        this.levelPercent = (levelPercent >= 0 && levelPercent <= 100) ? levelPercent : NO_LEVEL;
+        this.temperatureDeciC = temperatureDeciC;
+        this.charging = charging;
+    }
+
+    /**
+     * Sample from a readings snapshot. Only facts the evaluator allowed are retained: the
+     * temperature is stored only when the TEMPERATURE fact is available.
+     */
+    public static HistorySample from(BatteryReadings r, HealthReport report) {
+        final HealthFact t = report.fact(FactKind.TEMPERATURE);
+        final int level = r.levelPercent == BatteryReadings.MISSING ? NO_LEVEL
+                : (int) r.levelPercent;
+        return new HistorySample(r.sampleTimeMillis, level,
+                t.isAvailable() ? (int) t.value() : NO_TEMPERATURE, r.charging);
+    }
+
+    public boolean hasTemperature() {
+        return temperatureDeciC != NO_TEMPERATURE;
+    }
+
+    public boolean hasLevel() {
+        return levelPercent != NO_LEVEL;
+    }
+
+    @Override
+    public boolean equals(Object o) {
+        if (!(o instanceof HistorySample)) {
+            return false;
+        }
+        final HistorySample s = (HistorySample) o;
+        return timeMillis == s.timeMillis && levelPercent == s.levelPercent
+                && temperatureDeciC == s.temperatureDeciC && charging == s.charging;
+    }
+
+    @Override
+    public int hashCode() {
+        return Objects.hash(timeMillis, levelPercent, temperatureDeciC, charging);
+    }
+
+    @Override
+    public String toString() {
+        return timeMillis + "," + levelPercent + "," + temperatureDeciC + "," + charging;
+    }
+}
