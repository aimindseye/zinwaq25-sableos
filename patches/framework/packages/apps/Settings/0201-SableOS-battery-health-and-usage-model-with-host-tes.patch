+package com.android.settings.fuelgauge.sable.model;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.Test;
+
+public class ChargingControlPolicyTest {
+    private static final ChargingDiscovery NOTHING =
+            new ChargingDiscovery(false, BatteryReadings.MISSING, 0);
+    private static final ChargingDiscovery LINEAGE_HEALTH =
+            new ChargingDiscovery(true, ChargingDiscovery.CHARGING_POLICY_DEFAULT, 580);
+
+    @Test
+    public void mutationIsNotAuthorized() {
+        assertFalse(ChargingControlPolicy.MUTATION_AUTHORIZED);
+    }
+
+    @Test
+    public void neverEnabledEvenWithAFullyQualifiedProfile() {
+        // UNQUALIFIED_CHARGING_MUTATION=NO: BH6 is not authorized.
+        final BatteryCapabilityProfile p = TestProfiles.of("charge_limit_supported=YES",
+                "charge_limit_values=80", "adaptive_charging_supported=YES",
+                "scheduled_charging_supported=YES", "backend_provenance=vendor hal",
+                "mutable_backend_qualified=YES");
+        for (ChargingControl c : ChargingControl.values()) {
+            for (ChargingDiscovery d : new ChargingDiscovery[] {NOTHING, LINEAGE_HEALTH}) {
+                assertTrue(c.name(), ChargingControlPolicy.state(c, p, d)
+                        != ChargingControlPolicy.State.ENABLED);
+            }
+        }
+        assertEquals(ChargingControlPolicy.State.BACKEND_NOT_QUALIFIED,
+                ChargingControlPolicy.state(ChargingControl.CHARGE_LIMIT, p, LINEAGE_HEALTH));
+    }
+
+    @Test
+    public void unknownProfileStates() {
+        final BatteryCapabilityProfile p = BatteryCapabilityProfile.EMPTY;
+        assertEquals(ChargingControlPolicy.State.NOT_AVAILABLE_YET,
+                ChargingControlPolicy.state(ChargingControl.CHARGE_LIMIT, p, NOTHING));
+        assertEquals(ChargingControlPolicy.State.BACKEND_NOT_QUALIFIED,
+                ChargingControlPolicy.state(ChargingControl.CHARGE_LIMIT, p, LINEAGE_HEALTH));
+        assertEquals(ChargingControlPolicy.State.HIDDEN,
+                ChargingControlPolicy.state(ChargingControl.VENDOR_CHARGING_CONTROLS, p,
+                        LINEAGE_HEALTH));
+        assertEquals(ChargingControlPolicy.State.READ_ONLY_STATUS,
+                ChargingControlPolicy.state(ChargingControl.THERMAL_PROTECTION, p, NOTHING));
+        assertEquals(ChargingControlPolicy.State.HIDDEN,
+                ChargingControlPolicy.state(ChargingControl.CHARGING_POLICY_STATUS, p, NOTHING));
+        assertEquals(ChargingControlPolicy.State.READ_ONLY_STATUS,
+                ChargingControlPolicy.state(ChargingControl.CHARGING_POLICY_STATUS, p,
+                        LINEAGE_HEALTH));
+        assertEquals(ChargingControlPolicy.OverviewSummary.NOT_QUALIFIED,
+                ChargingControlPolicy.overview(p, NOTHING));
+    }
+
+    @Test
+    public void adaptivePolicyIsAHint() {
+        final ChargingDiscovery adaptive = new ChargingDiscovery(false,
+                ChargingDiscovery.CHARGING_POLICY_ADAPTIVE_LONGLIFE, 0);
+        assertEquals(ChargingControlPolicy.State.BACKEND_NOT_QUALIFIED,
+                ChargingControlPolicy.state(ChargingControl.ADAPTIVE_CHARGING,
+                        BatteryCapabilityProfile.EMPTY, adaptive));
+    }
+
+    @Test
+    public void unsupportedProfile() {
+        final BatteryCapabilityProfile p = TestProfiles.of("charge_limit_supported=NO",
+                "adaptive_charging_supported=NO", "scheduled_charging_supported=NO",
+                "thermal_protection_status_supported=NO");
+        assertEquals(ChargingControlPolicy.State.UNAVAILABLE_ON_DEVICE,
+                ChargingControlPolicy.state(ChargingControl.CHARGE_LIMIT, p, LINEAGE_HEALTH));
+        assertEquals(ChargingControlPolicy.State.HIDDEN,
+                ChargingControlPolicy.state(ChargingControl.THERMAL_PROTECTION, p, NOTHING));
+        assertEquals(ChargingControlPolicy.OverviewSummary.NOT_AVAILABLE,
+                ChargingControlPolicy.overview(p, NOTHING));
+    }
+}
