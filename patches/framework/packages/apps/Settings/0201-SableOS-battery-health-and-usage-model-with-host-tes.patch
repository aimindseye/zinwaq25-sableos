+package com.android.settings.fuelgauge.sable.model;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+
+import java.time.LocalDate;
+import java.time.Period;
+import java.time.ZoneId;
+import java.time.ZoneOffset;
+import org.junit.Test;
+
+public class HealthFactPresenterTest {
+    private static final ZoneId UTC = ZoneOffset.UTC;
+    private static final long NOW = 1_790_000_000_000L; // 2026-09-21
+
+    @Test
+    public void unavailableNeverShowsAValue() {
+        for (UnavailableReason r : UnavailableReason.values()) {
+            if (r == UnavailableReason.NONE) {
+                continue;
+            }
+            for (FactKind k : FactKind.values()) {
+                final FactText t = HealthFactPresenter.present(HealthFact.unavailable(k, r), 0,
+                        UTC, NOW);
+                assertFalse(t.showsValue());
+                assertEquals(0, t.args.length);
+                assertNull(t.source);
+            }
+        }
+        assertEquals(FactText.Template.NOT_QUALIFIED, HealthFactPresenter.present(
+                HealthFact.unavailable(FactKind.CYCLE_COUNT, UnavailableReason.NOT_QUALIFIED),
+                0, UTC, NOW).template);
+        assertEquals(FactText.Template.NOT_SUPPORTED, HealthFactPresenter.present(
+                HealthFact.unavailable(FactKind.CYCLE_COUNT, UnavailableReason.UNSUPPORTED),
+                0, UTC, NOW).template);
+    }
+
+    @Test
+    public void valueTemplates() {
+        FactText t = HealthFactPresenter.present(HealthFact.available(FactKind.MAXIMUM_CAPACITY,
+                2_769_400, FactSource.HEALTH_HAL, FactConfidence.PLATFORM_REPORTED, NOW), 0, UTC,
+                NOW);
+        assertEquals(FactText.Template.CAPACITY_MAH, t.template);
+        assertEquals(2769L, t.args[0]);
+        assertEquals(FactSource.HEALTH_HAL, t.source);
+
+        t = HealthFactPresenter.present(HealthFact.available(FactKind.TEMPERATURE, 465,
+                FactSource.ANDROID_FRAMEWORK, FactConfidence.PLATFORM_REPORTED, NOW), 580, UTC,
+                NOW);
+        assertEquals(FactText.Template.TEMPERATURE, t.template);
+        assertEquals(465L, t.args[0]);
+        assertEquals((long) TemperatureClass.WARM.ordinal(), t.args[1]);
+    }
+
+    @Test
+    public void datesAtMonthPrecision() {
+        final long mar2025 = 1_740_787_200L + 12 * 3600; // 2025-03-01 12:00Z
+        final FactText t = HealthFactPresenter.present(HealthFact.available(
+                FactKind.FIRST_USE_DATE, mar2025, FactSource.HEALTH_HAL,
+                FactConfidence.PLATFORM_REPORTED, 0), 0, UTC, NOW);
+        assertEquals(FactText.Template.MONTH_YEAR_WITH_AGE, t.template);
+        assertEquals(2025L, t.args[0]);
+        assertEquals(3L, t.args[1]);
+        assertEquals(1L, t.args[2]); // years
+        assertEquals(6L, t.args[3]); // months
+    }
+
+    @Test
+    public void coarseAgeIgnoresDays() {
+        assertEquals(Period.of(0, 0, 0), HealthFactPresenter.coarseAge(
+                LocalDate.of(2026, 9, 30), LocalDate.of(2026, 9, 1)));
+        assertEquals(Period.of(0, 1, 0), HealthFactPresenter.coarseAge(
+                LocalDate.of(2026, 8, 31), LocalDate.of(2026, 9, 1)));
+        assertEquals(Period.of(2, 0, 0), HealthFactPresenter.coarseAge(
+                LocalDate.of(2024, 9, 15), LocalDate.of(2026, 9, 1)));
+        assertEquals(Period.ZERO, HealthFactPresenter.coarseAge(
+                LocalDate.of(2027, 1, 1), LocalDate.of(2026, 9, 1)));
+    }
+
+    @Test
+    public void overviewSummary() {
+        final BatteryReadings tempOnly = BatteryReadings.builder().temperatureDeciC(300)
+                .sampleTimeMillis(NOW).build();
+        assertEquals(HealthFactPresenter.OverviewSummary.PARTIAL_TEMPERATURE,
+                HealthFactPresenter.overview(BatteryHealthEvaluator.evaluate(tempOnly,
+                        BatteryCapabilityProfile.EMPTY, NOW)));
+        assertEquals(HealthFactPresenter.OverviewSummary.NONE,
+                HealthFactPresenter.overview(BatteryHealthEvaluator.evaluate(
+                        BatteryReadings.builder().build(), BatteryCapabilityProfile.EMPTY, NOW)));
+        final BatteryReadings cap = BatteryReadings.builder().fullChargeUah(2_700_000)
+                .designCapacityUah(3_000_000).build();
+        assertEquals(HealthFactPresenter.OverviewSummary.CAPACITY_PERCENT,
+                HealthFactPresenter.overview(BatteryHealthEvaluator.evaluate(cap,
+                        TestProfiles.allHealthSupported(), NOW)));
+    }
+
+    @Test
+    public void temperatureClasses() {
+        assertEquals(450, TemperatureClass.hotThresholdDeciC(0));
+        assertEquals(480, TemperatureClass.hotThresholdDeciC(580));
+        assertEquals(500, TemperatureClass.hotThresholdDeciC(700));
+        assertEquals(400, TemperatureClass.hotThresholdDeciC(450));
+        assertEquals(TemperatureClass.NORMAL, TemperatureClass.classify(300, 580));
+        assertEquals(TemperatureClass.WARM, TemperatureClass.classify(430, 580));
+        assertEquals(TemperatureClass.HOT, TemperatureClass.classify(480, 580));
+        assertEquals(TemperatureClass.NORMAL, TemperatureClass.classify(-100, 0));
+        assertTrue(TemperatureClass.classify(449, 0) == TemperatureClass.WARM);
+    }
+}
