+
+package com.android.settings.fuelgauge.sable.model;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.EnumMap;
+import java.util.List;
+import java.util.Map;
+
+/** The evaluated set of health facts for one snapshot. */
+public final class HealthReport {
+    /** How much health data the device provides. */
+    public enum Coverage {
+        /** No health fact is available. */
+        NONE,
+        /** Some facts are available (for example temperature only). */
+        PARTIAL,
+        /** Capacity health, cycle count and temperature are all available. */
+        COMPLETE
+    }
+
+    private final Map<FactKind, HealthFact> mFacts;
+
+    HealthReport(Map<FactKind, HealthFact> facts) {
+        final EnumMap<FactKind, HealthFact> copy = new EnumMap<>(FactKind.class);
+        for (FactKind k : FactKind.values()) {
+            final HealthFact f = facts.get(k);
+            copy.put(k, f != null ? f : HealthFact.unavailable(k, UnavailableReason.NOT_REPORTED));
+        }
+        mFacts = Collections.unmodifiableMap(copy);
+    }
+
+    public HealthFact fact(FactKind kind) {
+        return mFacts.get(kind);
+    }
+
+    /** Available facts in declaration order (the Health screen order). */
+    public List<FactKind> availableKinds() {
+        final List<FactKind> out = new ArrayList<>();
+        for (FactKind k : FactKind.values()) {
+            if (mFacts.get(k).isAvailable()) {
+                out.add(k);
+            }
+        }
+        return out;
+    }
+
+    public Coverage coverage() {
+        if (fact(FactKind.CAPACITY_HEALTH).isAvailable()
+                && fact(FactKind.CYCLE_COUNT).isAvailable()
+                && fact(FactKind.TEMPERATURE).isAvailable()) {
+            return Coverage.COMPLETE;
+        }
+        for (HealthFact f : mFacts.values()) {
+            if (f.isAvailable()) {
+                return Coverage.PARTIAL;
+            }
+        }
+        return Coverage.NONE;
+    }
+}
