+
+package com.android.settings.fuelgauge.sable.model;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import java.util.Arrays;
+import org.junit.Test;
+
+public class BatteryProfileParserTest {
+    @Test
+    public void parsesAllKeys() {
+        final BatteryCapabilityProfile p = TestProfiles.of(
+                "# comment", "", "health_capacity_supported=YES",
+                "health_cycle_count_supported=no", "charge_limit_supported=SUPPORTED",
+                "charge_limit_values=85, 80,100,80", "backend_provenance=vendor hal v1",
+                "mutable_backend_qualified=YES", "spec_design_capacity_mah=3000");
+        assertEquals(TestProfiles.ID, p.profileId());
+        assertEquals(Capability.SUPPORTED, p.capability("health_capacity_supported"));
+        assertEquals(Capability.UNSUPPORTED, p.capability("health_cycle_count_supported"));
+        assertEquals(Capability.UNKNOWN, p.capability("health_temperature_supported"));
+        assertEquals(Arrays.asList(80, 85, 100), p.chargeLimitValues());
+        assertTrue(p.mutableBackendQualified());
+        assertEquals(3000, p.specDesignCapacityMah());
+    }
+
+    @Test
+    public void wrongSchemaOrIdIsEmpty() {
+        assertTrue(BatteryProfileParser.parse("schema=2\nprofile_id=test-device\n",
+                TestProfiles.ID).isEmpty());
+        assertTrue(BatteryProfileParser.parse("profile_id=test-device\n", TestProfiles.ID)
+                .isEmpty());
+        // Another device's file never applies.
+        assertTrue(BatteryProfileParser.parse("schema=1\nprofile_id=other\n"
+                + "health_capacity_supported=YES\n", TestProfiles.ID).isEmpty());
+        assertTrue(BatteryProfileParser.parse(null, TestProfiles.ID).isEmpty());
+    }
+
+    @Test
+    public void profileIdValidation() {
+        assertTrue(BatteryProfileParser.isValidProfileId("zinwa-q25"));
+        assertFalse(BatteryProfileParser.isValidProfileId("../etc/passwd"));
+        assertFalse(BatteryProfileParser.isValidProfileId("Zinwa"));
+        assertFalse(BatteryProfileParser.isValidProfileId(""));
+        assertFalse(BatteryProfileParser.isValidProfileId(null));
+        assertTrue(BatteryProfileParser.parse("schema=1\nprofile_id=../x\n", "../x").isEmpty());
+    }
+
+    @Test
+    public void malformedFailsClosed() {
+        final BatteryCapabilityProfile p = TestProfiles.of("health_capacity_supported=maybe",
+                "garbage line", "charge_limit_values=abc,20", "spec_design_capacity_mah=lots",
+                "health_cycle_count_supported=YES", "health_cycle_count_supported=YES");
+        assertEquals(Capability.UNKNOWN, p.capability("health_capacity_supported"));
+        // Duplicate keys are ambiguous and dropped.
+        assertEquals(Capability.UNKNOWN, p.capability("health_cycle_count_supported"));
+        assertTrue(p.chargeLimitValues().isEmpty());
+        assertEquals(0, p.specDesignCapacityMah());
+        assertTrue(p.warnings().size() >= 4);
+    }
+
+    @Test
+    public void qualifiedNeedsProvenanceAndLimitsNeedSupport() {
+        final BatteryCapabilityProfile p = TestProfiles.of("mutable_backend_qualified=YES",
+                "charge_limit_values=80");
+        assertFalse(p.mutableBackendQualified());
+        assertTrue(p.chargeLimitValues().isEmpty());
+    }
+}
