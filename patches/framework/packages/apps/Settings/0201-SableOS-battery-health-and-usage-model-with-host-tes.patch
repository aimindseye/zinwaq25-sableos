+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.settings.fuelgauge.sable.model;
+
+/**
+ * A segmented control (for example Today / 24 hours / 7 days) as one focusable group
+ * (BATTERY_HEALTH_USAGE_UX section 9.3).
+ *
+ * <pre>
+ * focused, idle:  Enter/Space enters the group; Left/Right are NOT consumed (no trap)
+ * in the group:   Left/Right move the pending value (mirrored for RTL, clamped)
+ *                 Enter/Space confirm the pending value and leave the group
+ *                 Escape/Back leave the group and restore the confirmed value
+ *                 Up/Down leave the group (confirmed value kept) and let focus move on
+ * </pre>
+ */
+public final class SegmentedRangeGroup {
+    /** What a key did. */
+    public static final class Result {
+        public final boolean consumed;
+        /** The highlighted (pending) value changed: redraw. */
+        public final boolean pendingChanged;
+        /** The confirmed value changed: reload data for the new value. */
+        public final boolean confirmedChanged;
+
+        Result(boolean consumed, boolean pendingChanged, boolean confirmedChanged) {
+            this.consumed = consumed;
+            this.pendingChanged = pendingChanged;
+            this.confirmedChanged = confirmedChanged;
+        }
+    }
+
+    private static final Result IGNORED = new Result(false, false, false);
+    private static final Result CONSUMED = new Result(true, false, false);
+
+    private final int mCount;
+    private int mConfirmed;
+    private int mPending;
+    private boolean mActive;
+    private boolean mRtl;
+
+    public SegmentedRangeGroup(int count, int initial) {
+        if (count <= 0 || initial < 0 || initial >= count) {
+            throw new IllegalArgumentException("bad segment count/initial");
+        }
+        mCount = count;
+        mConfirmed = initial;
+        mPending = initial;
+    }
+
+    public void setRtl(boolean rtl) {
+        mRtl = rtl;
+    }
+
+    public int confirmed() {
+        return mConfirmed;
+    }
+
+    public int pending() {
+        return mPending;
+    }
+
+    public boolean isActive() {
+        return mActive;
+    }
+
+    /** Touch/pointer fallback: a tap selects and confirms directly. */
+    public boolean tap(int index) {
+        if (index < 0 || index >= mCount) {
+            return false;
+        }
+        mActive = false;
+        mPending = index;
+        final boolean changed = index != mConfirmed;
+        mConfirmed = index;
+        return changed;
+    }
+
+    /** Focus left the group: keep the confirmed value. */
+    public void blur() {
+        mActive = false;
+        mPending = mConfirmed;
+    }
+
+    public Result handle(NavKey key) {
+        if (!mActive) {
+            if (key == NavKey.ENTER || key == NavKey.SPACE) {
+                mActive = true;
+                mPending = mConfirmed;
+                return new Result(true, true, false);
+            }
+            return IGNORED;
+        }
+        switch (key) {
+            case LEFT:
+                return movePending(mRtl ? 1 : -1);
+            case RIGHT:
+                return movePending(mRtl ? -1 : 1);
+            case MOVE_HOME:
+                return setPending(0);
+            case MOVE_END:
+                return setPending(mCount - 1);
+            case ENTER:
+            case SPACE: {
+                mActive = false;
+                final boolean changed = mPending != mConfirmed;
+                mConfirmed = mPending;
+                return new Result(true, true, changed);
+            }
+            case ESCAPE:
+            case BACK: {
+                mActive = false;
+                final boolean pendingChanged = mPending != mConfirmed;
+                mPending = mConfirmed;
+                return new Result(true, pendingChanged, false);
+            }
+            case UP:
+            case DOWN: {
+                mActive = false;
+                final boolean pendingChanged = mPending != mConfirmed;
+                mPending = mConfirmed;
+                return new Result(false, pendingChanged, false);
+            }
+            default:
+                return CONSUMED;
+        }
+    }
+
+    private Result movePending(int step) {
+        return setPending(Math.max(0, Math.min(mCount - 1, mPending + step)));
+    }
+
+    private Result setPending(int index) {
+        if (index == mPending) {
+            return CONSUMED;
+        }
+        mPending = index;
+        return new Result(true, true, false);
+    }
+}
