+
+package com.android.settings.fuelgauge.sable.model;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.Test;
+
+public class SegmentedRangeGroupTest {
+    @Test
+    public void idleDoesNotTrapArrows() {
+        final SegmentedRangeGroup g = new SegmentedRangeGroup(3, 1);
+        assertFalse(g.handle(NavKey.LEFT).consumed);
+        assertFalse(g.handle(NavKey.RIGHT).consumed);
+        assertFalse(g.handle(NavKey.DOWN).consumed);
+        assertEquals(1, g.confirmed());
+    }
+
+    @Test
+    public void enterMoveConfirm() {
+        final SegmentedRangeGroup g = new SegmentedRangeGroup(3, 1);
+        assertTrue(g.handle(NavKey.ENTER).consumed);
+        assertTrue(g.isActive());
+        assertTrue(g.handle(NavKey.RIGHT).pendingChanged);
+        assertEquals(2, g.pending());
+        assertEquals(1, g.confirmed());
+        assertTrue(g.handle(NavKey.RIGHT).consumed); // clamped
+        final SegmentedRangeGroup.Result r = g.handle(NavKey.SPACE);
+        assertTrue(r.confirmedChanged);
+        assertEquals(2, g.confirmed());
+        assertFalse(g.isActive());
+    }
+
+    @Test
+    public void escapeRestores() {
+        final SegmentedRangeGroup g = new SegmentedRangeGroup(3, 0);
+        g.handle(NavKey.ENTER);
+        g.handle(NavKey.MOVE_END);
+        assertEquals(2, g.pending());
+        final SegmentedRangeGroup.Result r = g.handle(NavKey.ESCAPE);
+        assertTrue(r.consumed);
+        assertFalse(r.confirmedChanged);
+        assertEquals(0, g.pending());
+        assertEquals(0, g.confirmed());
+    }
+
+    @Test
+    public void upDownLeaveWithoutConsuming() {
+        final SegmentedRangeGroup g = new SegmentedRangeGroup(3, 0);
+        g.handle(NavKey.ENTER);
+        g.handle(NavKey.RIGHT);
+        final SegmentedRangeGroup.Result r = g.handle(NavKey.DOWN);
+        assertFalse(r.consumed);
+        assertFalse(g.isActive());
+        assertEquals(0, g.confirmed());
+    }
+
+    @Test
+    public void rtlAndTap() {
+        final SegmentedRangeGroup g = new SegmentedRangeGroup(3, 1);
+        g.setRtl(true);
+        g.handle(NavKey.ENTER);
+        g.handle(NavKey.RIGHT);
+        assertEquals(0, g.pending());
+        g.blur();
+        assertEquals(1, g.pending());
+        assertTrue(g.tap(2));
+        assertEquals(2, g.confirmed());
+        assertFalse(g.tap(2));
+        assertFalse(g.tap(7));
+    }
+}
