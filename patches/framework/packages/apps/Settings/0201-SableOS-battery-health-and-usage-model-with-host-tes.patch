+
+import org.junit.Test;
+
+public class CapacityMathTest {
+    @Test
+    public void percentRoundsDown() {
+        assertEquals(92, CapacityMath.capacityPercent(2_769_000, 3_000_000));
+        assertEquals(100, CapacityMath.capacityPercent(3_000_000, 3_000_000));
+        assertEquals(105, CapacityMath.capacityPercent(3_150_000, 3_000_000));
+    }
+
+    @Test
+    public void invalidInputs() {
+        assertEquals(CapacityMath.INVALID, CapacityMath.capacityPercent(0, 3_000_000));
+        assertEquals(CapacityMath.INVALID, CapacityMath.capacityPercent(3_000_000, 0));
+        assertEquals(CapacityMath.INVALID,
+                CapacityMath.capacityPercent(BatteryReadings.MISSING, 3_000_000));
+        assertEquals(CapacityMath.INVALID, CapacityMath.capacityPercent(3_000_000, 1_000_000));
+        assertEquals(CapacityMath.INVALID, CapacityMath.capacityPercent(-5, -10));
+        assertEquals(CapacityMath.INVALID, CapacityMath.capacityPercent(1, 3_000_000));
+    }
+
+    @Test
+    public void mah() {
+        assertEquals(2769L, CapacityMath.uahToMah(2_769_000));
+        assertEquals(2770L, CapacityMath.uahToMah(2_769_500));
+        assertEquals(2769L, CapacityMath.uahToMah(2_769_499));
+    }
+
+    @Test
+    public void spec() {
+        assertTrue(CapacityMath.matchesSpec(3_000_000, 3000));
+        assertTrue(CapacityMath.matchesSpec(2_400_000, 3000));
+        assertFalse(CapacityMath.matchesSpec(2_000_000, 3000));
+        assertFalse(CapacityMath.matchesSpec(1_000_000, 3000));
+        assertTrue(CapacityMath.matchesSpec(1_000_000, 0));
+    }
+
+    @Test
+    public void agreement() {
+        assertTrue(CapacityMath.sourcesAgree(90, 92));
+        assertTrue(CapacityMath.sourcesAgree(80, 90));
+        assertFalse(CapacityMath.sourcesAgree(70, 92));
+    }
+}
diff --git a/tests/sable-battery/src/com/android/settings/fuelgauge/sable/model/ChargingControlPolicyTest.java b/tests/sable-battery/src/com/android/settings/fuelgauge/sable/model/ChargingControlPolicyTest.java
