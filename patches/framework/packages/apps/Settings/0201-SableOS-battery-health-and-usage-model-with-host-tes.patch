+package com.android.settings.fuelgauge.sable.model;
+
+/** Charging and protection rows (BATTERY_HEALTH_USAGE_UX section 7). */
+public enum ChargingControl {
+    /** Stop charging at a percentage. Mutable: requires a qualified backend. */
+    CHARGE_LIMIT(true, BatteryCapabilityProfile.KEY_CHARGE_LIMIT),
+    /** Adaptive charging. Mutable: requires a qualified backend. */
+    ADAPTIVE_CHARGING(true, BatteryCapabilityProfile.KEY_ADAPTIVE_CHARGING),
+    /** Overnight / scheduled charging. Mutable: requires a qualified backend. */
+    SCHEDULED_CHARGING(true, BatteryCapabilityProfile.KEY_SCHEDULED_CHARGING),
+    /** Thermal charging protection: platform/vendor owned, status only. */
+    THERMAL_PROTECTION(false, BatteryCapabilityProfile.KEY_THERMAL_PROTECTION_STATUS),
+    /** Current Android charging policy (BATTERY_PROPERTY_CHARGING_POLICY), status only. */
+    CHARGING_POLICY_STATUS(false, null),
+    /**
+     * Vendor charging controls that ship outside Sable's gate (for example LineageOS
+     * charging control and charging speed, backed by the lineagehealth service). Mutable.
+     */
+    VENDOR_CHARGING_CONTROLS(true, BatteryCapabilityProfile.KEY_CHARGE_LIMIT);
+
+    private final boolean mMutable;
+    private final String mProfileKey;
+
+    ChargingControl(boolean mutable, String profileKey) {
+        mMutable = mutable;
+        mProfileKey = profileKey;
+    }
+
+    public boolean isMutable() {
+        return mMutable;
+    }
+
+    /** Device-profile key, or null when the row depends only on runtime discovery. */
+    public String profileKey() {
+        return mProfileKey;
+    }
+}
diff --git a/src/com/android/settings/fuelgauge/sable/model/ChargingControlPolicy.java b/src/com/android/settings/fuelgauge/sable/model/ChargingControlPolicy.java
new file mode 100644
index 0000000..6ba8cf5
--- /dev/null
+++ b/src/com/android/settings/fuelgauge/sable/model/ChargingControlPolicy.java
@@ -0,0 +1,141 @@
+/*
+ * Copyright (C) 2026 The SableOS Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.settings.fuelgauge.sable.model;
+
+/**
+ * Capability gate for Charging and protection (BH5 discovery, BH6 boundary).
+ *
+ * <p>BH6 (mutable charging controls) is not authorized. {@link #MUTATION_AUTHORIZED} is a
+ * compile-time false, so {@link State#ENABLED} is unreachable for every mutable control no
+ * matter what a profile or the runtime claims. Lifting it requires a reviewed change together
+ * with a qualified per-device backend (implementation plan BH6 checklist), never a profile
+ * edit alone.
+ */
+public final class ChargingControlPolicy {
+    /** BH6 gate. Do not flip without the BH6 review: see class comment. */
+    public static final boolean MUTATION_AUTHORIZED = false;
+
+    /** How a row is shown. */
+    public enum State {
+        /** Not shown at all. */
+        HIDDEN,
+        /** Shown disabled: "Not available on this device". The profile proves absence. */
+        UNAVAILABLE_ON_DEVICE,
+        /** Shown disabled: "Not available on this device yet". No evidence either way. */
+        NOT_AVAILABLE_YET,
+        /**
+         * Shown disabled: a backend exists or is claimed, but it is not qualified (or mutation
+         * is not authorized). "Found on this device, not yet qualified".
+         */
+        BACKEND_NOT_QUALIFIED,
+        /** Shown as read-only status text owned by the platform. */
+        READ_ONLY_STATUS,
+        /** Interactive. Unreachable while MUTATION_AUTHORIZED is false. */
+        ENABLED
+    }
+
+    private ChargingControlPolicy() {}
+
+    public static State state(ChargingControl control, BatteryCapabilityProfile profile,
+            ChargingDiscovery discovery) {
+        switch (control) {
+            case THERMAL_PROTECTION:
+                // Thermal protection is owned by the platform and charger hardware on every
+                // Android device; Settings only describes it. Hidden only if a profile proves
+                // the status is not applicable.
+                return profile.capability(control.profileKey()) == Capability.UNSUPPORTED
+                        ? State.HIDDEN : State.READ_ONLY_STATUS;
+            case CHARGING_POLICY_STATUS:
+                return discovery.hasChargingPolicy() ? State.READ_ONLY_STATUS : State.HIDDEN;
+            case VENDOR_CHARGING_CONTROLS:
+                // Controls Sable does not own stay hidden unless they could be ENABLED.
+                return mutableState(control, profile, discovery) == State.ENABLED
+                        ? State.ENABLED : State.HIDDEN;
+            default:
+                return mutableState(control, profile, discovery);
+        }
+    }
+
+    private static State mutableState(ChargingControl control, BatteryCapabilityProfile profile,
+            ChargingDiscovery discovery) {
+        final Capability cap = profile.capability(control.profileKey());
+        final boolean runtimeHint = runtimeHint(control, discovery);
+        switch (cap) {
+            case UNSUPPORTED:
+                return State.UNAVAILABLE_ON_DEVICE;
+            case SUPPORTED:
+                if (MUTATION_AUTHORIZED && profile.mutableBackendQualified() && runtimeHint
+                        && (control != ChargingControl.CHARGE_LIMIT
+                                || !profile.chargeLimitValues().isEmpty())) {
+                    return State.ENABLED;
+                }
+                return State.BACKEND_NOT_QUALIFIED;
+            case UNKNOWN:
+            default:
+                return runtimeHint ? State.BACKEND_NOT_QUALIFIED : State.NOT_AVAILABLE_YET;
+        }
+    }
+
+    /** Whether the running system shows any sign of a backend for this control. */
+    static boolean runtimeHint(ChargingControl control, ChargingDiscovery d) {
+        switch (control) {
+            case CHARGE_LIMIT:
+            case VENDOR_CHARGING_CONTROLS:
+                return d.vendorChargingServicePresent;
+            case ADAPTIVE_CHARGING:
+                return d.chargingPolicy == ChargingDiscovery.CHARGING_POLICY_ADAPTIVE_AON
+                        || d.chargingPolicy == ChargingDiscovery.CHARGING_POLICY_ADAPTIVE_AC
+                        || d.chargingPolicy
+                                == ChargingDiscovery.CHARGING_POLICY_ADAPTIVE_LONGLIFE
+                        || d.vendorChargingServicePresent;
+            case SCHEDULED_CHARGING:
+                return d.vendorChargingServicePresent;
+            default:
+                return false;
+        }
+    }
+
+    /** Overview summary for the "Charging & protection" row. */
+    public enum OverviewSummary {
+        /** "Device controls not yet qualified". */
+        NOT_QUALIFIED,
+        /** "Charging controls not available on this device". */
+        NOT_AVAILABLE,
+        /** "Managed by Android". */
+        PLATFORM_ONLY
+    }
+
+    public static OverviewSummary overview(BatteryCapabilityProfile profile,
+            ChargingDiscovery discovery) {
+        boolean anyUnqualified = false;
+        boolean allUnavailable = true;
+        for (ChargingControl c : new ChargingControl[] {ChargingControl.CHARGE_LIMIT,
+                ChargingControl.ADAPTIVE_CHARGING, ChargingControl.SCHEDULED_CHARGING}) {
+            final State s = state(c, profile, discovery);
+            if (s == State.BACKEND_NOT_QUALIFIED || s == State.NOT_AVAILABLE_YET) {
+                anyUnqualified = true;
+            }
+            if (s != State.UNAVAILABLE_ON_DEVICE) {
+                allUnavailable = false;
+            }
+        }
+        if (anyUnqualified) {
+            return OverviewSummary.NOT_QUALIFIED;
+        }
+        return allUnavailable ? OverviewSummary.NOT_AVAILABLE : OverviewSummary.PLATFORM_ONLY;
+    }
+}
