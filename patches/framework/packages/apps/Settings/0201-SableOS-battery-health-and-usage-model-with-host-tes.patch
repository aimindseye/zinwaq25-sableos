+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.settings.fuelgauge.sable.model;
+
+/** Capacity arithmetic with explicit plausibility bounds. Returns {@link #INVALID} on doubt. */
+public final class CapacityMath {
+    public static final int INVALID = -1;
+
+    /** Largest plausible phone/tablet battery: 100 Ah. */
+    static final long MAX_PLAUSIBLE_UAH = 100_000_000L;
+    /** A fresh cell may report a little above design; beyond this the pair is inconsistent. */
+    static final int MAX_PLAUSIBLE_PERCENT = 125;
+    /** How far a reported design capacity may drift from the vendor specification. */
+    static final int SPEC_TOLERANCE_PERCENT = 25;
+    /** Points of disagreement between state-of-health and the capacity ratio we tolerate. */
+    static final int SOURCE_AGREEMENT_POINTS = 10;
+
+    private CapacityMath() {}
+
+    /** True for a positive capacity within the plausible range. */
+    public static boolean isPlausibleCapacityUah(long uah) {
+        return uah != BatteryReadings.MISSING && uah > 0 && uah <= MAX_PLAUSIBLE_UAH;
+    }
+
+    /** microampere-hours to milliampere-hours, rounded half up. */
+    public static long uahToMah(long uah) {
+        return (uah + 500) / 1000;
+    }
+
+    /**
+     * Full-charge capacity as a whole percentage of design capacity, rounded down (never
+     * flattering). INVALID when either input is implausible or the ratio exceeds
+     * {@link #MAX_PLAUSIBLE_PERCENT}.
+     */
+    public static int capacityPercent(long fullChargeUah, long designUah) {
+        if (!isPlausibleCapacityUah(fullChargeUah) || !isPlausibleCapacityUah(designUah)) {
+            return INVALID;
+        }
+        final long pct = fullChargeUah * 100L / designUah;
+        if (pct < 1 || pct > MAX_PLAUSIBLE_PERCENT) {
+            return INVALID;
+        }
+        return (int) pct;
+    }
+
+    /** True when {@code designUah} is within tolerance of the vendor spec (or no spec known). */
+    public static boolean matchesSpec(long designUah, int specMah) {
+        if (specMah <= 0) {
+            return true;
+        }
+        final long specUah = specMah * 1000L;
+        final long diff = Math.abs(designUah - specUah);
+        return diff * 100L <= specUah * SPEC_TOLERANCE_PERCENT;
+    }
+
+    /** True when a state-of-health percentage and a capacity ratio agree closely enough. */
+    public static boolean sourcesAgree(int stateOfHealthPercent, int ratioPercent) {
+        return Math.abs(stateOfHealthPercent - ratioPercent) <= SOURCE_AGREEMENT_POINTS;
+    }
+}
