+
+package com.android.settings.fuelgauge.sable.model;
+
+import java.util.EnumMap;
+import java.util.Map;
+
+/**
+ * Turns raw {@link BatteryReadings} plus a {@link BatteryCapabilityProfile} into a
+ * {@link HealthReport}. The rules, in order, for every fact:
+ *
+ * <ol>
+ *   <li>profile says UNSUPPORTED: unavailable (UNSUPPORTED);
+ *   <li>Android did not report a value: unavailable (NOT_REPORTED);
+ *   <li>the value fails a sanity check: unavailable (IMPLAUSIBLE);
+ *   <li>strict fact and the profile has no evidence (UNKNOWN): unavailable (NOT_QUALIFIED);
+ *   <li>otherwise available, with source and confidence.
+ * </ol>
+ *
+ * Nothing here estimates a value Android did not report.
+ */
+public final class BatteryHealthEvaluator {
+    /** 2000-01-01T00:00:00Z: earlier battery dates are treated as bogus. */
+    static final long EARLIEST_PLAUSIBLE_DATE_SEC = 946_684_800L;
+    /** Allowed clock skew for dates in the future. */
+    static final long FUTURE_DATE_SLACK_SEC = 24L * 60 * 60;
+    /** Battery temperature plausibility, tenths of a degree Celsius. */
+    static final long MIN_PLAUSIBLE_TEMP_DECI_C = -400;
+    static final long MAX_PLAUSIBLE_TEMP_DECI_C = 1000;
+    static final long MAX_PLAUSIBLE_CYCLES = 10_000;
+
+    private BatteryHealthEvaluator() {}
+
+    public static HealthReport evaluate(BatteryReadings r, BatteryCapabilityProfile p,
+            long nowMillis) {
+        final Map<FactKind, HealthFact> facts = new EnumMap<>(FactKind.class);
+        final long t = r.sampleTimeMillis;
+        final int specMah = p.specDesignCapacityMah();
+
+        // Design capacity.
+        UnavailableReason designProblem = rawCapacityProblem(r.designCapacityUah);
+        if (designProblem == UnavailableReason.NONE
+                && !CapacityMath.matchesSpec(r.designCapacityUah, specMah)) {
+            designProblem = UnavailableReason.IMPLAUSIBLE;
+        }
+        facts.put(FactKind.DESIGN_CAPACITY, gate(FactKind.DESIGN_CAPACITY, p, designProblem,
+                r.designCapacityUah, FactSource.HEALTH_HAL, FactConfidence.PLATFORM_REPORTED, t));
+
+        // Maximum (full-charge) capacity: must be consistent with design when design is known.
+        UnavailableReason fullProblem = rawCapacityProblem(r.fullChargeUah);
+        if (fullProblem == UnavailableReason.NONE) {
+            final long reference = designProblem == UnavailableReason.NONE
+                    ? r.designCapacityUah : (specMah > 0 ? specMah * 1000L : 0);
+            if (reference > 0
+                    && r.fullChargeUah * 100L > reference * CapacityMath.MAX_PLAUSIBLE_PERCENT) {
+                fullProblem = UnavailableReason.IMPLAUSIBLE;
+            }
+        }
+        facts.put(FactKind.MAXIMUM_CAPACITY, gate(FactKind.MAXIMUM_CAPACITY, p, fullProblem,
+                r.fullChargeUah, FactSource.HEALTH_HAL, FactConfidence.PLATFORM_REPORTED, t));
+
+        facts.put(FactKind.CAPACITY_HEALTH, capacityHealth(r, p, designProblem, fullProblem, t));
+
+        // Cycle count. Zero is ambiguous (new battery or "not reported"); only a profile with
+        // evidence may show zero.
+        UnavailableReason cycleProblem;
+        if (r.cycleCount == BatteryReadings.MISSING || r.cycleCount < 0) {
+            cycleProblem = UnavailableReason.NOT_REPORTED;
+        } else if (r.cycleCount == 0
+                && p.capability(FactKind.CYCLE_COUNT.profileKey()) != Capability.SUPPORTED) {
+            cycleProblem = UnavailableReason.NOT_REPORTED;
+        } else if (r.cycleCount > MAX_PLAUSIBLE_CYCLES) {
+            cycleProblem = UnavailableReason.IMPLAUSIBLE;
+        } else {
+            cycleProblem = UnavailableReason.NONE;
+        }
+        facts.put(FactKind.CYCLE_COUNT, gate(FactKind.CYCLE_COUNT, p, cycleProblem,
+                r.cycleCount, FactSource.HEALTH_HAL, FactConfidence.PLATFORM_REPORTED, t));
+
+        // Temperature.
+        UnavailableReason tempProblem;
+        if (r.temperatureDeciC == BatteryReadings.MISSING) {
+            tempProblem = UnavailableReason.NOT_REPORTED;
+        } else if (r.temperatureDeciC < MIN_PLAUSIBLE_TEMP_DECI_C
+                || r.temperatureDeciC > MAX_PLAUSIBLE_TEMP_DECI_C) {
+            tempProblem = UnavailableReason.IMPLAUSIBLE;
+        } else {
+            tempProblem = UnavailableReason.NONE;
+        }
+        facts.put(FactKind.TEMPERATURE, gate(FactKind.TEMPERATURE, p, tempProblem,
+                r.temperatureDeciC, FactSource.ANDROID_FRAMEWORK,
+                FactConfidence.PLATFORM_REPORTED, t));
+
+        // Health condition.
+        UnavailableReason statusProblem;
+        if (r.healthStatus == BatteryReadings.MISSING
+                || r.healthStatus == BatteryReadings.HEALTH_UNKNOWN) {
+            statusProblem = UnavailableReason.NOT_REPORTED;
+        } else if (r.healthStatus < BatteryReadings.HEALTH_GOOD
+                || r.healthStatus > BatteryReadings.HEALTH_COLD) {
+            statusProblem = UnavailableReason.IMPLAUSIBLE;
+        } else {
+            statusProblem = UnavailableReason.NONE;
+        }
+        facts.put(FactKind.HEALTH_STATUS, gate(FactKind.HEALTH_STATUS, p, statusProblem,
+                r.healthStatus, FactSource.ANDROID_FRAMEWORK, FactConfidence.PLATFORM_REPORTED,
+                t));
+
+        // Charge counter.
+        UnavailableReason counterProblem = rawCapacityProblem(r.chargeCounterUah);
+        if (counterProblem == UnavailableReason.NONE && designProblem == UnavailableReason.NONE
+                && r.chargeCounterUah * 100L
+                        > r.designCapacityUah * CapacityMath.MAX_PLAUSIBLE_PERCENT) {
+            counterProblem = UnavailableReason.IMPLAUSIBLE;
+        }
+        facts.put(FactKind.CHARGE_COUNTER, gate(FactKind.CHARGE_COUNTER, p, counterProblem,
+                r.chargeCounterUah, FactSource.HEALTH_HAL, FactConfidence.PLATFORM_REPORTED, t));
+
+        // Dates: never shown unless trustworthy (profile evidence and a sane value).
+        facts.put(FactKind.MANUFACTURING_DATE, gate(FactKind.MANUFACTURING_DATE, p,
+                dateProblem(r.manufacturingDateSec, nowMillis), r.manufacturingDateSec,
+                FactSource.HEALTH_HAL, FactConfidence.PLATFORM_REPORTED, HealthFact.NO_TIMESTAMP));
+        UnavailableReason firstUseProblem = dateProblem(r.firstUseDateSec, nowMillis);
+        if (firstUseProblem == UnavailableReason.NONE
+                && dateProblem(r.manufacturingDateSec, nowMillis) == UnavailableReason.NONE
+                && r.firstUseDateSec < r.manufacturingDateSec) {
+            firstUseProblem = UnavailableReason.IMPLAUSIBLE;
+        }
+        facts.put(FactKind.FIRST_USE_DATE, gate(FactKind.FIRST_USE_DATE, p, firstUseProblem,
+                r.firstUseDateSec, FactSource.HEALTH_HAL, FactConfidence.PLATFORM_REPORTED,
+                HealthFact.NO_TIMESTAMP));
+
+        return new HealthReport(facts);
+    }
+
+    private static HealthFact capacityHealth(BatteryReadings r, BatteryCapabilityProfile p,
+            UnavailableReason designProblem, UnavailableReason fullProblem, long t) {
+        final boolean sohValid = r.stateOfHealthPercent != BatteryReadings.MISSING
+                && r.stateOfHealthPercent >= 1
+                && r.stateOfHealthPercent <= CapacityMath.MAX_PLAUSIBLE_PERCENT;
+        final int ratio = (designProblem == UnavailableReason.NONE
+                && fullProblem == UnavailableReason.NONE)
+                ? CapacityMath.capacityPercent(r.fullChargeUah, r.designCapacityUah)
+                : CapacityMath.INVALID;
+
+        if (sohValid) {
+            // The Health HAL's own state of health has the meaning the UI needs. If the
+            // capacity pair disagrees, keep the platform value but say confidence is low.
+            final FactConfidence c = (ratio != CapacityMath.INVALID
+                    && !CapacityMath.sourcesAgree((int) r.stateOfHealthPercent, ratio))
+                    ? FactConfidence.DERIVED_LOW_CONFIDENCE : FactConfidence.PLATFORM_REPORTED;
+            return gate(FactKind.CAPACITY_HEALTH, p, UnavailableReason.NONE,
+                    r.stateOfHealthPercent, FactSource.HEALTH_HAL, c, t);
+        }
+        if (ratio != CapacityMath.INVALID) {
+            return gate(FactKind.CAPACITY_HEALTH, p, UnavailableReason.NONE, ratio,
+                    FactSource.HEALTH_HAL, FactConfidence.DERIVED_HIGH_CONFIDENCE, t);
+        }
+        // Nothing usable. IMPLAUSIBLE when Android reported something that failed the checks,
+        // NOT_REPORTED when it reported nothing at all.
+        final boolean sohReported = r.stateOfHealthPercent != BatteryReadings.MISSING
+                && r.stateOfHealthPercent != 0;
+        final boolean pairReported = designProblem != UnavailableReason.NOT_REPORTED
+                && fullProblem != UnavailableReason.NOT_REPORTED;
+        return gate(FactKind.CAPACITY_HEALTH, p,
+                (sohReported || pairReported)
+                        ? UnavailableReason.IMPLAUSIBLE : UnavailableReason.NOT_REPORTED,
+                0, FactSource.HEALTH_HAL, FactConfidence.PLATFORM_REPORTED, t);
+    }
+
+    private static HealthFact gate(FactKind kind, BatteryCapabilityProfile p,
+            UnavailableReason valueProblem, long value, FactSource source,
+            FactConfidence confidence, long sampleTimeMillis) {
+        final Capability cap = p.capability(kind.profileKey());
+        if (cap == Capability.UNSUPPORTED) {
+            return HealthFact.unavailable(kind, UnavailableReason.UNSUPPORTED);
+        }
+        if (valueProblem != UnavailableReason.NONE) {
+            return HealthFact.unavailable(kind, valueProblem);
+        }
+        if (kind.isStrict() && cap != Capability.SUPPORTED) {
+            return HealthFact.unavailable(kind, UnavailableReason.NOT_QUALIFIED);
+        }
+        return HealthFact.available(kind, value, source, confidence, sampleTimeMillis);
+    }
+
+    private static UnavailableReason rawCapacityProblem(long uah) {
+        if (uah == BatteryReadings.MISSING || uah <= 0) {
+            return UnavailableReason.NOT_REPORTED;
+        }
+        return CapacityMath.isPlausibleCapacityUah(uah)
+                ? UnavailableReason.NONE : UnavailableReason.IMPLAUSIBLE;
+    }
+
+    private static UnavailableReason dateProblem(long epochSec, long nowMillis) {
+        if (epochSec == BatteryReadings.MISSING || epochSec <= 0) {
+            return UnavailableReason.NOT_REPORTED;
+        }
+        if (epochSec < EARLIEST_PLAUSIBLE_DATE_SEC
+                || epochSec > nowMillis / 1000L + FUTURE_DATE_SLACK_SEC) {
+            return UnavailableReason.IMPLAUSIBLE;
+        }
+        return UnavailableReason.NONE;
+    }
+}
diff --git a/src/com/android/settings/fuelgauge/sable/model/BatteryProfileParser.java b/src/com/android/settings/fuelgauge/sable/model/BatteryProfileParser.java
new file mode 100644
index 0000000..fadb38a
--- /dev/null
+++ b/src/com/android/settings/fuelgauge/sable/model/BatteryProfileParser.java
@@ -0,0 +1,149 @@
+/*
+ * Copyright (C) 2026 The SableOS Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
