+     * meaningful on this hardware. Strict facts (capacity, cycle count, dates, charge counter)
+     * fail closed in this state.
+     */
+    NOT_QUALIFIED,
+    /** The reported value fails a sanity check (out of range, inconsistent with design). */
+    IMPLAUSIBLE
+}
