+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.settings.fuelgauge.sable.model;
+
+/**
+ * The battery health facts the Health screen can show, each tied to a device-profile capability
+ * key.
+ *
+ * <p>A <em>strict</em> fact is shown only when the device profile records evidence
+ * ({@link Capability#SUPPORTED}) that the value Android reports is meaningful on this hardware.
+ * Maximum capacity and cycle count must fail closed unless independently proven on each target
+ * (implementation plan BH3). Non-strict facts (temperature, health status) are core Android
+ * BatteryManager facts that every device reports; they are shown unless the profile says
+ * {@link Capability#UNSUPPORTED} or the value is missing or implausible.
+ */
+public enum FactKind {
+    /** Full-charge capacity, value in microampere-hours. */
+    MAXIMUM_CAPACITY(true, BatteryCapabilityProfile.KEY_HEALTH_CAPACITY),
+    /** Design capacity, value in microampere-hours. */
+    DESIGN_CAPACITY(true, BatteryCapabilityProfile.KEY_HEALTH_CAPACITY),
+    /** Capacity relative to design, value in whole percent. */
+    CAPACITY_HEALTH(true, BatteryCapabilityProfile.KEY_HEALTH_CAPACITY),
+    /** Charge cycle count, value in cycles. */
+    CYCLE_COUNT(true, BatteryCapabilityProfile.KEY_HEALTH_CYCLE_COUNT),
+    /** Battery temperature, value in tenths of a degree Celsius. */
+    TEMPERATURE(false, BatteryCapabilityProfile.KEY_HEALTH_TEMPERATURE),
+    /** Android battery health condition, value is a BatteryManager.BATTERY_HEALTH_* constant. */
+    HEALTH_STATUS(false, BatteryCapabilityProfile.KEY_HEALTH_STATUS),
+    /** Remaining charge counter, value in microampere-hours. */
+    CHARGE_COUNTER(true, BatteryCapabilityProfile.KEY_HEALTH_CHARGE_COUNTER),
+    /** Manufacturing date, value in epoch seconds. */
+    MANUFACTURING_DATE(true, BatteryCapabilityProfile.KEY_HEALTH_MANUFACTURING_DATE),
+    /** First-use date, value in epoch seconds. */
+    FIRST_USE_DATE(true, BatteryCapabilityProfile.KEY_HEALTH_FIRST_USE_DATE);
+
+    private final boolean mStrict;
+    private final String mProfileKey;
+
+    FactKind(boolean strict, String profileKey) {
+        mStrict = strict;
+        mProfileKey = profileKey;
+    }
+
+    /** True when the fact requires device-profile evidence before it may be shown. */
+    public boolean isStrict() {
+        return mStrict;
+    }
+
+    /** The device-profile capability key that gates this fact. */
+    public String profileKey() {
+        return mProfileKey;
+    }
+}
