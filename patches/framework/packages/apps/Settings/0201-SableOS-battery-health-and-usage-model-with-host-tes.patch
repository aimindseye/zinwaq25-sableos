+
+package com.android.settings.fuelgauge.sable.model;
+
+import static org.junit.Assert.assertEquals;
+
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.List;
+import org.junit.Test;
+
+public class TypeAheadMatcherTest {
+    /** Battery overview rows, aliases as in res/values/sable_battery_arrays.xml. */
+    private static final List<TypeAheadMatcher.Row> BATTERY = Arrays.asList(
+            new TypeAheadMatcher.Row("Battery usage", Arrays.asList("usage", "drain")),
+            new TypeAheadMatcher.Row("Battery health", Arrays.asList("health", "maximum capacity")),
+            new TypeAheadMatcher.Row("Charging & protection",
+                    Arrays.asList("charging", "charge limit", "protection")),
+            new TypeAheadMatcher.Row("Battery saver",
+                    Arrays.asList("battery saver", "saver", "power saver")),
+            new TypeAheadMatcher.Row("Battery percentage", Collections.emptyList()));
+
+    @Test
+    public void designMnemonics() {
+        final long t = 10_000;
+        assertEquals(0, new TypeAheadMatcher().onChar('U', t, BATTERY, -1));
+        assertEquals(1, new TypeAheadMatcher().onChar('h', t, BATTERY, -1));
+        assertEquals(2, new TypeAheadMatcher().onChar('c', t, BATTERY, -1));
+        assertEquals(3, new TypeAheadMatcher().onChar('b', t, BATTERY, -1));
+    }
+
+    @Test
+    public void repeatedLetterCycles() {
+        final TypeAheadMatcher m = new TypeAheadMatcher();
+        int focus = m.onChar('b', 0, BATTERY, -1);
+        assertEquals(3, focus);
+        focus = m.onChar('b', 100, BATTERY, focus);
+        assertEquals(0, focus);
+        focus = m.onChar('b', 200, BATTERY, focus);
+        assertEquals(1, focus);
+        focus = m.onChar('b', 300, BATTERY, focus);
+        assertEquals(4, focus);
+        focus = m.onChar('b', 400, BATTERY, focus);
+        assertEquals(3, focus); // wraps
+    }
+
+    @Test
+    public void bufferGrowsWithinTimeoutAndResetsAfter() {
+        final TypeAheadMatcher m = new TypeAheadMatcher();
+        assertEquals(1, m.onChar('h', 0, BATTERY, -1));
+        assertEquals(1, m.onChar('e', 300, BATTERY, 1));
+        assertEquals("he", m.buffer());
+        // "batt" + "ery p" style: prefix of title.
+        final TypeAheadMatcher n = new TypeAheadMatcher();
+        int f = -1;
+        for (char c : "battery p".toCharArray()) {
+            f = n.onChar(c, 10, BATTERY, f);
+        }
+        assertEquals(4, f);
+        // After the timeout, a new buffer starts.
+        assertEquals(2, m.onChar('c', 2_000, BATTERY, 1));
+        assertEquals("c", m.buffer());
+    }
+
+    @Test
+    public void accentAndCaseInsensitive() {
+        final List<TypeAheadMatcher.Row> rows = Arrays.asList(
+                new TypeAheadMatcher.Row("Économie de batterie", Collections.emptyList()),
+                new TypeAheadMatcher.Row("Santé", Collections.emptyList()));
+        assertEquals(0, new TypeAheadMatcher().onChar('e', 0, rows, -1));
+        assertEquals(0, new TypeAheadMatcher().onChar('É', 0, rows, -1));
+        final TypeAheadMatcher m = new TypeAheadMatcher();
+        m.onChar('s', 0, rows, -1);
+        assertEquals(1, m.onChar('a', 10, rows, 1));
+    }
+
+    @Test
+    public void noMatchKeepsFocus() {
+        assertEquals(-1, new TypeAheadMatcher().onChar('z', 0, BATTERY, 2));
+        assertEquals(-1, new TypeAheadMatcher().onChar('/', 0, BATTERY, 2));
+    }
+
+    @Test
+    public void wordStartMatches() {
+        final List<TypeAheadMatcher.Row> rows = Arrays.asList(
+                new TypeAheadMatcher.Row("Charging & protection", Collections.emptyList()),
+                new TypeAheadMatcher.Row("Battery health", Collections.emptyList()));
+        assertEquals(0, new TypeAheadMatcher().onChar('p', 0, rows, -1));
+        assertEquals(1, new TypeAheadMatcher().onChar('h', 0, rows, -1));
+    }
+}
