+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.settings.fuelgauge.sable.model;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+
+import java.util.List;
+import org.junit.Test;
+
+public class HistoryRingBufferTest {
+    private static final long H = HistoryRingBuffer.HOUR_MILLIS;
+    private static final long T0 = 1_790_000_000_000L;
+
+    @Test
+    public void capacityMatchesPolicy() {
+        assertEquals(336, HistoryRingBuffer.CAPACITY);
+    }
+
+    @Test
+    public void dropsSamplesTooClose() {
+        final HistoryRingBuffer b = new HistoryRingBuffer();
+        assertTrue(b.add(new HistorySample(T0, 50, 300, false)));
+        assertFalse(b.add(new HistorySample(T0 + 10 * 60_000, 49, 300, false)));
+        assertTrue(b.add(new HistorySample(T0 + 30 * 60_000, 48, 300, false)));
+        assertEquals(2, b.size());
+    }
+
+    @Test
+    public void wrapsAtCapacityKeepingNewest() {
+        final HistoryRingBuffer b = new HistoryRingBuffer(3);
+        for (int i = 0; i < 5; i++) {
+            b.add(new HistorySample(T0 + i * H, i, 300, false));
+        }
+        final List<HistorySample> l = b.toList();
+        assertEquals(3, l.size());
+        assertEquals(2, l.get(0).levelPercent);
+        assertEquals(4, l.get(2).levelPercent);
+        assertEquals(4, b.newest().levelPercent);
+    }
+
+    @Test
+    public void pruneRetention() {
+        final HistoryRingBuffer b = new HistoryRingBuffer();
+        b.add(new HistorySample(T0, 1, 300, false));
+        b.add(new HistorySample(T0 + 12 * H, 2, 300, false));
+        b.add(new HistorySample(T0 + 8 * 24 * H, 3, 300, false));
+        b.prune(T0 + 8 * 24 * H);
+        assertEquals(1, b.size());
+        assertEquals(3, b.toList().get(0).levelPercent);
+        b.prune(T0); // clock went back a week: the "future" sample is dropped
+        assertEquals(0, b.size());
+        assertNull(b.newest());
+    }
+
+    @Test
+    public void bigClockJumpBackResets() {
+        final HistoryRingBuffer b = new HistoryRingBuffer();
+        b.add(new HistorySample(T0, 1, 300, false));
+        b.add(new HistorySample(T0 + H, 2, 300, false));
+        assertTrue(b.add(new HistorySample(T0 - 3 * 24 * H, 3, 300, false)));
+        assertEquals(1, b.size());
+    }
+
+    @Test
+    public void encodeDecodeRoundTrip() {
+        final HistoryRingBuffer b = new HistoryRingBuffer();
+        b.add(new HistorySample(T0, 74, 312, true));
+        b.add(new HistorySample(T0 + H, 70, HistorySample.NO_TEMPERATURE, false));
+        b.add(new HistorySample(T0 + 2 * H, 200, -50, false)); // bad level -> NO_LEVEL
+        final HistoryRingBuffer d = HistoryRingBuffer.decode(b.encode(), 10);
+        assertEquals(b.toList(), d.toList());
+        assertFalse(d.toList().get(1).hasTemperature());
+        assertFalse(d.toList().get(2).hasLevel());
+    }
+
+    @Test
+    public void decodeIsRobust() {
+        assertEquals(0, HistoryRingBuffer.decode("junk\n1,2,3,1\n", 10).size());
+        assertEquals(0, HistoryRingBuffer.decode(null, 10).size());
+        final String text = HistoryRingBuffer.HEADER + "\n"
+                + T0 + ",50,300,1\n"
+                + "garbage\n"
+                + (T0 - 5) + ",50,300,1\n"      // out of order
+                + (T0 + H) + ",50,99999,1\n"    // implausible temperature
+                + (T0 + 2 * H) + ",50,300,7\n"  // bad flag
+                + (T0 + 3 * H) + ",51,-,0\n";
+        final HistoryRingBuffer d = HistoryRingBuffer.decode(text, 10);
+        assertEquals(2, d.size());
+        assertEquals(51, d.newest().levelPercent);
+        // Only the newest `capacity` samples survive.
+        assertEquals(1, HistoryRingBuffer.decode(text, 1).size());
+        assertEquals(51, HistoryRingBuffer.decode(text, 1).newest().levelPercent);
+    }
+
+    @Test
+    public void sampleFromReportKeepsOnlyAllowedTemperature() {
+        final BatteryReadings r = BatteryReadings.builder().temperatureDeciC(312)
+                .levelPercent(60).charging(true).sampleTimeMillis(T0).build();
+        final HistorySample ok = HistorySample.from(r, BatteryHealthEvaluator.evaluate(r,
+                BatteryCapabilityProfile.EMPTY, T0));
+        assertEquals(312, ok.temperatureDeciC);
+        assertTrue(ok.charging);
+        final HistorySample blocked = HistorySample.from(r, BatteryHealthEvaluator.evaluate(r,
+                TestProfiles.of("health_temperature_supported=NO"), T0));
+        assertFalse(blocked.hasTemperature());
+        assertEquals(60, blocked.levelPercent);
+    }
+}
