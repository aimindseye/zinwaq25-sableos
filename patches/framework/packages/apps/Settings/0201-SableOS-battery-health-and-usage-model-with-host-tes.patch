+package com.android.settings.fuelgauge.sable.model;
+
+/**
+ * Read-only runtime discovery for BH5: what the running system exposes, gathered without any
+ * write. Never reads sysfs; the Settings glue fills this from framework APIs only.
+ */
+public final class ChargingDiscovery {
+    /** Mirrors android.os.BatteryManager.CHARGING_POLICY_* (kept here so the model is pure). */
+    public static final int CHARGING_POLICY_DEFAULT = 1;
+    public static final int CHARGING_POLICY_ADAPTIVE_AON = 2;
+    public static final int CHARGING_POLICY_ADAPTIVE_AC = 3;
+    public static final int CHARGING_POLICY_ADAPTIVE_LONGLIFE = 4;
+
+    /** True when a vendor charging-control service is registered (LineageOS lineagehealth). */
+    public final boolean vendorChargingServicePresent;
+    /** BATTERY_PROPERTY_CHARGING_POLICY, or {@link BatteryReadings#MISSING}. */
+    public final long chargingPolicy;
+    /** Platform battery shutdown temperature in tenths of C, 0 when not configured. */
+    public final int shutdownTemperatureDeciC;
+
+    public ChargingDiscovery(boolean vendorChargingServicePresent, long chargingPolicy,
+            int shutdownTemperatureDeciC) {
+        this.vendorChargingServicePresent = vendorChargingServicePresent;
+        this.chargingPolicy = chargingPolicy;
+        this.shutdownTemperatureDeciC = Math.max(0, shutdownTemperatureDeciC);
+    }
+
+    public boolean hasChargingPolicy() {
+        return chargingPolicy >= CHARGING_POLICY_DEFAULT
+                && chargingPolicy <= CHARGING_POLICY_ADAPTIVE_LONGLIFE;
+    }
+}
diff --git a/src/com/android/settings/fuelgauge/sable/model/ChartInspectionCursor.java b/src/com/android/settings/fuelgauge/sable/model/ChartInspectionCursor.java
new file mode 100644
index 0000000..f7a83ce
--- /dev/null
+++ b/src/com/android/settings/fuelgauge/sable/model/ChartInspectionCursor.java
@@ -0,0 +1,266 @@
+/*
+ * Copyright (C) 2026 The SableOS Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.settings.fuelgauge.sable.model;
+
+/**
+ * Keyboard inspection of a bucketed chart (BATTERY_HEALTH_USAGE_UX section 9.4).
+ *
+ * <pre>
+ * chart focused, not inspecting:
+ *   Enter / Space   enter inspection at the selected (or newest valid) bucket
+ *   anything else   not consumed, so normal focus movement continues (no focus trap)
+ * inspecting:
+ *   Left / Right    previous / next bucket with data (mirrored for RTL)
+ *   PageUp / Down   jump pageSize buckets
+ *   MoveHome / End  first / last bucket with data
+ *   Up / Down       previous / next series, consumed only when more than one series
+ *   Enter / Space   confirm the bucket (selection callback)
+ *   Escape / Back   leave inspection, focus stays on the chart row
+ * </pre>
+ *
+ * Buckets without data are skipped. If no bucket has data, Enter does not enter inspection.
+ */
+public final class ChartInspectionCursor {
+    /** What a key did. */
+    public static final class Result {
+        public static final Result IGNORED = new Result(false, false, false, false, false);
+
+        /** The key was handled and must not propagate. */
+        public final boolean consumed;
+        /** Bucket or series changed: redraw and announce the new text. */
+        public final boolean moved;
+        public final boolean entered;
+        public final boolean exited;
+        /** The user confirmed the current bucket. */
+        public final boolean confirmed;
+
+        Result(boolean consumed, boolean moved, boolean entered, boolean exited,
+                boolean confirmed) {
+            this.consumed = consumed;
+            this.moved = moved;
+            this.entered = entered;
+            this.exited = exited;
+            this.confirmed = confirmed;
+        }
+
+        static Result consumed() {
+            return new Result(true, false, false, false, false);
+        }
+    }
+
+    private boolean[][] mValid;
+    private final int mPageSize;
+    private boolean mRtl;
+    private boolean mInspecting;
+    private int mBucket = -1;
+    private int mSeries;
+
+    /**
+     * @param validPerSeries validPerSeries[series][bucket] is true when that bucket has data
+     * @param pageSize buckets per PageUp/PageDown, at least 1
+     */
+    public ChartInspectionCursor(boolean[][] validPerSeries, int pageSize) {
+        mPageSize = Math.max(1, pageSize);
+        setData(validPerSeries);
+    }
+
+    /** Replaces the data, keeping the position when still valid. */
+    public void setData(boolean[][] validPerSeries) {
+        if (validPerSeries == null || validPerSeries.length == 0) {
+            validPerSeries = new boolean[][] {new boolean[0]};
+        }
+        mValid = validPerSeries;
+        if (mSeries >= mValid.length) {
+            mSeries = 0;
+        }
+        if (mBucket >= bucketCount() || (mBucket >= 0 && !isValid(mBucket))) {
+            mBucket = lastValid();
+        }
+        if (mInspecting && mBucket < 0) {
+            mInspecting = false;
+        }
+    }
+
+    public void setRtl(boolean rtl) {
+        mRtl = rtl;
+    }
+
+    public boolean isInspecting() {
+        return mInspecting;
+    }
+
+    /** The current bucket, or -1 when there is none. */
+    public int bucket() {
+        return mBucket;
+    }
+
+    public int series() {
+        return mSeries;
+    }
+
+    public int seriesCount() {
+        return mValid.length;
+    }
+
+    public int bucketCount() {
+        return mValid[mSeries].length;
+    }
+
+    /** Leaves inspection without a key (for example when the chart loses focus). */
+    public void exit() {
+        mInspecting = false;
+    }
+
+    /** Selects a bucket directly (touch fallback). Returns false for a bucket without data. */
+    public boolean select(int bucket) {
+        if (bucket < 0 || bucket >= bucketCount() || !isValid(bucket)) {
+            return false;
+        }
+        mBucket = bucket;
+        return true;
+    }
+
+    public Result handle(NavKey key) {
+        if (!mInspecting) {
+            if (key == NavKey.ENTER || key == NavKey.SPACE) {
+                if (mBucket < 0 || !isValid(mBucket)) {
+                    mBucket = lastValid();
+                }
+                if (mBucket < 0) {
+                    return Result.IGNORED;
+                }
+                mInspecting = true;
+                return new Result(true, true, true, false, false);
+            }
+            return Result.IGNORED;
+        }
+        switch (key) {
+            case LEFT:
+                return move(mRtl ? 1 : -1);
+            case RIGHT:
+                return move(mRtl ? -1 : 1);
+            case PAGE_UP:
+                return jump(-mPageSize);
+            case PAGE_DOWN:
+                return jump(mPageSize);
+            case MOVE_HOME:
+                return moveTo(firstValid());
+            case MOVE_END:
+                return moveTo(lastValid());
+            case UP:
+                return switchSeries(-1);
+            case DOWN:
+                return switchSeries(1);
+            case ENTER:
+            case SPACE:
+                return new Result(true, false, false, false, true);
+            case ESCAPE:
+            case BACK:
+                mInspecting = false;
+                return new Result(true, false, false, true, false);
+            default:
+                return Result.IGNORED;
+        }
+    }
+
+    private Result move(int step) {
+        for (int i = mBucket + step; i >= 0 && i < bucketCount(); i += step) {
+            if (isValid(i)) {
+                return moveTo(i);
+            }
+        }
+        return Result.consumed(); // at an edge: stay, keep the key so focus does not escape
+    }
+
+    private Result jump(int delta) {
+        int target = Math.max(0, Math.min(bucketCount() - 1, mBucket + delta));
+        final int dir = delta < 0 ? -1 : 1;
+        // Nearest valid bucket at or beyond the target, else back toward the current one.
+        for (int i = target; i >= 0 && i < bucketCount(); i += dir) {
+            if (isValid(i)) {
+                return moveTo(i);
+            }
+        }
+        for (int i = target; i != mBucket; i -= dir) {
+            if (isValid(i)) {
+                return moveTo(i);
+            }
+        }
+        return Result.consumed();
+    }
+
+    private Result moveTo(int bucket) {
+        if (bucket < 0 || bucket == mBucket) {
+            return Result.consumed();
+        }
+        mBucket = bucket;
+        return new Result(true, true, false, false, false);
+    }
+
+    private Result switchSeries(int step) {
+        if (mValid.length <= 1) {
+            return Result.IGNORED;
+        }
+        final int next = mSeries + step;
+        if (next < 0 || next >= mValid.length) {
+            return Result.consumed();
+        }
+        mSeries = next;
+        if (mBucket >= bucketCount() || mBucket < 0 || !isValid(mBucket)) {
+            final int nearest = nearestValid(Math.max(0, mBucket));
+            if (nearest >= 0) {
+                mBucket = nearest;
+            }
+        }
+        return new Result(true, true, false, false, false);
+    }
+
+    private boolean isValid(int bucket) {
+        final boolean[] v = mValid[mSeries];
+        return bucket >= 0 && bucket < v.length && v[bucket];
+    }
+
+    private int firstValid() {
+        for (int i = 0; i < bucketCount(); i++) {
+            if (isValid(i)) {
+                return i;
+            }
+        }
+        return -1;
+    }
+
+    private int lastValid() {
+        for (int i = bucketCount() - 1; i >= 0; i--) {
+            if (isValid(i)) {
+                return i;
+            }
+        }
+        return -1;
+    }
+
+    private int nearestValid(int from) {
+        for (int d = 0; d < bucketCount(); d++) {
+            if (isValid(from - d)) {
+                return from - d;
+            }
+            if (isValid(from + d)) {
+                return from + d;
+            }
+        }
+        return -1;
+    }
+}
