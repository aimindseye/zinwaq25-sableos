+
+package com.android.settings.fuelgauge.sable.model;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.Paths;
+import org.junit.Test;
+
+/**
+ * Checks a real device battery profile file when one is named with
+ * {@code -Dsable.battery.profile=<path to <profile-id>.conf>}; does nothing otherwise. Device
+ * repositories run this against their own profile so the shipped data parses under the same
+ * rules Settings uses.
+ */
+public class ProfileFileCheckTest {
+    private static final long NOW = 1_790_000_000_000L;
+
+    @Test
+    public void namedProfileFileIsWellFormedAndFailsClosed() throws IOException {
+        final String path = System.getProperty("sable.battery.profile");
+        if (path == null || path.isEmpty()) {
+            return;
+        }
+        final Path p = Paths.get(path);
+        final String file = p.getFileName().toString();
+        assertTrue("file must be <profile-id>.conf", file.endsWith(".conf"));
+        final String id = file.substring(0, file.length() - ".conf".length());
+        final String text = new String(Files.readAllBytes(p), StandardCharsets.UTF_8);
+        final BatteryCapabilityProfile profile = BatteryProfileParser.parse(text, id);
+
+        assertFalse("schema/profile_id must match the file name", profile.isEmpty());
+        assertEquals("parse warnings: " + profile.warnings(), 0, profile.warnings().size());
+        for (String key : BatteryCapabilityProfile.CAPABILITY_KEYS) {
+            assertTrue("every capability key must be stated explicitly: " + key,
+                    text.contains("\n" + key + "=") || text.startsWith(key + "="));
+        }
+
+        // Whatever the profile says, BH6 stays closed.
+        final ChargingDiscovery anything = new ChargingDiscovery(true,
+                ChargingDiscovery.CHARGING_POLICY_ADAPTIVE_LONGLIFE, 580);
+        for (ChargingControl c : ChargingControl.values()) {
+            assertTrue(c.name(), ChargingControlPolicy.state(c, profile, anything)
+                    != ChargingControlPolicy.State.ENABLED);
+        }
+
+        // Strict facts the profile has no evidence for must fail closed even when Android
+        // reports plausible values.
+        final BatteryReadings plausible = BatteryReadings.builder()
+                .fullChargeUah(2_700_000).designCapacityUah(
+                        profile.specDesignCapacityMah() > 0
+                                ? profile.specDesignCapacityMah() * 1000L : 3_000_000L)
+                .stateOfHealthPercent(90).cycleCount(100).temperatureDeciC(300)
+                .healthStatus(BatteryReadings.HEALTH_GOOD).chargeCounterUah(1_000_000)
+                .manufacturingDateSec(1_735_689_600L).firstUseDateSec(1_740_787_200L)
+                .sampleTimeMillis(NOW).build();
+        final HealthReport report = BatteryHealthEvaluator.evaluate(plausible, profile, NOW);
+        for (FactKind k : FactKind.values()) {
+            if (k.isStrict() && profile.capability(k.profileKey()) != Capability.SUPPORTED) {
+                assertFalse(k.name(), report.fact(k).isAvailable());
+            }
+        }
+    }
+}
