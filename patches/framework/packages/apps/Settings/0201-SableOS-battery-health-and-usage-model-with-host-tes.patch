+ */
+
+package com.android.settings.fuelgauge.sable.model;
+
+/**
+ * Tri-state capability from a device profile. {@link #UNKNOWN} is the default for every key and
+ * means "no device evidence yet"; it never grants anything that {@link #SUPPORTED} grants.
+ */
+public enum Capability {
+    SUPPORTED,
+    UNSUPPORTED,
+    UNKNOWN;
+
+    /** Parses YES/SUPPORTED/TRUE, NO/UNSUPPORTED/FALSE; anything else is UNKNOWN (fail closed). */
+    public static Capability parse(String raw) {
+        if (raw == null) {
+            return UNKNOWN;
+        }
+        switch (raw.trim().toUpperCase(java.util.Locale.ROOT)) {
+            case "YES":
+            case "TRUE":
+            case "SUPPORTED":
+                return SUPPORTED;
+            case "NO":
+            case "FALSE":
+            case "UNSUPPORTED":
+                return UNSUPPORTED;
+            default:
+                return UNKNOWN;
+        }
+    }
+}
