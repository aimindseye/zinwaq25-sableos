+
+package com.android.settings.fuelgauge.sable.model;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.Test;
+
+public class ChartInspectionCursorTest {
+    private static boolean[] mask(String s) {
+        final boolean[] b = new boolean[s.length()];
+        for (int i = 0; i < s.length(); i++) {
+            b[i] = s.charAt(i) == 'x';
+        }
+        return b;
+    }
+
+    @Test
+    public void notInspectingLetsFocusMove() {
+        final ChartInspectionCursor c = new ChartInspectionCursor(
+                new boolean[][] {mask("xxxx")}, 2);
+        for (NavKey k : new NavKey[] {NavKey.UP, NavKey.DOWN, NavKey.LEFT, NavKey.RIGHT,
+                NavKey.ESCAPE, NavKey.BACK, NavKey.PAGE_DOWN}) {
+            assertFalse(k.name(), c.handle(k).consumed);
+        }
+        assertFalse(c.isInspecting());
+    }
+
+    @Test
+    public void enterStartsAtNewestValidBucket() {
+        final ChartInspectionCursor c = new ChartInspectionCursor(
+                new boolean[][] {mask("x.x..")}, 2);
+        final ChartInspectionCursor.Result r = c.handle(NavKey.ENTER);
+        assertTrue(r.consumed && r.entered);
+        assertEquals(2, c.bucket());
+    }
+
+    @Test
+    public void leftRightSkipEmptyAndStopAtEdges() {
+        final ChartInspectionCursor c = new ChartInspectionCursor(
+                new boolean[][] {mask("x.x.x")}, 2);
+        c.handle(NavKey.ENTER);
+        assertEquals(4, c.bucket());
+        assertTrue(c.handle(NavKey.LEFT).moved);
+        assertEquals(2, c.bucket());
+        c.handle(NavKey.LEFT);
+        assertEquals(0, c.bucket());
+        final ChartInspectionCursor.Result edge = c.handle(NavKey.LEFT);
+        assertTrue(edge.consumed);
+        assertFalse(edge.moved);
+        assertEquals(0, c.bucket());
+        c.handle(NavKey.RIGHT);
+        assertEquals(2, c.bucket());
+    }
+
+    @Test
+    public void rtlMirrorsLeftRight() {
+        final ChartInspectionCursor c = new ChartInspectionCursor(
+                new boolean[][] {mask("xxx")}, 1);
+        c.setRtl(true);
+        c.handle(NavKey.ENTER);
+        assertEquals(2, c.bucket());
+        c.handle(NavKey.RIGHT);
+        assertEquals(1, c.bucket());
+    }
+
+    @Test
+    public void pageAndHomeEnd() {
+        final ChartInspectionCursor c = new ChartInspectionCursor(
+                new boolean[][] {mask("xxxxxx.xxxxx")}, 6);
+        c.handle(NavKey.ENTER);
+        assertEquals(11, c.bucket());
+        c.handle(NavKey.PAGE_UP);
+        assertEquals(5, c.bucket());
+        c.handle(NavKey.PAGE_UP);
+        assertEquals(0, c.bucket());
+        c.handle(NavKey.PAGE_DOWN);
+        assertEquals(7, c.bucket()); // 6 is empty: next valid beyond the target
+        c.handle(NavKey.MOVE_HOME);
+        assertEquals(0, c.bucket());
+        c.handle(NavKey.MOVE_END);
+        assertEquals(11, c.bucket());
+    }
+
+    @Test
+    public void escapeExitsAndKeepsPosition() {
+        final ChartInspectionCursor c = new ChartInspectionCursor(
+                new boolean[][] {mask("xxx")}, 1);
+        c.handle(NavKey.ENTER);
+        c.handle(NavKey.LEFT);
+        final ChartInspectionCursor.Result r = c.handle(NavKey.ESCAPE);
+        assertTrue(r.consumed && r.exited);
+        assertFalse(c.isInspecting());
+        assertEquals(1, c.bucket());
+        c.handle(NavKey.ENTER);
+        assertEquals(1, c.bucket());
+        assertTrue(c.handle(NavKey.BACK).exited);
+    }
+
+    @Test
+    public void seriesSwitchOnlyWithSeveralSeries() {
+        final ChartInspectionCursor one = new ChartInspectionCursor(
+                new boolean[][] {mask("xx")}, 1);
+        one.handle(NavKey.ENTER);
+        assertFalse(one.handle(NavKey.UP).consumed);
+        assertFalse(one.handle(NavKey.DOWN).consumed);
+
+        final ChartInspectionCursor two = new ChartInspectionCursor(
+                new boolean[][] {mask("xx.."), mask("xxxx")}, 1);
+        two.handle(NavKey.ENTER);
+        assertEquals(1, two.bucket());
+        assertTrue(two.handle(NavKey.DOWN).moved);
+        assertEquals(1, two.series());
+        two.handle(NavKey.MOVE_END);
+        assertEquals(3, two.bucket());
+        two.handle(NavKey.UP);
+        assertEquals(0, two.series());
+        assertEquals(1, two.bucket()); // nearest valid in series 0
+        assertTrue(two.handle(NavKey.UP).consumed); // edge, still inside
+    }
+
+    @Test
+    public void noDataNeverTraps() {
+        final ChartInspectionCursor c = new ChartInspectionCursor(
+                new boolean[][] {mask("....")}, 1);
+        assertFalse(c.handle(NavKey.ENTER).consumed);
+        assertFalse(c.isInspecting());
+        assertEquals(-1, c.bucket());
+    }
+
+    @Test
+    public void enterWhileInspectingConfirms() {
+        final ChartInspectionCursor c = new ChartInspectionCursor(
+                new boolean[][] {mask("xx")}, 1);
+        c.handle(NavKey.ENTER);
+        assertTrue(c.handle(NavKey.SPACE).confirmed);
+        assertTrue(c.isInspecting());
+    }
+
+    @Test
+    public void touchSelectAndDataRefresh() {
+        final ChartInspectionCursor c = new ChartInspectionCursor(
+                new boolean[][] {mask("x.x")}, 1);
+        assertFalse(c.select(1));
+        assertTrue(c.select(0));
+        assertEquals(0, c.bucket());
+        c.handle(NavKey.ENTER);
+        c.setData(new boolean[][] {mask("..x")});
+        assertEquals(2, c.bucket());
+        c.setData(new boolean[][] {mask("...")});
+        assertFalse(c.isInspecting());
+    }
+}
