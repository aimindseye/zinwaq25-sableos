+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.settings.fuelgauge.sable.model;
+
+import java.util.Arrays;
+
+/**
+ * Locale-free description of how one fact row reads. The Settings glue maps {@link #template}
+ * to a string resource and formats {@link #args} with the user's locale. Unavailable facts only
+ * ever map to a NOT_* / IMPLAUSIBLE template and carry no arguments.
+ */
+public final class FactText {
+    /** Row templates; each maps to exactly one string resource. */
+    public enum Template {
+        /** args: mAh. */
+        CAPACITY_MAH,
+        /** args: percent. */
+        CAPACITY_PERCENT,
+        /** args: cycles. */
+        CYCLES,
+        /** args: tenths of a degree Celsius, TemperatureClass ordinal. */
+        TEMPERATURE,
+        /** args: BatteryReadings.HEALTH_* value. */
+        HEALTH_STATUS,
+        /** args: year, month (1-12). */
+        MONTH_YEAR,
+        /** args: year, month (1-12), elapsed whole years, elapsed remaining months. */
+        MONTH_YEAR_WITH_AGE,
+        NOT_REPORTED,
+        NOT_SUPPORTED,
+        NOT_QUALIFIED,
+        IMPLAUSIBLE
+    }
+
+    public final Template template;
+    public final long[] args;
+    /** Source/confidence line; null when the fact is unavailable. */
+    public final FactSource source;
+    public final FactConfidence confidence;
+
+    FactText(Template template, FactSource source, FactConfidence confidence, long... args) {
+        this.template = template;
+        this.source = source;
+        this.confidence = confidence;
+        this.args = args;
+    }
+
+    public boolean showsValue() {
+        return source != null;
+    }
+
+    @Override
+    public String toString() {
+        return template + Arrays.toString(args) + (source == null ? "" : " " + source + "/"
+                + confidence);
+    }
+}
diff --git a/src/com/android/settings/fuelgauge/sable/model/HealthFact.java b/src/com/android/settings/fuelgauge/sable/model/HealthFact.java
