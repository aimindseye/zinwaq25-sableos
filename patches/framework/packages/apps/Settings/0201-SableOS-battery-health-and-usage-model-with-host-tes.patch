+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.settings.fuelgauge.sable.model;
+
+import java.util.List;
+
+/** Aggregates history samples into chart buckets. Empty buckets stay empty (no interpolation). */
+public final class HistoryBuckets {
+    /** Series ids for the history chart. */
+    public static final int SERIES_TEMPERATURE = 0;
+    public static final int SERIES_LEVEL = 1;
+    public static final int SERIES_COUNT = 2;
+
+    /** One bucket. Values are {@link HistorySample#NO_TEMPERATURE} / NO_LEVEL when empty. */
+    public static final class Bucket {
+        public final long startMillis;
+        public final long endMillis;
+        public final int sampleCount;
+        public final int averageTemperatureDeciC;
+        public final int maxTemperatureDeciC;
+        public final int lastLevelPercent;
+        public final boolean anyCharging;
+
+        Bucket(long startMillis, long endMillis, int sampleCount, int averageTemperatureDeciC,
+                int maxTemperatureDeciC, int lastLevelPercent, boolean anyCharging) {
+            this.startMillis = startMillis;
+            this.endMillis = endMillis;
+            this.sampleCount = sampleCount;
+            this.averageTemperatureDeciC = averageTemperatureDeciC;
+            this.maxTemperatureDeciC = maxTemperatureDeciC;
+            this.lastLevelPercent = lastLevelPercent;
+            this.anyCharging = anyCharging;
+        }
+
+        public boolean hasValue(int series) {
+            return series == SERIES_TEMPERATURE
+                    ? averageTemperatureDeciC != HistorySample.NO_TEMPERATURE
+                    : lastLevelPercent != HistorySample.NO_LEVEL;
+        }
+    }
+
+    private HistoryBuckets() {}
+
+    public static Bucket[] bucketize(List<HistorySample> samples, HistoryRange.Window w) {
+        final Bucket[] out = new Bucket[w.bucketCount];
+        for (int i = 0; i < w.bucketCount; i++) {
+            final long start = w.bucketStart(i);
+            final long end = start + w.bucketMillis;
+            int count = 0;
+            int tempCount = 0;
+            long tempSum = 0;
+            int tempMax = HistorySample.NO_TEMPERATURE;
+            int level = HistorySample.NO_LEVEL;
+            boolean charging = false;
+            for (HistorySample s : samples) {
+                if (s.timeMillis < start || s.timeMillis >= end) {
+                    continue;
+                }
+                count++;
+                if (s.hasTemperature()) {
+                    tempCount++;
+                    tempSum += s.temperatureDeciC;
+                    tempMax = tempMax == HistorySample.NO_TEMPERATURE
+                            ? s.temperatureDeciC : Math.max(tempMax, s.temperatureDeciC);
+                }
+                if (s.hasLevel()) {
+                    level = s.levelPercent; // samples are oldest first: keep the last
+                }
+                charging |= s.charging;
+            }
+            final int avg = tempCount == 0 ? HistorySample.NO_TEMPERATURE
+                    : (int) Math.round((double) tempSum / tempCount);
+            out[i] = new Bucket(start, end, count, avg, tempMax, level, charging);
+        }
+        return out;
+    }
+
+    /** Which buckets have a value for {@code series}; feeds ChartInspectionCursor. */
+    public static boolean[] validity(Bucket[] buckets, int series) {
+        final boolean[] v = new boolean[buckets.length];
+        for (int i = 0; i < buckets.length; i++) {
+            v[i] = buckets[i].hasValue(series);
+        }
+        return v;
+    }
+}
