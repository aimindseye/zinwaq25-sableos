+import org.junit.Test;
+
+public class ListFocusNavigatorTest {
+    // index: 0 header (not focusable), 1..5 rows, 6 footer (not focusable), 7..9 rows
+    private static final boolean[] F = {false, true, true, true, true, true, false, true, true,
+            true};
+
+    @Test
+    public void homeEnd() {
+        assertEquals(1, ListFocusNavigator.target(NavKey.MOVE_HOME, F, 5, 3));
+        assertEquals(9, ListFocusNavigator.target(NavKey.MOVE_END, F, 1, 3));
+    }
+
+    @Test
+    public void pages() {
+        assertEquals(4, ListFocusNavigator.target(NavKey.PAGE_DOWN, F, 1, 3));
+        assertEquals(5, ListFocusNavigator.target(NavKey.PAGE_DOWN, F, 3, 3)); // 6 skipped back
+        assertEquals(7, ListFocusNavigator.target(NavKey.PAGE_DOWN, F, 5, 1));
+        assertEquals(-1, ListFocusNavigator.target(NavKey.PAGE_DOWN, F, 9, 3));
+        assertEquals(5, ListFocusNavigator.target(NavKey.PAGE_UP, F, 8, 3));
+        assertEquals(1, ListFocusNavigator.target(NavKey.PAGE_UP, F, 2, 3));
+        assertEquals(-1, ListFocusNavigator.target(NavKey.PAGE_UP, F, 1, 3));
+        assertEquals(1, ListFocusNavigator.target(NavKey.PAGE_DOWN, F, -1, 3));
+    }
+
+    @Test
+    public void otherKeysIgnored() {
+        assertEquals(-1, ListFocusNavigator.target(NavKey.DOWN, F, 1, 3));
+        assertEquals(-1, ListFocusNavigator.target(NavKey.MOVE_HOME, new boolean[3], 0, 3));
+    }
