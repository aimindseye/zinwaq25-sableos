+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNull;
+
+import java.util.Arrays;
+import java.util.Collections;
+import org.junit.Test;
+
+public class UsageSummaryTest {
+    @Test
+    public void topSharesOfOneDenominator() {
+        final UsageSummary s = UsageSummary.build(1000, 2000, 100.0, Arrays.asList(
+                new UsageSummary.Component(1, 10.0),
+                new UsageSummary.Component(0, 24.0),
+                new UsageSummary.Component(8, 17.4),
+                new UsageSummary.Component(3, 0.2)), 2, 1);
+        assertEquals(2, s.shares.size());
+        assertEquals(0, s.shares.get(0).componentId);
+        assertEquals(24, s.shares.get(0).percent);
+        assertEquals(8, s.shares.get(1).componentId);
+        assertEquals(17, s.shares.get(1).percent);
+        assertEquals(1000L, s.windowStartMillis);
+    }
+
+    @Test
+    public void smallSharesDroppedAndCapped() {
+        final UsageSummary s = UsageSummary.build(1000, 2000, 10.0, Arrays.asList(
+                new UsageSummary.Component(0, 50.0), new UsageSummary.Component(1, 0.01)),
+                3, 1);
+        assertEquals(1, s.shares.size());
+        assertEquals(100, s.shares.get(0).percent);
+    }
+
+    @Test
+    public void unusableInputsGiveNull() {
+        assertNull(UsageSummary.build(0, 2000, 10.0, Collections.emptyList(), 2, 1));
+        assertNull(UsageSummary.build(2000, 1000, 10.0, Collections.emptyList(), 2, 1));
+        assertNull(UsageSummary.build(1000, 2000, 0.0, Collections.emptyList(), 2, 1));
+        assertNull(UsageSummary.build(1000, 2000, Double.NaN, Collections.emptyList(), 2, 1));
+    }
+
+    @Test
+    public void tiesAreDeterministic() {
+        final UsageSummary s = UsageSummary.build(1, 2, 10.0, Arrays.asList(
+                new UsageSummary.Component(5, 2.0), new UsageSummary.Component(2, 2.0),
+                new UsageSummary.Component(9, Double.NaN)), 2, 1);
+        assertEquals(2, s.shares.get(0).componentId);
+        assertEquals(5, s.shares.get(1).componentId);
+    }
+}
