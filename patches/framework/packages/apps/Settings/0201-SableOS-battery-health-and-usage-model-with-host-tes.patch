+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.settings.fuelgauge.sable.model;
+
+/**
+ * A raw snapshot of what Android reported, as read by the Settings glue from the sticky
+ * ACTION_BATTERY_CHANGED broadcast and BatteryManager properties. No interpretation happens
+ * here; {@link BatteryHealthEvaluator} decides what may be shown.
+ *
+ * <p>Every field uses {@link #MISSING} when Android did not report it. Callers must pass
+ * MISSING for Integer.MIN_VALUE / Long.MIN_VALUE property results and for absent extras.
+ */
+public final class BatteryReadings {
+    /** Marker for "not reported". */
+    public static final long MISSING = Long.MIN_VALUE;
+
+    /** Mirrors android.os.BatteryManager.BATTERY_HEALTH_* (kept here so the model is pure). */
+    public static final int HEALTH_UNKNOWN = 1;
+    public static final int HEALTH_GOOD = 2;
+    public static final int HEALTH_OVERHEAT = 3;
+    public static final int HEALTH_DEAD = 4;
+    public static final int HEALTH_OVER_VOLTAGE = 5;
+    public static final int HEALTH_UNSPECIFIED_FAILURE = 6;
+    public static final int HEALTH_COLD = 7;
+
+    public final long fullChargeUah;
+    public final long designCapacityUah;
+    public final long stateOfHealthPercent;
+    public final long cycleCount;
+    public final long temperatureDeciC;
+    public final long healthStatus;
+    public final long chargeCounterUah;
+    public final long manufacturingDateSec;
+    public final long firstUseDateSec;
+    public final long levelPercent;
+    public final boolean charging;
+    public final long sampleTimeMillis;
+
+    private BatteryReadings(Builder b) {
+        fullChargeUah = b.mFullChargeUah;
+        designCapacityUah = b.mDesignCapacityUah;
+        stateOfHealthPercent = b.mStateOfHealthPercent;
+        cycleCount = b.mCycleCount;
+        temperatureDeciC = b.mTemperatureDeciC;
+        healthStatus = b.mHealthStatus;
+        chargeCounterUah = b.mChargeCounterUah;
+        manufacturingDateSec = b.mManufacturingDateSec;
+        firstUseDateSec = b.mFirstUseDateSec;
+        levelPercent = b.mLevelPercent;
+        charging = b.mCharging;
+        sampleTimeMillis = b.mSampleTimeMillis;
+    }
+
+    /** Normalizes an int property/extra result: Integer.MIN_VALUE becomes MISSING. */
+    public static long fromInt(int value) {
+        return value == Integer.MIN_VALUE ? MISSING : value;
+    }
+
+    public static Builder builder() {
+        return new Builder();
+    }
+
+    /** Builder; every field starts as MISSING. */
+    public static final class Builder {
+        private long mFullChargeUah = MISSING;
+        private long mDesignCapacityUah = MISSING;
+        private long mStateOfHealthPercent = MISSING;
+        private long mCycleCount = MISSING;
+        private long mTemperatureDeciC = MISSING;
+        private long mHealthStatus = MISSING;
+        private long mChargeCounterUah = MISSING;
+        private long mManufacturingDateSec = MISSING;
+        private long mFirstUseDateSec = MISSING;
+        private long mLevelPercent = MISSING;
+        private boolean mCharging;
+        private long mSampleTimeMillis;
+
+        public Builder fullChargeUah(long v) { mFullChargeUah = v; return this; }
+        public Builder designCapacityUah(long v) { mDesignCapacityUah = v; return this; }
+        public Builder stateOfHealthPercent(long v) { mStateOfHealthPercent = v; return this; }
+        public Builder cycleCount(long v) { mCycleCount = v; return this; }
+        public Builder temperatureDeciC(long v) { mTemperatureDeciC = v; return this; }
+        public Builder healthStatus(long v) { mHealthStatus = v; return this; }
+        public Builder chargeCounterUah(long v) { mChargeCounterUah = v; return this; }
+        public Builder manufacturingDateSec(long v) { mManufacturingDateSec = v; return this; }
+        public Builder firstUseDateSec(long v) { mFirstUseDateSec = v; return this; }
+        public Builder levelPercent(long v) { mLevelPercent = v; return this; }
+        public Builder charging(boolean v) { mCharging = v; return this; }
+        public Builder sampleTimeMillis(long v) { mSampleTimeMillis = v; return this; }
+
+        public BatteryReadings build() {
+            return new BatteryReadings(this);
+        }
+    }
+}
