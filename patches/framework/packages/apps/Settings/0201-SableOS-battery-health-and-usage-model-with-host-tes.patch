+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.settings.fuelgauge.sable.model;
+
+import java.time.Instant;
+import java.time.ZoneId;
+import java.time.ZonedDateTime;
+import java.time.temporal.ChronoUnit;
+
+/**
+ * Time ranges for the local history chart. Every range is labelled in the UI with its exact
+ * window, so values from different windows are never presented as comparable.
+ */
+public enum HistoryRange {
+    /** Local midnight to now, hourly buckets. */
+    TODAY,
+    /** Rolling 24 hours ending at the next full hour, hourly buckets. */
+    LAST_24_HOURS,
+    /** Rolling 7 days ending at the next full hour, 12-hour buckets. */
+    LAST_7_DAYS;
+
+    /** The bucket layout for this range at {@code nowMillis}. */
+    public Window window(long nowMillis, ZoneId zone) {
+        final long hour = HistoryRingBuffer.HOUR_MILLIS;
+        final long end = ((nowMillis / hour) + 1) * hour;
+        switch (this) {
+            case TODAY: {
+                final ZonedDateTime midnight = Instant.ofEpochMilli(nowMillis).atZone(zone)
+                        .truncatedTo(ChronoUnit.DAYS);
+                final long start = midnight.toInstant().toEpochMilli();
+                final int count = (int) Math.max(1, (end - start + hour - 1) / hour);
+                return new Window(end - count * hour, hour, count);
+            }
+            case LAST_24_HOURS:
+                return new Window(end - 24 * hour, hour, 24);
+            case LAST_7_DAYS:
+            default:
+                return new Window(end - 14 * 12 * hour, 12 * hour, 14);
+        }
+    }
+
+    /** A contiguous run of equal buckets. */
+    public static final class Window {
+        public final long startMillis;
+        public final long bucketMillis;
+        public final int bucketCount;
+
+        Window(long startMillis, long bucketMillis, int bucketCount) {
+            this.startMillis = startMillis;
+            this.bucketMillis = bucketMillis;
+            this.bucketCount = bucketCount;
+        }
+
+        public long endMillis() {
+            return startMillis + bucketMillis * bucketCount;
+        }
+
+        public long bucketStart(int i) {
+            return startMillis + bucketMillis * i;
+        }
+    }
+}
diff --git a/src/com/android/settings/fuelgauge/sable/model/HistoryRingBuffer.java b/src/com/android/settings/fuelgauge/sable/model/HistoryRingBuffer.java
new file mode 100644
index 0000000..33a27e4
--- /dev/null
+++ b/src/com/android/settings/fuelgauge/sable/model/HistoryRingBuffer.java
@@ -0,0 +1,196 @@
+/*
+ * Copyright (C) 2026 The SableOS Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.settings.fuelgauge.sable.model;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Bounded, local-only battery history (BH4).
+ *
+ * <p>Sampling policy, justified against power cost: Settings already wakes once an hour for
+ * Android's own battery-usage snapshot (PeriodicJobReceiver). A sample is taken only then and
+ * when a Battery screen is opened, so the feature adds no alarm, no wakelock, no service and no
+ * polling. Samples closer than {@link #MIN_INTERVAL_MILLIS} are dropped, history older than
+ * {@link #RETENTION_MILLIS} is pruned, and the ring never holds more than {@link #CAPACITY}
+ * samples (about 10 KB encoded). Nothing leaves the device.
+ */
+public final class HistoryRingBuffer {
+    public static final long HOUR_MILLIS = 60L * 60 * 1000;
+    public static final long RETENTION_MILLIS = 7L * 24 * HOUR_MILLIS;
+    public static final long MIN_INTERVAL_MILLIS = 30L * 60 * 1000;
+    /** Worst case: one sample per MIN_INTERVAL over the whole retention window. */
+    public static final int CAPACITY = (int) (RETENTION_MILLIS / MIN_INTERVAL_MILLIS);
+    /** A backwards clock jump larger than this resets history instead of mixing timelines. */
+    static final long CLOCK_RESET_MILLIS = 24L * HOUR_MILLIS;
+
+    static final String HEADER = "sable-battery-history-v1";
+
+    private final int mCapacity;
+    private final HistorySample[] mRing;
+    private int mStart;
+    private int mSize;
+
+    public HistoryRingBuffer() {
+        this(CAPACITY);
+    }
+
+    public HistoryRingBuffer(int capacity) {
+        if (capacity <= 0) {
+            throw new IllegalArgumentException("capacity");
+        }
+        mCapacity = capacity;
+        mRing = new HistorySample[capacity];
+    }
+
+    public int size() {
+        return mSize;
+    }
+
+    public int capacity() {
+        return mCapacity;
+    }
+
+    private HistorySample get(int i) {
+        return mRing[(mStart + i) % mCapacity];
+    }
+
+    /** Newest sample or null. */
+    public HistorySample newest() {
+        return mSize == 0 ? null : get(mSize - 1);
+    }
+
+    /**
+     * Adds a sample. Returns false (and changes nothing) when it is closer than
+     * MIN_INTERVAL_MILLIS to the newest sample. A large backwards clock jump clears history.
+     */
+    public boolean add(HistorySample s) {
+        final HistorySample last = newest();
+        if (last != null) {
+            if (s.timeMillis < last.timeMillis - CLOCK_RESET_MILLIS) {
+                clear();
+            } else if (s.timeMillis < last.timeMillis + MIN_INTERVAL_MILLIS) {
+                return false;
+            }
+        }
+        if (mSize == mCapacity) {
+            mRing[mStart] = s;
+            mStart = (mStart + 1) % mCapacity;
+        } else {
+            mRing[(mStart + mSize) % mCapacity] = s;
+            mSize++;
+        }
+        return true;
+    }
+
+    public void clear() {
+        java.util.Arrays.fill(mRing, null);
+        mStart = 0;
+        mSize = 0;
+    }
+
+    /** Drops samples older than the retention window or more than an hour in the future. */
+    public void prune(long nowMillis) {
+        final List<HistorySample> keep = new ArrayList<>();
+        for (HistorySample s : toList()) {
+            if (s.timeMillis >= nowMillis - RETENTION_MILLIS
+                    && s.timeMillis <= nowMillis + HOUR_MILLIS) {
+                keep.add(s);
+            }
+        }
+        if (keep.size() != mSize) {
+            clear();
+            for (HistorySample s : keep) {
+                append(s);
+            }
+        }
+    }
+
+    private void append(HistorySample s) {
+        if (mSize == mCapacity) {
+            mRing[mStart] = s;
+            mStart = (mStart + 1) % mCapacity;
+        } else {
+            mRing[(mStart + mSize) % mCapacity] = s;
+            mSize++;
+        }
+    }
+
+    /** Samples oldest first. */
+    public List<HistorySample> toList() {
+        final List<HistorySample> out = new ArrayList<>(mSize);
+        for (int i = 0; i < mSize; i++) {
+            out.add(get(i));
+        }
+        return out;
+    }
+
+    /** Compact text encoding: a header line, then one {@code time,level,temp,charging} line. */
+    public String encode() {
+        final StringBuilder sb = new StringBuilder(HEADER).append('\n');
+        for (HistorySample s : toList()) {
+            sb.append(s.timeMillis).append(',').append(s.levelPercent).append(',')
+                    .append(s.hasTemperature() ? Integer.toString(s.temperatureDeciC) : "-")
+                    .append(',').append(s.charging ? '1' : '0').append('\n');
+        }
+        return sb.toString();
+    }
+
+    /**
+     * Decodes {@link #encode()} output. A wrong header gives an empty buffer; malformed or
+     * out-of-order lines are skipped; only the newest {@code capacity} samples are kept.
+     */
+    public static HistoryRingBuffer decode(String text, int capacity) {
+        final HistoryRingBuffer buf = new HistoryRingBuffer(capacity);
+        if (text == null) {
+            return buf;
+        }
+        final String[] lines = text.split("\n");
+        if (lines.length == 0 || !HEADER.equals(lines[0].trim())) {
+            return buf;
+        }
+        long lastTime = Long.MIN_VALUE;
+        for (int i = 1; i < lines.length; i++) {
+            final String[] parts = lines[i].trim().split(",");
+            if (parts.length != 4) {
+                continue;
+            }
+            try {
+                final long t = Long.parseLong(parts[0]);
+                final int level = Integer.parseInt(parts[1]);
+                final int temp = "-".equals(parts[2]) ? HistorySample.NO_TEMPERATURE
+                        : Integer.parseInt(parts[2]);
+                if (!"0".equals(parts[3]) && !"1".equals(parts[3])) {
+                    continue;
+                }
+                if (t <= lastTime) {
+                    continue;
+                }
+                if (temp != HistorySample.NO_TEMPERATURE
+                        && (temp < BatteryHealthEvaluator.MIN_PLAUSIBLE_TEMP_DECI_C
+                        || temp > BatteryHealthEvaluator.MAX_PLAUSIBLE_TEMP_DECI_C)) {
+                    continue;
+                }
+                buf.append(new HistorySample(t, level, temp, "1".equals(parts[3])));
+                lastTime = t;
+            } catch (NumberFormatException e) {
+                // skip
+            }
+        }
+        return buf;
+    }
+}
