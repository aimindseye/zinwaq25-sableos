+
+package com.android.settings.fuelgauge.sable.model;
+
+/**
+ * Coarse, text-labelled temperature classification. It is guidance for the user, not a
+ * safety guarantee: thresholds are generic and tighten when the platform exposes a
+ * device-specific limit (config_shutdownBatteryTemperature).
+ */
+public enum TemperatureClass {
+    NORMAL,
+    WARM,
+    HOT;
+
+    /** Generic hot threshold when the device exposes no limit: 45.0 C. */
+    static final int GENERIC_HOT_DECI_C = 450;
+    /** Warm starts this far below hot. */
+    static final int WARM_MARGIN_DECI_C = 50;
+    /** With a device shutdown limit, hot starts this far below it... */
+    static final int SHUTDOWN_MARGIN_DECI_C = 100;
+    /** ...but never outside these bounds. */
+    static final int MIN_HOT_DECI_C = 400;
+    static final int MAX_HOT_DECI_C = 500;
+
+    /** Threshold (tenths of C) at or above which the battery reads HOT. */
+    public static int hotThresholdDeciC(int shutdownDeciC) {
+        if (shutdownDeciC <= 0) {
+            return GENERIC_HOT_DECI_C;
+        }
+        final int t = shutdownDeciC - SHUTDOWN_MARGIN_DECI_C;
+        return Math.max(MIN_HOT_DECI_C, Math.min(MAX_HOT_DECI_C, t));
+    }
+
+    /** Classifies {@code deciC}; {@code shutdownDeciC} is 0 or negative when unknown. */
+    public static TemperatureClass classify(long deciC, int shutdownDeciC) {
+        final int hot = hotThresholdDeciC(shutdownDeciC);
+        if (deciC >= hot) {
+            return HOT;
+        }
+        if (deciC >= hot - WARM_MARGIN_DECI_C) {
+            return WARM;
+        }
+        return NORMAL;
+    }
+}
diff --git a/src/com/android/settings/fuelgauge/sable/model/TypeAheadMatcher.java b/src/com/android/settings/fuelgauge/sable/model/TypeAheadMatcher.java
new file mode 100644
index 0000000..2ce6861
--- /dev/null
+++ b/src/com/android/settings/fuelgauge/sable/model/TypeAheadMatcher.java
@@ -0,0 +1,159 @@
+/*
+ * Copyright (C) 2026 The SableOS Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.settings.fuelgauge.sable.model;
+
+import java.text.Normalizer;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.Locale;
+
+/**
+ * Settings type-ahead focus navigation (KEYBOARD_FIRST_SETTINGS_UX "Type-ahead focus
+ * navigation"): printable letters build a short-lived buffer that moves focus to the best
+ * matching row of the current screen. Case- and accent-insensitive, wraps, 800 ms timeout.
+ *
+ * <p>Ranking for a buffer: rows with an alias starting with the buffer, then rows whose title
+ * starts with it, then rows with any title word starting with it; ties keep screen order.
+ * Repeating one letter cycles through that letter's matches. With the Battery aliases this
+ * gives U to Battery usage, H to Battery health, C to Charging and protection and B to
+ * Battery saver, as the design requires, without Battery-specific key handling.
+ */
+public final class TypeAheadMatcher {
+    public static final long TIMEOUT_MILLIS = 800;
+
+    /** A focusable row: its title and alias list. */
+    public static final class Row {
+        final String title;
+        final List<String> aliases;
+
+        public Row(String title, List<String> aliases) {
+            this.title = normalize(title);
+            final List<String> a = new ArrayList<>();
+            if (aliases != null) {
+                for (String s : aliases) {
+                    final String n = normalize(s);
+                    if (!n.isEmpty()) {
+                        a.add(n);
+                    }
+                }
+            }
+            this.aliases = Collections.unmodifiableList(a);
+        }
+    }
+
+    private final StringBuilder mBuffer = new StringBuilder();
+    private long mLastKeyMillis = Long.MIN_VALUE;
+
+    /** Case-folds and strips accents. */
+    public static String normalize(String s) {
+        if (s == null) {
+            return "";
+        }
+        final String decomposed = Normalizer.normalize(s, Normalizer.Form.NFD);
+        return decomposed.replaceAll("\\p{M}+", "").toLowerCase(Locale.ROOT).trim();
+    }
+
+    /** Clears the buffer (focus moved by other means, screen changed). */
+    public void reset() {
+        mBuffer.setLength(0);
+        mLastKeyMillis = Long.MIN_VALUE;
+    }
+
+    public String buffer() {
+        return mBuffer.toString();
+    }
+
+    /**
+     * Feeds one printable character. Returns the row index to focus, or -1 for no match (focus
+     * stays). {@code currentIndex} is the focused row, -1 when none.
+     */
+    public int onChar(char c, long nowMillis, List<Row> rows, int currentIndex) {
+        if (!Character.isLetterOrDigit(c) && c != ' ') {
+            return -1;
+        }
+        if (mLastKeyMillis == Long.MIN_VALUE || nowMillis - mLastKeyMillis > TIMEOUT_MILLIS) {
+            mBuffer.setLength(0);
+        }
+        mLastKeyMillis = nowMillis;
+        final String ch = c == ' ' ? " " : normalize(String.valueOf(c));
+        if (ch.isEmpty() || (c == ' ' && mBuffer.length() == 0)) {
+            return -1;
+        }
+        // Repeating one letter cycles that letter's matches instead of growing "bbb".
+        final boolean repeat = mBuffer.length() > 0 && allSame(mBuffer, ch.charAt(0));
+        if (!repeat) {
+            mBuffer.append(ch);
+        }
+        final String query = repeat ? ch : mBuffer.toString();
+        final List<Integer> matches = ranked(query, rows);
+        if (matches.isEmpty()) {
+            return -1;
+        }
+        if (repeat) {
+            // The buffer stays one letter, so "s s y" still means "sy".
+            final int pos = matches.indexOf(currentIndex);
+            return matches.get(pos < 0 ? 0 : (pos + 1) % matches.size());
+        }
+        // A growing buffer keeps the current row if it still matches best-or-equal.
+        if (mBuffer.length() > 1 && matches.contains(currentIndex)
+                && rank(query, rows.get(currentIndex)) == rank(query, rows.get(matches.get(0)))) {
+            return currentIndex;
+        }
+        return matches.get(0);
+    }
+
+    private static boolean allSame(CharSequence s, char c) {
+        for (int i = 0; i < s.length(); i++) {
+            if (s.charAt(i) != c) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    /** Matching row indices, best first. */
+    static List<Integer> ranked(String query, List<Row> rows) {
+        final List<Integer> out = new ArrayList<>();
+        for (int r = 0; r <= 2; r++) {
+            for (int i = 0; i < rows.size(); i++) {
+                if (rank(query, rows.get(i)) == r) {
+                    out.add(i);
+                }
+            }
+        }
+        return out;
+    }
+
+    /** 0 alias prefix, 1 title prefix, 2 title word prefix, 3 no match. */
+    static int rank(String query, Row row) {
+        for (String a : row.aliases) {
+            if (a.startsWith(query)) {
+                return 0;
+            }
+        }
+        if (row.title.startsWith(query)) {
+            return 1;
+        }
+        for (String word : row.title.split("[\\s&,/-]+")) {
+            if (!word.isEmpty() && word.startsWith(query)) {
+                return 2;
+            }
+        }
+        return 3;
+    }
+}
