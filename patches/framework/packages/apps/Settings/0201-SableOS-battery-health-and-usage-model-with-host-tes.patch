diff --git a/tests/sable-battery/src/com/android/settings/fuelgauge/sable/model/BatteryHealthEvaluatorTest.java b/tests/sable-battery/src/com/android/settings/fuelgauge/sable/model/BatteryHealthEvaluatorTest.java
new file mode 100644
index 0000000..a7fc89d
--- /dev/null
+++ b/tests/sable-battery/src/com/android/settings/fuelgauge/sable/model/BatteryHealthEvaluatorTest.java
@@ -0,0 +1,208 @@
+/*
+ * Copyright (C) 2026 The SableOS Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.settings.fuelgauge.sable.model;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.Test;
+
+public class BatteryHealthEvaluatorTest {
+    private static final long NOW = 1_790_000_000_000L; // 2026-09
+    private static final long JAN_2025 = 1_735_689_600L;
+    private static final long MAR_2025 = 1_740_787_200L;
+
+    private static BatteryReadings.Builder full() {
+        return BatteryReadings.builder()
+                .fullChargeUah(2_760_000).designCapacityUah(3_000_000)
+                .cycleCount(412).temperatureDeciC(312)
+                .healthStatus(BatteryReadings.HEALTH_GOOD).chargeCounterUah(1_500_000)
+                .manufacturingDateSec(JAN_2025).firstUseDateSec(MAR_2025)
+                .levelPercent(74).sampleTimeMillis(NOW);
+    }
+
+    @Test
+    public void emptyProfileShowsOnlyNonStrictFacts() {
+        final HealthReport r = BatteryHealthEvaluator.evaluate(full().build(),
+                BatteryCapabilityProfile.EMPTY, NOW);
+        assertTrue(r.fact(FactKind.TEMPERATURE).isAvailable());
+        assertTrue(r.fact(FactKind.HEALTH_STATUS).isAvailable());
+        for (FactKind k : FactKind.values()) {
+            if (k.isStrict()) {
+                assertFalse(k.name(), r.fact(k).isAvailable());
+                assertEquals(k.name(), UnavailableReason.NOT_QUALIFIED, r.fact(k).reason());
+                assertEquals(0L, r.fact(k).value());
+            }
+        }
+        assertEquals(HealthReport.Coverage.PARTIAL, r.coverage());
+    }
+
+    @Test
+    public void unknownProfileNeverShowsCapacityOrCycles() {
+        // FABRICATED_MAX_CAPACITY / FABRICATED_CYCLE_COUNT: even with plausible values.
+        final BatteryCapabilityProfile p = TestProfiles.of("health_capacity_supported=UNKNOWN",
+                "health_cycle_count_supported=UNKNOWN");
+        final HealthReport r = BatteryHealthEvaluator.evaluate(full().build(), p, NOW);
+        assertFalse(r.fact(FactKind.CAPACITY_HEALTH).isAvailable());
+        assertFalse(r.fact(FactKind.MAXIMUM_CAPACITY).isAvailable());
+        assertFalse(r.fact(FactKind.CYCLE_COUNT).isAvailable());
+    }
+
+    @Test
+    public void supportedProfileShowsEverythingWithSources() {
+        final HealthReport r = BatteryHealthEvaluator.evaluate(full().build(),
+                TestProfiles.allHealthSupported(), NOW);
+        assertEquals(HealthReport.Coverage.COMPLETE, r.coverage());
+        final HealthFact cap = r.fact(FactKind.CAPACITY_HEALTH);
+        assertEquals(92L, cap.value());
+        assertEquals(FactSource.HEALTH_HAL, cap.source());
+        assertEquals(FactConfidence.DERIVED_HIGH_CONFIDENCE, cap.confidence());
+        assertEquals(412L, r.fact(FactKind.CYCLE_COUNT).value());
+        assertEquals(FactConfidence.PLATFORM_REPORTED, r.fact(FactKind.CYCLE_COUNT).confidence());
+        assertEquals(FactSource.ANDROID_FRAMEWORK, r.fact(FactKind.TEMPERATURE).source());
+        assertEquals(NOW, r.fact(FactKind.TEMPERATURE).sampleTimeMillis());
+        assertEquals(HealthFact.NO_TIMESTAMP, r.fact(FactKind.FIRST_USE_DATE).sampleTimeMillis());
+    }
+
+    @Test
+    public void stateOfHealthPreferredOverRatio() {
+        final HealthReport r = BatteryHealthEvaluator.evaluate(
+                full().stateOfHealthPercent(90).build(), TestProfiles.allHealthSupported(), NOW);
+        assertEquals(90L, r.fact(FactKind.CAPACITY_HEALTH).value());
+        assertEquals(FactConfidence.PLATFORM_REPORTED,
+                r.fact(FactKind.CAPACITY_HEALTH).confidence());
+    }
+
+    @Test
+    public void disagreeingSourcesLowerConfidence() {
+        final HealthReport r = BatteryHealthEvaluator.evaluate(
+                full().stateOfHealthPercent(70).build(), TestProfiles.allHealthSupported(), NOW);
+        assertEquals(70L, r.fact(FactKind.CAPACITY_HEALTH).value());
+        assertEquals(FactConfidence.DERIVED_LOW_CONFIDENCE,
+                r.fact(FactKind.CAPACITY_HEALTH).confidence());
+    }
+
+    @Test
+    public void missingValuesAreNotReported() {
+        final HealthReport r = BatteryHealthEvaluator.evaluate(
+                BatteryReadings.builder().sampleTimeMillis(NOW).build(),
+                TestProfiles.allHealthSupported(), NOW);
+        for (FactKind k : FactKind.values()) {
+            assertEquals(k.name(), UnavailableReason.NOT_REPORTED, r.fact(k).reason());
+        }
+        assertEquals(HealthReport.Coverage.NONE, r.coverage());
+    }
+
+    @Test
+    public void unsupportedBeatsEverything() {
+        final BatteryCapabilityProfile p = TestProfiles.of("health_temperature_supported=NO");
+        final HealthReport r = BatteryHealthEvaluator.evaluate(full().build(), p, NOW);
+        assertEquals(UnavailableReason.UNSUPPORTED, r.fact(FactKind.TEMPERATURE).reason());
+    }
+
+    @Test
+    public void fullAboveDesignIsImplausible() {
+        final HealthReport r = BatteryHealthEvaluator.evaluate(
+                full().fullChargeUah(4_000_000).build(), TestProfiles.allHealthSupported(), NOW);
+        assertEquals(UnavailableReason.IMPLAUSIBLE, r.fact(FactKind.MAXIMUM_CAPACITY).reason());
+        assertEquals(UnavailableReason.IMPLAUSIBLE, r.fact(FactKind.CAPACITY_HEALTH).reason());
+        assertTrue(r.fact(FactKind.DESIGN_CAPACITY).isAvailable());
+    }
+
+    @Test
+    public void designFarFromSpecIsImplausible() {
+        final BatteryCapabilityProfile p = TestProfiles.of("health_capacity_supported=YES",
+                "spec_design_capacity_mah=3000");
+        // A placeholder design value (1000 mAh) must not produce a 276% health figure.
+        final HealthReport r = BatteryHealthEvaluator.evaluate(
+                full().designCapacityUah(1_000_000).build(), p, NOW);
+        assertEquals(UnavailableReason.IMPLAUSIBLE, r.fact(FactKind.DESIGN_CAPACITY).reason());
+        assertFalse(r.fact(FactKind.CAPACITY_HEALTH).isAvailable());
+        // Full charge is checked against the spec when design is unusable.
+        assertTrue(r.fact(FactKind.MAXIMUM_CAPACITY).isAvailable());
+    }
+
+    @Test
+    public void zeroCyclesOnlyWithEvidence() {
+        final HealthReport unknown = BatteryHealthEvaluator.evaluate(full().cycleCount(0).build(),
+                BatteryCapabilityProfile.EMPTY, NOW);
+        assertEquals(UnavailableReason.NOT_REPORTED, unknown.fact(FactKind.CYCLE_COUNT).reason());
+        final HealthReport supported = BatteryHealthEvaluator.evaluate(
+                full().cycleCount(0).build(), TestProfiles.allHealthSupported(), NOW);
+        assertTrue(supported.fact(FactKind.CYCLE_COUNT).isAvailable());
+        assertEquals(0L, supported.fact(FactKind.CYCLE_COUNT).value());
+        final HealthReport absurd = BatteryHealthEvaluator.evaluate(
+                full().cycleCount(50_000).build(), TestProfiles.allHealthSupported(), NOW);
+        assertEquals(UnavailableReason.IMPLAUSIBLE, absurd.fact(FactKind.CYCLE_COUNT).reason());
+    }
+
+    @Test
+    public void temperatureRange() {
+        final HealthReport cold = BatteryHealthEvaluator.evaluate(
+                full().temperatureDeciC(-55).build(), BatteryCapabilityProfile.EMPTY, NOW);
+        assertEquals(-55L, cold.fact(FactKind.TEMPERATURE).value());
+        final HealthReport bogus = BatteryHealthEvaluator.evaluate(
+                full().temperatureDeciC(6553).build(), BatteryCapabilityProfile.EMPTY, NOW);
+        assertEquals(UnavailableReason.IMPLAUSIBLE, bogus.fact(FactKind.TEMPERATURE).reason());
+    }
+
+    @Test
+    public void unknownHealthStatusIsNotReported() {
+        final HealthReport r = BatteryHealthEvaluator.evaluate(
+                full().healthStatus(BatteryReadings.HEALTH_UNKNOWN).build(),
+                BatteryCapabilityProfile.EMPTY, NOW);
+        assertEquals(UnavailableReason.NOT_REPORTED, r.fact(FactKind.HEALTH_STATUS).reason());
+    }
+
+    @Test
+    public void datesMustBeSane() {
+        final BatteryCapabilityProfile p = TestProfiles.allHealthSupported();
+        final HealthReport epoch = BatteryHealthEvaluator.evaluate(
+                full().manufacturingDateSec(86_400).build(), p, NOW);
+        assertEquals(UnavailableReason.IMPLAUSIBLE,
+                epoch.fact(FactKind.MANUFACTURING_DATE).reason());
+        final HealthReport future = BatteryHealthEvaluator.evaluate(
+                full().firstUseDateSec(NOW / 1000 + 10L * 86_400).build(), p, NOW);
+        assertEquals(UnavailableReason.IMPLAUSIBLE, future.fact(FactKind.FIRST_USE_DATE).reason());
+        final HealthReport beforeMade = BatteryHealthEvaluator.evaluate(
+                full().manufacturingDateSec(MAR_2025).firstUseDateSec(JAN_2025).build(), p, NOW);
+        assertEquals(UnavailableReason.IMPLAUSIBLE,
+                beforeMade.fact(FactKind.FIRST_USE_DATE).reason());
+    }
+
+    @Test
+    public void chargeCounterAboveDesignIsImplausible() {
+        final HealthReport r = BatteryHealthEvaluator.evaluate(
+                full().chargeCounterUah(9_000_000).build(), TestProfiles.allHealthSupported(),
+                NOW);
+        assertEquals(UnavailableReason.IMPLAUSIBLE, r.fact(FactKind.CHARGE_COUNTER).reason());
+    }
+
+    @Test
+    public void unavailableFactsCarryNoSource() {
+        final HealthReport r = BatteryHealthEvaluator.evaluate(full().build(),
+                BatteryCapabilityProfile.EMPTY, NOW);
+        for (FactKind k : FactKind.values()) {
+            final HealthFact f = r.fact(k);
+            if (!f.isAvailable()) {
+                assertEquals(FactSource.UNAVAILABLE, f.source());
+                assertEquals(FactConfidence.UNAVAILABLE, f.confidence());
+            }
+        }
+    }
+}
