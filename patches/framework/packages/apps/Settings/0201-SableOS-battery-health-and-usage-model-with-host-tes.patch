+ */
+
+package com.android.settings.fuelgauge.sable.model;
+
+import java.util.Objects;
+
+/**
+ * One battery health fact: a value plus its availability, source, confidence and sample time.
+ *
+ * <p>Invariant: an unavailable fact carries no value (0), {@link FactSource#UNAVAILABLE} and
+ * {@link FactConfidence#UNAVAILABLE}, so nothing downstream can render a number for it.
+ */
+public final class HealthFact {
+    /** Sample time meaning "not meaningful for this fact". */
+    public static final long NO_TIMESTAMP = 0L;
+
+    private final FactKind mKind;
+    private final FactAvailability mAvailability;
+    private final UnavailableReason mReason;
+    private final FactSource mSource;
+    private final FactConfidence mConfidence;
+    private final long mValue;
+    private final long mSampleTimeMillis;
+
+    private HealthFact(FactKind kind, FactAvailability availability, UnavailableReason reason,
+            FactSource source, FactConfidence confidence, long value, long sampleTimeMillis) {
+        mKind = Objects.requireNonNull(kind);
+        mAvailability = availability;
+        mReason = reason;
+        mSource = source;
+        mConfidence = confidence;
+        mValue = value;
+        mSampleTimeMillis = sampleTimeMillis;
+    }
+
+    /** An available fact. Source and confidence must not be UNAVAILABLE. */
+    public static HealthFact available(FactKind kind, long value, FactSource source,
+            FactConfidence confidence, long sampleTimeMillis) {
+        if (source == null || source == FactSource.UNAVAILABLE) {
+            throw new IllegalArgumentException("available fact needs a real source");
+        }
+        if (confidence == null || confidence == FactConfidence.UNAVAILABLE) {
+            throw new IllegalArgumentException("available fact needs a real confidence");
+        }
+        return new HealthFact(kind, FactAvailability.AVAILABLE, UnavailableReason.NONE, source,
+                confidence, value, sampleTimeMillis);
+    }
+
+    /** An unavailable fact; carries no value. */
+    public static HealthFact unavailable(FactKind kind, UnavailableReason reason) {
+        if (reason == null || reason == UnavailableReason.NONE) {
+            throw new IllegalArgumentException("unavailable fact needs a reason");
+        }
+        return new HealthFact(kind, FactAvailability.UNAVAILABLE, reason, FactSource.UNAVAILABLE,
+                FactConfidence.UNAVAILABLE, 0L, NO_TIMESTAMP);
+    }
+
+    public FactKind kind() {
+        return mKind;
+    }
+
+    public FactAvailability availability() {
+        return mAvailability;
+    }
+
+    public boolean isAvailable() {
+        return mAvailability == FactAvailability.AVAILABLE;
+    }
+
+    public UnavailableReason reason() {
+        return mReason;
+    }
+
+    public FactSource source() {
+        return mSource;
+    }
+
+    public FactConfidence confidence() {
+        return mConfidence;
+    }
+
+    /** The value in the unit documented on {@link FactKind}; 0 when unavailable. */
+    public long value() {
+        return mValue;
+    }
+
+    public long sampleTimeMillis() {
+        return mSampleTimeMillis;
+    }
+
+    @Override
+    public boolean equals(Object o) {
+        if (!(o instanceof HealthFact)) {
+            return false;
+        }
+        final HealthFact f = (HealthFact) o;
+        return mKind == f.mKind && mAvailability == f.mAvailability && mReason == f.mReason
+                && mSource == f.mSource && mConfidence == f.mConfidence && mValue == f.mValue
+                && mSampleTimeMillis == f.mSampleTimeMillis;
+    }
+
+    @Override
+    public int hashCode() {
+        return Objects.hash(mKind, mAvailability, mReason, mSource, mConfidence, mValue,
+                mSampleTimeMillis);
+    }
+
+    @Override
+    public String toString() {
+        return isAvailable()
+                ? mKind + "=" + mValue + " [" + mSource + "/" + mConfidence + "]"
+                : mKind + "=UNAVAILABLE(" + mReason + ")";
+    }
+}
