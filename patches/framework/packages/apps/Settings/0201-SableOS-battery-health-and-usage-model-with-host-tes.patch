+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.settings.fuelgauge.sable.model;
+
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.regex.Pattern;
+
+/**
+ * Parses a battery profile file: UTF-8 {@code key=value} lines, {@code #} comments, blank lines
+ * ignored. Anything malformed fails closed: the key stays UNKNOWN / unqualified and a warning is
+ * recorded. A file with a missing or unsupported {@code schema} yields
+ * {@link BatteryCapabilityProfile#EMPTY}.
+ */
+public final class BatteryProfileParser {
+    /** Profile ids are lower-case words joined by dashes, e.g. zinwa-q25. */
+    private static final Pattern PROFILE_ID = Pattern.compile("[a-z0-9]+(-[a-z0-9]+)*");
+    private static final int MAX_LINES = 512;
+    private static final int MAX_LINE_LENGTH = 512;
+
+    private BatteryProfileParser() {}
+
+    /** True when {@code id} is a well-formed profile id (also safe as a file name). */
+    public static boolean isValidProfileId(String id) {
+        return id != null && id.length() <= 64 && PROFILE_ID.matcher(id).matches();
+    }
+
+    /**
+     * Parses {@code text}. {@code expectedProfileId} must match the file's {@code profile_id};
+     * a mismatch yields EMPTY so one device can never pick up another device's file.
+     */
+    public static BatteryCapabilityProfile parse(String text, String expectedProfileId) {
+        if (text == null || !isValidProfileId(expectedProfileId)) {
+            return BatteryCapabilityProfile.EMPTY;
+        }
+        final Map<String, String> raw = new HashMap<>();
+        final List<String> warnings = new ArrayList<>();
+        final String[] lines = text.split("\r?\n", -1);
+        if (lines.length > MAX_LINES) {
+            return BatteryCapabilityProfile.EMPTY;
+        }
+        for (int i = 0; i < lines.length; i++) {
+            final String line = lines[i].trim();
+            if (line.isEmpty() || line.startsWith("#")) {
+                continue;
+            }
+            if (line.length() > MAX_LINE_LENGTH) {
+                warnings.add("line " + (i + 1) + ": too long");
+                continue;
+            }
+            final int eq = line.indexOf('=');
+            if (eq <= 0) {
+                warnings.add("line " + (i + 1) + ": not key=value");
+                continue;
+            }
+            final String key = line.substring(0, eq).trim().toLowerCase(Locale.ROOT);
+            final String value = line.substring(eq + 1).trim();
+            if (raw.containsKey(key)) {
+                // A duplicate key is ambiguous: fail closed by dropping it.
+                warnings.add("duplicate key " + key);
+                raw.put(key, null);
+                continue;
+            }
+            raw.put(key, value);
+        }
+
+        if (!String.valueOf(BatteryCapabilityProfile.SCHEMA_VERSION)
+                .equals(raw.get(BatteryCapabilityProfile.KEY_SCHEMA))) {
+            return BatteryCapabilityProfile.EMPTY;
+        }
+        if (!expectedProfileId.equals(raw.get(BatteryCapabilityProfile.KEY_PROFILE_ID))) {
+            return BatteryCapabilityProfile.EMPTY;
+        }
+
+        final Map<String, Capability> caps = new HashMap<>();
+        for (String key : BatteryCapabilityProfile.CAPABILITY_KEYS) {
+            final String v = raw.get(key);
+            final Capability c = Capability.parse(v);
+            if (v != null && !v.isEmpty() && c == Capability.UNKNOWN
+                    && !"UNKNOWN".equalsIgnoreCase(v)) {
+                warnings.add("unrecognized value for " + key);
+            }
+            caps.put(key, c);
+        }
+
+        final List<Integer> limits = new ArrayList<>();
+        final String limitText = raw.get(BatteryCapabilityProfile.KEY_CHARGE_LIMIT_VALUES);
+        if (limitText != null && !limitText.isEmpty()) {
+            for (String part : limitText.split(",")) {
+                try {
+                    final int pct = Integer.parseInt(part.trim());
+                    if (pct >= 50 && pct <= 100 && !limits.contains(pct)) {
+                        limits.add(pct);
+                    } else {
+                        warnings.add("charge limit out of range: " + part.trim());
+                    }
+                } catch (NumberFormatException e) {
+                    warnings.add("charge limit not a number: " + part.trim());
+                }
+            }
+            java.util.Collections.sort(limits);
+        }
+        if (caps.get(BatteryCapabilityProfile.KEY_CHARGE_LIMIT) != Capability.SUPPORTED) {
+            limits.clear();
+        }
+
+        String provenance = raw.get(BatteryCapabilityProfile.KEY_BACKEND_PROVENANCE);
+        if (provenance == null || provenance.isEmpty()) {
+            provenance = "NONE";
+        }
+        final boolean qualified =
+                Capability.parse(raw.get(BatteryCapabilityProfile.KEY_MUTABLE_BACKEND_QUALIFIED))
+                        == Capability.SUPPORTED
+                && !"NONE".equalsIgnoreCase(provenance);
+
+        int specMah = 0;
+        final String spec = raw.get(BatteryCapabilityProfile.KEY_SPEC_DESIGN_CAPACITY_MAH);
+        if (spec != null && !spec.isEmpty()) {
+            try {
+                specMah = Integer.parseInt(spec);
+                if (specMah < 100 || specMah > 100_000) {
+                    warnings.add("spec design capacity out of range");
+                    specMah = 0;
+                }
+            } catch (NumberFormatException e) {
+                warnings.add("spec design capacity not a number");
+            }
+        }
+        return new BatteryCapabilityProfile(expectedProfileId, caps, limits, provenance,
+                qualified, specMah, warnings);
+    }
+}
