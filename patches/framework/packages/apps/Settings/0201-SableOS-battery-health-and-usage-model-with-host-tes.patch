+package com.android.settings.fuelgauge.sable.model;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import java.time.ZoneOffset;
+import java.util.Arrays;
+import org.junit.Test;
+
+public class HistoryBucketsTest {
+    private static final long H = HistoryRingBuffer.HOUR_MILLIS;
+    // 2026-09-21T13:20:00Z
+    private static final long NOW = 1_790_000_000_000L - (1_790_000_000_000L % H) + 20 * 60_000;
+
+    @Test
+    public void windows() {
+        final HistoryRange.Window day = HistoryRange.LAST_24_HOURS.window(NOW, ZoneOffset.UTC);
+        assertEquals(24, day.bucketCount);
+        assertEquals(H, day.bucketMillis);
+        assertEquals(NOW - 20 * 60_000 + H, day.endMillis());
+        final HistoryRange.Window week = HistoryRange.LAST_7_DAYS.window(NOW, ZoneOffset.UTC);
+        assertEquals(14, week.bucketCount);
+        assertEquals(7 * 24 * H, week.endMillis() - week.startMillis);
+        final HistoryRange.Window today = HistoryRange.TODAY.window(NOW, ZoneOffset.UTC);
+        final long hourOfDay = (NOW % (24 * H)) / H;
+        assertEquals((int) hourOfDay + 1, today.bucketCount);
+    }
+
+    @Test
+    public void bucketizeAveragesAndLeavesGapsEmpty() {
+        final HistoryRange.Window w = HistoryRange.LAST_24_HOURS.window(NOW, ZoneOffset.UTC);
+        final long b23 = w.bucketStart(23);
+        final long b20 = w.bucketStart(20);
+        final HistoryBuckets.Bucket[] b = HistoryBuckets.bucketize(Arrays.asList(
+                new HistorySample(b20 + 1, 80, 300, false),
+                new HistorySample(b23 + 1, 70, 310, false),
+                new HistorySample(b23 + 2, 69, 321, true),
+                new HistorySample(b23 + 3, 68, HistorySample.NO_TEMPERATURE, false)), w);
+        assertEquals(24, b.length);
+        assertEquals(3, b[23].sampleCount);
+        assertEquals(316, b[23].averageTemperatureDeciC);
+        assertEquals(321, b[23].maxTemperatureDeciC);
+        assertEquals(68, b[23].lastLevelPercent);
+        assertTrue(b[23].anyCharging);
+        assertFalse(b[22].hasValue(HistoryBuckets.SERIES_TEMPERATURE));
+        assertEquals(0, b[22].sampleCount);
+        final boolean[] v = HistoryBuckets.validity(b, HistoryBuckets.SERIES_TEMPERATURE);
+        assertTrue(v[20]);
+        assertTrue(v[23]);
+        assertFalse(v[21]);
+    }
+}
diff --git a/tests/sable-battery/src/com/android/settings/fuelgauge/sable/model/HistoryRingBufferTest.java b/tests/sable-battery/src/com/android/settings/fuelgauge/sable/model/HistoryRingBufferTest.java
