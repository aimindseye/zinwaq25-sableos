+
+package com.android.settings.applications.sable.model;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.Test;
+
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.HashSet;
+import java.util.Set;
+
+public class AppBlockerPolicyTest {
+    private static final Set<String> NEEDED = new HashSet<>(Arrays.asList(
+            "com.android.settings", "org.sableos.launcher", "com.android.dialer"));
+
+    @Test
+    public void neededAppsAreNeverBlockable() {
+        assertFalse(AppBlockerPolicy.canBlock("com.android.settings", NEEDED));
+        assertFalse(AppBlockerPolicy.canBlock("org.sableos.launcher", NEEDED));
+        assertTrue(AppBlockerPolicy.canBlock("com.example.game", NEEDED));
+    }
+
+    @Test
+    public void malformedNamesAreRefused() {
+        assertFalse(AppBlockerPolicy.canBlock(null, NEEDED));
+        assertFalse(AppBlockerPolicy.canBlock("", NEEDED));
+        assertFalse(AppBlockerPolicy.canBlock("nodots", NEEDED));
+        assertFalse(AppBlockerPolicy.canBlock("a b.c", NEEDED));
+    }
+
+    @Test
+    public void nullNeededSetBlocksNothingExtra() {
+        assertTrue(AppBlockerPolicy.canBlock("com.example.game", null));
+    }
+
+    @Test
+    public void blockableIsSortedDeduplicatedAndFiltered() {
+        final Set<String> out = AppBlockerPolicy.blockable(Arrays.asList(
+                "com.example.b", "com.android.settings", "com.example.a", "com.example.b", "bad"),
+                NEEDED);
+        assertEquals(Arrays.asList("com.example.a", "com.example.b"),
+                Arrays.asList(out.toArray(new String[0])));
+        assertTrue(AppBlockerPolicy.blockable(null, NEEDED).isEmpty());
+    }
+
+    @Test
+    public void toReleaseNamesBlockedAppsThePhoneNowNeeds() {
+        final Set<String> out = AppBlockerPolicy.toRelease(Arrays.asList(
+                "com.example.game", "com.android.dialer", "junk"), NEEDED);
+        assertEquals(Collections.singleton("com.android.dialer"), out);
+        assertTrue(AppBlockerPolicy.toRelease(null, NEEDED).isEmpty());
+        assertTrue(AppBlockerPolicy.toRelease(Arrays.asList("com.android.dialer"), null)
+                .isEmpty());
+    }
+}
