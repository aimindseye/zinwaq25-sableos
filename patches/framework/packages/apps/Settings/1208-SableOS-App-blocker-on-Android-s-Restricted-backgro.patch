+
+package com.android.settings.applications.sable.model;
+
+import java.util.Collection;
+import java.util.Set;
+import java.util.TreeSet;
+
+/**
+ * App blocker (Mobile Manager &gt; App blocker): which apps may be blocked. Blocking is Android's
+ * own Restricted background mode ({@code RUN_ANY_IN_BACKGROUND} ignored) plus a stop, so there is
+ * no second store: the platform holds the state. This is the pure part: the apps the phone needs
+ * (home, dialer, SMS, keyboard, Settings) are never blockable, and nothing but a well-formed
+ * package name is accepted.
+ */
+public final class AppBlockerPolicy {
+    private AppBlockerPolicy() {}
+
+    /** Whether {@code packageName} may be blocked, given the packages the phone needs. */
+    public static boolean canBlock(String packageName, Set<String> neverBlock) {
+        return PackageSet.isValidPackageName(packageName)
+                && (neverBlock == null || !neverBlock.contains(packageName));
+    }
+
+    /** The blockable apps among {@code launcherApps}, de-duplicated and sorted. */
+    public static Set<String> blockable(Collection<String> launcherApps, Set<String> neverBlock) {
+        final Set<String> out = new TreeSet<>();
+        if (launcherApps == null) {
+            return out;
+        }
+        for (String pkg : launcherApps) {
+            if (canBlock(pkg, neverBlock)) {
+                out.add(pkg);
+            }
+        }
+        return out;
+    }
+
+    /** Apps in {@code blocked} that are no longer blockable (the phone started needing them). */
+    public static Set<String> toRelease(Collection<String> blocked, Set<String> neverBlock) {
+        final Set<String> out = new TreeSet<>();
+        if (blocked == null) {
+            return out;
+        }
+        for (String pkg : blocked) {
+            if (PackageSet.isValidPackageName(pkg) && neverBlock != null
+                    && neverBlock.contains(pkg)) {
+                out.add(pkg);
+            }
+        }
+        return out;
+    }
+}
