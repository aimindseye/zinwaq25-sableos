diff --git a/src/com/android/settings/applications/sable/SableAppBlocker.java b/src/com/android/settings/applications/sable/SableAppBlocker.java
new file mode 100644
index 0000000..9770894
--- /dev/null
+++ b/src/com/android/settings/applications/sable/SableAppBlocker.java
@@ -0,0 +1,79 @@
+/*
