+package com.android.settings.sable;
+
+import android.content.Context;
+
+import com.android.settings.core.BasePreferenceController;
+
+/**
+ * Settings > System > Keyboard > Keyboard firmware: shown where the keyboard driver has the
+ * firmware-upgrade switch.
+ */
+public class SableKeyboardFirmwarePreferenceController extends BasePreferenceController {
+
+    public SableKeyboardFirmwarePreferenceController(Context context, String preferenceKey) {
+        super(context, preferenceKey);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return SableKeyboardFirmware.isSupported() ? AVAILABLE : UNSUPPORTED_ON_DEVICE;
+    }
+}
