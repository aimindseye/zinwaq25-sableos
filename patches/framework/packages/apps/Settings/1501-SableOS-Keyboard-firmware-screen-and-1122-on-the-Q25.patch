+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.settings.sable;
+
+import android.app.Activity;
+import android.os.Bundle;
+import android.util.Log;
+import android.util.TypedValue;
+import android.view.ViewGroup;
+import android.widget.Button;
+import android.widget.LinearLayout;
+import android.widget.ScrollView;
+import android.widget.TextView;
+
+import com.android.settings.R;
+import com.android.settings.sable.SableKeyboardFirmware.Step;
+
+import java.io.IOException;
+
+/**
+ * Keyboard firmware (*#*#1122#*#*, or Settings > System > Keyboard): the stock Zinwa Q25 menu's
+ * Turn off / Firmware upgrade / Exit, so a keyboard firmware .uf2 can be copied from a computer
+ * without returning to stock. Touch only while it runs, because the keyboard is off.
+ */
+public class SableKeyboardFirmwareActivity extends Activity {
+
+    private static final String TAG = "SableKbdFirmware";
+
+    private Step mStep = Step.NORMAL;
+    private TextView mStatus;
+    private Button mOff;
+    private Button mDownload;
+    private Button mExit;
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        int pad = dp(16);
+        LinearLayout body = new LinearLayout(this);
+        body.setOrientation(LinearLayout.VERTICAL);
+        body.setPadding(pad, pad, pad, pad);
+
+        TextView title = new TextView(this);
+        title.setText(R.string.sable_keyboard_firmware_title);
+        title.setTextSize(TypedValue.COMPLEX_UNIT_SP, 22);
+        body.addView(title);
+
+        TextView steps = new TextView(this);
+        steps.setText(R.string.sable_keyboard_firmware_steps);
+        steps.setPadding(0, pad / 2, 0, pad / 2);
+        body.addView(steps);
+
+        mStatus = new TextView(this);
+        mStatus.setPadding(0, 0, 0, pad / 2);
+        body.addView(mStatus);
+
+        mOff = button(body, R.string.sable_keyboard_firmware_off, Step.OFF);
+        mDownload = button(body, R.string.sable_keyboard_firmware_download, Step.DOWNLOAD);
+        mExit = button(body, R.string.sable_keyboard_firmware_exit, Step.NORMAL);
+
+        ScrollView scroll = new ScrollView(this);
+        scroll.addView(body);
+        setContentView(scroll);
+        refresh(SableKeyboardFirmware.isSupported()
+                ? 0 : R.string.sable_keyboard_firmware_unsupported);
+    }
+
+    private Button button(LinearLayout parent, int label, Step target) {
+        Button b = new Button(this);
+        b.setText(label);
+        b.setAllCaps(false);
+        b.setOnClickListener(v -> move(target));
+        parent.addView(b, new LinearLayout.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+        return b;
+    }
+
+    private void move(Step target) {
+        if (!SableKeyboardFirmware.canMove(mStep, target)) return;
+        try {
+            SableKeyboardFirmware.write(target);
+            mStep = target;
+            refresh(0);
+        } catch (IOException | SecurityException e) {
+            Log.w(TAG, "write " + target + " failed", e);
+            refresh(R.string.sable_keyboard_firmware_failed);
+        }
+    }
+
+    private void refresh(int error) {
+        boolean supported = SableKeyboardFirmware.isSupported();
+        if (error != 0) {
+            mStatus.setText(error);
+        } else if (mStep == Step.OFF) {
+            mStatus.setText(R.string.sable_keyboard_firmware_status_off);
+        } else if (mStep == Step.DOWNLOAD) {
+            mStatus.setText(R.string.sable_keyboard_firmware_status_download);
+        } else {
+            mStatus.setText(R.string.sable_keyboard_firmware_status_normal);
+        }
+        mOff.setEnabled(supported && SableKeyboardFirmware.canMove(mStep, Step.OFF));
+        mDownload.setEnabled(supported && SableKeyboardFirmware.canMove(mStep, Step.DOWNLOAD));
+        mExit.setEnabled(supported && mStep != Step.NORMAL);
+    }
+
+    /**
+     * Leaving the screen (Back, or finish) never leaves the keyboard off or USB with the keyboard.
+     * The manifest keeps the activity through the keyboard's own disconnect.
+     */
+    @Override
+    protected void onDestroy() {
+        if (isFinishing() && SableKeyboardFirmware.needsRestoreOnExit(mStep)) {
+            try {
+                SableKeyboardFirmware.write(Step.NORMAL);
+            } catch (IOException | SecurityException e) {
+                Log.w(TAG, "restore failed", e);
+            }
+        }
+        super.onDestroy();
+    }
+
+    private int dp(int v) {
+        return Math.round(v * getResources().getDisplayMetrics().density);
+    }
+}
