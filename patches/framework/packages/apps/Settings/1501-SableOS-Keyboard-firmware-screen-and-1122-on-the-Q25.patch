+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.settings.sable;
+
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+
+/**
+ * The Zinwa Q25 keyboard's firmware-upgrade switch, as the stock *#*#1122#*#* menu uses it.
+ * The bbqX0kbd driver's /proc/firmware_upgrade takes one digit: 1 powers the keyboard off,
+ * 2 powers it on in download mode and hands the phone's USB port to it (holding Hang Up at
+ * that moment makes the RP2040 start its USB drive), 0 powers it back on normally and returns
+ * USB to the phone. Pure apart from the file write, so the step logic is host-tested.
+ */
+public final class SableKeyboardFirmware {
+
+    public static final String NODE = "/proc/firmware_upgrade";
+
+    /** Where the keyboard is, as far as this screen has moved it. */
+    public enum Step {
+        NORMAL("0"),
+        OFF("1"),
+        DOWNLOAD("2");
+
+        final String command;
+
+        Step(String command) {
+            this.command = command;
+        }
+    }
+
+    private SableKeyboardFirmware() {}
+
+    /** True on devices whose keyboard driver has the switch. */
+    public static boolean isSupported() {
+        return new File(NODE).exists();
+    }
+
+    /**
+     * Download mode needs the keyboard off first, as the stock menu does; normal is always
+     * allowed, so a user can always get the keyboard and USB back.
+     */
+    public static boolean canMove(Step from, Step to) {
+        switch (to) {
+            case NORMAL:
+                return true;
+            case OFF:
+                return from == Step.NORMAL;
+            case DOWNLOAD:
+                return from == Step.OFF;
+            default:
+                return false;
+        }
+    }
+
+    /** Leaving the screen in any other step would leave the keyboard dead or USB taken. */
+    public static boolean needsRestoreOnExit(Step step) {
+        return step != Step.NORMAL;
+    }
+
+    /** Writes the step's digit to the switch. */
+    public static void write(Step step) throws IOException {
+        try (FileOutputStream out = new FileOutputStream(NODE)) {
+            out.write(step.command.getBytes(StandardCharsets.US_ASCII));
+        }
+    }
+}
diff --git a/src/com/android/settings/sable/SableKeyboardFirmwareActivity.java b/src/com/android/settings/sable/SableKeyboardFirmwareActivity.java
new file mode 100644
index 0000000..ba23c45
--- /dev/null
+++ b/src/com/android/settings/sable/SableKeyboardFirmwareActivity.java
@@ -0,0 +1,139 @@
+/*
