+
+package com.android.settings.sable;
+
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.os.UserManager;
+import android.telephony.TelephonyManager;
+
+/**
+ * *#*#1122#*#* opens Keyboard firmware, as on the stock Zinwa Q25. Owner (system) user only,
+ * and only where the keyboard driver has the switch. The manifest requires
+ * MODIFY_PHONE_STATE, which only the telephony stack that sends SECRET_CODE holds.
+ */
+public class SableKeyboardFirmwareCodeReceiver extends BroadcastReceiver {
+
+    @Override
+    public void onReceive(Context context, Intent intent) {
+        if (intent == null
+                || !TelephonyManager.ACTION_SECRET_CODE.equals(intent.getAction())) {
+            return;
+        }
+        UserManager um = context.getSystemService(UserManager.class);
+        if (um == null || !um.isSystemUser() || !SableKeyboardFirmware.isSupported()) return;
+        Intent open = new Intent(context, SableKeyboardFirmwareActivity.class)
+                .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+        context.startActivity(open);
+    }
+}
