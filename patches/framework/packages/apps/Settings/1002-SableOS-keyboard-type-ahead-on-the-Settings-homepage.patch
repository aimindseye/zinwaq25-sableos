+<!-- Settings homepage type-ahead (KEYBOARD_FIRST_SETTINGS_UX): pairs of homepage row key and
+     extra comma-separated words that also reach that row. The words match only after row titles
+     do (TypeAheadMatcher word rank), so S still reaches Sound and SY System, while "vol" reaches
+     Sound and "lang" System. Translate the words, never the keys. -->
+<resources>
+    <!-- Extra type-ahead words for the Settings homepage row "network". -->
+    <string name="sable_homepage_words_network">wifi, wi-fi, mobile, sim, data, hotspot, airplane</string>
+    <!-- Extra type-ahead words for the Settings homepage row "connected devices". -->
+    <string name="sable_homepage_words_connected_devices">bluetooth, usb, cast, nfc, printing</string>
+    <!-- Extra type-ahead words for the Settings homepage row "apps". -->
+    <string name="sable_homepage_words_apps">applications, default apps, network access, app security</string>
+    <!-- Extra type-ahead words for the Settings homepage row "notifications". -->
+    <string name="sable_homepage_words_notifications">lock screen, attention, hub</string>
+    <!-- Extra type-ahead words for the Settings homepage row "sound". -->
+    <string name="sable_homepage_words_sound">volume, vibration, ringtone, do not disturb</string>
+    <!-- Extra type-ahead words for the Settings homepage row "display". -->
+    <string name="sable_homepage_words_display">brightness, dark theme, accent, timeout, font, compatibility</string>
+    <!-- Extra type-ahead words for the Settings homepage row "wallpaper". -->
+    <string name="sable_homepage_words_wallpaper">theme, colors</string>
+    <!-- Extra type-ahead words for the Settings homepage row "battery". -->
+    <string name="sable_homepage_words_battery">power, charging, health, usage</string>
+    <!-- Extra type-ahead words for the Settings homepage row "system". -->
+    <string name="sable_homepage_words_system">keyboard, language, date, time, backup, reset, update, gestures</string>
+    <!-- Extra type-ahead words for the Settings homepage row "sable". -->
+    <string name="sable_homepage_words_sable">start, quick bar, hub, tools, diagnostics, compatibility</string>
+    <!-- Extra type-ahead words for the Settings homepage row "security". -->
+    <string name="sable_homepage_words_security">lock, pin, password, fingerprint</string>
+    <!-- Extra type-ahead words for the Settings homepage row "privacy". -->
+    <string name="sable_homepage_words_privacy">permissions, camera access, microphone access</string>
+    <!-- Extra type-ahead words for the Settings homepage row "location". -->
+    <string name="sable_homepage_words_location">gps</string>
+    <!-- Extra type-ahead words for the Settings homepage row "accounts". -->
+    <string name="sable_homepage_words_accounts">passwords, autofill</string>
+    <!-- Extra type-ahead words for the Settings homepage row "about device". -->
+    <string name="sable_homepage_words_about_device">phone number, imei, build, version</string>
+    <!-- Extra type-ahead words for the Settings homepage row "accessibility". -->
