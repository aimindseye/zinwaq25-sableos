diff --git a/src/com/android/settings/applications/sable/SableAppListKeyboard.java b/src/com/android/settings/applications/sable/SableAppListKeyboard.java
index a70c4560113..bd5228fd0c3 100644
--- a/src/com/android/settings/applications/sable/SableAppListKeyboard.java
+++ b/src/com/android/settings/applications/sable/SableAppListKeyboard.java
@@ -38,7 +38,9 @@ import com.android.settings.overlay.FeatureFactory;
 
 import java.util.ArrayList;
 import java.util.Collections;
+import java.util.HashMap;
 import java.util.List;
+import java.util.Map;
 
 /**
  * Keyboard-first behaviour for the Sable app lists (KEYBOARD_FIRST_SETTINGS_UX), on top of
@@ -47,17 +49,26 @@ import java.util.List;
  * PageUp/PageDown move by list position, and {@code /}, Search or Ctrl+K open Settings
  * search. It only sees keys no view handled, so it never traps focus or eats text input.
  * Reuses the Battery package's pure keyboard model.
+ *
+ * <p>{@link #attachToWindow} is the Settings homepage variant: it listens on the window, so the
+ * keys also work while the search bar or nothing at all is focused, and it can add extra words
+ * per row that match after the titles do.
  */
 public final class SableAppListKeyboard implements View.OnUnhandledKeyEventListener {
     private final Fragment mFragment;
     private final RecyclerView mList;
+    private final View mHost;
     private final int mPageId;
+    private final Map<String, String> mExtraWords;
     private final TypeAheadMatcher mTypeAhead = new TypeAheadMatcher();
 
-    private SableAppListKeyboard(Fragment fragment, RecyclerView list, int pageId) {
+    private SableAppListKeyboard(Fragment fragment, RecyclerView list, View host, int pageId,
+            Map<String, String> extraWords) {
         mFragment = fragment;
         mList = list;
+        mHost = host;
         mPageId = pageId;
+        mExtraWords = extraWords;
     }
 
     /** Installs keyboard support on a preference list; returns null when there is no list. */
@@ -65,13 +76,40 @@ public final class SableAppListKeyboard implements View.OnUnhandledKeyEventListe
         if (list == null) {
             return null;
         }
-        final SableAppListKeyboard k = new SableAppListKeyboard(fragment, list, pageId);
+        final SableAppListKeyboard k = new SableAppListKeyboard(fragment, list, list, pageId,
+                Collections.<String, String>emptyMap());
         list.addOnUnhandledKeyEventListener(k);
         return k;
     }
 
+    /**
+     * Installs keyboard support for a list on its whole window (the Settings homepage). {@code
+     * extraWordsRes} is a string array of preference key, words pairs; the words match only after
+     * row titles (TypeAheadMatcher word rank), so they never take a first letter from a title.
+     * Returns null when there is no list or window.
+     */
+    public static SableAppListKeyboard attachToWindow(Fragment fragment, RecyclerView list,
+            int pageId, int extraWordsRes) {
+        if (list == null || fragment.getActivity() == null
+                || fragment.getActivity().getWindow() == null) {
+            return null;
+        }
+        final View host = fragment.getActivity().getWindow().getDecorView();
+        final Map<String, String> words = new HashMap<>();
+        if (extraWordsRes != 0) {
+            final String[] raw = fragment.getResources().getStringArray(extraWordsRes);
+            for (int i = 0; i + 1 < raw.length; i += 2) {
+                words.put(raw[i], raw[i + 1].replace(',', ' '));
+            }
+        }
+        final SableAppListKeyboard k = new SableAppListKeyboard(fragment, list, host, pageId,
+                words);
+        host.addOnUnhandledKeyEventListener(k);
+        return k;
+    }
+
     public void detach() {
-        mList.removeOnUnhandledKeyEventListener(this);
+        mHost.removeOnUnhandledKeyEventListener(this);
         mTypeAhead.reset();
     }
 
@@ -111,8 +149,10 @@ public final class SableAppListKeyboard implements View.OnUnhandledKeyEventListe
                 if (!isFocusTarget(p) || TextUtils.isEmpty(p.getTitle())) {
                     continue;
                 }
-                rows.add(new TypeAheadMatcher.Row(p.getTitle().toString(),
-                        Collections.<String>emptyList()));
+                final String extra = p.getKey() == null ? null : mExtraWords.get(p.getKey());
+                final String text = extra == null ? p.getTitle().toString()
+                        : p.getTitle() + " " + extra;
+                rows.add(new TypeAheadMatcher.Row(text, Collections.<String>emptyList()));
                 positions.add(i);
             }
         }
