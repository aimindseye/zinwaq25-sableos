+<!-- Battery history: range group, bounded chart, text for the selected bucket. The row itself
+     is not selectable; the range group and the chart are the focus targets. -->
+<LinearLayout
+    xmlns:android="http://schemas.android.com/apk/res/android"
+    android:layout_width="match_parent"
+    android:layout_height="wrap_content"
+    android:orientation="vertical"
+    android:paddingStart="?android:attr/listPreferredItemPaddingStart"
+    android:paddingEnd="?android:attr/listPreferredItemPaddingEnd"
+    android:paddingTop="8dp"
+    android:paddingBottom="8dp">
+
+    <TextView
+        android:id="@android:id/title"
+        android:layout_width="match_parent"
+        android:layout_height="wrap_content"
+        android:textAppearance="?android:attr/textAppearanceListItem"
+        android:accessibilityHeading="true" />
+
+    <com.android.settings.fuelgauge.sable.SableRangeSelectorView
+        android:id="@+id/sable_battery_range"
+        android:layout_width="match_parent"
+        android:layout_height="@dimen/sable_battery_range_height"
+        android:layout_marginTop="8dp"
+        android:focusable="true"
+        android:defaultFocusHighlightEnabled="true" />
+
+    <com.android.settings.fuelgauge.sable.SableHistoryChartView
+        android:id="@+id/sable_battery_chart"
+        android:layout_width="match_parent"
+        android:layout_height="@dimen/sable_battery_chart_height"
+        android:layout_marginTop="8dp"
+        android:focusable="true"
+        android:defaultFocusHighlightEnabled="true" />
+
+    <TextView
+        android:id="@+id/sable_battery_bucket_text"
+        android:layout_width="match_parent"
+        android:layout_height="wrap_content"
+        android:layout_marginTop="4dp"
+        android:textAppearance="?android:attr/textAppearanceListItemSecondary"
+        android:textColor="?android:attr/textColorSecondary"
+        android:accessibilityLiveRegion="polite" />
+
+    <TextView
+        android:id="@+id/sable_battery_chart_hint"
+        android:layout_width="match_parent"
+        android:layout_height="wrap_content"
+        android:textAppearance="?android:attr/textAppearanceSmall"
+        android:textColor="?android:attr/textColorSecondary"
+        android:importantForAccessibility="no" />
+</LinearLayout>
