+
+package com.android.settings.fuelgauge.sable;
+
+import android.content.Context;
+import android.content.Intent;
+import android.content.res.Resources;
+import android.os.BatteryManager;
+import android.os.ServiceManager;
+import android.os.SystemClock;
+
+import com.android.settings.fuelgauge.sable.model.BatteryCapabilityProfile;
+import com.android.settings.fuelgauge.sable.model.BatteryHealthEvaluator;
+import com.android.settings.fuelgauge.sable.model.BatteryReadings;
+import com.android.settings.fuelgauge.sable.model.ChargingDiscovery;
+import com.android.settings.fuelgauge.sable.model.HealthReport;
+import com.android.settingslib.fuelgauge.BatteryUtils;
+
+/**
+ * One read of everything the Sable Battery screens show, from Android framework APIs only:
+ * the sticky ACTION_BATTERY_CHANGED broadcast, BatteryManager properties (Settings holds
+ * BATTERY_STATS) and framework configuration. No sysfs/procfs access, no writes, no network.
+ *
+ * <p>Several preference controllers render from the same snapshot, so it is cached for a
+ * short time instead of re-reading the binder properties per row.
+ */
+public final class SableBatteryState {
+    /** LineageOS charging-control service name (vendor.lineage.health backed). */
+    static final String LINEAGE_HEALTH_SERVICE = "lineagehealth";
+    private static final long CACHE_MILLIS = 2_000;
+
+    private static SableBatteryState sCached;
+    private static long sCachedAt;
+
+    public final BatteryCapabilityProfile profile;
+    public final BatteryReadings readings;
+    public final HealthReport report;
+    public final ChargingDiscovery discovery;
+
+    private SableBatteryState(BatteryCapabilityProfile profile, BatteryReadings readings,
+            ChargingDiscovery discovery) {
+        this.profile = profile;
+        this.readings = readings;
+        this.discovery = discovery;
+        this.report = BatteryHealthEvaluator.evaluate(readings, profile,
+                System.currentTimeMillis());
+    }
+
+    /** A recent snapshot (at most two seconds old). */
+    public static synchronized SableBatteryState get(Context context) {
+        final long now = SystemClock.elapsedRealtime();
+        if (sCached == null || now - sCachedAt > CACHE_MILLIS) {
+            sCached = read(context.getApplicationContext());
+            sCachedAt = now;
+        }
+        return sCached;
+    }
+
+    /** Drops the cached snapshot (screen resumed). */
+    public static synchronized void invalidate() {
+        sCached = null;
+    }
+
+    private static SableBatteryState read(Context context) {
+        final BatteryCapabilityProfile profile = SableBatteryProfileLoader.get();
+        final Intent i = BatteryUtils.getBatteryIntent(context);
+        final BatteryManager bm = context.getSystemService(BatteryManager.class);
+        final BatteryReadings.Builder b = BatteryReadings.builder()
+                .sampleTimeMillis(System.currentTimeMillis());
+        if (i != null) {
+            b.fullChargeUah(extra(i, BatteryManager.EXTRA_MAXIMUM_CAPACITY))
+                    .designCapacityUah(extra(i, BatteryManager.EXTRA_DESIGN_CAPACITY))
+                    .cycleCount(extra(i, BatteryManager.EXTRA_CYCLE_COUNT))
+                    .temperatureDeciC(extra(i, BatteryManager.EXTRA_TEMPERATURE))
+                    .healthStatus(extra(i, BatteryManager.EXTRA_HEALTH))
+                    .chargeCounterUah(extra(i, BatteryManager.EXTRA_CHARGE_COUNTER));
+            final int level = i.getIntExtra(BatteryManager.EXTRA_LEVEL, -1);
+            final int scale = i.getIntExtra(BatteryManager.EXTRA_SCALE, -1);
+            if (level >= 0 && scale > 0) {
+                b.levelPercent(Math.round(level * 100f / scale));
+            }
+            final int status = i.getIntExtra(BatteryManager.EXTRA_STATUS,
+                    BatteryManager.BATTERY_STATUS_UNKNOWN);
+            b.charging(status == BatteryManager.BATTERY_STATUS_CHARGING
+                    || status == BatteryManager.BATTERY_STATUS_FULL);
+        }
+        long chargingPolicy = BatteryReadings.MISSING;
+        if (bm != null) {
+            b.stateOfHealthPercent(property(bm, BatteryManager.BATTERY_PROPERTY_STATE_OF_HEALTH))
+                    .manufacturingDateSec(
+                            property(bm, BatteryManager.BATTERY_PROPERTY_MANUFACTURING_DATE))
+                    .firstUseDateSec(
+                            property(bm, BatteryManager.BATTERY_PROPERTY_FIRST_USAGE_DATE));
+            chargingPolicy = property(bm, BatteryManager.BATTERY_PROPERTY_CHARGING_POLICY);
+        }
+        final ChargingDiscovery discovery = new ChargingDiscovery(
+                isServicePresent(LINEAGE_HEALTH_SERVICE), chargingPolicy,
+                shutdownTemperatureDeciC());
+        return new SableBatteryState(profile, b.build(), discovery);
+    }
+
+    private static long extra(Intent i, String name) {
+        return i.hasExtra(name)
+                ? BatteryReadings.fromInt(i.getIntExtra(name, Integer.MIN_VALUE))
+                : BatteryReadings.MISSING;
+    }
+
+    private static long property(BatteryManager bm, int id) {
+        try {
+            final long v = bm.getLongProperty(id);
+            return v == Long.MIN_VALUE ? BatteryReadings.MISSING : v;
+        } catch (RuntimeException e) {
+            // Unsupported property, missing permission or HAL error: fail closed.
+            return BatteryReadings.MISSING;
+        }
+    }
+
+    private static boolean isServicePresent(String name) {
+        try {
+            return ServiceManager.checkService(name) != null;
+        } catch (RuntimeException e) {
+            return false;
+        }
+    }
+
+    /** config_shutdownBatteryTemperature (tenths of C) from the framework, 0 when absent. */
+    static int shutdownTemperatureDeciC() {
+        final Resources r = Resources.getSystem();
+        final int id = r.getIdentifier("config_shutdownBatteryTemperature", "integer",
+                "android");
+        if (id == 0) {
+            return 0;
+        }
+        try {
+            return Math.max(0, r.getInteger(id));
+        } catch (Resources.NotFoundException e) {
+            return 0;
+        }
+    }
+}
diff --git a/src/com/android/settings/fuelgauge/sable/SableBatteryText.java b/src/com/android/settings/fuelgauge/sable/SableBatteryText.java
