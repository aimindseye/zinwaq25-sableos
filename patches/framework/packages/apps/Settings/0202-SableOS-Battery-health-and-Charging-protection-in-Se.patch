+package com.android.settings.fuelgauge.sable;
+
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.Paint;
+import android.graphics.RectF;
+import android.view.View;
+import android.view.ViewTreeObserver;
+
+import androidx.recyclerview.widget.RecyclerView;
+
+import com.android.settings.R;
+
+/**
+ * High-contrast focus ring for the focused Settings row: a stroke in the primary text color
+ * (not the accent color alone), so keyboard focus is visible on any theme. Redraws on every
+ * global focus change.
+ */
+final class SableFocusDecoration extends RecyclerView.ItemDecoration {
+    private final Paint mPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final RectF mRect = new RectF();
+    private final float mInset;
+    private final float mRadius;
+    private final RecyclerView mList;
+    private final ViewTreeObserver.OnGlobalFocusChangeListener mFocusListener;
+
+    SableFocusDecoration(Context context, RecyclerView list) {
+        mList = list;
+        mPaint.setStyle(Paint.Style.STROKE);
+        mPaint.setStrokeWidth(
+                context.getResources().getDimension(R.dimen.sable_battery_focus_stroke));
+        mPaint.setColor(SableRangeSelectorView.color(context, android.R.attr.textColorPrimary));
+        mInset = context.getResources().getDimension(R.dimen.sable_battery_focus_inset);
+        mRadius = context.getResources().getDimension(R.dimen.sable_battery_focus_radius);
+        mFocusListener = (oldFocus, newFocus) -> mList.invalidate();
+    }
+
+    void install() {
+        mList.addItemDecoration(this);
+        mList.getViewTreeObserver().addOnGlobalFocusChangeListener(mFocusListener);
+    }
+
+    void uninstall() {
+        mList.removeItemDecoration(this);
+        if (mList.getViewTreeObserver().isAlive()) {
+            mList.getViewTreeObserver().removeOnGlobalFocusChangeListener(mFocusListener);
+        }
+    }
+
+    @Override
+    public void onDrawOver(Canvas c, RecyclerView parent, RecyclerView.State state) {
+        final View focused = parent.getFocusedChild();
+        // Rows only: inner widgets (range group, chart) draw their own focus state.
+        if (focused == null || !focused.isFocused() || parent.isInTouchMode()) {
+            return;
+        }
+        final float half = mPaint.getStrokeWidth() / 2f;
+        mRect.set(focused.getLeft() + mInset + half, focused.getTop() + mInset + half,
+                focused.getRight() - mInset - half, focused.getBottom() - mInset - half);
+        mRect.offset(focused.getTranslationX(), focused.getTranslationY());
+        c.drawRoundRect(mRect, mRadius, mRadius, mPaint);
+    }
+}
