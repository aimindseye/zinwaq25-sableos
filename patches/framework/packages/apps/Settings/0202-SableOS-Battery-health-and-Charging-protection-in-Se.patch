+
+package com.android.settings.fuelgauge.sable;
+
+import android.content.Context;
+import android.os.UserManager;
+import android.util.AtomicFile;
+import android.util.Log;
+
+import com.android.settings.fuelgauge.sable.model.HistoryRingBuffer;
+import com.android.settings.fuelgauge.sable.model.HistorySample;
+
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.util.Collections;
+import java.util.List;
+
+/**
+ * Local bounded battery history (BH4), stored in Settings' credential-encrypted files dir.
+ * See {@link HistoryRingBuffer} for the sampling and retention policy. Callers:
+ *
+ * <ul>
+ *   <li>PeriodicJobReceiver: the existing hourly battery-usage job (no new alarm);
+ *   <li>Battery screens on resume (the user is looking anyway).
+ * </ul>
+ *
+ * Nothing here schedules work, holds a wakelock or touches the network. The file never leaves
+ * the device; there is no export.
+ */
+public final class SableBatteryHistoryStore {
+    private static final String TAG = "SableBatteryHistory";
+    static final String FILE_NAME = "sable_battery_history.txt";
+    private static final Object LOCK = new Object();
+
+    private SableBatteryHistoryStore() {}
+
+    /** Records a sample if one is due. Safe to call from a broadcast receiver. */
+    public static void sampleIfDue(Context context) {
+        try {
+            if (!context.getSystemService(UserManager.class).isUserUnlocked()) {
+                return;
+            }
+            final SableBatteryState state = SableBatteryState.get(context);
+            final HistorySample sample = HistorySample.from(state.readings, state.report);
+            synchronized (LOCK) {
+                final HistoryRingBuffer buffer = read(context);
+                buffer.prune(sample.timeMillis);
+                if (buffer.add(sample)) {
+                    write(context, buffer);
+                }
+            }
+        } catch (RuntimeException e) {
+            Log.w(TAG, "sample failed", e);
+        }
+    }
+
+    /** Retained samples, oldest first; empty when none or unreadable. */
+    public static List<HistorySample> load(Context context) {
+        try {
+            synchronized (LOCK) {
+                final HistoryRingBuffer buffer = read(context);
+                buffer.prune(System.currentTimeMillis());
+                return buffer.toList();
+            }
+        } catch (RuntimeException e) {
+            Log.w(TAG, "load failed", e);
+            return Collections.emptyList();
+        }
+    }
+
+    private static AtomicFile file(Context context) {
+        return new AtomicFile(new File(context.getFilesDir(), FILE_NAME));
+    }
+
+    private static HistoryRingBuffer read(Context context) {
+        final AtomicFile f = file(context);
+        if (!f.exists()) {
+            return new HistoryRingBuffer();
+        }
+        try {
+            return HistoryRingBuffer.decode(
+                    new String(f.readFully(), StandardCharsets.UTF_8), HistoryRingBuffer.CAPACITY);
+        } catch (IOException e) {
+            Log.w(TAG, "unreadable history, starting over", e);
+            return new HistoryRingBuffer();
+        }
+    }
+
+    private static void write(Context context, HistoryRingBuffer buffer) {
+        final AtomicFile f = file(context);
+        FileOutputStream out = null;
+        try {
+            out = f.startWrite();
+            out.write(buffer.encode().getBytes(StandardCharsets.UTF_8));
+            f.finishWrite(out);
+        } catch (IOException e) {
+            if (out != null) {
+                f.failWrite(out);
+            }
+            Log.w(TAG, "cannot write history", e);
+        }
+    }
+}
diff --git a/src/com/android/settings/fuelgauge/sable/SableBatteryKeyboardSupport.java b/src/com/android/settings/fuelgauge/sable/SableBatteryKeyboardSupport.java
