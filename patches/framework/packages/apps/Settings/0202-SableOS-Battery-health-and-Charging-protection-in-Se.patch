+import com.android.settings.fuelgauge.sable.model.HistoryBuckets;
+import com.android.settings.fuelgauge.sable.model.NavKey;
+
+/**
+ * Bounded bar chart of local battery history with keyboard inspection
+ * ({@link ChartInspectionCursor}). The inspected bucket is drawn solid with an outline; the
+ * others are faded; empty buckets show only a baseline tick. The selected bucket's value is
+ * always also given as text by the owning preference, so color is never the only channel.
+ */
+public class SableHistoryChartView extends View {
+    /** Callbacks to the owning preference. */
+    public interface Listener {
+        /** The inspected bucket or series changed (also after a tap). */
+        void onCursorMoved();
+
+        /** Inspection mode was entered or left. */
+        void onInspectionChanged(boolean inspecting);
+    }
+
+    /** Fixed temperature scale for bars: 0 C to 60 C. */
+    private static final int TEMP_SCALE_MAX_DECI_C = 600;
+
+    private final Paint mBar = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint mOutline = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint mBaseline = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final RectF mRect = new RectF();
+    private final SableBackCallback mBack;
+    private final float mGap;
+    private HistoryBuckets.Bucket[] mBuckets = new HistoryBuckets.Bucket[0];
+    private ChartInspectionCursor mCursor;
+    private Listener mListener;
+
+    public SableHistoryChartView(Context context, AttributeSet attrs) {
+        super(context, attrs);
+        setFocusable(true);
+        setClickable(true);
+        final int fg = SableRangeSelectorView.color(context, android.R.attr.textColorPrimary);
+        mBar.setColor(SableRangeSelectorView.color(context, android.R.attr.colorAccent));
+        mOutline.setStyle(Paint.Style.STROKE);
+        mOutline.setStrokeWidth(getResources().getDimension(R.dimen.sable_battery_focus_stroke));
+        mOutline.setColor(fg);
+        mBaseline.setColor(fg);
+        mBaseline.setAlpha(0x60);
+        mBaseline.setStrokeWidth(getResources().getDisplayMetrics().density);
+        mGap = getResources().getDimension(R.dimen.sable_battery_chart_bar_gap);
+        mBack = new SableBackCallback(() -> handle(NavKey.BACK));
+    }
+
+    public void setListener(Listener l) {
+        mListener = l;
+    }
+
+    /** Binds data. The cursor is owned by the preference so it survives rebinds. */
+    public void setModel(HistoryBuckets.Bucket[] buckets, ChartInspectionCursor cursor) {
+        mBuckets = buckets;
+        mCursor = cursor;
+        mCursor.setRtl(getLayoutDirection() == LAYOUT_DIRECTION_RTL);
+        mBack.setActive(this, mCursor.isInspecting() && hasFocus());
+        invalidate();
+    }
+
+    @Override
+    public boolean onKeyDown(int keyCode, KeyEvent event) {
+        if (mCursor != null && handle(SableBatteryKeys.toNavKey(keyCode))) {
+            return true;
+        }
+        return super.onKeyDown(keyCode, event);
+    }
+
+    private boolean handle(NavKey key) {
+        final boolean wasInspecting = mCursor.isInspecting();
+        final ChartInspectionCursor.Result r = mCursor.handle(key);
+        if (r.moved && mListener != null) {
+            mListener.onCursorMoved();
+        }
+        if (wasInspecting != mCursor.isInspecting()) {
+            mBack.setActive(this, mCursor.isInspecting());
+            if (mListener != null) {
+                mListener.onInspectionChanged(mCursor.isInspecting());
+            }
+        }
+        if (r.consumed) {
+            invalidate();
+        }
+        return r.consumed;
+    }
+
+    @Override
+    protected void onFocusChanged(boolean gainFocus, int direction, Rect previous) {
+        super.onFocusChanged(gainFocus, direction, previous);
+        if (!gainFocus && mCursor != null && mCursor.isInspecting()) {
+            mCursor.exit();
+            mBack.setActive(this, false);
+            if (mListener != null) {
+                mListener.onInspectionChanged(false);
+            }
+            invalidate();
+        }
+    }
+
+    @Override
+    protected void onDetachedFromWindow() {
+        mBack.release();
+        super.onDetachedFromWindow();
+    }
+
+    @Override
+    public boolean onTouchEvent(MotionEvent e) {
+        if (mCursor == null || mBuckets.length == 0) {
+            return super.onTouchEvent(e);
+        }
+        if (e.getAction() == MotionEvent.ACTION_UP) {
+            final float slot = getWidth() / (float) mBuckets.length;
+            int index = (int) (e.getX() / slot);
+            if (getLayoutDirection() == LAYOUT_DIRECTION_RTL) {
+                index = mBuckets.length - 1 - index;
+            }
+            if (mCursor.select(Math.max(0, Math.min(mBuckets.length - 1, index)))
+                    && mListener != null) {
+                mListener.onCursorMoved();
+            }
+            invalidate();
+            performClick();
+        }
+        return true;
+    }
+
+    @Override
+    public boolean performClick() {
+        return super.performClick();
+    }
+
+    @Override
+    protected void onDraw(Canvas canvas) {
+        super.onDraw(canvas);
+        if (mCursor == null || mBuckets.length == 0) {
+            return;
+        }
+        final int series = mCursor.series();
+        final float slot = getWidth() / (float) mBuckets.length;
+        final float top = mOutline.getStrokeWidth();
+        final float bottom = getHeight() - mOutline.getStrokeWidth();
+        final boolean rtl = getLayoutDirection() == LAYOUT_DIRECTION_RTL;
+        canvas.drawLine(0, bottom, getWidth(), bottom, mBaseline);
+        for (int i = 0; i < mBuckets.length; i++) {
+            final int pos = rtl ? mBuckets.length - 1 - i : i;
+            final float left = pos * slot + mGap / 2f;
+            final float right = (pos + 1) * slot - mGap / 2f;
+            final HistoryBuckets.Bucket b = mBuckets[i];
+            final boolean selected = i == mCursor.bucket();
+            if (b.hasValue(series)) {
+                final float fraction = series == HistoryBuckets.SERIES_TEMPERATURE
+                        ? clamp(b.averageTemperatureDeciC / (float) TEMP_SCALE_MAX_DECI_C)
+                        : clamp(b.lastLevelPercent / 100f);
+                mRect.set(left, bottom - (bottom - top) * Math.max(fraction, 0.02f), right,
+                        bottom);
+                mBar.setAlpha(selected ? 0xff : 0x80);
+                canvas.drawRect(mRect, mBar);
+            }
+            if (selected && (mCursor.isInspecting() || hasFocus())) {
+                mRect.set(left, top, right, bottom);
+                canvas.drawRect(mRect, mOutline);
+            }
+        }
+    }
+
+    private static float clamp(float f) {
+        return Math.max(0f, Math.min(1f, f));
+    }
+
+    /** Text for the current bucket: series, time span and value. */
+    static CharSequence bucketText(Context c, HistoryBuckets.Bucket b, int series) {
+        final String seriesName = c.getString(series == HistoryBuckets.SERIES_TEMPERATURE
+                ? R.string.sable_battery_series_temperature : R.string.sable_battery_series_level);
+        String value;
+        if (!b.hasValue(series)) {
+            value = c.getString(R.string.sable_battery_bucket_empty);
+        } else if (series == HistoryBuckets.SERIES_TEMPERATURE) {
+            value = c.getString(R.string.sable_battery_bucket_temperature,
+                    SableBatteryText.temperature(c, b.averageTemperatureDeciC),
+                    SableBatteryText.temperature(c, b.maxTemperatureDeciC));
+        } else {
+            value = com.android.settingslib.Utils.formatPercentage(b.lastLevelPercent);
+        }
+        if (b.anyCharging && b.sampleCount > 0) {
+            value = value + c.getString(R.string.sable_battery_list_separator)
+                    + c.getString(R.string.sable_battery_bucket_charging);
+        }
+        return c.getString(R.string.sable_battery_bucket_text, seriesName,
+                SableBatteryText.span(c, b.startMillis, b.endMillis), value);
+    }
+}
