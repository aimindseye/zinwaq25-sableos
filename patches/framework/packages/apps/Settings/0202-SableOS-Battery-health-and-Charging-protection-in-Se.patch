+package com.android.settings.fuelgauge.sable;
+
+import android.content.Context;
+
+import com.android.settings.core.BasePreferenceController;
+import com.android.settings.fuelgauge.sable.model.FactKind;
+import com.android.settings.fuelgauge.sable.model.FactText;
+import com.android.settings.fuelgauge.sable.model.HealthFactPresenter;
+
+import java.time.ZoneId;
+
+/**
+ * One Battery health row. The preference key selects the fact. Unavailable facts stay visible
+ * with an honest "Not reported" / "Not verified" summary, except dates, which the design says
+ * to omit when untrustworthy.
+ */
+public class SableHealthFactPreferenceController extends BasePreferenceController {
+    static final String PREFIX = "sable_battery_fact_";
+
+    private final FactKind mKind;
+
+    public SableHealthFactPreferenceController(Context context, String key) {
+        super(context, key);
+        mKind = kindForKey(key);
+    }
+
+    static FactKind kindForKey(String key) {
+        if (key == null || !key.startsWith(PREFIX)) {
+            return null;
+        }
+        try {
+            return FactKind.valueOf(
+                    key.substring(PREFIX.length()).toUpperCase(java.util.Locale.ROOT));
+        } catch (IllegalArgumentException e) {
+            return null;
+        }
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        if (mKind == null) {
+            return UNSUPPORTED_ON_DEVICE;
+        }
+        if (mKind == FactKind.MANUFACTURING_DATE || mKind == FactKind.FIRST_USE_DATE) {
+            return SableBatteryState.get(mContext).report.fact(mKind).isAvailable()
+                    ? AVAILABLE : CONDITIONALLY_UNAVAILABLE;
+        }
+        return AVAILABLE;
+    }
+
+    private FactText text() {
+        final SableBatteryState s = SableBatteryState.get(mContext);
+        return HealthFactPresenter.present(s.report.fact(mKind),
+                s.discovery.shutdownTemperatureDeciC, ZoneId.systemDefault(),
+                System.currentTimeMillis());
+    }
+
+    @Override
+    public CharSequence getSummary() {
+        return mKind == null ? null : SableBatteryText.summary(mContext, text());
+    }
+}
