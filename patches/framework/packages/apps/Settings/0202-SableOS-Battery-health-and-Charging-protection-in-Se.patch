+
+package com.android.settings.fuelgauge.sable;
+
+import android.view.KeyEvent;
+
+import com.android.settings.fuelgauge.sable.model.NavKey;
+
+/** Maps Android key codes to the normalized {@link NavKey}s. System HOME is never MOVE_HOME. */
+public final class SableBatteryKeys {
+    private SableBatteryKeys() {}
+
+    public static NavKey toNavKey(int keyCode) {
+        switch (keyCode) {
+            case KeyEvent.KEYCODE_DPAD_UP:
+                return NavKey.UP;
+            case KeyEvent.KEYCODE_DPAD_DOWN:
+                return NavKey.DOWN;
+            case KeyEvent.KEYCODE_DPAD_LEFT:
+                return NavKey.LEFT;
+            case KeyEvent.KEYCODE_DPAD_RIGHT:
+                return NavKey.RIGHT;
+            case KeyEvent.KEYCODE_ENTER:
+            case KeyEvent.KEYCODE_NUMPAD_ENTER:
+            case KeyEvent.KEYCODE_DPAD_CENTER:
+                return NavKey.ENTER;
+            case KeyEvent.KEYCODE_SPACE:
+                return NavKey.SPACE;
+            case KeyEvent.KEYCODE_ESCAPE:
+                return NavKey.ESCAPE;
+            case KeyEvent.KEYCODE_BACK:
+                return NavKey.BACK;
+            case KeyEvent.KEYCODE_PAGE_UP:
+                return NavKey.PAGE_UP;
+            case KeyEvent.KEYCODE_PAGE_DOWN:
+                return NavKey.PAGE_DOWN;
+            case KeyEvent.KEYCODE_MOVE_HOME:
+                return NavKey.MOVE_HOME;
+            case KeyEvent.KEYCODE_MOVE_END:
+                return NavKey.MOVE_END;
+            default:
+                return NavKey.OTHER;
+        }
+    }
+}
