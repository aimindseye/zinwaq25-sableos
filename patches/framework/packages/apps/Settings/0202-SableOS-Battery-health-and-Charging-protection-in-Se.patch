+package com.android.settings.fuelgauge.sable;
+
+import android.content.Context;
+
+import com.android.settings.core.BasePreferenceController;
+
+/**
+ * Hides the LineageOS "Charging control" entry (a mutable charge limit backed by the
+ * lineagehealth service) unless the Sable charging gate allows vendor controls, which it does
+ * not while BH6 is unauthorized. The Charging and protection page reports a detected backend
+ * as "found, not yet qualified" instead.
+ */
+public class SableVendorChargingGateController extends BasePreferenceController {
+
+    public SableVendorChargingGateController(Context context, String key) {
+        super(context, key);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return SableChargingGate.vendorControlsAllowed(mContext)
+                ? AVAILABLE : CONDITIONALLY_UNAVAILABLE;
+    }
+}
