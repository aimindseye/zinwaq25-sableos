+package com.android.settings.fuelgauge.sable;
+
+import android.content.Context;
+
+import com.android.settings.R;
+import com.android.settings.fuelgauge.sable.model.ChargingControl;
+import com.android.settings.fuelgauge.sable.model.ChargingControlPolicy;
+
+/** Settings-side entry to {@link ChargingControlPolicy}. */
+public final class SableChargingGate {
+    private SableChargingGate() {}
+
+    /** True when the Sable Battery layer is on in this build. */
+    public static boolean isSableBatteryEnabled(Context context) {
+        return context.getResources().getBoolean(R.bool.config_sable_battery_enabled);
+    }
+
+    public static ChargingControlPolicy.State state(Context context, ChargingControl control) {
+        final SableBatteryState s = SableBatteryState.get(context);
+        return ChargingControlPolicy.state(control, s.profile, s.discovery);
+    }
+
+    /**
+     * Whether charging controls that Sable does not own (LineageOS charging control and
+     * charging speed) may be offered. Always false while BH6 is not authorized: an unqualified
+     * backend must not be mutable from the common Settings UI.
+     */
+    public static boolean vendorControlsAllowed(Context context) {
+        if (!isSableBatteryEnabled(context)) {
+            return true; // Sable layer off: stock LineageOS behaviour.
+        }
+        return state(context, ChargingControl.VENDOR_CHARGING_CONTROLS)
+                == ChargingControlPolicy.State.ENABLED;
+    }
+}
