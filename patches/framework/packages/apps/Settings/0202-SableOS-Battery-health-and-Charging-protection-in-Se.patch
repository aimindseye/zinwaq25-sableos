+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.settings.fuelgauge.sable;
+
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.Paint;
+import android.graphics.RectF;
+import android.util.AttributeSet;
+import android.util.TypedValue;
+import android.view.KeyEvent;
+import android.view.MotionEvent;
+import android.view.View;
+import android.view.accessibility.AccessibilityNodeInfo;
+
+import com.android.settings.R;
+import com.android.settings.fuelgauge.sable.model.NavKey;
+import com.android.settings.fuelgauge.sable.model.SegmentedRangeGroup;
+
+/**
+ * Segmented range control (Today / 24 hours / 7 days) as one focus stop, driven by
+ * {@link SegmentedRangeGroup}. The selected segment is marked by a filled background and bold
+ * text, the pending segment by an outline: never by color alone. Tapping a segment is the
+ * touch fallback.
+ */
+public class SableRangeSelectorView extends View {
+    /** Called when the confirmed segment changes. */
+    public interface Listener {
+        void onRangeConfirmed(int index);
+    }
+
+    private final Paint mText = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint mFill = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint mStroke = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final RectF mRect = new RectF();
+    private final SableBackCallback mBack;
+    private CharSequence[] mLabels = new CharSequence[0];
+    private SegmentedRangeGroup mGroup;
+    private Listener mListener;
+
+    public SableRangeSelectorView(Context context, AttributeSet attrs) {
+        super(context, attrs);
+        setFocusable(true);
+        setClickable(true);
+        mText.setTextAlign(Paint.Align.CENTER);
+        mText.setTextSize(TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_SP, 14,
+                getResources().getDisplayMetrics()));
+        mText.setColor(color(context, android.R.attr.textColorPrimary));
+        mFill.setColor(color(context, android.R.attr.colorControlHighlight));
+        mStroke.setStyle(Paint.Style.STROKE);
+        mStroke.setStrokeWidth(getResources().getDimension(R.dimen.sable_battery_focus_stroke));
+        mStroke.setColor(color(context, android.R.attr.textColorPrimary));
+        mBack = new SableBackCallback(() -> handle(NavKey.BACK));
+    }
+
+    static int color(Context c, int attr) {
+        final TypedValue v = new TypedValue();
+        if (!c.getTheme().resolveAttribute(attr, v, true)) {
+            return 0xff000000;
+        }
+        return v.resourceId != 0 ? c.getColorStateList(v.resourceId).getDefaultColor() : v.data;
+    }
+
+    public void setLabels(CharSequence[] labels, int confirmed) {
+        mLabels = labels;
+        mGroup = new SegmentedRangeGroup(labels.length, confirmed);
+        mGroup.setRtl(getLayoutDirection() == LAYOUT_DIRECTION_RTL);
+        updateDescription();
+        invalidate();
+    }
+
+    public void setListener(Listener l) {
+        mListener = l;
+    }
+
+    private void updateDescription() {
+        if (mGroup != null) {
+            setContentDescription(getContext().getString(R.string.sable_battery_range_description,
+                    mLabels[mGroup.pending()]));
+        }
+    }
+
+    @Override
+    public boolean onKeyDown(int keyCode, KeyEvent event) {
+        if (mGroup != null && handle(SableBatteryKeys.toNavKey(keyCode))) {
+            return true;
+        }
+        return super.onKeyDown(keyCode, event);
+    }
+
+    private boolean handle(NavKey key) {
+        final SegmentedRangeGroup.Result r = mGroup.handle(key);
+        if (r.pendingChanged) {
+            updateDescription();
+            invalidate();
+            announceForAccessibility(mLabels[mGroup.pending()]);
+        }
+        if (r.confirmedChanged && mListener != null) {
+            mListener.onRangeConfirmed(mGroup.confirmed());
+        }
+        mBack.setActive(this, mGroup.isActive());
+        return r.consumed;
+    }
+
+    @Override
+    protected void onFocusChanged(boolean gainFocus, int direction,
+            android.graphics.Rect previouslyFocusedRect) {
+        super.onFocusChanged(gainFocus, direction, previouslyFocusedRect);
+        if (!gainFocus && mGroup != null) {
+            mGroup.blur();
+            mBack.setActive(this, false);
+            updateDescription();
+            invalidate();
+        }
+    }
+
+    @Override
+    protected void onDetachedFromWindow() {
+        mBack.release();
+        super.onDetachedFromWindow();
+    }
+
+    @Override
+    public boolean onTouchEvent(MotionEvent e) {
+        if (mGroup == null || mLabels.length == 0) {
+            return super.onTouchEvent(e);
+        }
+        if (e.getAction() == MotionEvent.ACTION_UP) {
+            final float w = getWidth() / (float) mLabels.length;
+            int index = (int) (e.getX() / w);
+            if (getLayoutDirection() == LAYOUT_DIRECTION_RTL) {
+                index = mLabels.length - 1 - index;
+            }
+            if (mGroup.tap(Math.max(0, Math.min(mLabels.length - 1, index)))
+                    && mListener != null) {
+                mListener.onRangeConfirmed(mGroup.confirmed());
+            }
+            updateDescription();
+            invalidate();
+            performClick();
+        }
+        return true;
+    }
+
+    @Override
+    public boolean performClick() {
+        return super.performClick();
+    }
+
+    @Override
+    public void onInitializeAccessibilityNodeInfo(AccessibilityNodeInfo info) {
+        super.onInitializeAccessibilityNodeInfo(info);
+        info.setClassName(android.widget.RadioGroup.class.getName());
+    }
+
+    @Override
+    protected void onDraw(Canvas canvas) {
+        super.onDraw(canvas);
+        if (mGroup == null || mLabels.length == 0) {
+            return;
+        }
+        final float w = getWidth() / (float) mLabels.length;
+        final float h = getHeight();
+        final float r = getResources().getDimension(R.dimen.sable_battery_focus_radius);
+        final float inset = mStroke.getStrokeWidth();
+        final boolean rtl = getLayoutDirection() == LAYOUT_DIRECTION_RTL;
+        for (int i = 0; i < mLabels.length; i++) {
+            final int slot = rtl ? mLabels.length - 1 - i : i;
+            mRect.set(slot * w + inset, inset, (slot + 1) * w - inset, h - inset);
+            final boolean confirmed = i == mGroup.confirmed();
+            if (confirmed) {
+                canvas.drawRoundRect(mRect, r, r, mFill);
+            }
+            if (mGroup.isActive() && i == mGroup.pending()) {
+                canvas.drawRoundRect(mRect, r, r, mStroke);
+            }
+            mText.setFakeBoldText(confirmed);
+            final float y = h / 2f - (mText.descent() + mText.ascent()) / 2f;
+            canvas.drawText(mLabels[i].toString(), mRect.centerX(), y, mText);
+        }
+    }
+}
