+package com.android.settings.fuelgauge.sable;
+
+import android.content.Context;
+import android.util.AttributeSet;
+import android.view.View;
+import android.view.accessibility.AccessibilityNodeInfo;
+import android.widget.TextView;
+
+import androidx.preference.Preference;
+import androidx.preference.PreferenceViewHolder;
+
+/**
+ * A row for a control the device cannot offer. It looks disabled and reports itself disabled
+ * to accessibility services, but the row stays focusable so keyboard-only users can reach and
+ * read it (a disabled View cannot take focus). Activating it does nothing.
+ */
+public class SableUnavailablePreference extends Preference {
+    private boolean mUnavailable = true;
+
+    public SableUnavailablePreference(Context context, AttributeSet attrs) {
+        super(context, attrs);
+        setPersistent(false);
+    }
+
+    public SableUnavailablePreference(Context context) {
+        this(context, null);
+    }
+
+    /** True: shown as an unavailable control. False: a normal read-only status row. */
+    public void setUnavailable(boolean unavailable) {
+        if (mUnavailable != unavailable) {
+            mUnavailable = unavailable;
+            notifyChanged();
+        }
+    }
+
+    public boolean isUnavailable() {
+        return mUnavailable;
+    }
+
+    @Override
+    public void onBindViewHolder(PreferenceViewHolder holder) {
+        super.onBindViewHolder(holder);
+        final View title = holder.findViewById(android.R.id.title);
+        final View summary = holder.findViewById(android.R.id.summary);
+        final View icon = holder.findViewById(android.R.id.icon);
+        for (View v : new View[] {title, summary, icon}) {
+            if (v != null) {
+                v.setEnabled(!mUnavailable);
+            }
+        }
+        if (summary instanceof TextView) {
+            ((TextView) summary).setMaxLines(4);
+        }
+        holder.itemView.setAccessibilityDelegate(new View.AccessibilityDelegate() {
+            @Override
+            public void onInitializeAccessibilityNodeInfo(View host,
+                    AccessibilityNodeInfo info) {
+                super.onInitializeAccessibilityNodeInfo(host, info);
+                if (mUnavailable) {
+                    info.setEnabled(false);
+                    info.setClickable(false);
+                    info.removeAction(AccessibilityNodeInfo.AccessibilityAction.ACTION_CLICK);
+                }
+            }
+        });
+    }
+
+    @Override
+    protected void onClick() {
+        // Nothing to do: unavailable controls and status rows have no action.
+    }
+}
