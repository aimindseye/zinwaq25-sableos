+
+package com.android.settings.fuelgauge.sable;
+
+import android.view.View;
+
+import androidx.activity.OnBackPressedCallback;
+import androidx.activity.OnBackPressedDispatcher;
+import androidx.activity.OnBackPressedDispatcherOwner;
+import androidx.activity.ViewTreeOnBackPressedDispatcherOwner;
+
+/**
+ * Routes Back to a temporary keyboard mode (chart inspection, range group) while that mode is
+ * active. Settings opts into OnBackInvokedCallback, so KEYCODE_BACK does not reach views;
+ * this registers an androidx back callback that is enabled only while the mode is active and
+ * removed when the view detaches. Escape is handled by the view's own key handling.
+ */
+public final class SableBackCallback {
+    private final OnBackPressedCallback mCallback;
+    private boolean mRegistered;
+
+    public SableBackCallback(Runnable onBack) {
+        mCallback = new OnBackPressedCallback(false) {
+            @Override
+            public void handleOnBackPressed() {
+                onBack.run();
+            }
+        };
+    }
+
+    /** Enables or disables interception; registers lazily on the view's dispatcher. */
+    public void setActive(View view, boolean active) {
+        if (active && !mRegistered) {
+            final OnBackPressedDispatcherOwner owner =
+                    ViewTreeOnBackPressedDispatcherOwner.get(view);
+            if (owner == null) {
+                return; // No dispatcher: Escape still exits the mode.
+            }
+            final OnBackPressedDispatcher dispatcher = owner.getOnBackPressedDispatcher();
+            dispatcher.addCallback(mCallback);
+            mRegistered = true;
+        }
+        mCallback.setEnabled(active);
+    }
+
+    /** Unregisters; call from onDetachedFromWindow. */
+    public void release() {
+        mCallback.setEnabled(false);
+        mCallback.remove();
+        mRegistered = false;
+    }
+}
