+
+package com.android.settings.fuelgauge.sable;
+
+import android.content.Context;
+import android.util.AttributeSet;
+import android.widget.TextView;
+
+import androidx.preference.Preference;
+import androidx.preference.PreferenceViewHolder;
+
+import com.android.settings.R;
+import com.android.settings.fuelgauge.sable.model.ChartInspectionCursor;
+import com.android.settings.fuelgauge.sable.model.HistoryBuckets;
+import com.android.settings.fuelgauge.sable.model.HistoryRange;
+import com.android.settings.fuelgauge.sable.model.HistorySample;
+
+import java.time.ZoneId;
+import java.util.Collections;
+import java.util.List;
+
+/**
+ * Battery health history row (BH4): range group, bounded chart and a text line for the
+ * inspected bucket. Data comes only from {@link SableBatteryHistoryStore} (local, 7 days).
+ */
+public class SableBatteryHistoryPreference extends Preference
+        implements SableHistoryChartView.Listener, SableRangeSelectorView.Listener {
+    static final String KEY = "sable_battery_history";
+    private static final HistoryRange[] RANGES = {
+        HistoryRange.TODAY, HistoryRange.LAST_24_HOURS, HistoryRange.LAST_7_DAYS,
+    };
+
+    private int mRangeIndex = 1; // 24 hours
+    private List<HistorySample> mSamples = Collections.emptyList();
+    private HistoryBuckets.Bucket[] mBuckets = new HistoryBuckets.Bucket[0];
+    private final ChartInspectionCursor mCursor =
+            new ChartInspectionCursor(new boolean[][] {new boolean[0]}, 6);
+    private TextView mBucketText;
+    private TextView mHint;
+    private SableHistoryChartView mChart;
+
+    public SableBatteryHistoryPreference(Context context, AttributeSet attrs) {
+        super(context, attrs);
+        setLayoutResource(R.layout.sable_battery_history_preference);
+        setSelectable(false);
+        setPersistent(false);
+    }
+
+    /** Reloads samples from the local store (screen resumed). */
+    public void reload() {
+        mSamples = SableBatteryHistoryStore.load(getContext());
+        rebucket();
+        notifyChanged();
+    }
+
+    private void rebucket() {
+        final HistoryRange.Window w = RANGES[mRangeIndex].window(System.currentTimeMillis(),
+                ZoneId.systemDefault());
+        mBuckets = HistoryBuckets.bucketize(mSamples, w);
+        final boolean[][] valid = new boolean[HistoryBuckets.SERIES_COUNT][];
+        for (int s = 0; s < HistoryBuckets.SERIES_COUNT; s++) {
+            valid[s] = HistoryBuckets.validity(mBuckets, s);
+        }
+        mCursor.setData(valid);
+    }
+
+    @Override
+    public void onBindViewHolder(PreferenceViewHolder holder) {
+        super.onBindViewHolder(holder);
+        holder.itemView.setFocusable(false);
+        final Context c = getContext();
+        final SableRangeSelectorView range =
+                (SableRangeSelectorView) holder.findViewById(R.id.sable_battery_range);
+        range.setLabels(new CharSequence[] {
+            c.getText(R.string.sable_battery_range_today),
+            c.getText(R.string.sable_battery_range_24h),
+            c.getText(R.string.sable_battery_range_7d),
+        }, mRangeIndex);
+        range.setListener(this);
+
+        mChart = (SableHistoryChartView) holder.findViewById(R.id.sable_battery_chart);
+        mChart.setModel(mBuckets, mCursor);
+        mChart.setListener(this);
+        mBucketText = (TextView) holder.findViewById(R.id.sable_battery_bucket_text);
+        mHint = (TextView) holder.findViewById(R.id.sable_battery_chart_hint);
+        updateText();
+    }
+
+    private void updateText() {
+        if (mBucketText == null) {
+            return;
+        }
+        final Context c = getContext();
+        final boolean any = mCursor.bucket() >= 0;
+        final CharSequence text = any
+                ? SableHistoryChartView.bucketText(c, mBuckets[mCursor.bucket()],
+                        mCursor.series())
+                : c.getText(R.string.sable_battery_history_empty);
+        mBucketText.setText(text);
+        mHint.setText(mCursor.isInspecting() ? R.string.sable_battery_chart_hint_inspecting
+                : R.string.sable_battery_chart_hint_idle);
+        mHint.setVisibility(any ? android.view.View.VISIBLE : android.view.View.GONE);
+        if (mChart != null) {
+            mChart.setContentDescription(c.getString(R.string.sable_battery_chart_description)
+                    + " " + text);
+        }
+    }
+
+    @Override
+    public void onCursorMoved() {
+        updateText();
+    }
+
+    @Override
+    public void onInspectionChanged(boolean inspecting) {
+        updateText();
+    }
+
+    @Override
+    public void onRangeConfirmed(int index) {
+        mRangeIndex = index;
+        rebucket();
+        if (mChart != null) {
+            mChart.setModel(mBuckets, mCursor);
+        }
+        updateText();
+    }
+}
