+package com.android.settings.fuelgauge.sable;
+
+import android.content.Context;
+
+import com.android.settings.core.BasePreferenceController;
+
+/**
+ * Hides Android's "Battery information" row when the Sable Battery health page is on: that
+ * page shows capacity and cycle count without device-profile gating, which the design forbids
+ * (FABRICATED_HEALTH_PERCENTAGE=PASS_ABSENT). The Sable page shows the same facts, gated.
+ */
+public class SableLegacyBatteryInfoController extends BasePreferenceController {
+
+    public SableLegacyBatteryInfoController(Context context, String key) {
+        super(context, key);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return SableChargingGate.isSableBatteryEnabled(mContext)
+                ? CONDITIONALLY_UNAVAILABLE : AVAILABLE;
+    }
