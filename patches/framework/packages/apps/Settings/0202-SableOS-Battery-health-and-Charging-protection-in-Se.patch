+
+package com.android.settings.fuelgauge.sable;
+
+import android.content.Context;
+import android.os.BatteryConsumer;
+import android.os.BatteryUsageStats;
+import android.util.Log;
+
+import com.android.settings.R;
+import com.android.settings.fuelgauge.batteryusage.BatteryEntry;
+import com.android.settings.fuelgauge.sable.model.BatteryCapabilityProfile;
+import com.android.settings.fuelgauge.sable.model.Capability;
+import com.android.settings.fuelgauge.sable.model.UsageSummary;
+import com.android.settingslib.Utils;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Battery overview "Battery usage" summary (BH2): the top system consumers from Android's own
+ * BatteryUsageStats, labelled with the start of the accounting window, e.g.
+ * "Since Oct 9, 07:12 · Screen 24% · Mobile network 17%". No Sable-side accounting.
+ */
+public final class SableBatteryUsageSummary {
+    private static final String TAG = "SableBatteryUsage";
+    private static final int[] COMPONENTS = {
+        BatteryConsumer.POWER_COMPONENT_SCREEN,
+        BatteryConsumer.POWER_COMPONENT_CPU,
+        BatteryConsumer.POWER_COMPONENT_BLUETOOTH,
+        BatteryConsumer.POWER_COMPONENT_CAMERA,
+        BatteryConsumer.POWER_COMPONENT_FLASHLIGHT,
+        BatteryConsumer.POWER_COMPONENT_MOBILE_RADIO,
+        BatteryConsumer.POWER_COMPONENT_GNSS,
+        BatteryConsumer.POWER_COMPONENT_WIFI,
+        BatteryConsumer.POWER_COMPONENT_PHONE,
+    };
+
+    private SableBatteryUsageSummary() {}
+
+    /** The summary, or null to keep Android's default summary. */
+    public static CharSequence summarize(Context context, BatteryUsageStats stats) {
+        if (stats == null || !SableChargingGate.isSableBatteryEnabled(context)) {
+            return null;
+        }
+        final BatteryCapabilityProfile profile = SableBatteryProfileLoader.get();
+        if (profile.capability(BatteryCapabilityProfile.KEY_USAGE_PLATFORM_ACCOUNTING)
+                == Capability.UNSUPPORTED) {
+            return null;
+        }
+        try {
+            final BatteryConsumer device = stats.getAggregateBatteryConsumer(
+                    BatteryUsageStats.AGGREGATE_BATTERY_CONSUMER_SCOPE_DEVICE);
+            final List<UsageSummary.Component> components = new ArrayList<>();
+            for (int id : COMPONENTS) {
+                components.add(new UsageSummary.Component(id, device.getConsumedPower(id)));
+            }
+            final UsageSummary s = UsageSummary.build(stats.getStatsStartTimestamp(),
+                    stats.getStatsEndTimestamp(), device.getConsumedPower(), components, 2, 1);
+            if (s == null || s.shares.isEmpty()) {
+                return null;
+            }
+            final StringBuilder joined = new StringBuilder();
+            for (UsageSummary.Share share : s.shares) {
+                final String name =
+                        BatteryEntry.getNameAndIconFromPowerComponent(context, share.componentId)
+                                .mName;
+                if (name == null) {
+                    continue;
+                }
+                if (joined.length() > 0) {
+                    joined.append(context.getString(R.string.sable_battery_list_separator));
+                }
+                joined.append(context.getString(R.string.sable_battery_usage_share, name,
+                        Utils.formatPercentage(share.percent)));
+            }
+            if (joined.length() == 0) {
+                return null;
+            }
+            return context.getString(R.string.sable_battery_usage_summary,
+                    SableBatteryText.windowStart(context, s.windowStartMillis), joined);
+        } catch (RuntimeException e) {
+            Log.w(TAG, "usage summary unavailable", e);
+            return null;
+        }
+    }
+}
