+
+package com.android.settings.fuelgauge.sable;
+
+import android.content.Context;
+
+import androidx.preference.Preference;
+
+import com.android.settings.R;
+import com.android.settings.core.BasePreferenceController;
+import com.android.settings.fuelgauge.sable.model.ChargingControl;
+import com.android.settings.fuelgauge.sable.model.ChargingControlPolicy;
+import com.android.settingslib.search.SearchIndexableRaw;
+
+import java.util.List;
+
+/**
+ * One Charging and protection row, driven by {@link ChargingControlPolicy}. While BH6 is not
+ * authorized every mutable control renders as an unavailable row; nothing here writes to any
+ * backend.
+ */
+public class SableChargingControlPreferenceController extends BasePreferenceController {
+    static final String KEY_CHARGE_LIMIT = "sable_charging_charge_limit";
+    static final String KEY_ADAPTIVE = "sable_charging_adaptive";
+    static final String KEY_SCHEDULED = "sable_charging_scheduled";
+    static final String KEY_THERMAL = "sable_charging_thermal";
+    static final String KEY_POLICY = "sable_charging_policy";
+
+    private final ChargingControl mControl;
+
+    public SableChargingControlPreferenceController(Context context, String key) {
+        super(context, key);
+        mControl = controlForKey(key);
+    }
+
+    static ChargingControl controlForKey(String key) {
+        if (KEY_CHARGE_LIMIT.equals(key)) {
+            return ChargingControl.CHARGE_LIMIT;
+        } else if (KEY_ADAPTIVE.equals(key)) {
+            return ChargingControl.ADAPTIVE_CHARGING;
+        } else if (KEY_SCHEDULED.equals(key)) {
+            return ChargingControl.SCHEDULED_CHARGING;
+        } else if (KEY_THERMAL.equals(key)) {
+            return ChargingControl.THERMAL_PROTECTION;
+        } else if (KEY_POLICY.equals(key)) {
+            return ChargingControl.CHARGING_POLICY_STATUS;
+        }
+        return null;
+    }
+
+    private ChargingControlPolicy.State state() {
+        return mControl == null ? ChargingControlPolicy.State.HIDDEN
+                : SableChargingGate.state(mContext, mControl);
+    }
+
+    private static boolean isUnavailable(ChargingControlPolicy.State s) {
+        return s == ChargingControlPolicy.State.UNAVAILABLE_ON_DEVICE
+                || s == ChargingControlPolicy.State.NOT_AVAILABLE_YET
+                || s == ChargingControlPolicy.State.BACKEND_NOT_QUALIFIED;
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        final ChargingControlPolicy.State s = state();
+        if (s == ChargingControlPolicy.State.HIDDEN) {
+            return CONDITIONALLY_UNAVAILABLE;
+        }
+        // Unavailable controls are not indexed under their plain title; see
+        // updateDynamicRawDataToIndex for the explicit "(not available)" search entry.
+        return isUnavailable(s) ? AVAILABLE_UNSEARCHABLE : AVAILABLE;
+    }
+
+    @Override
+    public CharSequence getSummary() {
+        final SableBatteryState s = SableBatteryState.get(mContext);
+        return SableBatteryText.controlSummary(mContext, state(), s.discovery,
+                mControl == ChargingControl.CHARGING_POLICY_STATUS);
+    }
+
+    @Override
+    public void updateState(Preference preference) {
+        super.updateState(preference);
+        if (preference instanceof SableUnavailablePreference) {
+            ((SableUnavailablePreference) preference).setUnavailable(isUnavailable(state()));
+        }
+    }
+
+    @Override
+    public void updateDynamicRawDataToIndex(List<SearchIndexableRaw> rawData) {
+        if (mControl == null || !mControl.isMutable() || !isUnavailable(state())) {
+            return;
+        }
+        final SearchIndexableRaw raw = new SearchIndexableRaw(mContext);
+        final String title = mContext.getString(titleRes());
+        raw.key = getPreferenceKey();
+        raw.title = mContext.getString(R.string.sable_battery_search_unavailable, title);
+        raw.keywords = title;
+        raw.screenTitle = mContext.getString(R.string.sable_battery_charging_title);
+        raw.className = SableChargingProtectionFragment.class.getName();
+        rawData.add(raw);
+    }
+
+    private int titleRes() {
+        switch (mControl) {
+            case ADAPTIVE_CHARGING:
+                return R.string.sable_battery_adaptive_charging_title;
+            case SCHEDULED_CHARGING:
+                return R.string.sable_battery_scheduled_charging_title;
+            case CHARGE_LIMIT:
+            default:
+                return R.string.sable_battery_charge_limit_title;
+        }
+    }
+}
