+<!-- Type-ahead aliases for Battery rows, by preference key: entry 2n is a key, 2n+1 its
+     comma-separated aliases. Aliases outrank titles, so "b" reaches Battery saver even though
+     several titles start with "Battery". Translate the aliases, never the keys. -->
+<resources>
+    <string-array name="sable_battery_type_ahead_aliases" translatable="false">
+        <item>battery_usage_summary</item>
+        <item>@string/sable_battery_alias_usage</item>
+        <item>sable_battery_health</item>
+        <item>@string/sable_battery_alias_health</item>
+        <item>sable_charging_protection</item>
+        <item>@string/sable_battery_alias_charging</item>
+        <item>battery_saver_summary</item>
+        <item>@string/sable_battery_alias_saver</item>
+    </string-array>
+    <string name="sable_battery_alias_usage">usage, drain</string>
+    <string name="sable_battery_alias_health">health, maximum capacity</string>
+    <string name="sable_battery_alias_charging">charging, charge limit, protection</string>
+    <string name="sable_battery_alias_saver">battery saver, saver, power saver</string>
+</resources>
