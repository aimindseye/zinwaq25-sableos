+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.settings.fuelgauge.sable;
+
+import android.os.SystemProperties;
+import android.util.Log;
+
+import com.android.settings.fuelgauge.sable.model.BatteryCapabilityProfile;
+import com.android.settings.fuelgauge.sable.model.BatteryProfileParser;
+
+import java.io.File;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+
+/**
+ * Loads the device's battery capability profile. The profile id comes from
+ * {@code ro.sable.profile.id}; the data file is
+ * {@code /system_ext/etc/sable/battery/<id>.conf} (or the same path under /product). A missing,
+ * unreadable or malformed file yields {@link BatteryCapabilityProfile#EMPTY}: every capability
+ * UNKNOWN, every strict fact unavailable, every charging control unqualified. Common code never
+ * branches on a device model; device differences live only in that data file.
+ */
+public final class SableBatteryProfileLoader {
+    private static final String TAG = "SableBatteryProfile";
+    static final String PROP_PROFILE_ID = "ro.sable.profile.id";
+    private static final String[] DIRS = {
+        "/system_ext/etc/sable/battery", "/product/etc/sable/battery",
+    };
+    private static final long MAX_BYTES = 16 * 1024;
+
+    private static volatile BatteryCapabilityProfile sCached;
+
+    private SableBatteryProfileLoader() {}
+
+    /** The profile for this device, read once per process. */
+    public static BatteryCapabilityProfile get() {
+        BatteryCapabilityProfile p = sCached;
+        if (p == null) {
+            p = load(SystemProperties.get(PROP_PROFILE_ID, ""));
+            sCached = p;
+        }
+        return p;
+    }
+
+    static BatteryCapabilityProfile load(String profileId) {
+        if (!BatteryProfileParser.isValidProfileId(profileId)) {
+            return BatteryCapabilityProfile.EMPTY;
+        }
+        for (String dir : DIRS) {
+            final File f = new File(dir, profileId + ".conf");
+            if (!f.isFile() || f.length() > MAX_BYTES) {
+                continue;
+            }
+            try {
+                final String text =
+                        new String(Files.readAllBytes(f.toPath()), StandardCharsets.UTF_8);
+                final BatteryCapabilityProfile p = BatteryProfileParser.parse(text, profileId);
+                for (String w : p.warnings()) {
+                    Log.w(TAG, f + ": " + w);
+                }
+                return p;
+            } catch (IOException | SecurityException e) {
+                Log.w(TAG, "cannot read " + f, e);
+            }
+        }
+        return BatteryCapabilityProfile.EMPTY;
+    }
+}
diff --git a/src/com/android/settings/fuelgauge/sable/SableBatteryState.java b/src/com/android/settings/fuelgauge/sable/SableBatteryState.java
