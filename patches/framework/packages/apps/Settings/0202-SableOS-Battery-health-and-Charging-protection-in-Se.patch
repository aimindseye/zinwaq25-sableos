+
+package com.android.settings.fuelgauge.sable;
+
+import android.content.Context;
+
+import com.android.settings.R;
+import com.android.settings.core.BasePreferenceController;
+import com.android.settings.fuelgauge.sable.model.FactKind;
+import com.android.settings.fuelgauge.sable.model.HealthFactPresenter;
+import com.android.settingslib.Utils;
+
+/** Battery overview row "Battery health" with an availability-aware summary. */
+public class SableBatteryHealthEntryController extends BasePreferenceController {
+
+    public SableBatteryHealthEntryController(Context context, String key) {
+        super(context, key);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return SableChargingGate.isSableBatteryEnabled(mContext)
+                && com.android.settings.Utils.isBatteryPresent(mContext)
+                ? AVAILABLE : UNSUPPORTED_ON_DEVICE;
+    }
+
+    @Override
+    public CharSequence getSummary() {
+        final SableBatteryState s = SableBatteryState.get(mContext);
+        switch (HealthFactPresenter.overview(s.report)) {
+            case CAPACITY_PERCENT:
+                return mContext.getString(R.string.sable_battery_health_summary_capacity,
+                        Utils.formatPercentage(
+                                (int) s.report.fact(FactKind.CAPACITY_HEALTH).value()));
+            case PARTIAL_TEMPERATURE:
+                return mContext.getText(R.string.sable_battery_health_summary_partial_temperature);
+            case PARTIAL:
+                return mContext.getText(R.string.sable_battery_health_summary_partial);
+            case NONE:
+            default:
+                return mContext.getText(R.string.sable_battery_health_summary_none);
+        }
+    }
+}
