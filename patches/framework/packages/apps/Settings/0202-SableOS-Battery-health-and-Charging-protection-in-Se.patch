+package com.android.settings.fuelgauge.sable;
+
+import android.app.settings.SettingsEnums;
+import android.content.Context;
+import android.os.Bundle;
+import android.view.View;
+
+import com.android.settings.R;
+import com.android.settings.dashboard.DashboardFragment;
+import com.android.settings.search.BaseSearchIndexProvider;
+import com.android.settingslib.search.SearchIndexable;
+
+/**
+ * Settings > Battery > Battery health (BH3, BH4). Each row carries availability, source and
+ * confidence; unavailable facts say so instead of showing a number. Below the facts, a bounded
+ * local history chart with keyboard inspection.
+ */
+@SearchIndexable
+public class SableBatteryHealthFragment extends DashboardFragment {
+    private static final String TAG = "SableBatteryHealth";
+
+    private SableBatteryKeyboardSupport mKeyboard;
+
+    @Override
+    public int getMetricsCategory() {
+        return SettingsEnums.SETTINGS_BATTERY_INFORMATION;
+    }
+
+    @Override
+    protected String getLogTag() {
+        return TAG;
+    }
+
+    @Override
+    protected int getPreferenceScreenResId() {
+        return R.xml.sable_battery_health;
+    }
+
+    @Override
+    public void onResume() {
+        SableBatteryState.invalidate();
+        // The user is looking at battery state anyway: take a history sample if one is due
+        // (at most one per 30 minutes; no background work).
+        SableBatteryHistoryStore.sampleIfDue(getContext());
+        super.onResume();
+        final SableBatteryHistoryPreference history = findPreference(
+                SableBatteryHistoryPreference.KEY);
+        if (history != null) {
+            history.reload();
+        }
+    }
+
+    @Override
+    public void onViewCreated(View view, Bundle savedInstanceState) {
+        super.onViewCreated(view, savedInstanceState);
+        mKeyboard = SableBatteryKeyboardSupport.attach(this, getListView(), getMetricsCategory());
+    }
+
+    @Override
+    public void onDestroyView() {
+        if (mKeyboard != null) {
+            mKeyboard.detach();
+            mKeyboard = null;
+        }
+        super.onDestroyView();
+    }
+
+    public static final BaseSearchIndexProvider SEARCH_INDEX_DATA_PROVIDER =
+            new BaseSearchIndexProvider(R.xml.sable_battery_health) {
+                @Override
+                protected boolean isPageSearchEnabled(Context context) {
+                    return SableChargingGate.isSableBatteryEnabled(context);
+                }
+            };
+}
