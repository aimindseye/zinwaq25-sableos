+
+package com.android.settings.fuelgauge.sable;
+
+import android.content.Context;
+import android.icu.text.DateFormat;
+import android.icu.text.MeasureFormat;
+import android.icu.util.Calendar;
+import android.icu.util.Measure;
+import android.icu.util.MeasureUnit;
+import android.text.format.DateUtils;
+
+import com.android.settings.R;
+import com.android.settings.fuelgauge.sable.model.ChargingControlPolicy;
+import com.android.settings.fuelgauge.sable.model.ChargingDiscovery;
+import com.android.settings.fuelgauge.sable.model.FactConfidence;
+import com.android.settings.fuelgauge.sable.model.FactSource;
+import com.android.settings.fuelgauge.sable.model.FactText;
+import com.android.settings.fuelgauge.sable.model.TemperatureClass;
+import com.android.settingslib.Utils;
+
+import java.text.NumberFormat;
+import java.util.Locale;
+import java.util.TimeZone;
+
+/** Localized rendering of the model's locale-free text descriptions. */
+public final class SableBatteryText {
+    private SableBatteryText() {}
+
+    private static Locale locale(Context c) {
+        return c.getResources().getConfiguration().getLocales().get(0);
+    }
+
+    /** The value line for a fact row. */
+    public static CharSequence value(Context c, FactText t) {
+        switch (t.template) {
+            case CAPACITY_MAH:
+                return c.getString(R.string.sable_battery_value_mah,
+                        NumberFormat.getIntegerInstance(locale(c)).format(t.args[0]));
+            case CAPACITY_PERCENT:
+                return c.getString(R.string.sable_battery_value_percent_of_design,
+                        Utils.formatPercentage((int) t.args[0]));
+            case CYCLES:
+                return c.getResources().getQuantityString(R.plurals.sable_battery_value_cycles,
+                        (int) Math.min(Integer.MAX_VALUE, t.args[0]), (int) t.args[0]);
+            case TEMPERATURE:
+                return c.getString(R.string.sable_battery_value_temperature,
+                        temperature(c, t.args[0]),
+                        temperatureClass(c, TemperatureClass.values()[(int) t.args[1]]));
+            case HEALTH_STATUS:
+                return condition(c, (int) t.args[0]);
+            case MONTH_YEAR:
+                return monthYear(c, (int) t.args[0], (int) t.args[1]);
+            case MONTH_YEAR_WITH_AGE:
+                return c.getString(R.string.sable_battery_value_month_year_age,
+                        monthYear(c, (int) t.args[0], (int) t.args[1]),
+                        age(c, (int) t.args[2], (int) t.args[3]));
+            case NOT_SUPPORTED:
+                return c.getText(R.string.sable_battery_not_supported);
+            case NOT_QUALIFIED:
+                return c.getText(R.string.sable_battery_not_qualified);
+            case IMPLAUSIBLE:
+                return c.getText(R.string.sable_battery_implausible);
+            case NOT_REPORTED:
+            default:
+                return c.getText(R.string.sable_battery_not_reported);
+        }
+    }
+
+    /** "Source: ... · ..." line, or null for unavailable facts. */
+    public static CharSequence sourceLine(Context c, FactText t) {
+        if (!t.showsValue()) {
+            return null;
+        }
+        return c.getString(R.string.sable_battery_source_line, source(c, t.source),
+                confidence(c, t.confidence));
+    }
+
+    /** Value plus source line, for a two-line preference summary. */
+    public static CharSequence summary(Context c, FactText t) {
+        final CharSequence source = sourceLine(c, t);
+        return source == null ? value(c, t) : value(c, t) + "\n" + source;
+    }
+
+    static String source(Context c, FactSource s) {
+        switch (s) {
+            case HEALTH_HAL:
+                return c.getString(R.string.sable_battery_source_health_hal);
+            case VENDOR_SUPPORTED_INTERFACE:
+                return c.getString(R.string.sable_battery_source_vendor);
+            case DERIVED_LOCAL_ESTIMATE:
+                return c.getString(R.string.sable_battery_source_local);
+            case ANDROID_FRAMEWORK:
+            default:
+                return c.getString(R.string.sable_battery_source_android);
+        }
+    }
+
+    static String confidence(Context c, FactConfidence f) {
+        switch (f) {
+            case MEASURED:
+                return c.getString(R.string.sable_battery_confidence_measured);
+            case DERIVED_HIGH_CONFIDENCE:
+                return c.getString(R.string.sable_battery_confidence_derived_high);
+            case DERIVED_LOW_CONFIDENCE:
+                return c.getString(R.string.sable_battery_confidence_derived_low);
+            case PLATFORM_REPORTED:
+            default:
+                return c.getString(R.string.sable_battery_confidence_platform);
+        }
+    }
+
+    /** Tenths of a degree Celsius as a localized temperature. */
+    public static String temperature(Context c, long deciC) {
+        return MeasureFormat.getInstance(locale(c), MeasureFormat.FormatWidth.SHORT)
+                .format(new Measure(deciC / 10f, MeasureUnit.CELSIUS));
+    }
+
+    static String temperatureClass(Context c, TemperatureClass t) {
+        switch (t) {
+            case HOT:
+                return c.getString(R.string.sable_battery_temperature_hot);
+            case WARM:
+                return c.getString(R.string.sable_battery_temperature_warm);
+            case NORMAL:
+            default:
+                return c.getString(R.string.sable_battery_temperature_normal);
+        }
+    }
+
+    static String condition(Context c, int health) {
+        switch (health) {
+            case android.os.BatteryManager.BATTERY_HEALTH_GOOD:
+                return c.getString(R.string.sable_battery_condition_good);
+            case android.os.BatteryManager.BATTERY_HEALTH_OVERHEAT:
+                return c.getString(R.string.sable_battery_condition_overheat);
+            case android.os.BatteryManager.BATTERY_HEALTH_DEAD:
+                return c.getString(R.string.sable_battery_condition_dead);
+            case android.os.BatteryManager.BATTERY_HEALTH_OVER_VOLTAGE:
+                return c.getString(R.string.sable_battery_condition_over_voltage);
+            case android.os.BatteryManager.BATTERY_HEALTH_COLD:
+                return c.getString(R.string.sable_battery_condition_cold);
+            case android.os.BatteryManager.BATTERY_HEALTH_UNSPECIFIED_FAILURE:
+            default:
+                return c.getString(R.string.sable_battery_condition_failure);
+        }
+    }
+
+    static String monthYear(Context c, int year, int month) {
+        final Calendar cal = Calendar.getInstance(android.icu.util.TimeZone.getDefault(),
+                locale(c));
+        cal.clear();
+        cal.set(year, month - 1, 1);
+        return DateFormat.getInstanceForSkeleton("yMMMM", locale(c)).format(cal.getTime());
+    }
+
+    static String age(Context c, int years, int months) {
+        if (years <= 0 && months <= 0) {
+            return c.getString(R.string.sable_battery_age_under_a_month);
+        }
+        final String y = years > 0
+                ? c.getResources().getQuantityString(R.plurals.sable_battery_age_years, years,
+                        years) : null;
+        final String m = months > 0
+                ? c.getResources().getQuantityString(R.plurals.sable_battery_age_months, months,
+                        months) : null;
+        if (y == null) {
+            return m;
+        }
+        return m == null ? y : y + " " + m;
+    }
+
+    /** Text for a charging/protection row. */
+    public static CharSequence controlSummary(Context c, ChargingControlPolicy.State state,
+            ChargingDiscovery d, boolean policyRow) {
+        switch (state) {
+            case UNAVAILABLE_ON_DEVICE:
+                return c.getText(R.string.sable_battery_control_unavailable);
+            case NOT_AVAILABLE_YET:
+                return c.getText(R.string.sable_battery_control_not_yet);
+            case BACKEND_NOT_QUALIFIED:
+                return c.getText(R.string.sable_battery_control_not_qualified);
+            case READ_ONLY_STATUS:
+                if (policyRow) {
+                    return c.getString(R.string.sable_battery_charging_policy_status,
+                            chargingPolicy(c, d.chargingPolicy));
+                }
+                return d.shutdownTemperatureDeciC > 0
+                        ? c.getString(R.string.sable_battery_thermal_status_shutdown,
+                                temperature(c, d.shutdownTemperatureDeciC))
+                        : c.getText(R.string.sable_battery_thermal_status);
+            default:
+                return null;
+        }
+    }
+
+    static String chargingPolicy(Context c, long policy) {
+        if (policy == ChargingDiscovery.CHARGING_POLICY_ADAPTIVE_AON) {
+            return c.getString(R.string.sable_battery_charging_policy_adaptive_aon);
+        } else if (policy == ChargingDiscovery.CHARGING_POLICY_ADAPTIVE_AC) {
+            return c.getString(R.string.sable_battery_charging_policy_adaptive_ac);
+        } else if (policy == ChargingDiscovery.CHARGING_POLICY_ADAPTIVE_LONGLIFE) {
+            return c.getString(R.string.sable_battery_charging_policy_adaptive_longlife);
+        }
+        return c.getString(R.string.sable_battery_charging_policy_default);
+    }
+
+    /** "Since <date/time>" start of an accounting window. */
+    public static String windowStart(Context c, long startMillis) {
+        return DateUtils.formatDateTime(c, startMillis,
+                DateUtils.FORMAT_SHOW_TIME | DateUtils.FORMAT_SHOW_DATE
+                        | DateUtils.FORMAT_ABBREV_MONTH | DateUtils.FORMAT_NO_YEAR);
+    }
+
+    /** A bucket time span such as "13:00–14:00" or "Sep 20, 00:00–12:00". */
+    public static String span(Context c, long startMillis, long endMillis) {
+        return DateUtils.formatDateRange(c, startMillis, endMillis,
+                DateUtils.FORMAT_SHOW_TIME | DateUtils.FORMAT_ABBREV_MONTH
+                        | DateUtils.FORMAT_NO_YEAR);
+    }
+
+    static TimeZone zone() {
+        return TimeZone.getDefault();
+    }
+}
