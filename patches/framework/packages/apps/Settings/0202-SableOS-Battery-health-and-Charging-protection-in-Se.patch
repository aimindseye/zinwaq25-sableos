+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.settings.fuelgauge.sable;
+
+import android.content.Context;
+import android.content.Intent;
+import android.os.SystemClock;
+import android.text.TextUtils;
+import android.view.KeyEvent;
+import android.view.View;
+
+import androidx.fragment.app.Fragment;
+import androidx.preference.Preference;
+import androidx.preference.PreferenceGroupAdapter;
+import androidx.recyclerview.widget.LinearLayoutManager;
+import androidx.recyclerview.widget.RecyclerView;
+
+import com.android.settings.R;
+import com.android.settings.fuelgauge.sable.model.ListFocusNavigator;
+import com.android.settings.fuelgauge.sable.model.NavKey;
+import com.android.settings.fuelgauge.sable.model.TypeAheadMatcher;
+import com.android.settings.overlay.FeatureFactory;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Keyboard-first behaviour for the Battery screens (BATTERY_HEALTH_USAGE_UX section 9), on top
+ * of the platform's Up/Down focus search and Enter activation:
+ *
+ * <ul>
+ *   <li>type-ahead focus navigation over row titles and aliases (no text field on these
+ *       screens, so every unhandled printable key is type-ahead);
+ *   <li>MoveHome / MoveEnd / PageUp / PageDown to the first / last / next-page row;
+ *   <li>{@code /}, the Search key or Ctrl+K open Settings search;
+ *   <li>a high-contrast focus ring.
+ * </ul>
+ *
+ * Only keys no view handled reach this code (View#addOnUnhandledKeyEventListener), so focused
+ * widgets such as the chart keep their own keys and nothing here can trap focus.
+ */
+public final class SableBatteryKeyboardSupport implements View.OnUnhandledKeyEventListener {
+    private final Fragment mFragment;
+    private final RecyclerView mList;
+    private final int mPageId;
+    private final TypeAheadMatcher mTypeAhead = new TypeAheadMatcher();
+    private final SableFocusDecoration mDecoration;
+    private final Map<String, List<String>> mAliases;
+
+    private SableBatteryKeyboardSupport(Fragment fragment, RecyclerView list, int pageId) {
+        mFragment = fragment;
+        mList = list;
+        mPageId = pageId;
+        mDecoration = new SableFocusDecoration(fragment.requireContext(), list);
+        mAliases = loadAliases(fragment.requireContext());
+    }
+
+    /** Installs keyboard support on a preference list; returns null when there is no list. */
+    public static SableBatteryKeyboardSupport attach(Fragment fragment, RecyclerView list,
+            int pageId) {
+        if (list == null || !SableChargingGate.isSableBatteryEnabled(fragment.requireContext())) {
+            return null;
+        }
+        final SableBatteryKeyboardSupport s =
+                new SableBatteryKeyboardSupport(fragment, list, pageId);
+        list.addOnUnhandledKeyEventListener(s);
+        s.mDecoration.install();
+        return s;
+    }
+
+    public void detach() {
+        mList.removeOnUnhandledKeyEventListener(this);
+        mDecoration.uninstall();
+        mTypeAhead.reset();
+    }
+
+    static Map<String, List<String>> loadAliases(Context context) {
+        final String[] raw =
+                context.getResources().getStringArray(R.array.sable_battery_type_ahead_aliases);
+        final Map<String, List<String>> map = new HashMap<>();
+        for (int i = 0; i + 1 < raw.length; i += 2) {
+            final List<String> aliases = new ArrayList<>();
+            for (String a : raw[i + 1].split(",")) {
+                if (!a.trim().isEmpty()) {
+                    aliases.add(a.trim());
+                }
+            }
+            map.put(raw[i], aliases);
+        }
+        return map;
+    }
+
+    @Override
+    public boolean onUnhandledKeyEvent(View v, KeyEvent event) {
+        if (event.getAction() != KeyEvent.ACTION_DOWN) {
+            return false;
+        }
+        final int code = event.getKeyCode();
+        if (code == KeyEvent.KEYCODE_SEARCH
+                || (code == KeyEvent.KEYCODE_SLASH && !event.isShiftPressed())
+                || (code == KeyEvent.KEYCODE_K
+                        && (event.isCtrlPressed() || event.isMetaPressed()))) {
+            return openSearch();
+        }
+        final NavKey nav = SableBatteryKeys.toNavKey(code);
+        if (nav == NavKey.MOVE_HOME || nav == NavKey.MOVE_END || nav == NavKey.PAGE_UP
+                || nav == NavKey.PAGE_DOWN) {
+            final int target = ListFocusNavigator.target(nav, focusableMask(), currentIndex(),
+                    pageSize());
+            return target >= 0 && focusPosition(target);
+        }
+        if (event.isCtrlPressed() || event.isAltPressed() || event.isMetaPressed()) {
+            return false;
+        }
+        final int unicode = event.getUnicodeChar();
+        if (unicode <= 0 || Character.isISOControl(unicode)) {
+            return false;
+        }
+        final List<TypeAheadMatcher.Row> rows = new ArrayList<>();
+        final List<Integer> positions = new ArrayList<>();
+        collectRows(rows, positions);
+        final int current = positions.indexOf(currentIndex());
+        final int match = mTypeAhead.onChar((char) unicode, SystemClock.uptimeMillis(), rows,
+                current);
+        if (match < 0) {
+            return false; // no match: focus stays where it is
+        }
+        return focusPosition(positions.get(match));
+    }
+
+    private boolean openSearch() {
+        final Context c = mFragment.getContext();
+        if (c == null) {
+            return false;
+        }
+        final Intent i = FeatureFactory.getFeatureFactory().getSearchFeatureProvider()
+                .buildSearchIntent(c, mPageId);
+        if (i == null) {
+            return false;
+        }
+        mFragment.startActivity(i);
+        return true;
+    }
+
+    private PreferenceGroupAdapter adapter() {
+        final RecyclerView.Adapter<?> a = mList.getAdapter();
+        return a instanceof PreferenceGroupAdapter ? (PreferenceGroupAdapter) a : null;
+    }
+
+    private static boolean isFocusTarget(Preference p) {
+        return p != null && p.isVisible()
+                && (p.isSelectable() || p instanceof SableBatteryHistoryPreference);
+    }
+
+    private boolean[] focusableMask() {
+        final PreferenceGroupAdapter a = adapter();
+        if (a == null) {
+            return new boolean[0];
+        }
+        final boolean[] mask = new boolean[a.getItemCount()];
+        for (int i = 0; i < mask.length; i++) {
+            mask[i] = isFocusTarget(a.getItem(i));
+        }
+        return mask;
+    }
+
+    private void collectRows(List<TypeAheadMatcher.Row> rows, List<Integer> positions) {
+        final PreferenceGroupAdapter a = adapter();
+        if (a == null) {
+            return;
+        }
+        for (int i = 0; i < a.getItemCount(); i++) {
+            final Preference p = a.getItem(i);
+            if (!isFocusTarget(p) || TextUtils.isEmpty(p.getTitle())) {
+                continue;
+            }
+            final List<String> aliases = p.getKey() == null ? null : mAliases.get(p.getKey());
+            rows.add(new TypeAheadMatcher.Row(p.getTitle().toString(),
+                    aliases != null ? aliases : Collections.emptyList()));
+            positions.add(i);
+        }
+    }
+
+    private int currentIndex() {
+        final View focused = mList.getFocusedChild();
+        return focused == null ? -1 : mList.getChildAdapterPosition(focused);
+    }
+
+    private int pageSize() {
+        final View first = mList.getChildCount() > 0 ? mList.getChildAt(0) : null;
+        if (first == null || first.getHeight() == 0) {
+            return 5;
+        }
+        return Math.max(1, mList.getHeight() / first.getHeight() - 1);
+    }
+
+    /** Scrolls to and focuses an adapter position (after layout when it is off screen). */
+    private boolean focusPosition(int position) {
+        final RecyclerView.ViewHolder vh = mList.findViewHolderForAdapterPosition(position);
+        if (vh != null && vh.itemView.requestFocus()) {
+            mList.smoothScrollToPosition(position);
+            return true;
+        }
+        if (mList.getLayoutManager() instanceof LinearLayoutManager) {
+            ((LinearLayoutManager) mList.getLayoutManager())
+                    .scrollToPositionWithOffset(position, 0);
+        } else {
+            mList.scrollToPosition(position);
+        }
+        mList.post(() -> {
+            final RecyclerView.ViewHolder later = mList.findViewHolderForAdapterPosition(position);
+            if (later != null) {
+                later.itemView.requestFocus();
+            }
+        });
+        return true;
+    }
+}
