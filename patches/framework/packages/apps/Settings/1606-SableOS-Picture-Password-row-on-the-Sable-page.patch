From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SableOS <noreply@sableos.invalid>
Date: Thu, 5 Nov 2026 19:30:00 +0000
Subject: [PATCH] SableOS: Picture Password row on the Sable page

Settings > Sable gains a Picture Password row after Lock screen, which
opens SystemUI's Picture Password setup
(org.sableos.keyguard.action.PICTURE_PASSWORD, frameworks/base 0320) to
set it up, change it or turn it off.
---
 res/values/strings_sable_settings.xml |  4 ++++
 res/xml/sable_settings.xml            | 11 +++++++++++
 2 files changed, 15 insertions(+)

diff --git a/res/values/strings_sable_settings.xml b/res/values/strings_sable_settings.xml
index d253d9d..e5b2c8f 100644
--- a/res/values/strings_sable_settings.xml
+++ b/res/values/strings_sable_settings.xml
@@ -38,6 +38,10 @@
     <string name="sable_page_attention_summary">Priority people and how alerts reach you</string>
     <string name="sable_page_lock_title">Lock screen</string>
     <string name="sable_page_lock_summary">Peek, notifications, PIN pad</string>
+    <!-- Sable settings page: Picture Password, a quicker second unlock over a photo. [CHAR LIMIT=40] -->
+    <string name="sable_page_picture_password_title">Picture Password</string>
+    <!-- [CHAR LIMIT=NONE] -->
+    <string name="sable_page_picture_password_summary">Unlock by moving a number onto a spot in your photo. Your PIN is still needed after a restart.</string>
     <string name="sable_page_keyboard_title">Keyboard</string>
     <string name="sable_page_keyboard_summary">Sable Keyboard, shortcuts, backlight, typing test</string>
     <string name="sable_page_diagnostics_title">Diagnostics</string>
diff --git a/res/xml/sable_settings.xml b/res/xml/sable_settings.xml
index fc6f185..973bfe8 100644
--- a/res/xml/sable_settings.xml
+++ b/res/xml/sable_settings.xml
@@ -75,6 +75,17 @@
         android:summary="@string/sable_page_lock_summary"
         android:fragment="com.android.settings.security.LockscreenDashboardFragment" />
 
+    <!-- Sable Picture Password: set up, change or remove it (SystemUI, frameworks/base 0320). -->
+    <Preference
+        android:key="sable_picture_password"
+        android:icon="@drawable/ic_settings_security_filled"
+        android:title="@string/sable_page_picture_password_title"
+        android:summary="@string/sable_page_picture_password_summary">
+        <intent
+            android:action="org.sableos.keyguard.action.PICTURE_PASSWORD"
+            android:targetPackage="com.android.systemui" />
+    </Preference>
+
     <Preference
         android:key="sable_page_keyboard"
         android:icon="@drawable/ic_settings_keyboards"
-- 
2.43.0

