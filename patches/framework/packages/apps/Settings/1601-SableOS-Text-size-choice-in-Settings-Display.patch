 res/xml/display_settings.xml                  | 10 ++
 .../android/settings/sable/SableTextSize.java | 56 +++++++++++
 .../SableTextSizePreferenceController.java    | 93 +++++++++++++++++++
 4 files changed, 183 insertions(+)

