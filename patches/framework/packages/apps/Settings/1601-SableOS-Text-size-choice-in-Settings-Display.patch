+package com.android.settings.sable;
+
+import android.content.Context;
+import android.provider.Settings;
+import android.util.Log;
+
+import androidx.preference.ListPreference;
+import androidx.preference.Preference;
+
+import com.android.settings.R;
+import com.android.settings.core.BasePreferenceController;
+
+import java.util.Locale;
+
+/**
+ * Settings > Display > Text size: Small, Medium, Large or Larger, written to
+ * Settings.System.FONT_SCALE. The list values are choice indexes into {@link SableTextSize}. A
+ * scale set with Android's own Font size slider selects nothing and is named as custom.
+ */
+public class SableTextSizePreferenceController extends BasePreferenceController
+        implements Preference.OnPreferenceChangeListener {
+    private static final String TAG = "SableTextSizePref";
+
+    public SableTextSizePreferenceController(Context context, String preferenceKey) {
+        super(context, preferenceKey);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return AVAILABLE;
+    }
+
+    @Override
+    public void updateState(Preference preference) {
+        super.updateState(preference);
+        if (!(preference instanceof ListPreference)) {
+            return;
+        }
+        ListPreference list = (ListPreference) preference;
+        float scale = Settings.System.getFloat(
+                mContext.getContentResolver(), Settings.System.FONT_SCALE, 1f);
+        int index = SableTextSize.indexOf(scale);
+        if (index >= 0) {
+            list.setValue(String.valueOf(index));
+            list.setSummary(list.getEntry());
+        } else {
+            list.setValue(null);
+            list.setSummary(mContext.getString(R.string.sable_text_size_custom,
+                    String.format(Locale.getDefault(), "%.2f", scale)));
+        }
+    }
+
+    @Override
+    public boolean onPreferenceChange(Preference preference, Object newValue) {
+        int index;
+        try {
+            index = Integer.parseInt(String.valueOf(newValue));
+        } catch (NumberFormatException e) {
+            return false;
+        }
+        if (index < 0 || index >= SableTextSize.SCALES.length) {
+            return false;
+        }
+        boolean stored;
+        try {
+            stored = Settings.System.putFloat(mContext.getContentResolver(),
+                    Settings.System.FONT_SCALE, SableTextSize.scaleAt(index));
+        } catch (SecurityException e) {
+            Log.w(TAG, "could not set the text size", e);
+            stored = false;
+        }
+        if (stored && preference instanceof ListPreference) {
+            preference.setSummary(((ListPreference) preference).getEntries()[index]);
+        }
+        return stored;
+    }
+}
