+package com.android.settings.sable;
+
+import android.content.Context;
+import android.os.UserHandle;
+import android.provider.Settings;
+
+import com.android.settings.R;
+import com.android.settings.core.TogglePreferenceController;
+
+/**
+ * Settings > Security > Wipe after 10 failed tries, as on BlackBerry. Off by default. Settings
+ * only stores the choice in Settings.Secure sable_wipe_after_failed_unlocks for the system user;
+ * DevicePolicyManagerService (frameworks/base 0325) counts the failed tries, makes the lock
+ * screen warn before the last ones, and resets the phone on the tenth. Only the phone's owner
+ * (the system user) sees the switch.
+ */
+public class SableUnlockWipePreferenceController extends TogglePreferenceController {
+
+    static final String SETTING = "sable_wipe_after_failed_unlocks";
+
+    public SableUnlockWipePreferenceController(Context context, String preferenceKey) {
+        super(context, preferenceKey);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return UserHandle.myUserId() == UserHandle.USER_SYSTEM ? AVAILABLE : DISABLED_FOR_USER;
+    }
+
+    @Override
+    public boolean isChecked() {
+        return Settings.Secure.getIntForUser(mContext.getContentResolver(), SETTING, 0,
+                UserHandle.USER_SYSTEM) == 1;
+    }
+
+    @Override
+    public boolean setChecked(boolean isChecked) {
+        return Settings.Secure.putIntForUser(mContext.getContentResolver(), SETTING,
+                isChecked ? 1 : 0, UserHandle.USER_SYSTEM);
+    }
+
+    @Override
+    public int getSliceHighlightMenuRes() {
+        return R.string.menu_key_security;
+    }
+}
