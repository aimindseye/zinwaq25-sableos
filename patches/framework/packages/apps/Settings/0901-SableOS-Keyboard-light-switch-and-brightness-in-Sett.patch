+package com.android.settings.sable;
+
+import android.content.Context;
+import android.os.SystemProperties;
+
+import com.android.settings.core.SliderPreferenceController;
+
+/** Keyboard backlight brightness, in SableKeyboardBacklight.STEPS steps. */
+public class SableKeyboardBacklightLevelPreferenceController extends SliderPreferenceController {
+
+    public SableKeyboardBacklightLevelPreferenceController(Context context, String preferenceKey) {
+        super(context, preferenceKey);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return SableKeyboardBacklightCategoryController.isSupported()
+                ? AVAILABLE : UNSUPPORTED_ON_DEVICE;
+    }
+
+    @Override
+    public int getSliderPosition() {
+        return SableKeyboardBacklight.stepForLevel(
+                SystemProperties.get(SableKeyboardBacklight.PROP_LEVEL));
+    }
+
+    @Override
+    public boolean setSliderPosition(int position) {
+        SystemProperties.set(SableKeyboardBacklight.PROP_LEVEL,
+                Integer.toString(SableKeyboardBacklight.levelForStep(position)));
+        return true;
+    }
+
+    @Override
+    public int getMax() {
+        return SableKeyboardBacklight.STEPS;
+    }
+
+    @Override
+    public int getMin() {
+        return 1;
+    }
+}
