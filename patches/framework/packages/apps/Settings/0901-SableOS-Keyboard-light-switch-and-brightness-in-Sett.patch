+package com.android.settings.sable;
+
+import android.content.Context;
+import android.os.SystemProperties;
+
+import com.android.settings.core.BasePreferenceController;
+
+/** Settings > System > Keyboard > Keyboard light: shown only where the device supports it. */
+public class SableKeyboardBacklightCategoryController extends BasePreferenceController {
+
+    public SableKeyboardBacklightCategoryController(Context context, String preferenceKey) {
+        super(context, preferenceKey);
+    }
+
+    static boolean isSupported() {
+        return SystemProperties.getBoolean(SableKeyboardBacklight.PROP_SUPPORTED, false);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return isSupported() ? AVAILABLE : UNSUPPORTED_ON_DEVICE;
+    }
+}
