+package com.android.settings.sable;
+
+import android.content.Context;
+import android.os.SystemProperties;
+
+import com.android.settings.R;
+import com.android.settings.core.TogglePreferenceController;
+
+/** Keyboard backlight on or off while the screen is on. */
+public class SableKeyboardBacklightPreferenceController extends TogglePreferenceController {
+
+    public SableKeyboardBacklightPreferenceController(Context context, String preferenceKey) {
+        super(context, preferenceKey);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return SableKeyboardBacklightCategoryController.isSupported()
+                ? AVAILABLE : UNSUPPORTED_ON_DEVICE;
+    }
+
+    @Override
+    public boolean isChecked() {
+        return SableKeyboardBacklight.isEnabled(
+                SystemProperties.get(SableKeyboardBacklight.PROP_ENABLED));
+    }
+
+    @Override
+    public boolean setChecked(boolean isChecked) {
+        SystemProperties.set(SableKeyboardBacklight.PROP_ENABLED,
+                SableKeyboardBacklight.enabledValue(isChecked));
+        return true;
+    }
+
+    @Override
+    public int getSliceHighlightMenuRes() {
+        return R.string.menu_key_system;
+    }
+}
