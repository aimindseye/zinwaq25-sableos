+package com.android.settings.sable;
+
+/**
+ * Keyboard backlight choice for devices whose keyboard driver takes it from the system (Zinwa
+ * Q25: bbqX0kbd). Settings writes the two persist properties; an init rule in the Sable product
+ * layer copies them to the driver's module parameters, which apply them at once and every time
+ * the screen wakes. Pure Java so it can be tested off-device.
+ */
+public final class SableKeyboardBacklight {
+
+    /** Set to true by the device's product layer when the driver honours the properties. */
+    public static final String PROP_SUPPORTED = "ro.sable.keyboard_backlight";
+    /** "1" lights the keys while the screen is on, "0" keeps them dark. */
+    public static final String PROP_ENABLED = "persist.sys.sable.kbd_backlight";
+    /** Driver brightness, 1-255. */
+    public static final String PROP_LEVEL = "persist.sys.sable.kbd_backlight_level";
+
+    public static final int MAX_LEVEL = 255;
+    /** Slider positions; position STEPS is full brightness, the driver's default. */
+    public static final int STEPS = 10;
+
+    private SableKeyboardBacklight() {
+    }
+
+    /** Missing or unreadable means on, matching the driver's default. */
+    public static boolean isEnabled(String value) {
+        return !"0".equals(value == null ? null : value.trim());
+    }
+
+    public static String enabledValue(boolean enabled) {
+        return enabled ? "1" : "0";
+    }
+
+    /** Driver level for slider position 1..STEPS (out-of-range positions are clamped). */
+    public static int levelForStep(int step) {
+        int s = Math.max(1, Math.min(STEPS, step));
+        return (s * MAX_LEVEL + STEPS / 2) / STEPS;
+    }
+
+    /** Slider position for a stored level; missing or invalid values read as full brightness. */
+    public static int stepForLevel(String value) {
+        int level;
+        try {
+            level = Integer.parseInt(value == null ? "" : value.trim());
+        } catch (NumberFormatException e) {
+            return STEPS;
+        }
+        if (level < 1 || level > MAX_LEVEL) {
+            return STEPS;
+        }
+        int step = (level * STEPS + MAX_LEVEL / 2) / MAX_LEVEL;
+        return Math.max(1, Math.min(STEPS, step));
+    }
+}
