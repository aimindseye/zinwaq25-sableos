+package com.android.settings.applications.sable;
+
+import static com.android.settings.Utils.PROPERTY_CLONED_APPS_ENABLED;
+
+import android.app.settings.SettingsEnums;
+import android.content.ActivityNotFoundException;
+import android.content.Context;
+import android.content.Intent;
+import android.content.pm.PackageInfo;
+import android.os.Bundle;
+import android.os.UserHandle;
+import android.os.UserManager;
+import android.provider.DeviceConfig;
+import android.util.Log;
+import android.view.View;
+
+import androidx.preference.Preference;
+
+import com.android.settings.R;
+import com.android.settings.SettingsPreferenceFragment;
+import com.android.settings.Utils;
+import com.android.settings.applications.sable.model.ProfileSpaces;
+import com.android.settings.privatespace.PrivateSpaceAuthenticationActivity;
+import com.android.settings.privatespace.PrivateSpaceMaintainer;
+import com.android.settings.search.BaseSearchIndexProvider;
+import com.android.settingslib.search.SearchIndexable;
+import com.android.settingslib.utils.ThreadUtils;
+
+import java.util.Arrays;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+
+/**
+ * Private Space &amp; Dual Apps (Mobile Manager &gt; Private Space &amp; Dual Apps). Shows the
+ * state of Android's private, clone and work profiles and opens Android's own pages for them:
+ * Private Space through its authentication step (setup or settings), Dual Apps through the
+ * cloned-apps list, the work profile through its settings. Rows the build cannot support stay
+ * visible and say why. Locking and unlocking Private Space lives in Sable Start's All apps.
+ */
+@SearchIndexable
+public class SablePrivateSpaceFragment extends SettingsPreferenceFragment {
+    private static final String TAG = "SablePrivateSpace";
+    private static final String KEY_PRIVATE = "sable_spaces_private";
+    private static final String KEY_DUAL = "sable_spaces_dual";
+    private static final String KEY_WORK = "sable_spaces_work";
+
+    private SableAppListKeyboard mKeyboard;
+    private int mLoadGeneration;
+    private Loaded mLoaded;
+
+    /** Profile states read off the main thread. */
+    static final class Loaded {
+        final ProfileSpaces.PrivateSpace privateSpace;
+        final ProfileSpaces.DualApps dualApps;
+        final int cloned;
+        final int cloneable;
+        final ProfileSpaces.WorkProfile work;
+
+        Loaded(ProfileSpaces.PrivateSpace privateSpace, ProfileSpaces.DualApps dualApps,
+                int cloned, int cloneable, ProfileSpaces.WorkProfile work) {
+            this.privateSpace = privateSpace;
+            this.dualApps = dualApps;
+            this.cloned = cloned;
+            this.cloneable = cloneable;
+            this.work = work;
+        }
+    }
+
+    @Override
+    public int getMetricsCategory() {
+        return SettingsEnums.PRIVATE_SPACE_SETTINGS;
+    }
+
+    @Override
+    public void onCreate(Bundle icicle) {
+        super.onCreate(icicle);
+        addPreferencesFromResource(R.xml.sable_private_space);
+    }
+
+    @Override
+    public void onViewCreated(View view, Bundle savedInstanceState) {
+        super.onViewCreated(view, savedInstanceState);
+        mKeyboard = SableAppListKeyboard.attach(this, getListView(), getMetricsCategory());
+    }
+
+    @Override
+    public void onDestroyView() {
+        if (mKeyboard != null) {
+            mKeyboard.detach();
+            mKeyboard = null;
+        }
+        super.onDestroyView();
+    }
+
+    @Override
+    public void onResume() {
+        super.onResume();
+        final Context context = getPrefContext().getApplicationContext();
+        final int generation = ++mLoadGeneration;
+        ThreadUtils.postOnBackgroundThread(() -> {
+            final Loaded loaded = load(context);
+            ThreadUtils.postOnMainThread(() -> {
+                if (generation == mLoadGeneration && isAdded()) {
+                    show(loaded);
+                }
+            });
+        });
+    }
+
+    /** Whether the platform's cloned-apps page is on in this build. */
+    static boolean clonePageEnabled(Context context) {
+        return DeviceConfig.getBoolean(DeviceConfig.NAMESPACE_APP_CLONING,
+                PROPERTY_CLONED_APPS_ENABLED, true)
+                && context.getResources().getBoolean(R.bool.config_cloned_apps_page_enabled);
+    }
+
+    static Loaded load(Context context) {
+        ProfileSpaces.PrivateSpace ps = ProfileSpaces.PrivateSpace.UNAVAILABLE;
+        try {
+            final PrivateSpaceMaintainer maintainer = PrivateSpaceMaintainer.getInstance(context);
+            final boolean exists = maintainer.doesPrivateSpaceExist();
+            ps = ProfileSpaces.privateSpace(maintainer.isPrivateSpaceEntryPointEnabled(), exists,
+                    exists && maintainer.isPrivateSpaceLocked());
+        } catch (RuntimeException e) {
+            Log.w(TAG, "Cannot read Private Space state", e);
+        }
+
+        int cloned = 0;
+        int cloneable = 0;
+        final boolean pageEnabled = clonePageEnabled(context);
+        if (pageEnabled) {
+            try {
+                final List<String> allowed = Arrays.asList(context.getResources()
+                        .getStringArray(com.android.internal.R.array.cloneable_apps));
+                final Set<String> installed = packagesOf(context, UserHandle.myUserId());
+                final int cloneUser = Utils.getCloneUserId(context);
+                final Set<String> inClone = cloneUser == -1 ? new HashSet<>()
+                        : packagesOf(context, cloneUser);
+                for (String pkg : allowed) {
+                    if (inClone.contains(pkg)) {
+                        cloned++;
+                    } else if (installed.contains(pkg)) {
+                        cloneable++;
+                    }
+                }
+            } catch (RuntimeException e) {
+                Log.w(TAG, "Cannot read Dual Apps state", e);
+            }
+        }
+
+        final UserManager um = context.getSystemService(UserManager.class);
+        UserHandle work = null;
+        boolean paused = false;
+        try {
+            work = Utils.getManagedProfile(um);
+            paused = work != null && um.isQuietModeEnabled(work);
+        } catch (RuntimeException e) {
+            Log.w(TAG, "Cannot read work profile state", e);
+        }
+        return new Loaded(ps, ProfileSpaces.dualApps(pageEnabled, cloneable, cloned), cloned,
+                cloneable, ProfileSpaces.workProfile(work != null, paused));
+    }
+
+    private static Set<String> packagesOf(Context context, int userId) {
+        final Set<String> out = new HashSet<>();
+        for (PackageInfo pi : context.getPackageManager().getInstalledPackagesAsUser(0, userId)) {
+            out.add(pi.packageName);
+        }
+        return out;
+    }
+
+    private void show(Loaded loaded) {
+        mLoaded = loaded;
+        final Preference ps = findPreference(KEY_PRIVATE);
+        if (ps != null) {
+            ps.setSummary(privateSummary(loaded.privateSpace));
+            ps.setEnabled(ProfileSpaces.opens(loaded.privateSpace));
+        }
+        final Preference dual = findPreference(KEY_DUAL);
+        if (dual != null) {
+            switch (loaded.dualApps) {
+                case AVAILABLE:
+                    dual.setSummary(getString(R.string.sable_spaces_dual_counts, loaded.cloned,
+                            loaded.cloneable));
+                    break;
+                case NO_ELIGIBLE_APPS:
+                    dual.setSummary(R.string.sable_spaces_dual_none);
+                    break;
+                default:
+                    dual.setSummary(R.string.sable_spaces_dual_unavailable);
+                    break;
+            }
+            dual.setEnabled(ProfileSpaces.opens(loaded.dualApps));
+        }
+        final Preference work = findPreference(KEY_WORK);
+        if (work != null) {
+            switch (loaded.work) {
+                case ON:
+                    work.setSummary(R.string.sable_spaces_work_on);
+                    break;
+                case PAUSED:
+                    work.setSummary(R.string.sable_spaces_work_paused);
+                    break;
+                default:
+                    work.setSummary(R.string.sable_spaces_work_none);
+                    break;
+            }
+            work.setEnabled(ProfileSpaces.opens(loaded.work));
+        }
+    }
+
+    /** The Private Space row summary, shared with Mobile Manager. */
+    static int privateSummary(ProfileSpaces.PrivateSpace state) {
+        switch (state) {
+            case NOT_SET_UP:
+                return R.string.sable_spaces_private_not_set_up;
+            case LOCKED:
+                return R.string.sable_spaces_private_locked;
+            case UNLOCKED:
+                return R.string.sable_spaces_private_unlocked;
+            default:
+                return R.string.sable_spaces_private_unavailable;
+        }
+    }
+
+    @Override
+    public boolean onPreferenceTreeClick(Preference preference) {
+        final String key = preference.getKey();
+        final Context context = getPrefContext();
+        Intent intent = null;
+        if (KEY_PRIVATE.equals(key)) {
+            // Android's own entry: asks for the screen lock, then setup or Private Space settings.
+            intent = new Intent(context, PrivateSpaceAuthenticationActivity.class);
+        } else if (KEY_DUAL.equals(key)) {
+            intent = new Intent(context,
+                    com.android.settings.Settings.ClonedAppsListActivity.class);
+        } else if (KEY_WORK.equals(key) && mLoaded != null
+                && ProfileSpaces.opens(mLoaded.work)) {
+            // The page finds the managed profile itself.
+            intent = new Intent(context,
+                    com.android.settings.Settings.ManagedProfileSettingsActivity.class);
+        }
+        if (intent == null) {
+            return super.onPreferenceTreeClick(preference);
+        }
+        try {
+            startActivity(intent);
+        } catch (ActivityNotFoundException | SecurityException e) {
+            Log.w(TAG, "Cannot open " + key, e);
+        }
+        return true;
+    }
+
+    public static final BaseSearchIndexProvider SEARCH_INDEX_DATA_PROVIDER =
+            new BaseSearchIndexProvider(R.xml.sable_private_space);
+}
