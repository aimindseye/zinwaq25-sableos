+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.settings.applications.sable;
+
+import android.app.NotificationManager;
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.text.TextUtils;
+
+import com.android.settings.applications.sable.model.FocusModePolicy;
+import com.android.settingslib.utils.ThreadUtils;
+
+/**
+ * Android tells the owner of a mode when it starts or ends
+ * ({@link NotificationManager#ACTION_AUTOMATIC_ZEN_RULE_STATUS_CHANGED}, sent to Settings'
+ * package only). For Settings' Focus rule this pauses or releases the chosen apps, so Focus
+ * mode started or ended from Quick Settings, a schedule or Settings &gt; Modes behaves the
+ * same as from the Focus mode page.
+ */
+public class SableFocusModeReceiver extends BroadcastReceiver {
+
+    @Override
+    public void onReceive(Context context, Intent intent) {
+        if (intent == null || !NotificationManager.ACTION_AUTOMATIC_ZEN_RULE_STATUS_CHANGED
+                .equals(intent.getAction())) {
+            return;
+        }
+        final String ruleId =
+                intent.getStringExtra(NotificationManager.EXTRA_AUTOMATIC_ZEN_RULE_ID);
+        final int status = intent.getIntExtra(
+                NotificationManager.EXTRA_AUTOMATIC_ZEN_RULE_STATUS,
+                NotificationManager.AUTOMATIC_RULE_STATUS_UNKNOWN);
+        final Context app = context.getApplicationContext();
+        final PendingResult result = goAsync();
+        ThreadUtils.postOnBackgroundThread(() -> {
+            try {
+                final String focusId = SableFocusMode.findRuleId(app);
+                final Boolean active = FocusModePolicy.activeFromStatus(status,
+                        NotificationManager.AUTOMATIC_RULE_STATUS_ACTIVATED,
+                        NotificationManager.AUTOMATIC_RULE_STATUS_DEACTIVATED,
+                        NotificationManager.AUTOMATIC_RULE_STATUS_DISABLED,
+                        NotificationManager.AUTOMATIC_RULE_STATUS_REMOVED);
+                if (focusId != null && TextUtils.equals(focusId, ruleId)) {
+                    SableFocusMode.reconcile(app,
+                            active != null ? active : SableFocusMode.isActive(app));
+                } else if (focusId == null) {
+                    // The Focus rule is gone (deleted in Settings > Modes): release everything.
+                    SableFocusMode.reconcile(app, false);
+                }
+            } finally {
+                result.finish();
+            }
+        });
+    }
+}
