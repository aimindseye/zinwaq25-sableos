+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.settings.applications.sable;
+
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.Intent;
+import android.content.SharedPreferences;
+import android.content.pm.ApplicationInfo;
+import android.content.pm.PackageManager;
+import android.content.pm.ResolveInfo;
+import android.graphics.drawable.Drawable;
+import android.provider.Settings;
+import android.provider.Telephony;
+import android.telecom.TelecomManager;
+import android.text.TextUtils;
+import android.util.IconDrawableFactory;
+import android.util.Log;
+
+import com.android.settings.applications.sable.model.PackageSet;
+
+import java.text.Collator;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.TreeSet;
+
+/**
+ * Shared Android-side helpers for the Mobile Manager pages: the launcher apps of the current
+ * user, the apps that must never be locked or paused, and the small device-protected store
+ * that holds App lock and Focus mode choices (per user; nothing leaves the device).
+ */
+public final class SableAppControls {
+    private static final String TAG = "SableAppControls";
+    private static final String PREFS = "sable_app_controls";
+    static final String KEY_APP_LOCK = "app_lock_packages";
+    static final String KEY_FOCUS_PAUSE = "focus_pause_packages";
+    static final String KEY_FOCUS_HELD = "focus_paused_by_settings";
+    private static final String SYSTEMUI_PACKAGE = "com.android.systemui";
+
+    /** One launcher app of the current user. */
+    static final class LauncherApp {
+        final String packageName;
+        final String label;
+        final int uid;
+        final Drawable icon;
+
+        LauncherApp(String packageName, String label, int uid, Drawable icon) {
+            this.packageName = packageName;
+            this.label = label;
+            this.uid = uid;
+            this.icon = icon;
+        }
+    }
+
+    private SableAppControls() {
+    }
+
+    private static SharedPreferences prefs(Context context) {
+        return context.createDeviceProtectedStorageContext()
+                .getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+    }
+
+    static Set<String> readSet(Context context, String key) {
+        return PackageSet.parse(prefs(context).getString(key, ""));
+    }
+
+    static void writeSet(Context context, String key, Set<String> packages) {
+        // commit(): the Focus receiver may run in a short-lived process.
+        prefs(context).edit().putString(key, PackageSet.format(packages)).commit();
+    }
+
+    /**
+     * Apps the phone needs to stay usable and recoverable: Settings itself, the system UI,
+     * every home app, the default dialer and SMS app, and the current keyboard. They are never
+     * offered for App lock or Focus pausing.
+     */
+    static Set<String> protectedPackages(Context context) {
+        final Set<String> out = new TreeSet<>();
+        out.add(context.getPackageName());
+        out.add(SYSTEMUI_PACKAGE);
+        final PackageManager pm = context.getPackageManager();
+        try {
+            for (ResolveInfo ri : pm.queryIntentActivities(
+                    new Intent(Intent.ACTION_MAIN).addCategory(Intent.CATEGORY_HOME),
+                    PackageManager.ResolveInfoFlags.of(0))) {
+                if (ri.activityInfo != null) {
+                    out.add(ri.activityInfo.packageName);
+                }
+            }
+        } catch (RuntimeException e) {
+            Log.w(TAG, "Cannot list home apps", e);
+        }
+        try {
+            final TelecomManager telecom = context.getSystemService(TelecomManager.class);
+            final String dialer = telecom == null ? null : telecom.getDefaultDialerPackage();
+            if (!TextUtils.isEmpty(dialer)) {
+                out.add(dialer);
+            }
+        } catch (RuntimeException e) {
+            Log.w(TAG, "Cannot read the default dialer", e);
+        }
+        try {
+            final String sms = Telephony.Sms.getDefaultSmsPackage(context);
+            if (!TextUtils.isEmpty(sms)) {
+                out.add(sms);
+            }
+        } catch (RuntimeException e) {
+            Log.w(TAG, "Cannot read the default SMS app", e);
+        }
+        final String ime = Settings.Secure.getString(context.getContentResolver(),
+                Settings.Secure.DEFAULT_INPUT_METHOD);
+        final ComponentName imeComponent =
+                ime == null ? null : ComponentName.unflattenFromString(ime);
+        if (imeComponent != null) {
+            out.add(imeComponent.getPackageName());
+        }
+        return out;
+    }
+
+    /** Launcher apps of the current user, one per package, sorted by label. */
+    static List<LauncherApp> launcherApps(Context context, boolean withIcons) {
+        final PackageManager pm = context.getPackageManager();
+        final List<ResolveInfo> infos;
+        try {
+            infos = pm.queryIntentActivities(
+                    new Intent(Intent.ACTION_MAIN).addCategory(Intent.CATEGORY_LAUNCHER),
+                    PackageManager.ResolveInfoFlags.of(0));
+        } catch (RuntimeException e) {
+            Log.w(TAG, "Cannot list launcher apps", e);
+            return new ArrayList<>();
+        }
+        final IconDrawableFactory icons =
+                withIcons ? IconDrawableFactory.newInstance(context) : null;
+        final Map<String, LauncherApp> byPackage = new HashMap<>();
+        for (ResolveInfo ri : infos) {
+            if (ri.activityInfo == null || ri.activityInfo.applicationInfo == null) {
+                continue;
+            }
+            final ApplicationInfo ai = ri.activityInfo.applicationInfo;
+            if (byPackage.containsKey(ai.packageName)) {
+                continue;
+            }
+            final CharSequence label = ai.loadLabel(pm);
+            byPackage.put(ai.packageName, new LauncherApp(ai.packageName,
+                    label == null ? ai.packageName : label.toString(), ai.uid,
+                    icons == null ? null : icons.getBadgedIcon(ai)));
+        }
+        final List<LauncherApp> out = new ArrayList<>(byPackage.values());
+        final Collator collator = Collator.getInstance();
+        Collections.sort(out, (a, b) -> {
+            final int c = collator.compare(a.label, b.label);
+            return c != 0 ? c : a.packageName.compareTo(b.packageName);
+        });
+        return out;
+    }
+}
diff --git a/src/com/android/settings/applications/sable/SableAppLockFragment.java b/src/com/android/settings/applications/sable/SableAppLockFragment.java
new file mode 100644
index 00000000000..3cd744271a4
--- /dev/null
+++ b/src/com/android/settings/applications/sable/SableAppLockFragment.java
@@ -0,0 +1,196 @@
+/*
+ * Copyright (C) 2026 The SableOS Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.settings.applications.sable;
+
+import android.app.settings.SettingsEnums;
+import android.content.Context;
+import android.content.res.Resources;
+import android.os.Bundle;
+import android.view.View;
+
+import androidx.preference.Preference;
+import androidx.preference.PreferenceCategory;
+import androidx.preference.SwitchPreferenceCompat;
+
+import com.android.settings.R;
+import com.android.settings.SettingsPreferenceFragment;
+import com.android.settings.applications.sable.model.AppLockPolicy;
+import com.android.settings.applications.sable.model.PackageSet;
+import com.android.settingslib.utils.ThreadUtils;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Set;
+import java.util.TreeSet;
+
+/**
+ * App lock (Mobile Manager &gt; App lock, Private Space &amp; Dual Apps &gt; App lock). The
+ * chosen apps are recorded, and the page and its rows say "not enforced" for as long as
+ * {@link AppLockPolicy#PLATFORM_ENFORCEMENT} says so: LineageOS 23.2 has no launch gate, and
+ * Settings does not pretend to be one. The page points to Private Space, which does keep apps
+ * behind the screen lock.
+ */
+public class SableAppLockFragment extends SettingsPreferenceFragment
+        implements Preference.OnPreferenceChangeListener {
+    private static final String KEY_STATUS = "sable_app_lock_status";
+    private static final String KEY_APPS = "sable_app_lock_apps";
+    private static final String PREFIX = "sable_app_lock:";
+
+    private PreferenceCategory mAppsCategory;
+    private Preference mStatus;
+    private SableAppListKeyboard mKeyboard;
+    private Set<String> mChosen = new TreeSet<>();
+    private int mLoadGeneration;
+
+    @Override
+    public int getMetricsCategory() {
+        return SettingsEnums.MANAGE_APPLICATIONS;
+    }
+
+    @Override
+    public void onCreate(Bundle icicle) {
+        super.onCreate(icicle);
+        addPreferencesFromResource(R.xml.sable_app_lock);
+        mAppsCategory = findPreference(KEY_APPS);
+        mStatus = findPreference(KEY_STATUS);
+    }
+
+    @Override
+    public void onViewCreated(View view, Bundle savedInstanceState) {
+        super.onViewCreated(view, savedInstanceState);
+        mKeyboard = SableAppListKeyboard.attach(this, getListView(), getMetricsCategory());
+    }
+
+    @Override
+    public void onDestroyView() {
+        if (mKeyboard != null) {
+            mKeyboard.detach();
+            mKeyboard = null;
+        }
+        super.onDestroyView();
+    }
+
+    @Override
+    public void onResume() {
+        super.onResume();
+        load();
+    }
+
+    /** The App lock row summary, shared with Mobile Manager and Private Space. */
+    static String summary(Resources res, int chosenCount) {
+        switch (AppLockPolicy.status(chosenCount, AppLockPolicy.PLATFORM_ENFORCEMENT)) {
+            case LOCKED:
+                return res.getQuantityString(R.plurals.sable_app_lock_locked, chosenCount,
+                        chosenCount);
+            case CHOSEN_NOT_ENFORCED:
+                return res.getQuantityString(R.plurals.sable_app_lock_not_enforced,
+                        chosenCount, chosenCount);
+            default:
+                return res.getString(R.string.sable_app_lock_none);
+        }
+    }
+
+    /** Chosen apps that are still eligible launcher apps (uninstalled ones drop out). */
+    static int chosenCount(Context context) {
+        final Set<String> protectedPkgs = SableAppControls.protectedPackages(context);
+        final List<String> eligible = new ArrayList<>();
+        for (SableAppControls.LauncherApp app : SableAppControls.launcherApps(context, false)) {
+            if (AppLockPolicy.isEligible(app.packageName, true, protectedPkgs)) {
+                eligible.add(app.packageName);
+            }
+        }
+        return PackageSet.retain(SableAppControls.readSet(context,
+                SableAppControls.KEY_APP_LOCK), eligible).size();
+    }
+
+    private void load() {
+        final Context context = getPrefContext().getApplicationContext();
+        final int generation = ++mLoadGeneration;
+        ThreadUtils.postOnBackgroundThread(() -> {
+            final Set<String> protectedPkgs = SableAppControls.protectedPackages(context);
+            final List<SableAppControls.LauncherApp> apps = new ArrayList<>();
+            for (SableAppControls.LauncherApp app
+                    : SableAppControls.launcherApps(context, true)) {
+                if (AppLockPolicy.isEligible(app.packageName, true, protectedPkgs)) {
+                    apps.add(app);
+                }
+            }
+            final Set<String> chosen = SableAppControls.readSet(context,
+                    SableAppControls.KEY_APP_LOCK);
+            ThreadUtils.postOnMainThread(() -> {
+                if (generation == mLoadGeneration && isAdded()) {
+                    show(apps, chosen);
+                }
+            });
+        });
+    }
+
+    private void show(List<SableAppControls.LauncherApp> apps, Set<String> chosen) {
+        mChosen = chosen;
+        mAppsCategory.removeAll();
+        final List<String> listed = new ArrayList<>();
+        for (SableAppControls.LauncherApp app : apps) {
+            final SwitchPreferenceCompat pref = new SwitchPreferenceCompat(getPrefContext());
+            pref.setKey(PREFIX + app.packageName);
+            pref.setTitle(app.label);
+            if (app.icon != null) {
+                pref.setIcon(app.icon);
+            }
+            pref.setPersistent(false);
+            pref.setChecked(chosen.contains(app.packageName));
+            pref.setOnPreferenceChangeListener(this);
+            mAppsCategory.addPreference(pref);
+            listed.add(app.packageName);
+        }
+        if (apps.isEmpty()) {
+            final Preference empty = new Preference(getPrefContext());
+            empty.setTitle(R.string.sable_app_controls_empty);
+            empty.setSelectable(false);
+            mAppsCategory.addPreference(empty);
+        }
+        updateStatus(PackageSet.retain(chosen, listed).size());
+    }
+
+    private void updateStatus(int count) {
+        mStatus.setSummary(summary(getResources(), count) + "\n\n"
+                + getString(R.string.sable_app_lock_status_explanation));
+    }
+
+    @Override
+    public boolean onPreferenceChange(Preference preference, Object newValue) {
+        final String key = preference.getKey();
+        if (key == null || !key.startsWith(PREFIX) || !(newValue instanceof Boolean)) {
+            return false;
+        }
+        final String pkg = key.substring(PREFIX.length());
+        mChosen = PackageSet.with(mChosen, pkg, (Boolean) newValue);
+        final Set<String> toStore = mChosen;
+        final Context context = getPrefContext().getApplicationContext();
+        ThreadUtils.postOnBackgroundThread(() ->
+                SableAppControls.writeSet(context, SableAppControls.KEY_APP_LOCK, toStore));
+        int listed = 0;
+        for (int i = 0; i < mAppsCategory.getPreferenceCount(); i++) {
+            final Preference p = mAppsCategory.getPreference(i);
+            if (p.getKey() != null && p.getKey().startsWith(PREFIX)
+                    && mChosen.contains(p.getKey().substring(PREFIX.length()))) {
+                listed++;
+            }
+        }
+        updateStatus(listed);
+        return true;
+    }
+}
diff --git a/src/com/android/settings/applications/sable/SableFocusMode.java b/src/com/android/settings/applications/sable/SableFocusMode.java
new file mode 100644
index 00000000000..129ca4ed666
--- /dev/null
+++ b/src/com/android/settings/applications/sable/SableFocusMode.java
@@ -0,0 +1,219 @@
+/*
