+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.settings.applications.sable;
+
+import static android.app.NotificationManager.IMPORTANCE_NONE;
+
+import android.app.NotificationChannel;
+import android.app.NotificationChannelGroup;
+import android.app.settings.SettingsEnums;
+import android.content.ActivityNotFoundException;
+import android.content.Context;
+import android.content.Intent;
+import android.content.pm.PackageInfo;
+import android.content.pm.PackageManager;
+import android.os.Bundle;
+import android.provider.Settings;
+import android.util.Log;
+import android.view.View;
+import android.widget.Toast;
+
+import androidx.preference.Preference;
+import androidx.preference.PreferenceCategory;
+import androidx.preference.SwitchPreferenceCompat;
+
+import com.android.settings.R;
+import com.android.settings.SettingsPreferenceFragment;
+import com.android.settings.applications.sable.model.FocusModePolicy;
+import com.android.settings.applications.sable.model.PackageSet;
+import com.android.settings.notification.NotificationBackend;
+import com.android.settingslib.utils.ThreadUtils;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Set;
+
+/**
+ * Focus mode (Mobile Manager &gt; Focus mode; also org.sableos.settings.FOCUS_MODE and the
+ * configuration page of the "Focus mode" entry in Settings &gt; Modes). One switch starts or
+ * ends the mode; "Apps that can notify you" is Android's per-app can-interrupt choice; "Pause
+ * while Focus mode is on" suspends the chosen apps for as long as the mode is on. See
+ * {@link FocusModePolicy} for what is and is not done.
+ */
+public class SableFocusModeFragment extends SettingsPreferenceFragment
+        implements Preference.OnPreferenceChangeListener {
+    private static final String TAG = "SableFocusMode";
+    private static final String KEY_SWITCH = "sable_focus_switch";
+    private static final String KEY_ALLOWED = "sable_focus_allowed";
+    private static final String KEY_PAUSE = "sable_focus_pause";
+    private static final String KEY_SCHEDULE = "sable_focus_schedule";
+    private static final String PREFIX_ALLOW = "sable_focus_allow:";
+    private static final String PREFIX_PAUSE = "sable_focus_pause:";
+
+    private final NotificationBackend mBackend = new NotificationBackend();
+    private SwitchPreferenceCompat mSwitch;
+    private PreferenceCategory mAllowed;
+    private PreferenceCategory mPause;
+    private SableAppListKeyboard mKeyboard;
+    private final List<AppData> mApps = new ArrayList<>();
+    private int mLoadGeneration;
+
+    /** Everything one load read, off the main thread. */
+    private static final class Loaded {
+        final boolean active;
+        final Set<String> refused;
+        final Set<String> chosen;
+        final Set<String> held;
+        final List<AppData> apps;
+
+        Loaded(boolean active, Set<String> refused, Set<String> chosen, Set<String> held,
+                List<AppData> apps) {
+            this.active = active;
+            this.refused = refused;
+            this.chosen = chosen;
+            this.held = held;
+            this.apps = apps;
+        }
+    }
+
+    /** One launcher app with its notification channels and pause eligibility. */
+    private static final class AppData {
+        final SableAppControls.LauncherApp app;
+        final List<NotificationChannel> channels;
+        final List<FocusModePolicy.Channel> facts;
+        final boolean canPause;
+
+        AppData(SableAppControls.LauncherApp app, List<NotificationChannel> channels,
+                List<FocusModePolicy.Channel> facts, boolean canPause) {
+            this.app = app;
+            this.channels = channels;
+            this.facts = facts;
+            this.canPause = canPause;
+        }
+    }
+
+    @Override
+    public int getMetricsCategory() {
+        return SettingsEnums.NOTIFICATION_ZEN_MODE_AUTOMATION;
+    }
+
+    @Override
+    public void onCreate(Bundle icicle) {
+        super.onCreate(icicle);
+        addPreferencesFromResource(R.xml.sable_focus_mode);
+        mSwitch = findPreference(KEY_SWITCH);
+        mSwitch.setPersistent(false);
+        mSwitch.setOnPreferenceChangeListener(this);
+        mAllowed = findPreference(KEY_ALLOWED);
+        mPause = findPreference(KEY_PAUSE);
+    }
+
+    @Override
+    public void onViewCreated(View view, Bundle savedInstanceState) {
+        super.onViewCreated(view, savedInstanceState);
+        mKeyboard = SableAppListKeyboard.attach(this, getListView(), getMetricsCategory());
+    }
+
+    @Override
+    public void onDestroyView() {
+        if (mKeyboard != null) {
+            mKeyboard.detach();
+            mKeyboard = null;
+        }
+        super.onDestroyView();
+    }
+
+    @Override
+    public void onResume() {
+        super.onResume();
+        load();
+    }
+
+    private void load() {
+        final Context context = getPrefContext().getApplicationContext();
+        final NotificationBackend backend = mBackend;
+        final int generation = ++mLoadGeneration;
+        ThreadUtils.postOnBackgroundThread(() -> {
+            final boolean active = SableFocusMode.isActive(context);
+            final Set<String> refused = SableFocusMode.reconcile(context, active);
+            final Loaded loaded = new Loaded(active, refused,
+                    SableAppControls.readSet(context, SableAppControls.KEY_FOCUS_PAUSE),
+                    SableAppControls.readSet(context, SableAppControls.KEY_FOCUS_HELD),
+                    loadApps(context, backend));
+            ThreadUtils.postOnMainThread(() -> {
+                if (generation == mLoadGeneration && isAdded()) {
+                    show(loaded);
+                }
+            });
+        });
+    }
+
+    private static List<AppData> loadApps(Context context, NotificationBackend backend) {
+        final PackageManager pm = context.getPackageManager();
+        final Set<String> protectedPkgs = SableAppControls.protectedPackages(context);
+        final List<AppData> out = new ArrayList<>();
+        for (SableAppControls.LauncherApp app : SableAppControls.launcherApps(context, true)) {
+            final List<NotificationChannel> channels = new ArrayList<>();
+            final List<FocusModePolicy.Channel> facts = new ArrayList<>();
+            boolean banned = true;
+            boolean locked = true;
+            try {
+                final PackageInfo pi = pm.getPackageInfo(app.packageName,
+                        PackageManager.PackageInfoFlags.of(PackageManager.GET_PERMISSIONS));
+                final NotificationBackend.AppRow row = backend.loadAppRow(context, pm, pi);
+                banned = row.banned;
+                locked = row.lockedImportance;
+            } catch (PackageManager.NameNotFoundException | RuntimeException e) {
+                Log.w(TAG, "Cannot read notification settings of " + app.packageName, e);
+            }
+            for (NotificationChannelGroup group
+                    : backend.getGroups(app.packageName, app.uid).getList()) {
+                for (NotificationChannel c : group.getChannels()) {
+                    channels.add(c);
+                    facts.add(new FocusModePolicy.Channel(
+                            !banned && c.getImportance() != IMPORTANCE_NONE,
+                            c.canBypassDnd(),
+                            !locked || c.isBlockable(),
+                            c.getConversationId() != null && !c.isDemoted()));
+                }
+            }
+            out.add(new AppData(app, channels, facts,
+                    FocusModePolicy.canPause(app.packageName, true, protectedPkgs)));
+        }
+        return out;
+    }
+
+    private void show(Loaded loaded) {
+        mApps.clear();
+        mApps.addAll(loaded.apps);
+        mSwitch.setChecked(loaded.active);
+        mAllowed.removeAll();
+        mPause.removeAll();
+        for (AppData data : loaded.apps) {
+            final FocusModePolicy.Interrupts state = FocusModePolicy.interrupts(data.facts);
+            final SwitchPreferenceCompat allow = newSwitch(PREFIX_ALLOW, data);
+            allow.setChecked(state == FocusModePolicy.Interrupts.ALL);
+            allow.setEnabled(state != FocusModePolicy.Interrupts.NOT_CHANGEABLE);
+            allow.setSummary(allowSummary(state));
+            mAllowed.addPreference(allow);
+            if (data.canPause) {
+                final SwitchPreferenceCompat pause = newSwitch(PREFIX_PAUSE, data);
+                final boolean on = loaded.chosen.contains(data.app.packageName);
+                pause.setChecked(on);
+                if (loaded.refused.contains(data.app.packageName)) {
+                    pause.setSummary(R.string.sable_focus_app_pause_refused);
+                } else if (loaded.held.contains(data.app.packageName)) {
+                    pause.setSummary(R.string.sable_focus_app_paused_now);
+                } else if (on) {
+                    pause.setSummary(R.string.sable_focus_app_will_pause);
+                }
+                mPause.addPreference(pause);
+            }
+        }
+        addEmptyIfNeeded(mAllowed);
+        addEmptyIfNeeded(mPause);
+    }
+
+    private void addEmptyIfNeeded(PreferenceCategory category) {
+        if (category.getPreferenceCount() > 0) {
+            return;
+        }
+        final Preference empty = new Preference(getPrefContext());
+        empty.setTitle(R.string.sable_app_controls_empty);
+        empty.setSelectable(false);
+        category.addPreference(empty);
+    }
+
+    private SwitchPreferenceCompat newSwitch(String prefix, AppData data) {
+        final SwitchPreferenceCompat pref = new SwitchPreferenceCompat(getPrefContext());
+        pref.setKey(prefix + data.app.packageName);
+        pref.setTitle(data.app.label);
+        if (data.app.icon != null) {
+            pref.setIcon(data.app.icon);
+        }
+        pref.setPersistent(false);
+        pref.setOnPreferenceChangeListener(this);
+        return pref;
+    }
+
+    private static int allowSummary(FocusModePolicy.Interrupts state) {
+        switch (state) {
+            case ALL:
+                return R.string.sable_focus_app_allowed;
+            case SOME:
+                return R.string.sable_focus_app_some;
+            case NONE:
+                return R.string.sable_focus_app_silenced;
+            default:
+                return R.string.sable_focus_app_not_changeable;
+        }
+    }
+
+    private AppData appFor(String key, String prefix) {
+        if (key == null || !key.startsWith(prefix)) {
+            return null;
+        }
+        final String pkg = key.substring(prefix.length());
+        for (AppData d : mApps) {
+            if (d.app.packageName.equals(pkg)) {
+                return d;
+            }
+        }
+        return null;
+    }
+
+    @Override
+    public boolean onPreferenceTreeClick(Preference preference) {
+        if (KEY_SCHEDULE.equals(preference.getKey())) {
+            openModeSettings();
+            return true;
+        }
+        return super.onPreferenceTreeClick(preference);
+    }
+
+    /** Android's own page for this mode (schedule, calendar, calls, display effects). */
+    private void openModeSettings() {
+        final Context context = getPrefContext().getApplicationContext();
+        ThreadUtils.postOnBackgroundThread(() -> {
+            final String id = SableFocusMode.ensureRule(context);
+            ThreadUtils.postOnMainThread(() -> {
+                if (!isAdded()) {
+                    return;
+                }
+                if (id == null) {
+                    Toast.makeText(getPrefContext(), R.string.sable_focus_error,
+                            Toast.LENGTH_SHORT).show();
+                    return;
+                }
+                try {
+                    startActivity(new Intent(Settings.ACTION_AUTOMATIC_ZEN_RULE_SETTINGS)
+                            .setPackage(getPrefContext().getPackageName())
+                            .putExtra(Settings.EXTRA_AUTOMATIC_ZEN_RULE_ID, id));
+                } catch (ActivityNotFoundException e) {
+                    Log.w(TAG, "No mode settings page", e);
+                }
+            });
+        });
+    }
+
+    @Override
+    public boolean onPreferenceChange(Preference preference, Object newValue) {
+        if (!(newValue instanceof Boolean)) {
+            return false;
+        }
+        final boolean on = (Boolean) newValue;
+        final String key = preference.getKey();
+        final Context context = getPrefContext().getApplicationContext();
+        if (KEY_SWITCH.equals(key)) {
+            ThreadUtils.postOnBackgroundThread(() -> {
+                final boolean ok = SableFocusMode.setActive(context, on);
+                ThreadUtils.postOnMainThread(() -> {
+                    if (!ok && isAdded()) {
+                        Toast.makeText(getPrefContext(), R.string.sable_focus_error,
+                                Toast.LENGTH_SHORT).show();
+                    }
+                    if (isAdded()) {
+                        load();
+                    }
+                });
+            });
+            return false; // load() shows what Android now holds
+        }
+        final AppData allow = appFor(key, PREFIX_ALLOW);
+        if (allow != null) {
+            ThreadUtils.postOnBackgroundThread(() -> {
+                for (int i : FocusModePolicy.channelsToChange(allow.facts, on)) {
+                    final NotificationChannel channel = allow.channels.get(i);
+                    channel.setBypassDnd(on);
+                    channel.lockFields(NotificationChannel.USER_LOCKED_PRIORITY);
+                    mBackend.updateChannel(allow.app.packageName, allow.app.uid, channel);
+                }
+                ThreadUtils.postOnMainThread(() -> {
+                    if (isAdded()) {
+                        load();
+                    }
+                });
+            });
+            return false;
+        }
+        final AppData pause = appFor(key, PREFIX_PAUSE);
+        if (pause != null && pause.canPause) {
+            ThreadUtils.postOnBackgroundThread(() -> {
+                SableAppControls.writeSet(context, SableAppControls.KEY_FOCUS_PAUSE,
+                        PackageSet.with(SableAppControls.readSet(context,
+                                SableAppControls.KEY_FOCUS_PAUSE), pause.app.packageName, on));
+                ThreadUtils.postOnMainThread(() -> {
+                    if (isAdded()) {
+                        load(); // reconciles: pauses or releases at once while Focus is on
+                    }
+                });
+            });
+            return false;
+        }
+        return false;
+    }
+}
