+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.settings.applications.sable;
+
+import android.app.AutomaticZenRule;
+import android.app.NotificationManager;
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.pm.PackageManager;
+import android.content.pm.SuspendDialogInfo;
+import android.net.Uri;
+import android.service.notification.Condition;
+import android.service.notification.ZenPolicy;
+import android.util.Log;
+
+import com.android.settings.R;
+import com.android.settings.applications.sable.model.FocusModePolicy;
+
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.HashSet;
+import java.util.Map;
+import java.util.Set;
+
+/**
+ * Focus mode on Android's own machinery (see {@link FocusModePolicy}): an AutomaticZenRule
+ * owned by Settings, with Settings' Focus mode page as its configuration activity, so it is
+ * listed in Settings &gt; Modes and in Quick Settings and can be started from either. Pausing
+ * uses the platform package-suspension API; Settings releases only what it suspended, when
+ * the rule's status broadcast says the mode ended ({@link SableFocusModeReceiver}) and again
+ * whenever the Focus or Mobile Manager page is shown.
+ */
+public final class SableFocusMode {
+    private static final String TAG = "SableFocusMode";
+    private static final String CONDITION_PATH = "sable_focus";
+    private static final Object LOCK = new Object();
+
+    private SableFocusMode() {
+    }
+
+    static Uri conditionId(Context context) {
+        return new Uri.Builder().scheme(Condition.SCHEME)
+                .authority(context.getPackageName())
+                .appendPath(CONDITION_PATH)
+                .build();
+    }
+
+    /** The id of Settings' Focus rule, or null when it does not exist (yet, or was deleted). */
+    static String findRuleId(Context context) {
+        final NotificationManager nm = context.getSystemService(NotificationManager.class);
+        if (nm == null) {
+            return null;
+        }
+        final Uri condition = conditionId(context);
+        try {
+            final Map<String, AutomaticZenRule> rules = nm.getAutomaticZenRules();
+            if (rules == null) {
+                return null;
+            }
+            for (Map.Entry<String, AutomaticZenRule> e : rules.entrySet()) {
+                if (e.getValue() != null && condition.equals(e.getValue().getConditionId())) {
+                    return e.getKey();
+                }
+            }
+        } catch (RuntimeException e) {
+            Log.w(TAG, "Cannot read modes", e);
+        }
+        return null;
+    }
+
+    /** Creates the Focus rule if it is missing; returns its id or null on failure. */
+    static String ensureRule(Context context) {
+        final String existing = findRuleId(context);
+        if (existing != null) {
+            return existing;
+        }
+        final NotificationManager nm = context.getSystemService(NotificationManager.class);
+        if (nm == null) {
+            return null;
+        }
+        final ZenPolicy policy = new ZenPolicy.Builder()
+                .allowPriorityChannels(FocusModePolicy.Spec.ALLOW_PRIORITY_CHANNELS)
+                .allowAlarms(FocusModePolicy.Spec.ALLOW_ALARMS)
+                .allowMedia(FocusModePolicy.Spec.ALLOW_MEDIA)
+                .allowSystem(FocusModePolicy.Spec.ALLOW_SYSTEM)
+                .allowReminders(FocusModePolicy.Spec.ALLOW_REMINDERS)
+                .allowEvents(FocusModePolicy.Spec.ALLOW_EVENTS)
+                .allowRepeatCallers(FocusModePolicy.Spec.ALLOW_REPEAT_CALLERS)
+                .allowCalls(FocusModePolicy.Spec.ALLOW_CALLS
+                        ? ZenPolicy.PEOPLE_TYPE_ANYONE : ZenPolicy.PEOPLE_TYPE_NONE)
+                .allowMessages(FocusModePolicy.Spec.ALLOW_MESSAGES
+                        ? ZenPolicy.PEOPLE_TYPE_ANYONE : ZenPolicy.PEOPLE_TYPE_NONE)
+                .allowConversations(FocusModePolicy.Spec.ALLOW_CONVERSATIONS
+                        ? ZenPolicy.CONVERSATION_SENDERS_ANYONE
+                        : ZenPolicy.CONVERSATION_SENDERS_NONE)
+                .build();
+        final AutomaticZenRule rule = new AutomaticZenRule.Builder(
+                context.getString(R.string.sable_focus_title), conditionId(context))
+                .setConfigurationActivity(new ComponentName(context,
+                        com.android.settings.Settings.SableFocusModeActivity.class))
+                .setType(AutomaticZenRule.TYPE_OTHER)
+                .setInterruptionFilter(NotificationManager.INTERRUPTION_FILTER_PRIORITY)
+                .setZenPolicy(policy)
+                .setManualInvocationAllowed(true)
+                .build();
+        try {
+            return nm.addAutomaticZenRule(rule);
+        } catch (RuntimeException e) {
+            Log.e(TAG, "Cannot create the Focus mode", e);
+            return null;
+        }
+    }
+
+    /** Whether Focus mode is on now. */
+    static boolean isActive(Context context) {
+        final String id = findRuleId(context);
+        if (id == null) {
+            return false;
+        }
+        try {
+            return context.getSystemService(NotificationManager.class)
+                    .getAutomaticZenRuleState(id) == Condition.STATE_TRUE;
+        } catch (RuntimeException e) {
+            Log.w(TAG, "Cannot read the Focus mode state", e);
+            return false;
+        }
+    }
+
+    /** Turns Focus mode on or off as a user action; returns false when Android refused. */
+    static boolean setActive(Context context, boolean active) {
+        final String id = active ? ensureRule(context) : findRuleId(context);
+        if (id == null) {
+            if (active) {
+                return false;
+            }
+            reconcile(context, false);
+            return true;
+        }
+        try {
+            context.getSystemService(NotificationManager.class).setAutomaticZenRuleState(id,
+                    new Condition(conditionId(context), "",
+                            active ? Condition.STATE_TRUE : Condition.STATE_FALSE,
+                            Condition.SOURCE_USER_ACTION));
+        } catch (RuntimeException e) {
+            Log.e(TAG, "Cannot change the Focus mode", e);
+            return false;
+        }
+        reconcile(context, active);
+        return true;
+    }
+
+    /** Reconciles the paused apps with the mode's current state. */
+    static void reconcile(Context context) {
+        reconcile(context, isActive(context));
+    }
+
+    /**
+     * Suspends the chosen apps while {@code active}, releases what Settings holds otherwise.
+     * Returns the packages Android refused to suspend.
+     */
+    static Set<String> reconcile(Context context, boolean active) {
+        synchronized (LOCK) {
+            final Set<String> held = SableAppControls.readSet(context,
+                    SableAppControls.KEY_FOCUS_HELD);
+            final Set<String> chosen = SableAppControls.readSet(context,
+                    SableAppControls.KEY_FOCUS_PAUSE);
+            final FocusModePolicy.Plan plan = FocusModePolicy.plan(active, chosen, held,
+                    active ? SableAppControls.protectedPackages(context)
+                            : Collections.emptySet());
+            if (plan.isEmpty()) {
+                return Collections.emptySet();
+            }
+            final PackageManager pm = context.getPackageManager();
+            final Set<String> failedSuspend = new HashSet<>();
+            final Set<String> failedRelease = new HashSet<>();
+            if (!plan.suspend.isEmpty()) {
+                final SuspendDialogInfo dialog = new SuspendDialogInfo.Builder()
+                        .setTitle(R.string.sable_focus_suspended_title)
+                        .setMessage(R.string.sable_focus_suspended_message)
+                        .setNeutralButtonText(R.string.sable_focus_suspended_button)
+                        .setNeutralButtonAction(SuspendDialogInfo.BUTTON_ACTION_MORE_DETAILS)
+                        .build();
+                failedSuspend.addAll(apply(pm, plan.suspend, true, dialog));
+            }
+            if (!plan.release.isEmpty()) {
+                failedRelease.addAll(apply(pm, plan.release, false, null));
+            }
+            SableAppControls.writeSet(context, SableAppControls.KEY_FOCUS_HELD,
+                    FocusModePolicy.heldAfter(held, plan, failedSuspend, failedRelease));
+            return failedSuspend;
+        }
+    }
+
+    private static Set<String> apply(PackageManager pm, Set<String> packages, boolean suspend,
+            SuspendDialogInfo dialog) {
+        final String[] names = packages.toArray(new String[0]);
+        try {
+            final String[] failed = pm.setPackagesSuspended(names, suspend, null, null, dialog);
+            return failed == null ? Collections.emptySet() : new HashSet<>(Arrays.asList(failed));
+        } catch (RuntimeException e) {
+            Log.e(TAG, "Cannot " + (suspend ? "pause" : "release") + " apps", e);
+            return new HashSet<>(packages);
+        }
+    }
+}
diff --git a/src/com/android/settings/applications/sable/SableFocusModeFragment.java b/src/com/android/settings/applications/sable/SableFocusModeFragment.java
