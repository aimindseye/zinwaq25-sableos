+package com.android.settings.applications.sable;
+
+import android.app.settings.SettingsEnums;
+import android.content.Context;
+import android.net.NetworkPolicyManager;
+import android.os.Bundle;
+import android.os.UserHandle;
+import android.util.Log;
+import android.view.View;
+
+import androidx.preference.Preference;
+
+import com.android.settings.R;
+import com.android.settings.SettingsPreferenceFragment;
+import com.android.settings.applications.sable.model.ProfileSpaces;
+import com.android.settings.search.BaseSearchIndexProvider;
+import com.android.settingslib.search.SearchIndexable;
+import com.android.settingslib.utils.ThreadUtils;
+
+import java.util.List;
+
+/**
+ * Mobile Manager (MOBILE_MANAGER_APP_CONTROLS_UX app control center): one page that groups the
+ * app controls and shows each one's state. Every row opens the page that owns the setting;
+ * Network access is the existing Network Manager (no second blocker or store), Background use
+ * is Android's per-app battery setting. Settings &gt; Apps &gt; Mobile Manager, Settings &gt;
+ * Sable &gt; Mobile Manager and org.sableos.settings.MOBILE_MANAGER.
+ */
+@SearchIndexable
+public class SableMobileManagerFragment extends SettingsPreferenceFragment {
+    private static final String TAG = "SableMobileManager";
+    static final String KEY_NETWORK = "sable_mm_network";
+    static final String KEY_BACKGROUND = "sable_mm_background";
+    static final String KEY_APP_LOCK = "sable_mm_app_lock";
+    static final String KEY_FOCUS = "sable_mm_focus";
+    static final String KEY_SPACES = "sable_mm_spaces";
+
+    private SableAppListKeyboard mKeyboard;
+    private int mLoadGeneration;
+
+    /** Row states read off the main thread. */
+    private static final class Summaries {
+        final int networkBlocked;
+        final int appLockChosen;
+        final boolean focusActive;
+        final int focusPaused;
+        final ProfileSpaces.PrivateSpace privateSpace;
+
+        Summaries(int networkBlocked, int appLockChosen, boolean focusActive, int focusPaused,
+                ProfileSpaces.PrivateSpace privateSpace) {
+            this.networkBlocked = networkBlocked;
+            this.appLockChosen = appLockChosen;
+            this.focusActive = focusActive;
+            this.focusPaused = focusPaused;
+            this.privateSpace = privateSpace;
+        }
+    }
+
+    @Override
+    public int getMetricsCategory() {
+        return SettingsEnums.MANAGE_APPLICATIONS;
+    }
+
+    @Override
+    public void onCreate(Bundle icicle) {
+        super.onCreate(icicle);
+        addPreferencesFromResource(R.xml.sable_mobile_manager);
+        if (!backgroundListEnabled(getPrefContext())) {
+            final Preference background = findPreference(KEY_BACKGROUND);
+            if (background != null) {
+                background.setVisible(false);
+            }
+        }
+    }
+
+    /** Android's per-app battery list (Settings > Apps > App battery usage) is in this build. */
+    private static boolean backgroundListEnabled(Context context) {
+        return context.getResources().getBoolean(R.bool.config_app_battery_usage_list_enabled);
+    }
+
+    @Override
+    public void onViewCreated(View view, Bundle savedInstanceState) {
+        super.onViewCreated(view, savedInstanceState);
+        mKeyboard = SableAppListKeyboard.attach(this, getListView(), getMetricsCategory());
+    }
+
+    @Override
+    public void onDestroyView() {
+        if (mKeyboard != null) {
+            mKeyboard.detach();
+            mKeyboard = null;
+        }
+        super.onDestroyView();
+    }
+
+    @Override
+    public void onResume() {
+        super.onResume();
+        final Context context = getPrefContext().getApplicationContext();
+        final int generation = ++mLoadGeneration;
+        ThreadUtils.postOnBackgroundThread(() -> {
+            final boolean focus = SableFocusMode.isActive(context);
+            // Also releases apps left paused if Focus mode ended while Settings was not told.
+            SableFocusMode.reconcile(context, focus);
+            final Summaries s = new Summaries(networkBlockedCount(context),
+                    SableAppLockFragment.chosenCount(context), focus,
+                    SableAppControls.readSet(context, SableAppControls.KEY_FOCUS_HELD).size(),
+                    SablePrivateSpaceFragment.load(context).privateSpace);
+            ThreadUtils.postOnMainThread(() -> {
+                if (generation == mLoadGeneration && isAdded()) {
+                    show(s);
+                }
+            });
+        });
+    }
+
+    /** Apps of the current user blocked on all networks (the Network Manager switch off). */
+    private static int networkBlockedCount(Context context) {
+        try {
+            final int[] uids = NetworkPolicyManager.from(context)
+                    .getUidsWithPolicy(NetworkPolicyManager.POLICY_REJECT_ALL);
+            int count = 0;
+            final int user = UserHandle.myUserId();
+            for (int uid : uids) {
+                if (UserHandle.getUserId(uid) == user && UserHandle.isApp(uid)) {
+                    count++;
+                }
+            }
+            return count;
+        } catch (RuntimeException e) {
+            Log.w(TAG, "Cannot read network policies", e);
+            return 0;
+        }
+    }
+
+    private void show(Summaries s) {
+        final Preference network = findPreference(KEY_NETWORK);
+        if (network != null) {
+            network.setSummary(s.networkBlocked == 0
+                    ? getString(R.string.sable_mm_network_all_allowed)
+                    : getResources().getQuantityString(R.plurals.sable_mm_network_blocked,
+                            s.networkBlocked, s.networkBlocked));
+        }
+        final Preference lock = findPreference(KEY_APP_LOCK);
+        if (lock != null) {
+            lock.setSummary(SableAppLockFragment.summary(getResources(), s.appLockChosen));
+        }
+        final Preference focus = findPreference(KEY_FOCUS);
+        if (focus != null) {
+            if (!s.focusActive) {
+                focus.setSummary(R.string.sable_focus_off);
+            } else if (s.focusPaused > 0) {
+                focus.setSummary(getResources().getQuantityString(R.plurals.sable_focus_on_paused,
+                        s.focusPaused, s.focusPaused));
+            } else {
+                focus.setSummary(R.string.sable_focus_on);
+            }
+        }
+        final Preference spaces = findPreference(KEY_SPACES);
+        if (spaces != null) {
+            spaces.setSummary(getString(R.string.sable_spaces_private_title) + ": "
+                    + getString(SablePrivateSpaceFragment.privateSummary(s.privateSpace)));
+        }
+    }
+
+    public static final BaseSearchIndexProvider SEARCH_INDEX_DATA_PROVIDER =
+            new BaseSearchIndexProvider(R.xml.sable_mobile_manager) {
+                @Override
+                public List<String> getNonIndexableKeys(Context context) {
+                    final List<String> keys = super.getNonIndexableKeys(context);
+                    // Indexed once, from Settings > Apps > Network access.
+                    keys.add(KEY_NETWORK);
+                    if (!backgroundListEnabled(context)) {
+                        keys.add(KEY_BACKGROUND);
+                    }
+                    return keys;
+                }
+            };
+}
