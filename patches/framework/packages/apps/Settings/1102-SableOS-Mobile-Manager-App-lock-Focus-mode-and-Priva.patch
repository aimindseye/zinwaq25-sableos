+        <!-- SableOS: Mobile Manager (Settings > Apps > Mobile Manager). -->
+        <activity
+            android:name="Settings$SableMobileManagerActivity"
+            android:exported="true"
+            android:label="@string/sable_mobile_manager_title">
+            <intent-filter>
+                <action android:name="org.sableos.settings.MOBILE_MANAGER" />
+                <category android:name="android.intent.category.DEFAULT" />
+            </intent-filter>
+            <meta-data android:name="com.android.settings.FRAGMENT_CLASS"
+                android:value="com.android.settings.applications.sable.SableMobileManagerFragment" />
+            <meta-data android:name="com.android.settings.HIGHLIGHT_MENU_KEY"
+                android:value="@string/menu_key_apps"/>
+        </activity>
+
+        <!-- SableOS: Focus mode. Also the configuration activity of the Focus mode entry in
+             Settings > Modes, so Modes and Quick Settings open it by component. -->
+        <activity
+            android:name="Settings$SableFocusModeActivity"
+            android:exported="true"
+            android:label="@string/sable_focus_title">
+            <intent-filter>
+                <action android:name="org.sableos.settings.FOCUS_MODE" />
+                <category android:name="android.intent.category.DEFAULT" />
+            </intent-filter>
+            <meta-data android:name="com.android.settings.FRAGMENT_CLASS"
+                android:value="com.android.settings.applications.sable.SableFocusModeFragment" />
+            <meta-data android:name="com.android.settings.HIGHLIGHT_MENU_KEY"
+                android:value="@string/menu_key_apps"/>
+        </activity>
+
+        <!-- SableOS: the "Focus mode" button of Android's dialog for an app Focus mode paused.
+             Android only offers it when the suspending package (Settings) has an activity for
+             this action guarded by exactly this permission. -->
+        <activity-alias
+            android:name="SableFocusModeSuspendedAppDetails"
+            android:targetActivity="Settings$SableFocusModeActivity"
+            android:exported="true"
+            android:permission="android.permission.SEND_SHOW_SUSPENDED_APP_DETAILS"
+            android:label="@string/sable_focus_title">
+            <intent-filter>
+                <action android:name="android.intent.action.SHOW_SUSPENDED_APP_DETAILS" />
+                <category android:name="android.intent.category.DEFAULT" />
+            </intent-filter>
+            <meta-data android:name="com.android.settings.FRAGMENT_CLASS"
+                android:value="com.android.settings.applications.sable.SableFocusModeFragment" />
+            <meta-data android:name="com.android.settings.HIGHLIGHT_MENU_KEY"
+                android:value="@string/menu_key_apps"/>
+        </activity-alias>
+
+        <!-- SableOS: Focus mode started or ended (from anywhere): pause or release the chosen
+             apps. Android sends this only to the rule owner's package; Settings shares the
+             system UID, so the receiver need not be exported. -->
+        <receiver
+            android:name=".applications.sable.SableFocusModeReceiver"
+            android:exported="false">
+            <intent-filter>
+                <action android:name="android.app.action.AUTOMATIC_ZEN_RULE_STATUS_CHANGED" />
+            </intent-filter>
+        </receiver>
+
         <activity android:name="Settings$UserAspectRatioAppListActivity"
             android:exported="true"
             android:label="@string/aspect_ratio_title">
