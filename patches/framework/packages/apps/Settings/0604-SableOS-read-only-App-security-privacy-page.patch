+        rows.add(new Row(KEY_IDENTITY, res.getString(R.string.sable_security_signer),
+                digest == null
+                        ? ev(res, Evidence.UNKNOWN, res.getString(R.string.sable_security_unavailable))
+                        : ev(res, Evidence.DECLARED, res.getString(
