+        final AppSecurityFacts.InstallClass ic = AppSecurityFacts.installClass(
+                (ai.flags & ApplicationInfo.FLAG_SYSTEM) != 0,
+                (ai.flags & ApplicationInfo.FLAG_UPDATED_SYSTEM_APP) != 0);
