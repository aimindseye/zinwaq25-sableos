+        if (signing != null) {
+            final String lineage;
+            if (signing.hasMultipleSigners()) {
+                lineage = res.getString(R.string.sable_security_signers_multiple,
+                        signers == null ? 0 : signers.length);
+            } else if (signing.hasPastSigningCertificates()) {
+                final Signature[] history = signing.getSigningCertificateHistory();
+                lineage = res.getString(R.string.sable_security_signers_rotated,
