+                ev(res, Evidence.DECLARED, flags.isEmpty()
+                        ? res.getString(R.string.sable_security_flag_release)
+                        : TextUtils.join(" · ", flags)), null));
+    }
+
+    private void access(Context context, Resources res, ApplicationInfo ai, String packageName,
+            List<Row> rows) {
+        final PrivacyFacts facts = new SablePrivacyFactsReader(context).read(ai);
+        if (facts == null) {
+            rows.add(new Row(KEY_ACCESS, res.getString(R.string.sable_security_access_title),
+                    ev(res, Evidence.UNKNOWN, res.getString(R.string.sable_security_unavailable)),
+                    null));
+        } else {
+            final AppPrivacy privacy = PrivacyEvaluator.evaluate(facts);
+            final SablePrivacyLabels labels = new SablePrivacyLabels(context);
+            for (Map.Entry<PrivacyGroup, GroupState> e : privacy.groups().entrySet()) {
+                final GroupState state = e.getValue();
+                final Evidence evidence = state == GroupState.UNKNOWN
+                        ? Evidence.UNKNOWN : Evidence.ENFORCED;
+                rows.add(new Row(KEY_ACCESS,
+                        res.getString(SablePrivacyLabels.groupRes(e.getKey())),
+                        ev(res, evidence, stateLabel(res, labels, e.getKey(), state)), null));
+            }
+            if (privacy.groups().isEmpty()) {
+                rows.add(new Row(KEY_ACCESS,
+                        res.getString(R.string.sable_security_access_title),
+                        ev(res, Evidence.DECLARED,
+                                res.getString(R.string.sable_security_access_none)), null));
+            }
+        }
+        rows.add(new Row(KEY_ACCESS, res.getString(R.string.sable_security_open_permissions),
+                res.getString(R.string.sable_security_open_permissions_summary),
+                () -> openPermissions(packageName)));
+    }
+
+    private static String stateLabel(Resources res, SablePrivacyLabels labels, PrivacyGroup g,
+            GroupState state) {
+        switch (state) {
+            case ALLOWED:
+                return res.getString(R.string.sable_security_state_allowed);
+            case APPROXIMATE:
+            case LIMITED:
+                return labels.group(g, state);
+            case NOT_ALLOWED:
+                return res.getString(R.string.sable_security_state_not_allowed);
+            default:
+                return res.getString(R.string.sable_security_unavailable);
+        }
+    }
+
+    private void openPermissions(String packageName) {
+        final Context context = getContext();
+        if (context == null) {
+            return;
+        }
+        final Intent intent = new Intent(Intent.ACTION_MANAGE_APP_PERMISSIONS)
+                .setPackage(context.getPackageManager().getPermissionControllerPackageName())
+                .putExtra(Intent.EXTRA_PACKAGE_NAME, packageName);
+        try {
+            startActivity(intent);
+        } catch (RuntimeException e) {
+            Log.w(TAG, "No permission page for " + packageName, e);
+        }
+    }
+
+    private void components(Resources res, PackageInfo pi, boolean read, List<Row> rows) {
+        if (!read) {
+            rows.add(new Row(KEY_COMPONENTS, res.getString(R.string.sable_security_components),
+                    ev(res, Evidence.UNKNOWN,
+                            res.getString(R.string.sable_security_components_too_large)), null));
+            return;
+        }
+        final ComponentExposure activities = new ComponentExposure();
+        if (pi.activities != null) {
+            for (ActivityInfo a : pi.activities) {
+                activities.add(a.name, a.enabled, a.exported, !TextUtils.isEmpty(a.permission));
+            }
+        }
+        final ComponentExposure services = new ComponentExposure();
+        final Set<AppSecurityFacts.Elevated> elevated = new LinkedHashSet<>();
+        if (pi.services != null) {
+            for (ServiceInfo s : pi.services) {
+                services.add(s.name, s.enabled, s.exported, !TextUtils.isEmpty(s.permission));
+                final AppSecurityFacts.Elevated e = AppSecurityFacts.Elevated.of(s.permission);
+                if (e != null && e != AppSecurityFacts.Elevated.DEVICE_ADMIN) {
+                    elevated.add(e);
+                }
+            }
+        }
+        final ComponentExposure receivers = new ComponentExposure();
+        if (pi.receivers != null) {
+            for (ActivityInfo r : pi.receivers) {
+                receivers.add(r.name, r.enabled, r.exported, !TextUtils.isEmpty(r.permission));
+                if (AppSecurityFacts.Elevated.of(r.permission)
+                        == AppSecurityFacts.Elevated.DEVICE_ADMIN) {
+                    elevated.add(AppSecurityFacts.Elevated.DEVICE_ADMIN);
+                }
+            }
+        }
+        final ComponentExposure providers = new ComponentExposure();
+        if (pi.providers != null) {
+            for (ProviderInfo p : pi.providers) {
+                providers.add(p.name, p.enabled, p.exported,
+                        !TextUtils.isEmpty(p.readPermission)
+                                || !TextUtils.isEmpty(p.writePermission));
+            }
+        }
+        componentRow(res, R.string.sable_security_activities, activities, rows);
+        componentRow(res, R.string.sable_security_services, services, rows);
+        componentRow(res, R.string.sable_security_receivers, receivers, rows);
+        componentRow(res, R.string.sable_security_providers, providers, rows);
+        rows.add(new Row(KEY_COMPONENTS, res.getString(R.string.sable_security_instrumentation),
+                ev(res, Evidence.DECLARED, Integer.toString(
+                        pi.instrumentation == null ? 0 : pi.instrumentation.length)), null));
+        final List<String> names = new ArrayList<>();
+        for (AppSecurityFacts.Elevated e : elevated) {
+            names.add(res.getString(elevatedRes(e)));
+        }
+        rows.add(new Row(KEY_COMPONENTS, res.getString(R.string.sable_security_elevated),
+                ev(res, Evidence.DECLARED, names.isEmpty()
+                        ? res.getString(R.string.sable_security_none)
+                        : TextUtils.join(" · ", names)), null));
+    }
+
+    private static int elevatedRes(AppSecurityFacts.Elevated e) {
+        switch (e) {
+            case ACCESSIBILITY:
+                return R.string.sable_security_elevated_accessibility;
+            case NOTIFICATION_LISTENER:
+                return R.string.sable_security_elevated_notification_listener;
+            case VPN:
+                return R.string.sable_security_elevated_vpn;
+            case INPUT_METHOD:
+                return R.string.sable_security_elevated_input_method;
+            case AUTOFILL:
+                return R.string.sable_security_elevated_autofill;
+            default:
+                return R.string.sable_security_elevated_device_admin;
+        }
+    }
+
+    private static void componentRow(Resources res, int titleRes, ComponentExposure c,
+            List<Row> rows) {
+        String detail = res.getString(R.string.sable_security_components_format, c.total(),
+                c.enabled(), c.exported(), c.exportedUnguarded());
+        if (!c.exportedNames().isEmpty()) {
+            detail = res.getString(R.string.sable_security_components_names_format, detail,
+                    TextUtils.join(", ", c.exportedNames()));
+            if (c.unlistedExported() > 0) {
+                detail = res.getString(R.string.sable_security_components_more_format, detail,
+                        c.unlistedExported());
+            }
+        }
+        rows.add(new Row(KEY_COMPONENTS, res.getString(titleRes),
+                ev(res, Evidence.DECLARED, detail), null));
+    }
+
+    private static void code(Resources res, ApplicationInfo ai, List<Row> rows) {
+        final NativeCodeScan scan = new NativeCodeScan();
+        final List<String> apks = new ArrayList<>();
+        if (!TextUtils.isEmpty(ai.sourceDir)) {
+            apks.add(ai.sourceDir);
+        }
+        if (ai.splitSourceDirs != null) {
+            apks.addAll(Arrays.asList(ai.splitSourceDirs));
+        }
+        for (String path : apks) {
+            if (!scan.acceptsApk()) {
+                break;
+            }
+            try (ZipFile zip = new ZipFile(path)) {
+                scan.apkOpened();
+                final Enumeration<? extends ZipEntry> entries = zip.entries();
+                while (entries.hasMoreElements()) {
+                    if (!scan.entry(entries.nextElement().getName())) {
+                        break;
+                    }
+                }
+            } catch (IOException | RuntimeException e) {
+                // An unreadable APK adds nothing; UNKNOWN only when none could be read.
+            }
+        }
+        final String nativeDetail;
+        if (scan.evidence() == Evidence.UNKNOWN) {
+            nativeDetail = res.getString(R.string.sable_security_unavailable);
+        } else {
+            final String abis = scan.abis().isEmpty() ? res.getString(R.string.sable_security_none)
+                    : TextUtils.join(", ", scan.abis());
+            nativeDetail = res.getString(scan.truncated()
+                            ? R.string.sable_security_native_format_truncated
+                            : R.string.sable_security_native_format,
+                    scan.libraries().size(), abis);
+        }
+        rows.add(new Row(KEY_CODE, res.getString(R.string.sable_security_native),
+                ev(res, scan.evidence(), nativeDetail), null));
+        rows.add(new Row(KEY_CODE, res.getString(R.string.sable_security_shared_libraries),
+                ev(res, Evidence.DECLARED, Integer.toString(
+                        ai.sharedLibraryFiles == null ? 0 : ai.sharedLibraryFiles.length)), null));
+        rows.add(new Row(KEY_CODE, res.getString(R.string.sable_security_trackers),
+                ev(res, Evidence.UNKNOWN, res.getString(R.string.sable_security_trackers_unknown)),
+                null));
+    }
+
+    private void network(Context context, Resources res, Context userContext, PackageInfo pi,
+            ApplicationInfo ai, List<Row> rows) {
+        final boolean internet = pi.requestedPermissions != null
+                && Arrays.asList(pi.requestedPermissions).contains(Manifest.permission.INTERNET);
+        rows.add(new Row(KEY_NETWORK, res.getString(R.string.sable_security_internet),
+                ev(res, Evidence.DECLARED, res.getString(internet
+                        ? R.string.sable_security_yes : R.string.sable_security_no)), null));
+        if (internet) {
+            String summary;
+            try {
+                final NetworkPolicyManager npm = NetworkPolicyManager.from(context);
+                final NetworkAccessPolicy.State state = NetworkAccessPolicy.evaluate(
+                        npm.getUidPolicy(ai.uid), UserHandle.isApp(ai.uid),
+                        new NetworkAccessPolicy.Masks(NetworkPolicyManager.POLICY_REJECT_ALL,
+                                NetworkPolicyManager.POLICY_REJECT_CELLULAR,
+                                NetworkPolicyManager.POLICY_REJECT_WIFI,
+                                NetworkPolicyManager.POLICY_REJECT_VPN,
+                                NetworkPolicyManager.POLICY_REJECT_METERED_BACKGROUND));
+                summary = ev(res, Evidence.ENFORCED,
+                        SableNetworkManagerFragment.summaryFor(res, state, 0));
+            } catch (RuntimeException e) {
+                summary = ev(res, Evidence.UNKNOWN,
+                        res.getString(R.string.sable_security_unavailable));
+            }
+            final boolean currentUser = UserHandle.getUserId(ai.uid) == UserHandle.myUserId();
+            rows.add(new Row(KEY_NETWORK, res.getString(R.string.sable_network_manager_title),
+                    summary, currentUser ? this::openNetworkManager : null));
+        }
+        rows.add(new Row(KEY_NETWORK, res.getString(R.string.sable_security_network_usage),
+                ev(res, Evidence.UNKNOWN,
+                        res.getString(R.string.sable_security_network_usage_unknown)), null));
+        String background;
+        try {
+            final PowerManager power = userContext.getSystemService(PowerManager.class);
+            background = power == null
+                    ? ev(res, Evidence.UNKNOWN, res.getString(R.string.sable_security_unavailable))
+                    : ev(res, Evidence.ENFORCED, res.getString(
+                            power.isIgnoringBatteryOptimizations(pi.packageName)
+                                    ? R.string.sable_security_battery_unrestricted
+                                    : R.string.sable_security_battery_optimized));
+        } catch (RuntimeException e) {
+            background = ev(res, Evidence.UNKNOWN,
+                    res.getString(R.string.sable_security_unavailable));
+        }
+        rows.add(new Row(KEY_NETWORK, res.getString(R.string.sable_security_background),
+                background, null));
+        rows.add(new Row(KEY_NETWORK, res.getString(R.string.sable_security_stopped),
+                ev(res, Evidence.ENFORCED, res.getString(
+                        (ai.flags & ApplicationInfo.FLAG_STOPPED) != 0
+                                ? R.string.sable_security_stopped_yes
+                                : R.string.sable_security_stopped_no)), null));
+    }
+
+    private void openNetworkManager() {
+        if (getContext() == null) {
+            return;
+        }
+        new SubSettingLauncher(getContext())
+                .setDestination(SableNetworkManagerFragment.class.getName())
+                .setSourceMetricsCategory(getMetricsCategory())
+                .launch();
+    }
+
+    private static void history(Context context, Resources res, PackageInfo pi, List<Row> rows) {
+        rows.add(new Row(KEY_HISTORY, res.getString(R.string.sable_security_first_install),
+                ev(res, Evidence.OBSERVED, time(context, res, pi.firstInstallTime)), null));
+        rows.add(new Row(KEY_HISTORY, res.getString(R.string.sable_security_last_update),
+                ev(res, Evidence.OBSERVED, time(context, res, pi.lastUpdateTime)), null));
+        rows.add(new Row(KEY_HISTORY, res.getString(R.string.sable_security_change_history),
+                ev(res, Evidence.UNKNOWN, res.getString(R.string.sable_security_change_history_unknown)),
+                null));
+    }
+
+    private static String time(Context context, Resources res, long millis) {
+        if (millis <= 0) {
+            return res.getString(R.string.sable_security_unavailable);
+        }
+        return DateUtils.formatDateTime(context, millis,
+                DateUtils.FORMAT_SHOW_DATE | DateUtils.FORMAT_SHOW_YEAR
+                        | DateUtils.FORMAT_SHOW_TIME);
+    }
+
+    private static String sha256(Signature signature) {
+        try {
+            return AppSecurityFacts.hex(
+                    MessageDigest.getInstance("SHA-256").digest(signature.toByteArray()));
+        } catch (NoSuchAlgorithmException e) {
+            return null;
+        }
+    }
+}
