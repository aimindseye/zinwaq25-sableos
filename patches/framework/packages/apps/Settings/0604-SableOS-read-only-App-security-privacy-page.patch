+        for (String key : new String[] {KEY_IDENTITY, KEY_ACCESS, KEY_COMPONENTS, KEY_CODE,
+                KEY_NETWORK, KEY_HISTORY}) {
+            final PreferenceCategory c = findPreference(key);
+            if (c != null) {
+                c.removeAll();
+            }
+        }
+        for (Row row : rows) {
+            final PreferenceCategory c = findPreference(row.category);
+            if (c == null) {
