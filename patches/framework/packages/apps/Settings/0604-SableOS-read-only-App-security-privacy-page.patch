+/**
+ * Settings &gt; Apps &gt; App security &amp; privacy: the current user's apps with their
+ * sensitive-access summary; choosing one opens {@link SableAppSecurityFragment}. This is the
+ * page {@code org.sableos.settings.APP_SECURITY} opens. When that intent carries a
+ * {@code package:} URI for an app of the current user, that app's page opens at once (Back
+ * returns to this list); Sable Tools sends the action alone.
+ */
+public class SableAppSecurityAppsFragment extends SettingsPreferenceFragment {
+    private static final String KEY_APPS = "sable_security_apps";
+    private static final String STATE_HANDLED_URI = "sable_handled_uri";
+
+    private PreferenceCategory mApps;
+    private SableAppListKeyboard mKeyboard;
+    private boolean mHandledUri;
+    private int mLoadGeneration;
+
+    /** One loaded row. */
+    private static final class AppRow {
+        final ApplicationInfo info;
+        final String label;
+        final Drawable icon;
+        final CharSequence summary;
+
+        AppRow(ApplicationInfo info, String label, Drawable icon, CharSequence summary) {
+            this.info = info;
+            this.label = label;
+            this.icon = icon;
+            this.summary = summary;
+        }
+    }
+
+    @Override
+    public int getMetricsCategory() {
+        return SettingsEnums.MANAGE_APPLICATIONS;
+    }
+
+    @Override
+    public void onCreate(Bundle icicle) {
+        super.onCreate(icicle);
+        addPreferencesFromResource(R.xml.sable_app_security_apps);
+        mApps = findPreference(KEY_APPS);
+        mHandledUri = icicle != null && icicle.getBoolean(STATE_HANDLED_URI);
+        if (!mHandledUri) {
+            mHandledUri = true;
+            openFromIntent();
+        }
+    }
+
+    @Override
+    public void onSaveInstanceState(Bundle outState) {
+        super.onSaveInstanceState(outState);
+        outState.putBoolean(STATE_HANDLED_URI, mHandledUri);
+    }
+
+    /** package:<name> in the launching intent opens that app's page for the current user. */
+    private void openFromIntent() {
+        final Activity activity = getActivity();
+        final Intent intent = activity == null ? null : activity.getIntent();
+        final Uri data = intent == null ? null : intent.getData();
+        if (data == null || !"package".equals(data.getScheme())
+                || TextUtils.isEmpty(data.getSchemeSpecificPart())) {
+            return;
+        }
+        try {
+            final ApplicationInfo ai = getPrefContext().getPackageManager().getApplicationInfo(
+                    data.getSchemeSpecificPart(), PackageManager.ApplicationInfoFlags.of(0));
+            openApp(ai);
+        } catch (PackageManager.NameNotFoundException e) {
+            // Unknown package for this user: stay on the list.
+        }
+    }
+
+    @Override
+    public void onViewCreated(View view, Bundle savedInstanceState) {
+        super.onViewCreated(view, savedInstanceState);
+        mKeyboard = SableAppListKeyboard.attach(this, getListView(), getMetricsCategory());
+    }
+
+    @Override
+    public void onDestroyView() {
+        if (mKeyboard != null) {
+            mKeyboard.detach();
+            mKeyboard = null;
+        }
+        super.onDestroyView();
+    }
+
+    @Override
+    public void onResume() {
+        super.onResume();
+        final Context context = getPrefContext().getApplicationContext();
+        final int generation = ++mLoadGeneration;
+        ThreadUtils.postOnBackgroundThread(() -> {
+            final List<AppRow> rows = load(context);
+            ThreadUtils.postOnMainThread(() -> {
+                if (generation == mLoadGeneration && isAdded()) {
+                    show(rows);
+                }
+            });
+        });
+    }
+
+    private static List<AppRow> load(Context context) {
+        final PackageManager pm = context.getPackageManager();
+        final List<AppRow> rows = new ArrayList<>();
+        final List<ApplicationInfo> apps;
+        try {
+            apps = pm.getInstalledApplications(PackageManager.ApplicationInfoFlags.of(
+                    PackageManager.MATCH_DISABLED_COMPONENTS
+                            | PackageManager.MATCH_DISABLED_UNTIL_USED_COMPONENTS));
+        } catch (RuntimeException e) {
+            return rows;
+        }
+        final SablePrivacyFactsReader reader = new SablePrivacyFactsReader(context);
+        final SablePrivacyLabels labels = new SablePrivacyLabels(context);
+        final IconDrawableFactory icons = IconDrawableFactory.newInstance(context);
+        for (ApplicationInfo ai : apps) {
+            if (!InstalledAppCounter.includeInCount(InstalledAppCounter.IGNORE_INSTALL_REASON,
+                    pm, ai)) {
+                continue;
+            }
+            final CharSequence label = ai.loadLabel(pm);
+            final PrivacyFacts facts = reader.read(ai);
+            final PrivacyRow row = PrivacyRow.of(facts == null ? null
+                    : PrivacyEvaluator.evaluate(facts));
+            rows.add(new AppRow(ai, label == null ? ai.packageName : label.toString(),
+                    icons.getBadgedIcon(ai), row.text(labels)));
+        }
+        final Collator collator = Collator.getInstance();
+        rows.sort((a, b) -> collator.compare(a.label, b.label));
+        return rows;
+    }
+
+    private void show(List<AppRow> rows) {
+        mApps.removeAll();
+        for (AppRow row : rows) {
+            final Preference p = new Preference(getPrefContext());
+            p.setKey(row.info.packageName);
+            p.setTitle(row.label);
+            p.setSummary(row.summary);
+            p.setIcon(row.icon);
+            p.setPersistent(false);
+            p.setOnPreferenceClickListener(pref -> {
+                openApp(row.info);
+                return true;
+            });
+            mApps.addPreference(p);
+        }
+    }
+
+    private void openApp(ApplicationInfo ai) {
+        final Bundle args = new Bundle();
+        args.putString(AppInfoBase.ARG_PACKAGE_NAME, ai.packageName);
+        args.putInt(AppInfoBase.ARG_PACKAGE_UID, ai.uid);
+        new SubSettingLauncher(getPrefContext())
+                .setDestination(SableAppSecurityFragment.class.getName())
+                .setArguments(args)
+                .setTitleRes(R.string.sable_app_security_title)
+                .setUserHandle(UserHandle.getUserHandleForUid(ai.uid))
+                .setSourceMetricsCategory(getMetricsCategory())
+                .launch();
+    }
+}
