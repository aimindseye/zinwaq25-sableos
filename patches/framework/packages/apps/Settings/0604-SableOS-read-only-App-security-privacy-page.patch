+                res.getString(R.string.sable_security_notice), null));
+        identity(res, pm, pi, ai, rows);
+        access(context, res, ai, packageName, rows);
+        components(res, pi, componentsRead, rows);
+        code(res, ai, rows);
+        network(context, res, userContext, pi, ai, rows);
+        history(context, res, pi, rows);
+        return rows;
+    }
+
+    private static String ev(Resources res, Evidence e, CharSequence detail) {
+        return res.getString(R.string.sable_security_evidence_format, evidenceLabel(res, e),
+                detail);
+    }
+
+    static String evidenceLabel(Resources res, Evidence e) {
+        switch (e) {
+            case DECLARED:
+                return res.getString(R.string.sable_security_evidence_declared);
+            case ENFORCED:
+                return res.getString(R.string.sable_security_evidence_enforced);
+            case OBSERVED:
+                return res.getString(R.string.sable_security_evidence_observed);
+            case INFERRED:
+                return res.getString(R.string.sable_security_evidence_inferred);
+            default:
+                return res.getString(R.string.sable_security_evidence_unknown);
+        }
+    }
+
+    private void identity(Resources res, PackageManager pm, PackageInfo pi, ApplicationInfo ai,
+            List<Row> rows) {
+        rows.add(new Row(KEY_IDENTITY, res.getString(R.string.sable_security_package),
+                ev(res, Evidence.DECLARED, pi.packageName), null));
+        final String version = TextUtils.isEmpty(pi.versionName)
+                ? res.getString(R.string.sable_security_unavailable) : pi.versionName;
+        rows.add(new Row(KEY_IDENTITY, res.getString(R.string.sable_security_version),
+                ev(res, Evidence.DECLARED, res.getString(R.string.sable_security_version_format,
+                        version, pi.getLongVersionCode())), null));
+        rows.add(new Row(KEY_IDENTITY, res.getString(R.string.sable_security_sdk),
+                ev(res, Evidence.DECLARED, res.getString(R.string.sable_security_sdk_format,
+                        ai.minSdkVersion, ai.targetSdkVersion)), null));
+
+        List<String> chain;
+        try {
+            final InstallSourceInfo src = pm.getInstallSourceInfo(pi.packageName);
+            chain = AppSecurityFacts.installerChain(src.getInstallingPackageName(),
+                    src.getInitiatingPackageName(), src.getOriginatingPackageName());
+        } catch (PackageManager.NameNotFoundException | RuntimeException e) {
+            chain = null;
+        }
+        rows.add(new Row(KEY_IDENTITY, res.getString(R.string.sable_security_installer),
+                chain == null
+                        ? ev(res, Evidence.UNKNOWN, res.getString(R.string.sable_security_unavailable))
+                        : ev(res, Evidence.OBSERVED, chain.isEmpty()
+                                ? res.getString(R.string.sable_security_installer_none)
+                                : TextUtils.join(" · ", chain)), null));
+
+        final SigningInfo signing = pi.signingInfo;
