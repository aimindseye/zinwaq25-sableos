+            componentsRead = false;
+            try {
+                pi = pm.getPackageInfo(packageName, PackageManager.PackageInfoFlags.of(BASE_FLAGS));
+            } catch (PackageManager.NameNotFoundException | RuntimeException e2) {
+                return null;
