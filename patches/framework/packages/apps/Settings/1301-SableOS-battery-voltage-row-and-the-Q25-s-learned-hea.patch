+package com.android.settings.fuelgauge.sable.model;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.Test;
+
+/**
+ * The voltage row, and the Battery health facts a Zinwa Q25 shows with kernel patch 0201
+ * (learned cycle count and aging factor, design capacity in uAh) and its profile.
+ */
+public class VoltageAndQ25FactsTest {
+    private static final long NOW = 1_790_000_000_000L;
+
+    /** The capability lines of device-profile/battery/zinwa-q25.conf. */
+    private static BatteryCapabilityProfile q25() {
+        return TestProfiles.of("health_capacity_supported=YES",
+                "health_cycle_count_supported=YES", "health_temperature_supported=YES",
+                "health_status_supported=UNKNOWN", "health_charge_counter_supported=UNKNOWN",
+                "health_manufacturing_date_supported=NO", "health_first_use_date_supported=NO",
+                "health_voltage_supported=YES", "spec_design_capacity_mah=3000");
+    }
+
+    private static BatteryReadings.Builder q25Kernel0201() {
+        // charge_full_design 2951 mAh (Q_MAX), aging factor 95 %, 37 cycles, 31.2 C, 3.874 V.
+        return BatteryReadings.builder().designCapacityUah(2_951_000)
+                .fullChargeUah(2_803_450).cycleCount(37).temperatureDeciC(312)
+                .voltageMillivolts(3_874).healthStatus(BatteryReadings.HEALTH_GOOD)
+                .chargeCounterUah(1_475_500).sampleTimeMillis(NOW);
+    }
+
+    @Test
+    public void q25ShowsCyclesCapacityTemperatureAndVoltage() {
+        final HealthReport r = BatteryHealthEvaluator.evaluate(q25Kernel0201().build(), q25(),
+                NOW);
+        assertEquals(37L, r.fact(FactKind.CYCLE_COUNT).value());
+        assertEquals(2_951_000L, r.fact(FactKind.DESIGN_CAPACITY).value());
+        assertEquals(2_803_450L, r.fact(FactKind.MAXIMUM_CAPACITY).value());
+        assertEquals(95L, r.fact(FactKind.CAPACITY_HEALTH).value());
+        assertEquals(312L, r.fact(FactKind.TEMPERATURE).value());
+        assertEquals(3_874L, r.fact(FactKind.VOLTAGE).value());
+        assertEquals(HealthReport.Coverage.COMPLETE, r.coverage());
+        // Charge counter is the level times the static Q_MAX on this gauge: not verified.
+        assertFalse(r.fact(FactKind.CHARGE_COUNTER).isAvailable());
+        assertEquals(UnavailableReason.NOT_QUALIFIED, r.fact(FactKind.CHARGE_COUNTER).reason());
+        assertFalse(r.fact(FactKind.MANUFACTURING_DATE).isAvailable());
+    }
+
+    @Test
+    public void q25WithoutLearnedValuesSaysNotReported() {
+        // Kernel 0201 returns -ENODATA, which the health HAL reads as 0.
+        final HealthReport r = BatteryHealthEvaluator.evaluate(q25Kernel0201().fullChargeUah(0)
+                .cycleCount(0).build(), q25(), NOW);
+        assertEquals(UnavailableReason.NOT_REPORTED, r.fact(FactKind.MAXIMUM_CAPACITY).reason());
+        assertEquals(UnavailableReason.NOT_REPORTED, r.fact(FactKind.CAPACITY_HEALTH).reason());
+        // With evidence a zero count is a real zero (a new battery).
+        assertEquals(0L, r.fact(FactKind.CYCLE_COUNT).value());
+        assertTrue(r.fact(FactKind.TEMPERATURE).isAvailable());
+    }
+
+    @Test
+    public void theOldMediatekValuesAreNeverShownAsMeasurements() {
+        // Before 0201: design Q_MAX/10 (295 mAh) and full Q_MAX: the pair is rejected.
+        final HealthReport r = BatteryHealthEvaluator.evaluate(q25Kernel0201()
+                .designCapacityUah(295_000).fullChargeUah(2_951_000).build(), q25(), NOW);
+        assertEquals(UnavailableReason.IMPLAUSIBLE, r.fact(FactKind.DESIGN_CAPACITY).reason());
+        assertFalse(r.fact(FactKind.CAPACITY_HEALTH).isAvailable()
+                && r.fact(FactKind.CAPACITY_HEALTH).value() > 100);
+    }
+
+    @Test
+    public void voltageIsShownUnlessMissingOrImplausible() {
+        final BatteryCapabilityProfile unknown = TestProfiles.of();
+        assertTrue(BatteryHealthEvaluator.evaluate(q25Kernel0201().build(), unknown, NOW)
+                .fact(FactKind.VOLTAGE).isAvailable());
+        assertEquals(UnavailableReason.NOT_REPORTED, BatteryHealthEvaluator.evaluate(
+                q25Kernel0201().voltageMillivolts(BatteryReadings.MISSING).build(), unknown, NOW)
+                .fact(FactKind.VOLTAGE).reason());
+        assertEquals(UnavailableReason.NOT_REPORTED, BatteryHealthEvaluator.evaluate(
+                q25Kernel0201().voltageMillivolts(0).build(), unknown, NOW)
+                .fact(FactKind.VOLTAGE).reason());
+        // A microvolt value (an HAL unit mistake) is rejected, not shown as 3874 V.
+        assertEquals(UnavailableReason.IMPLAUSIBLE, BatteryHealthEvaluator.evaluate(
+                q25Kernel0201().voltageMillivolts(3_874_000).build(), unknown, NOW)
+                .fact(FactKind.VOLTAGE).reason());
+        assertEquals(UnavailableReason.UNSUPPORTED, BatteryHealthEvaluator.evaluate(
+                q25Kernel0201().build(), TestProfiles.of("health_voltage_supported=NO"), NOW)
+                .fact(FactKind.VOLTAGE).reason());
+    }
+
+    @Test
+    public void voltagePresentsAsMillivolts() {
+        final FactText t = HealthFactPresenter.present(HealthFact.available(FactKind.VOLTAGE,
+                3_874, FactSource.ANDROID_FRAMEWORK, FactConfidence.PLATFORM_REPORTED, NOW),
+                580, java.time.ZoneOffset.UTC, NOW);
+        assertEquals(FactText.Template.VOLTAGE, t.template);
+        assertEquals(3_874L, t.args[0]);
+        assertTrue(t.showsValue());
+    }
+}
