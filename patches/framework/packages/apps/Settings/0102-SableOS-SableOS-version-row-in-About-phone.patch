+package com.android.settings.sable;
+
+import android.content.Context;
+import android.os.SystemProperties;
+
+import com.android.settings.R;
+import com.android.settings.core.BasePreferenceController;
+
+/** Settings > About phone > SableOS version, from the Sable product properties. */
+public class SableVersionPreferenceController extends BasePreferenceController {
+
+    public SableVersionPreferenceController(Context context, String preferenceKey) {
+        super(context, preferenceKey);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return AVAILABLE;
+    }
+
+    @Override
+    public CharSequence getSummary() {
+        return SableBuildInfo.summary(
+                SystemProperties.get(SableBuildInfo.PROP_RELEASE),
+                SystemProperties.get(SableBuildInfo.PROP_BASE),
+                SystemProperties.get(SableBuildInfo.PROP_BUILD_SOURCE),
+                mContext.getString(R.string.unknown));
+    }
+}
