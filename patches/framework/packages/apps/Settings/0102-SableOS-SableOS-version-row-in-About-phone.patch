new file mode 100644
index 0000000..d01f8af
--- /dev/null
+++ b/res/values/strings_sable_about.xml
@@ -0,0 +1,10 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+  Copyright (C) 2026 The SableOS Project
+  SPDX-License-Identifier: Apache-2.0
+-->
+<resources>
+    <!-- Settings > About phone: the SableOS product version. The LineageOS version row and
+         LineageOS legal information stay as the base attribution. -->
+    <string name="sable_version_title">SableOS version</string>
+</resources>
diff --git a/res/xml/my_device_info.xml b/res/xml/my_device_info.xml
index 9148a9d..6266009 100644
--- a/res/xml/my_device_info.xml
+++ b/res/xml/my_device_info.xml
@@ -136,6 +136,16 @@
             settings:isPreferenceVisible="@bool/config_show_sim_info"
             settings:controller="com.android.settings.deviceinfo.imei.ImeiInfoPreferenceController"/>
 
+        <!-- SableOS version (SableOS product layer) -->
+        <Preference
+            android:key="sable_os_version"
+            android:order="41"
+            android:title="@string/sable_version_title"
+            android:summary="@string/summary_placeholder"
+            android:selectable="false"
+            settings:enableCopying="true"
+            settings:controller="com.android.settings.sable.SableVersionPreferenceController"/>
+
         <!-- Android version -->
         <Preference
             android:key="firmware_version"
