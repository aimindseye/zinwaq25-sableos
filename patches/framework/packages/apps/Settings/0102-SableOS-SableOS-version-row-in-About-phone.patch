+package com.android.settings.sable;
+
+/**
+ * Pure formatting of the "SableOS version" row in Settings > About phone from the properties the
+ * Sable product layer writes (ro.sable.release, ro.sable.base, ro.sable.build_source). No Android
+ * imports, so it is unit-tested on the host. The LineageOS version row stays below it as the base
+ * attribution.
+ */
+public final class SableBuildInfo {
+    public static final String PROP_RELEASE = "ro.sable.release";
+    public static final String PROP_BASE = "ro.sable.base";
+    public static final String PROP_BUILD_SOURCE = "ro.sable.build_source";
+
+    static final int SHORT_SOURCE_LENGTH = 12;
+
+    private SableBuildInfo() {}
+
+    /**
+     * "Q4 · lineage-23.2 · 0afdeef1c2d3"; parts that are missing are left out, and
+     * {@code unknown} is returned when nothing is set.
+     */
+    public static String summary(String release, String base, String buildSource, String unknown) {
+        StringBuilder out = new StringBuilder();
+        append(out, release);
+        append(out, base);
+        append(out, shortSource(buildSource));
+        return out.length() == 0 ? unknown : out.toString();
+    }
+
+    static String shortSource(String buildSource) {
+        if (isBlank(buildSource) || "uncommitted".equals(buildSource.trim())) {
+            return null;
+        }
+        String trimmed = buildSource.trim();
+        return trimmed.length() > SHORT_SOURCE_LENGTH
+                ? trimmed.substring(0, SHORT_SOURCE_LENGTH) : trimmed;
+    }
+
+    private static void append(StringBuilder out, String part) {
+        if (isBlank(part)) {
+            return;
+        }
+        if (out.length() > 0) {
+            out.append(" · ");
+        }
+        out.append(part.trim());
+    }
+
+    private static boolean isBlank(String value) {
+        return value == null || value.trim().isEmpty();
+    }
+}
