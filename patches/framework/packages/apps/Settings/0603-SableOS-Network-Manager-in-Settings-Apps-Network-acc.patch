+package com.android.settings.applications.sable;
+
+import android.Manifest;
+import android.app.settings.SettingsEnums;
+import android.content.Context;
+import android.content.Intent;
+import android.content.pm.ApplicationInfo;
+import android.content.pm.PackageInfo;
+import android.content.pm.PackageManager;
+import android.content.pm.ResolveInfo;
+import android.content.res.Resources;
+import android.graphics.drawable.Drawable;
+import android.net.NetworkPolicyManager;
+import android.net.Uri;
+import android.os.Bundle;
+import android.os.UserHandle;
+import android.util.IconDrawableFactory;
+import android.util.Log;
+import android.view.View;
+
+import androidx.appcompat.app.AlertDialog;
+import androidx.preference.Preference;
+import androidx.preference.PreferenceCategory;
+import androidx.preference.SwitchPreferenceCompat;
+
+import com.android.settings.R;
+import com.android.settings.SettingsPreferenceFragment;
+import com.android.settings.applications.InstalledAppCounter;
+import com.android.settings.applications.sable.model.NetworkAccessPolicy;
+import com.android.settings.applications.sable.model.NetworkAppRows;
+import com.android.settingslib.utils.ThreadUtils;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Locale;
+import java.util.Set;
+
+/**
+ * Sable Network Manager: one network switch per app (per UID), Settings &gt; Apps &gt;
+ * Network access, also opened by {@code org.sableos.settings.NETWORK_MANAGER}.
+ *
+ * <p>It is a view over the per-UID restriction LineageOS already enforces and already shows in
+ * App info &gt; Mobile data &amp; Wi-Fi ({@link NetworkPolicyManager#POLICY_REJECT_ALL}); it
+ * keeps no policy of its own. The switch touches only that bit. Per-network restrictions set
+ * in App info are listed in the row summary and left as they are. Blocking a messaging, mail
+ * or calling app asks first, because it can stop notifications, sync and sign-in.
+ */
+public class SableNetworkManagerFragment extends SettingsPreferenceFragment
+        implements Preference.OnPreferenceChangeListener {
+    private static final String TAG = "SableNetworkManager";
+    private static final String KEY_APPS = "sable_network_apps";
+    private static final String KEY_EMPTY = "sable_network_empty";
+    private static final String KEY_PREFIX = "sable_net:";
+
+    private NetworkPolicyManager mPolicyManager;
+    private NetworkAccessPolicy.Masks mMasks;
+    private PreferenceCategory mApps;
+    private SableAppListKeyboard mKeyboard;
+    private final List<RowData> mRows = new ArrayList<>();
+    private int mLoadGeneration;
+
+    /** One loaded row: model row, icon and whether blocking it asks first. */
+    private static final class RowData {
+        final NetworkAppRows.Row row;
+        final Drawable icon;
+        final boolean messaging;
+
+        RowData(NetworkAppRows.Row row, Drawable icon, boolean messaging) {
+            this.row = row;
+            this.icon = icon;
+            this.messaging = messaging;
+        }
+    }
+
+    @Override
+    public int getMetricsCategory() {
+        return SettingsEnums.MANAGE_APPLICATIONS;
+    }
+
+    @Override
+    public void onCreate(Bundle icicle) {
+        super.onCreate(icicle);
+        addPreferencesFromResource(R.xml.sable_network_manager);
+        mApps = findPreference(KEY_APPS);
+        mPolicyManager = NetworkPolicyManager.from(getPrefContext());
+        mMasks = new NetworkAccessPolicy.Masks(NetworkPolicyManager.POLICY_REJECT_ALL,
+                NetworkPolicyManager.POLICY_REJECT_CELLULAR,
+                NetworkPolicyManager.POLICY_REJECT_WIFI,
+                NetworkPolicyManager.POLICY_REJECT_VPN,
+                NetworkPolicyManager.POLICY_REJECT_METERED_BACKGROUND);
+    }
+
+    @Override
+    public void onViewCreated(View view, Bundle savedInstanceState) {
+        super.onViewCreated(view, savedInstanceState);
+        mKeyboard = SableAppListKeyboard.attach(this, getListView(), getMetricsCategory());
+    }
+
+    @Override
+    public void onDestroyView() {
+        if (mKeyboard != null) {
+            mKeyboard.detach();
+            mKeyboard = null;
+        }
+        super.onDestroyView();
+    }
+
+    @Override
+    public void onResume() {
+        super.onResume();
+        load();
+    }
+
+    private void load() {
+        final Context context = getPrefContext().getApplicationContext();
+        final int generation = ++mLoadGeneration;
+        ThreadUtils.postOnBackgroundThread(() -> {
+            final List<RowData> rows = loadRows(context);
+            ThreadUtils.postOnMainThread(() -> {
+                if (generation == mLoadGeneration && isAdded()) {
+                    show(rows);
+                }
+            });
+        });
+    }
+
+    /** Apps of the current user that request network access, one row per UID. */
+    private static List<RowData> loadRows(Context context) {
+        final PackageManager pm = context.getPackageManager();
+        final Set<String> messaging = new HashSet<>();
+        messaging.addAll(handlers(pm, new Intent(Intent.ACTION_SENDTO, Uri.parse("smsto:"))));
+        messaging.addAll(handlers(pm, new Intent(Intent.ACTION_SENDTO, Uri.parse("mailto:"))));
+        final List<NetworkAppRows.App> apps = new ArrayList<>();
+        final Set<Integer> messagingUids = new HashSet<>();
+        final List<ApplicationInfo> infos = new ArrayList<>();
+        final List<PackageInfo> packages;
+        try {
+            packages = pm.getInstalledPackages(
+                    PackageManager.PackageInfoFlags.of(PackageManager.GET_PERMISSIONS));
+        } catch (RuntimeException e) {
+            Log.w(TAG, "Cannot list packages", e);
+            return new ArrayList<>();
+        }
+        for (PackageInfo pi : packages) {
+            final ApplicationInfo ai = pi.applicationInfo;
+            if (ai == null || pi.requestedPermissions == null
+                    || !Arrays.asList(pi.requestedPermissions)
+                            .contains(Manifest.permission.INTERNET)
+                    || !UserHandle.isApp(ai.uid)
+                    || !InstalledAppCounter.includeInCount(
+                            InstalledAppCounter.IGNORE_INSTALL_REASON, pm, ai)) {
+                continue;
+            }
+            final CharSequence label = ai.loadLabel(pm);
+            apps.add(new NetworkAppRows.App(ai.uid, pi.packageName,
+                    label == null ? null : label.toString()));
+            infos.add(ai);
+            if (NetworkAccessPolicy.isMessagingApp(Arrays.asList(pi.requestedPermissions),
+                    messaging.contains(pi.packageName), false)) {
+                messagingUids.add(ai.uid);
+            }
+        }
+        final IconDrawableFactory icons = IconDrawableFactory.newInstance(context);
+        final List<RowData> out = new ArrayList<>();
+        for (NetworkAppRows.Row row : NetworkAppRows.build(apps, Locale.getDefault())) {
+            Drawable icon = null;
+            for (ApplicationInfo ai : infos) {
+                if (ai.packageName.equals(row.primary.packageName)) {
+                    icon = icons.getBadgedIcon(ai);
+                    break;
+                }
+            }
+            out.add(new RowData(row, icon, messagingUids.contains(row.uid)));
+        }
+        return out;
+    }
+
+    private static Set<String> handlers(PackageManager pm, Intent intent) {
+        final Set<String> out = new HashSet<>();
+        try {
+            for (ResolveInfo ri : pm.queryIntentActivities(intent,
+                    PackageManager.ResolveInfoFlags.of(0))) {
+                if (ri.activityInfo != null) {
+                    out.add(ri.activityInfo.packageName);
+                }
+            }
+        } catch (RuntimeException e) {
+            // No handler information: nobody counts as messaging through this path.
+        }
+        return out;
+    }
+
+    private void show(List<RowData> rows) {
+        mRows.clear();
+        mRows.addAll(rows);
+        mApps.removeAll();
+        if (rows.isEmpty()) {
+            final Preference empty = new Preference(getPrefContext());
+            empty.setKey(KEY_EMPTY);
+            empty.setTitle(R.string.sable_network_manager_empty);
+            empty.setSelectable(false);
+            mApps.addPreference(empty);
+            return;
+        }
+        for (RowData data : rows) {
+            final SwitchPreferenceCompat pref = new SwitchPreferenceCompat(getPrefContext());
+            pref.setKey(KEY_PREFIX + data.row.uid);
+            pref.setTitle(data.row.primary.label);
+            if (data.icon != null) {
+                pref.setIcon(data.icon);
+            }
+            pref.setPersistent(false);
+            pref.setOnPreferenceChangeListener(this);
+            bind(pref, data);
+            mApps.addPreference(pref);
+        }
+    }
+
+    private NetworkAccessPolicy.State stateOf(int uid) {
+        int policy;
+        try {
+            policy = mPolicyManager.getUidPolicy(uid);
+        } catch (RuntimeException e) {
+            policy = 0;
+            Log.w(TAG, "Cannot read network policy for " + uid, e);
+        }
+        return NetworkAccessPolicy.evaluate(policy, UserHandle.isApp(uid), mMasks);
+    }
+
+    private void bind(SwitchPreferenceCompat pref, RowData data) {
+        final NetworkAccessPolicy.State state = stateOf(data.row.uid);
+        pref.setChecked(state.switchChecked());
+        pref.setEnabled(state.summary != NetworkAccessPolicy.Summary.NOT_MANAGEABLE);
+        pref.setSummary(summaryFor(getResources(), state, data.row.othersCount()));
+    }
+
+    /** Row summary; also used by App Security &amp; Privacy. */
+    static String summaryFor(Resources res, NetworkAccessPolicy.State state, int others) {
+        final StringBuilder sb = new StringBuilder();
+        switch (state.summary) {
+            case BLOCKED:
+                sb.append(res.getString(R.string.sable_network_blocked_all));
+                break;
+            case NOT_MANAGEABLE:
+                sb.append(res.getString(R.string.sable_network_not_manageable));
+                break;
+            case PARTIAL: {
+                final List<String> blocked = new ArrayList<>();
+                if (state.blockedCellular) {
+                    blocked.add(res.getString(R.string.sable_network_transport_mobile));
+                }
+                if (state.blockedWifi) {
+                    blocked.add(res.getString(R.string.sable_network_transport_wifi));
+                }
+                if (state.blockedVpn) {
+                    blocked.add(res.getString(R.string.sable_network_transport_vpn));
+                }
+                if (!blocked.isEmpty()) {
+                    sb.append(res.getString(R.string.sable_network_blocked_some,
+                            String.join(", ", blocked)));
+                } else {
+                    sb.append(res.getString(R.string.sable_network_allowed_all));
+                }
+                if (state.backgroundDataRestricted) {
+                    sb.append(res.getString(R.string.sable_network_separator))
+                            .append(res.getString(R.string.sable_network_background_off));
+                }
+                break;
+            }
+            default:
+                sb.append(res.getString(R.string.sable_network_allowed_all));
+                break;
+        }
+        if (others > 0) {
+            sb.append(res.getString(R.string.sable_network_separator)).append(
+                    res.getQuantityString(R.plurals.sable_network_shared_uid, others, others));
+        }
+        return sb.toString();
+    }
+
+    private RowData rowFor(Preference preference) {
+        final String key = preference.getKey();
+        if (key == null || !key.startsWith(KEY_PREFIX)) {
+            return null;
+        }
+        final int uid;
+        try {
+            uid = Integer.parseInt(key.substring(KEY_PREFIX.length()));
+        } catch (NumberFormatException e) {
+            return null;
+        }
+        for (RowData d : mRows) {
+            if (d.row.uid == uid) {
+                return d;
+            }
+        }
+        return null;
+    }
+
+    @Override
+    public boolean onPreferenceChange(Preference preference, Object newValue) {
+        final RowData data = rowFor(preference);
+        if (data == null || !(newValue instanceof Boolean)
+                || !(preference instanceof SwitchPreferenceCompat)) {
+            return false;
+        }
+        final boolean allow = (Boolean) newValue;
+        final SwitchPreferenceCompat pref = (SwitchPreferenceCompat) preference;
+        if (NetworkAccessPolicy.needsConfirmation(allow, data.messaging)) {
+            new AlertDialog.Builder(getPrefContext())
+                    .setTitle(getString(R.string.sable_network_confirm_title,
+                            data.row.primary.label))
+                    .setMessage(R.string.sable_network_confirm_message)
+                    .setPositiveButton(R.string.sable_network_confirm_block,
+                            (dialog, which) -> apply(pref, data, false))
+                    .setNegativeButton(android.R.string.cancel, null)
+                    .show();
+            return false;
+        }
+        apply(pref, data, allow);
+        return false; // bind() shows what the platform now holds
+    }
+
+    private void apply(SwitchPreferenceCompat pref, RowData data, boolean allow) {
+        final NetworkAccessPolicy.Change change =
+                NetworkAccessPolicy.changeFor(stateOf(data.row.uid), allow, mMasks);
+        if (change != null) {
+            try {
+                if (change.add) {
+                    mPolicyManager.addUidPolicy(data.row.uid, change.bits);
+                } else {
+                    mPolicyManager.removeUidPolicy(data.row.uid, change.bits);
+                }
+            } catch (RuntimeException e) {
+                Log.e(TAG, "Cannot change network policy for " + data.row.uid, e);
+            }
+        }
+        bind(pref, data);
+    }
+}
