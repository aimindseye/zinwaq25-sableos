From: SableOS <noreply@sableos.invalid>
Date: Fri, 20 Nov 2026 00:55:00 +0000
Subject: [PATCH 1620/1620] SableOS: media player on lock screen switch in
 Settings > Security

Android's own Lock screen page is not reachable on SableOS, so the switch for the
lock screen media player had no home. Settings > Security gets "Media player on
lock screen" next to the Lock screen peek row. It is the Settings.Secure
media_controls_lock_screen setting (on by default), one switch for Sable Media and
the FM radio.
---
 res/values/strings_sable_lock_media.xml       |  9 ++++
 res/xml/security_dashboard_settings.xml       |  8 ++++
 .../SableLockMediaPreferenceController.java   | 38 +++++++++++++++++
 3 files changed, 55 insertions(+)

diff --git a/res/values/strings_sable_lock_media.xml b/res/values/strings_sable_lock_media.xml
new file mode 100644
--- /dev/null
+++ b/res/values/strings_sable_lock_media.xml
@@ -0,0 +1,11 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+     Copyright (C) 2026 The SableOS Project
+     SPDX-License-Identifier: Apache-2.0
+-->
+<resources>
+    <!-- SableOS Settings > Security > Lock screen media player. -->
+    <string name="sable_lock_media_title">Media player on lock screen</string>
+    <string name="sable_lock_media_summary">Show the playing song or FM radio, with its buttons, on the lock screen</string>
+    <string name="sable_lock_media_keywords">lock screen, media, player, music, radio, fm, controls</string>
+</resources>
diff --git a/res/xml/security_dashboard_settings.xml b/res/xml/security_dashboard_settings.xml
--- a/res/xml/security_dashboard_settings.xml
+++ b/res/xml/security_dashboard_settings.xml
@@ -51,6 +51,14 @@
             settings:keywords="@string/sable_lock_peek_keywords"
             settings:controller="com.android.settings.sable.SableLockPeekPreferenceController" />
 
+        <!-- SableOS: the media player (and the FM radio) on the lock screen. -->
+        <SwitchPreferenceCompat
+            android:key="sable_lock_screen_media"
+            android:title="@string/sable_lock_media_title"
+            android:summary="@string/sable_lock_media_summary"
+            settings:keywords="@string/sable_lock_media_keywords"
+            settings:controller="com.android.settings.sable.SableLockMediaPreferenceController" />
+
         <!-- SableOS: Picture Password, also on the Sable page (SystemUI, frameworks/base 0320). -->
         <Preference
             android:key="sable_picture_password_security"
diff --git a/src/com/android/settings/sable/SableLockMediaPreferenceController.java b/src/com/android/settings/sable/SableLockMediaPreferenceController.java
new file mode 100644
--- /dev/null
+++ b/src/com/android/settings/sable/SableLockMediaPreferenceController.java
@@ -0,0 +1,57 @@
