+package com.android.settings.sable;
+
+import android.content.Context;
+import android.provider.Settings;
+
+import com.android.settings.R;
+import com.android.settings.core.TogglePreferenceController;
+
+/**
+ * Settings > Security > Media player on lock screen: the switch behind the player card on the
+ * lock screen (Settings.Secure media_controls_lock_screen, on unless the owner turned it off).
+ * It is one switch for the player of Sable Media and the FM radio. Android's own Lock screen
+ * page is not reachable on SableOS, so the choice lives next to the Lock screen peek row.
+ */
+public class SableLockMediaPreferenceController extends TogglePreferenceController {
+    private static final String KEY = "media_controls_lock_screen";
+
+    public SableLockMediaPreferenceController(Context context, String preferenceKey) {
+        super(context, preferenceKey);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return AVAILABLE;
+    }
+
+    @Override
+    public boolean isChecked() {
+        return Settings.Secure.getInt(mContext.getContentResolver(), KEY, 1) != 0;
+    }
+
+    @Override
+    public boolean setChecked(boolean isChecked) {
+        return Settings.Secure.putInt(mContext.getContentResolver(), KEY, isChecked ? 1 : 0);
+    }
+
+    @Override
+    public int getSliceHighlightMenuRes() {
+        return R.string.menu_key_security;
+    }
+}
