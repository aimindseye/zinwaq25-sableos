 res/xml/top_level_settings_expressive.xml | 63 ++++++++++++++++++++++++++++-----------------------
 2 files changed, 68 insertions(+), 53 deletions(-)
diff --git a/res/xml/top_level_settings.xml b/res/xml/top_level_settings.xml
index 10a7d35..86d15d4 100644
--- a/res/xml/top_level_settings.xml
+++ b/res/xml/top_level_settings.xml
@@ -26,6 +26,25 @@
         android:layout="@layout/settingslib_untitled_preference_category">
     </PreferenceCategory>
 
+    <!-- SableOS: BlackBerry 10 order (owner pick 2026-11-05, reorder only): Sable first, then
+         Networks, Notifications, Apps, Display, Security and privacy, Accessibility, Device,
+         Storage, Battery and About. Nothing is hidden. -->
