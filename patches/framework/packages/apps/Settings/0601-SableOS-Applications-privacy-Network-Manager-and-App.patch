+package com.android.settings.applications.sable.model;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.Test;
+
+import java.util.EnumMap;
+import java.util.Map;
+
+/** The compact row wording matches Sable Start's All Apps row. */
+public class PrivacyRowTest {
+    private static final EnglishLabels L = EnglishLabels.INSTANCE;
+
+    private static AppPrivacy of(Object... pairs) {
+        final Map<PrivacyGroup, GroupState> m = new EnumMap<>(PrivacyGroup.class);
+        for (int i = 0; i < pairs.length; i += 2) {
+            m.put((PrivacyGroup) pairs[i], (GroupState) pairs[i + 1]);
+        }
+        return new AppPrivacy(m);
+    }
+
+    @Test
+    public void unreadableStateSaysUnavailable() {
+        final PrivacyRow r = PrivacyRow.of(null);
+        assertEquals(PrivacyRow.State.UNAVAILABLE, r.state);
+        assertEquals("permissions · unavailable", r.text(L));
+    }
+
+    @Test
+    public void nothingRequestedOrAllDeniedIsNoneSensitive() {
+        assertEquals("permissions · none sensitive", PrivacyRow.of(of()).text(L));
+        assertEquals("permissions · none sensitive",
+                PrivacyRow.of(of(PrivacyGroup.CAMERA, GroupState.NOT_ALLOWED)).text(L));
+    }
+
+    @Test
+    public void unknownWithoutAccessIsNotConfirmedNeverNone() {
+        final PrivacyRow r = PrivacyRow.of(of(PrivacyGroup.CAMERA, GroupState.UNKNOWN,
+                PrivacyGroup.CONTACTS, GroupState.NOT_ALLOWED));
+        assertEquals(PrivacyRow.State.NOT_CONFIRMED, r.state);
+        assertEquals("permissions · see app info", r.text(L));
+    }
+
+    @Test
+    public void unknownIsNeverListedBesideKnownAccess() {
+        final PrivacyRow r = PrivacyRow.of(of(PrivacyGroup.CAMERA, GroupState.UNKNOWN,
+                PrivacyGroup.CONTACTS, GroupState.ALLOWED));
+        assertEquals("permissions · Contacts", r.text(L));
+    }
+
+    @Test
+    public void atMostThreeInlineLabelsThenPlusN() {
+        final PrivacyRow r = PrivacyRow.of(of(PrivacyGroup.LOCATION, GroupState.ALLOWED,
+                PrivacyGroup.CONTACTS, GroupState.ALLOWED, PrivacyGroup.NEARBY, GroupState.ALLOWED,
+                PrivacyGroup.NOTIFICATIONS, GroupState.ALLOWED));
+        assertEquals("permissions · Location · Contacts · Nearby · +1", r.text(L));
+        assertEquals(1, r.overflow);
+        assertEquals("Permissions: Location, Contacts, Nearby, Notifications", r.spokenText(L));
+    }
+
+    @Test
+    public void maxInlineIsClampedToOneToThree() {
+        final AppPrivacy p = of(PrivacyGroup.CAMERA, GroupState.ALLOWED,
+                PrivacyGroup.MICROPHONE, GroupState.ALLOWED);
+        assertEquals("permissions · Camera · +1", PrivacyRow.of(p, 0).text(L));
+        assertEquals("permissions · Camera · Microphone", PrivacyRow.of(p, 9).text(L));
+    }
+
+    @Test
+    public void partialLabels() {
+        assertEquals("permissions · Location approximate · Photos limited",
+                PrivacyRow.of(of(PrivacyGroup.LOCATION, GroupState.APPROXIMATE,
+                        PrivacyGroup.PHOTOS, GroupState.LIMITED)).text(L));
+    }
+
+    @Test
+    public void specialAccessIsAMarkerBesideEverydayGroups() {
+        final PrivacyRow r = PrivacyRow.of(of(PrivacyGroup.CAMERA, GroupState.ALLOWED,
+                PrivacyGroup.ACCESSIBILITY, GroupState.ALLOWED));
+        assertTrue(r.warning);
+        assertEquals("⚠ permissions · Camera", r.text(L));
+        assertEquals(1, r.badge.size());
+        assertEquals("Permissions: Camera. Special access: Accessibility", r.spokenText(L));
+    }
+
+    @Test
+    public void specialAccessGoesInlineWhenNothingEverydayIsEffective() {
+        final PrivacyRow r = PrivacyRow.of(of(PrivacyGroup.OVERLAY, GroupState.ALLOWED,
+                PrivacyGroup.CAMERA, GroupState.NOT_ALLOWED));
+        assertEquals("⚠ permissions · Overlay", r.text(L));
+        assertTrue(r.badge.isEmpty());
+    }
+
+    @Test
+    public void noRawPermissionOrPackageNames() {
+        final PrivacyRow r = PrivacyRow.of(of(PrivacyGroup.MESSAGES, GroupState.ALLOWED));
+        assertFalse(r.text(L).contains("android.permission"));
+        assertEquals("permissions · Messages", r.text(L));
+    }
+}
