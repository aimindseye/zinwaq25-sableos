+ */
+
+
+package com.android.settings.applications.sable.model;
+
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.Map;
+
+/**
+ * Everything the Android layer could read about one app in one Android user. Only requested
+ * permissions appear in {@link #permissions}. A null special-access field means "could not be
+ * determined" and is left out, never guessed.
+ */
+public final class PrivacyFacts {
+    public final Map<String, PermissionFact> permissions;
+    public final int targetSdk;
+    public final int deviceSdk;
+    public final Boolean accessibilityServiceEnabled;
+    public final Boolean activeDeviceAdmin;
+    public final OpMode installAppsOp;
+    public final OpMode overlayOp;
+    public final OpMode usageAccessOp;
+
+    private PrivacyFacts(Builder b) {
+        permissions = Collections.unmodifiableMap(new LinkedHashMap<>(b.mPermissions));
+        targetSdk = b.mTargetSdk;
+        deviceSdk = b.mDeviceSdk;
+        accessibilityServiceEnabled = b.mAccessibility;
+        activeDeviceAdmin = b.mDeviceAdmin;
+        installAppsOp = b.mInstallAppsOp;
+        overlayOp = b.mOverlayOp;
+        usageAccessOp = b.mUsageAccessOp;
+    }
+
+    public static Builder builder(int targetSdk, int deviceSdk) {
+        return new Builder(targetSdk, deviceSdk);
+    }
+
+    /** Builder; permissions keep insertion order. */
+    public static final class Builder {
+        private final Map<String, PermissionFact> mPermissions = new LinkedHashMap<>();
+        private final int mTargetSdk;
+        private final int mDeviceSdk;
+        private Boolean mAccessibility;
+        private Boolean mDeviceAdmin;
+        private OpMode mInstallAppsOp;
+        private OpMode mOverlayOp;
+        private OpMode mUsageAccessOp;
+
+        Builder(int targetSdk, int deviceSdk) {
+            mTargetSdk = targetSdk;
+            mDeviceSdk = deviceSdk;
+        }
+
+        public Builder permission(String name, PermissionFact fact) {
+            if (name != null && fact != null) {
+                mPermissions.put(name, fact);
+            }
+            return this;
+        }
+
+        public Builder accessibilityServiceEnabled(Boolean enabled) {
+            mAccessibility = enabled;
+            return this;
+        }
+
+        public Builder activeDeviceAdmin(Boolean active) {
+            mDeviceAdmin = active;
+            return this;
+        }
+
+        public Builder installAppsOp(OpMode mode) {
+            mInstallAppsOp = mode;
+            return this;
+        }
+
+        public Builder overlayOp(OpMode mode) {
+            mOverlayOp = mode;
+            return this;
+        }
+
+        public Builder usageAccessOp(OpMode mode) {
+            mUsageAccessOp = mode;
+            return this;
+        }
+
+        public PrivacyFacts build() {
+            return new PrivacyFacts(this);
+        }
+    }
+}
diff --git a/src/com/android/settings/applications/sable/model/PrivacyGroup.java b/src/com/android/settings/applications/sable/model/PrivacyGroup.java
