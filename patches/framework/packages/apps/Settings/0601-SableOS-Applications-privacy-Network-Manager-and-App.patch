+
+package com.android.settings.applications.sable.model;
+
+import java.text.Collator;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.Comparator;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+
+/**
+ * Network Manager rows. The platform restriction is per UID, so packages that share a UID
+ * share one row (and one switch); the row is titled by the alphabetically first label and
+ * says how many other apps it covers. Rows are sorted by title for type-ahead.
+ */
+public final class NetworkAppRows {
+
+    /** One package that requests network access. */
+    public static final class App {
+        public final int uid;
+        public final String packageName;
+        public final String label;
+
+        public App(int uid, String packageName, String label) {
+            this.uid = uid;
+            this.packageName = packageName;
+            this.label = label == null || label.isEmpty() ? packageName : label;
+        }
+    }
+
+    /** One switch row. */
+    public static final class Row {
+        public final int uid;
+        public final App primary;
+        public final List<App> members;
+
+        Row(int uid, List<App> members) {
+            this.uid = uid;
+            this.members = Collections.unmodifiableList(members);
+            this.primary = members.get(0);
+        }
+
+        /** Other apps sharing this UID (and switch). */
+        public int othersCount() {
+            return members.size() - 1;
+        }
+    }
+
+    private NetworkAppRows() {}
+
+    public static List<Row> build(List<App> apps, Locale locale) {
+        final Collator collator = Collator.getInstance(locale == null ? Locale.ROOT : locale);
+        collator.setStrength(Collator.PRIMARY);
+        final Comparator<App> byLabel = (a, b) -> {
+            final int c = collator.compare(a.label, b.label);
+            return c != 0 ? c : a.packageName.compareTo(b.packageName);
+        };
+        final Map<Integer, List<App>> byUid = new LinkedHashMap<>();
+        for (App a : apps) {
+            byUid.computeIfAbsent(a.uid, k -> new ArrayList<>()).add(a);
+        }
+        final List<Row> rows = new ArrayList<>();
+        for (Map.Entry<Integer, List<App>> e : byUid.entrySet()) {
+            final List<App> members = new ArrayList<>(e.getValue());
+            members.sort(byLabel);
+            rows.add(new Row(e.getKey(), members));
+        }
+        rows.sort((a, b) -> byLabel.compare(a.primary, b.primary));
+        return rows;
+    }
+}
