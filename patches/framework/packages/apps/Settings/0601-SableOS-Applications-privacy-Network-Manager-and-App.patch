+package com.android.settings.applications.sable.model;
+
+/**
+ * The effective App-op mode of one permission for one app, as read in the app's own user.
+ * The Android layer maps AppOpsManager.MODE_* onto this; nothing here knows the numbers.
+ */
+public enum OpMode {
+    ALLOWED,
+    FOREGROUND,
+    DEFAULT,
+    IGNORED,
+    ERRORED,
+    /** The permission has no App-op: the runtime grant alone decides. */
+    NOT_APPLICABLE,
+    /** The op exists but could not be read. Never treated as access or as no access. */
+    UNKNOWN
+}
