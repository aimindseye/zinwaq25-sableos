+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+
+package com.android.settings.applications.sable.model;
+
+/**
+ * Sensitive access groups, in the order the compact app row lists them. Same groups and order
+ * as Sable Start's All Apps row (DESIGN-KF-D, ALL_APPS_PRIVACY_UX "Sensitive groups"), so an
+ * app reads the same in Sable Start and in Settings.
+ *
+ * <p>The five special-access groups go into a warning marker and the detail page; they join
+ * the compact row only when there is no everyday group to show.
+ */
+public enum PrivacyGroup {
+    LOCATION(false),
+    CAMERA(false),
+    MICROPHONE(false),
+    CONTACTS(false),
+    PHONE(false),
+    MESSAGES(false),
+    CALENDAR(false),
+    PHOTOS(false),
+    AUDIO(false),
+    NEARBY(false),
+    NOTIFICATIONS(false),
+
+    ACCESSIBILITY(true),
+    DEVICE_ADMIN(true),
+    INSTALL_APPS(true),
+    OVERLAY(true),
+    USAGE_ACCESS(true);
+
+    private final boolean mSpecial;
+
+    PrivacyGroup(boolean special) {
+        mSpecial = special;
+    }
+
+    /** True for special access (accessibility, device admin, install apps, overlay, usage). */
+    public boolean isSpecial() {
+        return mSpecial;
+    }
+}
