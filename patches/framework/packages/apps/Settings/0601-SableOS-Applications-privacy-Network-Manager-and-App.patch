+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+
+package com.android.settings.applications.sable.model;
+
+import java.util.Objects;
+
+/** Grant state of one permission the app requested, in the app's own user. */
+public final class PermissionFact {
+    public final boolean granted;
+    public final OpMode opMode;
+
+    public PermissionFact(boolean granted, OpMode opMode) {
+        this.granted = granted;
+        this.opMode = opMode == null ? OpMode.UNKNOWN : opMode;
+    }
+
+    public static PermissionFact granted() {
+        return new PermissionFact(true, OpMode.NOT_APPLICABLE);
+    }
+
+    public static PermissionFact denied() {
+        return new PermissionFact(false, OpMode.NOT_APPLICABLE);
+    }
+
+    /** TRUE = effective, FALSE = not effective, null = cannot tell. */
+    public Boolean effective() {
+        if (!granted) {
+            return Boolean.FALSE;
+        }
+        switch (opMode) {
+            case ALLOWED:
+            case FOREGROUND:
+            case DEFAULT:
+            case NOT_APPLICABLE:
+                return Boolean.TRUE;
+            case IGNORED:
+            case ERRORED:
+                return Boolean.FALSE;
+            default:
+                return null;
+        }
+    }
+
+    @Override
+    public boolean equals(Object o) {
+        if (!(o instanceof PermissionFact)) {
+            return false;
+        }
+        final PermissionFact f = (PermissionFact) o;
+        return granted == f.granted && opMode == f.opMode;
+    }
+
+    @Override
+    public int hashCode() {
+        return Objects.hash(granted, opMode);
+    }
+
+    @Override
+    public String toString() {
+        return (granted ? "granted" : "denied") + "/" + opMode;
+    }
+}
diff --git a/src/com/android/settings/applications/sable/model/PrivacyEvaluator.java b/src/com/android/settings/applications/sable/model/PrivacyEvaluator.java
new file mode 100644
index 00000000000..8daff5470c3
--- /dev/null
+++ b/src/com/android/settings/applications/sable/model/PrivacyEvaluator.java
@@ -0,0 +1,204 @@
+/*
+ * Copyright (C) 2026 The SableOS Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+
+package com.android.settings.applications.sable.model;
+
+import java.util.EnumMap;
+import java.util.LinkedHashSet;
+import java.util.Map;
+import java.util.Set;
+
+/**
+ * Decides which sensitive access may be shown for one app instance. A Java port of Sable
+ * Start's PrivacyEvaluator (DESIGN-KF-D) with the same rules, so the two surfaces agree:
+ *
+ * <ul>
+ *   <li>REQUESTED_PERMISSION_ONLY=INSUFFICIENT: a group needs an effective grant;
+ *   <li>an ignored/errored App-op cancels a grant; an op that could not be read makes the
+ *       group UNKNOWN, which is never shown as access;
+ *   <li>"approximate" location only when precise location is known to be off; "limited"
+ *       photos only when full photo access is known to be off;
+ *   <li>notifications count from Android 13, where the POST_NOTIFICATIONS grant is the
+ *       app-level switch;
+ *   <li>READ_EXTERNAL_STORAGE counts as photos and audio only for apps targeting 32 or lower;
+ *   <li>nothing is persisted.
+ * </ul>
+ */
+public final class PrivacyEvaluator {
+    public static final int SDK_TIRAMISU = 33;
+    public static final int SDK_UPSIDE_DOWN_CAKE = 34;
+
+    private PrivacyEvaluator() {}
+
+    public static AppPrivacy evaluate(PrivacyFacts facts) {
+        final Map<PrivacyGroup, GroupState> groups = new EnumMap<>(PrivacyGroup.class);
+        put(groups, PrivacyGroup.LOCATION, location(facts));
+        for (Map.Entry<PrivacyGroup, Set<String>> e
+                : PrivacyPermissions.RUNTIME_GROUPS.entrySet()) {
+            final Set<String> perms = new LinkedHashSet<>(e.getValue());
+            if (e.getKey() == PrivacyGroup.AUDIO) {
+                perms.addAll(legacyStorage(facts));
+            }
+            put(groups, e.getKey(), groupOf(facts, perms));
+        }
+        put(groups, PrivacyGroup.PHOTOS, photos(facts));
+        put(groups, PrivacyGroup.NOTIFICATIONS, notifications(facts));
+        if (Boolean.TRUE.equals(facts.accessibilityServiceEnabled)) {
+            groups.put(PrivacyGroup.ACCESSIBILITY, GroupState.ALLOWED);
+        }
+        if (Boolean.TRUE.equals(facts.activeDeviceAdmin)) {
+            groups.put(PrivacyGroup.DEVICE_ADMIN, GroupState.ALLOWED);
+        }
+        put(groups, PrivacyGroup.INSTALL_APPS, specialOp(facts.installAppsOp,
+                facts.permissions.get(PrivacyPermissions.REQUEST_INSTALL_PACKAGES)));
+        put(groups, PrivacyGroup.OVERLAY, specialOp(facts.overlayOp,
+                facts.permissions.get(PrivacyPermissions.SYSTEM_ALERT_WINDOW)));
+        put(groups, PrivacyGroup.USAGE_ACCESS, specialOp(facts.usageAccessOp,
+                facts.permissions.get(PrivacyPermissions.PACKAGE_USAGE_STATS)));
+        return new AppPrivacy(groups);
+    }
+
+    private static void put(Map<PrivacyGroup, GroupState> m, PrivacyGroup g, GroupState s) {
+        if (s != null) {
+            m.put(g, s);
+        }
+    }
+
+    /** Null when none of the permissions was requested. */
+    static GroupState groupOf(PrivacyFacts facts, Set<String> permissions) {
+        boolean requested = false;
+        boolean unknown = false;
+        for (String p : permissions) {
+            final PermissionFact f = facts.permissions.get(p);
+            if (f == null) {
+                continue;
+            }
+            requested = true;
+            final Boolean eff = f.effective();
+            if (Boolean.TRUE.equals(eff)) {
+                return GroupState.ALLOWED;
+            }
+            if (eff == null) {
+                unknown = true;
+            }
+        }
+        if (!requested) {
+            return null;
+        }
+        return unknown ? GroupState.UNKNOWN : GroupState.NOT_ALLOWED;
+    }
+
+    private static GroupState location(PrivacyFacts facts) {
+        final PermissionFact fine = facts.permissions.get(PrivacyPermissions.ACCESS_FINE_LOCATION);
+        final PermissionFact coarse =
+                facts.permissions.get(PrivacyPermissions.ACCESS_COARSE_LOCATION);
+        if (fine == null && coarse == null) {
+            return null;
+        }
+        final Boolean fineState = fine == null ? null : fine.effective();
+        final Boolean coarseState = coarse == null ? null : coarse.effective();
+        if (Boolean.TRUE.equals(fineState)) {
+            return GroupState.ALLOWED;
+        }
+        if (Boolean.TRUE.equals(coarseState) && fine != null && fineState == null) {
+            // Access is certain, precision is not: plain "Location".
+            return GroupState.ALLOWED;
+        }
+        if (Boolean.TRUE.equals(coarseState)) {
+            return GroupState.APPROXIMATE;
+        }
+        if (fine != null && fineState == null) {
+            return GroupState.UNKNOWN;
+        }
+        if (coarse != null && coarseState == null) {
+            return GroupState.UNKNOWN;
+        }
+        return GroupState.NOT_ALLOWED;
+    }
+
+    private static Set<String> legacyStorage(PrivacyFacts facts) {
+        final Set<String> s = new LinkedHashSet<>();
+        if (facts.deviceSdk < SDK_TIRAMISU || facts.targetSdk < SDK_TIRAMISU) {
+            s.add(PrivacyPermissions.READ_EXTERNAL_STORAGE);
+        }
+        return s;
+    }
+
+    private static GroupState photos(PrivacyFacts facts) {
+        final Set<String> full = new LinkedHashSet<>();
+        full.add(PrivacyPermissions.READ_MEDIA_IMAGES);
+        full.add(PrivacyPermissions.READ_MEDIA_VIDEO);
+        full.addAll(legacyStorage(facts));
+        final GroupState fullState = groupOf(facts, full);
+        final boolean selectedSupported = facts.deviceSdk >= SDK_UPSIDE_DOWN_CAKE;
+        final PermissionFact selectedFact = selectedSupported
+                ? facts.permissions.get(PrivacyPermissions.READ_MEDIA_VISUAL_USER_SELECTED)
+                : null;
+        final Boolean selected = selectedFact == null ? null : selectedFact.effective();
+        if (fullState == GroupState.ALLOWED) {
+            return GroupState.ALLOWED;
+        }
+        if (fullState == GroupState.UNKNOWN) {
+            return GroupState.UNKNOWN;
+        }
+        if (Boolean.TRUE.equals(selected)) {
+            return GroupState.LIMITED;
+        }
+        if (selectedFact != null && selected == null) {
+            return GroupState.UNKNOWN;
+        }
+        if (fullState == null && selectedFact == null) {
+            return null;
+        }
+        return GroupState.NOT_ALLOWED;
+    }
+
+    private static GroupState notifications(PrivacyFacts facts) {
+        if (facts.deviceSdk < SDK_TIRAMISU) {
+            return null;
+        }
+        final PermissionFact f = facts.permissions.get(PrivacyPermissions.POST_NOTIFICATIONS);
+        if (f == null) {
+            return null;
+        }
+        final Boolean eff = f.effective();
+        if (eff == null) {
+            return GroupState.UNKNOWN;
+        }
+        return eff ? GroupState.ALLOWED : GroupState.NOT_ALLOWED;
+    }
+
+    /** App-op backed special access: MODE_DEFAULT defers to the permission grant. */
+    private static GroupState specialOp(OpMode op, PermissionFact permission) {
+        if (permission == null) {
+            return null;
+        }
+        if (op == null || op == OpMode.UNKNOWN) {
+            return GroupState.UNKNOWN;
+        }
+        switch (op) {
+            case ALLOWED:
+            case FOREGROUND:
+                return GroupState.ALLOWED;
+            case DEFAULT:
+            case NOT_APPLICABLE:
+                return permission.granted ? GroupState.ALLOWED : GroupState.NOT_ALLOWED;
+            default:
+                return GroupState.NOT_ALLOWED;
+        }
+    }
+}
