+package com.android.settings.applications.sable.model;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.EnumMap;
+import java.util.List;
+import java.util.Map;
+
+/** Evaluated groups of one app instance. Groups that were not requested are absent. */
+public final class AppPrivacy {
+    private final Map<PrivacyGroup, GroupState> mGroups;
+
+    public AppPrivacy(Map<PrivacyGroup, GroupState> groups) {
+        final Map<PrivacyGroup, GroupState> m = new EnumMap<>(PrivacyGroup.class);
+        if (groups != null) {
+            m.putAll(groups);
+        }
+        mGroups = Collections.unmodifiableMap(m);
+    }
+
+    public Map<PrivacyGroup, GroupState> groups() {
+        return mGroups;
+    }
+
+    /** State of a group, or null when the app did not request it. */
+    public GroupState stateOf(PrivacyGroup group) {
+        return mGroups.get(group);
+    }
+
+    /** Groups with effective (full or partial) access, in design order. */
+    public List<PrivacyGroup> effective() {
+        final List<PrivacyGroup> out = new ArrayList<>();
+        for (Map.Entry<PrivacyGroup, GroupState> e : mGroups.entrySet()) {
+            if (e.getValue().isEffective()) {
+                out.add(e.getKey());
+            }
+        }
+        return out;
+    }
+
+    public boolean hasUnknown() {
+        return mGroups.containsValue(GroupState.UNKNOWN);
+    }
+}
diff --git a/src/com/android/settings/applications/sable/model/AppSecurityFacts.java b/src/com/android/settings/applications/sable/model/AppSecurityFacts.java
