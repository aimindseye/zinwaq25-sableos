+package com.android.settings.applications.sable.model;
+
+import java.util.EnumMap;
+import java.util.Map;
+
+/** English labels identical to Sable Start's All Apps row, for the host tests. */
+final class EnglishLabels implements PrivacyRow.Labels {
+    static final EnglishLabels INSTANCE = new EnglishLabels();
+
+    private static final Map<PrivacyGroup, String> NAMES = new EnumMap<>(PrivacyGroup.class);
+
+    static {
+        NAMES.put(PrivacyGroup.LOCATION, "Location");
+        NAMES.put(PrivacyGroup.CAMERA, "Camera");
+        NAMES.put(PrivacyGroup.MICROPHONE, "Microphone");
+        NAMES.put(PrivacyGroup.CONTACTS, "Contacts");
+        NAMES.put(PrivacyGroup.PHONE, "Phone");
+        NAMES.put(PrivacyGroup.MESSAGES, "Messages");
+        NAMES.put(PrivacyGroup.CALENDAR, "Calendar");
+        NAMES.put(PrivacyGroup.PHOTOS, "Photos");
+        NAMES.put(PrivacyGroup.AUDIO, "Audio");
+        NAMES.put(PrivacyGroup.NEARBY, "Nearby");
+        NAMES.put(PrivacyGroup.NOTIFICATIONS, "Notifications");
+        NAMES.put(PrivacyGroup.ACCESSIBILITY, "Accessibility");
+        NAMES.put(PrivacyGroup.DEVICE_ADMIN, "Device admin");
+        NAMES.put(PrivacyGroup.INSTALL_APPS, "Install apps");
+        NAMES.put(PrivacyGroup.OVERLAY, "Overlay");
+        NAMES.put(PrivacyGroup.USAGE_ACCESS, "Usage access");
+    }
+
+    @Override
+    public String group(PrivacyGroup group, GroupState state) {
+        if (state == GroupState.APPROXIMATE) {
+            return "Location approximate";
+        }
+        if (state == GroupState.LIMITED) {
+            return "Photos limited";
+        }
+        return NAMES.get(group);
+    }
+
+    @Override
+    public String prefix() {
+        return "permissions";
+    }
+
+    @Override
+    public String separator() {
+        return " · ";
+    }
+
+    @Override
+    public String more(int count) {
+        return "+" + count;
+    }
+
+    @Override
+    public String noneSensitive() {
+        return "permissions · none sensitive";
+    }
+
+    @Override
+    public String notConfirmed() {
+        return "permissions · see app info";
+    }
+
+    @Override
+    public String unavailable() {
+        return "permissions · unavailable";
+    }
+
+    @Override
+    public String warningMarker() {
+        return "⚠";
+    }
+
+    @Override
+    public String spokenEveryday(String joined) {
+        return "Permissions: " + joined;
+    }
+
+    @Override
+    public String spokenSpecial(String joined) {
+        return "Special access: " + joined;
+    }
+}
