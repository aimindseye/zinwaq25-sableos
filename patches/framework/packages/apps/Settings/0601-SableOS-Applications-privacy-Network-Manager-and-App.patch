+package com.android.settings.applications.sable.model;
+
+/** What the evaluator concluded for one requested group. */
+public enum GroupState {
+    /** Effective access. */
+    ALLOWED,
+    /** Coarse location granted and precise location known to be off (or never requested). */
+    APPROXIMATE,
+    /** Only the selected-photos grant (Android 14+), full photo access known to be off. */
+    LIMITED,
+    /** Requested, not effectively allowed. */
+    NOT_ALLOWED,
+    /** Requested, but the effective state could not be read: omitted, never inferred. */
+    UNKNOWN;
+
+    /** Full or partial effective access. */
+    public boolean isEffective() {
+        return this == ALLOWED || this == APPROXIMATE || this == LIMITED;
+    }
+}
diff --git a/src/com/android/settings/applications/sable/model/NativeCodeScan.java b/src/com/android/settings/applications/sable/model/NativeCodeScan.java
new file mode 100644
index 00000000000..7d7f67b3b2e
--- /dev/null
+++ b/src/com/android/settings/applications/sable/model/NativeCodeScan.java
@@ -0,0 +1,90 @@
+/*
+ * Copyright (C) 2026 The SableOS Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+
+package com.android.settings.applications.sable.model;
+
+import java.util.Collections;
+import java.util.Set;
+import java.util.TreeSet;
+
+/**
+ * Bounded inspection of APK entry names for packaged native code ({@code lib/<abi>/<name>.so}).
+ * The Android layer feeds the entry names of the base and split APKs. Work is bounded by
+ * {@link #MAX_APKS} files and {@link #MAX_ENTRIES} entries in total; when a bound is hit the
+ * result is marked truncated and reads "at least". If no APK could be opened the result is
+ * UNKNOWN, never "none".
+ */
+public final class NativeCodeScan {
+    public static final int MAX_APKS = 32;
+    public static final int MAX_ENTRIES = 100_000;
+
+    private final Set<String> mAbis = new TreeSet<>();
+    private final Set<String> mLibraries = new TreeSet<>();
+    private int mApksOpened;
+    private int mEntries;
+    private boolean mTruncated;
+
+    /** Whether another APK may be opened. */
+    public boolean acceptsApk() {
+        if (mApksOpened >= MAX_APKS) {
+            mTruncated = true;
+            return false;
+        }
+        return !mTruncated;
+    }
+
+    /** Records that an APK was opened. */
+    public void apkOpened() {
+        mApksOpened++;
+    }
+
+    /** Offers one entry name; returns false once the entry budget is used up. */
+    public boolean entry(String name) {
+        if (mEntries >= MAX_ENTRIES) {
+            mTruncated = true;
+            return false;
+        }
+        mEntries++;
+        if (name == null || !name.startsWith("lib/") || !name.endsWith(".so")) {
+            return true;
+        }
+        final String[] parts = name.split("/");
+        if (parts.length == 3 && !parts[1].isEmpty() && parts[2].length() > 3) {
+            mAbis.add(parts[1]);
+            mLibraries.add(parts[2]);
+        }
+        return true;
+    }
+
+    /** INFERRED when at least one APK was read, else UNKNOWN. */
+    public Evidence evidence() {
+        return mApksOpened > 0 ? Evidence.INFERRED : Evidence.UNKNOWN;
+    }
+
+    public boolean truncated() {
+        return mTruncated;
+    }
+
+    public Set<String> abis() {
+        return Collections.unmodifiableSet(mAbis);
+    }
+
+    /** Distinct library file names (one libfoo.so for several ABIs counts once). */
+    public Set<String> libraries() {
+        return Collections.unmodifiableSet(mLibraries);
+    }
+}
diff --git a/src/com/android/settings/applications/sable/model/NetworkAccessPolicy.java b/src/com/android/settings/applications/sable/model/NetworkAccessPolicy.java
new file mode 100644
index 00000000000..71e913488e0
--- /dev/null
+++ b/src/com/android/settings/applications/sable/model/NetworkAccessPolicy.java
@@ -0,0 +1,174 @@
+/*
+ * Copyright (C) 2026 The SableOS Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+
+package com.android.settings.applications.sable.model;
+
+/**
+ * Network Manager policy over the platform's existing per-UID network restrictions.
+ *
+ * <p>On LineageOS the Network permission is not revocable; the platform blocker is the
+ * NetworkPolicyManager UID policy LineageOS already enforces and already exposes in
+ * App info &gt; Mobile data &amp; Wi-Fi (POLICY_REJECT_ALL, _CELLULAR, _WIFI, _VPN). Network
+ * Manager is one more view of that same store (DUPLICATE_NETWORK_POLICY_STORE=NO): its single
+ * switch adds or removes only the "all networks" bit, and it reports the transport bits set
+ * elsewhere instead of hiding them. The bit values come from the Android layer through
+ * {@link Masks}, so nothing here hard-codes them.
+ */
+public final class NetworkAccessPolicy {
+
+    /** The platform's policy bits (NetworkPolicyManager.POLICY_*). */
+    public static final class Masks {
+        public final int rejectAll;
+        public final int rejectCellular;
+        public final int rejectWifi;
+        public final int rejectVpn;
+        public final int rejectMeteredBackground;
+
+        public Masks(int rejectAll, int rejectCellular, int rejectWifi, int rejectVpn,
+                int rejectMeteredBackground) {
+            this.rejectAll = rejectAll;
+            this.rejectCellular = rejectCellular;
+            this.rejectWifi = rejectWifi;
+            this.rejectVpn = rejectVpn;
+            this.rejectMeteredBackground = rejectMeteredBackground;
+        }
+    }
+
+    /** What the switch and summary of one app row show. */
+    public enum Summary {
+        /** No restriction bit set. */
+        ALLOWED,
+        /** Allowed, but some transports are blocked in App info (see the flags). */
+        PARTIAL,
+        /** The all-networks bit is set. */
+        BLOCKED,
+        /** Not an app UID (system/shared core UID): shown, never changed here. */
+        NOT_MANAGEABLE
+    }
+
+    /** Evaluated state of one UID. */
+    public static final class State {
+        public final Summary summary;
+        public final boolean blockedAll;
+        public final boolean blockedCellular;
+        public final boolean blockedWifi;
+        public final boolean blockedVpn;
+        public final boolean backgroundDataRestricted;
+
+        State(Summary summary, boolean all, boolean cellular, boolean wifi, boolean vpn,
+                boolean background) {
+            this.summary = summary;
+            blockedAll = all;
+            blockedCellular = cellular;
+            blockedWifi = wifi;
+            blockedVpn = vpn;
+            backgroundDataRestricted = background;
+        }
+
+        /** The switch: on = network access allowed (not blocked on all networks). */
+        public boolean switchChecked() {
+            return !blockedAll;
+        }
+
+        /** Number of transports (mobile data, Wi-Fi, VPN) blocked by App info bits. */
+        public int blockedTransportCount() {
+            return (blockedCellular ? 1 : 0) + (blockedWifi ? 1 : 0) + (blockedVpn ? 1 : 0);
+        }
+    }
+
+    /** One change to the UID policy: add or remove exactly these bits. */
+    public static final class Change {
+        public final boolean add;
+        public final int bits;
+
+        Change(boolean add, int bits) {
+            this.add = add;
+            this.bits = bits;
+        }
+    }
+
+    private NetworkAccessPolicy() {}
+
+    public static State evaluate(int uidPolicy, boolean manageableUid, Masks m) {
+        final boolean all = (uidPolicy & m.rejectAll) != 0;
+        final boolean cell = (uidPolicy & m.rejectCellular) != 0;
+        final boolean wifi = (uidPolicy & m.rejectWifi) != 0;
+        final boolean vpn = (uidPolicy & m.rejectVpn) != 0;
+        final boolean bg = (uidPolicy & m.rejectMeteredBackground) != 0;
+        final Summary s;
+        if (!manageableUid) {
+            s = Summary.NOT_MANAGEABLE;
+        } else if (all) {
+            s = Summary.BLOCKED;
+        } else if (cell || wifi || vpn || bg) {
+            s = Summary.PARTIAL;
+        } else {
+            s = Summary.ALLOWED;
+        }
+        return new State(s, all, cell, wifi, vpn, bg);
+    }
+
+    /**
+     * The change for the switch, or null when nothing may change (not an app UID, or the
+     * switch already shows the requested state). Only the all-networks bit is ever touched;
+     * transport bits from App info are left as they are.
+     */
+    public static Change changeFor(State current, boolean allow, Masks m) {
+        if (current.summary == Summary.NOT_MANAGEABLE || current.switchChecked() == allow) {
+            return null;
+        }
+        return new Change(!allow, m.rejectAll);
+    }
+
+    /** Applies a change to a policy value (what the platform will hold afterwards). */
+    public static int apply(int uidPolicy, Change change) {
+        if (change == null) {
+            return uidPolicy;
+        }
+        return change.add ? (uidPolicy | change.bits) : (uidPolicy & ~change.bits);
+    }
+
+    /**
+     * Blocking an app that delivers messages, mail or calls can silently break notifications,
+     * sync and sign-in (MOBILE_MANAGER_APP_CONTROLS_UX: CONFIRM_FOR_MESSAGING_APPS=YES), so
+     * blocking one asks first. Allowing never asks.
+     */
+    public static boolean needsConfirmation(boolean allow, boolean messagingApp) {
+        return !allow && messagingApp;
+    }
+
+    /**
+     * A messaging, mail or calling app for {@link #needsConfirmation}: it requests SMS or call
+     * permissions, or handles smsto:/mailto: links.
+     */
+    public static boolean isMessagingApp(java.util.Collection<String> requestedPermissions,
+            boolean handlesSmsTo, boolean handlesMailTo) {
+        if (handlesSmsTo || handlesMailTo) {
+            return true;
+        }
+        if (requestedPermissions == null) {
+            return false;
+        }
+        for (String p : requestedPermissions) {
+            if (PrivacyPermissions.RUNTIME_GROUPS.get(PrivacyGroup.MESSAGES).contains(p)
+                    || PrivacyPermissions.ANSWER_PHONE_CALLS.equals(p)) {
+                return true;
+            }
+        }
+        return false;
+    }
+}
