+++ b/src/com/android/settings/applications/sable/model/AppSecurityFacts.java
@@ -0,0 +1,101 @@
+/*
+ * Copyright (C) 2026 The SableOS Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+
+package com.android.settings.applications.sable.model;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+
+/** Small pure helpers for the App Security &amp; Privacy page. */
+public final class AppSecurityFacts {
+
+    /** How the package came to be on the device (from ApplicationInfo flags). */
+    public enum InstallClass {
+        SYSTEM_IMAGE,
+        UPDATED_SYSTEM_APP,
+        USER_INSTALLED
+    }
+
+    /** Services and receivers that ask for a powerful platform binding. */
+    public enum Elevated {
+        ACCESSIBILITY("android.permission.BIND_ACCESSIBILITY_SERVICE"),
+        NOTIFICATION_LISTENER("android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"),
+        VPN("android.permission.BIND_VPN_SERVICE"),
+        INPUT_METHOD("android.permission.BIND_INPUT_METHOD"),
+        AUTOFILL("android.permission.BIND_AUTOFILL_SERVICE"),
+        DEVICE_ADMIN("android.permission.BIND_DEVICE_ADMIN");
+
+        public final String bindPermission;
+
+        Elevated(String bindPermission) {
+            this.bindPermission = bindPermission;
+        }
+
+        /** The elevated kind a component permission declares, or null. */
+        public static Elevated of(String componentPermission) {
+            if (componentPermission == null) {
+                return null;
+            }
+            for (Elevated e : values()) {
+                if (e.bindPermission.equals(componentPermission)) {
+                    return e;
+                }
+            }
+            return null;
+        }
+    }
+
+    private AppSecurityFacts() {}
+
+    public static InstallClass installClass(boolean systemFlag, boolean updatedSystemFlag) {
+        if (updatedSystemFlag) {
+            return InstallClass.UPDATED_SYSTEM_APP;
+        }
+        return systemFlag ? InstallClass.SYSTEM_IMAGE : InstallClass.USER_INSTALLED;
+    }
+
+    /** "AB:CD:..." upper-case hex of a digest, or null for no digest. */
+    public static String hex(byte[] digest) {
+        if (digest == null || digest.length == 0) {
+            return null;
+        }
+        final StringBuilder sb = new StringBuilder(digest.length * 3);
+        for (int i = 0; i < digest.length; i++) {
+            if (i > 0) {
+                sb.append(':');
+            }
+            sb.append(String.format(Locale.ROOT, "%02X", digest[i] & 0xff));
+        }
+        return sb.toString();
+    }
+
+    /**
+     * Installer chain without repeats: installing, initiating, originating package. Nulls and
+     * empties are skipped; an empty list means the platform recorded none.
+     */
+    public static List<String> installerChain(String installing, String initiating,
+            String originating) {
+        final List<String> out = new ArrayList<>();
+        for (String s : new String[] {installing, initiating, originating}) {
+            if (s != null && !s.isEmpty() && !out.contains(s)) {
+                out.add(s);
+            }
+        }
+        return out;
+    }
+}
