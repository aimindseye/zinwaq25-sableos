+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+
+package com.android.settings.applications.sable.model;
+
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.EnumMap;
+import java.util.LinkedHashSet;
+import java.util.Map;
+import java.util.Set;
+
+/** Permission names per group (same table as Sable Start's PrivacyPermissions). */
+public final class PrivacyPermissions {
+    public static final String ACCESS_FINE_LOCATION = "android.permission.ACCESS_FINE_LOCATION";
+    public static final String ACCESS_COARSE_LOCATION =
+            "android.permission.ACCESS_COARSE_LOCATION";
+    public static final String ACCESS_BACKGROUND_LOCATION =
+            "android.permission.ACCESS_BACKGROUND_LOCATION";
+    public static final String CAMERA = "android.permission.CAMERA";
+    public static final String RECORD_AUDIO = "android.permission.RECORD_AUDIO";
+    public static final String READ_CONTACTS = "android.permission.READ_CONTACTS";
+    public static final String WRITE_CONTACTS = "android.permission.WRITE_CONTACTS";
+    public static final String GET_ACCOUNTS = "android.permission.GET_ACCOUNTS";
+    public static final String READ_PHONE_STATE = "android.permission.READ_PHONE_STATE";
+    public static final String READ_PHONE_NUMBERS = "android.permission.READ_PHONE_NUMBERS";
+    public static final String CALL_PHONE = "android.permission.CALL_PHONE";
+    public static final String ANSWER_PHONE_CALLS = "android.permission.ANSWER_PHONE_CALLS";
+    public static final String READ_CALL_LOG = "android.permission.READ_CALL_LOG";
+    public static final String WRITE_CALL_LOG = "android.permission.WRITE_CALL_LOG";
+    public static final String READ_SMS = "android.permission.READ_SMS";
+    public static final String RECEIVE_SMS = "android.permission.RECEIVE_SMS";
+    public static final String SEND_SMS = "android.permission.SEND_SMS";
+    public static final String RECEIVE_MMS = "android.permission.RECEIVE_MMS";
+    public static final String RECEIVE_WAP_PUSH = "android.permission.RECEIVE_WAP_PUSH";
+    public static final String READ_CALENDAR = "android.permission.READ_CALENDAR";
+    public static final String WRITE_CALENDAR = "android.permission.WRITE_CALENDAR";
+    public static final String READ_MEDIA_IMAGES = "android.permission.READ_MEDIA_IMAGES";
+    public static final String READ_MEDIA_VIDEO = "android.permission.READ_MEDIA_VIDEO";
+    public static final String READ_MEDIA_VISUAL_USER_SELECTED =
+            "android.permission.READ_MEDIA_VISUAL_USER_SELECTED";
+    public static final String READ_MEDIA_AUDIO = "android.permission.READ_MEDIA_AUDIO";
+    public static final String READ_EXTERNAL_STORAGE = "android.permission.READ_EXTERNAL_STORAGE";
+    public static final String BLUETOOTH_SCAN = "android.permission.BLUETOOTH_SCAN";
+    public static final String BLUETOOTH_CONNECT = "android.permission.BLUETOOTH_CONNECT";
+    public static final String BLUETOOTH_ADVERTISE = "android.permission.BLUETOOTH_ADVERTISE";
+    public static final String NEARBY_WIFI_DEVICES = "android.permission.NEARBY_WIFI_DEVICES";
+    public static final String UWB_RANGING = "android.permission.UWB_RANGING";
+    public static final String POST_NOTIFICATIONS = "android.permission.POST_NOTIFICATIONS";
+    public static final String SYSTEM_ALERT_WINDOW = "android.permission.SYSTEM_ALERT_WINDOW";
+    public static final String REQUEST_INSTALL_PACKAGES =
+            "android.permission.REQUEST_INSTALL_PACKAGES";
+    public static final String PACKAGE_USAGE_STATS = "android.permission.PACKAGE_USAGE_STATS";
+    public static final String INTERNET = "android.permission.INTERNET";
+
+    /** Runtime permissions per everyday group; location, photos and notifications are special-cased. */
+    public static final Map<PrivacyGroup, Set<String>> RUNTIME_GROUPS;
+
+    /** Every permission whose grant/op state the reader must fetch. */
+    public static final Set<String> ALL;
+
+    static {
+        final Map<PrivacyGroup, Set<String>> m = new EnumMap<>(PrivacyGroup.class);
+        m.put(PrivacyGroup.CAMERA, set(CAMERA));
+        m.put(PrivacyGroup.MICROPHONE, set(RECORD_AUDIO));
+        m.put(PrivacyGroup.CONTACTS, set(READ_CONTACTS, WRITE_CONTACTS, GET_ACCOUNTS));
+        m.put(PrivacyGroup.PHONE, set(READ_PHONE_STATE, READ_PHONE_NUMBERS, CALL_PHONE,
+                ANSWER_PHONE_CALLS, READ_CALL_LOG, WRITE_CALL_LOG));
+        m.put(PrivacyGroup.MESSAGES,
+                set(READ_SMS, RECEIVE_SMS, SEND_SMS, RECEIVE_MMS, RECEIVE_WAP_PUSH));
+        m.put(PrivacyGroup.CALENDAR, set(READ_CALENDAR, WRITE_CALENDAR));
+        m.put(PrivacyGroup.AUDIO, set(READ_MEDIA_AUDIO));
+        m.put(PrivacyGroup.NEARBY, set(BLUETOOTH_SCAN, BLUETOOTH_CONNECT, BLUETOOTH_ADVERTISE,
+                NEARBY_WIFI_DEVICES, UWB_RANGING));
+        RUNTIME_GROUPS = Collections.unmodifiableMap(m);
+
+        final Set<String> all = new LinkedHashSet<>();
+        for (Set<String> s : m.values()) {
+            all.addAll(s);
+        }
+        all.addAll(Arrays.asList(ACCESS_FINE_LOCATION, ACCESS_COARSE_LOCATION,
+                ACCESS_BACKGROUND_LOCATION, READ_MEDIA_IMAGES, READ_MEDIA_VIDEO,
+                READ_MEDIA_VISUAL_USER_SELECTED, READ_EXTERNAL_STORAGE, POST_NOTIFICATIONS,
+                SYSTEM_ALERT_WINDOW, REQUEST_INSTALL_PACKAGES, PACKAGE_USAGE_STATS));
+        ALL = Collections.unmodifiableSet(all);
+    }
+
+    private PrivacyPermissions() {}
+
+    private static Set<String> set(String... names) {
+        return Collections.unmodifiableSet(new LinkedHashSet<>(Arrays.asList(names)));
+    }
+
+    /** Permissions that belong to a group, for the detail page ("declared" column). */
+    public static Set<String> permissionsOf(PrivacyGroup group) {
+        switch (group) {
+            case LOCATION:
+                return set(ACCESS_FINE_LOCATION, ACCESS_COARSE_LOCATION,
+                        ACCESS_BACKGROUND_LOCATION);
+            case PHOTOS:
+                return set(READ_MEDIA_IMAGES, READ_MEDIA_VIDEO, READ_MEDIA_VISUAL_USER_SELECTED,
+                        READ_EXTERNAL_STORAGE);
+            case NOTIFICATIONS:
+                return set(POST_NOTIFICATIONS);
+            case INSTALL_APPS:
+                return set(REQUEST_INSTALL_PACKAGES);
+            case OVERLAY:
+                return set(SYSTEM_ALERT_WINDOW);
+            case USAGE_ACCESS:
+                return set(PACKAGE_USAGE_STATS);
+            case ACCESSIBILITY:
+            case DEVICE_ADMIN:
+                return Collections.emptySet();
+            default:
+                final Set<String> s = RUNTIME_GROUPS.get(group);
+                return s == null ? Collections.<String>emptySet() : s;
+        }
+    }
+}
diff --git a/src/com/android/settings/applications/sable/model/PrivacyRow.java b/src/com/android/settings/applications/sable/model/PrivacyRow.java
new file mode 100644
index 00000000000..c2a650f65cf
--- /dev/null
+++ b/src/com/android/settings/applications/sable/model/PrivacyRow.java
@@ -0,0 +1,182 @@
+/*
+ * Copyright (C) 2026 The SableOS Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+
+package com.android.settings.applications.sable.model;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+
+/**
+ * The one-line sensitive-access summary under an app name, and its spoken form. Same states,
+ * density and wording rules as Sable Start's All Apps row (DESIGN-KF-D):
+ *
+ * <pre>
+ * MAX_INLINE_PERMISSION_LABELS=3   EXCESS_LABELS=+N   RAW_PERMISSION_NAMES=NO
+ * PACKAGE_NAME=NO   UNKNOWN_ACCESS_STATE=DO_NOT_DISPLAY_AS_FACT
+ * </pre>
+ *
+ * Text comes from a {@link Labels} implementation, so Settings uses its localized resources
+ * and the host tests use the English wording Sable Start uses.
+ */
+public final class PrivacyRow {
+    public static final int MAX_INLINE_LABELS = 3;
+
+    /** What the row says. */
+    public enum State {
+        /** At least one effective group is listed. */
+        LABELS,
+        /** Every requested sensitive group is known and none is effectively allowed. */
+        NONE_SENSITIVE,
+        /** Nothing effective, but some requested group could not be read. */
+        NOT_CONFIRMED,
+        /** The app's permission state could not be read at all. */
+        UNAVAILABLE
+    }
+
+    /** Localized words for the row. */
+    public interface Labels {
+        /** Label of an effective group in its state (ALLOWED, APPROXIMATE or LIMITED). */
+        String group(PrivacyGroup group, GroupState state);
+
+        /** The row prefix ("permissions"), or "" for none. */
+        String prefix();
+
+        String separator();
+
+        /** "+N" for N folded labels. */
+        String more(int count);
+
+        String noneSensitive();
+
+        String notConfirmed();
+
+        String unavailable();
+
+        /** Warning marker put before the row when special access is effective ("⚠"). */
+        String warningMarker();
+
+        /** Spoken: "Permissions: a, b" for everyday groups. */
+        String spokenEveryday(String joined);
+
+        /** Spoken: "Special access: a, b". */
+        String spokenSpecial(String joined);
+    }
+
+    public final State state;
+    /** Inline groups, in design order. */
+    public final List<PrivacyGroup> inline;
+    /** Groups folded into "+N". */
+    public final int overflow;
+    /** Special-access groups carried by the warning marker instead of inline. */
+    public final List<PrivacyGroup> badge;
+    /** True when any special access is effective, inline or in the marker. */
+    public final boolean warning;
+
+    private final AppPrivacy mPrivacy;
+
+    private PrivacyRow(State state, List<PrivacyGroup> inline, int overflow,
+            List<PrivacyGroup> badge, boolean warning, AppPrivacy privacy) {
+        this.state = state;
+        this.inline = Collections.unmodifiableList(new ArrayList<>(inline));
+        this.overflow = overflow;
+        this.badge = Collections.unmodifiableList(new ArrayList<>(badge));
+        this.warning = warning;
+        mPrivacy = privacy;
+    }
+
+    /** Builds the compact row; {@code privacy == null} means the state could not be read. */
+    public static PrivacyRow of(AppPrivacy privacy) {
+        return of(privacy, MAX_INLINE_LABELS);
+    }
+
+    public static PrivacyRow of(AppPrivacy privacy, int maxInline) {
+        final List<PrivacyGroup> none = Collections.emptyList();
+        if (privacy == null) {
+            return new PrivacyRow(State.UNAVAILABLE, none, 0, none, false, null);
+        }
+        final List<PrivacyGroup> everyday = new ArrayList<>();
+        final List<PrivacyGroup> special = new ArrayList<>();
+        for (PrivacyGroup g : privacy.effective()) {
+            (g.isSpecial() ? special : everyday).add(g);
+        }
+        if (everyday.isEmpty() && special.isEmpty()) {
+            return new PrivacyRow(privacy.hasUnknown() ? State.NOT_CONFIRMED
+                    : State.NONE_SENSITIVE, none, 0, none, false, privacy);
+        }
+        final List<PrivacyGroup> inline = everyday.isEmpty() ? special : everyday;
+        final List<PrivacyGroup> badge = everyday.isEmpty() ? none : special;
+        final int limit = Math.max(1, Math.min(MAX_INLINE_LABELS, maxInline));
+        final int shown = Math.min(limit, inline.size());
+        return new PrivacyRow(State.LABELS, inline.subList(0, shown), inline.size() - shown,
+                badge, !special.isEmpty(), privacy);
+    }
+
+    /** The visible row text. */
+    public String text(Labels l) {
+        switch (state) {
+            case NONE_SENSITIVE:
+                return l.noneSensitive();
+            case NOT_CONFIRMED:
+                return l.notConfirmed();
+            case UNAVAILABLE:
+                return l.unavailable();
+            default:
+                break;
+        }
+        final StringBuilder sb = new StringBuilder();
+        if (warning && !l.warningMarker().isEmpty()) {
+            sb.append(l.warningMarker()).append(' ');
+        }
+        boolean first = true;
+        if (!l.prefix().isEmpty()) {
+            sb.append(l.prefix());
+            first = false;
+        }
+        for (PrivacyGroup g : inline) {
+            if (!first) {
+                sb.append(l.separator());
+            }
+            sb.append(l.group(g, mPrivacy.stateOf(g)));
+            first = false;
+        }
+        if (overflow > 0) {
+            sb.append(l.separator()).append(l.more(overflow));
+        }
+        return sb.toString();
+    }
+
+    /** Spoken text: names every group, including the folded ones and the marker's. */
+    public String spokenText(Labels l) {
+        if (state != State.LABELS) {
+            return text(l);
+        }
+        final List<String> everyday = new ArrayList<>();
+        final List<String> special = new ArrayList<>();
+        for (PrivacyGroup g : mPrivacy.effective()) {
+            (g.isSpecial() ? special : everyday).add(l.group(g, mPrivacy.stateOf(g)));
+        }
+        final List<String> parts = new ArrayList<>();
+        if (!everyday.isEmpty()) {
+            parts.add(l.spokenEveryday(String.join(", ", everyday)));
+        }
+        if (!special.isEmpty()) {
+            parts.add(l.spokenSpecial(String.join(", ", special)));
+        }
+        return String.join(". ", parts);
+    }
+}
