+
+
+package com.android.settings.applications.sable.model;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.Test;
+
+import java.util.Arrays;
+import java.util.Collections;
+
+/** Truthfulness rule shared with Sable Start: effective, current-user access only. */
+public class PrivacyEvaluatorTest {
+    private static final PermissionFact GRANTED = PermissionFact.granted();
+    private static final PermissionFact DENIED = PermissionFact.denied();
+
+    private static PermissionFact op(OpMode m) {
+        return new PermissionFact(true, m);
+    }
+
+    private static PrivacyFacts.Builder facts() {
+        return PrivacyFacts.builder(36, 36);
+    }
+
+    @Test
+    public void requestedButNotGrantedShowsNothing() {
+        final AppPrivacy p = PrivacyEvaluator.evaluate(facts()
+                .permission(PrivacyPermissions.CAMERA, DENIED)
+                .permission(PrivacyPermissions.RECORD_AUDIO, DENIED).build());
+        assertTrue(p.effective().isEmpty());
+        assertEquals(GroupState.NOT_ALLOWED, p.stateOf(PrivacyGroup.CAMERA));
+        assertFalse(p.hasUnknown());
+    }
+
+    @Test
+    public void notRequestedIsAbsent() {
+        final AppPrivacy p = PrivacyEvaluator.evaluate(facts().build());
+        assertTrue(p.groups().isEmpty());
+        assertNull(p.stateOf(PrivacyGroup.CAMERA));
+    }
+
+    @Test
+    public void grantedRuntimePermissionIsEffectiveInDesignOrder() {
+        final AppPrivacy p = PrivacyEvaluator.evaluate(facts()
+                .permission(PrivacyPermissions.READ_CONTACTS, GRANTED)
+                .permission(PrivacyPermissions.CAMERA, GRANTED).build());
+        assertEquals(Arrays.asList(PrivacyGroup.CAMERA, PrivacyGroup.CONTACTS), p.effective());
+    }
+
+    @Test
+    public void ignoredAppOpCancelsGrantAndForegroundCounts() {
+        final AppPrivacy p = PrivacyEvaluator.evaluate(facts()
+                .permission(PrivacyPermissions.CAMERA, op(OpMode.IGNORED))
+                .permission(PrivacyPermissions.RECORD_AUDIO, op(OpMode.FOREGROUND))
+                .permission(PrivacyPermissions.READ_CALENDAR, op(OpMode.ERRORED))
+                .permission(PrivacyPermissions.READ_SMS, op(OpMode.DEFAULT)).build());
+        assertEquals(Arrays.asList(PrivacyGroup.MICROPHONE, PrivacyGroup.MESSAGES),
+                p.effective());
+    }
+
+    @Test
+    public void unreadableAppOpIsUnknownNotGuessed() {
+        final AppPrivacy p = PrivacyEvaluator.evaluate(facts()
+                .permission(PrivacyPermissions.CAMERA, op(OpMode.UNKNOWN)).build());
+        assertTrue(p.effective().isEmpty());
+        assertEquals(GroupState.UNKNOWN, p.stateOf(PrivacyGroup.CAMERA));
+        assertTrue(p.hasUnknown());
+        final AppPrivacy mixed = PrivacyEvaluator.evaluate(facts()
+                .permission(PrivacyPermissions.READ_CONTACTS, op(OpMode.UNKNOWN))
+                .permission(PrivacyPermissions.WRITE_CONTACTS, GRANTED).build());
+        assertEquals(Collections.singletonList(PrivacyGroup.CONTACTS), mixed.effective());
+    }
+
+    @Test
+    public void locationApproximateOnlyWhenPreciseIsKnownOff() {
+        assertEquals(GroupState.APPROXIMATE, PrivacyEvaluator.evaluate(facts()
+                .permission(PrivacyPermissions.ACCESS_FINE_LOCATION, DENIED)
+                .permission(PrivacyPermissions.ACCESS_COARSE_LOCATION, GRANTED).build())
+                .stateOf(PrivacyGroup.LOCATION));
+        assertEquals(GroupState.ALLOWED, PrivacyEvaluator.evaluate(facts()
+                .permission(PrivacyPermissions.ACCESS_FINE_LOCATION, GRANTED)
+                .permission(PrivacyPermissions.ACCESS_COARSE_LOCATION, GRANTED).build())
+                .stateOf(PrivacyGroup.LOCATION));
+        assertEquals("precision unknown reads plain Location", GroupState.ALLOWED,
+                PrivacyEvaluator.evaluate(facts()
+                        .permission(PrivacyPermissions.ACCESS_FINE_LOCATION, op(OpMode.UNKNOWN))
+                        .permission(PrivacyPermissions.ACCESS_COARSE_LOCATION, GRANTED).build())
+                        .stateOf(PrivacyGroup.LOCATION));
+        assertEquals(GroupState.APPROXIMATE, PrivacyEvaluator.evaluate(facts()
+                .permission(PrivacyPermissions.ACCESS_COARSE_LOCATION, GRANTED).build())
+                .stateOf(PrivacyGroup.LOCATION));
+        assertEquals(GroupState.UNKNOWN, PrivacyEvaluator.evaluate(facts()
+                .permission(PrivacyPermissions.ACCESS_FINE_LOCATION, op(OpMode.UNKNOWN)).build())
+                .stateOf(PrivacyGroup.LOCATION));
+        assertEquals(GroupState.NOT_ALLOWED, PrivacyEvaluator.evaluate(facts()
+                .permission(PrivacyPermissions.ACCESS_FINE_LOCATION, DENIED)
+                .permission(PrivacyPermissions.ACCESS_COARSE_LOCATION, DENIED).build())
+                .stateOf(PrivacyGroup.LOCATION));
+    }
+
+    @Test
+    public void photosLimitedOnlyOnAndroid14WithSelectedPhotos() {
+        assertEquals(GroupState.LIMITED, PrivacyEvaluator.evaluate(facts()
+                .permission(PrivacyPermissions.READ_MEDIA_IMAGES, DENIED)
+                .permission(PrivacyPermissions.READ_MEDIA_VIDEO, DENIED)
+                .permission(PrivacyPermissions.READ_MEDIA_VISUAL_USER_SELECTED, GRANTED).build())
+                .stateOf(PrivacyGroup.PHOTOS));
+        assertEquals(GroupState.ALLOWED, PrivacyEvaluator.evaluate(facts()
+                .permission(PrivacyPermissions.READ_MEDIA_IMAGES, GRANTED).build())
+                .stateOf(PrivacyGroup.PHOTOS));
+        assertTrue(PrivacyEvaluator.evaluate(PrivacyFacts.builder(36, 33)
+                .permission(PrivacyPermissions.READ_MEDIA_VISUAL_USER_SELECTED, GRANTED).build())
+                .effective().isEmpty());
+    }
+
+    @Test
+    public void legacyStorageMeansMediaOnlyForOldTargets() {
+        assertEquals(Arrays.asList(PrivacyGroup.PHOTOS, PrivacyGroup.AUDIO),
+                PrivacyEvaluator.evaluate(PrivacyFacts.builder(29, 36)
+                        .permission(PrivacyPermissions.READ_EXTERNAL_STORAGE, GRANTED).build())
+                        .effective());
+        assertTrue(PrivacyEvaluator.evaluate(PrivacyFacts.builder(34, 36)
+                .permission(PrivacyPermissions.READ_EXTERNAL_STORAGE, GRANTED).build())
+                .effective().isEmpty());
+    }
+
+    @Test
+    public void notificationsNeedTheEffectiveGrant() {
+        assertFalse(PrivacyEvaluator.evaluate(facts()
+                .permission(PrivacyPermissions.POST_NOTIFICATIONS, DENIED).build())
+                .effective().contains(PrivacyGroup.NOTIFICATIONS));
+        assertEquals(Collections.singletonList(PrivacyGroup.NOTIFICATIONS),
+                PrivacyEvaluator.evaluate(facts()
+                        .permission(PrivacyPermissions.POST_NOTIFICATIONS, GRANTED).build())
+                        .effective());
+        assertNull(PrivacyEvaluator.evaluate(PrivacyFacts.builder(36, 32)
+                .permission(PrivacyPermissions.POST_NOTIFICATIONS, GRANTED).build())
+                .stateOf(PrivacyGroup.NOTIFICATIONS));
+    }
+
+    @Test
+    public void specialAccessUsesAppOpsAndKnownFlagsOnly() {
+        final AppPrivacy p = PrivacyEvaluator.evaluate(facts()
+                .permission(PrivacyPermissions.SYSTEM_ALERT_WINDOW, DENIED)
+                .permission(PrivacyPermissions.REQUEST_INSTALL_PACKAGES, DENIED)
+                .permission(PrivacyPermissions.PACKAGE_USAGE_STATS, GRANTED)
+                .accessibilityServiceEnabled(true)
+                .activeDeviceAdmin(null)
+                .overlayOp(OpMode.ALLOWED)
+                .installAppsOp(OpMode.DEFAULT)
+                .usageAccessOp(OpMode.IGNORED).build());
+        assertEquals(Arrays.asList(PrivacyGroup.ACCESSIBILITY, PrivacyGroup.OVERLAY),
+                p.effective());
+        assertNull(p.stateOf(PrivacyGroup.DEVICE_ADMIN));
+        assertEquals(GroupState.NOT_ALLOWED, p.stateOf(PrivacyGroup.INSTALL_APPS));
+        assertEquals(GroupState.NOT_ALLOWED, p.stateOf(PrivacyGroup.USAGE_ACCESS));
+    }
+
+    @Test
+    public void specialOpWithoutReadableModeIsUnknown() {
+        final AppPrivacy p = PrivacyEvaluator.evaluate(facts()
+                .permission(PrivacyPermissions.SYSTEM_ALERT_WINDOW, GRANTED).build());
+        assertEquals(GroupState.UNKNOWN, p.stateOf(PrivacyGroup.OVERLAY));
+        assertTrue(p.effective().isEmpty());
+    }
+
+    @Test
+    public void groupListMatchesSableStart() {
+        int everyday = 0;
+        for (PrivacyGroup g : PrivacyGroup.values()) {
+            if (!g.isSpecial()) {
+                everyday++;
+            }
+        }
+        assertEquals(11, everyday);
+        assertEquals(16, PrivacyGroup.values().length);
+        assertTrue(PrivacyPermissions.ALL.contains(PrivacyPermissions.POST_NOTIFICATIONS));
+        assertFalse("INTERNET is not a privacy group",
+                PrivacyPermissions.ALL.contains(PrivacyPermissions.INTERNET));
+    }
+}
