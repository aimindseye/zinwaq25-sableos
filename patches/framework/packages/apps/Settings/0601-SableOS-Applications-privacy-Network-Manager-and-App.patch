+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+
+package com.android.settings.applications.sable.model;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.Test;
+
+import java.util.Arrays;
+import java.util.Collections;
+
+/** App Security & Privacy: component exposure, bounded native scan, identity helpers. */
+public class AppSecurityModelTest {
+
+    @Test
+    public void componentExposureCountsAndNames() {
+        final ComponentExposure c = new ComponentExposure()
+                .add("org.example.MainActivity", true, true, false)
+                .add("org.example.Hidden", true, false, false)
+                .add("org.example.Guarded", false, true, true)
+                .add("Bare", true, true, false)
+                .add("org.example.Four", true, true, false)
+                .add("org.example.Five", true, true, false);
+        assertEquals(6, c.total());
+        assertEquals(5, c.enabled());
+        assertEquals(5, c.exported());
+        assertEquals(4, c.exportedUnguarded());
+        assertEquals(Arrays.asList("MainActivity", "Guarded", "Bare", "Four"), c.exportedNames());
+        assertEquals(1, c.unlistedExported());
+    }
+
+    @Test
+    public void emptyComponentsAreZero() {
+        final ComponentExposure c = new ComponentExposure();
+        assertEquals(0, c.total());
+        assertTrue(c.exportedNames().isEmpty());
+    }
+
+    @Test
+    public void nativeScanFindsAbisAndDistinctLibraries() {
+        final NativeCodeScan s = new NativeCodeScan();
+        assertTrue(s.acceptsApk());
+        s.apkOpened();
+        for (String n : new String[] {"classes.dex", "lib/arm64-v8a/libfoo.so",
+                "lib/armeabi-v7a/libfoo.so", "lib/arm64-v8a/libbar.so", "lib/x86/readme.txt",
+                "lib/.so", "assets/lib/x/libz.so", "lib/arm64-v8a/sub/libdeep.so"}) {
+            s.entry(n);
+        }
+        assertEquals(Evidence.INFERRED, s.evidence());
+        assertEquals(Arrays.asList("arm64-v8a", "armeabi-v7a"),
+                Arrays.asList(s.abis().toArray(new String[0])));
+        assertEquals(Arrays.asList("libbar.so", "libfoo.so"),
+                Arrays.asList(s.libraries().toArray(new String[0])));
+        assertFalse(s.truncated());
+    }
+
+    @Test
+    public void nativeScanWithNoApkIsUnknownNotNone() {
+        assertEquals(Evidence.UNKNOWN, new NativeCodeScan().evidence());
+    }
+
+    @Test
+    public void nativeScanIsBounded() {
+        final NativeCodeScan s = new NativeCodeScan();
+        s.apkOpened();
+        boolean more = true;
+        int offered = 0;
+        while (more) {
+            more = s.entry("assets/f" + offered);
+            offered++;
+        }
+        assertEquals(NativeCodeScan.MAX_ENTRIES + 1, offered);
+        assertTrue(s.truncated());
+        assertFalse(s.acceptsApk());
+
+        final NativeCodeScan apks = new NativeCodeScan();
+        for (int i = 0; i < NativeCodeScan.MAX_APKS; i++) {
+            assertTrue(apks.acceptsApk());
+            apks.apkOpened();
+        }
+        assertFalse(apks.acceptsApk());
+        assertTrue(apks.truncated());
+    }
+
+    @Test
+    public void installClass() {
+        assertEquals(AppSecurityFacts.InstallClass.USER_INSTALLED,
+                AppSecurityFacts.installClass(false, false));
+        assertEquals(AppSecurityFacts.InstallClass.SYSTEM_IMAGE,
+                AppSecurityFacts.installClass(true, false));
+        assertEquals(AppSecurityFacts.InstallClass.UPDATED_SYSTEM_APP,
+                AppSecurityFacts.installClass(true, true));
+    }
+
+    @Test
+    public void hexDigest() {
+        assertEquals("00:0A:FF", AppSecurityFacts.hex(new byte[] {0, 10, (byte) 0xff}));
+        assertNull(AppSecurityFacts.hex(new byte[0]));
+        assertNull(AppSecurityFacts.hex(null));
+    }
+
+    @Test
+    public void installerChainSkipsEmptiesAndRepeats() {
+        assertEquals(Arrays.asList("org.fdroid.fdroid", "com.android.shell"),
+                AppSecurityFacts.installerChain("org.fdroid.fdroid", "com.android.shell",
+                        "org.fdroid.fdroid"));
+        assertEquals(Collections.emptyList(), AppSecurityFacts.installerChain(null, "", null));
+    }
+
+    @Test
+    public void elevatedComponents() {
+        assertEquals(AppSecurityFacts.Elevated.VPN,
+                AppSecurityFacts.Elevated.of("android.permission.BIND_VPN_SERVICE"));
+        assertEquals(AppSecurityFacts.Elevated.DEVICE_ADMIN,
+                AppSecurityFacts.Elevated.of("android.permission.BIND_DEVICE_ADMIN"));
+        assertNull(AppSecurityFacts.Elevated.of("android.permission.CAMERA"));
+        assertNull(AppSecurityFacts.Elevated.of(null));
+    }
+
+    @Test
+    public void groupPermissionTableCoversEveryGroupButFlagBackedOnes() {
+        for (PrivacyGroup g : PrivacyGroup.values()) {
+            final boolean flagBacked =
+                    g == PrivacyGroup.ACCESSIBILITY || g == PrivacyGroup.DEVICE_ADMIN;
+            assertEquals(g.name(), flagBacked, PrivacyPermissions.permissionsOf(g).isEmpty());
+        }
+    }
+}
