+package com.android.settings.applications.sable.model;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.Test;
+
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.List;
+import java.util.Locale;
+
+/** Network Manager over the LineageOS per-UID restriction bits. */
+public class NetworkAccessPolicyTest {
+    // LineageOS 23.2 NetworkPolicyManager values (frameworks/base f4ed08a0).
+    static final int REJECT_METERED_BACKGROUND = 0x1;
+    static final int REJECT_WIFI = 0x8000;
+    static final int REJECT_CELLULAR = 0x10000;
+    static final int REJECT_VPN = 0x20000;
+    static final int REJECT_ALL = 0x40000;
+    private static final NetworkAccessPolicy.Masks M = new NetworkAccessPolicy.Masks(
+            REJECT_ALL, REJECT_CELLULAR, REJECT_WIFI, REJECT_VPN, REJECT_METERED_BACKGROUND);
+
+    @Test
+    public void noBitsIsAllowed() {
+        final NetworkAccessPolicy.State s = NetworkAccessPolicy.evaluate(0, true, M);
+        assertEquals(NetworkAccessPolicy.Summary.ALLOWED, s.summary);
+        assertTrue(s.switchChecked());
+    }
+
+    @Test
+    public void rejectAllIsBlockedAndSwitchOff() {
+        final NetworkAccessPolicy.State s = NetworkAccessPolicy.evaluate(REJECT_ALL, true, M);
+        assertEquals(NetworkAccessPolicy.Summary.BLOCKED, s.summary);
+        assertFalse(s.switchChecked());
+    }
+
+    @Test
+    public void transportBitsFromAppInfoAreReportedNotHidden() {
+        final NetworkAccessPolicy.State s =
+                NetworkAccessPolicy.evaluate(REJECT_CELLULAR | REJECT_VPN, true, M);
+        assertEquals(NetworkAccessPolicy.Summary.PARTIAL, s.summary);
+        assertTrue(s.switchChecked());
+        assertTrue(s.blockedCellular);
+        assertFalse(s.blockedWifi);
+        assertTrue(s.blockedVpn);
+        assertEquals(2, s.blockedTransportCount());
+        assertEquals(NetworkAccessPolicy.Summary.PARTIAL,
+                NetworkAccessPolicy.evaluate(REJECT_METERED_BACKGROUND, true, M).summary);
+    }
+
+    @Test
+    public void blockingTouchesOnlyTheAllNetworksBit() {
+        final int before = REJECT_WIFI | 0x4; // 0x4: POLICY_ALLOW_METERED_BACKGROUND, untouched
+        final NetworkAccessPolicy.State s = NetworkAccessPolicy.evaluate(before, true, M);
+        final NetworkAccessPolicy.Change block = NetworkAccessPolicy.changeFor(s, false, M);
+        assertTrue(block.add);
+        assertEquals(REJECT_ALL, block.bits);
+        final int after = NetworkAccessPolicy.apply(before, block);
+        assertEquals(before | REJECT_ALL, after);
+
+        final NetworkAccessPolicy.Change allow = NetworkAccessPolicy.changeFor(
+                NetworkAccessPolicy.evaluate(after, true, M), true, M);
+        assertFalse(allow.add);
+        assertEquals("allow restores exactly the previous policy", before,
+                NetworkAccessPolicy.apply(after, allow));
+    }
+
+    @Test
+    public void noChangeWhenAlreadyInStateOrNotAnAppUid() {
+        assertNull(NetworkAccessPolicy.changeFor(NetworkAccessPolicy.evaluate(0, true, M), true, M));
+        final NetworkAccessPolicy.State system = NetworkAccessPolicy.evaluate(0, false, M);
+        assertEquals(NetworkAccessPolicy.Summary.NOT_MANAGEABLE, system.summary);
+        assertNull(NetworkAccessPolicy.changeFor(system, false, M));
+        assertEquals(5, NetworkAccessPolicy.apply(5, null));
+    }
+
+    @Test
+    public void blockingAMessagingAppAsksFirst() {
+        assertTrue(NetworkAccessPolicy.needsConfirmation(false, true));
+        assertFalse(NetworkAccessPolicy.needsConfirmation(true, true));
+        assertFalse(NetworkAccessPolicy.needsConfirmation(false, false));
+    }
+
+    @Test
+    public void messagingAppDetection() {
+        assertTrue(NetworkAccessPolicy.isMessagingApp(
+                Collections.singletonList(PrivacyPermissions.RECEIVE_SMS), false, false));
+        assertTrue(NetworkAccessPolicy.isMessagingApp(
+                Collections.singletonList(PrivacyPermissions.ANSWER_PHONE_CALLS), false, false));
+        assertTrue(NetworkAccessPolicy.isMessagingApp(null, false, true));
+        assertTrue(NetworkAccessPolicy.isMessagingApp(null, true, false));
+        assertFalse(NetworkAccessPolicy.isMessagingApp(
+                Arrays.asList(PrivacyPermissions.INTERNET, PrivacyPermissions.CAMERA),
+                false, false));
+    }
+
+    @Test
+    public void sharedUidAppsShareOneSortedRow() {
+        final List<NetworkAppRows.Row> rows = NetworkAppRows.build(Arrays.asList(
+                new NetworkAppRows.App(10050, "org.example.zeta", "Zeta"),
+                new NetworkAppRows.App(10020, "org.example.shared.b", "beta tools"),
+                new NetworkAppRows.App(10020, "org.example.shared.a", "Alpha"),
+                new NetworkAppRows.App(10030, "org.example.nolabel", "")), Locale.ROOT);
+        assertEquals(3, rows.size());
+        assertEquals("Alpha", rows.get(0).primary.label);
+        assertEquals(1, rows.get(0).othersCount());
+        assertEquals("org.example.nolabel", rows.get(1).primary.label);
+        assertEquals("Zeta", rows.get(2).primary.label);
+        assertEquals(10050, rows.get(2).uid);
+    }
+}
