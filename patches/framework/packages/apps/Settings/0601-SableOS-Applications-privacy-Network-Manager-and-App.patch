+package com.android.settings.applications.sable.model;
+
+/**
+ * Where a fact on the App Security &amp; Privacy page comes from. Every row names its class so
+ * nothing reads as more certain than it is; UNKNOWN is shown instead of a guess.
+ */
+public enum Evidence {
+    /** Package metadata: manifest, signing block, flags. */
+    DECLARED,
+    /** Current Android policy state: permission grants, App-ops, power policy. */
+    ENFORCED,
+    /** State the platform recorded locally: install source, install and update times. */
+    OBSERVED,
+    /** Bounded local static inspection of the installed APK files. */
+    INFERRED,
+    /** The OS cannot support a reliable conclusion here. */
+    UNKNOWN
+}
