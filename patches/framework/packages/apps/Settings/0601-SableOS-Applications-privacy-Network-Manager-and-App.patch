+
+
+package com.android.settings.applications.sable.model;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+
+/**
+ * Exposure of one component type (activities, services, receivers or providers) from the
+ * parsed package metadata: total, enabled, exported, exported without a guarding permission,
+ * and the first few exported short names.
+ */
+public final class ComponentExposure {
+    public static final int MAX_NAMES = 4;
+
+    private int mTotal;
+    private int mEnabled;
+    private int mExported;
+    private int mExportedUnguarded;
+    private final List<String> mNames = new ArrayList<>();
+
+    /**
+     * Adds one component. {@code guarded} is true when a permission protects it (for a
+     * provider: a read or a write permission).
+     */
+    public ComponentExposure add(String className, boolean enabled, boolean exported,
+            boolean guarded) {
+        mTotal++;
+        if (enabled) {
+            mEnabled++;
+        }
+        if (exported) {
+            mExported++;
+            if (!guarded) {
+                mExportedUnguarded++;
+            }
+            if (mNames.size() < MAX_NAMES && className != null && !className.isEmpty()) {
+                final int dot = className.lastIndexOf('.');
+                mNames.add(dot >= 0 ? className.substring(dot + 1) : className);
+            }
+        }
+        return this;
+    }
+
+    public int total() {
+        return mTotal;
+    }
+
+    public int enabled() {
+        return mEnabled;
+    }
+
+    public int exported() {
+        return mExported;
+    }
+
+    public int exportedUnguarded() {
+        return mExportedUnguarded;
+    }
+
+    /** Short names of the first {@link #MAX_NAMES} exported components. */
+    public List<String> exportedNames() {
+        return Collections.unmodifiableList(mNames);
+    }
+
+    /** Exported components beyond the listed names. */
+    public int unlistedExported() {
+        return mExported - mNames.size();
+    }
+}
