\ No newline at end of file
diff --git a/src/com/android/settings/homepage/TopLevelSettings.java b/src/com/android/settings/homepage/TopLevelSettings.java
index 7a0e4c4..fa3d2cf 100644
--- a/src/com/android/settings/homepage/TopLevelSettings.java
+++ b/src/com/android/settings/homepage/TopLevelSettings.java
@@ -94,7 +94,13 @@
 
     @Override
     protected int getPreferenceScreenResId() {
-        return getPreferenceLayoutResId(getContext());
+        // Sable: BlackBerry 7 shows one flat Options-style list, BlackBerry 10 the ten groups.
+        final Context context = getContext();
+        if (context != null && "bb7".equals(android.provider.Settings.Secure.getString(
+                context.getContentResolver(), "sable_profile"))) {
+            return R.xml.top_level_settings_bb7;
+        }
+        return getPreferenceLayoutResId(context);
     }
 
     @Override
-- 
