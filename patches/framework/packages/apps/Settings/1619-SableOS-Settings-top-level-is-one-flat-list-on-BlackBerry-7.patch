+        android:key="top_level_support_category"
+        android:layout="@layout/settingslib_expressive_untitled_preference_category">
+
+        <com.android.settings.widget.HomepagePreference
+            android:icon="@drawable/ic_help_filled"
+            android:key="top_level_support"
+            android:order="10"
+            android:title="@string/page_tab_title_support"
+            android:summary="@string/support_summary"
+            settings:highlightableMenuKey="@string/menu_key_support"
+            settings:controller="com.android.settings.support.SupportPreferenceController"/>
+
+        <!-- SableOS: keyboard hint footer, only with a hardware keyboard. Not a focus target. -->
+        <Preference
+            android:key="sable_homepage_key_hint"
+            android:order="20"
+            android:summary="@string/sable_homepage_key_hint"
