+        android:icon="@drawable/ic_settings_emergency_filled"
+        android:order="60"
+        android:fragment="com.android.settings.emergency.EmergencyDashboardFragment"
+        settings:isPreferenceVisible="@bool/config_show_emergency_settings"/>
