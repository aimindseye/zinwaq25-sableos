+package com.android.settings.sable;
+
+import android.content.Context;
+
+import androidx.preference.ListPreference;
+import androidx.preference.Preference;
+
+import com.android.settings.core.BasePreferenceController;
+
+/**
+ * Settings > Display > Panel opacity (Profile and Theme board): 100, 90, 80, 70, 60 or 50 percent.
+ * Stored in the Sable appearance authority and read by Sable apps and the launcher.
+ */
+public class SablePanelOpacityPreferenceController extends BasePreferenceController
+        implements Preference.OnPreferenceChangeListener {
+
+    public SablePanelOpacityPreferenceController(Context context, String preferenceKey) {
+        super(context, preferenceKey);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return AVAILABLE;
+    }
+
+    @Override
+    public void updateState(Preference preference) {
+        super.updateState(preference);
+        if (preference instanceof ListPreference) {
+            ListPreference list = (ListPreference) preference;
+            list.setValue(String.valueOf(SableAppearanceProvider.readPanelOpacity(mContext)));
+            list.setSummary(list.getEntry());
+        }
+    }
+
+    @Override
+    public boolean onPreferenceChange(Preference preference, Object newValue) {
+        int percent;
+        try {
+            percent = Integer.parseInt(String.valueOf(newValue));
+        } catch (NumberFormatException e) {
+            return false;
+        }
+        boolean stored = SableAppearanceProvider.writePanelOpacity(mContext, percent);
+        if (stored && preference instanceof ListPreference) {
+            ListPreference list = (ListPreference) preference;
+            int index = list.findIndexOfValue(String.valueOf(newValue));
+            if (index >= 0) {
+                list.setSummary(list.getEntries()[index]);
+            }
+        }
+        return stored;
+    }
+}
