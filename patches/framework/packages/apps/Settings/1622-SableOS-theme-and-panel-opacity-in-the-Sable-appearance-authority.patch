+    public static boolean isValidTheme(String theme) {
+        return theme != null && Arrays.asList(THEMES).contains(theme);
+    }
+
+    /** A stored or requested theme, falling back to Sable when unknown. */
+    public static String normalizeTheme(String theme) {
+        return isValidTheme(theme) ? theme : DEFAULT_THEME;
+    }
+
+    /** The accent a theme starts with. */
+    public static String accentForTheme(String theme) {
+        switch (normalizeTheme(theme)) {
+            case "graphite":
+                return "gold";
+            case "harbor":
+                return "teal";
+            default:
+                return "blue";
+        }
+    }
+
+    /** The system mode a theme sets: Daylight is light, every other theme is dark. */
+    public static String modeForTheme(String theme) {
+        return "daylight".equals(normalizeTheme(theme)) ? MODE_LIGHT : MODE_DARK;
+    }
+
+    /** A stored or requested panel opacity, clamped to 50..100 and rounded to a step of 10. */
+    public static int normalizePanelOpacity(int percent) {
+        int clamped = Math.max(MIN_PANEL_OPACITY, Math.min(MAX_PANEL_OPACITY, percent));
+        return Math.round(clamped / 10f) * 10;
+    }
