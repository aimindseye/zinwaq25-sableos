+package com.android.settings.applications.sable;
+
+import android.content.Context;
+
+import com.android.settings.applications.AppStateBaseBridge;
+import com.android.settings.applications.sable.model.PrivacyEvaluator;
+import com.android.settings.applications.sable.model.PrivacyFacts;
+import com.android.settings.applications.sable.model.PrivacyRow;
+import com.android.settingslib.applications.ApplicationsState;
+import com.android.settingslib.applications.ApplicationsState.AppEntry;
+
+import java.util.List;
+
+/**
+ * Loads the sensitive-access row of every app in the main "All apps" list on the
+ * ApplicationsState background thread, so binding a row only formats a stored result
+ * (no binder call per row). ManageApplications already calls {@link #forceUpdate} for the
+ * app the user returns from, so a permission change in App info shows at once.
+ */
+public final class AppStateSablePrivacyBridge extends AppStateBaseBridge {
+
+    /** Stored in {@link AppEntry#extraInfo} for the main list. */
+    public static final class SablePrivacyInfo {
+        public final CharSequence text;
+        public final CharSequence spoken;
+
+        SablePrivacyInfo(CharSequence text, CharSequence spoken) {
+            this.text = text;
+            this.spoken = spoken;
+        }
+    }
+
+    private final SablePrivacyFactsReader mReader;
+    private final SablePrivacyLabels mLabels;
+
+    public AppStateSablePrivacyBridge(Context context, ApplicationsState appState,
+            Callback callback) {
+        super(appState, callback);
+        mReader = new SablePrivacyFactsReader(context);
+        mLabels = new SablePrivacyLabels(context);
+    }
+
+    @Override
+    protected void loadAllExtraInfo() {
+        mReader.reset();
+        final List<AppEntry> apps = mAppSession.getAllApps();
+        for (AppEntry app : apps) {
+            app.extraInfo = infoFor(app);
+        }
+    }
+
+    @Override
+    protected void updateExtraInfo(AppEntry app, String pkg, int uid) {
+        mReader.reset();
+        app.extraInfo = infoFor(app);
+    }
+
+    private SablePrivacyInfo infoFor(AppEntry app) {
+        final PrivacyFacts facts = mReader.read(app.info);
+        final PrivacyRow row = PrivacyRow.of(facts == null ? null
+                : PrivacyEvaluator.evaluate(facts));
+        return new SablePrivacyInfo(row.text(mLabels), row.spokenText(mLabels));
+    }
+}
diff --git a/src/com/android/settings/applications/sable/SablePrivacyFactsReader.java b/src/com/android/settings/applications/sable/SablePrivacyFactsReader.java
new file mode 100644
index 00000000000..75e09121549
--- /dev/null
+++ b/src/com/android/settings/applications/sable/SablePrivacyFactsReader.java
@@ -0,0 +1,186 @@
