+package com.android.settings.applications.sable;
+
+import android.app.AppOpsManager;
+import android.app.admin.DevicePolicyManager;
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.pm.ApplicationInfo;
+import android.content.pm.PackageInfo;
+import android.content.pm.PackageManager;
+import android.os.Build;
+import android.os.UserHandle;
+import android.text.TextUtils;
+import android.util.SparseArray;
+
+import com.android.settings.applications.sable.model.OpMode;
+import com.android.settings.applications.sable.model.PermissionFact;
+import com.android.settings.applications.sable.model.PrivacyFacts;
+import com.android.settings.applications.sable.model.PrivacyPermissions;
+import com.android.settingslib.accessibility.AccessibilityUtils;
+
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+
+/**
+ * Reads {@link PrivacyFacts} for one app instance in its own Android user from
+ * PackageManager (requested permissions and their grant flags), AppOpsManager, the enabled
+ * accessibility services and the active device admins. Nothing is cached beyond one load
+ * and nothing is persisted. Call from a background thread.
+ */
+public final class SablePrivacyFactsReader {
+    private final Context mContext;
+    private final AppOpsManager mAppOps;
+    private final DevicePolicyManager mDpm;
+    /** Per-user sets, valid for one load. */
+    private final SparseArray<Set<String>> mAccessibilityPackages = new SparseArray<>();
+    private final SparseArray<Set<String>> mAdminPackages = new SparseArray<>();
+
+    public SablePrivacyFactsReader(Context context) {
+        mContext = context.getApplicationContext() != null
+                ? context.getApplicationContext() : context;
+        mAppOps = mContext.getSystemService(AppOpsManager.class);
+        mDpm = mContext.getSystemService(DevicePolicyManager.class);
+    }
+
+    /** Forgets per-user state so the next read sees current settings. */
+    public void reset() {
+        mAccessibilityPackages.clear();
+        mAdminPackages.clear();
+    }
+
+    /** Facts for one app in its user, or null when its state cannot be read. */
+    public PrivacyFacts read(ApplicationInfo info) {
+        if (info == null || TextUtils.isEmpty(info.packageName)) {
+            return null;
+        }
+        final UserHandle user = UserHandle.getUserHandleForUid(info.uid);
+        final PackageInfo pi;
+        try {
+            final PackageManager pm = mContext.createContextAsUser(user, 0).getPackageManager();
+            pi = pm.getPackageInfo(info.packageName,
+                    PackageManager.PackageInfoFlags.of(PackageManager.GET_PERMISSIONS
+                            | PackageManager.MATCH_DISABLED_COMPONENTS
+                            | PackageManager.MATCH_UNINSTALLED_PACKAGES));
+        } catch (PackageManager.NameNotFoundException | RuntimeException e) {
+            return null;
+        }
+        final PrivacyFacts.Builder b = PrivacyFacts.builder(info.targetSdkVersion,
+                Build.VERSION.SDK_INT);
+        final String[] requested = pi.requestedPermissions;
+        final int[] flags = pi.requestedPermissionsFlags;
+        if (requested != null) {
+            for (int i = 0; i < requested.length; i++) {
+                final String perm = requested[i];
+                if (!PrivacyPermissions.ALL.contains(perm)) {
+                    continue;
+                }
+                final boolean granted = flags != null && i < flags.length
+                        && (flags[i] & PackageInfo.REQUESTED_PERMISSION_GRANTED) != 0;
+                b.permission(perm, new PermissionFact(granted, opModeFor(perm, info)));
+            }
+        }
+        final int userId = user.getIdentifier();
+        b.accessibilityServiceEnabled(accessibilityPackages(userId) == null ? null
+                : accessibilityPackages(userId).contains(info.packageName));
+        b.activeDeviceAdmin(adminPackages(userId) == null ? null
+                : adminPackages(userId).contains(info.packageName));
+        b.installAppsOp(op(AppOpsManager.OPSTR_REQUEST_INSTALL_PACKAGES, info));
+        b.overlayOp(op(AppOpsManager.OPSTR_SYSTEM_ALERT_WINDOW, info));
+        b.usageAccessOp(op(AppOpsManager.OPSTR_GET_USAGE_STATS, info));
+        return b.build();
+    }
+
+    private OpMode opModeFor(String permission, ApplicationInfo info) {
+        final String opStr = AppOpsManager.permissionToOp(permission);
+        if (opStr == null) {
+            return OpMode.NOT_APPLICABLE;
+        }
+        return op(opStr, info);
+    }
+
+    private OpMode op(String opStr, ApplicationInfo info) {
+        if (mAppOps == null) {
+            return OpMode.UNKNOWN;
+        }
+        try {
+            return toOpMode(mAppOps.unsafeCheckOpNoThrow(opStr, info.uid, info.packageName));
+        } catch (RuntimeException e) {
+            return OpMode.UNKNOWN;
+        }
+    }
+
+    /** Maps AppOpsManager.MODE_* onto the model. */
+    public static OpMode toOpMode(int mode) {
+        switch (mode) {
+            case AppOpsManager.MODE_ALLOWED:
+                return OpMode.ALLOWED;
+            case AppOpsManager.MODE_FOREGROUND:
+                return OpMode.FOREGROUND;
+            case AppOpsManager.MODE_DEFAULT:
+                return OpMode.DEFAULT;
+            case AppOpsManager.MODE_IGNORED:
+                return OpMode.IGNORED;
+            case AppOpsManager.MODE_ERRORED:
+                return OpMode.ERRORED;
+            default:
+                return OpMode.UNKNOWN;
+        }
+    }
+
+    private Set<String> accessibilityPackages(int userId) {
+        if (mAccessibilityPackages.indexOfKey(userId) < 0) {
+            Set<String> pkgs;
+            try {
+                pkgs = new HashSet<>();
+                for (ComponentName cn
+                        : AccessibilityUtils.getEnabledServicesFromSettings(mContext, userId)) {
+                    pkgs.add(cn.getPackageName());
+                }
+            } catch (RuntimeException e) {
+                pkgs = null;
+            }
+            mAccessibilityPackages.put(userId, pkgs);
+        }
+        return mAccessibilityPackages.get(userId);
+    }
+
+    private Set<String> adminPackages(int userId) {
+        if (mAdminPackages.indexOfKey(userId) < 0) {
+            Set<String> pkgs;
+            try {
+                pkgs = new HashSet<>();
+                final List<ComponentName> admins =
+                        mDpm == null ? null : mDpm.getActiveAdminsAsUser(userId);
+                if (mDpm == null) {
+                    pkgs = null;
+                } else if (admins != null) {
+                    for (ComponentName cn : admins) {
+                        pkgs.add(cn.getPackageName());
+                    }
+                }
+            } catch (RuntimeException e) {
+                pkgs = null;
+            }
+            mAdminPackages.put(userId, pkgs);
+        }
+        return mAdminPackages.get(userId);
+    }
+}
