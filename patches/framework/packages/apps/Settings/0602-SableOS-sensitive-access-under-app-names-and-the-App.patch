+package com.android.settings.applications.sable;
+
+import android.content.Context;
+import android.content.res.Resources;
+
+import com.android.settings.R;
+import com.android.settings.applications.sable.model.GroupState;
+import com.android.settings.applications.sable.model.PrivacyGroup;
+import com.android.settings.applications.sable.model.PrivacyRow;
+
+/** Localized words for the sensitive-access row and the App Security page. */
+public final class SablePrivacyLabels implements PrivacyRow.Labels {
+    private final Resources mRes;
+
+    public SablePrivacyLabels(Context context) {
+        mRes = context.getResources();
+    }
+
+    @Override
+    public String group(PrivacyGroup group, GroupState state) {
+        if (state == GroupState.APPROXIMATE) {
+            return mRes.getString(R.string.sable_privacy_location_approximate);
+        }
+        if (state == GroupState.LIMITED) {
+            return mRes.getString(R.string.sable_privacy_photos_limited);
+        }
+        return mRes.getString(groupRes(group));
+    }
+
+    /** Plain group name. */
+    public static int groupRes(PrivacyGroup group) {
+        switch (group) {
+            case LOCATION:
+                return R.string.sable_privacy_group_location;
+            case CAMERA:
+                return R.string.sable_privacy_group_camera;
+            case MICROPHONE:
+                return R.string.sable_privacy_group_microphone;
+            case CONTACTS:
+                return R.string.sable_privacy_group_contacts;
+            case PHONE:
+                return R.string.sable_privacy_group_phone;
+            case MESSAGES:
+                return R.string.sable_privacy_group_messages;
+            case CALENDAR:
+                return R.string.sable_privacy_group_calendar;
+            case PHOTOS:
+                return R.string.sable_privacy_group_photos;
+            case AUDIO:
+                return R.string.sable_privacy_group_audio;
+            case NEARBY:
+                return R.string.sable_privacy_group_nearby;
+            case NOTIFICATIONS:
+                return R.string.sable_privacy_group_notifications;
+            case ACCESSIBILITY:
+                return R.string.sable_privacy_group_accessibility;
+            case DEVICE_ADMIN:
+                return R.string.sable_privacy_group_device_admin;
+            case INSTALL_APPS:
+                return R.string.sable_privacy_group_install_apps;
+            case OVERLAY:
+                return R.string.sable_privacy_group_overlay;
+            default:
+                return R.string.sable_privacy_group_usage_access;
+        }
+    }
+
+    @Override
+    public String prefix() {
+        return mRes.getString(R.string.sable_privacy_row_prefix);
+    }
+
+    @Override
+    public String separator() {
+        return mRes.getString(R.string.sable_privacy_row_separator);
+    }
+
+    @Override
+    public String more(int count) {
+        return mRes.getString(R.string.sable_privacy_row_more, count);
+    }
+
+    @Override
+    public String noneSensitive() {
+        return mRes.getString(R.string.sable_privacy_row_none_sensitive);
+    }
+
+    @Override
+    public String notConfirmed() {
+        return mRes.getString(R.string.sable_privacy_row_not_confirmed);
+    }
+
+    @Override
+    public String unavailable() {
