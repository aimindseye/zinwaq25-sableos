+
+package com.android.settings.applications.sable.model;
+
+import java.time.DayOfWeek;
+import java.time.LocalDate;
+import java.time.LocalDateTime;
+import java.time.LocalTime;
+import java.util.Collection;
+import java.util.Set;
+import java.util.TreeSet;
+
+/**
+ * Student mode's time window (MOBILE_MANAGER_APP_CONTROLS_UX "Time: Weekdays 08:00-17:00"):
+ * the days it runs and a start and end time. An end at or before the start runs past
+ * midnight into the next day (22:00-06:00 on Monday is Monday 22:00 to Tuesday 06:00).
+ * Stored as {@code days=1,2,3,4,5;start=480;end=1020} (ISO days, Monday 1; minutes of the
+ * day). Damaged values fall back to the default, weekdays 08:00-17:00.
+ */
+public final class StudentSchedule {
+    public static final int MINUTES_PER_DAY = 24 * 60;
+    public static final StudentSchedule DEFAULT = new StudentSchedule(
+            daysOf(1, 2, 3, 4, 5), 8 * 60, 17 * 60);
+
+    /** ISO days of week (1 Monday ... 7 Sunday) the window starts on. */
+    public final Set<Integer> days;
+    public final int startMinute;
+    public final int endMinute;
+
+    public StudentSchedule(Set<Integer> days, int startMinute, int endMinute) {
+        final Set<Integer> clean = new TreeSet<>();
+        if (days != null) {
+            for (Integer d : days) {
+                if (d != null && d >= 1 && d <= 7) {
+                    clean.add(d);
+                }
+            }
+        }
+        this.days = java.util.Collections.unmodifiableSet(clean);
+        this.startMinute = clampMinute(startMinute);
+        this.endMinute = clampMinute(endMinute);
+    }
+
+    private static Set<Integer> daysOf(Integer... d) {
+        return new TreeSet<>(java.util.Arrays.asList(d));
+    }
+
+    private static int clampMinute(int m) {
+        return m < 0 ? 0 : (m >= MINUTES_PER_DAY ? MINUTES_PER_DAY - 1 : m);
+    }
+
+    /** True when the window runs past midnight. */
+    public boolean overnight() {
+        return endMinute <= startMinute;
+    }
+
+    /** Length of one window in minutes (an equal start and end is a full day). */
+    public int lengthMinutes() {
+        return overnight() ? MINUTES_PER_DAY - startMinute + endMinute : endMinute - startMinute;
+    }
+
+    public StudentSchedule withDays(Collection<Integer> newDays) {
+        return new StudentSchedule(newDays == null ? null : new TreeSet<>(newDays),
+                startMinute, endMinute);
+    }
+
+    public StudentSchedule withStart(int minute) {
+        return new StudentSchedule(days, minute, endMinute);
+    }
+
+    public StudentSchedule withEnd(int minute) {
+        return new StudentSchedule(days, startMinute, minute);
+    }
+
+    /** Whether {@code now} falls inside a window. */
+    public boolean isActive(LocalDateTime now) {
+        if (days.isEmpty() || now == null) {
+            return false;
+        }
+        final int minute = now.getHour() * 60 + now.getMinute();
+        final int today = now.getDayOfWeek().getValue();
+        final int yesterday = today == 1 ? 7 : today - 1;
+        if (!overnight()) {
+            return days.contains(today) && minute >= startMinute && minute < endMinute;
+        }
+        return (days.contains(today) && minute >= startMinute)
+                || (days.contains(yesterday) && minute < endMinute);
+    }
+
+    /**
+     * The next time after {@code now} at which {@link #isActive} changes, or null when it
+     * never does (no days chosen).
+     */
+    public LocalDateTime nextChange(LocalDateTime now) {
+        if (days.isEmpty() || now == null) {
+            return null;
+        }
+        final LocalDate base = now.toLocalDate();
+        LocalDateTime best = null;
+        // Windows that start from yesterday up to 8 days ahead cover every boundary.
+        for (int offset = -1; offset <= 8; offset++) {
+            final LocalDate day = base.plusDays(offset);
+            if (!days.contains(day.getDayOfWeek().getValue())) {
+                continue;
+            }
+            final LocalDateTime start = LocalDateTime.of(day, toTime(startMinute));
+            final LocalDateTime end = start.plusMinutes(lengthMinutes());
+            for (LocalDateTime t : new LocalDateTime[] {start, end}) {
+                if (t.isAfter(now) && isActive(t) != isActive(now)
+                        && (best == null || t.isBefore(best))) {
+                    best = t;
+                }
+            }
+        }
+        return best;
+    }
+
+    private static LocalTime toTime(int minute) {
+        return LocalTime.of(minute / 60, minute % 60);
+    }
+
+    /** "HH:MM" for a minute of the day. */
+    public static String clock(int minute) {
+        final int m = clampMinute(minute);
+        return String.format(java.util.Locale.ROOT, "%02d:%02d", m / 60, m % 60);
+    }
+
+    /** True for Monday to Friday exactly. */
+    public boolean isWeekdays() {
+        return days.equals(daysOf(1, 2, 3, 4, 5));
+    }
+
+    public String format() {
+        final StringBuilder sb = new StringBuilder("days=");
+        boolean first = true;
+        for (int d : days) {
+            if (!first) {
+                sb.append(',');
+            }
+            sb.append(d);
+            first = false;
+        }
+        return sb.append(";start=").append(startMinute).append(";end=").append(endMinute)
+                .toString();
+    }
+
+    public static StudentSchedule parse(String stored) {
+        if (stored == null || stored.trim().isEmpty()) {
+            return DEFAULT;
+        }
+        Set<Integer> d = null;
+        Integer start = null;
+        Integer end = null;
+        try {
+            for (String part : stored.split(";")) {
+                final int eq = part.indexOf('=');
+                if (eq < 0) {
+                    return DEFAULT;
+                }
+                final String key = part.substring(0, eq).trim();
+                final String value = part.substring(eq + 1).trim();
+                if ("days".equals(key)) {
+                    d = new TreeSet<>();
+                    for (String n : value.split(",")) {
+                        if (!n.trim().isEmpty()) {
+                            final int day = Integer.parseInt(n.trim());
+                            if (day < 1 || day > 7) {
+                                return DEFAULT;
+                            }
+                            d.add(day);
+                        }
+                    }
+                } else if ("start".equals(key)) {
+                    start = Integer.parseInt(value);
+                } else if ("end".equals(key)) {
+                    end = Integer.parseInt(value);
+                }
+            }
+        } catch (NumberFormatException e) {
+            return DEFAULT;
+        }
+        if (d == null || start == null || end == null || start < 0 || end < 0
+                || start >= MINUTES_PER_DAY || end >= MINUTES_PER_DAY) {
+            return DEFAULT;
+        }
+        return new StudentSchedule(d, start, end);
+    }
+
+    /**
+     * The apps Student mode pauses: launcher apps not on the allow list and not ones the phone
+     * needs.
+     */
+    public static Set<String> blocked(Collection<String> launcherApps, Set<String> allowed,
+            Set<String> neverPause) {
+        final Set<String> out = new TreeSet<>();
+        if (launcherApps == null) {
+            return out;
+        }
+        for (String pkg : launcherApps) {
+            if (PackageSet.isValidPackageName(pkg)
+                    && (allowed == null || !allowed.contains(pkg))
+                    && (neverPause == null || !neverPause.contains(pkg))) {
+                out.add(pkg);
+            }
+        }
+        return out;
+    }
+
+    /** Used by the Android layer for day labels. */
+    public static DayOfWeek day(int iso) {
+        return DayOfWeek.of(iso);
+    }
+}
diff --git a/tests/sable-apps/src/com/android/settings/applications/sable/model/AppControlCenterModelTest.java b/tests/sable-apps/src/com/android/settings/applications/sable/model/AppControlCenterModelTest.java
