+package com.android.settings.applications.sable.model;
+
+import java.util.Collections;
+import java.util.Map;
+import java.util.Set;
+import java.util.TreeMap;
+
+/**
+ * Every app Settings pauses goes through one platform mechanism, package suspension
+ * ({@code PackageManager.setPackagesSuspended}), and Android keeps one suspension per
+ * suspending package. Freezer, Student mode and Focus mode therefore share one target set:
+ * an app stays suspended while any of them wants it, and is released only when none does.
+ * Without this, Focus mode ending would unfreeze a frozen app.
+ *
+ * <p>{@link FocusModePolicy#plan} turns the target set into suspend and release lists; only
+ * packages Settings itself suspended are ever released.
+ */
+public final class AppSuspensions {
+
+    /** Why Settings pauses an app, strongest first (the one the App Control Center shows). */
+    public enum Reason {
+        /** Frozen in the Freezer: until the user unfreezes it. */
+        FROZEN,
+        /** Not on the Student mode allow list while Student mode is on. */
+        STUDENT,
+        /** Chosen to pause while Focus mode is on. */
+        FOCUS
+    }
+
+    private AppSuspensions() {}
+
+    /**
+     * The apps Settings should hold suspended now, each with its strongest reason.
+     *
+     * @param frozen apps frozen in the Freezer
+     * @param focusActive whether Focus mode is on
+     * @param focusChosen apps chosen to pause during Focus mode
+     * @param studentActive whether Student mode is on
+     * @param studentBlocked apps Student mode pauses (launcher apps not on its allow list)
+     * @param neverPause apps that must never be suspended (Settings, home, dialer, SMS, keyboard)
+     */
+    public static Map<String, Reason> targets(Set<String> frozen, boolean focusActive,
+            Set<String> focusChosen, boolean studentActive, Set<String> studentBlocked,
+            Set<String> neverPause) {
+        final Map<String, Reason> out = new TreeMap<>();
+        add(out, focusActive ? focusChosen : null, Reason.FOCUS, neverPause);
+        add(out, studentActive ? studentBlocked : null, Reason.STUDENT, neverPause);
+        add(out, frozen, Reason.FROZEN, neverPause);
+        return out;
+    }
+
+    /** Suspend and release lists that make the platform match {@code targets}. */
+    public static FocusModePolicy.Plan plan(Map<String, Reason> targets,
+            Set<String> heldBySettings, Set<String> neverPause) {
+        return FocusModePolicy.plan(true,
+                targets == null ? Collections.<String>emptySet() : targets.keySet(),
+                heldBySettings, neverPause);
+    }
+
+    // Later calls overwrite earlier ones, so callers add the weakest reason first.
+    private static void add(Map<String, Reason> out, Set<String> packages, Reason reason,
+            Set<String> neverPause) {
+        if (packages == null) {
+            return;
+        }
+        for (String pkg : packages) {
+            if (PackageSet.isValidPackageName(pkg)
+                    && (neverPause == null || !neverPause.contains(pkg))) {
+                out.put(pkg, reason);
+            }
+        }
+    }
+}
