+
+package com.android.settings.applications.sable.model;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.Test;
+
+import java.time.LocalDateTime;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.Set;
+import java.util.TreeSet;
+
+/** Mobile Manager: App Control Center rows, Freezer/Student/Focus suspensions, Student window. */
+public class AppControlCenterModelTest {
+
+    private static Set<String> set(String... names) {
+        return new TreeSet<>(Arrays.asList(names));
+    }
+
+    // 2026-10-19 is a Monday.
+    private static LocalDateTime at(int day, int hour, int minute) {
+        return LocalDateTime.of(2026, 10, 18 + day, hour, minute);
+    }
+
+    // --- AppSuspensions ---
+
+    @Test
+    public void focusEndingKeepsFrozenAppsSuspended() {
+        final Set<String> frozen = set("com.game");
+        final Set<String> focus = set("com.game", "com.social");
+        final Map<String, AppSuspensions.Reason> on = AppSuspensions.targets(frozen, true, focus,
+                false, null, set());
+        assertEquals(AppSuspensions.Reason.FROZEN, on.get("com.game"));
+        assertEquals(AppSuspensions.Reason.FOCUS, on.get("com.social"));
+        final Map<String, AppSuspensions.Reason> off = AppSuspensions.targets(frozen, false,
+                focus, false, null, set());
+        final FocusModePolicy.Plan plan = AppSuspensions.plan(off, on.keySet(), set());
+        assertEquals(set(), plan.suspend);
+        assertEquals(set("com.social"), plan.release);
+    }
+
+    @Test
+    public void studentOutranksFocusAndNeverPauseWins() {
+        final Map<String, AppSuspensions.Reason> t = AppSuspensions.targets(set(), true,
+                set("com.a", "com.dialer"), true, set("com.a", "com.b"), set("com.dialer"));
+        assertEquals(AppSuspensions.Reason.STUDENT, t.get("com.a"));
+        assertEquals(AppSuspensions.Reason.STUDENT, t.get("com.b"));
+        assertNull(t.get("com.dialer"));
+        assertEquals(2, t.size());
+    }
+
+    @Test
+    public void planNeverReleasesOtherSuspenders() {
+        final FocusModePolicy.Plan plan = AppSuspensions.plan(
+                AppSuspensions.targets(set("com.x"), false, null, false, null, null),
+                set("com.held"), null);
+        assertEquals(set("com.x"), plan.suspend);
+        assertEquals(set("com.held"), plan.release);
+        assertTrue(AppSuspensions.plan(null, set(), null).isEmpty());
+    }
+
+    // --- StudentSchedule ---
+
+    @Test
+    public void defaultIsWeekdaysEightToFive() {
+        final StudentSchedule s = StudentSchedule.DEFAULT;
+        assertTrue(s.isWeekdays());
+        assertEquals("08:00", StudentSchedule.clock(s.startMinute));
+        assertEquals("17:00", StudentSchedule.clock(s.endMinute));
+        assertTrue(s.isActive(at(1, 8, 0)));
+        assertTrue(s.isActive(at(5, 16, 59)));
+        assertFalse(s.isActive(at(5, 17, 0)));
+        assertFalse(s.isActive(at(1, 7, 59)));
+        assertFalse(s.isActive(at(6, 12, 0)));
+    }
+
+    @Test
+    public void nextChangeCrossesTheWeekend() {
+        final StudentSchedule s = StudentSchedule.DEFAULT;
+        assertEquals(at(1, 17, 0), s.nextChange(at(1, 9, 30)));
+        assertEquals(at(2, 8, 0), s.nextChange(at(1, 17, 0)));
+        assertEquals(at(8, 8, 0), s.nextChange(at(5, 18, 0)));
+        assertNull(s.withDays(Collections.<Integer>emptyList()).nextChange(at(1, 9, 0)));
+    }
+
+    @Test
+    public void overnightWindowRunsIntoTheNextDay() {
+        final StudentSchedule s = new StudentSchedule(set1(1), 22 * 60, 6 * 60);
+        assertTrue(s.overnight());
