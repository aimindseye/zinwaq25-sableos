+package com.android.settings.applications.sable.model;
+
+import java.text.Collator;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.Locale;
+
+/**
+ * App Control Center rows (MOBILE_MANAGER_APP_CONTROLS_UX "Mail · network allowed ·
+ * background unrestricted"): one row per app with what each control holds, read from
+ * Android's own stores (network policy, battery optimization mode, package suspension, the
+ * hidden setting), and the list filters. Nothing here is a second store.
+ */
+public final class AppControlRows {
+
+    /** Network access as the Network Manager switch sees it. */
+    public enum Network { ALLOWED, PARTIAL, BLOCKED, NOT_MANAGEABLE }
+
+    /** Android's per-app battery mode (Settings &gt; Apps &gt; App battery usage). */
+    public enum Background { UNRESTRICTED, OPTIMIZED, RESTRICTED, UNKNOWN }
+
+    /** Whether, and by whom, the app is paused (suspended). */
+    public enum Paused {
+        NO,
+        FROZEN,
+        STUDENT,
+        FOCUS,
+        /** Suspended by another app (a device admin or wellbeing app); Settings leaves it. */
+        OTHER
+    }
+
+    /** The list filters, in the order the page offers them. */
+    public enum Filter { ALL, NETWORK_BLOCKED, BACKGROUND_RESTRICTED, PAUSED, FROZEN, HIDDEN }
+
+    /** One app. */
+    public static final class Row {
+        public final String packageName;
+        public final String label;
+        public final Network network;
+        public final Background background;
+        public final Paused paused;
+        public final boolean hidden;
+        /** User-installed (not part of the system image): only these can be hidden. */
+        public final boolean userInstalled;
+
+        public Row(String packageName, String label, Network network, Background background,
+                Paused paused, boolean hidden, boolean userInstalled) {
+            this.packageName = packageName;
+            this.label = label == null || label.trim().isEmpty() ? packageName : label;
+            this.network = network == null ? Network.ALLOWED : network;
+            this.background = background == null ? Background.UNKNOWN : background;
+            this.paused = paused == null ? Paused.NO : paused;
+            this.hidden = hidden;
+            this.userInstalled = userInstalled;
+        }
+
+        public boolean frozen() {
+            return paused == Paused.FROZEN;
+        }
+    }
+
+    private AppControlRows() {}
+
+    /** Settings' own reason for a suspended app, or OTHER/NO from the platform state. */
+    public static Paused paused(boolean suspended, AppSuspensions.Reason heldBySettings) {
+        if (heldBySettings != null) {
+            switch (heldBySettings) {
+                case FROZEN:
+                    return Paused.FROZEN;
+                case STUDENT:
+                    return Paused.STUDENT;
+                default:
+                    return Paused.FOCUS;
+            }
+        }
+        return suspended ? Paused.OTHER : Paused.NO;
+    }
+
+    public static boolean matches(Row row, Filter filter) {
+        if (row == null) {
+            return false;
+        }
+        switch (filter == null ? Filter.ALL : filter) {
+            case NETWORK_BLOCKED:
+                return row.network == Network.BLOCKED || row.network == Network.PARTIAL;
+            case BACKGROUND_RESTRICTED:
+                return row.background == Background.RESTRICTED;
+            case PAUSED:
+                return row.paused != Paused.NO;
+            case FROZEN:
+                return row.paused == Paused.FROZEN;
+            case HIDDEN:
+                return row.hidden;
+            default:
+                return true;
+        }
+    }
+
+    /** Rows matching {@code filter}, sorted by label then package. */
+    public static List<Row> filter(List<Row> rows, Filter filter, Locale locale) {
+        final List<Row> out = new ArrayList<>();
+        if (rows != null) {
+            for (Row r : rows) {
+                if (matches(r, filter)) {
+                    out.add(r);
+                }
+            }
+        }
+        final Collator collator = Collator.getInstance(locale == null ? Locale.ROOT : locale);
+        Collections.sort(out, (a, b) -> {
+            final int c = collator.compare(a.label, b.label);
+            return c != 0 ? c : a.packageName.compareTo(b.packageName);
+        });
+        return out;
+    }
+
+    public static int count(List<Row> rows, Filter filter) {
+        int n = 0;
+        if (rows != null) {
+            for (Row r : rows) {
+                if (matches(r, filter)) {
+                    n++;
+                }
+            }
+        }
+        return n;
+    }
+
+    /**
+     * Whether "Hide from launcher" is offered: only for a frozen, user-installed app that is not
+     * one the phone needs, so a system app is never made to vanish.
+     */
+    public static boolean canHide(Row row, boolean neverPause) {
+        return row != null && row.userInstalled && !neverPause
+                && (row.hidden || row.paused == Paused.FROZEN);
+    }
+}
