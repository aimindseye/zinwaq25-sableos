+package com.android.settings.sable;
+
+import android.app.settings.SettingsEnums;
+import android.os.Bundle;
+import android.view.View;
+
+import com.android.settings.R;
+import com.android.settings.applications.sable.SableAppListKeyboard;
+import com.android.settings.dashboard.DashboardFragment;
+
+/**
+ * One of the grouped rows of the BlackBerry 10 style Settings top level (Sable 2.0): Networks and
+ * connections, Notifications and sound, Display and look, Security and privacy, Storage and backup,
+ * or System and about. The homepage row passes which one in the "sable_group" extra; the page lists
+ * the entries the homepage used to show, with their own controllers. Letters find a row.
+ *
+ * <p>Not indexed for search: every page it links indexes itself, as before.
+ */
+public class SableSettingsGroupFragment extends DashboardFragment {
+    private static final String TAG = "SableSettingsGroup";
+
+    /** The homepage row's extra naming the group. */
+    public static final String EXTRA_GROUP = "sable_group";
+
+    private SableAppListKeyboard mKeyboard;
+
+    /** The page for [group]; an unknown or missing name opens System and about. */
+    static int screenFor(String group) {
+        if (group == null) return R.xml.sable_group_system;
+        switch (group) {
+            case "networks":
+                return R.xml.sable_group_networks;
+            case "notifications":
+                return R.xml.sable_group_notifications;
+            case "display":
+                return R.xml.sable_group_display;
+            case "security":
+                return R.xml.sable_group_security;
+            case "storage":
+                return R.xml.sable_group_storage;
+            default:
+                return R.xml.sable_group_system;
+        }
+    }
+
+    @Override
+    public int getMetricsCategory() {
+        return SettingsEnums.SETTINGS_SYSTEM_CATEGORY;
+    }
+
+    @Override
+    protected String getLogTag() {
+        return TAG;
+    }
+
+    @Override
+    protected int getPreferenceScreenResId() {
+        final Bundle args = getArguments();
+        return screenFor(args == null ? null : args.getString(EXTRA_GROUP));
+    }
+
+    @Override
+    public void onViewCreated(View view, Bundle savedInstanceState) {
+        super.onViewCreated(view, savedInstanceState);
+        mKeyboard = SableAppListKeyboard.attach(this, getListView(), getMetricsCategory());
+    }
+
+    @Override
+    public void onDestroyView() {
+        if (mKeyboard != null) {
+            mKeyboard.detach();
+            mKeyboard = null;
+        }
+        super.onDestroyView();
+    }
+}
