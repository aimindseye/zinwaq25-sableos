+package com.android.settings.sable;
+
+import android.content.Context;
+
+import androidx.preference.ListPreference;
+import androidx.preference.Preference;
+
+import com.android.settings.core.BasePreferenceController;
+
+/**
+ * Settings > Display > Accent: picks the Sable accent used by Sable apps and, through the system
+ * palette, by Quick Settings, Settings and SetupWizard. Sits next to Android's Dark theme, which
+ * stays the only light/dark control (DESIGN-KF-B: one system theme source).
+ */
+public class SableAccentPreferenceController extends BasePreferenceController
+        implements Preference.OnPreferenceChangeListener {
+
+    public SableAccentPreferenceController(Context context, String preferenceKey) {
+        super(context, preferenceKey);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return AVAILABLE;
+    }
+
+    @Override
+    public void updateState(Preference preference) {
+        super.updateState(preference);
+        if (preference instanceof ListPreference) {
+            ListPreference list = (ListPreference) preference;
+            list.setValue(SableAppearanceProvider.readAccent(mContext));
+            list.setSummary(list.getEntry());
+        }
+    }
+
+    @Override
+    public boolean onPreferenceChange(Preference preference, Object newValue) {
+        boolean stored = SableAppearanceProvider.writeAccent(mContext, String.valueOf(newValue));
+        if (stored && preference instanceof ListPreference) {
+            ListPreference list = (ListPreference) preference;
+            int index = list.findIndexOfValue(String.valueOf(newValue));
+            if (index >= 0) {
+                list.setSummary(list.getEntries()[index]);
+            }
+        }
+        return stored;
+    }
+}
diff --git a/src/com/android/settings/sable/SableAppearancePolicy.java b/src/com/android/settings/sable/SableAppearancePolicy.java
