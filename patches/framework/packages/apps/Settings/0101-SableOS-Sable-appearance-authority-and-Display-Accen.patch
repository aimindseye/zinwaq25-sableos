+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.settings.sable;
+
+import android.app.UiModeManager;
+import android.content.ContentProvider;
+import android.content.ContentValues;
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.database.Cursor;
+import android.database.MatrixCursor;
+import android.net.Uri;
+import android.os.Binder;
+import android.os.Process;
+import android.provider.Settings;
+import android.util.Log;
+
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.util.Map;
+
+/**
+ * The Sable appearance authority read by Sable apps (org.sableos.design.SableGlobalAppearance)
+ * and Sable Start. Hosted by Settings so the launcher never owns system theme state.
+ *
+ * <p>Columns: {@code mode} (always "follow-system": Android's Dark theme is the single source)
+ * and {@code accent} (blue, green, purple, orange, slate). Writing an accent also seeds the
+ * system palette; writing light/dark sets the system night mode. See
+ * {@link SableAppearancePolicy}.
+ */
+public final class SableAppearanceProvider extends ContentProvider {
+    private static final String TAG = "SableAppearance";
+    private static final String PREFS = "sable_system_appearance";
+    private static final String KEY_ACCENT = "accent";
+
+    public static final Uri CONTENT_URI = Uri.parse(
+            "content://" + SableAppearancePolicy.AUTHORITY + "/"
+                    + SableAppearancePolicy.PATH_APPEARANCE);
+
+    @Override
+    public boolean onCreate() {
+        return true;
+    }
+
+    private static SharedPreferences prefs(Context context) {
+        return context.createDeviceProtectedStorageContext()
+                .getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+    }
+
+    /** The stored Sable accent for the current user. */
+    public static String readAccent(Context context) {
+        return SableAppearancePolicy.normalizeAccent(
+                prefs(context).getString(KEY_ACCENT, SableAppearancePolicy.DEFAULT_ACCENT));
+    }
+
+    /**
+     * Stores the accent, seeds the system palette with it and notifies observers.
+     *
+     * @return false when the accent is not a Sable preset.
+     */
+    public static boolean writeAccent(Context context, String accent) {
+        if (!SableAppearancePolicy.isValidAccent(accent)) {
+            return false;
+        }
+        prefs(context).edit().putString(KEY_ACCENT, accent).apply();
+        applySystemPalette(context, accent);
+        context.getContentResolver().notifyChange(CONTENT_URI, null);
+        return true;
+    }
+
+    /** Applies an explicit light/dark request to the system theme. */
+    public static void applyMode(Context context, String mode) {
+        int nightMode = SableAppearancePolicy.nightModeFor(mode);
+        if (nightMode == SableAppearancePolicy.NIGHT_MODE_UNCHANGED) {
+            return;
+        }
+        UiModeManager uiModeManager = context.getSystemService(UiModeManager.class);
+        if (uiModeManager != null) {
+            uiModeManager.setNightMode(nightMode);
+        }
+    }
+
+    private static void applySystemPalette(Context context, String accent) {
+        String current = Settings.Secure.getString(context.getContentResolver(),
+                Settings.Secure.THEME_CUSTOMIZATION_OVERLAY_PACKAGES);
+        try {
+            JSONObject json = new JSONObject(current == null || current.isEmpty() ? "{}" : current);
+            for (Map.Entry<String, String> field
+                    : SableAppearancePolicy.themeCustomizationFor(accent).entrySet()) {
+                json.put(field.getKey(), field.getValue());
+            }
+            json.remove(SableAppearancePolicy.KEY_COLOR_INDEX);
+            json.put(SableAppearancePolicy.KEY_APPLIED_TIMESTAMP, System.currentTimeMillis());
+            Settings.Secure.putString(context.getContentResolver(),
+                    Settings.Secure.THEME_CUSTOMIZATION_OVERLAY_PACKAGES, json.toString());
+        } catch (JSONException e) {
+            Log.w(TAG, "Could not update the system palette for accent " + accent, e);
+        }
+    }
+
+    @Override
+    public Cursor query(Uri uri, String[] projection, String selection, String[] selectionArgs,
+            String sortOrder) {
+        enforceUri(uri);
+        Context context = requireContextOrThrow();
+        MatrixCursor cursor = new MatrixCursor(new String[] {
+                SableAppearancePolicy.COLUMN_MODE, SableAppearancePolicy.COLUMN_ACCENT}, 1);
+        final long token = Binder.clearCallingIdentity();
+        try {
+            cursor.addRow(new Object[] {SableAppearancePolicy.reportedMode(), readAccent(context)});
+        } finally {
+            Binder.restoreCallingIdentity(token);
+        }
+        cursor.setNotificationUri(context.getContentResolver(), CONTENT_URI);
+        return cursor;
+    }
+
+    @Override
+    public int update(Uri uri, ContentValues values, String selection, String[] selectionArgs) {
+        enforceUri(uri);
+        Context context = requireContextOrThrow();
+        String[] callerPackages =
+                context.getPackageManager().getPackagesForUid(Binder.getCallingUid());
+        if (!SableAppearancePolicy.isAllowedWriter(
+                Binder.getCallingUid() == Process.myUid(), callerPackages)) {
+            throw new SecurityException(
+                    "Sable appearance writes are limited to Settings and Sable Start");
+        }
+        String mode = values == null ? null : values.getAsString(SableAppearancePolicy.COLUMN_MODE);
+        String accent =
+                values == null ? null : values.getAsString(SableAppearancePolicy.COLUMN_ACCENT);
+        if (mode != null && !SableAppearancePolicy.isValidMode(mode)) {
+            throw new IllegalArgumentException("Invalid Sable appearance mode: " + mode);
+        }
+        if (accent != null && !SableAppearancePolicy.isValidAccent(accent)) {
+            throw new IllegalArgumentException("Invalid Sable accent: " + accent);
+        }
+        final long token = Binder.clearCallingIdentity();
+        try {
+            if (mode != null) {
+                applyMode(context, mode);
+            }
+            if (accent != null) {
+                writeAccent(context, accent);
+            } else {
+                context.getContentResolver().notifyChange(CONTENT_URI, null);
+            }
+        } finally {
+            Binder.restoreCallingIdentity(token);
+        }
+        return 1;
+    }
+
+    @Override
+    public String getType(Uri uri) {
+        enforceUri(uri);
+        return "vnd.android.cursor.item/vnd.org.sableos.appearance";
+    }
+
+    @Override
+    public Uri insert(Uri uri, ContentValues values) {
+        throw new UnsupportedOperationException("Use update for Sable appearance");
+    }
+
+    @Override
+    public int delete(Uri uri, String selection, String[] selectionArgs) {
+        throw new UnsupportedOperationException("Sable appearance cannot be deleted");
+    }
+
+    private Context requireContextOrThrow() {
+        Context context = getContext();
+        if (context == null) {
+            throw new IllegalStateException("Settings context unavailable");
+        }
+        return context;
+    }
+
+    private static void enforceUri(Uri uri) {
+        if (!CONTENT_URI.equals(uri)) {
+            throw new IllegalArgumentException("Unsupported Sable appearance URI: " + uri);
+        }
+    }
+}
