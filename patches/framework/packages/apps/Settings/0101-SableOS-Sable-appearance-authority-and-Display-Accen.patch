+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.settings.sable;
+
+import java.util.Arrays;
+import java.util.LinkedHashMap;
+import java.util.Map;
+
+/**
+ * Pure policy for the Sable appearance authority (content://org.sableos.appearance/appearance).
+ * No Android imports, so it is unit-tested on the host.
+ *
+ * DESIGN-KF-B: the system theme is the single source of truth. Light/dark belongs to Android's
+ * Dark theme (Quick Settings tile, Settings > Display); this authority therefore always reports
+ * "follow-system" and turns an explicit light/dark request into the system night mode. It owns
+ * only the Sable accent, which it also hands to the system palette so SystemUI, Settings and
+ * SetupWizard use the same accent as Sable apps.
+ *
+ * Accent values and seeds equal SableAccentTokens in sable-src sabledesign
+ * (tests/check-sable-design.py compares them).
+ */
+public final class SableAppearancePolicy {
+    public static final String AUTHORITY = "org.sableos.appearance";
+    public static final String PATH_APPEARANCE = "appearance";
+    public static final String COLUMN_MODE = "mode";
+    public static final String COLUMN_ACCENT = "accent";
+
+    public static final String MODE_FOLLOW_SYSTEM = "follow-system";
+    public static final String MODE_LIGHT = "light";
+    public static final String MODE_DARK = "dark";
+
+    /** Stable accent values, in display order. */
+    public static final String[] ACCENTS = {"blue", "green", "purple", "orange", "slate"};
+    /** System palette seeds (RRGGBB), parallel to {@link #ACCENTS}. */
+    public static final String[] ACCENT_SEEDS = {"4D9CFF", "35C66B", "7A42E8", "F28C45", "64748B"};
+    public static final String DEFAULT_ACCENT = "blue";
+
+    /** Mirrors UiModeManager.MODE_NIGHT_NO / MODE_NIGHT_YES. */
+    public static final int NIGHT_MODE_NO = 1;
+    public static final int NIGHT_MODE_YES = 2;
+    public static final int NIGHT_MODE_UNCHANGED = -1;
+
+    /** Package allowed to write besides Settings itself (Sable Start's appearance control). */
+    public static final String LAUNCHER_PACKAGE = "org.sableos.launcher";
+
+    // Keys of Settings.Secure.THEME_CUSTOMIZATION_OVERLAY_PACKAGES read by SystemUI's
+    // ThemeOverlayController.
+    public static final String KEY_COLOR_SOURCE = "android.theme.customization.color_source";
+    public static final String KEY_SYSTEM_PALETTE = "android.theme.customization.system_palette";
+    public static final String KEY_ACCENT_COLOR = "android.theme.customization.accent_color";
+    public static final String KEY_THEME_STYLE = "android.theme.customization.theme_style";
+    public static final String KEY_COLOR_INDEX = "android.theme.customization.color_index";
+    public static final String KEY_APPLIED_TIMESTAMP = "_applied_timestamp";
+    public static final String COLOR_SOURCE_PRESET = "preset";
+    public static final String THEME_STYLE = "TONAL_SPOT";
+
+    private SableAppearancePolicy() {}
+
+    public static boolean isValidMode(String mode) {
+        return MODE_FOLLOW_SYSTEM.equals(mode) || MODE_LIGHT.equals(mode)
+                || MODE_DARK.equals(mode);
+    }
+
+    public static boolean isValidAccent(String accent) {
+        return indexOfAccent(accent) >= 0;
+    }
+
+    /** A stored or requested accent, falling back to Sable Blue when unknown. */
+    public static String normalizeAccent(String accent) {
+        return isValidAccent(accent) ? accent : DEFAULT_ACCENT;
+    }
+
+    public static String seedHexForAccent(String accent) {
+        return ACCENT_SEEDS[indexOfAccent(normalizeAccent(accent))];
+    }
+
+    /** What readers see in the mode column: always the system. */
+    public static String reportedMode() {
+        return MODE_FOLLOW_SYSTEM;
+    }
+
+    /** The system night mode a mode request maps to, or {@link #NIGHT_MODE_UNCHANGED}. */
+    public static int nightModeFor(String mode) {
+        if (MODE_LIGHT.equals(mode)) {
+            return NIGHT_MODE_NO;
+        }
+        if (MODE_DARK.equals(mode)) {
+            return NIGHT_MODE_YES;
+        }
+        return NIGHT_MODE_UNCHANGED;
+    }
+
+    /** Writes come from Settings itself or from Sable Start. Everyone may read. */
+    public static boolean isAllowedWriter(boolean callerIsSelf, String[] callerPackages) {
+        if (callerIsSelf) {
+            return true;
+        }
+        return callerPackages != null && Arrays.asList(callerPackages).contains(LAUNCHER_PACKAGE);
+    }
+
+    /**
+     * The fields to set in THEME_CUSTOMIZATION_OVERLAY_PACKAGES for an accent, as a user-chosen
+     * preset color (the same form the wallpaper picker writes). The caller adds the timestamp and
+     * removes {@link #KEY_COLOR_INDEX}, which only the picker's own preset list understands.
+     */
+    public static Map<String, String> themeCustomizationFor(String accent) {
+        String seed = seedHexForAccent(accent);
+        Map<String, String> fields = new LinkedHashMap<>();
+        fields.put(KEY_COLOR_SOURCE, COLOR_SOURCE_PRESET);
+        fields.put(KEY_SYSTEM_PALETTE, seed);
+        fields.put(KEY_ACCENT_COLOR, seed);
+        fields.put(KEY_THEME_STYLE, THEME_STYLE);
+        return fields;
+    }
+
+    private static int indexOfAccent(String accent) {
+        if (accent == null) {
+            return -1;
+        }
+        for (int i = 0; i < ACCENTS.length; i++) {
+            if (ACCENTS[i].equals(accent)) {
+                return i;
+            }
+        }
+        return -1;
+    }
+}
