 import java.util.List;
 
 /**
- * Intents from Settings into Sable apps: Sable Setup (Settings > Sable) and App display
- * compatibility (Display, App info). Each link is resolved to an explicit component in that
+ * Intents from Settings into Sable apps: Sable Setup (Settings > Sable), App display
+ * compatibility (Display, App info) and Sable Tools' typing test and diagnostics (Keyboard &amp;
+ * input). Each link is resolved to an explicit component in that
  * app's own package, so a missing app hides the row and no other app can answer.
  */
 public final class SableLinks {
@@ -37,7 +38,18 @@ public final class SableLinks {
     public static final String ACTION_APP_DISPLAY_PROFILE =
             "org.sableos.titan2.displaycompat.action.APP_PROFILE";
 
+    public static final String TOOLS_PACKAGE = "org.sableos.tools";
+    /** Sable Tools' ToolActivity: opens one tool by its core Tool name. */
+    public static final String ACTION_OPEN_TOOL = "org.sableos.tools.action.OPEN_TOOL";
+    public static final String EXTRA_TOOL = "org.sableos.tools.extra.TOOL";
+    /** Sable Tools' "Critical text-entry test" (PIN, password and pairing-code typing). */
+    public static final String TOOL_TEXT_ENTRY = "TEXT_ENTRY";
+
     public static final String KEY_SETUP = "sable_setup";
+    /** Keyboard &amp; input: Sable Tools' typing test. */
+    public static final String KEY_TYPING_TEST = "sable_typing_test";
+    /** Keyboard &amp; input: Sable Tools (diagnostics, hardware tests, factory-test bridge). */
+    public static final String KEY_DIAGNOSTICS = "sable_tools_diagnostics";
     /** Settings > Display > App display compatibility. */
     public static final String KEY_DISPLAY_COMPAT_DISPLAY = "sable_display_compat_display";
 
@@ -59,6 +71,13 @@ public final class SableLinks {
                 return launcher(SETUP_PACKAGE);
             case KEY_DISPLAY_COMPAT_DISPLAY:
                 return launcher(DISPLAY_COMPAT_PACKAGE);
+            case KEY_TYPING_TEST:
+                return new Intent(ACTION_OPEN_TOOL).setPackage(TOOLS_PACKAGE)
