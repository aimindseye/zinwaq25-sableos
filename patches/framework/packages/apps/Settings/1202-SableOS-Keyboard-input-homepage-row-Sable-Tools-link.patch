+package com.android.settings.sable;
+
+import android.content.Context;
+import android.content.res.Configuration;
+
+import com.android.settings.core.BasePreferenceController;
+
+/**
+ * The homepage keyboard hint footer ("↑↓ focus · Enter open · / search", approved Settings
+ * design). Shown only while a hardware QWERTY keyboard is present (the Q25's always is), so
+ * touch-only devices get no keyboard hint. Never indexed.
+ */
+public class SableKeyHintPreferenceController extends BasePreferenceController {
+
+    public SableKeyHintPreferenceController(Context context, String preferenceKey) {
+        super(context, preferenceKey);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return mContext.getResources().getConfiguration().keyboard == Configuration.KEYBOARD_QWERTY
+                ? AVAILABLE_UNSEARCHABLE : CONDITIONALLY_UNAVAILABLE;
+    }
+}
