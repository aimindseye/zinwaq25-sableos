+            case KEY_DIAGNOSTICS:
+                // Sable Tools' own home: it lists only the tools this phone supports and keeps
+                // the *#*#3377#*#* factory-test bridge behind its own gate.
+                return launcher(TOOLS_PACKAGE);
             default:
                 return null;
         }
