+package com.android.settings.applications.sable.model;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.Test;
+
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.Map;
+import java.util.Set;
+
+public class DeepSleepPolicyTest {
+    private static final long NOW = 1_794_000_000_000L;
+    private static final long DAY = 24L * 60 * 60 * 1000;
+    private static final Set<String> NEEDED = new HashSet<>(Arrays.asList(
+            "com.android.settings", "com.android.dialer"));
+
+    private static Map<String, Long> used(Object... pairs) {
+        final Map<String, Long> out = new HashMap<>();
+        for (int i = 0; i < pairs.length; i += 2) {
+            out.put((String) pairs[i], (Long) pairs[i + 1]);
+        }
+        return out;
+    }
+
+    @Test
+    public void appsUnusedForThreeDaysGoToSleep() {
+        final Set<String> out = DeepSleepPolicy.toSleep(used(
+                "com.example.old", NOW - 3 * DAY,
+                "com.example.recent", NOW - 2 * DAY,
+                "com.example.older", NOW - 30 * DAY), NOW, null, null, NEEDED, null);
+        assertEquals(new HashSet<>(Arrays.asList("com.example.old", "com.example.older")), out);
+    }
+
+    @Test
+    public void neededSableExemptAsleepAndWokenAppsAreLeftAlone() {
+        final long old = NOW - 10 * DAY;
+        final Set<String> out = DeepSleepPolicy.toSleep(used(
+                "com.android.dialer", old,
+                "org.sableos.weather", old,
+                "com.example.listener", old,
+                "com.example.asleep", old,
+                "com.example.woken", old,
+                "com.example.game", old,
+                "com.example.unknown", 0L,
+                "bad", old), NOW,
+                Collections.singleton("com.example.asleep"),
+                Collections.singleton("com.example.woken"), NEEDED,
+                Collections.singleton("com.example.listener"));
+        assertEquals(Collections.singleton("com.example.game"), out);
+        assertTrue(DeepSleepPolicy.toSleep(null, NOW, null, null, NEEDED, null).isEmpty());
+    }
+
+    @Test
+    public void wakingKeepsAnAppAwakeAndSleepingByHandReleasesIt() {
+        Set<String> keep = DeepSleepPolicy.afterManualChange(null, "com.example.a", false);
+        assertEquals(Collections.singleton("com.example.a"), keep);
+        keep = DeepSleepPolicy.afterManualChange(keep, "com.example.a", true);
+        assertTrue(keep.isEmpty());
+        assertTrue(DeepSleepPolicy.afterManualChange(null, "not valid", false).isEmpty());
+    }
+
+    @Test
+    public void lastTouchedIsTheNewestTime() {
+        assertEquals(30L, DeepSleepPolicy.lastTouched(10L, 30L, 20L));
+        assertEquals(0L, DeepSleepPolicy.lastTouched(0L, 0L, -1L));
+    }
+}
