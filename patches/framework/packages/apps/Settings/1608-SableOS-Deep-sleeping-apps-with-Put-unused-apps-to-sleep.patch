+package com.android.settings.applications.sable.model;
+
+import java.util.Collection;
+import java.util.Map;
+import java.util.Set;
+import java.util.TreeSet;
+
+/**
+ * Deep sleeping apps (Mobile Manager &gt; Deep sleeping apps), the pure part of "Put unused apps
+ * to sleep": which apps go into deep sleep after {@link #UNUSED_MILLIS} without being opened, and
+ * which apps the user woke and so keep awake. Deep sleep is App blocker's Restricted background
+ * mode ({@link AppBlockerPolicy}), so the platform holds the state.
+ */
+public final class DeepSleepPolicy {
+    /** Three days, as in the request (after the deep sleep of recent Samsung phones). */
+    public static final long UNUSED_MILLIS = 3L * 24 * 60 * 60 * 1000;
+
+    /** Sable's own apps (Hub, Weather, Tasks and the rest) are never put to sleep on their own. */
+    public static final String SABLE_PREFIX = "org.sableos.";
+
+    private DeepSleepPolicy() {}
+
+    /**
+     * The apps to put to sleep now: blockable, not asleep already, not woken by the user, not
+     * {@code exempt} (an accessibility service, notification listener, device admin or the live
+     * wallpaper), not a Sable app, and last used (or installed or updated) at least
+     * {@link #UNUSED_MILLIS} before {@code now}. An app with no known time is left alone.
+     */
+    public static Set<String> toSleep(Map<String, Long> lastUsed, long now,
+            Collection<String> asleep, Collection<String> keepAwake, Set<String> neverBlock,
+            Collection<String> exempt) {
+        final Set<String> out = new TreeSet<>();
+        if (lastUsed == null) {
+            return out;
+        }
+        for (Map.Entry<String, Long> entry : lastUsed.entrySet()) {
+            final String pkg = entry.getKey();
+            final Long used = entry.getValue();
+            if (used != null && used > 0 && now - used >= UNUSED_MILLIS
+                    && AppBlockerPolicy.canBlock(pkg, neverBlock)
+                    && !pkg.startsWith(SABLE_PREFIX)
+                    && !contains(asleep, pkg) && !contains(keepAwake, pkg)
+                    && !contains(exempt, pkg)) {
+                out.add(pkg);
+            }
+        }
+        return out;
+    }
+
+    /**
+     * The apps kept awake after the user switches {@code pkg} by hand: waking one keeps it awake
+     * from then on, and putting one to sleep by hand lets "Put unused apps to sleep" manage it
+     * again.
+     */
+    public static Set<String> afterManualChange(Collection<String> keepAwake, String pkg,
+            boolean asleep) {
+        final Set<String> out = new TreeSet<>();
+        if (keepAwake != null) {
+            out.addAll(keepAwake);
+        }
+        if (!PackageSet.isValidPackageName(pkg)) {
+            return out;
+        }
+        if (asleep) {
+            out.remove(pkg);
+        } else {
+            out.add(pkg);
+        }
+        return out;
+    }
+
+    /** The newest of the last use, install and update times, in milliseconds (0 when none). */
+    public static long lastTouched(long lastUsed, long installed, long updated) {
+        return Math.max(Math.max(lastUsed, installed), Math.max(updated, 0L));
+    }
+
+    private static boolean contains(Collection<String> set, String pkg) {
+        return set != null && set.contains(pkg);
+    }
+}
