+package com.android.settings.applications.sable;
+
+import android.app.WallpaperInfo;
+import android.app.WallpaperManager;
+import android.app.admin.DevicePolicyManager;
+import android.app.job.JobInfo;
+import android.app.job.JobParameters;
+import android.app.job.JobScheduler;
+import android.app.job.JobService;
+import android.app.usage.UsageStats;
+import android.app.usage.UsageStatsManager;
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.pm.PackageInfo;
+import android.content.pm.PackageManager;
+import android.provider.Settings;
+import android.text.TextUtils;
+import android.util.Log;
+
+import com.android.settings.applications.sable.model.DeepSleepPolicy;
+
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.TreeSet;
+
+/**
+ * "Put unused apps to sleep" (Mobile Manager &gt; Deep sleeping apps), off until the user turns
+ * it on: once a day, while the phone is idle, every launcher app not opened for three days goes
+ * into deep sleep ({@link SableAppBlocker}: Android's Restricted background mode and a stop), as
+ * {@link DeepSleepPolicy} decides. An app the user wakes on the page stays awake.
+ */
+public class SableDeepSleep extends JobService {
+    private static final String TAG = "SableDeepSleep";
+    private static final String NAMESPACE = "sable_deep_sleep";
+    private static final int JOB_ID = 1;
+    private static final long DAY_MILLIS = 24L * 60 * 60 * 1000;
+    /** Usage older than this is not looked up; such an app counts as unused since install. */
+    private static final long LOOKBACK_MILLIS = 30L * DAY_MILLIS;
+
+    static final String KEY_AUTO = "deep_sleep_auto";
+    static final String KEY_KEEP_AWAKE = "deep_sleep_keep_awake";
+    static final String KEY_AUTO_SLEPT = "deep_sleep_auto_slept";
+
+    static boolean isAutoOn(Context context) {
+        return "1".equals(SableAppControls.readString(context, KEY_AUTO));
+    }
+
+    /** Turns "Put unused apps to sleep" on or off, and schedules or cancels the daily pass. */
+    static void setAutoOn(Context context, boolean on) {
+        SableAppControls.writeString(context, KEY_AUTO, on ? "1" : "0");
+        final JobScheduler scheduler = scheduler(context);
+        if (scheduler == null) {
+            return;
+        }
+        if (!on) {
+            scheduler.cancel(JOB_ID);
+            return;
+        }
+        scheduler.schedule(new JobInfo.Builder(JOB_ID,
+                new ComponentName(context, SableDeepSleep.class))
+                .setPeriodic(DAY_MILLIS)
+                .setRequiresDeviceIdle(true)
+                .setPersisted(true)
+                .build());
+    }
+
+    /** Records a switch the user flipped on the page, so a woken app is not put back to sleep. */
+    static void onManualChange(Context context, String pkg, boolean asleep) {
+        SableAppControls.writeSet(context, KEY_KEEP_AWAKE, DeepSleepPolicy.afterManualChange(
+                SableAppControls.readSet(context, KEY_KEEP_AWAKE), pkg, asleep));
+        final Set<String> slept = new TreeSet<>(SableAppControls.readSet(context, KEY_AUTO_SLEPT));
+        if (slept.remove(pkg)) {
+            SableAppControls.writeSet(context, KEY_AUTO_SLEPT, slept);
+        }
+    }
+
+    /** Whether "Put unused apps to sleep" put {@code pkg} to sleep (for its summary). */
+    static boolean wasAutoSlept(Context context, String pkg) {
+        return SableAppControls.readSet(context, KEY_AUTO_SLEPT).contains(pkg);
+    }
+
+    @Override
+    public boolean onStartJob(JobParameters params) {
+        final Context context = getApplicationContext();
+        new Thread(() -> {
+            try {
+                if (isAutoOn(context)) {
+                    sleepUnused(context, System.currentTimeMillis());
+                }
+            } catch (RuntimeException e) {
+                Log.e(TAG, "Deep sleep pass failed", e);
+            }
+            jobFinished(params, false);
+        }, TAG).start();
+        return true;
+    }
+
+    @Override
+    public boolean onStopJob(JobParameters params) {
+        return false;
+    }
+
+    private static void sleepUnused(Context context, long now) {
+        final Map<String, Long> lastUsed = new HashMap<>();
+        final Set<String> asleep = new TreeSet<>();
+        final Map<String, UsageStats> usage = usage(context, now);
+        final PackageManager pm = context.getPackageManager();
+        for (SableAppControls.LauncherApp app : SableAppControls.launcherApps(context, false)) {
+            if (SableAppBlocker.isBlocked(context, app.uid, app.packageName)) {
+                asleep.add(app.packageName);
+            }
+            final UsageStats stats = usage.get(app.packageName);
+            long installed = 0;
+            long updated = 0;
+            try {
+                final PackageInfo info = pm.getPackageInfo(app.packageName,
+                        PackageManager.PackageInfoFlags.of(0));
+                installed = info.firstInstallTime;
+                updated = info.lastUpdateTime;
+            } catch (PackageManager.NameNotFoundException e) {
+                continue;
+            }
+            lastUsed.put(app.packageName, DeepSleepPolicy.lastTouched(
+                    stats == null ? 0 : stats.getLastTimeUsed(), installed, updated));
+        }
+        final Set<String> chosen = DeepSleepPolicy.toSleep(lastUsed, now, asleep,
+                SableAppControls.readSet(context, KEY_KEEP_AWAKE),
+                SableAppControls.protectedPackages(context), exempt(context));
+        final Set<String> slept = new TreeSet<>(SableAppControls.readSet(context, KEY_AUTO_SLEPT));
+        slept.retainAll(lastUsed.keySet());
+        for (String pkg : chosen) {
+            if (SableAppBlocker.setBlocked(context, pkg, true)) {
+                slept.add(pkg);
+            }
+        }
+        SableAppControls.writeSet(context, KEY_AUTO_SLEPT, slept);
+        Log.i(TAG, "Put " + chosen.size() + " unused apps to sleep");
+    }
+
+    private static Map<String, UsageStats> usage(Context context, long now) {
+        try {
+            final UsageStatsManager manager = context.getSystemService(UsageStatsManager.class);
+            final Map<String, UsageStats> stats = manager == null ? null
+                    : manager.queryAndAggregateUsageStats(now - LOOKBACK_MILLIS, now);
+            return stats == null ? new HashMap<>() : stats;
+        } catch (RuntimeException e) {
+            Log.w(TAG, "Cannot read app usage", e);
+            return new HashMap<>();
+        }
+    }
+
+    /**
+     * Apps that work in the background on the user's behalf, which a sleep would quietly break:
+     * enabled accessibility services and notification listeners, active device admins and the
+     * live wallpaper.
+     */
+    private static Set<String> exempt(Context context) {
+        final Set<String> out = new TreeSet<>();
+        addComponents(out, Settings.Secure.getString(context.getContentResolver(),
+                Settings.Secure.ENABLED_ACCESSIBILITY_SERVICES));
+        addComponents(out, Settings.Secure.getString(context.getContentResolver(),
+                Settings.Secure.ENABLED_NOTIFICATION_LISTENERS));
+        try {
+            final DevicePolicyManager dpm = context.getSystemService(DevicePolicyManager.class);
+            final List<ComponentName> admins = dpm == null ? null : dpm.getActiveAdmins();
+            if (admins != null) {
+                for (ComponentName admin : admins) {
+                    out.add(admin.getPackageName());
+                }
+            }
+        } catch (RuntimeException e) {
+            Log.w(TAG, "Cannot list device admins", e);
+        }
+        try {
+            final WallpaperManager wallpapers = context.getSystemService(WallpaperManager.class);
+            final WallpaperInfo live = wallpapers == null ? null : wallpapers.getWallpaperInfo();
+            if (live != null) {
+                out.add(live.getPackageName());
+            }
+        } catch (RuntimeException e) {
+            Log.w(TAG, "Cannot read the live wallpaper", e);
+        }
+        return out;
+    }
+
+    private static void addComponents(Set<String> out, String flattened) {
+        if (TextUtils.isEmpty(flattened)) {
+            return;
+        }
+        for (String item : flattened.split(":")) {
+            final ComponentName component = ComponentName.unflattenFromString(item);
+            if (component != null) {
+                out.add(component.getPackageName());
+            }
+        }
+    }
+
+    private static JobScheduler scheduler(Context context) {
+        final JobScheduler scheduler = context.getSystemService(JobScheduler.class);
+        return scheduler == null ? null : scheduler.forNamespace(NAMESPACE);
+    }
+}
