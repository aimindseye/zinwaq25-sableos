+package com.android.settings.sable;
+
+/**
+ * Pure rules for Settings > Keyboard > Key remapping (2.0 plan, after q25toolbox's Key Remapper;
+ * ideas only, no code taken). The Q25 keys that can be remapped, and what each can become, as
+ * android.view.KeyEvent key codes. No android.* imports, unit-tested off the device.
+ */
+public final class SableKeyRemap {
+    /** The currency key: scan code 41, GRAVE; the Q25 types $ on it (device tree 1501). */
+    public static final int KEY_CURRENCY = 68;
+    /** Right Shift, scan code 54. */
+    public static final int KEY_SHIFT_RIGHT = 60;
+    /** The Recents key, scan code 580, APP_SWITCH (opens Active Frames). */
+    public static final int KEY_RECENTS = 187;
+
+    /** Keys offered, in the order the page lists them. */
+    public static final int[] KEYS = {KEY_CURRENCY, KEY_SHIFT_RIGHT, KEY_RECENTS};
+
+    /** 0 = the key's own job; then Ctrl, Alt, Tab, Esc, Menu and Search. */
+    public static final int DEFAULT = 0;
+    public static final int[] TARGETS = {DEFAULT, 114, 57, 61, 111, 82, 84};
+
+    private SableKeyRemap() {
+    }
+
+    /** Index into {@link #TARGETS} for what {@code key} is mapped to now (absent or itself = 0). */
+    public static int targetIndex(int key, int mappedTo) {
+        if (mappedTo == key || mappedTo <= 0) {
+            return 0;
+        }
+        for (int i = 1; i < TARGETS.length; i++) {
+            if (TARGETS[i] == mappedTo) {
+                return i;
+            }
+        }
+        return 0;
+    }
+
+    /**
+     * The key code to hand InputManager for choice {@code index}: the target, or the key itself,
+     * which clears its remapping.
+     */
+    public static int remapTo(int key, int index) {
+        return index <= 0 || index >= TARGETS.length ? key : TARGETS[index];
+    }
+
+    /** True for a key the page offers. */
+    public static boolean isOffered(int key) {
+        for (int k : KEYS) {
+            if (k == key) {
+                return true;
+            }
+        }
+        return false;
+    }
+}
