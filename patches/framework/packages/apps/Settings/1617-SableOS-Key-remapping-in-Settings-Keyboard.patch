+package com.android.settings.sable;
+
+import android.app.Activity;
+import android.app.AlertDialog;
+import android.hardware.input.InputManager;
+import android.os.Bundle;
+import android.util.TypedValue;
+import android.view.ViewGroup;
+import android.widget.LinearLayout;
+import android.widget.ScrollView;
+import android.widget.TextView;
+
+import com.android.settings.R;
+
+import java.util.Map;
+
+/**
+ * Settings > Keyboard > Key remapping: turn the Q25's currency key, right Shift or Recents key
+ * into Ctrl, Alt, Tab, Esc, Menu or Search, for every app, through InputManager's own key
+ * remapping (Settings holds REMAP_MODIFIER_KEYS; the system stores the choice and restores it at
+ * boot). Default gives the key its own job back. Keys first: the trackpad moves, Enter picks.
+ */
+public class SableKeyRemapActivity extends Activity {
+
+    private InputManager mInput;
+    private LinearLayout mRows;
+    private String[] mTargetLabels;
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        setTitle(R.string.sable_key_remap_title);
+        mInput = getSystemService(InputManager.class);
+        mTargetLabels = getResources().getStringArray(R.array.sable_key_remap_targets);
+        mRows = new LinearLayout(this);
+        mRows.setOrientation(LinearLayout.VERTICAL);
+        mRows.setPadding(0, dp(8), 0, dp(16));
+        ScrollView scroll = new ScrollView(this);
+        scroll.addView(mRows);
+        setContentView(scroll);
+        refresh();
+    }
+
+    private void refresh() {
+        mRows.removeAllViews();
+        Map<Integer, Integer> current = mInput.getModifierKeyRemapping();
+        String[] keyLabels = getResources().getStringArray(R.array.sable_key_remap_keys);
+        for (int i = 0; i < SableKeyRemap.KEYS.length; i++) {
+            final int key = SableKeyRemap.KEYS[i];
+            Integer mapped = current.get(key);
+            final int at = SableKeyRemap.targetIndex(key, mapped != null ? mapped : 0);
+            row(keyLabels[i], mTargetLabels[at], () -> new AlertDialog.Builder(this)
+                    .setTitle(keyLabels[indexOf(key)])
+                    .setSingleChoiceItems(mTargetLabels, at, (dialog, which) -> {
+                        dialog.dismiss();
+                        mInput.remapModifierKey(key, SableKeyRemap.remapTo(key, which));
+                        mRows.postDelayed(this::refresh, 300);
+                    })
+                    .setNegativeButton(android.R.string.cancel, null)
+                    .show());
+        }
+        TextView hint = new TextView(this);
+        hint.setText(R.string.sable_key_remap_hint);
+        hint.setTextSize(TypedValue.COMPLEX_UNIT_SP, 13);
+        hint.setPadding(dp(16), dp(12), dp(16), 0);
+        mRows.addView(hint);
+    }
+
+    private static int indexOf(int key) {
+        for (int i = 0; i < SableKeyRemap.KEYS.length; i++) {
+            if (SableKeyRemap.KEYS[i] == key) return i;
+        }
+        return 0;
+    }
+
+    private void row(String title, String summary, Runnable action) {
+        LinearLayout row = new LinearLayout(this);
+        row.setOrientation(LinearLayout.VERTICAL);
+        row.setPadding(dp(16), dp(10), dp(16), dp(10));
+        TextView t = new TextView(this);
+        t.setText(title);
+        t.setTextSize(TypedValue.COMPLEX_UNIT_SP, 17);
+        row.addView(t);
+        TextView s = new TextView(this);
+        s.setText(summary);
+        s.setTextSize(TypedValue.COMPLEX_UNIT_SP, 14);
+        s.setAlpha(0.7f);
+        row.addView(s);
+        TypedValue bg = new TypedValue();
+        getTheme().resolveAttribute(android.R.attr.selectableItemBackground, bg, true);
+        row.setBackgroundResource(bg.resourceId);
+        row.setFocusable(true);
+        row.setClickable(true);
+        row.setOnClickListener(v -> action.run());
+        mRows.addView(row, new LinearLayout.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+    }
+
+    private int dp(int v) {
+        return Math.round(v * getResources().getDisplayMetrics().density);
+    }
+}
