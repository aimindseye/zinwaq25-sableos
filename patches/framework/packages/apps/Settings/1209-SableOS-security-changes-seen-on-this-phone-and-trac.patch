+    @Test
+    public void ledgerFirstLookStoresBaselineThenListsChanges() {
+        final SecurityLedger.Outcome first = SecurityLedger.observe(null, null,
+                base().build(), 100);
+        assertTrue(first.firstLook);
+        assertTrue(first.events.isEmpty());
+        final SecuritySnapshot v2 = base().versionCode(11)
+                .trackers(Arrays.asList("Adjust")).build();
+        final SecurityLedger.Outcome second = SecurityLedger.observe(first.snapshotText,
+                first.eventsText, v2, 200);
+        assertFalse(second.firstLook);
+        assertEquals(2, second.newChanges.size());
+        assertEquals(200L, second.events.get(0).timeMillis);
+        // An identical look adds nothing and keeps the events.
+        final SecurityLedger.Outcome third = SecurityLedger.observe(second.snapshotText,
+                second.eventsText, v2, 300);
+        assertTrue(third.newChanges.isEmpty());
+        assertEquals(second.events.size(), third.events.size());
+        // A damaged baseline counts as a first look and keeps the events.
+        final SecurityLedger.Outcome damaged = SecurityLedger.observe("junk", second.eventsText, v2,
+                400);
+        assertTrue(damaged.firstLook);
+        assertEquals(second.events.size(), damaged.events.size());
+    }
