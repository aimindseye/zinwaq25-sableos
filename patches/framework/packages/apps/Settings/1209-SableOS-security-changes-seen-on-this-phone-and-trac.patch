+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.settings.applications.sable.model;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.Test;
+
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.List;
+
+public class SecurityHistoryTest {
+    private static SecuritySnapshot.Builder base() {
+        return new SecuritySnapshot.Builder().versionCode(10).targetSdk(34)
+                .signers(Arrays.asList("AA:BB"))
+                .permissions(Arrays.asList("android.permission.CAMERA"))
+                .exposed(Collections.<String>emptyList())
+                .elevated(Collections.<String>emptyList())
+                .trackers(Collections.<String>emptyList());
+    }
+
+    @Test
+    public void trackerMatchByComponentPrefix() {
+        assertEquals(Arrays.asList("AppsFlyer", "Google AdMob"), new java.util.ArrayList<>(
+                TrackerSignatures.matchComponents(Arrays.asList(
+                        "com.appsflyer.internal.Foo", "com.google.android.gms.ads.AdActivity",
+                        "com.example.app.Main"))));
+        // A look-alike package is not a match.
+        assertTrue(TrackerSignatures.matchComponents(
+                Arrays.asList("com.appsflyerx.Foo", "com.adjust.sdkx.A")).isEmpty());
+        assertTrue(TrackerSignatures.matchComponents(null).isEmpty());
+    }
+
+    @Test
+    public void trackerMatchByVersionFilesOnly() {
+        final TrackerSignatures.Scan scan = new TrackerSignatures.Scan();
+        scan.entry("classes.dex");
+        scan.entry("res/layout/firebase-analytics.xml");
+        assertTrue(scan.found().isEmpty());
+        assertFalse(scan.sawInput());
+        scan.entry("META-INF/com.google.firebase_firebase-analytics.version");
+        scan.entry("META-INF/com.google.android.gms_play-services-ads.version");
+        assertEquals(Arrays.asList("Google AdMob", "Google Firebase Analytics"),
+                new java.util.ArrayList<>(scan.found()));
+        assertTrue(scan.sawInput());
+        assertTrue(TrackerSignatures.size() >= 25);
+    }
+
+    @Test
+    public void snapshotRoundTripAndDamage() {
+        final SecuritySnapshot s = new SecuritySnapshot.Builder().versionCode(10).targetSdk(34)
+                .permissions(Arrays.asList("a.b.C", "x;y", "d.E")).build();
+        // A value the text form cannot hold is dropped, the rest survive in order.
+        assertEquals(Arrays.asList("a.b.C", "d.E"), new java.util.ArrayList<>(s.permissions));
+        final SecuritySnapshot back = SecuritySnapshot.decode(s.encode());
+        assertNotNull(back);
+        assertEquals(s.encode(), back.encode());
+        assertEquals(10L, back.versionCode);
+        assertFalse(back.componentsKnown || back.trackersKnown);
+        assertNull(SecuritySnapshot.decode(null));
+        assertNull(SecuritySnapshot.decode(""));
+        assertNull(SecuritySnapshot.decode("v2\nversion=1\ntarget=1\n"));
+        assertNull(SecuritySnapshot.decode("v1\nversion=abc\ntarget=1\n"));
+        assertNull(SecuritySnapshot.decode("v1\ntarget=1\n"));
+    }
+
+    private static boolean has(List<SecurityChanges.Change> l, SecurityChanges.Kind k, String s) {
+        for (SecurityChanges.Change c : l) {
+            if (c.kind == k && c.subject.equals(s)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    @Test
+    public void updateDeltaIsClassedAndOrdered() {
+        final SecuritySnapshot old = base().build();
+        final SecuritySnapshot now = new SecuritySnapshot.Builder().versionCode(11).targetSdk(30)
