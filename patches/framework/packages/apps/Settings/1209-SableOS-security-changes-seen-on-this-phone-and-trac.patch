+    /** Most events listed on the page; the phone keeps {@link SecurityChanges#MAX_EVENTS}. */
+    private static final int MAX_SHOWN_EVENTS = 8;
+
+    /**
+     * Compares the app with how this phone last saw it (kept on the phone, per user, only for
+     * apps whose page was opened) and lists what changed: permissions, signing, exported
+     * components, elevated services, target SDK and tracker signals.
+     */
+    private static void changes(Context context, Resources res, int uid, PackageInfo pi,
+            boolean componentsRead, TrackerSignatures.Scan trackers, List<Row> rows) {
+        final SecuritySnapshot.Builder b = new SecuritySnapshot.Builder()
+                .versionCode(pi.getLongVersionCode())
+                .targetSdk(pi.applicationInfo == null ? 0 : pi.applicationInfo.targetSdkVersion);
+        final SigningInfo signing = pi.signingInfo;
+        final Signature[] signers = signing == null ? null : signing.getApkContentsSigners();
+        if (signers != null) {
+            for (Signature signer : signers) {
+                final String digest = sha256(signer);
+                if (digest != null) {
+                    b.signers(Collections.singleton(digest));
+                }
+            }
+        }
+        if (pi.requestedPermissions != null) {
+            b.permissions(Arrays.asList(pi.requestedPermissions));
+        }
+        if (componentsRead) {
+            final List<String> exposed = new ArrayList<>();
+            final Set<String> elevated = new LinkedHashSet<>();
+            if (pi.activities != null) {
+                for (ActivityInfo a : pi.activities) {
+                    if (a.exported && TextUtils.isEmpty(a.permission)) {
+                        exposed.add(a.name);
+                    }
+                }
+            }
+            if (pi.services != null) {
+                for (ServiceInfo s : pi.services) {
+                    if (s.exported && TextUtils.isEmpty(s.permission)) {
+                        exposed.add(s.name);
+                    }
+                    final AppSecurityFacts.Elevated e = AppSecurityFacts.Elevated.of(s.permission);
+                    if (e != null) {
+                        elevated.add(e.name());
+                    }
+                }
+            }
+            if (pi.receivers != null) {
+                for (ActivityInfo r : pi.receivers) {
+                    if (r.exported && TextUtils.isEmpty(r.permission)) {
+                        exposed.add(r.name);
+                    }
+                    if (AppSecurityFacts.Elevated.of(r.permission)
+                            == AppSecurityFacts.Elevated.DEVICE_ADMIN) {
+                        elevated.add(AppSecurityFacts.Elevated.DEVICE_ADMIN.name());
+                    }
+                }
+            }
+            if (pi.providers != null) {
+                for (ProviderInfo p : pi.providers) {
+                    if (p.exported && TextUtils.isEmpty(p.readPermission)
+                            && TextUtils.isEmpty(p.writePermission)) {
+                        exposed.add(p.name);
+                    }
+                }
+            }
+            b.exposed(exposed).elevated(elevated);
+        }
+        if (trackers != null) {
+            b.trackers(trackers.found());
+        }
+        final SecurityLedger.Outcome outcome = SableSecurityHistoryStore.observe(context,
+                pi.packageName, UserHandle.getUserId(uid), b.build(), System.currentTimeMillis());
+        if (outcome.firstLook) {
+            rows.add(new Row(KEY_HISTORY, res.getString(R.string.sable_security_changes_title),
+                    ev(res, Evidence.OBSERVED,
+                            res.getString(R.string.sable_security_changes_first)), null));
+            return;
+        }
+        if (outcome.events.isEmpty()) {
+            rows.add(new Row(KEY_HISTORY, res.getString(R.string.sable_security_changes_title),
+                    ev(res, Evidence.OBSERVED,
+                            res.getString(R.string.sable_security_changes_none)), null));
+            return;
+        }
+        int shown = 0;
+        for (SecurityChanges.Event event : outcome.events) {
+            if (shown++ >= MAX_SHOWN_EVENTS) {
+                break;
+            }
+            final SecurityChanges.Change c = event.change;
+            rows.add(new Row(KEY_HISTORY, res.getString(R.string.sable_security_change_format,
+                            severityLabel(res, c.severity()), res.getString(kindRes(c.kind),
+                                    c.subject)),
+                    ev(res, Evidence.OBSERVED, res.getString(
+                            R.string.sable_security_change_when_format,
+                            time(context, res, event.timeMillis), event.versionCode)), null));
+        }
+    }
+
+    private static String severityLabel(Resources res, SecurityChanges.Severity s) {
+        switch (s) {
+            case CRITICAL:
+                return res.getString(R.string.sable_security_severity_critical);
+            case ELEVATED:
+                return res.getString(R.string.sable_security_severity_elevated);
+            case REVIEW:
+                return res.getString(R.string.sable_security_severity_review);
+            case PRIVACY:
+                return res.getString(R.string.sable_security_severity_privacy);
+            default:
+                return res.getString(R.string.sable_security_severity_info);
+        }
+    }
+
+    private static int kindRes(SecurityChanges.Kind k) {
+        switch (k) {
+            case VERSION_CHANGED:
+                return R.string.sable_security_change_version;
+            case SIGNER_CHANGED:
+                return R.string.sable_security_change_signer;
+            case PERMISSION_ADDED:
+                return R.string.sable_security_change_permission_added;
+            case PERMISSION_REMOVED:
+                return R.string.sable_security_change_permission_removed;
+            case COMPONENT_NEWLY_EXPORTED:
+                return R.string.sable_security_change_exported;
+            case COMPONENT_NO_LONGER_EXPORTED:
+                return R.string.sable_security_change_unexported;
+            case ELEVATED_ADDED:
+                return R.string.sable_security_change_elevated;
+            case TARGET_SDK_LOWERED:
+                return R.string.sable_security_change_target_sdk;
+            case TRACKER_ADDED:
+                return R.string.sable_security_change_tracker_added;
+            default:
+                return R.string.sable_security_change_tracker_removed;
+        }
     }
 
