+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.settings.applications.sable.model;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * The local record of one app's security changes. {@link #observe} takes the stored snapshot and
+ * events (text, as kept), the app as it is now and the time, and returns what to store and what
+ * is new. The first look at an app only stores a baseline; changes are listed from the second
+ * look on, so the record says "seen since this phone first looked", never "since install".
+ */
+public final class SecurityLedger {
+    private SecurityLedger() {}
+
+    /** The result of one look. */
+    public static final class Outcome {
+        public final String snapshotText;
+        public final String eventsText;
+        public final boolean firstLook;
+        /** Changes found by this look, most serious first. */
+        public final List<SecurityChanges.Change> newChanges;
+        /** All kept events, newest first, at most {@link SecurityChanges#MAX_EVENTS}. */
+        public final List<SecurityChanges.Event> events;
+
+        Outcome(String snapshotText, String eventsText, boolean firstLook,
+                List<SecurityChanges.Change> newChanges, List<SecurityChanges.Event> events) {
+            this.snapshotText = snapshotText;
+            this.eventsText = eventsText;
+            this.firstLook = firstLook;
+            this.newChanges = newChanges;
+            this.events = events;
+        }
+    }
+
+    public static Outcome observe(String storedSnapshot, String storedEvents,
+            SecuritySnapshot now, long nowMillis) {
+        final SecuritySnapshot old = SecuritySnapshot.decode(storedSnapshot);
+        final List<SecurityChanges.Event> kept = SecurityChanges.decodeEvents(storedEvents);
+        final String snapshotText = now.encode();
+        if (old == null) {
+            return new Outcome(snapshotText, SecurityChanges.encodeEvents(kept), true,
+                    new ArrayList<SecurityChanges.Change>(), kept);
+        }
+        final List<SecurityChanges.Change> changes = SecurityChanges.compare(old, now);
+        final List<SecurityChanges.Event> all = new ArrayList<>();
+        for (SecurityChanges.Change c : changes) {
+            all.add(new SecurityChanges.Event(nowMillis, now.versionCode, c));
+        }
+        all.addAll(kept);
+        final List<SecurityChanges.Event> bounded = all.size() > SecurityChanges.MAX_EVENTS
+                ? new ArrayList<>(all.subList(0, SecurityChanges.MAX_EVENTS)) : all;
+        return new Outcome(snapshotText, SecurityChanges.encodeEvents(bounded), false, changes,
+                bounded);
+    }
+}
diff --git a/src/com/android/settings/applications/sable/model/SecuritySnapshot.java b/src/com/android/settings/applications/sable/model/SecuritySnapshot.java
new file mode 100644
index 0000000..4e9a677
--- /dev/null
+++ b/src/com/android/settings/applications/sable/model/SecuritySnapshot.java
@@ -0,0 +1,239 @@
+/*
+ * Copyright (C) 2026 The SableOS Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.settings.applications.sable.model;
+
+import java.util.Collection;
+import java.util.Collections;
+import java.util.Set;
+import java.util.TreeSet;
+
+/**
+ * What matters for security about one installed version of an app, kept to compare with the
+ * next look: version, target SDK, signing certificates, requested permissions, exported
+ * components without a guarding permission, elevated service kinds and tracker signals.
+ * Immutable. The text form is line based ({@code key=a;b;c}) and decoding never throws: a
+ * damaged record reads as null, so the next look counts as a first look.
+ */
+public final class SecuritySnapshot {
+    private static final String HEADER = "v1";
+
+    public final long versionCode;
+    public final int targetSdk;
+    public final Set<String> signers;
+    public final Set<String> permissions;
+    /** Exported components with no guarding permission; only meaningful if componentsKnown. */
+    public final Set<String> exposed;
+    public final Set<String> elevated;
+    public final Set<String> trackers;
+    public final boolean componentsKnown;
+    public final boolean trackersKnown;
+
+    private SecuritySnapshot(Builder b) {
+        versionCode = b.mVersionCode;
+        targetSdk = b.mTargetSdk;
+        signers = clean(b.mSigners);
+        permissions = clean(b.mPermissions);
+        exposed = clean(b.mExposed);
+        elevated = clean(b.mElevated);
+        trackers = clean(b.mTrackers);
+        componentsKnown = b.mComponentsKnown;
+        trackersKnown = b.mTrackersKnown;
+    }
+
+    /** Sorted, immutable, and without values the text form could not hold. */
+    private static Set<String> clean(Collection<String> in) {
+        final Set<String> out = new TreeSet<>();
+        if (in != null) {
+            for (String s : in) {
+                if (s != null && !s.isEmpty() && s.indexOf(';') < 0 && s.indexOf('\n') < 0
+                        && s.indexOf('\r') < 0) {
+                    out.add(s);
+                }
+            }
+        }
+        return Collections.unmodifiableSet(out);
+    }
+
+    public String encode() {
+        final StringBuilder sb = new StringBuilder(HEADER).append('\n');
+        sb.append("version=").append(versionCode).append('\n');
+        sb.append("target=").append(targetSdk).append('\n');
+        sb.append("components=").append(componentsKnown ? 1 : 0).append('\n');
+        sb.append("trackersknown=").append(trackersKnown ? 1 : 0).append('\n');
+        line(sb, "signers", signers);
+        line(sb, "permissions", permissions);
+        line(sb, "exposed", exposed);
+        line(sb, "elevated", elevated);
+        line(sb, "trackers", trackers);
+        return sb.toString();
+    }
+
+    private static void line(StringBuilder sb, String key, Set<String> values) {
+        sb.append(key).append('=');
+        boolean first = true;
+        for (String v : values) {
+            if (!first) {
+                sb.append(';');
+            }
+            sb.append(v);
+            first = false;
+        }
+        sb.append('\n');
+    }
+
+    /** The snapshot {@link #encode} wrote, or null for missing or damaged text. */
+    public static SecuritySnapshot decode(String text) {
+        if (text == null) {
+            return null;
+        }
+        final String[] lines = text.split("\n");
+        if (lines.length == 0 || !HEADER.equals(lines[0])) {
+            return null;
+        }
+        final Builder b = new Builder();
+        int seen = 0;
+        for (int i = 1; i < lines.length; i++) {
+            final int eq = lines[i].indexOf('=');
+            if (eq <= 0) {
+                continue;
+            }
+            final String key = lines[i].substring(0, eq);
+            final String value = lines[i].substring(eq + 1);
+            try {
+                switch (key) {
+                    case "version":
+                        b.versionCode(Long.parseLong(value));
+                        seen++;
+                        break;
+                    case "target":
+                        b.targetSdk(Integer.parseInt(value));
+                        seen++;
+                        break;
+                    case "components":
+                        b.componentsKnown("1".equals(value));
+                        break;
+                    case "trackersknown":
+                        b.trackersKnown("1".equals(value));
+                        break;
+                    case "signers":
+                        b.mSigners.addAll(split(value));
+                        break;
+                    case "permissions":
+                        b.mPermissions.addAll(split(value));
+                        break;
+                    case "exposed":
+                        b.mExposed.addAll(split(value));
+                        break;
+                    case "elevated":
+                        b.mElevated.addAll(split(value));
+                        break;
+                    case "trackers":
+                        b.mTrackers.addAll(split(value));
+                        break;
+                    default:
+                        break;
+                }
+            } catch (NumberFormatException e) {
+                return null;
+            }
+        }
+        return seen == 2 ? b.build() : null;
+    }
+
+    private static Set<String> split(String value) {
+        final Set<String> out = new TreeSet<>();
+        if (!value.isEmpty()) {
+            Collections.addAll(out, value.split(";"));
+        }
+        return out;
+    }
+
+    public static final class Builder {
+        private long mVersionCode;
+        private int mTargetSdk;
+        private final Set<String> mSigners = new TreeSet<>();
+        private final Set<String> mPermissions = new TreeSet<>();
+        private final Set<String> mExposed = new TreeSet<>();
+        private final Set<String> mElevated = new TreeSet<>();
+        private final Set<String> mTrackers = new TreeSet<>();
+        private boolean mComponentsKnown;
+        private boolean mTrackersKnown;
+
+        public Builder versionCode(long v) {
+            mVersionCode = v;
+            return this;
+        }
+
+        public Builder targetSdk(int v) {
+            mTargetSdk = v;
+            return this;
+        }
+
+        public Builder signers(Collection<String> v) {
+            if (v != null) {
+                mSigners.addAll(v);
+            }
+            return this;
+        }
+
+        public Builder permissions(Collection<String> v) {
+            if (v != null) {
+                mPermissions.addAll(v);
+            }
+            return this;
+        }
+
+        /** Marks the component facts as read and sets the exported-unguarded names. */
+        public Builder exposed(Collection<String> v) {
+            mComponentsKnown = true;
+            if (v != null) {
+                mExposed.addAll(v);
+            }
+            return this;
+        }
+
+        public Builder elevated(Collection<String> v) {
+            if (v != null) {
+                mElevated.addAll(v);
+            }
+            return this;
+        }
+
+        /** Marks the tracker facts as read and sets the signals found. */
+        public Builder trackers(Collection<String> v) {
+            mTrackersKnown = true;
+            if (v != null) {
+                mTrackers.addAll(v);
+            }
+            return this;
+        }
+
+        Builder componentsKnown(boolean v) {
+            mComponentsKnown = v;
+            return this;
+        }
+
+        Builder trackersKnown(boolean v) {
+            mTrackersKnown = v;
+            return this;
+        }
+
+        public SecuritySnapshot build() {
+            return new SecuritySnapshot(this);
+        }
+    }
+}
diff --git a/src/com/android/settings/applications/sable/model/TrackerSignatures.java b/src/com/android/settings/applications/sable/model/TrackerSignatures.java
