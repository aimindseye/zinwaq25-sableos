index 0000000..7905c58
--- /dev/null
+++ b/tests/sable-apps/src/com/android/settings/applications/sable/model/SecurityHistoryTest.java
@@ -0,0 +1,179 @@
+/*
+ * Copyright (C) 2026 The SableOS Project
+ *
