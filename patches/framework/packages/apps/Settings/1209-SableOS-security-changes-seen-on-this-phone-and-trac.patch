+package com.android.settings.applications.sable;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+
+import com.android.settings.applications.sable.model.SecurityLedger;
+import com.android.settings.applications.sable.model.SecuritySnapshot;
+
+/**
+ * Where the App Security &amp; Privacy page keeps what it saw of each app: the last snapshot and
+ * the recent changes, per app and user, in device-protected storage on this phone. Nothing is
+ * sent anywhere and nothing is read from the app's own data. Only apps whose page was opened
+ * have a record, so the history reads "since this phone first looked", not "since install".
+ */
+final class SableSecurityHistoryStore {
+    private static final String PREFS = "sable_security_history";
+    private static final Object LOCK = new Object();
+
+    private SableSecurityHistoryStore() {
+    }
+
+    /** Records this look at {@code pkg} for {@code userId} and returns what it showed. */
+    static SecurityLedger.Outcome observe(Context context, String pkg, int userId,
+            SecuritySnapshot now, long nowMillis) {
+        final SharedPreferences prefs = context.createDeviceProtectedStorageContext()
+                .getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+        final String id = pkg + "@" + userId;
+        synchronized (LOCK) {
+            final SecurityLedger.Outcome outcome = SecurityLedger.observe(
+                    prefs.getString("snap:" + id, null), prefs.getString("events:" + id, null),
+                    now, nowMillis);
+            prefs.edit().putString("snap:" + id, outcome.snapshotText)
+                    .putString("events:" + id, outcome.eventsText).commit();
+            return outcome;
+        }
+    }
+}
diff --git a/src/com/android/settings/applications/sable/model/SecurityChanges.java b/src/com/android/settings/applications/sable/model/SecurityChanges.java
