+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.settings.applications.sable.model;
+
+import java.util.Collection;
+import java.util.Locale;
+import java.util.Set;
+import java.util.TreeSet;
+
+/**
+ * Known tracker and analytics libraries, matched locally against what an installed app ships:
+ * the class names of its manifest components, and the Gradle module version files that build
+ * tools leave in {@code META-INF/} of the APK. A match is an INFERRED privacy signal, not proof
+ * that the code ran or sent anything; no match does not prove the app has none (code that
+ * declares no component and ships no version file is not seen). The list is small, ships with
+ * the system and is never fetched; {@link #LIST_VERSION} names it on the page.
+ */
+public final class TrackerSignatures {
+    public static final String LIST_VERSION = "2026-10";
+
+    /** One library: a display name, component package prefixes and META-INF name fragments. */
+    private static final class Signature {
+        final String name;
+        final String[] prefixes;
+        final String[] fragments;
+
+        Signature(String name, String[] prefixes, String... fragments) {
+            this.name = name;
+            this.prefixes = prefixes;
+            this.fragments = fragments;
+        }
+    }
+
+    private static String[] p(String... prefixes) {
+        return prefixes;
+    }
+
+    private static final Signature[] LIST = {
+        new Signature("Google Firebase Analytics",
+                p("com.google.firebase.analytics", "com.google.android.gms.measurement"),
+                "firebase-analytics", "play-services-measurement"),
+        new Signature("Google AdMob", p("com.google.android.gms.ads"), "play-services-ads"),
+        new Signature("Firebase Crashlytics (crash reports)",
+                p("com.google.firebase.crashlytics"), "firebase-crashlytics"),
+        new Signature("Meta Audience Network", p("com.facebook.ads"), "audience-network"),
+        new Signature("AppsFlyer", p("com.appsflyer")),
+        new Signature("Adjust", p("com.adjust.sdk")),
+        new Signature("Branch", p("io.branch")),
+        new Signature("Kochava", p("com.kochava")),
+        new Signature("Singular", p("com.singular.sdk")),
+        new Signature("Flurry", p("com.flurry")),
+        new Signature("Mixpanel", p("com.mixpanel")),
+        new Signature("Amplitude", p("com.amplitude")),
+        new Signature("Segment", p("com.segment.analytics")),
+        new Signature("Braze", p("com.braze", "com.appboy")),
+        new Signature("OneSignal", p("com.onesignal")),
+        new Signature("CleverTap", p("com.clevertap")),
+        new Signature("Unity Ads", p("com.unity3d.ads")),
+        new Signature("AppLovin", p("com.applovin")),
+        new Signature("ironSource", p("com.ironsource")),
+        new Signature("Vungle (Liftoff)", p("com.vungle")),
+        new Signature("Chartboost", p("com.chartboost")),
+        new Signature("InMobi", p("com.inmobi")),
+        new Signature("StartApp", p("com.startapp")),
+        new Signature("Tapjoy", p("com.tapjoy")),
+        new Signature("Fyber", p("com.fyber")),
+        new Signature("Bugsnag (crash reports)", p("com.bugsnag")),
+        new Signature("Microsoft App Center", p("com.microsoft.appcenter")),
+        new Signature("Yandex Metrica", p("com.yandex.metrica")),
+        new Signature("Umeng", p("com.umeng")),
+        new Signature("Baidu Mobstat", p("com.baidu.mobstat")),
+    };
+
+    private TrackerSignatures() {}
+
+    /** How many signatures the list holds. */
+    public static int size() {
+        return LIST.length;
+    }
+
+    /** The tracker libraries a package's component class names point to, sorted. */
+    public static Set<String> matchComponents(Collection<String> classNames) {
+        final Scan scan = new Scan();
+        if (classNames != null) {
+            for (String name : classNames) {
+                scan.component(name);
+            }
+        }
+        return scan.found();
+    }
+
+    /** Incremental, bounded matcher: feed component names and APK entry names, then read. */
+    public static final class Scan {
+        private final Set<String> mFound = new TreeSet<>();
+        private boolean mAny;
+
+        /** Offers one manifest component class name. */
+        public void component(String className) {
+            if (className == null || className.isEmpty()) {
+                return;
+            }
+            mAny = true;
+            for (Signature s : LIST) {
+                if (mFound.contains(s.name)) {
+                    continue;
+                }
+                for (String prefix : s.prefixes) {
+                    if (className.equals(prefix) || className.startsWith(prefix + ".")) {
+                        mFound.add(s.name);
+                        break;
+                    }
+                }
+            }
+        }
+
+        /** Offers one APK entry name; only {@code META-INF/*.version} files are looked at. */
+        public void entry(String entryName) {
+            if (entryName == null || !entryName.startsWith("META-INF/")
+                    || !entryName.endsWith(".version")) {
+                return;
+            }
+            mAny = true;
+            final String lower = entryName.toLowerCase(Locale.ROOT);
+            for (Signature s : LIST) {
+                if (mFound.contains(s.name)) {
+                    continue;
+                }
+                for (String fragment : s.fragments) {
+                    if (lower.contains(fragment)) {
+                        mFound.add(s.name);
+                        break;
+                    }
+                }
+            }
+        }
+
+        /** Whether anything was offered (names or version files) to look at. */
+        public boolean sawInput() {
+            return mAny;
+        }
+
+        public Set<String> found() {
+            return java.util.Collections.unmodifiableSet(new TreeSet<>(mFound));
+        }
+    }
+}
diff --git a/tests/sable-apps/src/com/android/settings/applications/sable/model/SecurityHistoryTest.java b/tests/sable-apps/src/com/android/settings/applications/sable/model/SecurityHistoryTest.java
