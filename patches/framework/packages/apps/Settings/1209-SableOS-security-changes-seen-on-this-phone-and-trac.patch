+
+package com.android.settings.applications.sable.model;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.Comparator;
+import java.util.List;
+import java.util.Set;
+
+/**
+ * What changed between two {@link SecuritySnapshot}s of one app, classed as the application
+ * security policy asks (Info, Review, Elevated, Critical, Privacy signal) without a score, and
+ * the bounded list of such events kept on the phone. Pure; the Android layer only stores text.
+ */
+public final class SecurityChanges {
+    public static final int MAX_EVENTS = 40;
+
+    /** In the policy's wording; {@link #rank} orders them for display, most serious first. */
+    public enum Severity {
+        INFO(0), PRIVACY(1), REVIEW(2), ELEVATED(3), CRITICAL(4);
+
+        private final int mRank;
+
+        Severity(int rank) {
+            mRank = rank;
+        }
+
+        public int rank() {
+            return mRank;
+        }
+    }
+
+    public enum Kind {
+        VERSION_CHANGED,
+        SIGNER_CHANGED,
+        PERMISSION_ADDED,
+        PERMISSION_REMOVED,
+        COMPONENT_NEWLY_EXPORTED,
+        COMPONENT_NO_LONGER_EXPORTED,
+        ELEVATED_ADDED,
+        TARGET_SDK_LOWERED,
+        TRACKER_ADDED,
+        TRACKER_REMOVED
+    }
+
+    /** Permissions whose addition is classed Elevated rather than Review. */
+    private static final Set<String> ELEVATED_PERMISSIONS = new java.util.HashSet<>(
+            java.util.Arrays.asList(
+                    "android.permission.ACCESS_BACKGROUND_LOCATION",
+                    "android.permission.SYSTEM_ALERT_WINDOW",
+                    "android.permission.REQUEST_INSTALL_PACKAGES",
+                    "android.permission.MANAGE_EXTERNAL_STORAGE",
+                    "android.permission.BIND_ACCESSIBILITY_SERVICE",
+                    "android.permission.BIND_DEVICE_ADMIN"));
+
+    /** One difference: what kind, and the permission, component, tracker or version it names. */
+    public static final class Change {
+        public final Kind kind;
+        public final String subject;
+
+        public Change(Kind kind, String subject) {
+            this.kind = kind;
+            this.subject = subject == null ? "" : subject;
+        }
+
+        public Severity severity() {
+            return SecurityChanges.severity(kind, subject);
+        }
+    }
+
+    /** A change as kept: when it was seen and the version that showed it. */
+    public static final class Event {
+        public final long timeMillis;
+        public final long versionCode;
+        public final Change change;
+
+        public Event(long timeMillis, long versionCode, Change change) {
+            this.timeMillis = timeMillis;
+            this.versionCode = versionCode;
+            this.change = change;
+        }
+    }
+
+    private SecurityChanges() {}
+
+    public static Severity severity(Kind kind, String subject) {
+        switch (kind) {
+            case SIGNER_CHANGED:
+                return Severity.CRITICAL;
+            case ELEVATED_ADDED:
+                return Severity.ELEVATED;
+            case PERMISSION_ADDED:
+                return ELEVATED_PERMISSIONS.contains(subject) ? Severity.ELEVATED : Severity.REVIEW;
+            case COMPONENT_NEWLY_EXPORTED:
+            case TARGET_SDK_LOWERED:
+                return Severity.REVIEW;
+            case TRACKER_ADDED:
+                return Severity.PRIVACY;
+            default:
+                return Severity.INFO;
+        }
+    }
+
+    /** Differences from {@code old} to {@code now}, most serious first. Null old: none. */
+    public static List<Change> compare(SecuritySnapshot old, SecuritySnapshot now) {
+        final List<Change> out = new ArrayList<>();
+        if (old == null || now == null) {
+            return out;
+        }
+        if (old.versionCode != now.versionCode) {
+            out.add(new Change(Kind.VERSION_CHANGED, Long.toString(now.versionCode)));
+        }
+        if (!old.signers.isEmpty() && !now.signers.isEmpty() && !old.signers.equals(now.signers)) {
+            out.add(new Change(Kind.SIGNER_CHANGED, ""));
+        }
+        if (old.targetSdk > 0 && now.targetSdk > 0 && now.targetSdk < old.targetSdk) {
+            out.add(new Change(Kind.TARGET_SDK_LOWERED, Integer.toString(now.targetSdk)));
+        }
+        diff(old.permissions, now.permissions, Kind.PERMISSION_ADDED, Kind.PERMISSION_REMOVED,
+                out);
+        if (old.componentsKnown && now.componentsKnown) {
+            diff(old.exposed, now.exposed, Kind.COMPONENT_NEWLY_EXPORTED,
+                    Kind.COMPONENT_NO_LONGER_EXPORTED, out);
+            diff(old.elevated, now.elevated, Kind.ELEVATED_ADDED, null, out);
+        }
+        if (old.trackersKnown && now.trackersKnown) {
+            diff(old.trackers, now.trackers, Kind.TRACKER_ADDED, Kind.TRACKER_REMOVED, out);
+        }
+        Collections.sort(out, new Comparator<Change>() {
+            @Override
+            public int compare(Change a, Change b) {
+                final int bySeverity = b.severity().rank() - a.severity().rank();
+                if (bySeverity != 0) {
+                    return bySeverity;
+                }
+                final int byKind = a.kind.ordinal() - b.kind.ordinal();
+                return byKind != 0 ? byKind : a.subject.compareTo(b.subject);
+            }
+        });
+        return out;
+    }
+
+    private static void diff(Set<String> before, Set<String> after, Kind added, Kind removed,
+            List<Change> out) {
+        for (String s : after) {
+            if (!before.contains(s)) {
+                out.add(new Change(added, s));
+            }
+        }
+        if (removed != null) {
+            for (String s : before) {
+                if (!after.contains(s)) {
+                    out.add(new Change(removed, s));
+                }
+            }
+        }
+    }
+
+    /** One line per event: {@code time|version|KIND|subject}, newest first. */
+    public static String encodeEvents(List<Event> events) {
+        final StringBuilder sb = new StringBuilder();
+        if (events != null) {
+            for (Event e : events) {
+                if (e.change.subject.indexOf('|') >= 0 || e.change.subject.indexOf('\n') >= 0) {
+                    continue;
+                }
+                sb.append(e.timeMillis).append('|').append(e.versionCode).append('|')
+                        .append(e.change.kind.name()).append('|').append(e.change.subject)
+                        .append('\n');
+            }
+        }
+        return sb.toString();
+    }
+
+    /** Reads {@link #encodeEvents}; damaged lines are dropped, never thrown. */
+    public static List<Event> decodeEvents(String text) {
+        final List<Event> out = new ArrayList<>();
+        if (text == null) {
+            return out;
+        }
+        for (String line : text.split("\n")) {
+            final String[] parts = line.split("\\|", 4);
+            if (parts.length < 3) {
+                continue;
+            }
+            try {
+                out.add(new Event(Long.parseLong(parts[0]), Long.parseLong(parts[1]),
+                        new Change(Kind.valueOf(parts[2]), parts.length == 4 ? parts[3] : "")));
+            } catch (IllegalArgumentException e) {
+                // A damaged or unknown line is dropped.
+            }
+            if (out.size() >= MAX_EVENTS) {
+                break;
+            }
+        }
+        return out;
+    }
+}
