+<resources>
+    <!-- Settings > System > Keyboard: title of the info row about the hardware keyboard's light. -->
+    <string name="sable_keyboard_backlight_title">Keyboard light</string>
+    <!-- Settings > System > Keyboard: the keyboard firmware owns its light; this row only says how to use it. -->
+    <string name="sable_keyboard_backlight_summary">Your keyboard controls its own light. Press Sym+0 to turn it on or off. With the PaBaLF keyboard firmware, Sym+Shift+1 to 9 sets the level.</string>
+    <!-- Search keywords for the keyboard light info row. [CHAR LIMIT=NONE] -->
+    <string name="keywords_sable_keyboard_backlight">keyboard light, backlight, kb light</string>
+</resources>
diff --git a/res/xml/keyboard_settings.xml b/res/xml/keyboard_settings.xml
index 4afd9c9..2214e7c 100644
--- a/res/xml/keyboard_settings.xml
+++ b/res/xml/keyboard_settings.xml
@@ -54,6 +54,17 @@
             settings:controller="com.android.settings.language.UserDictionaryPreferenceController" />
     </PreferenceCategory>
 
+    <!-- SableOS: hardware keyboard light, on devices that set ro.sable.keyboard_backlight.
+         The keyboard firmware owns the light, so this row only explains its keys. -->
+    <Preference
+        android:key="sable_keyboard_backlight"
+        android:title="@string/sable_keyboard_backlight_title"
+        android:summary="@string/sable_keyboard_backlight_summary"
+        android:persistent="false"
+        android:selectable="false"
+        settings:keywords="@string/keywords_sable_keyboard_backlight"
+        settings:controller="com.android.settings.sable.SableKeyboardBacklightPreferenceController" />
+
     <lineageos.preference.LineageSecureSettingSwitchPreference
         android:key="feature_touch_hovering"
         android:title="@string/touchscreen_hovering_title"
