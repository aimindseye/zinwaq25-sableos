+package com.android.settings.sable;
+
+import android.content.Context;
+import android.os.SystemProperties;
+
+import com.android.settings.core.BasePreferenceController;
+
+/**
+ * Settings > System > Keyboard > Keyboard light: a read-only row that explains the keyboard's
+ * own light keys. On the Zinwa Q25 the keyboard firmware owns the backlight and ignores host
+ * writes, so Settings offers no switch or slider. Shown only where the device's product layer
+ * sets ro.sable.keyboard_backlight.
+ */
+public class SableKeyboardBacklightPreferenceController extends BasePreferenceController {
+
+    /** Set to true by the device's product layer on devices with a lit hardware keyboard. */
+    static final String PROP_SUPPORTED = "ro.sable.keyboard_backlight";
+
+    public SableKeyboardBacklightPreferenceController(Context context, String preferenceKey) {
+        super(context, preferenceKey);
+    }
+
+    static boolean isDeviceSupported() {
+        return SystemProperties.getBoolean(PROP_SUPPORTED, false);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return isDeviceSupported() ? AVAILABLE : UNSUPPORTED_ON_DEVICE;
+    }
+}
