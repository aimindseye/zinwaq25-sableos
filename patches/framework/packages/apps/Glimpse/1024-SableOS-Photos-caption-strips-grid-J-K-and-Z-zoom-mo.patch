+        /** SableOS: Z, zoom mode: one step in when the photo fits, else back to fit. */
+        fun zoomToggle() {
+            if (!imageView.isVisible) {
+                return
+            }
+            val zoomable = imageView.zoomable
+            val fits = zoomable.transformState.value.scaleX <=
+                    zoomable.minScaleState.value * SABLE_FIT_TOLERANCE
+            zoomStep(if (fits) 1 else 0)
+        }
