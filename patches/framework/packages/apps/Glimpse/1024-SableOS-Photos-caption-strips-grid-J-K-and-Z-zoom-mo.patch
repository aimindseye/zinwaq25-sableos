+    /** J / K: focus the previous / next photo in the grid, skipping date headers. */
+    private fun moveSableFocus(itemView: View, next: Boolean) {
+        val from = recyclerView.getChildAdapterPosition(itemView)
+        if (from == RecyclerView.NO_POSITION) return
+        val step = if (next) 1 else -1
+        var target = from + step
+        while (target in 0 until thumbnailAdapter.itemCount &&
+            thumbnailAdapter.itemKeyProvider.getKey(target) == null
+        ) {
+            target += step
+        }
+        if (target !in 0 until thumbnailAdapter.itemCount) return
+        recyclerView.scrollToPosition(target)
+        recyclerView.post {
+            recyclerView.findViewHolderForAdapterPosition(target)?.itemView?.requestFocus()
+        }
+    }
+
+    /**
+     * The caption strip (artifact state 3: "IMG_2042 · 12:42 [Enter Open] [J/K Prev/Next]"):
+     * shown while a thumbnail has keyboard focus on a device with a hardware keyboard.
+     */
+    private fun updateSableCaption() {
+        val focused = recyclerView.focusedChild
+        val position = focused?.let { recyclerView.getChildAdapterPosition(it) }
+            ?: RecyclerView.NO_POSITION
+        val media = position.takeIf { it != RecyclerView.NO_POSITION }
+            ?.let { thumbnailAdapter.itemKeyProvider.getKey(it) }
+        val hasKeyboard = resources.configuration.keyboard != Configuration.KEYBOARD_NOKEYS
+        val show = media != null && hasKeyboard
+        if (show) {
+            val time = DateUtils.formatDateTime(
+                requireContext(), media!!.dateAdded.time,
+                DateUtils.FORMAT_SHOW_DATE or DateUtils.FORMAT_SHOW_TIME or
+                        DateUtils.FORMAT_ABBREV_MONTH
+            )
+            sableCaptionStrip.text = SableGalleryKeys.gridCaption(media.displayName, time)
+        }
+        if (sableCaptionStrip.isVisible != show) {
+            sableCaptionStrip.isVisible = show
+            applySableCaptionPadding()
+        }
+    }
+
+    private fun applySableCaptionPadding() {
+        val caption = if (sableCaptionStrip.isVisible) sableCaptionStrip.height else 0
+        recyclerView.updatePadding(bottom = sableInsetBottom + caption)
+    }
+
