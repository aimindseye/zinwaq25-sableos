+            case KEYCODE_Z:
+                return Action.ZOOM_TOGGLE;
             case KEYCODE_F:
                 return Action.FAVORITE;
             case KEYCODE_D:
@@ -152,7 +162,11 @@ public final class SableGalleryKeys {
         switch (keyCode) {
             case KEYCODE_SPACE:
                 return Action.OPEN;
-            case KEYCODE_S:
