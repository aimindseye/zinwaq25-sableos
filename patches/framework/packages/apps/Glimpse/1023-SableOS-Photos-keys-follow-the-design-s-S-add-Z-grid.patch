+            case KEYCODE_E:
                 return picking ? Action.NONE : Action.SHARE;
             case KEYCODE_D:
             case KEYCODE_DEL:
@@ -163,6 +177,24 @@ public final class SableGalleryKeys {
         }
     }
 
+    /** The viewer caption strip (artifact state 4). */
+    public static final String VIEWER_CAPTION =
+            "[J Prev] [K Next] [Z Zoom] [D Del] \u00b7 [I Info] [E Share] [F Fav]";
+
+    /** The contact sheet caption strip's key line (artifact state 3). */
+    public static final String GRID_CAPTION_KEYS =
+            "[Enter Open] [J/K Prev/Next] [E Share] [D Del]";
+
+    /** The contact sheet caption: the focused item's name and time, then the key line. */
+    public static String gridCaption(String name, String time) {
+        final StringBuilder out = new StringBuilder();
+        out.append(name == null || name.isEmpty() ? "\u2014" : name);
+        if (time != null && !time.isEmpty()) {
+            out.append(" \u00b7 ").append(time);
+        }
+        return out.append('\n').append(GRID_CAPTION_KEYS).toString();
+    }
+
