+    private fun onThumbnailKey(itemView: View, media: Media, event: KeyEvent): Boolean {
+        val action = SableGalleryKeys.grid(
+            event.keyCode,
+            event.isAltPressed,
+            event.isCtrlPressed,
+            event.isShiftPressed,
+            event.isMetaPressed,
+            intentsViewModel.isPicking.value,
+        )
+        if (action == SableGalleryKeys.Action.NONE) {
+            return false
+        }
+        if (event.action != KeyEvent.ACTION_DOWN || event.repeatCount > 0) {
+            return true
+        }
+
+        val targets = selectionTracker?.selection?.toList()?.takeUnless {
+            it.isEmpty()
+        }?.toTypedArray() ?: arrayOf(media)
+
+        when (action) {
+            SableGalleryKeys.Action.OPEN -> itemView.performClick()
+
+            SableGalleryKeys.Action.SHARE -> requireActivity().startActivity(
+                buildShareIntent(*targets)
+            )
+
+            SableGalleryKeys.Action.DELETE -> when (
+                viewModel.albumRequest.value?.albumType == AlbumType.TRASH
+            ) {
+                true -> MediaDialogsUtils.openDeleteForeverDialog(requireContext(), *targets) {
+                    lastProcessedSelection = it
+                    deleteForeverContract.launch(
+                        requireContext().contentResolver.createDeleteRequest(
+                            *it.map { media -> media.uri }.toTypedArray()
+                        )
+                    )
+                }
+
+                false -> MediaDialogsUtils.openMoveToTrashDialog(requireContext(), *targets) {
+                    trashMedias(true, *it)
+                }
+            }
+
+            else -> Unit
+        }
+
+        return true
+    }
