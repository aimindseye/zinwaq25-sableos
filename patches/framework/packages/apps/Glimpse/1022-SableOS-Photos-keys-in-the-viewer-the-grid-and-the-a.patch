+    private fun navigate(forward: Boolean) {
+        viewPager.adapter?.let { adapter ->
+            val currentPosition = viewPager.currentItem
+
+            val newPosition = if (forward) {
+                currentPosition + 1
+            } else {
+                currentPosition - 1
+            }
+
+            if (newPosition in 0 until adapter.itemCount) {
+                viewPager.setCurrentItem(newPosition, true)
+            }
+        }
+    }
+
+    // SableOS: viewer keys (sable/SableGalleryKeys.java). Arrows, Space and Enter stay with a
+    // focused toolbar or bottom-bar button; dialogs get their own keys.
+    override fun dispatchKeyEvent(event: KeyEvent): Boolean {
+        val media = viewModel.displayedMedia.value
+        val action = SableGalleryKeys.viewer(
+            event.keyCode,
+            event.getUnicodeChar(event.metaState),
+            event.isAltPressed,
+            event.isCtrlPressed,
+            event.isShiftPressed,
+            event.isMetaPressed,
+            appBarLayout.hasFocus() || bottomSheetLinearLayout.hasFocus(),
+            media?.mediaType == MediaType.VIDEO,
+        )
+        if (media == null || action == SableGalleryKeys.Action.NONE) {
+            return super.dispatchKeyEvent(event)
+        }
+        if (event.action == KeyEvent.ACTION_DOWN &&
+            (event.repeatCount == 0 || SableGalleryKeys.repeats(action))
+        ) {
+            runViewerAction(action, media)
+        }
+        return true
+    }
+
+    private fun runViewerAction(action: SableGalleryKeys.Action, media: Media) {
+        when (action) {
+            SableGalleryKeys.Action.PREVIOUS -> navigate(false)
+            SableGalleryKeys.Action.NEXT -> navigate(true)
+            SableGalleryKeys.Action.PLAY_PAUSE -> viewModel.exoPlayer.let {
+                when {
+                    it.isPlaying -> viewModel.pause()
+                    it.playbackState == Player.STATE_ENDED -> {
+                        it.seekTo(0)
+                        viewModel.play()
+                    }
+
+                    else -> viewModel.play()
+                }
+            }
+
+            SableGalleryKeys.Action.ZOOM_IN -> currentMediaViewHolder()?.zoomStep(1)
+            SableGalleryKeys.Action.ZOOM_OUT -> currentMediaViewHolder()?.zoomStep(-1)
+            SableGalleryKeys.Action.ZOOM_FIT -> currentMediaViewHolder()?.zoomStep(0)
+            SableGalleryKeys.Action.INFO -> if (infoButton.isVisible) {
+                toolbar.menu.performIdentifierAction(R.id.info, 0)
+            }
+
+            SableGalleryKeys.Action.SHARE -> if (shareButton.isVisible) {
+                shareButton.performClick()
+            }
+
+            SableGalleryKeys.Action.FAVORITE -> if (favoriteButton.isVisible) {
+                favoriteButton.performClick()
+            }
+
+            // The on-screen trash button trashes at once (MediaStore may still ask); the
+            // key always asks first. On a trashed item it deletes forever, after asking.
+            SableGalleryKeys.Action.DELETE -> if (deleteButton.isVisible) {
+                when (media.isTrashed) {
+                    true -> MediaDialogsUtils.openDeleteForeverDialog(this, media.uri) { uris ->
+                        deleteUriContract.launch(contentResolver.createDeleteRequest(*uris))
+                    }
+
+                    false -> MediaDialogsUtils.openMoveToTrashDialog(this, media) {
+                        dismissKeyguardAndRun {
+                            trashMedia(media)
+                        }
+                    }
+                }
+            }
+
+            SableGalleryKeys.Action.OPEN,
+            SableGalleryKeys.Action.NONE -> Unit
+        }
+    }
+
+    private fun currentMediaViewHolder(): MediaViewerAdapter.MediaViewHolder? {
+        val recyclerView = viewPager.getChildAt(0) as? RecyclerView ?: return null
+        val holder = recyclerView.findViewHolderForAdapterPosition(viewPager.currentItem)
+        return holder as? MediaViewerAdapter.MediaViewHolder
+    }
+
