+                    zoomable.transformState.value.scaleX,
+                    minScale,
+                    zoomable.maxScaleState.value,
+                    step > 0,
+                )
+            }
+            itemView.findViewTreeLifecycleOwner()?.lifecycleScope?.launch {
+                zoomable.scale(targetScale, animated = true)
+            }
+        }
