+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.contacts.list;
+
+import android.app.KeyguardManager;
+import android.content.AsyncTaskLoader;
+import android.content.Context;
+import android.content.Intent;
+import android.database.Cursor;
+import android.net.Uri;
+import android.provider.ContactsContract;
+import android.provider.ContactsContract.CommonDataKinds.Email;
+import android.util.Log;
+
+import com.android.contacts.sable.SablePreferredNumbers;
+import com.android.contacts.sable.SableRoutes;
+
+import java.util.HashSet;
+import java.util.Set;
+
+/**
+ * Sable: what the route subtitle needs beyond the default number, loaded off the main thread
+ * with read-only queries: which contacts have an email address (bounded), whether Sable
+ * Messages can open a conversation, and whether rows hide numbers (locked device or Sable private
+ * mode, read from Hub's read-only provider). Reloads on Email data and private mode changes.
+ * Writes nothing.
+ */
+final class SableRouteLoader extends AsyncTaskLoader<SableRouteLoader.Data> {
+
+    /** Immutable result. */
+    static final class Data {
+        static final Data EMPTY = new Data(new HashSet<>(), false, false, false);
+
+        final Set<Long> emailContacts;
+        final boolean hubAvailable;
+        final boolean deviceLocked;
+        final boolean privateMode;
+
+        Data(Set<Long> emailContacts, boolean hubAvailable, boolean deviceLocked,
+                boolean privateMode) {
+            this.emailContacts = emailContacts;
+            this.hubAvailable = hubAvailable;
+            this.deviceLocked = deviceLocked;
+            this.privateMode = privateMode;
+        }
+
+        boolean hideDetails() {
+            return SableRoutes.hideDetails(deviceLocked, privateMode);
+        }
+    }
+
+    static final Uri PRIVACY_URI = new Uri.Builder()
+            .scheme("content")
+            .authority(SableRoutes.PRIVACY_AUTHORITY)
+            .appendPath(SableRoutes.PRIVACY_PATH)
+            .build();
+
+    private final ForceLoadContentObserver observer = new ForceLoadContentObserver();
+    private boolean observing;
+    private Data result;
+
+    SableRouteLoader(Context context) {
+        super(context);
+    }
+
+    @Override
+    public Data loadInBackground() {
+        final Context context = getContext();
+        final KeyguardManager keyguard = context.getSystemService(KeyguardManager.class);
+        final boolean locked = keyguard == null || keyguard.isDeviceLocked();
+        return new Data(loadEmailContacts(context), hubAvailable(context), locked,
+                privateMode(context));
+    }
+
+    private Set<Long> loadEmailContacts(Context context) {
+        final Set<Long> ids = new HashSet<>();
+        final Uri uri = Email.CONTENT_URI.buildUpon()
+                .appendQueryParameter(ContactsContract.LIMIT_PARAM_KEY,
+                        String.valueOf(SablePreferredNumbers.MAX_ROWS))
+                .build();
+        try (Cursor cursor = context.getContentResolver().query(
+                uri, new String[] {Email.CONTACT_ID}, Email.ADDRESS + " IS NOT NULL", null, null)) {
+            while (cursor != null && !isLoadInBackgroundCanceled() && cursor.moveToNext()
+                    && ids.size() < SablePreferredNumbers.MAX_CONTACTS) {
+                ids.add(cursor.getLong(0));
+            }
+        } catch (RuntimeException e) {
+            // Missing permission or provider trouble: no Mail route shown, never fail the list.
+            Log.w("SableRouteLoader", "email query failed", e);
+        }
+        return ids;
+    }
+
+    static boolean hubAvailable(Context context) {
+        return context.getPackageManager().resolveActivity(messagesIntent("0"), 0) != null;
+    }
+
+    /** Sable Messages, where a person's conversation lives (Sable Hub's inbox is Start's page). */
+    static final String MESSAGES_PACKAGE = "org.sableos.messages";
+
+    /**
+     * Sable: the person's conversation in Sable Messages (a new message to {@code address} when
+     * there is none yet). It only navigates; nothing is sent.
+     */
+    static Intent messagesIntent(String address) {
+        return new Intent(Intent.ACTION_SENDTO, Uri.fromParts("smsto", address, null))
+                .setPackage(MESSAGES_PACKAGE);
+    }
+
+    static boolean privateMode(Context context) {
+        try (Cursor cursor = context.getContentResolver().query(
+                PRIVACY_URI, null, null, null, null)) {
+            if (cursor == null || !cursor.moveToFirst()) {
+                return SableRoutes.privateMode(null);
+            }
+            final int column = cursor.getColumnIndex(SableRoutes.COLUMN_PRIVATE_MODE);
+            return SableRoutes.privateMode(column < 0 ? 1 : cursor.getInt(column));
+        } catch (RuntimeException e) {
+            // Hub absent or refusing us: no private mode is known.
+            return SableRoutes.privateMode(null);
+        }
+    }
+
+    @Override
+    public void deliverResult(Data data) {
+        result = data;
+        if (isStarted()) {
+            super.deliverResult(data);
+        }
+    }
+
+    @Override
+    protected void onStartLoading() {
+        if (!observing) {
+            getContext().getContentResolver().registerContentObserver(
+                    Email.CONTENT_URI, true, observer);
+            try {
+                getContext().getContentResolver().registerContentObserver(
+                        PRIVACY_URI, false, observer);
+            } catch (RuntimeException e) {
+                // No Hub: nothing to observe.
+            }
+            observing = true;
+        }
+        if (result != null) {
+            deliverResult(result);
+        }
+        // The lock state has no observer: re-read on every start.
+        forceLoad();
+    }
+
+    @Override
+    protected void onStopLoading() {
+        cancelLoad();
+    }
+
+    @Override
+    protected void onReset() {
+        onStopLoading();
+        if (observing) {
+            getContext().getContentResolver().unregisterContentObserver(observer);
+            observing = false;
+        }
+        result = null;
+    }
+}
