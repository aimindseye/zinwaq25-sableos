--- /dev/null
+++ b/res/values-night/sable_colors.xml
@@ -0,0 +1,38 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+  Copyright (C) 2026 The SableOS Project
+  SPDX-License-Identifier: Apache-2.0
+-->
+<!-- Sable dark palette (sable-contacts-people-titan2, sable-phone-dialer-titan2), used while the system Dark theme is on:
+     values of SableSystemTokens.Dark and SableTheme's dark outline tones. The accent is never
+     hard-coded: it comes from the system palette (system_accent1_*), which the Sable accent
+     seeds. The light palette with the same names is in values/sable_colors.xml. -->
+<resources>
+  <!-- surfaceBase, surfaceRaised, surfaceOverlay -->
+  <color name="sable_background">#FF000000</color>
+  <color name="sable_surface">#FF141414</color>
+  <color name="sable_surface_raised">#FF1C1C1C</color>
+  <!-- textPrimary, textSecondary, textDisabled -->
+  <color name="sable_text">#FFF7F9FC</color>
+  <color name="sable_text_muted">#FFAAB4C0</color>
+  <color name="sable_text_disabled">#FF7D8896</color>
+  <!-- outline, outlineVariant -->
+  <color name="sable_outline">#FF526170</color>
+  <color name="sable_outline_variant">#FF26313D</color>
+  <!-- Accent tones from the system palette: the outline/text tone for dark surfaces, a dark
+       container for selected and focused fills, and the tone drawn on the accent. -->
+  <color name="sable_accent">@android:color/system_accent1_200</color>
+  <color name="sable_accent_container">@android:color/system_accent1_900</color>
+  <color name="sable_on_accent">@android:color/system_accent1_900</color>
+  <!-- success / danger roles and their dark containers (call and end pills). -->
+  <color name="sable_call">#FF4ADE80</color>
+  <color name="sable_on_call">#FF04140A</color>
+  <color name="sable_call_container">#FF1D4D39</color>
+  <color name="sable_danger">#FFFF8A80</color>
+  <color name="sable_danger_container">#FF4D2328</color>
+  <!-- Touch ripple on dark surfaces (16% white). -->
+  <color name="sable_ripple">#29FFFFFF</color>
+  <!-- Faint overlays: the selected navigation item and a disabled button. -->
+  <color name="sable_overlay_faint">#0FFFFFFF</color>
+  <color name="sable_overlay_disabled">#26FFFFFF</color>
+</resources>
