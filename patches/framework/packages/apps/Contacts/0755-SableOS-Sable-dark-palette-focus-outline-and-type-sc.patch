diff --git a/res/drawable/sable_focus_outline.xml b/res/drawable/sable_focus_outline.xml
new file mode 100644
index 0000000..f9176ee
--- /dev/null
+++ b/res/drawable/sable_focus_outline.xml
@@ -0,0 +1,32 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+  Copyright (C) 2026 The SableOS Project
+  SPDX-License-Identifier: Apache-2.0
+-->
+<!-- Focus state only: transparent unless the view is focused (or activated, as for the
+     selected item of a list in selection mode). -->
+<selector xmlns:android="http://schemas.android.com/apk/res/android">
+  <item android:state_window_focused="false" android:state_activated="false">
+    <color android:color="@android:color/transparent"/>
+  </item>
+  <item android:state_focused="true">
+    <inset android:inset="@dimen/sable_focus_inset">
+      <shape android:shape="rectangle">
+        <solid android:color="@color/sable_accent_container"/>
+        <stroke android:width="@dimen/sable_focus_stroke" android:color="@color/sable_accent"/>
+        <corners android:radius="@dimen/sable_row_radius"/>
+      </shape>
+    </inset>
+  </item>
+  <item android:state_activated="true">
+    <inset android:inset="@dimen/sable_focus_inset">
+      <shape android:shape="rectangle">
+        <solid android:color="@color/sable_accent_container"/>
+        <corners android:radius="@dimen/sable_row_radius"/>
+      </shape>
+    </inset>
+  </item>
+  <item>
+    <color android:color="@android:color/transparent"/>
+  </item>
+</selector>
diff --git a/res/drawable/sable_pill_outline.xml b/res/drawable/sable_pill_outline.xml
new file mode 100644
index 0000000..29fd5e3
--- /dev/null
+++ b/res/drawable/sable_pill_outline.xml
@@ -0,0 +1,28 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+  Copyright (C) 2026 The SableOS Project
+  SPDX-License-Identifier: Apache-2.0
+-->
+<!-- Secondary pill action (Open, Message, Add): raised fill, outline tone border; the border
+     turns accent and thicker while focused. -->
+<ripple xmlns:android="http://schemas.android.com/apk/res/android"
+    android:color="@color/sable_ripple">
+  <item>
+    <selector>
+      <item android:state_focused="true">
+        <shape android:shape="rectangle">
+          <solid android:color="@color/sable_accent_container"/>
+          <stroke android:width="@dimen/sable_focus_stroke" android:color="@color/sable_accent"/>
+          <corners android:radius="@dimen/sable_pill_radius"/>
+        </shape>
+      </item>
+      <item>
+        <shape android:shape="rectangle">
+          <solid android:color="@color/sable_surface_raised"/>
+          <stroke android:width="@dimen/sable_hairline" android:color="@color/sable_outline"/>
+          <corners android:radius="@dimen/sable_pill_radius"/>
+        </shape>
+      </item>
+    </selector>
+  </item>
+</ripple>
diff --git a/res/drawable/sable_selectable_item.xml b/res/drawable/sable_selectable_item.xml
new file mode 100644
index 0000000..5e90534
--- /dev/null
+++ b/res/drawable/sable_selectable_item.xml
@@ -0,0 +1,18 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+  Copyright (C) 2026 The SableOS Project
+  SPDX-License-Identifier: Apache-2.0
+-->
+<!-- Sable list row / action background: a ripple for touch, and while the row has keyboard or
+     trackpad focus a 2dp accent outline around a dark accent fill, so the focused row is
+     obvious. Used as the theme's selectableItemBackground. -->
+<ripple xmlns:android="http://schemas.android.com/apk/res/android"
+    android:color="@color/sable_ripple">
+  <item android:id="@android:id/mask">
+    <shape android:shape="rectangle">
+      <solid android:color="@android:color/white"/>
+      <corners android:radius="@dimen/sable_row_radius"/>
+    </shape>
+  </item>
+  <item android:drawable="@drawable/sable_focus_outline"/>
+</ripple>
