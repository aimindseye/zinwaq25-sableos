+    <dimen name="sable_focus_inset">2dp</dimen>
+    <dimen name="sable_hairline">1dp</dimen>
+    <dimen name="sable_pill_height">48dp</dimen>
+    <!-- Type: SableTypeRole.ScreenTitle (22sp) and the 12sp section label. -->
+    <dimen name="sable_screen_title_size">22sp</dimen>
+    <dimen name="sable_section_label_size">12sp</dimen>
 </resources>
