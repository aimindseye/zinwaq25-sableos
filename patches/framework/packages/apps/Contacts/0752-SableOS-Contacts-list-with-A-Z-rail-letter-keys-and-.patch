+package com.android.contacts.sable;
+
+import android.content.Context;
+import android.content.res.ColorStateList;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+
+/**
+ * The one A-Z rail on the right of a contact list. It reads the list's existing section index
+ * through {@link SableAlphabetIndex}: letters with no contacts are dimmed and skipped by focus,
+ * and choosing a letter asks the list to jump. It keeps no contact data.
+ */
+public final class SableAlphabetRail extends LinearLayout {
+
+    /** Width of the rail in dp. */
+    public static final int WIDTH_DP = 28;
+
+    private static final float UNAVAILABLE_ALPHA = 0.38f;
+
+    /** Called when a letter is chosen by touch, pointer, Enter or accessibility. */
+    public interface Listener {
+        void onRailLetter(int codePoint);
+    }
+
+    /** Accessible names, from the app's string resources. */
+    public interface Labels {
+        String jumpTo(String letter);
+    }
+
+    private final TextView[] letters = new TextView[SableAlphabetIndex.RAIL_LETTERS.length()];
+    private Listener listener;
+
+    public SableAlphabetRail(Context context, Labels labels) {
+        super(context);
+        setOrientation(VERTICAL);
+        setGravity(Gravity.CENTER_HORIZONTAL);
+        setImportantForAccessibility(View.IMPORTANT_FOR_ACCESSIBILITY_YES);
+
+        TypedValue background = new TypedValue();
+        boolean hasBackground =
+                context
+                        .getTheme()
+                        .resolveAttribute(android.R.attr.selectableItemBackground, background, true);
+
+        for (int i = 0; i < letters.length; i++) {
+            final char letter = SableAlphabetIndex.RAIL_LETTERS.charAt(i);
+            TextView view = new TextView(context);
+            view.setText(String.valueOf(letter));
+            view.setTextSize(TypedValue.COMPLEX_UNIT_SP, 10);
+            view.setGravity(Gravity.CENTER);
+            view.setIncludeFontPadding(false);
+            view.setContentDescription(labels.jumpTo(String.valueOf(letter)));
+            if (hasBackground && background.resourceId != 0) {
+                view.setBackgroundResource(background.resourceId);
+            }
+            view.setOnClickListener(
+                    v -> {
+                        if (listener != null) {
+                            listener.onRailLetter(letter);
+                        }
+                    });
+            view.setLayoutParams(new LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, 0, 1f));
+            letters[i] = view;
+            addView(view);
+        }
+        setAvailable(SableAlphabetIndex.empty());
+    }
+
+    /** Layout params for a rail at the end edge of a FrameLayout, full height. */
+    public static android.widget.FrameLayout.LayoutParams frameParams(Context context) {
+        int width =
+                (int)
+                        TypedValue.applyDimension(
+                                TypedValue.COMPLEX_UNIT_DIP,
+                                WIDTH_DP,
+                                context.getResources().getDisplayMetrics());
+        return new android.widget.FrameLayout.LayoutParams(
+                width, ViewGroup.LayoutParams.MATCH_PARENT, Gravity.END);
+    }
+
+    public void setListener(Listener listener) {
+        this.listener = listener;
+    }
+
+    public void setLetterColor(ColorStateList color) {
+        for (TextView view : letters) {
+            view.setTextColor(color);
+        }
+    }
+
+    /** Dims and unfocuses the letters that have no rows in {@code index}. */
+    public void setAvailable(SableAlphabetIndex index) {
+        for (int i = 0; i < letters.length; i++) {
+            boolean available = index.hasLetter(SableAlphabetIndex.RAIL_LETTERS.charAt(i));
+            TextView view = letters[i];
+            view.setAlpha(available ? 1f : UNAVAILABLE_ALPHA);
+            view.setFocusable(available);
+            view.setClickable(available);
+            view.setEnabled(available);
+        }
+    }
+}
