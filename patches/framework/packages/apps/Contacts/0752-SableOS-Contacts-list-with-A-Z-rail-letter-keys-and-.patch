+package com.android.contacts.list;
+
+import android.content.AsyncTaskLoader;
+import android.content.Context;
+import android.content.res.Resources;
+import android.database.Cursor;
+import android.net.Uri;
+import android.provider.ContactsContract;
+import android.provider.ContactsContract.CommonDataKinds.Phone;
+import android.util.Log;
+
+import com.android.contacts.sable.SablePreferredNumbers;
+
+/**
+ * Sable: one read-only ContactsProvider query of Phone rows, reduced off the main thread to the
+ * bounded {@link SablePreferredNumbers} map used for the line under each contact's name.
+ * Reloads when the provider's Phone data changes. Writes nothing.
+ */
+final class SableNumbersLoader extends AsyncTaskLoader<SablePreferredNumbers> {
+
+    private static final String[] PROJECTION = {
+        Phone.CONTACT_ID, Phone.NUMBER, Phone.TYPE, Phone.LABEL, Phone.IS_SUPER_PRIMARY,
+        Phone.IS_PRIMARY,
+    };
+    private static final int CONTACT_ID = 0;
+    private static final int NUMBER = 1;
+    private static final int TYPE = 2;
+    private static final int LABEL = 3;
+    private static final int IS_SUPER_PRIMARY = 4;
+    private static final int IS_PRIMARY = 5;
+
+    private static final String SELECTION = Phone.NUMBER + " IS NOT NULL";
+    private static final String SORT_ORDER =
+            Phone.CONTACT_ID
+                    + " ASC, "
+                    + Phone.IS_SUPER_PRIMARY
+                    + " DESC, "
+                    + Phone.IS_PRIMARY
+                    + " DESC, "
+                    + Phone._ID
+                    + " ASC";
+
+    private final ForceLoadContentObserver observer = new ForceLoadContentObserver();
+    private boolean observing;
+    private SablePreferredNumbers result;
+
+    SableNumbersLoader(Context context) {
+        super(context);
+    }
+
+    @Override
+    public SablePreferredNumbers loadInBackground() {
+        Uri uri =
+                Phone.CONTENT_URI
+                        .buildUpon()
+                        .appendQueryParameter(
+                                ContactsContract.LIMIT_PARAM_KEY, String.valueOf(SablePreferredNumbers.MAX_ROWS))
+                        .build();
+        SablePreferredNumbers.Builder builder = new SablePreferredNumbers.Builder();
+        Resources res = getContext().getResources();
+        try (Cursor cursor =
+                getContext().getContentResolver().query(uri, PROJECTION, SELECTION, null, SORT_ORDER)) {
+            if (cursor == null) {
+                return SablePreferredNumbers.empty();
+            }
+            while (!isLoadInBackgroundCanceled() && cursor.moveToNext()) {
+                CharSequence label =
+                        Phone.getTypeLabel(res, cursor.getInt(TYPE), cursor.getString(LABEL));
+                if (!builder.offer(
+                        cursor.getLong(CONTACT_ID),
+                        cursor.getString(NUMBER),
+                        label == null ? null : label.toString(),
+                        cursor.getInt(IS_SUPER_PRIMARY) != 0,
+                        cursor.getInt(IS_PRIMARY) != 0)) {
+                    break;
+                }
+            }
+        } catch (RuntimeException e) {
+            // Missing permission or provider trouble: show names only, never fail the list.
+            Log.w("SableNumbersLoader", "phone query failed", e);
+            return SablePreferredNumbers.empty();
+        }
+        return builder.build();
+    }
+
+    @Override
+    public void deliverResult(SablePreferredNumbers data) {
+        result = data;
+        if (isStarted()) {
+            super.deliverResult(data);
+        }
+    }
+
+    @Override
+    protected void onStartLoading() {
+        if (!observing) {
+            getContext().getContentResolver().registerContentObserver(Phone.CONTENT_URI, true, observer);
+            observing = true;
+        }
+        if (result != null) {
+            deliverResult(result);
+        }
+        if (takeContentChanged() || result == null) {
+            forceLoad();
+        }
+    }
+
+    @Override
+    protected void onStopLoading() {
+        cancelLoad();
+    }
+
+    @Override
+    protected void onReset() {
+        onStopLoading();
+        if (observing) {
+            getContext().getContentResolver().unregisterContentObserver(observer);
+            observing = false;
+        }
+        result = null;
+    }
+}
