+    /**
+     * Sable: the one A-Z rail at the end edge of the list. It reads the adapter's existing
+     * section indexer; while it shows, the upstream fast-scroll thumb is off so there is one
+     * rail, not two.
+     */
+    private void installSableAlphabetRail(FrameLayout container) {
+        mSableRail = new SableAlphabetRail(
+                getContext(), letter -> getString(R.string.sable_alphabet_jump_to, letter));
+        mSableRail.setLetterColor(
+                ContextCompat.getColorStateList(getContext(), R.color.primary_color));
+        mSableRail.setListener(codePoint -> sableJump(codePoint, false));
+        mSableRail.setVisibility(View.GONE);
+        container.addView(mSableRail, SableAlphabetRail.frameParams(getContext()));
+    }
+
+    private void updateSableAlphabetRail() {
+        if (mSableRail == null || getView() == null) {
+            return;
+        }
+        final SableAlphabetIndex index = isSearchMode()
+                ? SableAlphabetIndex.empty() : getSableAlphabetIndex();
+        final boolean show = index.sectionCount() > 0;
+        mSableRail.setAvailable(index);
+        mSableRail.setVisibility(show ? View.VISIBLE : View.GONE);
+        final ListView list = getListView();
+        if (list != null) {
+            list.setPaddingRelative(list.getPaddingStart(), list.getPaddingTop(),
+                    show ? mSableRail.getLayoutParams().width : 0, list.getPaddingBottom());
+            if (show) {
+                list.setFastScrollEnabled(false);
+            }
+        }
+    }
+
+    /** Sable: letter navigation over the adapter's section indexer, in ListView positions. */
+    private SableAlphabetIndex getSableAlphabetIndex() {
+        final ContactListAdapter adapter = getAdapter();
+        final ListView list = getListView();
+        if (adapter == null || list == null || adapter.getPartitionCount() == 0) {
+            return SableAlphabetIndex.empty();
+        }
+        final SectionIndexer indexer = adapter.getIndexer();
+        final int partition = adapter.getIndexedPartition();
+        if (indexer == null || partition < 0 || partition >= adapter.getPartitionCount()) {
+            return SableAlphabetIndex.empty();
+        }
+        final Object[] sections = indexer.getSections();
+        final Cursor cursor = adapter.getCursor(partition);
+        if (sections == null || cursor == null || cursor.isClosed()) {
+            return SableAlphabetIndex.empty();
+        }
+        final int[] positions = new int[sections.length];
+        for (int i = 0; i < sections.length; i++) {
+            positions[i] = indexer.getPositionForSection(i);
+        }
+        final int start = list.getHeaderViewsCount()
+                + adapter.getPositionForPartition(partition)
+                + (adapter.hasHeader(partition) ? 1 : 0);
+        return SableAlphabetIndex.fromPositions(sections, positions, cursor.getCount(), start);
+    }
+
+    private void setSableNumbers(SablePreferredNumbers numbers) {
+        mSableNumbers = numbers == null ? SablePreferredNumbers.empty() : numbers;
+        final ContactListAdapter adapter = getAdapter();
+        if (adapter instanceof DefaultContactListAdapter) {
+            ((DefaultContactListAdapter) adapter).setSableNumbers(mSableNumbers);
+        }
+    }
+
+    /**
+     * Sable: keyboard shortcuts on the list (CONTACTS_PEOPLE_UX). A letter jumps to the
+     * contacts filed under it and repeating it cycles through them; "/" opens search. Letters
+     * never open, call, message or edit a contact. Returns false to keep the upstream
+     * type-to-search for every other key.
+     */
+    public boolean onSableKey(KeyEvent event) {
+        if (event.getAction() != KeyEvent.ACTION_DOWN || !isVisible()
+                || mActionBarAdapter == null) {
+            return false;
+        }
+        final int unicodeChar = event.getUnicodeChar();
+        if ((unicodeChar & KeyCharacterMap.COMBINING_ACCENT) != 0) {
+            return false;
+        }
+        final SableListKeys.Action action = SableListKeys.decide(
+                unicodeChar,
+                event.isCtrlPressed() || event.isAltPressed() || event.isMetaPressed(),
+                event.getRepeatCount() > 0,
+                mActionBarAdapter.isSearchMode(),
+                mActionBarAdapter.isSelectionMode(),
+                /* canOpenSearch= */ true);
+        switch (action) {
+            case JUMP:
+                sableJump(unicodeChar, true);
+                return true;
+            case OPEN_SEARCH:
+                mActionBarAdapter.setSearchMode(true);
+                return true;
+            case IGNORE:
+                return true;
+            default:
+                return false;
+        }
+    }
+
+    private void sableJump(int codePoint, boolean fromKeyboard) {
+        final ListView list = getListView();
+        if (list == null) {
+            return;
+        }
+        final SableAlphabetIndex index = getSableAlphabetIndex();
+        int current = list.getSelectedItemPosition();
+        if (current == ListView.INVALID_POSITION) {
+            current = mSableLastJump;
+        }
+        final int target = fromKeyboard
+                ? index.nextJump(codePoint, current) : index.firstPosition(codePoint);
+        if (target == SableAlphabetIndex.NO_POSITION) {
+            final int key = SableAlphabetIndex.keyOf(codePoint);
+            final String letter = new String(Character.toChars(key == 0 ? codePoint : key));
+            if (mSableToast != null) {
+                mSableToast.cancel();
+            }
+            mSableToast = Toast.makeText(getContext(),
+                    getString(R.string.sable_alphabet_no_contacts, letter), Toast.LENGTH_SHORT);
+            mSableToast.show();
+            return;
+        }
+        mSableLastJump = target;
+        if (fromKeyboard) {
+            list.requestFocus();
+        }
+        list.setSelection(target);
+    }
