+    private @Nullable TextView mSableDockFocus;
+
+    /**
+     * SableOS: the Files hint dock (FILES_DOCUMENTS_UX artifact): the focused file's name, type,
+     * size and date, a search prompt, and the key line. It sits under the whole Files layout, in
+     * both the classic and the Material 3 layouts, and moves nothing else.
+     */
+    private void addSableDock() {
+        final View root = findViewById(getRes(R.id.coordinator_layout));
+        if (!(root instanceof CoordinatorLayout) || ((ViewGroup) root).getChildCount() == 0) {
+            return;
+        }
+        final CoordinatorLayout coordinator = (CoordinatorLayout) root;
+        final View content = coordinator.getChildAt(0);
+        final float density = getResources().getDisplayMetrics().density;
+        final int pad = (int) (12 * density);
+
+        final LinearLayout dock = new LinearLayout(this);
+        dock.setOrientation(LinearLayout.VERTICAL);
+        dock.setPadding(pad, pad / 3, pad, pad / 3);
+        final TypedValue surface = new TypedValue();
+        if (getTheme().resolveAttribute(android.R.attr.colorBackgroundFloating, surface, true)) {
+            dock.setBackgroundColor(surface.data);
+        }
+        dock.setElevation(8 * density);
+
+        mSableDockFocus = sableDockLine(dock, null, 13, false);
+        final TextView prompt = sableDockLine(dock, SableFilesKeys.DOCK_PROMPT, 14, true);
+        prompt.setFocusable(true);
+        prompt.setClickable(true);
+        prompt.setOnClickListener(v -> mInjector.searchManager.onSearchBarClicked());
+        sableDockLine(dock, SableFilesKeys.DOCK_HINT, 12, true);
+
+        final CoordinatorLayout.LayoutParams params = new CoordinatorLayout.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
+        params.gravity = Gravity.BOTTOM;
+        coordinator.addView(dock, params);
+        // Keep the Files layout above the dock.
+        dock.addOnLayoutChangeListener((v, l, t, r, b, ol, ot, or, ob) -> {
+            final ViewGroup.LayoutParams lp = content.getLayoutParams();
+            if (lp instanceof ViewGroup.MarginLayoutParams
+                    && ((ViewGroup.MarginLayoutParams) lp).bottomMargin != b - t) {
+                ((ViewGroup.MarginLayoutParams) lp).bottomMargin = b - t;
+                content.setLayoutParams(lp);
+            }
+        });
+        coordinator.getViewTreeObserver().addOnGlobalFocusChangeListener(
+                (oldFocus, newFocus) -> updateSableDockFocus());
+        updateSableDockFocus();
+    }
+
+    private TextView sableDockLine(LinearLayout dock, @Nullable String text, int sp,
+            boolean accent) {
+        final TextView line = new TextView(this);
+        line.setText(text);
+        line.setTextSize(TypedValue.COMPLEX_UNIT_SP, sp);
+        line.setMaxLines(2);
+        line.setEllipsize(android.text.TextUtils.TruncateAt.END);
+        final TypedValue color = new TypedValue();
+        if (getTheme().resolveAttribute(
+                accent ? android.R.attr.colorAccent : android.R.attr.textColorSecondary,
+                color, true)) {
+            line.setTextColor(color.resourceId != 0 ? getColor(color.resourceId) : color.data);
+        }
+        dock.addView(line);
+        return line;
+    }
+
+    /** The dock's first line follows the file that has keyboard focus. */
+    private void updateSableDockFocus() {
+        if (mSableDockFocus == null) {
+            return;
+        }
+        final DirectoryFragment dir = getDirectoryFragment();
+        final String modelId = dir != null ? dir.getKeyboardFocusedModelId() : null;
+        final DocumentInfo doc = modelId != null ? mInjector.getModel().getDocument(modelId) : null;
+        if (doc == null) {
+            mSableDockFocus.setVisibility(View.GONE);
+            return;
+        }
+        final String type = doc.isDirectory() ? null : mInjector.fileTypeLookup.lookup(doc.mimeType);
+        final String size = (doc.isDirectory() || doc.size < 0)
+                ? null : Formatter.formatShortFileSize(this, doc.size);
+        final String date = doc.lastModified > 0
+                ? DateUtils.formatDateTime(this, doc.lastModified,
+                        DateUtils.FORMAT_SHOW_DATE | DateUtils.FORMAT_ABBREV_MONTH)
+                : null;
+        mSableDockFocus.setText(SableFilesKeys.focusLine(doc.displayName, type, size, date));
+        mSableDockFocus.setVisibility(View.VISIBLE);
+    }
+
