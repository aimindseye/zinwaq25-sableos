+    @Override
+    public boolean dispatchKeyEvent(KeyEvent event) {
+        return onSableKey(event) || super.dispatchKeyEvent(event);
+    }
+
+    /**
+     * SableOS: the Files keyboard model (sable/SableFilesKeys.java), looked at before the focused
+     * view so Alt chords are not typed into type-to-focus. Returns true when the key is consumed.
+     */
+    private boolean onSableKey(KeyEvent event) {
+        final View focus = getCurrentFocus();
+        final DirectoryFragment dir = getDirectoryFragment();
+        final boolean hasTarget = mInjector.selectionMgr.hasSelection()
+                || (dir != null && dir.getKeyboardFocusedModelId() != null);
+        final SableFilesKeys.Action action = SableFilesKeys.decide(
+                event.getKeyCode(),
+                event.getUnicodeChar(event.getMetaState()),
+                event.isAltPressed(),
+                event.isCtrlPressed(),
+                event.isShiftPressed(),
+                event.isMetaPressed(),
+                focus != null && focus.onCheckIsTextEditor(),
+                mInjector.focusManager.isTypeToFocusActive(),
+                hasTarget);
+        if (action == SableFilesKeys.Action.UPSTREAM) {
+            return false;
+        }
+        // The release and repeats of a command are consumed; a held key runs it once.
+        if (event.getAction() != KeyEvent.ACTION_DOWN || event.getRepeatCount() > 0) {
+            return true;
+        }
+        switch (action) {
+            case SEARCH:
+                mInjector.searchManager.onSearchBarClicked();
+                break;
+            case NEW_FOLDER:
+                if (canCreateDirectory()) {
+                    mInjector.actions.showCreateDirectoryDialog();
+                }
+                break;
+            case SELECT_ALL:
+                mInjector.actions.selectAllFiles();
+                break;
+            case COPY_TO:
+                runKeyboardAction(dir, R.id.action_menu_copy_to);
+                break;
+            case MOVE_TO:
+                runKeyboardAction(dir, R.id.action_menu_move_to);
+                break;
+            case RENAME:
+                runKeyboardAction(dir, R.id.action_menu_rename);
+                break;
+            case INFO:
+                runKeyboardAction(dir, R.id.action_menu_inspect);
+                break;
+            case OPEN_WITH:
+                runKeyboardAction(dir, R.id.action_menu_open_with);
+                break;
+            case DELETE:
+                runKeyboardAction(dir, R.id.action_menu_delete);
+                break;
+            default:
+                break;
+        }
+        return true;
+    }
+
+    private static void runKeyboardAction(@Nullable DirectoryFragment dir, int menuItemId) {
+        if (dir != null) {
+            dir.runKeyboardAction(menuItemId);
+        }
+    }
+
