+    /**
+     * SableOS: the model id of the document that has keyboard focus in the list, or null when
+     * focus is elsewhere (the roots, the toolbar, a dialog).
+     */
+    public @Nullable String getKeyboardFocusedModelId() {
+        if (mRecView == null || !mRecView.hasFocus()) {
+            return null;
+        }
+        final View child = mRecView.getFocusedChild();
+        if (child == null) {
+            return null;
+        }
+        final ViewHolder holder = mRecView.getChildViewHolder(child);
+        return (holder instanceof DocumentHolder) ? ((DocumentHolder) holder).getModelId() : null;
+    }
+
+    /**
+     * SableOS: runs an item of the selection menu (action_mode_menu) from the keyboard, on the
+     * selection or, when nothing is selected, on the focused document. The focused document is
+     * then selected, so the selection bar shows what the action applies to. It runs only when
+     * the on-screen menu would offer the item for that selection, and through the same code as a
+     * tap on it: Delete still asks first, Copy to and Move to still pick a visible destination.
+     *
+     * @return whether the item ran
+     */
+    public boolean runKeyboardAction(@IdRes int menuItemId) {
+        String selectedForKey = null;
+        if (!mSelectionMgr.hasSelection()) {
+            final String focused = getKeyboardFocusedModelId();
+            if (focused == null || !mSelectionMgr.select(focused)) {
+                return false;
+            }
+            selectedForKey = focused;
+        }
+        final PopupMenu popup = new PopupMenu(mRecView.getContext(), mRecView);
+        final Menu menu = popup.getMenu();
+        popup.getMenuInflater().inflate(getRes(R.menu.action_mode_menu), menu);
+        mInjector.menuManager.updateActionMenu(menu, mSelectionMetadata);
+        final MenuItem item = menu.findItem(getRes(menuItemId));
+        if (item != null && item.isVisible() && item.isEnabled() && handleMenuItemClick(item)) {
+            return true;
+        }
+        if (selectedForKey != null) {
+            mSelectionMgr.deselect(selectedForKey);
+        }
+        return false;
+    }
