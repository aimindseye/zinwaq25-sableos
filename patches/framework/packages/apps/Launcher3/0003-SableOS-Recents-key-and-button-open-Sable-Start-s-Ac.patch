+package com.android.quickstep.sable
+
+import android.content.ActivityNotFoundException
+import android.content.Context
+import android.content.Intent
+import android.os.SystemProperties
+import android.util.Log
+
+/**
+ * Sable Start's Active Frames take the Recents role on SableOS: the Recents key and the 3-button
+ * Recents button open them instead of the Quickstep overview. Alt+Tab quick switch and the
+ * swipe-up gesture keep the overview.
+ */
+object SableActiveFrames {
+    private const val TAG = "SableActiveFrames"
+    private const val HOME_PROPERTY = "ro.sable.home"
+    const val ACTION_SHOW_ACTIVE_FRAMES = "org.sableos.start.action.SHOW_ACTIVE_FRAMES"
+
+    /** The Sable home package, or null when the build has none. */
+    fun homePackage(): String? = SystemProperties.get(HOME_PROPERTY, "").ifEmpty { null }
+
+    /** Opens Active Frames in Sable Start; false when there is no Sable home to open. */
+    fun open(context: Context): Boolean {
+        val home = homePackage() ?: return false
+        val intent =
+            Intent(ACTION_SHOW_ACTIVE_FRAMES)
+                .setPackage(home)
+                .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_RESET_TASK_IF_NEEDED)
+        return try {
+            context.startActivity(intent)
+            true
+        } catch (e: ActivityNotFoundException) {
+            Log.w(TAG, "Sable home $home cannot show Active Frames; using the overview", e)
+            false
+        }
+    }
+}
