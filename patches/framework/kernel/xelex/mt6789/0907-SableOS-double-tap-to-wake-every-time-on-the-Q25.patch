From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SableOS <noreply@sableos.invalid>
Date: Sat, 14 Nov 2026 15:24:51 +0000
Subject: [PATCH] SableOS: double-tap to wake every time on the Q25

On the owner's Q25 (2026-11-14) double-tap to wake with 0903 armed
woke the phone only sometimes. A double tap usually comes while the
phone is in system suspend. Its falling-edge interrupt wakes the
system, but the driver only queues a work item: nothing kept the system
awake until KEY_WAKEUP reached Android, and the work could read the
sensor before the I2C bus had resumed. A failed read also left the
attention line low, so no later tap raised a new edge until the screen
was turned on another way.

While the gesture is armed, the interrupt now holds a one-second wakeup
event (the device is made wakeup-capable at probe), and the work waits,
up to a second, for this driver's resume before reading the gesture.
Arming and disarming are logged, so dmesg shows whether the panel took
the gesture.
---
 .../synaptics_dsx/synaptics_dsx_core.c        | 42 ++++++++++++++++++-
 1 file changed, 41 insertions(+), 1 deletion(-)

diff --git a/drivers/input/touchscreen/mtk_touchscreen_hodafonehw/synaptics_dsx/synaptics_dsx_core.c b/drivers/input/touchscreen/mtk_touchscreen_hodafonehw/synaptics_dsx/synaptics_dsx_core.c
index 2345e6a..795d9a7 100644
--- a/drivers/input/touchscreen/mtk_touchscreen_hodafonehw/synaptics_dsx/synaptics_dsx_core.c
+++ b/drivers/input/touchscreen/mtk_touchscreen_hodafonehw/synaptics_dsx/synaptics_dsx_core.c
@@ -56,6 +56,8 @@ ctp {
 #include <linux/regulator/consumer.h>
 #include <linux/ktime.h>
 #include <linux/moduleparam.h>
+#include <linux/completion.h>
+#include <linux/pm_wakeup.h>
 #include "mtk_disp_notify.h"
 #include "synaptics_dsx_core.h"
 #include <linux/input/mt.h>
@@ -707,6 +709,19 @@ MODULE_PARM_DESC(wake_gesture, "Double-tap the screen to wake it (SableOS)");
 static struct synaptics_rmi4_data *sable_wg_data;
 static bool sable_wg_armed;
 
+/*
+ * SableOS: a double tap usually arrives while the phone is in system suspend.
+ * Its interrupt wakes the system, but the work that reads the gesture can run
+ * before the I2C bus is back, and nothing kept the system awake until the
+ * KEY_WAKEUP reached Android; either way the tap was lost, and with a missed
+ * read the attention line stayed low, so no later tap raised a new edge. Hold
+ * a wakeup event from the interrupt, and let the work wait for this driver's
+ * resume while the system is still waking.
+ */
+#define SABLE_WG_WAKE_MS 1000
+static bool sable_wg_sleeping;
+static DECLARE_COMPLETION(sable_wg_resumed);
+
 static struct synaptics_rmi4_fn *sable_wg_f12(struct synaptics_rmi4_data *rmi4_data)
 {
 	struct synaptics_rmi4_fn *fhandler;
@@ -776,6 +791,8 @@ static void sable_wg_arm(struct synaptics_rmi4_data *rmi4_data, bool arm)
 	else
 		disable_irq_wake(rmi4_data->irq);
 	sable_wg_armed = arm;
+	dev_info(rmi4_data->pdev->dev.parent, "%s: double-tap to wake %s\n",
+			__func__, arm ? "armed" : "disarmed");
 out:
 	mutex_unlock(&rmi4_data->input_dev->mutex);
 }
@@ -1448,6 +1465,10 @@ static irqreturn_t synaptics_rmi4_irq(int irq, void *data)
 {
 	struct synaptics_rmi4_data *rmi4_data = data;
 
+	/* SableOS: keep the system awake until the double tap is read and reported. */
+	if (sable_wg_armed)
+		pm_wakeup_dev_event(&rmi4_data->pdev->dev, SABLE_WG_WAKE_MS, true);
+
 	synaptics_rmi4_diable_irq_nosync(irq, rmi4_data, true);
 	queue_work(rmi4_data->workqueue, &rmi4_data->irq_work);
 
@@ -1462,6 +1483,14 @@ static void synaptics_rmi4_irq_work(struct work_struct *work)
 	const struct synaptics_dsx_board_data *bdata =
 			rmi4_data->hw_if->board_data;
 
+	/* SableOS: woken by a double tap; read it once the bus has resumed. */
+	if (READ_ONCE(sable_wg_sleeping) &&
+			!wait_for_completion_timeout(&sable_wg_resumed,
+				msecs_to_jiffies(SABLE_WG_WAKE_MS)))
+		dev_err(rmi4_data->pdev->dev.parent,
+				"%s: Not resumed; reading the double tap anyway\n",
+				__func__);
+
 	mutex_lock(&rmi4_data->rmi4_irq_mutex);
 	if (true != rmi4_data->irq_enabled) {
 		/* IRQ is disabled. Must be a race conditon */
@@ -3197,6 +3226,7 @@ static int synaptics_rmi4_probe(struct platform_device *pdev)
 
 	/* SableOS: double-tap to wake follows the display's power. */
 	sable_wg_data = rmi4_data;
+	device_init_wakeup(&pdev->dev, true);
 	if (mtk_disp_notifier_register("synaptics_dsx_wake", &sable_wg_disp_nb))
 		dev_err(&pdev->dev, "%s: No display notifier; no double-tap to wake\n",
 				__func__);
@@ -3266,6 +3296,7 @@ static int synaptics_rmi4_remove(struct platform_device *pdev)
 	}
 
 	mtk_disp_notifier_unregister(&sable_wg_disp_nb);
+	device_init_wakeup(&pdev->dev, false);
 	sable_wg_data = NULL;
 	synaptics_rmi4_irq_enable(rmi4_data, false, false);
 
@@ -3384,8 +3415,11 @@ static int synaptics_rmi4_suspend(struct device *dev)
 		goto exit;
 
 	/* SableOS: armed for double-tap to wake, so the sensor and its interrupt stay on. */
-	if (sable_wg_armed)
+	if (sable_wg_armed) {
+		reinit_completion(&sable_wg_resumed);
+		WRITE_ONCE(sable_wg_sleeping, true);
 		goto exit;
+	}
 
 	if (!rmi4_data->suspend) {
 		synaptics_rmi4_irq_enable(rmi4_data, false, false);
@@ -3419,6 +3453,12 @@ static int synaptics_rmi4_resume(struct device *dev)
 	const struct synaptics_dsx_board_data *bdata =
 			rmi4_data->hw_if->board_data;
 
+	/* SableOS: the bus is back; a waiting double-tap read may go ahead. */
+	if (READ_ONCE(sable_wg_sleeping)) {
+		WRITE_ONCE(sable_wg_sleeping, false);
+		complete_all(&sable_wg_resumed);
+	}
+
 	mutex_lock(&rmi4_data->input_dev->mutex);
 
 	if (!rmi4_data->suspend)
-- 
2.43.0

