From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SableOS <noreply@sableos.invalid>
Date: Thu, 22 Oct 2026 04:05:26 +0000
Subject: [PATCH] SableOS: report the fuel gauge's learned battery health on
 the Q25

The MediaTek battery power supply reported values Android shows as
battery health but which never change: cycle_count was a fixed 1 and
charge_full the static profile Q_MAX, while charge_full_design divided
the same Q_MAX by ten (the Q25 device tree gives Q_MAX in mAh, 2951 for
the 3000 mAh cell), so the two disagreed by 10x.

- cycle_count: the full-equivalent cycle count fuelgauged keeps and
  restores (FG_DAEMON_CMD_SET_BAT_CYCLES) when the daemon runs the
  gauge; -ENODATA in kernel-algorithm mode, which counts no cycles.
- charge_full: charge_full_design scaled by the learned aging factor
  (fuelgauged's FG_DAEMON_CMD_SET_AGING_FACTOR, or the kernel
  algorithm's), clamped to 100 %; -ENODATA without one.
- charge_full_design: Q_MAX in mAh times 1000 (uAh).

-ENODATA properties are skipped in uevents and read as missing by the
health HAL, so Android shows "Not reported" rather than a made-up value.
---
 drivers/power/supply/mtk_battery.c | 69 ++++++++++++++++++++++++------
 1 file changed, 56 insertions(+), 13 deletions(-)

diff --git a/drivers/power/supply/mtk_battery.c b/drivers/power/supply/mtk_battery.c
index ccfafa3f..b4ed1ea6 100644
--- a/drivers/power/supply/mtk_battery.c
+++ b/drivers/power/supply/mtk_battery.c
@@ -262,6 +262,35 @@ int check_cap_level(int uisoc)
 		return POWER_SUPPLY_CAPACITY_LEVEL_UNKNOWN;
 }
 
+/*
+ * SableOS: battery health values Android reads through the health HAL
+ * (cycle_count, charge_full, charge_full_design). The MediaTek defaults were
+ * a fixed cycle count of 1 and the static profile Q_MAX for both capacities,
+ * with the design capacity off by a factor of ten. These report what the
+ * fuel gauge has learned instead, or -ENODATA (Android shows "Not reported")
+ * while it has nothing.
+ *
+ * g_Q_MAX in the Q25 device tree is in mAh (2951 for the 3000 mAh cell).
+ * Aging factors are in 0.01 % (10000 = 100 %), as in mtk_battery_algo.c.
+ */
+#define SABLE_AGING_FACTOR_FULL 10000
+
+static int sable_design_capacity_uah(struct mtk_battery *gm)
+{
+	int q_max_mah = gm->fg_table_cust_data.fg_profile[gm->battery_id].q_max;
+
+	return q_max_mah > 0 ? q_max_mah * 1000 : 0;
+}
+
+static int sable_aging_factor(struct mtk_battery *gm)
+{
+	int af = gm->algo.active ? gm->algo.aging_factor : gm->aging_factor;
+
+	if (af <= 0)
+		return 0;
+	return af > SABLE_AGING_FACTOR_FULL ? SABLE_AGING_FACTOR_FULL : af;
+}
+
 static enum power_supply_property battery_props[] = {
 	POWER_SUPPLY_PROP_STATUS,
 	POWER_SUPPLY_PROP_HEALTH,
@@ -323,7 +352,15 @@ static int battery_psy_get_property(struct power_supply *psy,
 		val->intval = bs_data->bat_technology;
 		break;
 	case POWER_SUPPLY_PROP_CYCLE_COUNT:
-		val->intval = 1;
+		/*
+		 * SableOS: the full-equivalent cycle count fuelgauged keeps (and
+		 * restores at boot, FG_DAEMON_CMD_SET_BAT_CYCLES). The kernel
+		 * gauge algorithm does not count cycles, so nothing then.
+		 */
+		if (!gm->algo.active && gm->bat_cycle >= 0)
+			val->intval = gm->bat_cycle;
+		else
+			ret = -ENODATA;
 		break;
 	case POWER_SUPPLY_PROP_CAPACITY:
 		/* 1 = META_BOOT, 4 = FACTORY_BOOT 5=ADVMETA_BOOT */
@@ -364,9 +401,20 @@ static int battery_psy_get_property(struct power_supply *psy,
 		ret = 0;
 		break;
 	case POWER_SUPPLY_PROP_CHARGE_FULL:
-		val->intval =
-			gm->fg_table_cust_data.fg_profile[
-				gm->battery_id].q_max * 1000;
+		/*
+		 * SableOS: full-charge capacity now = design capacity scaled by
+		 * the learned aging factor, not the static profile Q_MAX.
+		 */
+		{
+			int design_uah = sable_design_capacity_uah(gm);
+			int af = sable_aging_factor(gm);
+
+			if (design_uah > 0 && af > 0)
+				val->intval = (int)div_s64((s64)design_uah * af,
+					SABLE_AGING_FACTOR_FULL);
+			else
+				ret = -ENODATA;
+		}
 		break;
 	case POWER_SUPPLY_PROP_CHARGE_COUNTER:
 		val->intval = gm->ui_soc *
@@ -437,17 +485,12 @@ static int battery_psy_get_property(struct power_supply *psy,
 			POWER_SUPPLY_CAPACITY_LEVEL_UNKNOWN)
 			val->intval = 0;
 		else {
-			int q_max_mah = 0;
-			int q_max_uah = 0;
-
-			q_max_mah =
-				gm->fg_table_cust_data.fg_profile[
-				gm->battery_id].q_max / 10;
+			/* SableOS: Q_MAX is in mAh here, not 0.1 mAh. */
+			int q_max_uah = sable_design_capacity_uah(gm);
 
-			q_max_uah = q_max_mah * 1000;
 			if (q_max_uah <= 100000) {
-				bm_debug("%s q_max_mah:%d q_max_uah:%d\n",
-					__func__, q_max_mah, q_max_uah);
+				bm_debug("%s q_max_uah:%d\n",
+					__func__, q_max_uah);
 				q_max_uah = 100001;
 			}
 			val->intval = q_max_uah;
-- 
2.43.0

