From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SableOS <noreply@sableos.invalid>
Date: Fri, 6 Nov 2026 18:00:00 +0000
Subject: [PATCH] SableOS: double-tap to wake on the Q25 touch panel

The Q25 build uses the open synaptics_dsx driver (Q20_TOUCH is off). It
reads whether the panel's F12 has the wakeup-gesture control (ctrl27)
and where ctrl20 and data4 are, but never turns the gesture on: screen
off puts the sensor to sleep through system suspend.

Add a wake_gesture module parameter (off by default). When the display
powers down with it on, F12 goes to wakeup-gesture report mode with
double tap enabled and its interrupt becomes a wake source, and system
suspend leaves the sensor awake. While armed, an attention interrupt
reads data4 and a double tap reports KEY_WAKEUP. The display powering up
puts F12 back in continuous mode. The display power comes from MediaTek's
mtk_disp_notifier chain.
---
 .../synaptics_dsx/synaptics_dsx_core.c        | 145 ++++++++++++++++++
 1 file changed, 145 insertions(+)

diff --git a/drivers/input/touchscreen/mtk_touchscreen_hodafonehw/synaptics_dsx/synaptics_dsx_core.c b/drivers/input/touchscreen/mtk_touchscreen_hodafonehw/synaptics_dsx/synaptics_dsx_core.c
index 2e99ad6..2345e6a 100644
--- a/drivers/input/touchscreen/mtk_touchscreen_hodafonehw/synaptics_dsx/synaptics_dsx_core.c
+++ b/drivers/input/touchscreen/mtk_touchscreen_hodafonehw/synaptics_dsx/synaptics_dsx_core.c
@@ -55,6 +55,8 @@ ctp {
 #include <linux/reboot.h>
 #include <linux/regulator/consumer.h>
 #include <linux/ktime.h>
+#include <linux/moduleparam.h>
+#include "mtk_disp_notify.h"
 #include "synaptics_dsx_core.h"
 #include <linux/input/mt.h>
 
@@ -685,6 +687,118 @@ static struct device_attribute attrs[] = {
 			synaptics_rmi4_suspend_store),
 };
 
+/*
+ * SableOS: double-tap to wake. Settings > Display stores the choice in
+ * persist.sys.sable.dt2w and init copies it here (sable-dt2w.rc). When the
+ * display powers down with it on, F12 is put in wakeup-gesture report mode
+ * with double tap enabled and the attention interrupt becomes a wake source;
+ * the sensor is then kept out of sleep through system suspend, and a double
+ * tap reports KEY_WAKEUP. The display powering up puts F12 back in
+ * continuous mode. Off by default; nothing changes while it is off.
+ */
+static bool wake_gesture;
+module_param(wake_gesture, bool, 0644);
+MODULE_PARM_DESC(wake_gesture, "Double-tap the screen to wake it (SableOS)");
+
+#define F12_CONTINUOUS_MODE 0x00
+#define F12_WAKEUP_GESTURE_MODE 0x02
+#define F12_GESTURE_DOUBLE_TAP 0x01
+
+static struct synaptics_rmi4_data *sable_wg_data;
+static bool sable_wg_armed;
+
+static struct synaptics_rmi4_fn *sable_wg_f12(struct synaptics_rmi4_data *rmi4_data)
+{
+	struct synaptics_rmi4_fn *fhandler;
+	struct synaptics_rmi4_device_info *rmi = &(rmi4_data->rmi4_mod_info);
+
+	list_for_each_entry(fhandler, &rmi->support_fn_list, link) {
+		if (fhandler->fn_number == SYNAPTICS_RMI4_F12)
+			return fhandler;
+	}
+	return NULL;
+}
+
+/* F12 report mode: wakeup gesture (double tap enabled) or continuous. */
+static int sable_wg_set_mode(struct synaptics_rmi4_data *rmi4_data, bool gesture)
+{
+	int retval;
+	unsigned char reporting_control[3];
+	unsigned char enables;
+	unsigned short ctrl_base;
+	struct synaptics_rmi4_f12_extra_data *extra_data;
+	struct synaptics_rmi4_fn *fhandler = sable_wg_f12(rmi4_data);
+
+	if (!fhandler || !rmi4_data->f12_wakeup_gesture)
+		return -ENODEV;
+	extra_data = (struct synaptics_rmi4_f12_extra_data *)fhandler->extra;
+	ctrl_base = fhandler->full_addr.ctrl_base;
+
+	if (gesture) {
+		retval = synaptics_rmi4_reg_read(rmi4_data,
+				ctrl_base + extra_data->ctrl27_offset,
+				&enables, sizeof(enables));
+		if (retval < 0)
+			return retval;
+		enables |= F12_DOUBLE_TAP_WAKEUP;
+		retval = synaptics_rmi4_reg_write(rmi4_data,
+				ctrl_base + extra_data->ctrl27_offset,
+				&enables, sizeof(enables));
+		if (retval < 0)
+			return retval;
+	}
+
+	retval = synaptics_rmi4_reg_read(rmi4_data,
+			ctrl_base + extra_data->ctrl20_offset,
+			reporting_control, sizeof(reporting_control));
+	if (retval < 0)
+		return retval;
+	reporting_control[2] = gesture ? F12_WAKEUP_GESTURE_MODE : F12_CONTINUOUS_MODE;
+	retval = synaptics_rmi4_reg_write(rmi4_data,
+			ctrl_base + extra_data->ctrl20_offset,
+			reporting_control, sizeof(reporting_control));
+	return retval < 0 ? retval : 0;
+}
+
+static void sable_wg_arm(struct synaptics_rmi4_data *rmi4_data, bool arm)
+{
+	mutex_lock(&rmi4_data->input_dev->mutex);
+	if (arm == sable_wg_armed || rmi4_data->suspend)
+		goto out;
+	if (sable_wg_set_mode(rmi4_data, arm) < 0) {
+		dev_err(rmi4_data->pdev->dev.parent,
+				"%s: Failed to %s the wakeup gesture\n",
+				__func__, arm ? "arm" : "disarm");
+		goto out;
+	}
+	if (arm)
+		enable_irq_wake(rmi4_data->irq);
+	else
+		disable_irq_wake(rmi4_data->irq);
+	sable_wg_armed = arm;
+out:
+	mutex_unlock(&rmi4_data->input_dev->mutex);
+}
+
+static int sable_wg_disp_notify(struct notifier_block *nb,
+		unsigned long event, void *data)
+{
+	int blank;
+
+	if (!sable_wg_data || !data)
+		return NOTIFY_DONE;
+	blank = *(int *)data;
+	if (event == MTK_DISP_EARLY_EVENT_BLANK && blank == MTK_DISP_BLANK_POWERDOWN)
+		sable_wg_arm(sable_wg_data, wake_gesture);
+	else if (event == MTK_DISP_EVENT_BLANK && blank == MTK_DISP_BLANK_UNBLANK)
+		sable_wg_arm(sable_wg_data, false);
+	return NOTIFY_OK;
+}
+
+static struct notifier_block sable_wg_disp_nb = {
+	.notifier_call = sable_wg_disp_notify,
+};
+
 static void enable_modem_power(int enable)
 {
         struct regulator* set_ldo = NULL;
@@ -978,6 +1092,22 @@ static int synaptics_rmi4_f12_abs_report(struct synaptics_rmi4_data *rmi4_data,
 	extra_data = (struct synaptics_rmi4_f12_extra_data *)fhandler->extra;
 	size_of_2d_data = sizeof(struct synaptics_rmi4_f12_finger_data);
 
+	/* SableOS: while the wakeup gesture is armed, only a double tap is reported. */
+	if (sable_wg_armed) {
+		unsigned char gesture = 0;
+
+		retval = synaptics_rmi4_reg_read(rmi4_data,
+				data_addr + extra_data->data4_offset,
+				&gesture, sizeof(gesture));
+		if (retval >= 0 && gesture == F12_GESTURE_DOUBLE_TAP) {
+			input_report_key(rmi4_data->input_dev, KEY_WAKEUP, 1);
+			input_sync(rmi4_data->input_dev);
+			input_report_key(rmi4_data->input_dev, KEY_WAKEUP, 0);
+			input_sync(rmi4_data->input_dev);
+		}
+		return 0;
+	}
+
 	/* Determine the total number of fingers to process */
 	if (extra_data->data15_size) {
 		retval = synaptics_rmi4_reg_read(rmi4_data,
@@ -2474,6 +2604,9 @@ static int synaptics_rmi4_set_input_dev(struct synaptics_rmi4_data *rmi4_data)
 	set_bit(EV_ABS, rmi4_data->input_dev->evbit);
 	set_bit(BTN_TOUCH, rmi4_data->input_dev->keybit);
 	set_bit(BTN_TOOL_FINGER, rmi4_data->input_dev->keybit);
+	/* SableOS: double-tap to wake reports KEY_WAKEUP. */
+	if (rmi4_data->f12_wakeup_gesture)
+		input_set_capability(rmi4_data->input_dev, EV_KEY, KEY_WAKEUP);
 	if (bdata->touchpad)
 		set_bit(INPUT_PROP_POINTER, rmi4_data->input_dev->propbit);
 	else
@@ -3062,6 +3195,12 @@ static int synaptics_rmi4_probe(struct platform_device *pdev)
 	synaptics_rmi4_fw_update_module_init(rmi4_data);
 #endif
 
+	/* SableOS: double-tap to wake follows the display's power. */
+	sable_wg_data = rmi4_data;
+	if (mtk_disp_notifier_register("synaptics_dsx_wake", &sable_wg_disp_nb))
+		dev_err(&pdev->dev, "%s: No display notifier; no double-tap to wake\n",
+				__func__);
+
 	tpd_load_status = 1;
 	return retval;
 
@@ -3126,6 +3265,8 @@ static int synaptics_rmi4_remove(struct platform_device *pdev)
 				&attrs[attr_count].attr);
 	}
 
+	mtk_disp_notifier_unregister(&sable_wg_disp_nb);
+	sable_wg_data = NULL;
 	synaptics_rmi4_irq_enable(rmi4_data, false, false);
 
 	synaptics_rmi4_empty_fn_list(rmi4_data);
@@ -3242,6 +3383,10 @@ static int synaptics_rmi4_suspend(struct device *dev)
 	if (rmi4_data->stay_awake)
 		goto exit;
 
+	/* SableOS: armed for double-tap to wake, so the sensor and its interrupt stay on. */
+	if (sable_wg_armed)
+		goto exit;
+
 	if (!rmi4_data->suspend) {
 		synaptics_rmi4_irq_enable(rmi4_data, false, false);
 		synaptics_rmi4_sensor_sleep(rmi4_data);
-- 
2.43.0

