+/*
+ * SPDX-FileCopyrightText: The SableOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.internal.notification.sable;
+
+/**
+ * BlackBerry-style battery light decision, without Android dependencies so it can be unit
+ * tested off-device. {@code LineageBatteryLights} maps the result to a color and pattern.
+ *
+ * <ul>
+ *   <li>Plugged in and completely charged (status FULL, or level 100 while charging or not
+ *       charging): the full color, solid, unless "Turn off when fully charged" is on.
+ *   <li>Charging below that: the charging color (the low color when the level is low),
+ *       blinking where the light can blink, otherwise solid.
+ *   <li>Not charging and low: the low color, flashed by BatteryService when pulse is on.
+ *   <li>Anything else, or the battery light switched off: off.
+ * </ul>
+ */
+public final class SableBatteryLightPolicy {
+    // android.os.BatteryManager.BATTERY_STATUS_* values.
+    public static final int STATUS_UNKNOWN = 1;
+    public static final int STATUS_CHARGING = 2;
+    public static final int STATUS_DISCHARGING = 3;
+    public static final int STATUS_NOT_CHARGING = 4;
+    public static final int STATUS_FULL = 5;
+
+    public static final int FULL_LEVEL = 100;
+
+    public enum Light {
+        OFF,
+        /** Low color, pulse times from BatteryService (125/2875 ms by default). */
+        LOW_FLASH,
+        /** Low color, charging pattern. */
+        LOW_CHARGING,
+        /** Charging (medium) color, charging pattern. */
+        CHARGING,
+        /** Full color, solid. */
+        FULL,
+    }
+
+    private SableBatteryLightPolicy() {}
+
+    /** True when a charger is attached and the battery is completely charged. */
+    public static boolean isPluggedAndFull(int level, int status) {
+        if (status == STATUS_FULL) {
+            return true;
+        }
+        return level >= FULL_LEVEL
+                && (status == STATUS_CHARGING || status == STATUS_NOT_CHARGING);
+    }
+
+    public static Light decide(int level, int status, boolean low, boolean lightEnabled,
+            boolean fullChargeDisabled, boolean lowPulseEnabled) {
+        if (!lightEnabled) {
+            return Light.OFF;
+        }
+        if (isPluggedAndFull(level, status)) {
+            return fullChargeDisabled ? Light.OFF : Light.FULL;
+        }
+        if (status == STATUS_CHARGING) {
+            return low ? Light.LOW_CHARGING : Light.CHARGING;
+        }
+        if (low && lowPulseEnabled) {
+            return Light.LOW_FLASH;
+        }
+        return Light.OFF;
+    }
+
+    /** True when the charging pattern blinks (both times positive). */
+    public static boolean chargingBlinks(boolean canBlink, int onMs, int offMs) {
+        return canBlink && onMs > 0 && offMs > 0;
+    }
+}
