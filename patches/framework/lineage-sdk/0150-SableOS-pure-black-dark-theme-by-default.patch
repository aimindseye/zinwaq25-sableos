From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SableOS <noreply@sableos.invalid>
Date: Wed, 28 Oct 2026 23:40:00 +0000
Subject: [PATCH] SableOS: pure black dark theme by default

The Pure black switch (Settings > Display > Dark theme) is
LineageSettings.Secure.BERRY_BLACK_THEME; SystemUI's ThemeOverlayApplier
turns org.lineageos.overlay.customization.blacktheme on from it while
Dark theme is on. It had no default (read as 0), so a fresh install was
dark grey while Sable Start and the Sable apps are #000000. The provider
now writes 1 when it creates its database (first boot); the switch still
turns it off, and an existing install keeps its choice.
---
 packages/LineageSettingsProvider/res/values/defaults.xml      | 4 ++++
 .../org/lineageos/lineagesettings/LineageDatabaseHelper.java  | 3 +++
 2 files changed, 7 insertions(+)

diff --git a/packages/LineageSettingsProvider/res/values/defaults.xml b/packages/LineageSettingsProvider/res/values/defaults.xml
index 1d59bac..def3466 100644
--- a/packages/LineageSettingsProvider/res/values/defaults.xml
+++ b/packages/LineageSettingsProvider/res/values/defaults.xml
@@ -20,6 +20,10 @@
     <!-- Default for LineageSettings.Secure.QS_SHOW_BRIGHTNESS_SLIDER -->
     <bool name="def_qs_show_brightness_slider">true</bool>
 
+    <!-- Default for LineageSettings.Secure.BERRY_BLACK_THEME. SableOS: pure black is on
+         by default, so a fresh install in Dark theme matches the black Sable apps. -->
+    <bool name="def_berry_black_theme">true</bool>
+
     <!-- Defaults for System -->
 
     <!-- Default for LineageSettings.System.FORCE_SHOW_NAVBAR -->
diff --git a/packages/LineageSettingsProvider/src/org/lineageos/lineagesettings/LineageDatabaseHelper.java b/packages/LineageSettingsProvider/src/org/lineageos/lineagesettings/LineageDatabaseHelper.java
index 2057bee..c784738 100644
--- a/packages/LineageSettingsProvider/src/org/lineageos/lineagesettings/LineageDatabaseHelper.java
+++ b/packages/LineageSettingsProvider/src/org/lineageos/lineagesettings/LineageDatabaseHelper.java
@@ -444,6 +444,9 @@ public class LineageDatabaseHelper extends SQLiteOpenHelper{
 
             loadBooleanSetting(stmt, LineageSettings.Secure.QS_SHOW_BRIGHTNESS_SLIDER,
                     R.bool.def_qs_show_brightness_slider);
+
+            loadBooleanSetting(stmt, LineageSettings.Secure.BERRY_BLACK_THEME,
+                    R.bool.def_berry_black_theme);
         } finally {
             if (stmt != null) stmt.close();
         }
-- 
