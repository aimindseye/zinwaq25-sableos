+
+package com.android.keyguard.sable;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.graphics.Bitmap;
+import android.graphics.BitmapFactory;
+import android.util.Log;
+
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+
+/**
+ * Where Picture Password lives: the hashed record ({@link SablePicturePassword.Record}), the
+ * wrong-picture count and the photo, per user, in SystemUI's own credential-encrypted storage.
+ * Nothing here is readable before the first PIN unlock after a reboot, which Picture Password
+ * never offers anyway, and no other app can read it.
+ */
+public final class SablePicturePasswordStore {
+    private static final String TAG = "SablePicturePassword";
+    private static final String PREFS = "sable_picture_password";
+    private static final String KEY_RECORD = "record_";
+    private static final String KEY_FAILURES = "failures_";
+    private static final int MAX_PHOTO_SIDE = 1440;
+
+    private final Context mContext;
+
+    public SablePicturePasswordStore(Context context) {
+        mContext = context.getApplicationContext();
+    }
+
+    private SharedPreferences prefs() {
+        return mContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+    }
+
+    public SablePicturePassword.Record record(int userId) {
+        return SablePicturePassword.Record.decode(prefs().getString(KEY_RECORD + userId, null));
+    }
+
+    public boolean enrolled(int userId) {
+        return record(userId) != null && photoFile(userId).isFile();
+    }
+
+    public int failures(int userId) {
+        return prefs().getInt(KEY_FAILURES + userId, 0);
+    }
+
+    /** One more wrong picture; committed at once so a SystemUI restart cannot reset it. */
+    public void addFailure(int userId) {
+        prefs().edit().putInt(KEY_FAILURES + userId, failures(userId) + 1).commit();
+    }
+
+    /** The PIN or password unlocked: wrong pictures start again from zero. */
+    public void clearFailures(int userId) {
+        if (failures(userId) != 0) prefs().edit().remove(KEY_FAILURES + userId).commit();
+    }
+
+    /** Saves a new Picture Password; the photo is copied in, scaled down. */
+    public boolean save(int userId, SablePicturePassword.Record record, InputStream photo) {
+        final Bitmap bitmap = decode(photo);
+        if (bitmap == null) return false;
+        try (FileOutputStream out = new FileOutputStream(photoFile(userId))) {
+            bitmap.compress(Bitmap.CompressFormat.JPEG, 90, out);
+        } catch (IOException e) {
+            Log.w(TAG, "could not save the photo", e);
+            return false;
+        }
+        return prefs().edit()
+                .putString(KEY_RECORD + userId, record.encode())
+                .remove(KEY_FAILURES + userId)
+                .commit();
+    }
+
+    public void remove(int userId) {
+        prefs().edit().remove(KEY_RECORD + userId).remove(KEY_FAILURES + userId).commit();
+        if (!photoFile(userId).delete()) Log.d(TAG, "no photo to delete");
+    }
+
+    public Bitmap photo(int userId) {
+        return BitmapFactory.decodeFile(photoFile(userId).getPath());
+    }
+
+    private File photoFile(int userId) {
+        return new File(mContext.getFilesDir(), "sable_picture_password_" + userId + ".jpg");
+    }
+
+    private static Bitmap decode(InputStream in) {
+        final Bitmap full = BitmapFactory.decodeStream(in);
+        if (full == null) return null;
+        final int side = Math.max(full.getWidth(), full.getHeight());
+        if (side <= MAX_PHOTO_SIDE) return full;
+        final float scale = (float) MAX_PHOTO_SIDE / side;
+        return Bitmap.createScaledBitmap(full, Math.round(full.getWidth() * scale),
+                Math.round(full.getHeight() * scale), true);
+    }
+}
