+
+package com.android.keyguard.sable;
+
+import android.view.View;
+import android.view.ViewGroup;
+
+import com.android.systemui.res.R;
+
+import java.security.SecureRandom;
+
+/**
+ * Picture Password in the PIN or password bouncer. When it is set up and allowed
+ * ({@link SablePicturePassword#allowed}), it covers the bouncer's own views; Esc or a wrong
+ * picture too many returns to them. With the Stronger second number there are two rounds, each
+ * reshuffled, and a mistake is reported only after the last, so a try never says which number
+ * was wrong. Five wrong pictures put the PIN or password back until it is used.
+ */
+public final class SablePictureBouncer implements SablePicturePasswordView.Listener {
+    /** The bouncer that hosts it. */
+    public interface Host {
+        /** The picture matched: dismiss the keyguard for this user. */
+        void onPictureUnlocked(int userId);
+
+        /** Back to the PIN or password, with a line for the message area (may be null). */
+        void onPictureClosed(CharSequence message);
+    }
+
+    private final ViewGroup mRoot;
+    private final int mUserId;
+    private final Host mHost;
+    private final SablePicturePasswordStore mStore;
+    private final SablePicturePassword.Record mRecord;
+    private final SablePicturePasswordView mView;
+    private final SecureRandom mRandom = new SecureRandom();
+    private int mRound;
+    private boolean mAllMatched = true;
+    private int[] mHidden;
+
+    private SablePictureBouncer(ViewGroup root, int userId, Host host,
+            SablePicturePasswordStore store, SablePicturePassword.Record record) {
+        mRoot = root;
+        mUserId = userId;
+        mHost = host;
+        mStore = store;
+        mRecord = record;
+        mView = new SablePicturePasswordView(root.getContext());
+        mView.setPhoto(store.photo(userId));
+        mView.setListener(this);
+    }
+
+    /**
+     * Shows Picture Password over {@code root} if it is set up for the user and allowed now;
+     * otherwise returns null and leaves the bouncer as it is.
+     */
+    public static SablePictureBouncer showIfAllowed(ViewGroup root, int userId,
+            boolean strongAuthAllowsQuickUnlock, Host host) {
+        final SablePicturePasswordStore store = new SablePicturePasswordStore(root.getContext());
+        final SablePicturePassword.Record record = store.record(userId);
+        if (!SablePicturePassword.allowed(store.enrolled(userId), strongAuthAllowsQuickUnlock,
+                store.failures(userId))) {
+            return null;
+        }
+        final SablePictureBouncer bouncer = new SablePictureBouncer(root, userId, host, store, record);
+        bouncer.show();
+        return bouncer;
+    }
+
+    /** The PIN or password unlocked: wrong pictures start again from zero. */
+    public static void onCredentialUnlock(ViewGroup anyView, int userId) {
+        new SablePicturePasswordStore(anyView.getContext()).clearFailures(userId);
+    }
+
+    private void show() {
+        mHidden = new int[mRoot.getChildCount()];
+        for (int i = 0; i < mHidden.length; i++) {
+            mHidden[i] = mRoot.getChildAt(i).getVisibility();
+            mRoot.getChildAt(i).setVisibility(View.GONE);
+        }
+        mRoot.addView(mView, new ViewGroup.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));
+        startTry(null);
+        mView.requestFocus();
+    }
+
+    /** Puts the bouncer's own views back. */
+    public void close() {
+        if (mView.getParent() == null) return;
+        mRoot.removeView(mView);
+        for (int i = 0; i < mHidden.length && i < mRoot.getChildCount(); i++) {
+            mRoot.getChildAt(i).setVisibility(mHidden[i]);
+        }
+    }
+
+    private void startTry(CharSequence why) {
+        mRound = 0;
+        mAllMatched = true;
+        startRound(why);
+    }
+
+    private void startRound(CharSequence why) {
+        mView.setAttempt(SablePicturePassword.Attempt.start(mRecord.size, mRandom));
+        final String hint = mRecord.numbers() > 1
+                ? res(R.string.sable_picture_round, mRound + 1, mRecord.numbers())
+                : res(R.string.sable_picture_hint);
+        mView.setMessage(why == null ? hint : why + " · " + hint);
+    }
+
+    @Override
+    public void onSubmit() {
+        mAllMatched &= SablePicturePassword.check(mRecord, mRound, currentAttempt());
+        if (++mRound < mRecord.numbers()) {
+            startRound(null);
+            return;
+        }
+        if (mAllMatched) {
+            mStore.clearFailures(mUserId);
+            close();
+            mHost.onPictureUnlocked(mUserId);
+            return;
+        }
+        mStore.addFailure(mUserId);
+        final int left = SablePicturePassword.MAX_FAILURES - mStore.failures(mUserId);
+        if (left <= 0) {
+            close();
+            mHost.onPictureClosed(res(R.string.sable_picture_use_pin_now));
+        } else {
+            startTry(mRoot.getResources().getQuantityString(
+                    R.plurals.sable_picture_wrong, left, left));
+        }
+    }
+
+    @Override
+    public void onUsePin() {
+        close();
+        mHost.onPictureClosed(null);
+    }
+
+    private SablePicturePassword.Attempt currentAttempt() {
+        return mView.attempt();
+    }
+
+    private String res(int id, Object... args) {
+        return mRoot.getResources().getString(id, args);
+    }
+}
