diff --git a/packages/SystemUI/src/com/android/keyguard/sable/SablePictureBouncer.java b/packages/SystemUI/src/com/android/keyguard/sable/SablePictureBouncer.java
new file mode 100644
index 0000000..8abafb5
--- /dev/null
+++ b/packages/SystemUI/src/com/android/keyguard/sable/SablePictureBouncer.java
@@ -0,0 +1,160 @@
+/*
