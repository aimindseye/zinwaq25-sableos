+
+package com.android.keyguard.sable;
+
+import android.content.Context;
+import android.graphics.Bitmap;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.Matrix;
+import android.graphics.Paint;
+import android.view.HapticFeedbackConstants;
+import android.view.KeyEvent;
+import android.view.MotionEvent;
+import android.view.View;
+
+/**
+ * The Picture Password grid over the user's photo, in the bouncer and in enrolment. The trackpad
+ * (arrow keys) or a drag moves the grid one cell at a time with a light tick, Enter submits, and
+ * in pick mode the arrows move a spot marker instead. The view never describes the digits to
+ * accessibility services, so a screen reader cannot speak them.
+ */
+public class SablePicturePasswordView extends View {
+    /** What the user did; the owner decides what it means. */
+    public interface Listener {
+        void onSubmit();
+        void onUsePin();
+    }
+
+    private final Paint mDigit = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint mShade = new Paint();
+    private final Paint mMarker = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Matrix mPhotoMatrix = new Matrix();
+    private Bitmap mPhoto;
+    private SablePicturePassword.Attempt mAttempt;
+    private Listener mListener;
+    /** Pick mode (enrolment): the spot marker, or -1 when the grid moves instead. */
+    private int mPickRow = -1;
+    private int mPickCol = -1;
+    private float mDownX;
+    private float mDownY;
+    private String mMessage;
+
+    public SablePicturePasswordView(Context context) {
+        super(context);
