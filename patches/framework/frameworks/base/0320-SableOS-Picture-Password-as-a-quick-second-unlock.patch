+
+package com.android.keyguard.sable;
+
+import android.app.Activity;
+import android.app.KeyguardManager;
+import android.content.Intent;
+import android.graphics.BitmapFactory;
+import android.net.Uri;
+import android.os.Bundle;
+import android.os.UserManager;
+import android.util.Log;
+import android.view.KeyEvent;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.Button;
+import android.widget.CheckBox;
+import android.widget.LinearLayout;
+import android.widget.RadioButton;
+import android.widget.RadioGroup;
+import android.widget.ScrollView;
+import android.widget.TextView;
+import android.widget.Toast;
+
+import com.android.systemui.res.R;
+
+import java.io.IOException;
+import java.io.InputStream;
+import java.security.SecureRandom;
+import java.text.NumberFormat;
+
+/**
+ * Picture Password setup (org.sableos.keyguard.action.PICTURE_PASSWORD, from Settings > Sable).
+ * It confirms the PIN or password first, then: photo, grid size, precision and the optional
+ * Stronger second number (off by default), each number's digit (typed) and spot (moved with the
+ * trackpad), then {@link SablePicturePassword#PRACTICE_ROUNDS} practice unlocks before saving.
+ * The owner only, since the keyguard reads the owner's SystemUI storage.
+ */
+public class SablePicturePasswordSetupActivity extends Activity
+        implements SablePicturePasswordView.Listener {
+    private static final String TAG = "SablePicturePassword";
+    private static final int REQUEST_CONFIRM = 1;
+    private static final int REQUEST_PHOTO = 2;
+
+    private final SecureRandom mRandom = new SecureRandom();
+    private SablePicturePasswordStore mStore;
+    private Uri mPhoto;
+    private int mSize = SablePicturePassword.DEFAULT_SIZE;
+    private int mTolerance;
+    private boolean mStronger;
+    private SablePicturePassword.Number[] mNumbers;
+    private int mNumberIndex;
+    private int mTypedDigit = -1;
+    private SablePicturePassword.Record mRecord;
+    private int mPracticeDone;
+    private int mPracticeRound;
+    private boolean mPracticeMatched;
+    private SablePicturePasswordView mGrid;
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        setTitle(R.string.sable_picture_setup_title);
+        mStore = new SablePicturePasswordStore(this);
+        final UserManager um = getSystemService(UserManager.class);
+        if (um == null || !um.isSystemUser()) {
+            showText(getString(R.string.sable_picture_setup_owner_only));
+            return;
+        }
+        final KeyguardManager km = getSystemService(KeyguardManager.class);
+        if (km == null || !km.isDeviceSecure()) {
+            showText(getString(R.string.sable_picture_setup_needs_lock));
+            return;
+        }
+        if (savedInstanceState == null) {
+            final Intent confirm = km.createConfirmDeviceCredentialIntent(
+                    getString(R.string.sable_picture_setup_title), null);
+            if (confirm == null) {
+                showStart();
+            } else {
+                startActivityForResult(confirm, REQUEST_CONFIRM);
+            }
+        }
+    }
+
+    @Override
+    protected void onActivityResult(int requestCode, int resultCode, Intent data) {
+        super.onActivityResult(requestCode, resultCode, data);
+        if (requestCode == REQUEST_CONFIRM) {
+            if (resultCode == RESULT_OK) {
+                showStart();
+            } else {
+                finish();
+            }
+        } else if (requestCode == REQUEST_PHOTO && resultCode == RESULT_OK && data != null) {
+            mPhoto = data.getData();
+            showOptions();
+        }
+    }
+
+    private void showText(String text) {
+        final TextView view = new TextView(this);
+        view.setText(text);
+        view.setPadding(32, 32, 32, 32);
+        setContentView(view);
+    }
+
+    private LinearLayout column() {
+        final LinearLayout col = new LinearLayout(this);
+        col.setOrientation(LinearLayout.VERTICAL);
+        col.setPadding(32, 32, 32, 32);
+        return col;
+    }
+
+    private Button button(int text, View.OnClickListener click) {
+        final Button b = new Button(this);
+        b.setText(text);
+        b.setOnClickListener(click);
+        return b;
+    }
+
+    /** Intro, with Set up again and Turn off when one is saved. */
+    private void showStart() {
+        final LinearLayout col = column();
+        final TextView intro = new TextView(this);
+        intro.setText(R.string.sable_picture_setup_intro);
+        col.addView(intro);
+        final Button choose = button(mStore.enrolled(0)
+                ? R.string.sable_picture_setup_change
+                : R.string.sable_picture_setup_choose_photo, v -> pickPhoto());
+        col.addView(choose);
+        if (mStore.enrolled(0)) {
+            col.addView(button(R.string.sable_picture_setup_remove, v -> {
+                mStore.remove(0);
+                Toast.makeText(this, R.string.sable_picture_setup_removed, Toast.LENGTH_SHORT).show();
+                finish();
+            }));
+        }
+        final ScrollView scroll = new ScrollView(this);
+        scroll.addView(col);
+        setContentView(scroll);
+        choose.requestFocus();
+    }
+
+    private void pickPhoto() {
+        startActivityForResult(new Intent(Intent.ACTION_OPEN_DOCUMENT)
+                .addCategory(Intent.CATEGORY_OPENABLE).setType("image/*"), REQUEST_PHOTO);
+    }
+
+    /** Grid size, precision and Stronger, with the strength of the current choice. */
+    private void showOptions() {
+        final LinearLayout col = column();
+        final TextView gridLabel = new TextView(this);
+        gridLabel.setText(R.string.sable_picture_setup_grid);
+        col.addView(gridLabel);
+        final RadioGroup sizes = new RadioGroup(this);
+        for (int s = SablePicturePassword.MIN_SIZE; s <= SablePicturePassword.MAX_SIZE; s++) {
+            final RadioButton b = new RadioButton(this);
+            b.setText(s + " × " + s);
+            b.setId(View.generateViewId());
+            b.setTag(s);
+            sizes.addView(b);
+            if (s == mSize) sizes.check(b.getId());
+        }
+        col.addView(sizes);
+        final RadioGroup precision = new RadioGroup(this);
+        final RadioButton exact = new RadioButton(this);
+        exact.setId(View.generateViewId());
+        exact.setText(R.string.sable_picture_setup_precision_exact);
+        final RadioButton near = new RadioButton(this);
+        near.setId(View.generateViewId());
+        near.setText(R.string.sable_picture_setup_precision_near);
+        precision.addView(exact);
+        precision.addView(near);
+        precision.check(mTolerance == 0 ? exact.getId() : near.getId());
+        col.addView(precision);
+        final CheckBox stronger = new CheckBox(this);
+        stronger.setText(R.string.sable_picture_setup_stronger);
+        stronger.setChecked(mStronger);
+        col.addView(stronger);
+        final TextView strength = new TextView(this);
+        col.addView(strength);
+        final Runnable update = () -> {
+            final View chosen = sizes.findViewById(sizes.getCheckedRadioButtonId());
+            mSize = chosen == null ? SablePicturePassword.DEFAULT_SIZE : (Integer) chosen.getTag();
+            mTolerance = precision.getCheckedRadioButtonId() == near.getId() ? 1 : 0;
+            mStronger = stronger.isChecked();
+            strength.setText(getString(R.string.sable_picture_setup_strength,
+                    NumberFormat.getInstance().format(SablePicturePassword.combinations(
+                            mSize, mTolerance, mStronger ? 2 : 1))));
+        };
+        sizes.setOnCheckedChangeListener((g, id) -> update.run());
+        precision.setOnCheckedChangeListener((g, id) -> update.run());
+        stronger.setOnCheckedChangeListener((b, on) -> update.run());
+        update.run();
+        col.addView(button(R.string.sable_picture_setup_next, v -> startNumbers()));
+        final ScrollView scroll = new ScrollView(this);
+        scroll.addView(col);
+        setContentView(scroll);
+    }
+
+    private void startNumbers() {
+        mNumbers = new SablePicturePassword.Number[mStronger ? 2 : 1];
+        mNumberIndex = 0;
+        mGrid = new SablePicturePasswordView(this);
+        try (InputStream in = getContentResolver().openInputStream(mPhoto)) {
+            mGrid.setPhoto(BitmapFactory.decodeStream(in));
+        } catch (IOException | SecurityException e) {
+            Log.w(TAG, "could not read the photo", e);
+        }
+        mGrid.setListener(this);
+        mGrid.setAttempt(SablePicturePassword.Attempt.start(mSize, mRandom));
+        setContentView(mGrid, new ViewGroup.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));
+        askDigit();
+        mGrid.requestFocus();
+    }
+
+    private void askDigit() {
+        mTypedDigit = -1;
+        mGrid.stopPicking();
+        mGrid.setMessage(getString(R.string.sable_picture_setup_type_number, mNumberIndex + 1));
+    }
+
+    @Override
+    public boolean onKeyDown(int keyCode, KeyEvent event) {
+        // Only while choosing a number: typing a digit here is setup, never unlocking.
+        if (mGrid != null && mRecord == null && mTypedDigit < 0) {
+            final int digit = event.getNumber() - '0';
+            if (digit >= 0 && digit <= 9) {
+                mTypedDigit = digit;
+                mGrid.startPicking();
+                mGrid.setMessage(getString(R.string.sable_picture_setup_pick_spot, digit));
+                return true;
+            }
+        }
+        return super.onKeyDown(keyCode, event);
+    }
+
+    @Override
+    public void onSubmit() {
+        if (mRecord != null) {
+            practiceSubmit();
+            return;
+        }
+        if (mTypedDigit < 0) return;
+        final SablePicturePassword.Number n = new SablePicturePassword.Number(
+                mTypedDigit, mGrid.pickedRow(), mGrid.pickedCol());
+        if (mNumberIndex == 1 && n.digit == mNumbers[0].digit && n.row == mNumbers[0].row
+                && n.col == mNumbers[0].col) {
+            mGrid.setMessage(getString(R.string.sable_picture_setup_same));
+            return;
+        }
+        mNumbers[mNumberIndex++] = n;
+        if (mNumberIndex < mNumbers.length) {
+            askDigit();
+            return;
+        }
+        mRecord = SablePicturePassword.enrol(mSize, mTolerance, mNumbers, mRandom);
+        mNumbers = null;
+        mGrid.stopPicking();
+        mPracticeDone = 0;
+        startPractice(null);
+    }
+
+    private void startPractice(String why) {
+        mPracticeRound = 0;
+        mPracticeMatched = true;
+        nextPracticeRound(why);
+    }
+
+    private void nextPracticeRound(String why) {
+        mGrid.setAttempt(SablePicturePassword.Attempt.start(mSize, mRandom));
+        final String line = getString(R.string.sable_picture_setup_practice,
+                mPracticeDone + 1, SablePicturePassword.PRACTICE_ROUNDS);
+        mGrid.setMessage(why == null ? line : why + " " + line);
+    }
+
+    private void practiceSubmit() {
+        mPracticeMatched &= SablePicturePassword.check(mRecord, mPracticeRound, mGrid.attempt());
+        if (++mPracticeRound < mRecord.numbers()) {
+            nextPracticeRound(null);
+            return;
+        }
+        if (!mPracticeMatched) {
+            startPractice(getString(R.string.sable_picture_setup_practice_wrong));
+            return;
+        }
+        if (++mPracticeDone < SablePicturePassword.PRACTICE_ROUNDS) {
+            startPractice(null);
+            return;
+        }
+        boolean saved = false;
+        try (InputStream in = getContentResolver().openInputStream(mPhoto)) {
+            saved = mStore.save(0, mRecord, in);
+        } catch (IOException | SecurityException e) {
+            Log.w(TAG, "could not read the photo", e);
+        }
+        Toast.makeText(this, saved ? R.string.sable_picture_setup_saved
+                : R.string.sable_picture_setup_failed, Toast.LENGTH_SHORT).show();
+        finish();
+    }
+
+    @Override
+    public void onUsePin() {
+        finish();
+    }
+}
