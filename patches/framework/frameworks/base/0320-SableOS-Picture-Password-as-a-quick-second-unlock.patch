+package com.android.keyguard.sable;
+
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
+import java.util.Random;
+
+/**
+ * Sable Picture Password, after BlackBerry 10's: over the user's photo a grid of digits moves
+ * until the user's secret digit sits on their secret spot. Pure Java (no android.*).
+ *
+ * <p>Improvements over BB10, all in this class:
+ *
+ * <ul>
+ *   <li><b>Optional second number</b> ("Stronger", off by default, owner decision 2026-11-05):
+ *       a second round with its own digit and spot. Each round is reshuffled, and a wrong first
+ *       round is only reported after the second, so an attempt never tells which number failed.
+ *   <li><b>Trackpad first</b>: {@link Attempt#move} shifts the grid one cell per flick or drag
+ *       step; Enter submits. Typing never enters the digit, so nothing typed gives it away.
+ *   <li><b>No smudge trail</b>: every round starts at a random offset with the digits in a fresh
+ *       random order, so no two unlocks move the same way.
+ *   <li><b>Precision</b>: the exact spot, or one cell either way (shown as weaker).
+ *   <li><b>Grid</b>: {@link #MIN_SIZE} to {@link #MAX_SIZE} cells a side.
+ * </ul>
+ *
+ * <p>It is a second, quicker unlock, never the device credential: the PIN or password still
+ * decrypts storage, and {@link #allowed} sends the user to it after a reboot, after the
+ * platform's 72-hour strong-auth timeout and after {@link #MAX_FAILURES} wrong pictures, the same
+ * rules Android applies to fingerprint. Each number is stored only as a salted, iterated SHA-256
+ * of its digit and spot. With at most 1,440 choices per number the hash cannot resist an offline
+ * search, so the record lives in SystemUI's credential-encrypted storage, readable only after the
+ * first PIN unlock; the real protection is the five-try limit.
+ */
+public final class SablePicturePassword {
+    public static final int MIN_SIZE = 8;
+    public static final int MAX_SIZE = 12;
+    public static final int DEFAULT_SIZE = 10;
+    public static final int DIGITS = 10;
+    /** Wrong pictures before the PIN or password is required (then until the next PIN unlock). */
+    public static final int MAX_FAILURES = 5;
+    /** Practice rounds that must pass before enrolment saves. */
+    public static final int PRACTICE_ROUNDS = 3;
+
+    static final int HASH_ROUNDS = 256;
+    /** Steps between neighbouring cells of the digit pattern; coprime with 10 so rows differ. */
+    private static final int ROW_STEP = 3;
+    private static final String RECORD_VERSION = "pp1";
+
+    private SablePicturePassword() {}
+
+    /** One number of the secret: the digit and the cell it must land on. */
+    public static final class Number {
+        public final int digit;
+        public final int row;
+        public final int col;
+
+        public Number(int digit, int row, int col) {
+            this.digit = digit;
+            this.row = row;
+            this.col = col;
+        }
+    }
+
+    /**
+     * One round on screen: the digit order and the grid's offset. Digit at screen cell (r, c) is
+     * {@code order[((r + dr) * ROW_STEP + (c + dc)) mod 10]}, so each digit recurs every few cells
+     * in every row and column and can be brought to any spot within a short move.
+     */
+    public static final class Attempt {
+        public final int size;
+        private final int[] order;
+        private int dr;
+        private int dc;
+
+        Attempt(int size, int[] order, int dr, int dc) {
+            this.size = size;
+            this.order = order.clone();
+            this.dr = dr;
+            this.dc = dc;
+        }
+
+        /** A fresh round: digits in a random order and a random starting offset. */
+        public static Attempt start(int size, Random random) {
+            final int[] order = new int[DIGITS];
+            for (int i = 0; i < DIGITS; i++) order[i] = i;
+            for (int i = DIGITS - 1; i > 0; i--) {
+                final int j = random.nextInt(i + 1);
+                final int t = order[i];
+                order[i] = order[j];
+                order[j] = t;
+            }
+            return new Attempt(clampSize(size), order, random.nextInt(DIGITS), random.nextInt(DIGITS));
+        }
+
+        /** Shifts the grid by whole cells (a trackpad flick or a drag step); wraps endlessly. */
+        public void move(int rows, int cols) {
+            dr = Math.floorMod(dr - rows, DIGITS);
+            dc = Math.floorMod(dc - cols, DIGITS);
+        }
+
+        /** The digit shown at a screen cell. */
+        public int digitAt(int row, int col) {
+            return order[Math.floorMod((row + dr) * ROW_STEP + (col + dc), DIGITS)];
+        }
+
+        /** Whether {@code number}'s digit sits on its spot, or within {@code tolerance} cells. */
+        boolean matches(Number number, int tolerance) {
+            for (int r = number.row - tolerance; r <= number.row + tolerance; r++) {
+                for (int c = number.col - tolerance; c <= number.col + tolerance; c++) {
+                    if (r < 0 || c < 0 || r >= size || c >= size) continue;
+                    if (digitAt(r, c) == number.digit) return true;
+                }
+            }
+            return false;
+        }
+    }
+
+    /** What is stored: grid size, precision and one hashed record per number. */
+    public static final class Record {
+        public final int size;
+        public final int tolerance;
+        final String[] hashed;
+
+        Record(int size, int tolerance, String[] hashed) {
+            this.size = size;
+            this.tolerance = tolerance;
+            this.hashed = hashed;
+        }
+
+        /** 1 for the BB10 picture, 2 with the Stronger second number. */
+        public int numbers() {
+            return hashed.length;
+        }
+
+        /** "pp1:size:tolerance:salt$hash[:salt$hash]". */
+        public String encode() {
+            final StringBuilder b = new StringBuilder(RECORD_VERSION)
+                    .append(':').append(size).append(':').append(tolerance);
+            for (String h : hashed) b.append(':').append(h);
+            return b.toString();
+        }
+
+        /** null for anything this version did not write. */
+        public static Record decode(String stored) {
+            if (stored == null) return null;
+            final String[] parts = stored.split(":");
+            if (parts.length < 4 || parts.length > 5 || !RECORD_VERSION.equals(parts[0])) return null;
+            try {
+                final int size = Integer.parseInt(parts[1]);
+                final int tolerance = Integer.parseInt(parts[2]);
+                if (size != clampSize(size) || tolerance < 0 || tolerance > 1) return null;
+                final String[] hashed = new String[parts.length - 3];
+                for (int i = 0; i < hashed.length; i++) {
+                    if (parts[3 + i].indexOf('$') <= 0) return null;
+                    hashed[i] = parts[3 + i];
+                }
+                return new Record(size, tolerance, hashed);
+            } catch (NumberFormatException e) {
+                return null;
+            }
+        }
+    }
+
+    /**
+     * Makes the stored record. {@code numbers} has one entry, or two with Stronger; a second
+     * number must differ from the first in digit or spot.
+     */
+    public static Record enrol(int size, int tolerance, Number[] numbers, Random salts) {
+        if (numbers.length < 1 || numbers.length > 2) throw new IllegalArgumentException("numbers");
+        final int s = clampSize(size);
+        final String[] hashed = new String[numbers.length];
+        for (int i = 0; i < numbers.length; i++) {
+            final Number n = numbers[i];
+            if (n.digit < 0 || n.digit >= DIGITS || n.row < 0 || n.col < 0 || n.row >= s || n.col >= s) {
+                throw new IllegalArgumentException("number " + i);
+            }
+            final String salt = Long.toHexString(salts.nextLong());
+            hashed[i] = salt + '$' + hash(salt, n.digit, n.row, n.col);
+        }
+        if (numbers.length == 2 && hashed[0].equals(hashed[1])) throw new IllegalArgumentException("same");
+        return new Record(s, Math.max(0, Math.min(1, tolerance)), hashed);
+    }
+
+    /**
+     * Whether round {@code index}'s grid puts that number's digit on its spot. Every spot and the
+     * digits around it are tried against the stored hash, so the secret is never kept in clear.
+     */
+    public static boolean check(Record record, int index, Attempt attempt) {
+        final String entry = record.hashed[index];
+        final String salt = entry.substring(0, entry.indexOf('$'));
+        final String expected = entry.substring(entry.indexOf('$') + 1);
+        final int t = record.tolerance;
+        boolean found = false;
+        for (int row = 0; row < record.size; row++) {
+            for (int col = 0; col < record.size; col++) {
+                int seen = 0;
+                for (int r = row - t; r <= row + t; r++) {
+                    for (int c = col - t; c <= col + t; c++) {
+                        if (r < 0 || c < 0 || r >= record.size || c >= record.size) continue;
+                        final int digit = attempt.digitAt(r, c);
+                        if ((seen & (1 << digit)) != 0) continue;
+                        seen |= 1 << digit;
+                        // No early exit, so the time taken does not hint at the spot.
+                        found |= MessageDigest.isEqual(
+                                bytes(hash(salt, digit, row, col)), bytes(expected));
+                    }
+                }
+            }
+        }
+        return found;
+    }
+
+    /**
+     * Picture Password may be offered: it is set up, the platform allows a non-credential unlock
+     * now (false after a reboot and after the 72-hour strong-auth timeout, the rules fingerprint
+     * follows) and fewer than {@link #MAX_FAILURES} wrong pictures since the last PIN unlock.
+     */
+    public static boolean allowed(boolean enrolled, boolean strongAuthAllowsQuickUnlock, int failures) {
+        return enrolled && strongAuthAllowsQuickUnlock && failures < MAX_FAILURES;
+    }
+
+    /** Combinations an attacker must cover, for the strength line in enrolment. */
+    public static long combinations(int size, int tolerance, int numbers) {
+        final int s = clampSize(size);
+        final long cells = (long) s * s;
+        // One cell either way lets roughly nine spots count for each digit.
+        final long perNumber = Math.max(1, DIGITS * cells / (tolerance == 0 ? 1 : 9));
+        return numbers >= 2 ? perNumber * perNumber : perNumber;
+    }
+
+    public static int clampSize(int size) {
+        return Math.max(MIN_SIZE, Math.min(MAX_SIZE, size));
+    }
+
+    static String hash(String salt, int digit, int row, int col) {
+        try {
+            final MessageDigest sha = MessageDigest.getInstance("SHA-256");
+            byte[] value = (salt + '|' + digit + '|' + row + '|' + col).getBytes(StandardCharsets.UTF_8);
+            for (int i = 0; i < HASH_ROUNDS; i++) {
+                sha.update(salt.getBytes(StandardCharsets.UTF_8));
+                value = sha.digest(value);
+            }
+            final StringBuilder hex = new StringBuilder(value.length * 2);
+            for (byte v : value) hex.append(String.format("%02x", v));
+            return hex.toString();
+        } catch (NoSuchAlgorithmException e) {
+            throw new IllegalStateException(e);
+        }
+    }
+
+    private static byte[] bytes(String s) {
+        return s.getBytes(StandardCharsets.UTF_8);
+    }
+}
