diff --git a/packages/SystemUI/multivalentTests/src/com/android/systemui/keyguard/domain/interactor/KeyguardKeyEventInteractorTest.kt b/packages/SystemUI/multivalentTests/src/com/android/systemui/keyguard/domain/interactor/KeyguardKeyEventInteractorTest.kt
index ca7af557..2caa7f4e 100644
--- a/packages/SystemUI/multivalentTests/src/com/android/systemui/keyguard/domain/interactor/KeyguardKeyEventInteractorTest.kt
+++ b/packages/SystemUI/multivalentTests/src/com/android/systemui/keyguard/domain/interactor/KeyguardKeyEventInteractorTest.kt
@@ -21,6 +21,7 @@ import android.media.session.MediaSessionLegacyHelper
 import android.view.KeyEvent
 import androidx.test.ext.junit.runners.AndroidJUnit4
 import androidx.test.filters.SmallTest
+import com.android.keyguard.sable.SableEmergencyShortcut
 import com.android.systemui.SysuiTestCase
 import com.android.systemui.back.domain.interactor.BackActionInteractor
 import com.android.systemui.deviceentry.domain.interactor.DeviceEntryInteractor
@@ -72,6 +73,7 @@ class KeyguardKeyEventInteractorTest : SysuiTestCase() {
     @Mock private lateinit var mediaSessionLegacyHelper: MediaSessionLegacyHelper
     @Mock private lateinit var backActionInteractor: BackActionInteractor
     @Mock private lateinit var deviceEntryInteractor: DeviceEntryInteractor
+    @Mock private lateinit var sableEmergencyShortcut: SableEmergencyShortcut
 
     private lateinit var underTest: KeyguardKeyEventInteractor
 
@@ -322,4 +324,37 @@ class KeyguardKeyEventInteractorTest : SysuiTestCase() {
                 eq("KeyguardKeyEventInteractor#collapseShadeLockedOrShowPrimaryBouncer"),
             )
     }
+
+    @Test
+    fun dispatchKeyEventPreIme_altSpaceOnKeyguard_opensEmergencyDialer() {
+        // Sable: Alt+Space is the keyboard emergency shortcut; its DOWN and UP are consumed.
+        val withShortcut =
+            KeyguardKeyEventInteractor(
+                context,
+                statusBarStateController,
+                statusBarKeyguardViewManager,
+                shadeController,
+                mediaSessionLegacyHelperWrapper,
+                backActionInteractor,
+                deviceEntryInteractor,
+                powerInteractor,
+                kosmos.keyguardMediaKeyInteractor,
+                { sableEmergencyShortcut },
+            )
+        whenever(statusBarStateController.state).thenReturn(StatusBarState.KEYGUARD)
+        whenever(sableEmergencyShortcut.isAvailable()).thenReturn(true)
+        val down =
+            KeyEvent(0, 0, KeyEvent.ACTION_DOWN, KeyEvent.KEYCODE_SPACE, 0, KeyEvent.META_ALT_ON)
+        val up = KeyEvent(0, 0, KeyEvent.ACTION_UP, KeyEvent.KEYCODE_SPACE, 0, 0)
+
+        assertThat(withShortcut.dispatchKeyEventPreIme(down)).isTrue()
+        assertThat(withShortcut.dispatchKeyEventPreIme(up)).isTrue()
+        verify(sableEmergencyShortcut).launch()
+
+        // Plain Space keeps its confirm meaning.
+        clearInvocations(sableEmergencyShortcut)
+        val plain = KeyEvent(KeyEvent.ACTION_DOWN, KeyEvent.KEYCODE_SPACE)
+        assertThat(withShortcut.dispatchKeyEventPreIme(plain)).isFalse()
+        verify(sableEmergencyShortcut, never()).launch()
+    }
 }
