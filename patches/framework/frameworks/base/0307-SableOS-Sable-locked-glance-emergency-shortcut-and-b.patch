+     limitations under the License.
+-->
+<!-- Sable locked glance under the lock screen clock (sable-lockscreen-titan2): "Locked", the
+     Hub count row, the private mode card and "Open/reply requires unlock". Counts only. -->
+<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
+    android:id="@+id/sable_keyguard_glance"
+    android:layout_width="0dp"
+    android:layout_height="wrap_content"
+    android:orientation="vertical"
+    android:importantForAccessibility="yes"
+    android:visibility="gone">
+
+    <TextView
+        android:id="@+id/sable_keyguard_locked"
+        android:layout_width="match_parent"
+        android:layout_height="wrap_content"
+        android:gravity="center_horizontal"
+        android:text="@string/sable_keyguard_locked"
+        android:textColor="@color/sable_keyguard_text_secondary"
+        android:textSize="18sp"
+        android:visibility="gone" />
+
+    <TextView
+        android:id="@+id/sable_keyguard_counts"
+        android:layout_width="match_parent"
+        android:layout_height="wrap_content"
+        android:layout_marginTop="@dimen/sable_keyguard_card_gap"
+        android:background="@drawable/sable_keyguard_focus_ring"
+        android:ellipsize="end"
+        android:maxLines="1"
+        android:paddingHorizontal="@dimen/sable_keyguard_card_padding_horizontal"
+        android:paddingVertical="@dimen/sable_keyguard_card_padding_vertical"
+        android:textColor="@color/sable_keyguard_text_primary"
+        android:textSize="15sp"
+        android:accessibilityLiveRegion="polite"
+        android:visibility="gone" />
+
+    <LinearLayout
+        android:id="@+id/sable_keyguard_private"
+        android:layout_width="match_parent"
+        android:layout_height="wrap_content"
+        android:layout_marginTop="@dimen/sable_keyguard_card_gap"
+        android:background="@drawable/sable_keyguard_card"
+        android:orientation="vertical"
+        android:paddingHorizontal="@dimen/sable_keyguard_card_padding_horizontal"
+        android:paddingVertical="@dimen/sable_keyguard_card_padding_vertical"
+        android:visibility="gone">
+
+        <TextView
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:text="@string/sable_keyguard_private_title"
+            android:textColor="@color/sable_keyguard_text_secondary"
+            android:textSize="11sp" />
+
+        <TextView
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:text="@string/sable_keyguard_private_text"
+            android:textColor="@color/sable_keyguard_text_primary"
+            android:textSize="15sp" />
+    </LinearLayout>
+
+    <TextView
+        android:id="@+id/sable_keyguard_requires_unlock"
+        android:layout_width="match_parent"
+        android:layout_height="wrap_content"
+        android:layout_marginTop="@dimen/sable_keyguard_card_gap"
+        android:gravity="center_horizontal"
+        android:text="@string/sable_keyguard_requires_unlock"
+        android:textColor="@color/sable_keyguard_text_warning"
+        android:textSize="12sp"
+        android:visibility="gone" />
+</LinearLayout>
