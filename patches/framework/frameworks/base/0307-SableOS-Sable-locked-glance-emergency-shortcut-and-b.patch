+package com.android.keyguard.sable;
+
+import android.annotation.SuppressLint;
+import android.app.ActivityOptions;
+import android.app.ActivityTaskManager;
+import android.content.Context;
+import android.content.Intent;
+import android.content.pm.PackageManager;
+import android.os.PowerManager;
+import android.os.SystemClock;
+import android.os.UserHandle;
+import android.telecom.TelecomManager;
+import android.util.Log;
+
+import androidx.annotation.Nullable;
+
+import com.android.keyguard.KeyguardUpdateMonitor;
+import com.android.systemui.dagger.SysUISingleton;
+import com.android.systemui.dagger.qualifiers.Background;
+import com.android.systemui.dagger.qualifiers.Main;
+import com.android.systemui.shade.ShadeController;
+import com.android.systemui.user.domain.interactor.SelectedUserInteractor;
+import com.android.systemui.util.EmergencyDialerConstants;
+
+import java.util.concurrent.Executor;
+
+import javax.inject.Inject;
+
+/**
+ * Sable: the keyboard emergency shortcut (Alt+Space, {@link SableKeyguardKeys#isEmergencyChord})
+ * does what the bouncer's Emergency button does (EmergencyButtonController
+ * #takeEmergencyCallAction): return to a call in progress, or open the emergency dialer over the
+ * lock screen. It never dials, unlocks or touches the credential.
+ */
+@SysUISingleton
+public class SableEmergencyShortcut {
+    private static final String TAG = "SableEmergencyShortcut";
+
+    private final Context mContext;
+    private final KeyguardUpdateMonitor mKeyguardUpdateMonitor;
+    private final PowerManager mPowerManager;
+    private final ActivityTaskManager mActivityTaskManager;
+    private final ShadeController mShadeController;
+    @Nullable
+    private final TelecomManager mTelecomManager;
+    private final Executor mMainExecutor;
+    private final Executor mBackgroundExecutor;
+    private final SelectedUserInteractor mSelectedUserInteractor;
+
+    @Inject
+    public SableEmergencyShortcut(Context context,
+            KeyguardUpdateMonitor keyguardUpdateMonitor,
+            PowerManager powerManager,
+            ActivityTaskManager activityTaskManager,
+            ShadeController shadeController,
+            @Nullable TelecomManager telecomManager,
+            @Main Executor mainExecutor,
+            @Background Executor backgroundExecutor,
+            SelectedUserInteractor selectedUserInteractor) {
+        mContext = context;
+        mKeyguardUpdateMonitor = keyguardUpdateMonitor;
+        mPowerManager = powerManager;
+        mActivityTaskManager = activityTaskManager;
+        mShadeController = shadeController;
+        mTelecomManager = telecomManager;
+        mMainExecutor = mainExecutor;
+        mBackgroundExecutor = backgroundExecutor;
+        mSelectedUserInteractor = selectedUserInteractor;
+    }
+
+    /** Whether this device can place calls, so the shortcut and its hint apply. */
+    public boolean isAvailable() {
+        return mTelecomManager != null && mContext.getPackageManager()
+                .hasSystemFeature(PackageManager.FEATURE_TELEPHONY_CALLING);
+    }
+
+    /** Returns to the call in progress or opens the emergency dialer. */
+    @SuppressLint("MissingPermission")
+    public void launch() {
+        if (!isAvailable()) {
+            return;
+        }
+        mPowerManager.userActivity(SystemClock.uptimeMillis(), true);
+        mActivityTaskManager.stopSystemLockTaskMode();
+        mShadeController.collapseShade(false);
+        // TelecomManager calls are binder calls: off the main thread, as the Emergency button.
+        mBackgroundExecutor.execute(() -> {
+            final boolean isInCall = mTelecomManager.isInCall();
+            mMainExecutor.execute(() -> {
+                if (isInCall) {
+                    mTelecomManager.showInCallScreen(false);
+                    return;
+                }
+                mKeyguardUpdateMonitor.reportEmergencyCallAction(true /* bypassHandler */);
+                final Intent intent = mTelecomManager.createLaunchEmergencyDialerIntent(null)
+                        .setFlags(Intent.FLAG_ACTIVITY_NEW_TASK
+                                | Intent.FLAG_ACTIVITY_EXCLUDE_FROM_RECENTS
+                                | Intent.FLAG_ACTIVITY_CLEAR_TOP)
+                        .putExtra(EmergencyDialerConstants.EXTRA_ENTRY_TYPE,
+                                EmergencyDialerConstants.ENTRY_TYPE_LOCKSCREEN_BUTTON);
+                try {
+                    mContext.startActivityAsUser(intent,
+                            ActivityOptions.makeCustomAnimation(mContext, 0, 0).toBundle(),
+                            new UserHandle(mSelectedUserInteractor.getSelectedUserId()));
+                } catch (RuntimeException e) {
+                    Log.w(TAG, "Cannot open the emergency dialer", e);
+                }
+            });
+        });
+    }
+}
