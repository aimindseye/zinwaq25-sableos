+import com.android.systemui.keyguard.ui.viewmodel.KeyguardClockViewModel
+import com.android.systemui.plugins.keyguard.ui.clocks.ClockViewIds
+import com.android.systemui.plugins.statusbar.StatusBarStateController
+import com.android.systemui.res.R
+import com.android.systemui.shade.ShadeDisplayAware
+import com.android.systemui.statusbar.NotificationLockscreenUserManager
+import com.android.systemui.statusbar.notification.collection.NotifPipeline
+import com.android.systemui.statusbar.notification.collection.NotificationEntry
+import com.android.systemui.statusbar.notification.collection.notifcollection.NotifCollectionListener
+import com.android.systemui.statusbar.notification.interruption.KeyguardNotificationVisibilityProvider
+import com.android.systemui.statusbar.policy.KeyguardStateController
+import javax.inject.Inject
+
+/**
+ * Sable locked glance (LOCKSCREEN_SECURE_ENTRY_UX, sable-lockscreen-titan2) under the lock screen
+ * clock: "Locked" while the keyguard is secure and not unlocked; the Hub count row ("2 Messages ·
+ * 1 Mail · 1 Missed call", hidden when all are zero) of the notifications the lock screen may
+ * show; the "Private mode · Counts only until unlock" card when lock screen notification content
+ * is hidden; and "Open/reply requires unlock" under it while such notifications are shown.
+ *
+ * Counts only: no title, text or sender is read. Notifications the keyguard hides (secret, a user
+ * or profile setting, silent ones when hidden, lock screen notifications off) are not counted, so
+ * with lock screen notifications off the count row stays hidden. Hidden while dozing. The
+ * notification stack starts below the glance. Legacy (blueprint) keyguard only.
+ */
+@SysUISingleton
+class SableLockGlanceSection
+@Inject
+constructor(
+    @ShadeDisplayAware private val context: Context,
+    private val keyguardClockViewModel: KeyguardClockViewModel,
+    private val notifPipeline: NotifPipeline,
+    private val visibilityProvider: KeyguardNotificationVisibilityProvider,
+    private val lockscreenUserManager: NotificationLockscreenUserManager,
+    private val keyguardStateController: KeyguardStateController,
+    private val statusBarStateController: StatusBarStateController,
+) : KeyguardSection() {
+    private var glanceView: View? = null
+    private var listening = false
+
+    private val collectionListener =
+        object : NotifCollectionListener {
+            override fun onEntryAdded(entry: NotificationEntry) = refresh()
+
+            override fun onEntryUpdated(entry: NotificationEntry) = refresh()
+
+            override fun onEntryRemoved(entry: NotificationEntry, reason: Int) = refresh()
+
+            override fun onRankingApplied() = refresh()
+        }
+
+    private val keyguardStateCallback =
+        object : KeyguardStateController.Callback {
+            override fun onUnlockedChanged() = refresh()
+
+            override fun onKeyguardShowingChanged() = refresh()
+        }
+
+    private val statusBarStateListener =
+        object : StatusBarStateController.StateListener {
+            override fun onDozingChanged(isDozing: Boolean) = refresh()
+
+            override fun onStateChanged(newState: Int) = refresh()
+        }
+
+    override fun addViews(constraintLayout: ConstraintLayout) {
+        val view =
+            LayoutInflater.from(context)
+                .inflate(R.layout.sable_keyguard_glance, constraintLayout, false)
+        glanceView = view
+        constraintLayout.addView(view)
+        startListening()
+        refresh()
+    }
+
+    override fun bindData(constraintLayout: ConstraintLayout) {
+        refresh()
+    }
+
+    override fun applyConstraints(constraintSet: ConstraintSet) {
+        val res = context.resources
+        val horizontal = res.getDimensionPixelSize(R.dimen.sable_keyguard_glance_margin_horizontal)
+        val top = res.getDimensionPixelSize(R.dimen.sable_keyguard_glance_margin_top)
+        constraintSet.apply {
+            constrainWidth(ID, ConstraintSet.MATCH_CONSTRAINT)
+            constrainHeight(ID, ConstraintSet.WRAP_CONTENT)
+            connect(ID, START, PARENT_ID, START, horizontal)
+            connect(ID, END, PARENT_ID, END, horizontal)
+            if (keyguardClockViewModel.isLargeClockVisible.value) {
+                connect(ID, TOP, ClockViewIds.LOCKSCREEN_CLOCK_VIEW_LARGE, BOTTOM, top)
+            } else {
+                // Below the small clock and the date (smartspace or slice barrier).
+                connect(ID, TOP, R.id.smart_space_barrier_bottom, BOTTOM, top)
+            }
+            if (!res.getBoolean(R.bool.config_use_large_screen_shade_header)) {
+                // Notifications start below the glance; while it is gone, where they did.
+                connect(
+                    R.id.nssl_placeholder,
+                    TOP,
+                    ID,
+                    BOTTOM,
+                    res.getDimensionPixelSize(R.dimen.keyguard_status_view_bottom_margin),
+                )
+            }
+        }
+    }
+
+    override fun removeViews(constraintLayout: ConstraintLayout) {
+        glanceView?.let { if (it.parent == constraintLayout) constraintLayout.removeView(it) }
+        glanceView = null
+    }
+
+    private fun startListening() {
+        if (listening) return
+        listening = true
+        notifPipeline.addCollectionListener(collectionListener)
+        visibilityProvider.addOnStateChangedListener { refresh() }
+        lockscreenUserManager.addNotificationStateChangedListener { refresh() }
+        keyguardStateController.addCallback(keyguardStateCallback)
+        statusBarStateController.addCallback(statusBarStateListener)
+    }
+
+    private fun refresh() {
+        val view = glanceView ?: return
+        val counts = SableLockGlance.Counts()
+        if (keyguardStateController.isShowing) {
+            for (entry in notifPipeline.allNotifs) {
+                if (visibilityProvider.shouldHideNotification(entry)) continue
+                val sbn = entry.sbn
+                counts.add(
+                    SableLockGlance.bucketFor(
+                        sbn.notification.category,
+                        sbn.packageName,
+                        sbn.notification.isGroupSummary,
+                        sbn.isOngoing,
+                    )
+                )
+            }
+        }
+        val userId = lockscreenUserManager.currentUserId
+        val privateMode =
+            lockscreenUserManager.isLockscreenPublicMode(userId) &&
+                lockscreenUserManager.shouldShowLockscreenNotifications() &&
+                !lockscreenUserManager.userAllowsPrivateNotificationsInPublic(userId)
+        val locked =
+            keyguardStateController.isMethodSecure && !keyguardStateController.canDismissLockScreen()
+        val glance =
+            SableLockGlance.Glance(statusBarStateController.isDozing, locked, privateMode, counts)
+
+        view.findViewById<View>(R.id.sable_keyguard_locked).visibleIf(glance.lockedLabel)
+        view.findViewById<TextView>(R.id.sable_keyguard_counts).apply {
+            visibleIf(glance.countRow)
+            if (glance.countRow) text = countText(counts)
+        }
+        view.findViewById<View>(R.id.sable_keyguard_private).visibleIf(glance.privateCard)
+        view.findViewById<View>(R.id.sable_keyguard_requires_unlock)
+            .visibleIf(glance.requiresUnlockLine)
+        view.visibleIf(glance.any())
+    }
+
+    private fun countText(counts: SableLockGlance.Counts): String {
+        val res = context.resources
+        val parts = buildList {
+            if (counts.messages > 0) {
+                add(res.getQuantityString(R.plurals.sable_keyguard_count_messages, counts.messages, counts.messages))
+            }
+            if (counts.mail > 0) {
+                add(res.getQuantityString(R.plurals.sable_keyguard_count_mail, counts.mail, counts.mail))
+            }
+            if (counts.missedCalls > 0) {
+                add(
+                    res.getQuantityString(
+                        R.plurals.sable_keyguard_count_missed_calls,
+                        counts.missedCalls,
+                        counts.missedCalls,
+                    )
+                )
+            }
+        }
+        return parts.joinToString(res.getString(R.string.sable_keyguard_count_separator))
+    }
+
+    private fun View.visibleIf(show: Boolean) {
+        val wanted = if (show) View.VISIBLE else View.GONE
+        if (visibility != wanted) visibility = wanted
+    }
+
+    private companion object {
+        val ID = R.id.sable_keyguard_glance
+    }
+}
