+
+package com.android.keyguard.sable;
+
+import java.util.Arrays;
+import java.util.HashSet;
+import java.util.Set;
+
+/**
+ * The Sable locked glance (LOCKSCREEN_SECURE_ENTRY_UX, sable-lockscreen-titan2): which Hub count
+ * bucket a lock screen notification falls in ("2 Messages · 1 Mail · 1 Missed call"), what each
+ * part of the glance shows, and the "N new · content hidden" count of a redacted notification.
+ *
+ * <p>Counts only: nothing here reads a title, a text or a sender. Pure (no android.* imports) so
+ * it can be tested off-device; android.app.Notification category values are copied.
+ */
+public final class SableLockGlance {
+    /** Not counted. */
+    public static final int BUCKET_NONE = 0;
+    /** Messages (SMS, chat). */
+    public static final int BUCKET_MESSAGES = 1;
+    /** Mail. */
+    public static final int BUCKET_MAIL = 2;
+    /** Missed calls. */
+    public static final int BUCKET_MISSED_CALL = 3;
+
+    // android.app.Notification categories.
+    static final String CATEGORY_MESSAGE = "msg";
+    static final String CATEGORY_EMAIL = "email";
+    static final String CATEGORY_MISSED_CALL = "missed_call";
+
+    /** Messaging apps recognised when a notification carries no category. */
+    static final Set<String> MESSAGE_PACKAGES = new HashSet<>(Arrays.asList(
+            "org.sableos.messages",
+            "com.android.messaging",
+            "com.google.android.apps.messaging",
+            "org.thoughtcrime.securesms",
+            "org.telegram.messenger",
+            "com.whatsapp",
+            "im.molly.app"));
+
+    /** Mail apps recognised without a category (the Hub list, HubMailSources.KNOWN_PACKAGES). */
+    static final Set<String> MAIL_PACKAGES = new HashSet<>(Arrays.asList(
+            "com.google.android.gm",
+            "com.microsoft.office.outlook",
+            "ch.protonmail.android",
+            "com.yahoo.mobile.client.android.mail",
+            "com.readdle.spark",
+            "eu.faircode.email",
+            "com.fsck.k9",
+            "net.thunderbird.android",
+            "com.samsung.android.email.provider",
+            "me.bluemail.mail",
+            "de.tutao.tutanota",
+            "com.fastmail.app",
+            "org.sableos.mail",
+            "com.android.email"));
+
+    private SableLockGlance() {}
+
+    /**
+     * The count bucket of a notification the lock screen may show. Group summaries are never
+     * counted (their children are), nor are ongoing notifications (a call in progress, a
+     * download). The category wins; known apps without a category are counted by package.
+     */
+    public static int bucketFor(String category, String packageName, boolean groupSummary,
+            boolean ongoing) {
+        if (groupSummary || ongoing) {
+            return BUCKET_NONE;
+        }
+        if (CATEGORY_MISSED_CALL.equals(category)) {
+            return BUCKET_MISSED_CALL;
+        }
+        if (CATEGORY_EMAIL.equals(category)) {
+            return BUCKET_MAIL;
+        }
+        if (CATEGORY_MESSAGE.equals(category)) {
+            return BUCKET_MESSAGES;
+        }
+        if (category != null && !category.isEmpty()) {
+            // An app that says what it is (event, alarm, call, ...) is not mail or a message.
+            return BUCKET_NONE;
+        }
+        if (packageName != null && MAIL_PACKAGES.contains(packageName)) {
+            return BUCKET_MAIL;
+        }
+        if (packageName != null && MESSAGE_PACKAGES.contains(packageName)) {
+            return BUCKET_MESSAGES;
+        }
+        return BUCKET_NONE;
+    }
+
+    /** Hub counts of the notifications the lock screen may show. */
+    public static final class Counts {
+        public int messages;
+        public int mail;
+        public int missedCalls;
+        /** Every lock screen notification, counted or not. */
+        public int total;
+
+        /** Counts one lock screen notification. */
+        public void add(int bucket) {
+            total++;
+            switch (bucket) {
+                case BUCKET_MESSAGES:
+                    messages++;
+                    break;
+                case BUCKET_MAIL:
+                    mail++;
+                    break;
+                case BUCKET_MISSED_CALL:
+                    missedCalls++;
+                    break;
+                default:
+                    break;
+            }
+        }
+
+        /** Whether the count row has nothing to show (it is hidden then). */
+        public boolean isEmpty() {
+            return messages == 0 && mail == 0 && missedCalls == 0;
+        }
+    }
+
+    /**
+     * What the glance under the clock shows. {@code locked}: the keyguard is secure and not
+     * unlocked (trust agent, biometrics). {@code privateMode}: the user is in public mode and
+     * hides notification content on the lock screen. Nothing shows while dozing.
+     */
+    public static final class Glance {
+        public final boolean lockedLabel;
+        public final boolean countRow;
+        public final boolean privateCard;
+        public final boolean requiresUnlockLine;
+
+        public Glance(boolean dozing, boolean locked, boolean privateMode, Counts counts) {
+            lockedLabel = !dozing && locked;
+            countRow = !dozing && !counts.isEmpty();
+            privateCard = !dozing && privateMode;
+            requiresUnlockLine = !dozing && privateMode && counts.total > 0;
+        }
+
+        /** Whether any part shows. */
+        public boolean any() {
+            return lockedLabel || countRow || privateCard || requiresUnlockLine;
+        }
+    }
+
+    /**
+     * How many new items a redacted notification stands for ("N new · content hidden"): the
+     * notification's number, else the messages of a messaging-style notification, else 1.
+     */
+    public static int newCount(int number, int messageCount) {
+        if (number > 0) {
+            return number;
+        }
+        return Math.max(1, messageCount);
+    }
+}
