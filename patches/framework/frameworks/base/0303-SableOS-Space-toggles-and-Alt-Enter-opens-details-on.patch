+/**
+ * Sable keyboard-first tile keys ([SableTileKeys]): Space toggles, Alt+Enter opens details or
+ * settings. Arrows and Enter stay with Compose focus traversal and the tile's clickable, whose
+ * focus ring is drawn by [borderOnFocus]. Placed before the clickable so it sees the key first.
+ */
+private fun Modifier.sableTileKeys(onToggle: () -> Unit, onDetails: () -> Unit): Modifier =
+    onPreviewKeyEvent { keyEvent ->
+        val event = keyEvent.nativeKeyEvent
+        when (
+            SableTileKeys.actionFor(event.keyCode, event.metaState, event.action, event.repeatCount)
+        ) {
+            SableTileKeys.TOGGLE -> {
+                onToggle()
+                true
+            }
+            SableTileKeys.DETAILS -> {
+                onDetails()
+                true
+            }
+            SableTileKeys.CONSUME -> true
+            else -> false
+        }
+    }
+
 @Composable
