+package com.android.systemui.qs.sable;
+
+/**
+ * Keys on a focused Quick Settings tile (keyboard-first shade design).
+ *
+ * <ul>
+ *   <li>Arrows move focus and Enter activates the tile: both stay with Compose (focus traversal
+ *       and the tile's clickable), so they are {@link #PASS}.
+ *   <li>Space toggles the tile. On a dual-target tile (Internet, Bluetooth...) Enter opens the
+ *       tile's dialog or details while Space flips the switch.
+ *   <li>Alt+Enter is the design's Menu / Fn+Enter for keyboards without Fn: the tile's details or
+ *       settings, as a long press opens them.
+ * </ul>
+ *
+ * <p>The action runs on the first key-down; its repeats and its key-up are {@link #CONSUME}d so
+ * the tile's clickable never also clicks. Any other modifier (Ctrl, Meta, Sym, Fn, Shift) leaves
+ * the key alone. Pure: android.view.KeyEvent values are copied so it can be tested off-device.
+ */
+public final class SableTileKeys {
+    /** Not ours: Compose focus navigation and the tile's own click handling. */
+    public static final int PASS = 0;
+    /** Ours but nothing to do now (repeat or key-up of a handled key). */
+    public static final int CONSUME = 1;
+    /** Toggle the tile. */
+    public static final int TOGGLE = 2;
+    /** Open the tile's details or settings (its long-press action). */
+    public static final int DETAILS = 3;
+
+    // android.view.KeyEvent key codes, actions and meta state bits.
+    static final int KEYCODE_DPAD_CENTER = 23;
+    static final int KEYCODE_SPACE = 62;
+    static final int KEYCODE_ENTER = 66;
+    static final int KEYCODE_NUMPAD_ENTER = 160;
+    static final int ACTION_DOWN = 0;
+    private static final int META_SHIFT_MASK = 0x01 | 0x40 | 0x80;
+    private static final int META_ALT_MASK = 0x02 | 0x10 | 0x20;
+    private static final int META_SYM_ON = 0x04;
+    private static final int META_FUNCTION_ON = 0x08;
+    private static final int META_CTRL_MASK = 0x1000 | 0x2000 | 0x4000;
+    private static final int META_META_MASK = 0x10000 | 0x20000 | 0x40000;
+    private static final int NON_ALT_MODIFIERS =
+            META_SHIFT_MASK | META_SYM_ON | META_FUNCTION_ON | META_CTRL_MASK | META_META_MASK;
+
+    private SableTileKeys() {}
+
+    /** What a key event on a focused tile does; {@code action} is the KeyEvent action. */
+    public static int actionFor(int keyCode, int metaState, int action, int repeatCount) {
+        if ((metaState & NON_ALT_MODIFIERS) != 0) {
+            return PASS;
+        }
+        final boolean alt = (metaState & META_ALT_MASK) != 0;
+        final int command;
+        if (keyCode == KEYCODE_SPACE && !alt) {
+            command = TOGGLE;
+        } else if (alt && (keyCode == KEYCODE_ENTER || keyCode == KEYCODE_NUMPAD_ENTER
+                || keyCode == KEYCODE_DPAD_CENTER)) {
+            command = DETAILS;
+        } else {
+            return PASS;
+        }
+        return action == ACTION_DOWN && repeatCount == 0 ? command : CONSUME;
+    }
+}
