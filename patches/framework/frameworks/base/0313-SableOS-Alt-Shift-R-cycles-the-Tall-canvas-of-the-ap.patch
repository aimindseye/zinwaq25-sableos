+package com.android.server.policy.sable;
+
+/**
+ * Sable resolution hotkey for keyboards without Ctrl or Fn (the Q25: Alt, Shift, Sym and letters).
+ *
+ * <p>Alt+Shift+R (Sym is Right Alt, so Sym+Shift+R too) asks Sable Display Compat to move the app
+ * in front to its next favourite Tall canvas size. Alt+R types 3 and Shift+R types R, so only the
+ * three-key chord is taken; Ctrl, Meta, Fn or the Sym meta state keep the key's own meaning, and
+ * software keyboards never trigger it. Android 16 has no system shortcut on Alt+Shift+R.
+ *
+ * <p>Pure: android.view.KeyEvent values are copied so that it can be tested off-device.
+ */
+public final class SableDisplayKeys {
+    /** {@code KeyEvent.KEYCODE_R}. */
+    public static final int KEYCODE_R = 46;
+    /** Sent to {@link #DISPLAY_COMPAT_PACKAGE}; its receiver is not exported (system UID only). */
+    public static final String ACTION_CYCLE_CANVAS =
+            "org.sableos.titan2.displaycompat.action.CYCLE_CANVAS";
+    public static final String DISPLAY_COMPAT_PACKAGE = "org.sableos.titan2.displaycompat";
+
+    // android.view.KeyEvent meta state bits.
+    private static final int META_SHIFT_MASK = 0x01 | 0x40 | 0x80;
+    private static final int META_ALT_MASK = 0x02 | 0x10 | 0x20;
+    private static final int META_SYM_ON = 0x04;
+    private static final int META_FUNCTION_ON = 0x08;
+    private static final int META_CTRL_MASK = 0x1000 | 0x2000 | 0x4000;
+    private static final int META_META_MASK = 0x10000 | 0x20000 | 0x40000;
+    private static final int OTHER_MODIFIERS =
+            META_SYM_ON | META_FUNCTION_ON | META_CTRL_MASK | META_META_MASK;
+
+    private SableDisplayKeys() {}
+
+    /**
+     * True when this key is the Alt+Shift+R chord from a physical keyboard. Lock states (Caps,
+     * Num, Scroll) are ignored, as in {@code KeyEvent.hasModifiers}.
+     */
+    public static boolean isCanvasCycleChord(int keyCode, int metaState, boolean virtualKey) {
+        return !virtualKey
+                && keyCode == KEYCODE_R
+                && (metaState & META_ALT_MASK) != 0
+                && (metaState & META_SHIFT_MASK) != 0
+                && (metaState & OTHER_MODIFIERS) == 0;
+    }
+}
