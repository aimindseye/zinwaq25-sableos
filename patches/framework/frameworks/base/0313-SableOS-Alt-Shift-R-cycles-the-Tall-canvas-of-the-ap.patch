From: SableOS <noreply@sableos.invalid>
Date: Fri, 23 Oct 2026 09:00:00 +0000
Subject: [PATCH] SableOS: Alt+Shift+R cycles the Tall canvas of the app in
 front

Sable Display Compat gives an app a taller, phone-shaped logical display
(Tall canvas: 720x772, 720x960, 720x1280 or 720x1440 on the Q25) while
it is in front. The resolution hotkey cycles the app in front through
the user's favourite sizes and back to native.

The Q25 keyboard has Alt, Shift, Sym and letters but no Ctrl or Fn, and
Alt+letter types digits and symbols, so the chord is Alt+Shift+R (Sym is
Right Alt, so Sym+Shift+R too). Android 16 has no system shortcut on it.

* PhoneWindowManager.interceptSystemKeysAndShortcuts takes the chord
  from a physical keyboard only, after setup and off the keyguard, and
  sends org.sableos.titan2.displaycompat.action.CYCLE_CANVAS to that
  package for the current user. Its receiver is not exported, so only
  the system UID can reach it; it applies the size, saves it for the app
  and shows a toast. Pure policy: policy/sable/SableDisplayKeys.java.
---
 .../server/policy/PhoneWindowManager.java     | 22 +++++++
 .../server/policy/sable/SableDisplayKeys.java | 60 +++++++++++++++++++
 2 files changed, 82 insertions(+)
 create mode 100644 services/core/java/com/android/server/policy/sable/SableDisplayKeys.java

diff --git a/services/core/java/com/android/server/policy/PhoneWindowManager.java b/services/core/java/com/android/server/policy/PhoneWindowManager.java
index e5b1da34..97010c1a 100644
--- a/services/core/java/com/android/server/policy/PhoneWindowManager.java
+++ b/services/core/java/com/android/server/policy/PhoneWindowManager.java
@@ -265,6 +265,7 @@ import com.android.server.pm.UserManagerInternal;
 import com.android.server.policy.keyguard.KeyguardServiceDelegate;
 import com.android.server.policy.keyguard.KeyguardServiceDelegate.DrawnListener;
 import com.android.server.policy.keyguard.KeyguardStateMonitor.StateCallback;
+import com.android.server.policy.sable.SableDisplayKeys;
 import com.android.server.policy.sable.SableShadeKeys;
 import com.android.server.statusbar.StatusBarManagerInternal;
 import com.android.server.vr.VrManagerInternal;
@@ -4007,6 +4008,19 @@ public class PhoneWindowManager implements WindowManagerPolicy {
                 }
                 return true;
             }
+            case KeyEvent.KEYCODE_R: {
+                // Sable: Alt+Shift+R (Sym+Shift+R) cycles the app in front through the user's
+                // favourite Tall canvas sizes in Sable Display Compat, which applies the size,
+                // saves it for that app and shows a toast. Not on the keyguard or before setup.
+                if (!SableDisplayKeys.isCanvasCycleChord(keyCode, event.getMetaState(), virtualKey)
+                        || keyguardOn || !isUserSetupComplete()) {
+                    break;
+                }
+                if (down && repeatCount == 0) {
+                    mHandler.post(this::sendSableCanvasCycle);
+                }
+                return true;
+            }
         }
         if (isValidGlobalKey(keyCode)
                 && mGlobalKeyManager.handleGlobalKey(mContext, keyCode, event)) {
@@ -4019,6 +4033,14 @@ public class PhoneWindowManager implements WindowManagerPolicy {
         return false;
     }
 
+    /** Sable resolution hotkey: Sable Display Compat cycles the app in front (see above). */
+    private void sendSableCanvasCycle() {
+        final Intent intent = new Intent(SableDisplayKeys.ACTION_CYCLE_CANVAS)
+                .setPackage(SableDisplayKeys.DISPLAY_COMPAT_PACKAGE)
+                .addFlags(Intent.FLAG_RECEIVER_FOREGROUND);
+        mContext.sendBroadcastAsUser(intent, UserHandle.CURRENT);
+    }
+
