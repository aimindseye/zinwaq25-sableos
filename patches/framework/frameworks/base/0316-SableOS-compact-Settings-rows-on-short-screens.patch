-        <item name="android:paddingVertical">@dimen/settingslib_expressive_space_small1</item>f
+        <item name="android:paddingVertical">@dimen/settingslib_expressive_preference_text_padding_vertical</item>
         <item name="android:paddingStart">@dimen/settingslib_expressive_space_none</item>
         <item name="android:paddingEnd">@dimen/settingslib_expressive_space_small1</item>
     </style>
@@ -181,7 +181,7 @@
         <item name="android:paddingStart">?android:attr/listPreferredItemPaddingStart</item>
         <item name="android:paddingRight">?android:attr/listPreferredItemPaddingRight</item>
         <item name="android:paddingEnd">?android:attr/listPreferredItemPaddingEnd</item>
-        <item name="android:paddingTop">@dimen/settingslib_expressive_space_small1</item>
+        <item name="android:paddingTop">@dimen/settingslib_expressive_category_padding_top</item>
         <item name="android:background">?android:attr/selectableItemBackground</item>
