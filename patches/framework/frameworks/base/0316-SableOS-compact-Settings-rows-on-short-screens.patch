+
+<resources>
+    <!-- SableOS: Android's own values on screens 600 dp tall or more (values-v36 has the compact
+         ones for short screens). -->
+    <dimen name="settingslib_preference_corner_radius">20dp</dimen>
+    <dimen name="settingslib_expressive_preference_min_height">72dp</dimen>
+    <dimen name="settingslib_expressive_preference_text_padding_vertical">@dimen/settingslib_expressive_space_small1</dimen>
+    <dimen name="settingslib_expressive_category_padding_top">@dimen/settingslib_expressive_space_small1</dimen>
+</resources>
diff --git a/packages/SettingsLib/SettingsTheme/res/values-h600dp-v36/styles_preference_expressive.xml b/packages/SettingsLib/SettingsTheme/res/values-h600dp-v36/styles_preference_expressive.xml
