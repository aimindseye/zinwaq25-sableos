+<resources>
+    <!-- SableOS: Android's own category title on screens 600 dp tall or more (values-v36 has the
+         small-capitals title for short screens). -->
+    <style
+        name="ExpressivePreferenceCategoryTitleStyle"
+        parent="@style/PreferenceCategoryTitleTextStyle">
+        <item name="android:layout_width">match_parent</item>
+        <item name="android:layout_height">wrap_content</item>
+        <item name="android:layout_gravity">start</item>
+        <item name="android:textAlignment">viewStart</item>
+    </style>
+</resources>
diff --git a/packages/SettingsLib/SettingsTheme/res/values-v36/dimens.xml b/packages/SettingsLib/SettingsTheme/res/values-v36/dimens.xml
index d783956..d2a859a 100644
--- a/packages/SettingsLib/SettingsTheme/res/values-v36/dimens.xml
+++ b/packages/SettingsLib/SettingsTheme/res/values-v36/dimens.xml
@@ -16,5 +16,12 @@
   -->
 
 <resources>
-    <dimen name="settingslib_preference_corner_radius">20dp</dimen>
+    <!-- SableOS: these values are for short screens (under 600 dp tall, such as the Zinwa Q25's
+         411 dp square screen), where 72 dp cards fit three rows. Compact rows, smaller corners
+         and tighter category gaps fit about twice as many. values-h600dp-v36 keeps Android's
+         own values for every taller screen. -->
+    <dimen name="settingslib_preference_corner_radius">8dp</dimen>
+    <dimen name="settingslib_expressive_preference_min_height">56dp</dimen>
+    <dimen name="settingslib_expressive_preference_text_padding_vertical">8dp</dimen>
+    <dimen name="settingslib_expressive_category_padding_top">8dp</dimen>
 </resources>
\ No newline at end of file
