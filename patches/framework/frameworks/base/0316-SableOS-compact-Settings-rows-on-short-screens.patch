     </style>
 
+    <!-- SableOS: on short screens category titles are small capitals with letter spacing, as
+         on BlackBerry 10, so a section reads as a label and takes one short line.
+         values-h600dp-v36 keeps Android's title on taller screens. -->
     <style
         name="ExpressivePreferenceCategoryTitleStyle"
         parent="@style/PreferenceCategoryTitleTextStyle">
@@ -203,6 +206,9 @@
