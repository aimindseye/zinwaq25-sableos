+package com.android.server.policy.sable;
+
+/**
+ * Privacy Screen from anywhere: Alt+Shift+P (either Alt; Sym is Right Alt on the Q25) switches
+ * Sable Text Reader's Privacy Screen on or off over whatever app is in front.
+ *
+ * <p>Shift is required: Alt+P types '@' on the Q25 keyboard, so the plain Alt chord stays typing.
+ * Ctrl, Meta, Sym-as-symbol or Fn keep P's own meaning, and software keyboards never trigger it.
+ * Text Reader's switch receiver answers {@link #RESULT_SWITCHED} when its service ran and switched;
+ * any other answer (service not turned on, app missing) means Accessibility should open instead.
+ *
+ * <p>Pure: android.view.KeyEvent and android.app.Activity values are copied so that it can be
+ * tested off-device.
+ */
+public final class SablePrivacyKeys {
+    /** {@code KeyEvent.KEYCODE_P}. */
+    public static final int KEYCODE_P = 44;
+    /** Text Reader's switch (PrivacyScreenSwitchReceiver.ACTION, sable-src 0175). */
+    public static final String ACTION_TOGGLE = "org.sableos.textreader.action.TOGGLE_PRIVACY_SCREEN";
+    /** Sable Text Reader, which runs the Privacy Screen service. */
+    public static final String TEXT_READER_PACKAGE = "org.sableos.textreader";
+    /** {@code Activity.RESULT_OK}: the service ran and switched. */
+    public static final int RESULT_SWITCHED = -1;
+    /** {@code Activity.RESULT_CANCELED}: the starting answer, kept when nothing switched. */
+    public static final int RESULT_NOT_RUNNING = 0;
+
+    // android.view.KeyEvent meta state bits.
+    private static final int META_SHIFT_ON = 0x01;
+    private static final int META_ALT_ON = 0x02;
+    private static final int META_SYM_ON = 0x04;
+    private static final int META_FUNCTION_ON = 0x08;
+    private static final int META_CTRL_MASK = 0x1000 | 0x2000 | 0x4000;
+    private static final int META_META_MASK = 0x10000 | 0x20000 | 0x40000;
+    private static final int OTHER_MODIFIERS =
+            META_SYM_ON | META_FUNCTION_ON | META_CTRL_MASK | META_META_MASK;
+
+    private SablePrivacyKeys() {}
+
+    /** Alt+Shift+P from a physical keyboard, with no other modifier (lock states aside). */
+    public static boolean isPrivacyChord(int keyCode, int metaState, boolean virtualKey) {
+        return keyCode == KEYCODE_P
+                && !virtualKey
+                && (metaState & META_ALT_ON) != 0
+                && (metaState & META_SHIFT_ON) != 0
+                && (metaState & OTHER_MODIFIERS) == 0;
+    }
+
+    /** True when Text Reader's answer says the Privacy Screen switched. */
+    public static boolean switched(int resultCode) {
+        return resultCode == RESULT_SWITCHED;
+    }
+}
