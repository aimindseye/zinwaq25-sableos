From: SableOS <noreply@sableos.invalid>
Date: Thu, 12 Nov 2026 12:00:00 +0000
Subject: [PATCH] SableOS: Alt+Shift+P switches the Privacy Screen from any app

The 2.0 plan gave the Privacy Screen a keyboard shortcut next to its
Quick Settings tile and My Sable switch. Alt+P types '@' on the Q25, so
the chord takes Shift as well:

* PhoneWindowManager.interceptSystemKeysAndShortcuts takes Alt+Shift+P
  (either Alt; Sym is Right Alt on the Q25) from a physical keyboard
  only, with no other modifier, after setup and off the keyguard, and
  sends Sable Text Reader's TOGGLE_PRIVACY_SCREEN as an ordered
  broadcast for the current user. Its release is consumed with it.
* Text Reader answers RESULT_OK when its service ran and switched. Any
  other answer (service not turned on yet, app missing) opens
  Accessibility, where the Privacy Screen is turned on the first time.
* The receiver asks its sender for org.sableos.permission.PRIVACY_SCREEN,
  which the system uid passes.
  Pure policy: policy/sable/SablePrivacyKeys.java.
---
 .../server/policy/PhoneWindowManager.java     | 39 +++++++++++
 .../server/policy/sable/SablePrivacyKeys.java | 68 +++++++++++++++++++
 2 files changed, 107 insertions(+)
 create mode 100644 services/core/java/com/android/server/policy/sable/SablePrivacyKeys.java

diff --git a/services/core/java/com/android/server/policy/PhoneWindowManager.java b/services/core/java/com/android/server/policy/PhoneWindowManager.java
index 86a53aa..dae9078 100644
--- a/services/core/java/com/android/server/policy/PhoneWindowManager.java
+++ b/services/core/java/com/android/server/policy/PhoneWindowManager.java
@@ -267,6 +267,7 @@ import com.android.server.policy.keyguard.KeyguardServiceDelegate;
 import com.android.server.statusbar.StatusBarManagerInternal;
 import com.android.server.policy.sable.SableCommandKeys;
 import com.android.server.policy.sable.SableDisplayKeys;
+import com.android.server.policy.sable.SablePrivacyKeys;
 import com.android.server.policy.sable.SableShadeKeys;
 import com.android.server.vr.VrManagerInternal;
 import com.android.server.wallpaper.WallpaperManagerInternal;
@@ -4124,6 +4125,19 @@ public class PhoneWindowManager implements WindowManagerPolicy {
                 }
                 return true;
             }
+            case KeyEvent.KEYCODE_P: {
+                // Sable: Alt+Shift+P switches the Privacy Screen (Sable Text Reader) on or off over
+                // any app. Alt+P alone types '@' on the Q25, so it is left alone. Not on the
+                // keyguard, where the Privacy Screen never shows, nor before setup.
+                if (!SablePrivacyKeys.isPrivacyChord(keyCode, event.getMetaState(), virtualKey)
+                        || keyguardOn || !isUserSetupComplete()) {
+                    break;
+                }
+                if (down && repeatCount == 0) {
+                    mHandler.post(this::toggleSablePrivacyScreen);
+                }
+                return true;
+            }
         }
         if (isValidGlobalKey(keyCode)
                 && mGlobalKeyManager.handleGlobalKey(mContext, keyCode, event)) {
@@ -4171,6 +4185,31 @@ public class PhoneWindowManager implements WindowManagerPolicy {
         startActivityAsUser(intent, UserHandle.CURRENT, displayId);
     }
 
+    /**
+     * Sable Privacy Screen switch (see above). Text Reader answers RESULT_OK when its service ran
+     * and switched; otherwise the service is not turned on yet, so Accessibility opens to turn it on.
+     */
+    private void toggleSablePrivacyScreen() {
+        final Intent intent = new Intent(SablePrivacyKeys.ACTION_TOGGLE)
+                .setPackage(SablePrivacyKeys.TEXT_READER_PACKAGE)
+                .addFlags(Intent.FLAG_RECEIVER_FOREGROUND);
+        final BroadcastReceiver answer = new BroadcastReceiver() {
+            @Override
+            public void onReceive(Context context, Intent result) {
+                if (!SablePrivacyKeys.switched(getResultCode())) {
+                    final Intent settings = new Intent(Settings.ACTION_ACCESSIBILITY_SETTINGS)
+                            .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+                    startActivityAsUser(settings, UserHandle.CURRENT);
+                }
+            }
+        };
+        // The receiver asks its sender for org.sableos.permission.PRIVACY_SCREEN, which the system
+        // uid passes; no permission is asked of the receiver.
+        mContext.sendOrderedBroadcastAsUser(intent, UserHandle.CURRENT,
+                null, answer, mHandler,
+                SablePrivacyKeys.RESULT_NOT_RUNNING, null, null);
+    }
+
