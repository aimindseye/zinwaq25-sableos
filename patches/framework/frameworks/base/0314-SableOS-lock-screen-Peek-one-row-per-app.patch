@@ -137,7 +142,77 @@ public final class SableLockGlance {
     }
 
     /**
-     * What the glance under the clock shows. {@code locked}: the keyguard is secure and not
+     * Peek (owner decision 2026-11-04, as BB10 and TenSeven): one row per app with Hub-countable
+     * notifications on the lock screen, most notifications first, then the newest. A row carries
+     * the newest sender only when the lock screen may show that notification's content (the
+     * user's "Show all content" and no redaction); otherwise it is counts only.
+     */
+    public static final class Peek {
+        /** At most this many app rows; the rest are "+N more apps". */
+        public static final int MAX_ROWS = 4;
+
+        /** One app row of the peek. */
+        public static final class Row {
+            public final String packageName;
+            public int count;
+            public long newestWhen;
+            /** The newest notification's sender or title, or null when content is hidden. */
+            public String sender;
+
+            Row(String packageName) {
+                this.packageName = packageName;
+            }
+        }
+
+        private final Map<String, Row> rows = new LinkedHashMap<>();
+
+        /**
+         * Adds one lock screen notification. {@code sender} is null unless its content may show;
+         * a bucket of {@link #BUCKET_NONE} is not part of the peek.
+         */
+        public void add(String packageName, int bucket, long when, String sender) {
+            if (bucket == BUCKET_NONE || packageName == null || packageName.isEmpty()) {
+                return;
+            }
+            Row row = rows.get(packageName);
+            if (row == null) {
+                row = new Row(packageName);
+                rows.put(packageName, row);
+            }
+            row.count++;
+            if (when >= row.newestWhen) {
+                row.newestWhen = when;
+                row.sender = sender == null || sender.trim().isEmpty() ? null : sender.trim();
+            }
+        }
+
+        /** The rows to show, most notifications first, then the newest; at most {@link #MAX_ROWS}. */
+        public List<Row> rows() {
+            List<Row> sorted = sortedRows();
+            return sorted.size() > MAX_ROWS ? sorted.subList(0, MAX_ROWS) : sorted;
+        }
+
+        /** How many apps did not fit ("+N more apps"). */
+        public int moreApps() {
+            return Math.max(0, rows.size() - MAX_ROWS);
+        }
+
+        public boolean isEmpty() {
+            return rows.isEmpty();
+        }
+
+        private List<Row> sortedRows() {
+            List<Row> sorted = new ArrayList<>(rows.values());
+            Collections.sort(sorted, (a, b) -> a.count != b.count
+                    ? Integer.compare(b.count, a.count)
+                    : Long.compare(b.newestWhen, a.newestWhen));
+            return sorted;
+        }
+    }
+
+    /**
+     * What the glance under the clock shows: {@code countRow} is the peek. {@code locked}: the
+     * keyguard is secure and not
      * unlocked (trust agent, biometrics). {@code privateMode}: the user is in public mode and
      * hides notification content on the lock screen. Nothing shows while dozing.
      */
@@ -150,7 +225,8 @@ public final class SableLockGlance {
         public Glance(boolean dozing, boolean locked, boolean privateMode, Counts counts) {
             lockedLabel = !dozing && locked;
             countRow = !dozing && !counts.isEmpty();
-            privateCard = !dozing && privateMode;
+            // The peek's own footer says what unlocking shows; the card covers an empty peek.
+            privateCard = !dozing && privateMode && counts.isEmpty();
             requiresUnlockLine = !dozing && privateMode && counts.total > 0;
         }
 
