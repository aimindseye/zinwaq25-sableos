From: SableOS <noreply@sableos.invalid>
Date: Thu, 5 Nov 2026 12:00:00 +0000
Subject: [PATCH] SableOS: Alt+Space opens Sable Command from any app

BB10 had no system-wide search key; on the Q25 Alt+Space already opens
Command on Sable Start, so it becomes the chord for Command anywhere:

* PhoneWindowManager.interceptSystemKeysAndShortcuts takes Alt+Space
  (either Alt; Sym is Right Alt on the Q25) from a physical keyboard
  only, with no other modifier, after setup and off the keyguard, and
  starts org.sableos.start.action.COMMAND in Sable Start for the
  current user on the key's display. Its release is consumed with it.
  Start opens Command over the app, and Back returns to that app.
* The keyguard keeps Alt+Space for its emergency shortcut (0307): the
  chord is not taken while the keyguard shows, so SystemUI gets it.
* On the Q25 Space has no Alt character, so nothing typed is lost.
  Pure policy: policy/sable/SableCommandKeys.java.
---
 .../server/policy/PhoneWindowManager.java     | 23 ++++++++
 .../server/policy/sable/SableCommandKeys.java | 57 +++++++++++++++++++
 2 files changed, 80 insertions(+)

diff --git a/services/core/java/com/android/server/policy/PhoneWindowManager.java b/services/core/java/com/android/server/policy/PhoneWindowManager.java
index 7b6ae07..47afb18 100644
--- a/services/core/java/com/android/server/policy/PhoneWindowManager.java
+++ b/services/core/java/com/android/server/policy/PhoneWindowManager.java
@@ -265,6 +265,7 @@ import com.android.server.inputmethod.InputMethodManagerInternal;
 import com.android.server.pm.UserManagerInternal;
 import com.android.server.policy.keyguard.KeyguardServiceDelegate;
 import com.android.server.statusbar.StatusBarManagerInternal;
+import com.android.server.policy.sable.SableCommandKeys;
 import com.android.server.policy.sable.SableDisplayKeys;
 import com.android.server.policy.sable.SableShadeKeys;
 import com.android.server.vr.VrManagerInternal;
@@ -4070,6 +4071,20 @@ public class PhoneWindowManager implements WindowManagerPolicy {
                 }
                 return true;
             }
+            case KeyEvent.KEYCODE_SPACE: {
+                // Sable: Alt+Space opens Sable Start's Command search over any app; Back there
+                // returns to the app. The keyguard keeps Alt+Space for its emergency shortcut
+                // (SystemUI), so the chord is not taken there, nor before setup.
+                if (!SableCommandKeys.isCommandChord(keyCode, event.getMetaState(), virtualKey)
+                        || keyguardOn || !isUserSetupComplete()) {
+                    break;
+                }
+                if (down && repeatCount == 0) {
+                    final int displayId = event.getDisplayId();
+                    mHandler.post(() -> openSableCommand(displayId));
+                }
+                return true;
+            }
         }
         if (isValidGlobalKey(keyCode)
                 && mGlobalKeyManager.handleGlobalKey(mContext, keyCode, event)) {
@@ -4090,6 +4105,14 @@ public class PhoneWindowManager implements WindowManagerPolicy {
         mContext.sendBroadcastAsUser(intent, UserHandle.CURRENT);
     }
 
+    /** Sable Command from anywhere (see above): Start's search, on the display the key came from. */
+    private void openSableCommand(int displayId) {
+        final Intent intent = new Intent(SableCommandKeys.ACTION_COMMAND)
+                .setPackage(SableCommandKeys.START_PACKAGE)
+                .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+        startActivityAsUser(intent, UserHandle.CURRENT, displayId);
+    }
+
     @SuppressLint("MissingPermission")
     private void initKeyGestures() {
         List<Integer> supportedGestures = new ArrayList<>(List.of(
