+package com.android.server.policy.sable;
+
+/**
+ * Sable Command from anywhere: Alt+Space (either Alt; Sym is Right Alt on the Q25) opens Sable
+ * Start's Command search over whatever app is in front.
+ *
+ * <p>Only Alt may be held: Shift, Ctrl, Meta, Sym-as-symbol or Fn keep Space's own meaning, and
+ * software keyboards never trigger it. On the Q25 Space has no Alt character, so the chord never
+ * types anything. The lock screen keeps Alt+Space for its emergency shortcut: PhoneWindowManager
+ * does not take the chord while the keyguard shows, so SystemUI's keyguard handles it there.
+ *
+ * <p>Pure: android.view.KeyEvent values are copied so that it can be tested off-device.
+ */
+public final class SableCommandKeys {
+    /** {@code KeyEvent.KEYCODE_SPACE}. */
+    public static final int KEYCODE_SPACE = 62;
+    /** Sable Start's Command search (SableStartActivity.ACTION_COMMAND). */
+    public static final String ACTION_COMMAND = "org.sableos.start.action.COMMAND";
+    /** Sable Start (the BB10 and BB7 home). */
+    public static final String START_PACKAGE = "org.sableos.launcher";
+
+    // android.view.KeyEvent meta state bits.
+    private static final int META_SHIFT_MASK = 0x01 | 0x40 | 0x80;
+    private static final int META_ALT_ON = 0x02;
+    private static final int META_SYM_ON = 0x04;
+    private static final int META_FUNCTION_ON = 0x08;
+    private static final int META_CTRL_MASK = 0x1000 | 0x2000 | 0x4000;
+    private static final int META_META_MASK = 0x10000 | 0x20000 | 0x40000;
+    private static final int OTHER_MODIFIERS =
+            META_SHIFT_MASK | META_SYM_ON | META_FUNCTION_ON | META_CTRL_MASK | META_META_MASK;
+
+    private SableCommandKeys() {}
+
+    /** Alt+Space from a physical keyboard, with no other modifier (lock states aside). */
+    public static boolean isCommandChord(int keyCode, int metaState, boolean virtualKey) {
+        return keyCode == KEYCODE_SPACE
+                && !virtualKey
+                && (metaState & META_ALT_ON) != 0
+                && (metaState & OTHER_MODIFIERS) == 0;
+    }
+}
