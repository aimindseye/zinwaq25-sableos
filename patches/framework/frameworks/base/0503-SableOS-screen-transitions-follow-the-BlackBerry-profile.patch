diff --git a/core/res/res/anim/sable_bb7_close_enter.xml b/core/res/res/anim/sable_bb7_close_enter.xml
new file mode 100644
index 0000000..d36cf36
--- /dev/null
+++ b/core/res/res/anim/sable_bb7_close_enter.xml
@@ -0,0 +1,26 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- SableOS BlackBerry 7: zoom out to the parent, from 110 percent, with a 150 ms fade. Chosen in TransitionAnimation.sableMotion() from Settings.Secure sable_profile. -->
+<set xmlns:android="http://schemas.android.com/apk/res/android"
+    android:shareInterpolator="false">
+    <scale
+        android:fromXScale="1.1"
+        android:toXScale="1.0"
+        android:fromYScale="1.1"
+        android:toYScale="1.0"
+        android:pivotX="50%"
+        android:pivotY="50%"
+        android:fillEnabled="true"
+        android:fillBefore="true"
+        android:fillAfter="true"
+        android:interpolator="@interpolator/linear_out_slow_in"
+        android:duration="200" />
+    <alpha
