+++ b/packages/SystemUI/multivalentTests/src/com/android/systemui/statusbar/notification/row/SableNotificationKeyRouterTest.kt
@@ -145,5 +145,43 @@ class SableNotificationKeyRouterTest : SysuiTestCase() {
         assertEquals(SableNotificationKey.Other, SableNotificationKeyRouter.keyFor(29))
     }
 
+    @Test
+    fun altEnterOpensTheRowMenuOnKeyboardsWithoutFn() {
+        val altHeld = focused.copy(hasModifiers = true, altOnly = true)
+        assertEquals(
+            SableNotificationCommand.RowMenu,
+            SableNotificationKeyRouter.route(SableNotificationKey.Enter, altHeld),
+        )
+        assertEquals(
+            SableNotificationCommand.Consume,
+            SableNotificationKeyRouter.route(SableNotificationKey.Enter, altHeld.copy(canOpenMenu = false)),
+        )
+        assertEquals(
+            SableNotificationCommand.Consume,
+            SableNotificationKeyRouter.route(SableNotificationKey.Enter, altHeld.copy(isRepeat = true)),
+        )
+    }
+
+    @Test
+    fun altEnterYieldsToTextInputAndNeedsAFocusedRow() {
+        val altHeld = focused.copy(hasModifiers = true, altOnly = true)
+        assertEquals(
+            SableNotificationCommand.PassThrough,
+            SableNotificationKeyRouter.route(SableNotificationKey.Enter, altHeld.copy(textInputFocused = true)),
+        )
+        assertEquals(
+            SableNotificationCommand.PassThrough,
+            SableNotificationKeyRouter.route(SableNotificationKey.Enter, altHeld.copy(rowFocused = false)),
+        )
+    }
+
+    @Test
+    fun altWithLettersIsStillNotACommand() {
+        val altHeld = focused.copy(hasModifiers = true, altOnly = true)
+        letters.forEach { key ->
+            assertEquals(SableNotificationCommand.PassThrough, SableNotificationKeyRouter.route(key, altHeld))
+        }
+    }
+
     private fun route(key: SableNotificationKey) = SableNotificationKeyRouter.route(key, focused)
 }
diff --git a/packages/SystemUI/src/com/android/systemui/keyevent/domain/interactor/SysUIKeyEventHandler.kt b/packages/SystemUI/src/com/android/systemui/keyevent/domain/interactor/SysUIKeyEventHandler.kt
index bc65ad476c37..25ae6a502408 100644
--- a/packages/SystemUI/src/com/android/systemui/keyevent/domain/interactor/SysUIKeyEventHandler.kt
+++ b/packages/SystemUI/src/com/android/systemui/keyevent/domain/interactor/SysUIKeyEventHandler.kt
@@ -56,6 +56,16 @@ constructor(
     }
 
     fun dispatchKeyEventPreIme(event: KeyEvent): Boolean {
+        // Sable: Alt+Up steps the open shade back one level (Quick Settings to notifications, then
+        // closed), exactly like Back. It is the design's Fn+Up on keyboards without Fn (Q25).
+        // Pre-IME, so focus navigation inside the shade never takes it first. The shade window
+        // only has focus while the shade or the keyguard shows, so apps keep Alt+Up.
+        if (event.keyCode == KeyEvent.KEYCODE_DPAD_UP && event.hasModifiers(KeyEvent.META_ALT_ON)) {
+            if (event.action == KeyEvent.ACTION_DOWN && event.repeatCount == 0) {
+                backActionInteractor.onBackRequested()
+            }
+            return true
+        }
         return keyguardKeyEventInteractor.dispatchKeyEventPreIme(event)
     }
 
