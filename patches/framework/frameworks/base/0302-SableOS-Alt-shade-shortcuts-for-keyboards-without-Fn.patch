+package com.android.server.policy.sable;
+
+/**
+ * Sable shade chord for keyboards without an Fn key (the Q25: Alt, Shift, Sym and letters).
+ *
+ * <p>The keyboard-first shade design asks for Fn+Down to open the shade and Fn+Down again to
+ * expand Quick Settings. On a keyboard without Fn the chord is Alt+Down (Down being the trackpad
+ * or a D-pad on the same keyboard). It becomes the platform's system navigation Down key, which
+ * SystemUI already turns into "open the shade, then expand Quick Settings". Only Alt may be held:
+ * Shift, Ctrl, Meta, Sym or Fn keep the key's own meaning, and software keyboards never trigger
+ * it. Up is not mapped here: Alt+Up acts only inside the open shade (SystemUI), so apps keep it.
+ *
+ * <p>Pure: android.view.KeyEvent values are copied so that it can be tested off-device.
+ */
+public final class SableShadeKeys {
+    /** {@code KeyEvent.KEYCODE_DPAD_DOWN}. */
+    public static final int KEYCODE_DPAD_DOWN = 20;
+    /** {@code KeyEvent.KEYCODE_SYSTEM_NAVIGATION_DOWN}. */
+    public static final int KEYCODE_SYSTEM_NAVIGATION_DOWN = 281;
+    /** Not the shade chord. */
+    public static final int NONE = 0;
+
+    // android.view.KeyEvent meta state bits.
+    private static final int META_SHIFT_MASK = 0x01 | 0x40 | 0x80;
+    private static final int META_ALT_MASK = 0x02 | 0x10 | 0x20;
+    private static final int META_SYM_ON = 0x04;
+    private static final int META_FUNCTION_ON = 0x08;
+    private static final int META_CTRL_MASK = 0x1000 | 0x2000 | 0x4000;
+    private static final int META_META_MASK = 0x10000 | 0x20000 | 0x40000;
+    private static final int OTHER_MODIFIERS =
+            META_SHIFT_MASK | META_SYM_ON | META_FUNCTION_ON | META_CTRL_MASK | META_META_MASK;
+
+    private SableShadeKeys() {}
+
+    /**
+     * Returns {@link #KEYCODE_SYSTEM_NAVIGATION_DOWN} when this key is the Alt+Down shade chord
+     * from a physical keyboard, else {@link #NONE}. Lock states (Caps, Num, Scroll and Alt lock)
+     * are ignored, as in {@code KeyEvent.hasModifiers}.
+     */
+    public static int systemKeyFor(int keyCode, int metaState, boolean virtualKey) {
+        if (virtualKey || keyCode != KEYCODE_DPAD_DOWN) {
+            return NONE;
+        }
+        if ((metaState & META_ALT_MASK) == 0 || (metaState & OTHER_MODIFIERS) != 0) {
+            return NONE;
+        }
+        return KEYCODE_SYSTEM_NAVIGATION_DOWN;
+    }
+}
