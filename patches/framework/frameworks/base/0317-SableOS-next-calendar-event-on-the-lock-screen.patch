     private val statusBarStateListener =
@@ -175,6 +201,66 @@ constructor(
         lockscreenUserManager.addNotificationStateChangedListener { refresh() }
         keyguardStateController.addCallback(keyguardStateCallback)
         statusBarStateController.addCallback(statusBarStateListener)
+        // Sable Calendar's snapshot, and Android's calendar for edits and syncs. Either may refuse
+        // an observer; the event is read again each time the lock screen shows anyway.
+        for (uri in arrayOf(CALENDAR_URI, ANDROID_CALENDAR_URI)) {
+            runCatching {
+                context.contentResolver.registerContentObserver(uri, true, calendarObserver, UserHandle.USER_ALL)
+            }
+        }
+        loadNextEvent()
+    }
+
+    /** Reads Sable Calendar's next event off the main thread, then redraws the glance. */
+    private fun loadNextEvent() {
+        val userId = lockscreenUserManager.currentUserId
+        bgExecutor.execute {
+            val event =
+                runCatching {
+                    context
+                        .createContextAsUser(UserHandle.of(userId), 0)
+                        .contentResolver
+                        .query(CALENDAR_NEXT_URI, null, null, null, null)
+                        ?.use { cursor ->
+                            if (!cursor.moveToFirst()) return@use null
+                            Triple(
+                                cursor.getString(cursor.getColumnIndexOrThrow("title")),
+                                cursor.getLong(cursor.getColumnIndexOrThrow("begin")),
+                                cursor.getInt(cursor.getColumnIndexOrThrow("all_day")) != 0,
+                            )
+                        }
+                }.getOrNull()
+            glanceView?.post {
+                nextEvent = event
+                refresh()
+            }
+        }
+    }
+
+    /** The next-event line, or null when there is none today or tomorrow. */
+    private fun eventLine(privateMode: Boolean): String? {
+        val (title, begin, allDay) = nextEvent ?: return null
+        val res = context.resources
+        val day = SableLockGlance.eventDay(begin, allDay, System.currentTimeMillis(), ZoneId.systemDefault())
+        val time = DateFormat.getTimeFormat(context).format(Date(begin))
+        val whenText =
+            when (day) {
+                SableLockGlance.EVENT_NOW -> res.getString(R.string.sable_keyguard_event_now)
+                0, 1 -> {
+                    val word =
+                        res.getString(
+                            if (day == 0) R.string.sable_keyguard_event_today else R.string.sable_keyguard_event_tomorrow
+                        )
+                    word + " " + if (allDay) res.getString(R.string.sable_keyguard_event_all_day) else time
+                }
+                else -> return null
+            }
+        return SableLockGlance.eventLine(
+            whenText,
+            title,
+            privateMode,
+            res.getString(R.string.sable_keyguard_event_hidden),
+        )
     }
 
     private fun refresh() {
