 package com.android.keyguard.sable;
 
+import java.time.Instant;
+import java.time.LocalDate;
+import java.time.ZoneId;
+import java.time.ZoneOffset;
+import java.time.temporal.ChronoUnit;
 import java.util.ArrayList;
 import java.util.Arrays;
 import java.util.Collections;
@@ -246,4 +251,36 @@ public final class SableLockGlance {
         }
         return Math.max(1, messageCount);
     }
+
+    /** {@link #eventDay}: the event has started and has not ended. */
+    public static final int EVENT_NOW = -2;
+    /** {@link #eventDay}: the event is after tomorrow, so the lock screen does not show it. */
+    public static final int EVENT_LATER = -1;
+
+    /**
+     * Next event under the clock (Sable Calendar's "next" snapshot): {@link #EVENT_NOW}, 0 for
+     * today, 1 for tomorrow, else {@link #EVENT_LATER}. All-day events are stored at UTC midnight.
+     */
+    public static int eventDay(long beginMillis, boolean allDay, long nowMillis, ZoneId zone) {
+        LocalDate today = Instant.ofEpochMilli(nowMillis).atZone(zone).toLocalDate();
+        LocalDate day =
+                Instant.ofEpochMilli(beginMillis).atZone(allDay ? ZoneOffset.UTC : zone).toLocalDate();
+        if (!allDay && beginMillis <= nowMillis) {
+            return EVENT_NOW;
+        }
+        if (allDay && !day.isAfter(today)) {
+            return 0;
+        }
+        long days = ChronoUnit.DAYS.between(today, day);
+        return days == 0 || days == 1 ? (int) days : EVENT_LATER;
+    }
+
+    /**
+     * "Today 9:30 · Standup". While the lock screen hides notification content the title is
+     * {@code hiddenTitle} ("Event"), so a locked phone never names a meeting the user hides.
+     */
+    public static String eventLine(String when, String title, boolean hideTitle, String hiddenTitle) {
+        boolean blank = title == null || title.trim().isEmpty();
+        return when + " · " + (hideTitle || blank ? hiddenTitle : title.trim());
+    }
 }
