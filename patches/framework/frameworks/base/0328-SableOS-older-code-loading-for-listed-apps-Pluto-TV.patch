From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SableOS <noreply@sableos.invalid>
Date: Thu, 12 Nov 2026 21:30:00 +0000
Subject: [PATCH] SableOS: older code loading for listed apps (Pluto TV)

Android 14's ENFORCE_READ_ONLY_JAVA_DCL (218865702) stops an app that
targets it from loading a dex or jar file it can still write. Pluto TV's
ad library (Google PAL) writes such a jar to its cache and loads it, so
Pluto crashes at start on SableOS 2.0 (owner report 2026-11-12). A user
build refuses "am compat disable" for a Play Store app.

CompatChange.isEnabled now treats that one change as off for the
packages listed in persist.sys.sable.legacy_dcl (comma-separated; "-" for
none). Until App Compatibility sets it, the list is tv.pluto.android. App
Compatibility can add or remove an app. Every other app keeps the
read-only rule.
---
 .../android/server/compat/CompatChange.java   | 10 ++++
 .../server/compat/sable/SableCodeLoading.java | 52 +++++++++++++++++++
 2 files changed, 62 insertions(+)
 create mode 100644 services/core/java/com/android/server/compat/sable/SableCodeLoading.java

diff --git a/services/core/java/com/android/server/compat/CompatChange.java b/services/core/java/com/android/server/compat/CompatChange.java
index 5c1db38..5ec7b68 100644
--- a/services/core/java/com/android/server/compat/CompatChange.java
+++ b/services/core/java/com/android/server/compat/CompatChange.java
@@ -27,11 +27,13 @@ import android.compat.annotation.Disabled;
 import android.compat.annotation.EnabledSince;
 import android.compat.annotation.Overridable;
 import android.content.pm.ApplicationInfo;
+import android.os.SystemProperties;
 
 import com.android.internal.compat.AndroidBuildClassifier;
 import com.android.internal.compat.CompatibilityChangeInfo;
 import com.android.internal.compat.OverrideAllowedState;
 import com.android.server.compat.config.Change;
+import com.android.server.compat.sable.SableCodeLoading;
 import com.android.server.compat.overrides.ChangeOverrides;
 import com.android.server.compat.overrides.OverrideValue;
 import com.android.server.compat.overrides.RawOverrideValue;
@@ -240,6 +242,14 @@ public final class CompatChange extends CompatibilityChangeInfo {
         if (app == null) {
             return defaultValue();
         }
+        // SableOS: an app on the Sable older-code-loading list (App Compatibility) may load code
+        // it wrote itself, as before Android 14; every other app keeps the read-only rule.
+        if (getId() == SableCodeLoading.CHANGE_ID
+                && SableCodeLoading.allows(
+                        SystemProperties.get(SableCodeLoading.PROPERTY, SableCodeLoading.DEFAULT_LIST),
+                        app.packageName)) {
+            return false;
+        }
         if (app.packageName != null) {
             final Boolean enabled = mEvaluatedOverrides.get(app.packageName);
             if (enabled != null) {
diff --git a/services/core/java/com/android/server/compat/sable/SableCodeLoading.java b/services/core/java/com/android/server/compat/sable/SableCodeLoading.java
new file mode 100644
index 0000000..50a4327
--- /dev/null
+++ b/services/core/java/com/android/server/compat/sable/SableCodeLoading.java
@@ -0,0 +1,52 @@
