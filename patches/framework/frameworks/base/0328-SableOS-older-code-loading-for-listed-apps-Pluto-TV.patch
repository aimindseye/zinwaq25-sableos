+package com.android.server.compat.sable;
+
+/**
+ * SableOS: the apps that may load code they wrote themselves, as before Android 14.
+ *
+ * <p>Android 14 stops apps that target it from loading a dex or jar file they can still write
+ * (ENFORCE_READ_ONLY_JAVA_DCL). Some Play Store apps' ad libraries still do it and crash on
+ * start, for example Pluto TV through Google's PAL. A user build cannot switch the rule off per
+ * app with adb, so App Compatibility keeps a short list in {@link #PROPERTY} (comma-separated
+ * package names) and CompatChange treats the rule as off for those apps only.
+ */
+public final class SableCodeLoading {
+    /** libcore's ENFORCE_READ_ONLY_JAVA_DCL. */
+    public static final long CHANGE_ID = 218865702L;
+
+    /** Comma-separated package names, set by App Compatibility ("-" for none). */
+    public static final String PROPERTY = "persist.sys.sable.legacy_dcl";
+
+    /** The list while App Compatibility has never set one. */
+    public static final String DEFAULT_LIST = "tv.pluto.android";
+
+    private SableCodeLoading() {}
+
+    /** True when {@code packageName} is one of the names in {@code list}. */
+    public static boolean allows(String list, String packageName) {
+        if (list == null || packageName == null || packageName.isEmpty()) {
+            return false;
+        }
+        for (String name : list.split(",")) {
+            if (name.trim().equals(packageName)) {
+                return true;
+            }
+        }
+        return false;
+    }
+}
