From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SableOS <noreply@sableos.invalid>
Date: Thu, 12 Nov 2026 19:40:00 +0000
Subject: [PATCH] SableOS: PIN pad leaves room for the navigation bar

The compact PIN pad (0315) sized its keys from the window's height minus
the status bar only. The window's height also counts the navigation bar
and any cutout, so on the Q25 the bottom row of keys (Delete, 0, OK) and
the emergency button could fall under the navigation bar, part hidden and
hard to press.

KeyguardPINView now subtracts the status bar, navigation bar and cutout
(WindowMetrics insets, ignoring visibility), and SableLockSize keeps 16 dp
for the security container's padding. Keys may shrink to 28 dp high
(still about 2.2 times as wide) so every row fits at every Lock screen size
and text size. No authentication code changes.
---
 .../com/android/keyguard/KeyguardPINView.java | 28 +++++++++++++++++--
 .../android/keyguard/sable/SableLockSize.java | 14 +++++++---
 2 files changed, 36 insertions(+), 6 deletions(-)

diff --git a/packages/SystemUI/src/com/android/keyguard/KeyguardPINView.java b/packages/SystemUI/src/com/android/keyguard/KeyguardPINView.java
index 2a8909d..efbe1db 100644
--- a/packages/SystemUI/src/com/android/keyguard/KeyguardPINView.java
+++ b/packages/SystemUI/src/com/android/keyguard/KeyguardPINView.java
@@ -30,12 +30,15 @@ import android.animation.ValueAnimator;
 import android.annotation.Nullable;
 import android.content.Context;
 import android.content.res.Configuration;
+import android.graphics.Insets;
 import android.os.UserHandle;
 import android.provider.Settings;
 import android.util.AttributeSet;
 import android.util.MathUtils;
 import android.view.View;
 import android.view.ViewGroup;
+import android.view.WindowInsets;
+import android.view.WindowManager;
 import android.view.animation.AnimationUtils;
 import android.view.animation.Interpolator;
 
@@ -210,8 +213,8 @@ public class KeyguardPINView extends KeyguardPinBasedInputView {
         int level = Settings.Secure.getIntForUser(mContext.getContentResolver(),
                 SableLockSize.SETTING, SableLockSize.DEFAULT_LEVEL, UserHandle.USER_CURRENT);
         SableLockSize.Pad pad = SableLockSize.compactPad(level, config.screenWidthDp,
-                config.screenHeightDp, Math.round(SystemBarUtils.getStatusBarHeight(mContext)
-                        / density), config.fontScale, fallback);
+                config.screenHeightDp, Math.round(sableSystemBarsPx() / density),
+                config.fontScale, fallback);
         if (pad == null) {
             return;
         }
@@ -284,6 +287,27 @@ public class KeyguardPINView extends KeyguardPinBasedInputView {
         }
     }
 
+    /**
+     * SableOS: the status bar, navigation bar and display cutout, which the bouncer does not draw
+     * over. The window's height in dp counts them, so the pad must leave room for all three, not
+     * only the status bar, or its bottom row falls under the navigation bar.
+     */
+    private int sableSystemBarsPx() {
+        int statusBar = SystemBarUtils.getStatusBarHeight(mContext);
+        try {
+            WindowManager windowManager = mContext.getSystemService(WindowManager.class);
+            if (windowManager != null) {
+                Insets bars = windowManager.getCurrentWindowMetrics().getWindowInsets()
+                        .getInsetsIgnoringVisibility(WindowInsets.Type.systemBars()
+                                | WindowInsets.Type.displayCutout());
+                return Math.max(statusBar, bars.top) + bars.bottom;
+            }
+        } catch (RuntimeException e) {
+            // The status bar alone, as before.
+        }
+        return statusBar;
+    }
+
     private static int px(int dp, float density) {
         return Math.round(dp * density);
     }
diff --git a/packages/SystemUI/src/com/android/keyguard/sable/SableLockSize.java b/packages/SystemUI/src/com/android/keyguard/sable/SableLockSize.java
index 9b20a8e..94b1596 100644
--- a/packages/SystemUI/src/com/android/keyguard/sable/SableLockSize.java
+++ b/packages/SystemUI/src/com/android/keyguard/sable/SableLockSize.java
@@ -41,7 +41,7 @@ public final class SableLockSize {
     public static final int COMPACT_BELOW_DP = 560;
 
     static final int KEY_DP = 44;
-    static final int MIN_KEY_DP = 32;
+    static final int MIN_KEY_DP = 28;
     static final int GAP_DP = 6;
     static final int ENTRY_DP = 40;
     static final int MIN_ENTRY_DP = 32;
@@ -55,6 +55,8 @@ public final class SableLockSize {
     static final int MESSAGE_LINE_DP = 20;
     static final int MESSAGE_PADDING_DP = 12;
     static final int FALLBACK_LINE_DP = 18;
+    /** The security container's own padding around the pad. */
+    static final int CONTAINER_DP = 16;
 
     private SableLockSize() {}
 
@@ -101,7 +103,8 @@ public final class SableLockSize {
      * @param level the Lock screen size level
      * @param widthDp the window width
      * @param heightDp the window height
-     * @param statusBarDp the status bar's height, which the bouncer does not draw over
+     * @param statusBarDp the status bar, navigation bar and cutout, which the bouncer does not
+     *     draw over
      * @param fontScale the text scale, which grows the message lines
      * @param fallbackLine whether the "Software keyboard fallback" line shows (hardware keyboard)
      */
@@ -127,12 +130,15 @@ public final class SableLockSize {
         return new Pad(keyWidth, keyHeight, GAP_DP, entry, digit, ECA_MARGIN_DP);
     }
 
-    /** The message lines, the emergency button and its margins, and the fallback line. */
+    /**
+     * The message lines, the emergency button and its margins, the fallback line and the
+     * container's padding.
+     */
     static int fixedHeight(float fontScale, boolean fallbackLine) {
         float text = Float.isNaN(fontScale) || fontScale <= 0f ? 1f : fontScale;
         int message = Math.round(2 * MESSAGE_LINE_DP * text) + MESSAGE_PADDING_DP;
         int eca = ECA_DP + 2 * ECA_MARGIN_DP;
         int fallback = fallbackLine ? Math.round(FALLBACK_LINE_DP * text) : 0;
-        return message + eca + FLOW_BOTTOM_DP + fallback;
+        return message + eca + FLOW_BOTTOM_DP + fallback + CONTAINER_DP;
     }
 }
