diff --git a/packages/SystemUI/res/values/sable_qs_config.xml b/packages/SystemUI/res/values/sable_qs_config.xml
new file mode 100644
index 0000000..6ff75bb
--- /dev/null
+++ b/packages/SystemUI/res/values/sable_qs_config.xml
@@ -0,0 +1,13 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+  ~ SableOS Quick Settings layout switches (sable-quick-settings-titan2). The defaults keep
+  ~ upstream behaviour; the SableSystemUIOverlay sets the Sable values.
+  -->
+<resources>
+    <!-- Tiles in the compact (QQS) row. 0 uses quick_settings_infinite_grid_num_columns.
+         Sable: 4 small tiles over a 3-column expanded grid. -->
+    <integer name="config_sableQuickQsNumColumns">0</integer>
+    <!-- Small (one-column) tiles show their label under the icon. Sable: true, so the
+         three-column grid of small tiles is labeled like the artifact. -->
+    <bool name="config_sableQsSmallTileLabels">false</bool>
+</resources>
diff --git a/packages/SystemUI/src/com/android/systemui/qs/panels/data/repository/QuickQuickSettingsRowRepository.kt b/packages/SystemUI/src/com/android/systemui/qs/panels/data/repository/QuickQuickSettingsRowRepository.kt
index 636f703..fe77360 100644
--- a/packages/SystemUI/src/com/android/systemui/qs/panels/data/repository/QuickQuickSettingsRowRepository.kt
+++ b/packages/SystemUI/src/com/android/systemui/qs/panels/data/repository/QuickQuickSettingsRowRepository.kt
@@ -36,4 +36,13 @@ constructor(
         configurationRepository.onConfigurationChange.emitOnStart().map {
             resources.getInteger(R.integer.quick_qs_paginated_grid_num_rows)
         }
+
+    /**
+     * Sable: tiles in the compact (QQS) row. 0 keeps the Quick Settings grid's column count; Sable
+     * sets 4 so the compact shade shows four small tiles over a three-column expanded grid.
+     */
+    val sableColumns =
+        configurationRepository.onConfigurationChange.emitOnStart().map {
+            resources.getInteger(R.integer.config_sableQuickQsNumColumns)
+        }
 }
diff --git a/packages/SystemUI/src/com/android/systemui/qs/panels/domain/interactor/QuickQuickSettingsRowInteractor.kt b/packages/SystemUI/src/com/android/systemui/qs/panels/domain/interactor/QuickQuickSettingsRowInteractor.kt
