+++ b/packages/SystemUI/src/com/android/systemui/qs/panels/ui/compose/infinitegrid/CommonTile.kt
@@ -85,6 +85,7 @@ import androidx.compose.ui.semantics.semantics
 import androidx.compose.ui.semantics.stateDescription
 import androidx.compose.ui.semantics.toggleableState
 import androidx.compose.ui.text.TextStyle
+import androidx.compose.ui.text.style.TextAlign
 import androidx.compose.ui.unit.Dp
 import androidx.compose.ui.unit.LayoutDirection
 import androidx.compose.ui.unit.dp
@@ -198,6 +199,41 @@ fun LargeTileContent(
     }
 }
 
+/**
+ * Sable (sable-quick-settings-titan2): a small tile of the three-column grid names itself under its
+ * icon, so every tile is labeled without the two-column large tiles. The icon is
+ * [CommonTileDefaults.SableLabeledIconSize] to leave one line of text inside [TileHeight]. The
+ * label is decoration: the tile's own semantics already carry its name and state.
+ */
+@Composable
+fun SableLabeledSmallTileContent(
+    label: String,
+    iconProvider: Context.() -> Icon,
+    colors: TileColors,
+    modifier: Modifier = Modifier,
+    isVisible: () -> Boolean = { true },
+) {
+    val animatedLabelColor by animateColorAsState(colors.label, label = "QSTileLabelColor")
+    Column(
+        verticalArrangement = Arrangement.spacedBy(2.dp, Alignment.CenterVertically),
+        horizontalAlignment = Alignment.CenterHorizontally,
+        modifier = modifier.fillMaxWidth().fillMaxHeight().padding(horizontal = 6.dp),
+    ) {
+        SmallTileContent(
+            iconProvider = iconProvider,
+            color = colors.icon,
+            size = { CommonTileDefaults.SableLabeledIconSize },
+        )
+        TileLabel(
+            text = label,
+            color = { animatedLabelColor },
+            style = MaterialTheme.typography.labelMedium.copy(textAlign = TextAlign.Center),
+            isVisible = isVisible,
+            modifier = Modifier.clearAndSetSemantics {},
+        )
+    }
+}
+
 @OptIn(ExperimentalMaterial3ExpressiveApi::class)
 @Composable
 fun LargeTileLabels(
@@ -414,6 +450,8 @@ object CommonTileDefaults {
         @Composable
         @ReadOnlyComposable
         get() = dimensionResource(id = R.dimen.common_tile_default_active_icon_corner_radius)
+    /** Sable: icon of a labeled small tile (icon over label). */
+    val SableLabeledIconSize = 24.dp
 
     val ActiveTileCornerRadius: Dp
         @Composable
