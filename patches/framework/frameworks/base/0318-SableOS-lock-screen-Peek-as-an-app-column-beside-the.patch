+    /** The newest notification beside the column: app and time, then its sender or the count. */
+    private fun bindNewest(container: View, newest: SableLockGlance.Peek.Row?) {
+        val app = container.findViewById<TextView>(R.id.sable_keyguard_peek_newest_app)
+        val line = container.findViewById<TextView>(R.id.sable_keyguard_peek_newest_line)
+        app.scaleText(textScale)
+        line.scaleText(textScale)
+        if (newest == null) {
+            app.text = null
+            line.text = null
+            return
+        }
+        val time =
+            if (newest.newestWhen > 0) DateFormat.getTimeFormat(context).format(Date(newest.newestWhen)) else null
+        val label = labelFor(newest.packageName)
+        app.text = if (time == null) label else "$label · $time"
+        line.text =
+            newest.sender
+                ?: context.resources.getQuantityString(
+                    R.plurals.sable_keyguard_peek_count,
+                    newest.count,
+                    newest.count,
+                )
+    }
+
     /** The app's icon, else the notification's small icon. */
     private fun iconFor(packageName: String, notification: Notification?): Drawable? =
         runCatching { context.packageManager.getApplicationIcon(packageName) }.getOrNull()
