diff --git a/packages/SystemUI/src/com/android/keyguard/sable/SableLockGlance.java b/packages/SystemUI/src/com/android/keyguard/sable/SableLockGlance.java
index e361d01..d40d5ae 100644
--- a/packages/SystemUI/src/com/android/keyguard/sable/SableLockGlance.java
+++ b/packages/SystemUI/src/com/android/keyguard/sable/SableLockGlance.java
@@ -191,10 +191,33 @@ public final class SableLockGlance {
             }
         }
 
-        /** The rows to show, most notifications first, then the newest; at most {@link #MAX_ROWS}. */
+        /**
+         * The rows to show, most notifications first, then the newest; at most {@link #MAX_ROWS},
+         * and always with the {@link #newest()} app, which takes the last place when it would not
+         * fit (the column beside the newest notification marks it).
+         */
         public List<Row> rows() {
             List<Row> sorted = sortedRows();
-            return sorted.size() > MAX_ROWS ? sorted.subList(0, MAX_ROWS) : sorted;
+            if (sorted.size() <= MAX_ROWS) {
+                return sorted;
+            }
+            List<Row> shown = new ArrayList<>(sorted.subList(0, MAX_ROWS));
+            Row newest = newest();
+            if (!shown.contains(newest)) {
+                shown.set(MAX_ROWS - 1, newest);
+            }
+            return shown;
+        }
+
+        /** The app with the newest notification (the latest when wins a tie), or null. */
+        public Row newest() {
+            Row newest = null;
+            for (Row row : rows.values()) {
+                if (newest == null || row.newestWhen >= newest.newestWhen) {
+                    newest = row;
+                }
+            }
+            return newest;
         }
 
         /** How many apps did not fit ("+N more apps"). */
