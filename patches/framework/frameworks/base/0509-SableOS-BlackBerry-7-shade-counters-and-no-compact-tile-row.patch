+package com.android.systemui.qs.composefragment.ui
+
+import android.provider.Settings
+import androidx.annotation.StringRes
+import androidx.compose.foundation.background
+import androidx.compose.foundation.layout.Arrangement
+import androidx.compose.foundation.layout.Row
+import androidx.compose.foundation.layout.fillMaxWidth
+import androidx.compose.foundation.layout.padding
+import androidx.compose.foundation.shape.RoundedCornerShape
+import androidx.compose.material3.MaterialTheme
+import androidx.compose.material3.Text
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.collectAsState
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.remember
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.draw.clip
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.platform.LocalContext
+import androidx.compose.ui.res.stringResource
+import androidx.compose.ui.unit.dp
+import com.android.systemui.res.R
+import com.android.systemui.shade.sable.SableShadeCounts
+
+/** Whether the BlackBerry 7 profile is chosen (Settings.Secure sable_profile is bb7). */
+@Composable
+fun rememberSableBb7(): Boolean {
+    val context = LocalContext.current
+    return remember { Settings.Secure.getString(context.contentResolver, "sable_profile") == "bb7" }
+}
+
+/**
+ * The BlackBerry 7 shade counters (Sable 2.0): one blue chip per kind of notification that is
+ * waiting (Messages, Email, Calls, Other) with its count, under the Manage Connections banner. The
+ * notifications themselves are the list below. Nothing shows on BBOS 10 or when nothing is waiting.
+ */
+@Composable
+fun SableBb7Counters(modifier: Modifier = Modifier) {
+    if (!rememberSableBb7()) return
+    val counts by SableShadeCounts.counts.collectAsState()
+    if (counts.total == 0) return
+    Row(
+        modifier = modifier.fillMaxWidth().padding(top = 6.dp),
+        horizontalArrangement = Arrangement.spacedBy(6.dp),
+    ) {
+        CountChip(R.string.sable_bb7_count_messages, counts.messages)
+        CountChip(R.string.sable_bb7_count_email, counts.email)
+        CountChip(R.string.sable_bb7_count_calls, counts.calls)
+        CountChip(R.string.sable_bb7_count_other, counts.other)
+    }
+}
+
+@Composable
+private fun CountChip(@StringRes label: Int, count: Int) {
+    if (count <= 0) return
+    Text(
+        text = stringResource(label, count),
+        style = MaterialTheme.typography.labelLarge,
+        color = Color.White,
+        modifier =
+            Modifier.clip(RoundedCornerShape(4.dp))
+                .background(Color(0xFF2E9BD6))
+                .padding(horizontal = 10.dp, vertical = 6.dp),
+    )
+}
