+package com.android.systemui.shade.sable
+
+import android.app.Notification
+import com.android.systemui.statusbar.notification.collection.GroupEntry
+import com.android.systemui.statusbar.notification.collection.NotificationEntry
+import com.android.systemui.statusbar.notification.collection.PipelineEntry
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+
+/**
+ * How many notifications of each kind the shade holds, for the BlackBerry 7 counters row (Sable 2.0).
+ * Fed by the notification pipeline (SableShadeCoordinator) on the main thread, read by the shade's
+ * Compose header. Counts only: it reads each notification's category and nothing of its content.
+ * Ongoing notifications (music, navigation, the foreground-service lines) are not counted.
+ */
+object SableShadeCounts {
+    /** The counts by kind. */
+    data class Counts(
+        val messages: Int = 0,
+        val email: Int = 0,
+        val calls: Int = 0,
+        val other: Int = 0,
+    ) {
+        val total: Int
+            get() = messages + email + calls + other
+    }
+
+    /** The kinds the counters row tells apart. */
+    enum class Kind {
+        MESSAGES,
+        EMAIL,
+        CALLS,
+        OTHER,
+    }
+
+    /** The kind of a notification, from its category. */
+    fun kindOf(category: String?): Kind =
+        when (category) {
+            Notification.CATEGORY_MESSAGE -> Kind.MESSAGES
+            Notification.CATEGORY_EMAIL -> Kind.EMAIL
+            Notification.CATEGORY_CALL -> Kind.CALLS
+            else -> Kind.OTHER
+        }
+
+    private val _counts = MutableStateFlow(Counts())
+
+    /** The current counts. */
+    val counts: StateFlow<Counts> = _counts.asStateFlow()
+
+    /** Recounts from the list about to be shown (after the final filters). */
+    fun update(entries: List<PipelineEntry>) {
+        var messages = 0
+        var email = 0
+        var calls = 0
+        var other = 0
+        fun add(entry: NotificationEntry) {
+            if (entry.sbn.isOngoing) return
+            when (kindOf(entry.sbn.notification.category)) {
+                Kind.MESSAGES -> messages++
+                Kind.EMAIL -> email++
+                Kind.CALLS -> calls++
+                Kind.OTHER -> other++
+            }
+        }
+        for (entry in entries) {
+            when (entry) {
+                is NotificationEntry -> add(entry)
+                is GroupEntry -> {
+                    val children = entry.children
+                    if (children.isEmpty()) {
+                        entry.summary?.let { add(it) }
+                    } else {
+                        children.forEach { add(it) }
+                    }
+                }
+                else -> {}
+            }
+        }
+        _counts.value = Counts(messages, email, calls, other)
+    }
+}
