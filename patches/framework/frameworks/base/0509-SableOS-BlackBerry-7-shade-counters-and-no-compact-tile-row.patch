index 3adbb16..e3a1d62 100644
--- a/packages/SystemUI/res/values/sable_bb7_strings.xml
+++ b/packages/SystemUI/res/values/sable_bb7_strings.xml
@@ -17,4 +17,9 @@
 <resources>
     <!-- SableOS: the BlackBerry 7 shade banner (Sable 2.0). -->
     <string name="sable_bb7_manage_connections">Manage Connections</string>
+    <!-- The BlackBerry 7 shade counters: one chip per kind of notification, with its count. -->
+    <string name="sable_bb7_count_messages">Messages %1$d</string>
+    <string name="sable_bb7_count_email">Email %1$d</string>
+    <string name="sable_bb7_count_calls">Calls %1$d</string>
+    <string name="sable_bb7_count_other">Other %1$d</string>
 </resources>
