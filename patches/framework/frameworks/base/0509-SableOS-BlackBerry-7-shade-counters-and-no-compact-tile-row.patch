--- a/packages/SystemUI/src/com/android/systemui/statusbar/notification/collection/coordinator/SableShadeCoordinator.kt
+++ b/packages/SystemUI/src/com/android/systemui/statusbar/notification/collection/coordinator/SableShadeCoordinator.kt
@@ -67,6 +67,7 @@
             // While a search filters the list, keep the unfiltered count.
             if (sableShadeState.query.value.isBlank()) {
                 sableShadeState.setPriorityCount(countPriority(entries))
+                com.android.systemui.shade.sable.SableShadeCounts.update(entries)
             }
         }
