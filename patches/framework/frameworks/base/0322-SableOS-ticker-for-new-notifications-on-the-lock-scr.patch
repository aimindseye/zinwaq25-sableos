                 if (visibilityProvider.shouldHideNotification(entry)) continue
@@ -311,6 +339,16 @@ constructor(
         textScale = scale
         for (id in SCALED_TEXT) view.findViewById<TextView>(id)?.scaleText(scale)
 
+        val tickerLine =
+            if (statusBarStateController.isDozing || !keyguardStateController.isShowing) null else ticker
