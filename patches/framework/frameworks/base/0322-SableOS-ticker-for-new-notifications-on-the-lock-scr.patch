         view.findViewById<TextView>(R.id.sable_keyguard_next_event).apply {
@@ -335,7 +373,66 @@ constructor(
                 )
             }
         }
-        view.visibleIf(glance.any() || event != null)
+        view.visibleIf(glance.any() || event != null || tickerLine != null)
+    }
+
+    /** The user is in public mode and the lock screen hides notification content. */
+    private fun privateMode(userId: Int): Boolean =
+        lockscreenUserManager.isLockscreenPublicMode(userId) &&
+            lockscreenUserManager.shouldShowLockscreenNotifications() &&
+            !lockscreenUserManager.userAllowsPrivateNotificationsInPublic(userId)
+
+    /**
+     * Starts the ticker for [entry] when it is a new alert the lock screen shows, while the lock
+     * screen is up and the screen is on. Content only as far as the lock screen would show it.
+     */
+    private fun tick(entry: NotificationEntry) {
+        val sbn = entry.sbn
+        val notification = sbn.notification
+        val previous = tickerSeen.put(entry.key, sbn.postTime) ?: 0L
+        if (!keyguardStateController.isShowing || statusBarStateController.isDozing) return
+        if (visibilityProvider.shouldHideNotification(entry)) return
+        val alerting = entry.importance >= NotificationManager.IMPORTANCE_DEFAULT && !entry.isAmbient
+        val worthy =
+            SableLockGlance.tickerWorthy(
+                alerting,
+                sbn.isOngoing,
+                notification.isGroupSummary,
+                (notification.flags and Notification.FLAG_ONLY_ALERT_ONCE) != 0,
+                sbn.postTime,
+                previous,
+            )
+        if (!worthy) return
+        val showContent =
+            !privateMode(lockscreenUserManager.currentUserId) &&
+                lockscreenUserManager.getRedactionType(entry) ==
+                    NotificationLockscreenUserManager.REDACTION_TYPE_NONE
+        val extras = notification.extras
+        val title =
+            extras?.getCharSequence(Notification.EXTRA_CONVERSATION_TITLE)
+                ?: extras?.getCharSequence(Notification.EXTRA_TITLE)
+        val text =
+            extras?.getCharSequence(Notification.EXTRA_TEXT)
+                ?: extras?.getCharSequence(Notification.EXTRA_BIG_TEXT)
+        ticker =
+            SableLockGlance.tickerLine(
+                labelFor(sbn.packageName).toString(),
+                title?.toString(),
+                text?.toString(),
+                showContent,
+                context.getString(R.string.sable_keyguard_ticker_hidden),
+            )
+        tickerKey = entry.key
+        glanceView?.let {
+            it.removeCallbacks(hideTicker)
+            it.postDelayed(hideTicker, SableLockGlance.TICKER_SHOW_MILLIS)
+        }
+    }
+
+    private fun clearTicker() {
+        glanceView?.removeCallbacks(hideTicker)
+        ticker = null
+        tickerKey = null
     }
 
     /**
@@ -476,6 +573,7 @@ constructor(
