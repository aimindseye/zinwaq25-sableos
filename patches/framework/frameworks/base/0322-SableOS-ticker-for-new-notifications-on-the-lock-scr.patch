 public final class SableLockGlance {
     /** Not counted. */
@@ -306,4 +307,64 @@ public final class SableLockGlance {
         boolean blank = title == null || title.trim().isEmpty();
         return when + " · " + (hideTitle || blank ? hiddenTitle : title.trim());
     }
+
+    /** How long the ticker line shows for a new notification. */
+    public static final long TICKER_SHOW_MILLIS = 10_000L;
+    /** The longest ticker line; the marquee scrolls what does not fit the width. */
+    public static final int TICKER_MAX_CHARS = 160;
+
+    /**
+     * Whether a notification that just arrived gets the ticker: it alerts (not silent or
+     * ambient), is not ongoing and is not a group summary, and it is new or an update that alerts
+     * again with a newer time (not "only alert once"). {@code previousWhen} is the time the ticker
+     * last saw for this notification, or 0 for a new one.
+     */
+    public static boolean tickerWorthy(boolean alerting, boolean ongoing, boolean groupSummary,
+            boolean onlyAlertOnce, long when, long previousWhen) {
+        if (!alerting || ongoing || groupSummary) {
+            return false;
+        }
+        if (previousWhen == 0) {
+            return true;
+        }
+        return !onlyAlertOnce && when > previousWhen;
+    }
+
+    /**
+     * The ticker line, one line: "WhatsApp: Maya · See you at 6". While the lock screen hides
+     * this notification's content it is "WhatsApp: {@code hiddenText}" ("New notification"), so
+     * it never shows more than the lock screen would. Line breaks and runs of spaces collapse, and
+     * the line stops at {@link #TICKER_MAX_CHARS}.
+     */
+    public static String tickerLine(String app, String title, String text, boolean showContent,
+            String hiddenText) {
+        String body;
+        if (!showContent) {
+            body = hiddenText;
+        } else {
+            String t = oneLine(title);
+            String x = oneLine(text);
+            if (t.isEmpty() && x.isEmpty()) {
+                body = hiddenText;
+            } else if (t.isEmpty() || x.isEmpty() || t.equals(x)) {
+                body = t.isEmpty() ? x : t;
+            } else {
+                body = t + " · " + x;
+            }
+        }
+        String a = oneLine(app);
+        String line = a.isEmpty() ? body : a + ": " + body;
+        if (line.length() > TICKER_MAX_CHARS) {
+            int end = TICKER_MAX_CHARS - 1;
+            if (Character.isHighSurrogate(line.charAt(end - 1))) {
+                end--;
+            }
+            line = line.substring(0, end).trim() + "…";
+        }
+        return line;
+    }
+
+    private static String oneLine(String s) {
+        return s == null ? "" : s.replaceAll("\\s+", " ").trim();
+    }
 }
