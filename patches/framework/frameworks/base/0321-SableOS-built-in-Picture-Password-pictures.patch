+package com.android.keyguard.sable;
+
+import android.graphics.Bitmap;
+import android.graphics.Canvas;
+import android.graphics.LinearGradient;
+import android.graphics.Paint;
+import android.graphics.Path;
+import android.graphics.Shader;
+
+import java.util.Random;
+
+/**
+ * Built-in Picture Password pictures, for a phone without photos of its own. Drawn in code, so
+ * they add nothing to the image and carry no licence: each has a fixed seed, so it looks the same
+ * on every boot, and enough distinct shapes and colours that a spot is easy to remember.
+ */
+public final class SableBuiltInPictures {
+    public static final int COUNT = 4;
+    private static final int SIDE = 720;
+    private static final int[][] PALETTES = {
+        {0xFF0B1E3A, 0xFF1D4E89, 0xFFF2A541, 0xFFE4572E, 0xFF76B041},
+        {0xFF102A24, 0xFF1F6F5C, 0xFFF4D35E, 0xFFEE964B, 0xFFF95738},
+        {0xFF2B1B3D, 0xFF5C3C92, 0xFF4ECDC4, 0xFFFFE66D, 0xFFFF6B6B},
+        {0xFF1A1A1A, 0xFF3A3A3A, 0xFF2E9BFF, 0xFFFFC857, 0xFFE9724C},
+    };
+
+    private SableBuiltInPictures() {}
+
+    /** Picture {@code index} (0 to {@link #COUNT} - 1). */
+    public static Bitmap draw(int index) {
+        final int i = Math.floorMod(index, COUNT);
+        final int[] colours = PALETTES[i];
+        final Bitmap bitmap = Bitmap.createBitmap(SIDE, SIDE, Bitmap.Config.ARGB_8888);
+        final Canvas canvas = new Canvas(bitmap);
+        final Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG);
+        paint.setShader(new LinearGradient(0, 0, 0, SIDE, colours[0], colours[1], Shader.TileMode.CLAMP));
+        canvas.drawRect(0, 0, SIDE, SIDE, paint);
+        paint.setShader(null);
+        final Random random = new Random(0x5AB1E000L + i);
+        // Large shapes first, then smaller ones on top, each in its own place and colour.
+        for (int n = 0; n < 28; n++) {
+            final float size = SIDE * (n < 8 ? 0.18f : 0.07f) * (0.6f + random.nextFloat());
+            final float x = random.nextFloat() * SIDE;
+            final float y = random.nextFloat() * SIDE;
+            paint.setColor(colours[2 + random.nextInt(3)]);
+            paint.setAlpha(n < 8 ? 200 : 255);
+            switch (random.nextInt(3)) {
+                case 0:
+                    canvas.drawCircle(x, y, size / 2f, paint);
+                    break;
+                case 1:
+                    canvas.drawRect(x - size / 2f, y - size / 2f, x + size / 2f, y + size / 2f, paint);
+                    break;
+                default:
+                    final Path triangle = new Path();
+                    triangle.moveTo(x, y - size / 2f);
+                    triangle.lineTo(x + size / 2f, y + size / 2f);
+                    triangle.lineTo(x - size / 2f, y + size / 2f);
+                    triangle.close();
+                    canvas.drawPath(triangle, paint);
+                    break;
+            }
+        }
+        return bitmap;
+    }
+}
