+/**
+ * The "/" notification search line: what is typed, or the kept filter. Live region, so TalkBack
+ * reads the query as it changes.
+ */
+@Composable
+fun SableShadeSearchLine(query: String, typing: Boolean, modifier: Modifier = Modifier) {
+    if (!typing && query.isEmpty()) return
+    val text =
+        when {
+            typing && query.isEmpty() -> stringResource(R.string.sable_shade_search_empty)
+            typing -> stringResource(R.string.sable_shade_search_typing, query)
+            else -> stringResource(R.string.sable_shade_search_kept, query)
+        }
+    Text(
+        text = text,
+        style = MaterialTheme.typography.labelMedium,
+        color = MaterialTheme.colorScheme.onSurface,
+        maxLines = 1,
+        overflow = TextOverflow.Ellipsis,
+        modifier =
+            modifier
+                .fillMaxWidth()
+                .padding(top = 8.dp)
+                .clip(RoundedCornerShape(SableCardRadius))
+                .background(MaterialTheme.colorScheme.surfaceContainerHighest)
+                .padding(horizontal = 12.dp, vertical = 6.dp)
+                .semantics { liveRegion = LiveRegionMode.Polite },
+    )
+}
