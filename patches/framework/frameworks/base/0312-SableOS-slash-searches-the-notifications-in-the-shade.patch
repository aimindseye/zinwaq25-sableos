+package com.android.systemui.shade.sable
+
+import android.view.InputDevice
+import android.view.KeyCharacterMap
+import android.view.KeyEvent
+import com.android.systemui.dagger.SysUISingleton
+import com.android.systemui.plugins.statusbar.StatusBarStateController
+import com.android.systemui.statusbar.StatusBarState
+import javax.inject.Inject
+
+/**
+ * "/" notification search keys for the shade window ([SableShadeSearch]). Runs pre-IME on the
+ * shade window, before the focused notification row, so letters typed into the query never
+ * reach the row's single-key commands (frameworks/base 0301). Never on the keyguard or a locked
+ * shade, never while a text field (inline reply) has focus, never from a software keyboard.
+ */
+@SysUISingleton
+class SableShadeSearchKeys
+@Inject
+constructor(
+    private val state: SableShadeState,
+    private val statusBarStateController: StatusBarStateController,
+) {
+    /** Key codes whose down was used, so their up is swallowed too. */
+    private val usedDowns = mutableSetOf<Int>()
+
+    /** Returns true when the key was used. */
+    fun dispatchKeyEventPreIme(event: KeyEvent, textInputFocused: Boolean): Boolean {
+        if (event.action == KeyEvent.ACTION_UP) {
+            return usedDowns.remove(event.keyCode)
+        }
+        if (event.action != KeyEvent.ACTION_DOWN) return false
+        val eligible =
+            state.searchEligible &&
+                !textInputFocused &&
+                statusBarStateController.state == StatusBarState.SHADE &&
+                event.deviceId != KeyCharacterMap.VIRTUAL_KEYBOARD &&
+                event.isFromSource(InputDevice.SOURCE_KEYBOARD)
+        // Closing or locking the shade clears the search (SableShadeState.onShadeChanged).
+        if (!eligible) return false
+        val unicodeChar = event.getUnicodeChar(event.metaState)
+        val query = state.query.value
+        val used =
+            when (
+                SableShadeSearch.decide(
+                    event.keyCode,
+                    event.repeatCount,
+                    unicodeChar,
+                    event.metaState,
+                    state.typing.value,
+                    query.isNotEmpty(),
+                )
+            ) {
+                SableShadeSearch.START -> {
+                    state.startTyping()
+                    true
+                }
+                SableShadeSearch.APPEND -> {
+                    state.setQuery(SableShadeSearch.append(query, unicodeChar))
+                    true
+                }
+                SableShadeSearch.DELETE -> {
+                    // An empty query keeps typing, so a held Backspace never reaches a row.
+                    state.setQuery(SableShadeSearch.deleteLast(query))
+                    true
+                }
+                SableShadeSearch.CLEAR -> {
+                    state.clear()
+                    true
+                }
+                SableShadeSearch.COMMIT -> {
+                    if (query.isEmpty()) state.clear() else state.commit()
+                    true
+                }
+                SableShadeSearch.COMMIT_PASS -> {
+                    if (query.isEmpty()) state.clear() else state.commit()
+                    false
+                }
+                SableShadeSearch.CONSUME -> true
+                else -> false
+            }
+        if (used) usedDowns += event.keyCode
+        return used
+    }
+}
