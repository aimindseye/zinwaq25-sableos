+package com.android.systemui.shade.sable;
+
+import java.text.Normalizer;
+import java.util.Locale;
+
+/**
+ * Pure policy for "/" notification search in the shade (sable-quick-settings-titan2,
+ * QUICK_SETTINGS_NOTIFICATION_SHADE_UX "/ search notifications").
+ *
+ * <p>"/" (however the keyboard makes it; on the Q25 it is an Alt or Sym key) starts typing a
+ * query; printable keys extend it, Backspace shortens it, Enter keeps the filter and gives the
+ * keys back to the notification rows, Down or Tab do the same and move focus, Esc or Back clear
+ * it. With a kept filter "/" edits it again and Esc or Back clear it. Ctrl and Meta chords are
+ * never taken. The caller decides eligibility: unlocked shade open on notifications, no text
+ * field focused, a physical key.
+ *
+ * <p>Key codes and meta flags are the android.view.KeyEvent values, copied so this class has
+ * no Android dependency.
+ */
+public final class SableShadeSearch {
+    /** Not a search key: let the shade handle it. */
+    public static final int NONE = 0;
+    /** Start (or resume) typing the query. */
+    public static final int START = 1;
+    /** Append the key's character. */
+    public static final int APPEND = 2;
+    /** Delete the last character (clears when the query becomes empty). */
+    public static final int DELETE = 3;
+    /** Clear the query and stop typing. */
+    public static final int CLEAR = 4;
+    /** Stop typing, keep the filter; the key is used. */
+    public static final int COMMIT = 5;
+    /** Stop typing, keep the filter; the key also goes on (focus moves). */
+    public static final int COMMIT_PASS = 6;
+    /** Swallow the key (repeats while typing). */
+    public static final int CONSUME = 7;
+
+    /** Longest query kept. */
+    public static final int MAX_QUERY_LENGTH = 40;
+
+    static final int KEYCODE_BACK = 4;
+    static final int KEYCODE_DPAD_DOWN = 20;
+    static final int KEYCODE_DPAD_CENTER = 23;
+    static final int KEYCODE_TAB = 61;
+    static final int KEYCODE_ENTER = 66;
+    static final int KEYCODE_DEL = 67;
+    static final int KEYCODE_SLASH = 76;
+    static final int KEYCODE_SEARCH = 84;
+    static final int KEYCODE_ESCAPE = 111;
+    static final int KEYCODE_NUMPAD_ENTER = 160;
+    static final int KEYCODE_NUMPAD_DIVIDE = 154;
+    static final int META_CTRL_ON = 0x1000;
+    static final int META_META_ON = 0x10000;
+
+    private SableShadeSearch() {}
+
+    /**
+     * What a key-down does.
+     *
+     * @param unicodeChar the character the key makes with its meta state, 0 when none
+     * @param typing whether the query is being typed
+     * @param filterActive whether a non-empty query filters the shade
+     */
+    public static int decide(int keyCode, int repeatCount, int unicodeChar, int metaState,
+            boolean typing, boolean filterActive) {
+        if ((metaState & (META_CTRL_ON | META_META_ON)) != 0) return NONE;
+        if (!typing) {
+            if (repeatCount == 0 && isSlash(keyCode, unicodeChar)) return START;
+            if (filterActive && (keyCode == KEYCODE_ESCAPE || keyCode == KEYCODE_BACK)) {
+                return repeatCount == 0 ? CLEAR : CONSUME;
+            }
+            return NONE;
+        }
+        switch (keyCode) {
+            case KEYCODE_ESCAPE:
+            case KEYCODE_BACK:
+                return repeatCount == 0 ? CLEAR : CONSUME;
+            case KEYCODE_DEL:
+                return DELETE;
+            case KEYCODE_ENTER:
+            case KEYCODE_NUMPAD_ENTER:
+            case KEYCODE_DPAD_CENTER:
+                return repeatCount == 0 ? COMMIT : CONSUME;
+            case KEYCODE_DPAD_DOWN:
+            case KEYCODE_TAB:
+                return COMMIT_PASS;
+            default:
+                break;
+        }
+        if (isPrintable(unicodeChar)) return repeatCount == 0 ? APPEND : CONSUME;
+        return NONE;
+    }
+
+    /** "/" by character or by key. */
+    static boolean isSlash(int keyCode, int unicodeChar) {
+        if (unicodeChar == '/') return true;
+        if (unicodeChar != 0) return false;
+        return keyCode == KEYCODE_SLASH || keyCode == KEYCODE_SEARCH
+                || keyCode == KEYCODE_NUMPAD_DIVIDE;
+    }
+
+    static boolean isPrintable(int unicodeChar) {
+        return unicodeChar >= 0x20 && unicodeChar != 0x7f && !Character.isISOControl(unicodeChar)
+                && (unicodeChar & 0x80000000) == 0; // not a dead-key accent
+    }
+
+    /** The query with one more character; no leading space, at most {@link #MAX_QUERY_LENGTH}. */
+    public static String append(String query, int unicodeChar) {
+        String q = query == null ? "" : query;
+        if (!isPrintable(unicodeChar)) return q;
+        if (q.isEmpty() && Character.isWhitespace(unicodeChar)) return q;
+        String next = q + new String(Character.toChars(unicodeChar));
+        return next.length() > MAX_QUERY_LENGTH ? q : next;
+    }
+
+    /** The query without its last character (a whole surrogate pair). */
+    public static String deleteLast(String query) {
+        if (query == null || query.isEmpty()) return "";
+        int end = query.offsetByCodePoints(query.length(), -1);
+        return query.substring(0, end);
+    }
+
+    /** Case- and accent-insensitive form used for matching. */
+    public static String fold(CharSequence text) {
+        if (text == null) return "";
+        String decomposed = Normalizer.normalize(text, Normalizer.Form.NFD);
+        return decomposed.replaceAll("\\p{M}+", "").toLowerCase(Locale.ROOT);
+    }
+
+    /**
+     * Whether every word of the query is found in at least one field (case and accents
+     * ignored). An empty or blank query matches everything.
+     */
+    public static boolean matches(String query, CharSequence... fields) {
+        String[] words = fold(query).trim().split("\\s+");
+        if (words.length == 0 || (words.length == 1 && words[0].isEmpty())) return true;
+        StringBuilder all = new StringBuilder();
+        if (fields != null) {
+            for (CharSequence field : fields) {
+                if (field != null) all.append(fold(field)).append('\n');
+            }
+        }
+        String haystack = all.toString();
+        for (String word : words) {
+            if (!word.isEmpty() && !haystack.contains(word)) return false;
+        }
+        return true;
+    }
+}
