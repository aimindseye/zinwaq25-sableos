+package com.android.systemui.qs.composefragment.ui
+
+import android.provider.Settings
+import androidx.compose.foundation.background
+import androidx.compose.foundation.clickable
+import androidx.compose.foundation.layout.fillMaxWidth
+import androidx.compose.foundation.layout.padding
+import androidx.compose.foundation.shape.RoundedCornerShape
+import androidx.compose.material3.MaterialTheme
+import androidx.compose.material3.Text
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.remember
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.draw.clip
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.platform.LocalContext
+import androidx.compose.ui.res.stringResource
+import androidx.compose.ui.semantics.Role
+import androidx.compose.ui.unit.dp
+import com.android.systemui.res.R
+
+/** The Sable blue of the BlackBerry 7 banner. */
+private val BannerBlue = Color(0xFF2E9BD6)
+
+/**
+ * The BlackBerry 7 shade banner (Sable 2.0): a blue bar whose tap opens Manage Connections. It
+ * shows only on the BBOS 7 profile (Settings.Secure sable_profile is bb7), read when the shade is
+ * composed; BBOS 10 keeps its tiles alone.
+ */
+@Composable
+fun SableBb7Banner(onClick: () -> Unit, modifier: Modifier = Modifier) {
+    val context = LocalContext.current
+    val bb7 =
+        remember {
+            Settings.Secure.getString(context.contentResolver, "sable_profile") == "bb7"
+        }
+    if (!bb7) return
+    Text(
+        text = stringResource(R.string.sable_bb7_manage_connections),
+        style = MaterialTheme.typography.titleMedium,
+        color = Color.White,
+        modifier =
+            modifier
+                .fillMaxWidth()
+                .padding(top = 8.dp)
+                .clip(RoundedCornerShape(4.dp))
+                .background(BannerBlue)
+                .clickable(role = Role.Button, onClick = onClick)
+                .padding(horizontal = 12.dp, vertical = 10.dp),
+    )
+}
