+     WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+     See the License for the specific language governing permissions and
+     limitations under the License.
+-->
+<resources>
+    <!-- SableOS: the BlackBerry 7 shade banner (Sable 2.0). -->
+    <string name="sable_bb7_manage_connections">Manage Connections</string>
+</resources>
diff --git a/packages/SystemUI/src/com/android/systemui/qs/composefragment/QSFragmentCompose.kt b/packages/SystemUI/src/com/android/systemui/qs/composefragment/QSFragmentCompose.kt
index 01756c9..6bc2419 100644
--- a/packages/SystemUI/src/com/android/systemui/qs/composefragment/QSFragmentCompose.kt
+++ b/packages/SystemUI/src/com/android/systemui/qs/composefragment/QSFragmentCompose.kt
@@ -844,6 +844,16 @@
         // Looked up again each time the shade opens, so installing or removing Start is seen.
         val hubInstalled =
             remember(shadeOpen) { sableHubIntent(context) != null }
+        // Sable: on the BBOS 7 profile a blue banner opens Manage Connections.
+        com.android.systemui.qs.composefragment.ui.SableBb7Banner(
+            onClick = {
+                activityStarter.postStartActivityDismissingKeyguard(
+                    Intent("org.sableos.settings.MANAGE_CONNECTIONS").setPackage("com.android.settings")
+                        .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK),
+                    0 /* delay */,
+                )
+            }
+        )
         SableHubSummaryRow(
             priorityCount = priorityCount,
             locked = viewModel.statusBarState != StatusBarState.SHADE,
diff --git a/packages/SystemUI/src/com/android/systemui/qs/composefragment/ui/SableBb7Banner.kt b/packages/SystemUI/src/com/android/systemui/qs/composefragment/ui/SableBb7Banner.kt
new file mode 100644
index 0000000..0d8957d
--- /dev/null
+++ b/packages/SystemUI/src/com/android/systemui/qs/composefragment/ui/SableBb7Banner.kt
@@ -0,0 +1,67 @@
