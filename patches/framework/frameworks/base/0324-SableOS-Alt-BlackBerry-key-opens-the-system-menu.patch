From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SableOS <noreply@sableos.invalid>
Date: Thu, 12 Nov 2026 05:00:00 +0000
Subject: [PATCH] SableOS: Alt+BlackBerry key opens the system menu

Owner decisions 2026-11-12: holding the BlackBerry key (HOME) opens the
assistant, Cosgrove (config_longPressOnHomeBehavior 3, SEARCH, in the
Lineage platform overlay), and a press stays Home. Alt+BlackBerry key
opens a BlackBerry 7 style system menu:

* PhoneWindowManager.interceptSystemKeysAndShortcuts takes Alt+HOME
  (either Alt; no other modifier) from a physical keyboard, off the
  keyguard and after setup, and starts the SableOS home's
  SableSystemMenuActivity (sable-src/apps/r8/tenseven) on the key's
  display: the app's own menu, Close the app, Switch Application,
  Notifications and Quick Settings, moved through with the trackpad.
  When the home has no such menu (Sable Start), the app in front gets
  MENU instead, as the hold used to send.
* Its repeats and release are consumed with it, even when Alt is let
  go first, so Home's own long press never fires on the same press.
* The keyguard keeps Home. Pure policy: SableCommandKeys.isMenuChord.
---
 .../server/policy/PhoneWindowManager.java     | 35 +++++++++++++++++++
 .../server/policy/sable/SableCommandKeys.java | 17 +++++++++
 2 files changed, 52 insertions(+)

diff --git a/services/core/java/com/android/server/policy/PhoneWindowManager.java b/services/core/java/com/android/server/policy/PhoneWindowManager.java
index 47afb18..27cd443 100644
--- a/services/core/java/com/android/server/policy/PhoneWindowManager.java
+++ b/services/core/java/com/android/server/policy/PhoneWindowManager.java
@@ -3960,6 +3960,9 @@ public class PhoneWindowManager implements WindowManagerPolicy {
     // NOTE: Please try not to add new Shortcut combinations here and instead use KeyGestureEvents.
     // Add shortcut trigger logic in {@code KeyGestureController} and add handling logic in
     // {@link handleKeyGesture()}
+    /** Sable: an Alt+BlackBerry key press (the app menu) is in progress; see KEYCODE_HOME below. */
+    private boolean mSableAltHomeHeld;
+
     private boolean interceptSystemKeysAndShortcuts(IBinder focusedToken, KeyEvent event) {
         final int keyCode = event.getKeyCode();
         final int repeatCount = event.getRepeatCount();
@@ -3971,6 +3974,26 @@ public class PhoneWindowManager implements WindowManagerPolicy {
 
         switch (keyCode) {
             case KeyEvent.KEYCODE_HOME:
+                // Sable: holding the BlackBerry key (HOME) opens the assistant, so Alt+BlackBerry
+                // key opens the system menu (the app's menu, Close, Switch application,
+                // Notifications, Quick Settings) in the SableOS home; with no such menu, the app's
+                // own menu. Its repeats and release go with it, even when Alt is let go first.
+                // Off the keyguard and after setup only; the keyguard keeps Home.
+                if (down && repeatCount == 0) {
+                    mSableAltHomeHeld = !keyguardOn && isUserSetupComplete()
+                            && SableCommandKeys.isMenuChord(keyCode, event.getMetaState(),
+                                    virtualKey);
+                    if (mSableAltHomeHeld) {
+                        final int displayId = event.getDisplayId();
+                        mHandler.post(() -> openSableSystemMenu(displayId));
+                        return true;
+                    }
+                } else if (mSableAltHomeHeld) {
+                    if (!down) {
+                        mSableAltHomeHeld = false;
+                    }
+                    return true;
+                }
                 return handleHomeShortcuts(focusedToken, event);
             case KeyEvent.KEYCODE_MENU:
                 if (virtualKey || keyguardOn) {
@@ -4105,6 +4128,18 @@ public class PhoneWindowManager implements WindowManagerPolicy {
         mContext.sendBroadcastAsUser(intent, UserHandle.CURRENT);
     }
 
+    /** Sable: Alt+BlackBerry key (see KEYCODE_HOME above). */
+    private void openSableSystemMenu(int displayId) {
+        final Intent intent = new Intent()
+                .setClassName(SableCommandKeys.START_PACKAGE, SableCommandKeys.SYSTEM_MENU_ACTIVITY)
+                .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+        if (intent.resolveActivityInfo(mContext.getPackageManager(), 0) == null) {
+            triggerVirtualKeypress(KeyEvent.KEYCODE_MENU);
+            return;
+        }
+        startActivityAsUser(intent, UserHandle.CURRENT, displayId);
+    }
+
     /** Sable Command from anywhere (see above): Start's search, on the display the key came from. */
     private void openSableCommand(int displayId) {
         final Intent intent = new Intent(SableCommandKeys.ACTION_COMMAND)
diff --git a/services/core/java/com/android/server/policy/sable/SableCommandKeys.java b/services/core/java/com/android/server/policy/sable/SableCommandKeys.java
index 407e4a5..74364af 100644
--- a/services/core/java/com/android/server/policy/sable/SableCommandKeys.java
+++ b/services/core/java/com/android/server/policy/sable/SableCommandKeys.java
@@ -28,10 +28,15 @@ package com.android.server.policy.sable;
  * <p>Pure: android.view.KeyEvent values are copied so that it can be tested off-device.
  */
 public final class SableCommandKeys {
+    /** {@code KeyEvent.KEYCODE_HOME}: the Q25's BlackBerry key. */
+    public static final int KEYCODE_HOME = 3;
     /** {@code KeyEvent.KEYCODE_SPACE}. */
     public static final int KEYCODE_SPACE = 62;
     /** Sable Start's Command search (SableStartActivity.ACTION_COMMAND). */
     public static final String ACTION_COMMAND = "org.sableos.start.action.COMMAND";
+    /** The SableOS home's BlackBerry 7 style system menu (sable-src/apps/r8/tenseven). */
+    public static final String SYSTEM_MENU_ACTIVITY =
+            "io.github.aimindseye.tenseven.SableSystemMenuActivity";
     /** Sable Start (the BB10 and BB7 home). */
     public static final String START_PACKAGE = "org.sableos.launcher";
 
@@ -54,4 +59,16 @@ public final class SableCommandKeys {
                 && (metaState & META_ALT_ON) != 0
                 && (metaState & OTHER_MODIFIERS) == 0;
     }
+
+    /**
+     * Alt+BlackBerry key (HOME) from a physical keyboard, with no other modifier: the system menu
+     * (the app's menu, Close, Switch application, Notifications, Quick Settings). Holding the BlackBerry key alone opens the assistant (Cosgrove), and a press
+     * alone stays Home.
+     */
+    public static boolean isMenuChord(int keyCode, int metaState, boolean virtualKey) {
+        return keyCode == KEYCODE_HOME
+                && !virtualKey
+                && (metaState & META_ALT_ON) != 0
+                && (metaState & OTHER_MODIFIERS) == 0;
+    }
 }
