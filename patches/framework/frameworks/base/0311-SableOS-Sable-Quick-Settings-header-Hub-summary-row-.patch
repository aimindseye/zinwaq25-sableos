+package com.android.systemui.shade.sable
+
+import com.android.systemui.dagger.SysUISingleton
+import javax.inject.Inject
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+
+/**
+ * Sable shade state shared between the notification pipeline and the compose Quick Settings
+ * header (sable-quick-settings-titan2). Main thread only: the pipeline and the QS fragment both
+ * run there.
+ */
+@SysUISingleton
+class SableShadeState @Inject constructor() {
+    private val _priorityCount = MutableStateFlow(0)
+
+    /** Notifications that count as Hub priority items ([SableHubSummary.isPriority]). */
+    val priorityCount: StateFlow<Int> = _priorityCount.asStateFlow()
+
+    fun setPriorityCount(count: Int) {
+        _priorityCount.value = count
+    }
+}
