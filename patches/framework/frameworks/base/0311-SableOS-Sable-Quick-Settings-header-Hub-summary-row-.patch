+/*
+ * Sable shade extras (sable-quick-settings-titan2): the "Sable Quick Settings" header over the
+ * compact row, the Hub summary row under it and the keyboard hint line. Shown only when
+ * config_sableShadeExtras is true (SableSystemUIOverlay).
+ */
+
+private val SableCardRadius = 12.dp
+
+/** True while a physical keyboard is attached and open (the Q25's is always). */
+@Composable
+fun sableHasHardwareKeyboard(): Boolean {
+    val configuration = LocalConfiguration.current
+    return configuration.keyboard == Configuration.KEYBOARD_QWERTY &&
+        configuration.hardKeyboardHidden != Configuration.HARDKEYBOARDHIDDEN_YES
+}
+
+/** The compact shade's title card. */
+@Composable
+fun SableShadeHeader(modifier: Modifier = Modifier) {
+    Box(
+        modifier =
+            modifier
+                .fillMaxWidth()
+                .padding(bottom = 8.dp)
+                .clip(RoundedCornerShape(SableCardRadius))
+                .background(MaterialTheme.colorScheme.surfaceContainerHigh)
+                .padding(horizontal = 12.dp, vertical = 8.dp)
+    ) {
+        Text(
+            text = stringResource(R.string.sable_qs_header),
+            style = MaterialTheme.typography.titleSmall,
+            color = MaterialTheme.colorScheme.onSurface,
+            maxLines = 1,
+            modifier = Modifier.semantics { heading() },
+        )
+    }
+}
+
+/**
+ * Hub summary row: a count only, never a sender or text. Enter (or a tap) opens Sable Hub through
+ * [onOpenHub], which asks for unlock first on a locked shade.
+ */
+@Composable
+fun SableHubSummaryRow(
+    priorityCount: Int,
+    locked: Boolean,
+    hubInstalled: Boolean,
+    onOpenHub: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    val state = SableHubSummary.rowState(hubInstalled, locked, priorityCount)
+    if (state == SableHubSummary.HIDDEN) return
+    val resources = LocalContext.current.resources
+    val shown = SableHubSummary.shownCount(priorityCount)
+    val count =
+        if (SableHubSummary.isCapped(priorityCount)) {
+            resources.getString(R.string.sable_hub_summary_capped, shown)
+        } else {
+            resources.getQuantityString(R.plurals.sable_hub_summary_items, shown, shown)
+        }
+    val detail =
+        when (state) {
+            SableHubSummary.LOCKED -> resources.getString(R.string.sable_hub_summary_locked, count)
+            SableHubSummary.EMPTY -> resources.getString(R.string.sable_hub_summary_empty)
+            else -> resources.getString(R.string.sable_hub_summary_open, count)
+        }
+    val shape = RoundedCornerShape(SableCardRadius)
+    Row(
+        verticalAlignment = Alignment.CenterVertically,
+        horizontalArrangement = Arrangement.spacedBy(10.dp),
+        modifier =
+            modifier
+                .fillMaxWidth()
+                .padding(top = 8.dp)
+                .borderOnFocus(
+                    color = MaterialTheme.colorScheme.secondary,
+                    cornerSize = CornerSize(SableCardRadius),
+                )
+                .clip(shape)
+                .background(MaterialTheme.colorScheme.surfaceContainerHigh)
+                .clickable(
+                    onClickLabel = stringResource(R.string.sable_hub_summary_action),
+                    role = Role.Button,
+                    onClick = onOpenHub,
+                )
+                .padding(horizontal = 12.dp, vertical = 8.dp),
+    ) {
+        Box(
+            modifier =
+                Modifier.size(10.dp).clip(CircleShape).background(MaterialTheme.colorScheme.primary)
+        )
+        Column(modifier = Modifier.weight(1f)) {
+            Text(
+                text = stringResource(R.string.sable_hub_summary_title),
+                style = MaterialTheme.typography.labelLarge,
+                color = MaterialTheme.colorScheme.onSurface,
+                maxLines = 1,
+            )
+            Text(
+                text = detail,
+                style = MaterialTheme.typography.labelMedium,
+                color = MaterialTheme.colorScheme.onSurfaceVariant,
+                maxLines = 1,
+                overflow = TextOverflow.Ellipsis,
+            )
+        }
+    }
+}
+
+/** One line of the shade's keys, only with a physical keyboard. */
+@Composable
+fun SableShadeKeyHint(expanded: Boolean, modifier: Modifier = Modifier) {
+    if (!sableHasHardwareKeyboard()) return
+    Text(
+        text =
+            stringResource(
+                if (expanded) R.string.sable_qs_key_hint_expanded else R.string.sable_qs_key_hint
+            ),
+        style = MaterialTheme.typography.labelSmall,
+        color = MaterialTheme.colorScheme.onSurfaceVariant,
+        maxLines = 1,
+        overflow = TextOverflow.Ellipsis,
+        modifier = modifier.fillMaxWidth().padding(top = 6.dp),
+    )
+}
