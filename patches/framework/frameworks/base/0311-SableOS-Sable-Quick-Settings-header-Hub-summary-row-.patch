+package com.android.systemui.statusbar.notification.collection.coordinator
+
+import com.android.systemui.shade.sable.SableHubSummary
+import com.android.systemui.shade.sable.SableShadeState
+import com.android.systemui.statusbar.notification.collection.GroupEntry
+import com.android.systemui.statusbar.notification.collection.NotifPipeline
+import com.android.systemui.statusbar.notification.collection.NotificationEntry
+import com.android.systemui.statusbar.notification.collection.PipelineEntry
+import com.android.systemui.statusbar.notification.collection.coordinator.dagger.CoordinatorScope
+import com.android.systemui.statusbar.notification.stack.BUCKET_ALERTING
+import com.android.systemui.statusbar.notification.stack.BUCKET_HEADS_UP
+import com.android.systemui.statusbar.notification.stack.BUCKET_PEOPLE
+import com.android.systemui.statusbar.notification.stack.BUCKET_PRIORITY_PEOPLE
+import javax.inject.Inject
+
+/**
+ * Sable shade (sable-quick-settings-titan2): counts the Hub priority items for the shade's Hub
+ * summary row. Counted on the list about to be shown, after the final filters, so a notification
+ * hidden from the lock screen is not counted there either. Only counts; reads no content.
+ */
+@CoordinatorScope
+class SableShadeCoordinator @Inject constructor(private val sableShadeState: SableShadeState) :
+    Coordinator {
+
+    override fun attach(pipeline: NotifPipeline) {
+        pipeline.addOnBeforeRenderListListener { entries ->
+            sableShadeState.setPriorityCount(countPriority(entries))
+        }
+    }
+
+    private fun countPriority(entries: List<PipelineEntry>): Int {
+        var count = 0
+        for (entry in entries) {
+            when (entry) {
+                is NotificationEntry -> if (isPriority(entry)) count++
+                is GroupEntry -> {
+                    val children = entry.children
+                    if (children.isEmpty()) {
+                        entry.summary?.let { if (isPriority(it)) count++ }
+                    } else {
+                        for (child in children) if (isPriority(child)) count++
+                    }
+                }
+                else -> {}
+            }
+        }
+        return count
+    }
+
+    private fun isPriority(entry: NotificationEntry): Boolean =
+        SableHubSummary.isPriority(
+            when (entry.bucket) {
+                BUCKET_HEADS_UP,
+                BUCKET_PRIORITY_PEOPLE,
+                BUCKET_PEOPLE,
+                BUCKET_ALERTING -> true
+                else -> false
+            },
+            entry.sbn.isOngoing,
+        )
+}
