+package com.android.systemui.shade.sable;
+
+/**
+ * Pure policy for the shade's Hub summary row (sable-quick-settings-titan2, Hub handoff).
+ *
+ * <p>A priority item is a notification the shade ranks as alerting (heads-up, conversation or
+ * alerting section) that is not ongoing: silent, minimized, ongoing and foreground-service
+ * notifications are not counted. The row shows only a count, never a sender or text, and on a
+ * locked shade it says so ("counts only"); Enter then asks for unlock before Hub opens.
+ */
+public final class SableHubSummary {
+    /** Hub is not installed: no row. */
+    public static final int HIDDEN = 0;
+    /** Unlocked, nothing to count: "No priority items · Enter opens Hub". */
+    public static final int EMPTY = 1;
+    /** Unlocked: "N priority items · Enter opens Hub". */
+    public static final int COUNT = 2;
+    /** Locked shade: "N priority items · counts only". */
+    public static final int LOCKED = 3;
+
+    /** Counts above this read as "99+". */
+    public static final int MAX_SHOWN = 99;
+
+    private SableHubSummary() {}
+
+    /** Whether one notification counts as a Hub priority item. */
+    public static boolean isPriority(boolean alertingSection, boolean ongoing) {
+        return alertingSection && !ongoing;
+    }
+
+    /** Which row variant to show. */
+    public static int rowState(boolean hubInstalled, boolean locked, int priorityCount) {
+        if (!hubInstalled) return HIDDEN;
+        if (locked) return LOCKED;
+        return priorityCount > 0 ? COUNT : EMPTY;
+    }
+
+    /** The number as shown: never negative, capped at {@link #MAX_SHOWN} (caller adds "+"). */
+    public static int shownCount(int priorityCount) {
+        return Math.max(0, Math.min(priorityCount, MAX_SHOWN));
+    }
+
+    /** Whether the shown count is capped. */
+    public static boolean isCapped(int priorityCount) {
+        return priorityCount > MAX_SHOWN;
+    }
+}
