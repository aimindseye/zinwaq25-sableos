+    @Override
+    public boolean dispatchKeyEvent(KeyEvent event) {
+        return handleSableKeyEvent(event) || super.dispatchKeyEvent(event);
+    }
+
+    /**
+     * Sable: PIN keys from a physical keyboard, also called by KeyguardSecurityContainerController
+     * before the view tree sees the key, so they work even when focus is outside this view.
+     * Digits (number row, numpad, the key map's phone-pad or Alt digits, and the phone-pad
+     * letters W E R S D F Z X C by key code on keyboards without a number row) and Backspace act
+     * on DOWN; Enter acts on the UP of a DOWN seen here and always presses OK. Every other key
+     * returns false and keeps its meaning. Entry goes through the on-screen keys, so the
+     * credential path is unchanged.
+     */
+    boolean handleSableKeyEvent(KeyEvent event) {
+        final int keyCode = event.getKeyCode();
+        final int action = event.getAction();
+        if (keyCode == KeyEvent.KEYCODE_ENTER || keyCode == KeyEvent.KEYCODE_NUMPAD_ENTER) {
+            if (action == KeyEvent.ACTION_DOWN) {
+                if (event.getRepeatCount() == 0) {
+                    mSableEnterDown = true;
+                }
+            } else if (action == KeyEvent.ACTION_UP) {
+                final boolean press = mSableEnterDown && !event.isCanceled();
+                mSableEnterDown = false;
+                if (press && mPasswordEntry.isEnabled()) {
+                    mOkButton.performClick();
+                }
+            }
+            return true;
+        }
+        if (keyCode == KeyEvent.KEYCODE_DEL) {
+            if (action == KeyEvent.ACTION_DOWN && mPasswordEntry.isEnabled()) {
+                mDeleteButton.performClick();
+            }
+            return true;
+        }
+        final int digit = SableKeyguardKeys.pinDigitFor(keyCode, event.getUnicodeChar(),
+                event.getNumber(), event.getMetaState());
+        if (digit < 0) {
+            return false;
+        }
+        if (action == KeyEvent.ACTION_DOWN && event.getRepeatCount() == 0
+                && mPasswordEntry.isEnabled()) {
+            // Keys typed on the locked glance while the bouncer opened come first.
+            for (int pending : SableKeyguardTypeAhead.get().takeDigits(
+                    SystemClock.uptimeMillis())) {
+                performNumberClick(pending);
+            }
+            // NumPadKey appends and reports user activity (PowerManager and the controller's
+            // input hook through the field's user activity listener).
+            performNumberClick(digit);
+        }
+        return true;
+    }
+
+    /**
+     * Sable: with a hardware keyboard the on-screen keys are not focusable, so the trackpad
+     * (DPAD) and Tab cannot move focus off the PIN field. Touch is unaffected.
+     */
+    void setSableNumPadFocusable(boolean focusable) {
+        for (NumPadKey key : mButtons) {
+            key.setFocusable(focusable);
+        }
+        mDeleteButton.setFocusable(focusable);
+        mOkButton.setFocusable(focusable);
+    }
+
+    /** Sable: a digit typed on the locked glance before this field had focus. */
+    void typeSableDigit(int digit) {
+        if (mPasswordEntry.isEnabled()) {
+            performNumberClick(digit);
+        }
+    }
+
