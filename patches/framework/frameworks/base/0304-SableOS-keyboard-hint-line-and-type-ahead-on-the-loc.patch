+package com.android.keyguard.sable;
+
+/**
+ * Keyboard-first secure entry on the lock screen (LOCKSCREEN_SECURE_ENTRY_UX), for phones whose
+ * keyboard has no number row, such as the Q25: digits come from Alt+letter, or from the key map's
+ * number behavior where it defines one (BlackBerry-style phone pad).
+ *
+ * <p>Nothing here authenticates or skips anything: it only decides which character a key types
+ * into the PIN or password field, which keys typed on the locked glance open that field, and
+ * which hint line the lock screen shows. Pure: android.view.KeyEvent and LockPatternUtils values
+ * are copied so it can be tested off-device.
+ */
+public final class SableKeyguardKeys {
+    /** No hint line. */
+    public static final int HINT_NONE = 0;
+    /** "Type PIN · Enter unlocks". */
+    public static final int HINT_PIN = 1;
+    /** "Type password · Enter unlocks". */
+    public static final int HINT_PASSWORD = 2;
+    /** "Enter unlocks" (swipe lock). */
+    public static final int HINT_ENTER = 3;
+
+    // LockPatternUtils credential types.
+    static final int CREDENTIAL_TYPE_NONE = -1;
+    static final int CREDENTIAL_TYPE_PATTERN = 1;
+    static final int CREDENTIAL_TYPE_PIN = 3;
+    static final int CREDENTIAL_TYPE_PASSWORD = 4;
+
+    // android.view.KeyEvent key codes and meta state bits.
+    static final int KEYCODE_BACK = 4;
+    static final int KEYCODE_DPAD_CENTER = 23;
+    static final int KEYCODE_TAB = 61;
+    static final int KEYCODE_SPACE = 62;
+    static final int KEYCODE_ENTER = 66;
+    static final int KEYCODE_DEL = 67;
+    static final int KEYCODE_ESCAPE = 111;
+    static final int KEYCODE_FORWARD_DEL = 112;
+    static final int KEYCODE_NUMPAD_ENTER = 160;
+    private static final int META_SHIFT_MASK = 0x01 | 0x40 | 0x80;
+    private static final int META_ALT_MASK = 0x02 | 0x10 | 0x20;
+    private static final int META_SYM_ON = 0x04;
+    private static final int META_FUNCTION_ON = 0x08;
+    private static final int META_CTRL_MASK = 0x1000 | 0x2000 | 0x4000;
+    private static final int META_META_MASK = 0x10000 | 0x20000 | 0x40000;
+    /** Chords that are shortcuts, never text. */
+    private static final int SHORTCUT_MODIFIERS = META_CTRL_MASK | META_META_MASK | META_FUNCTION_ON;
+    /** Modifiers that make a key type something other than its number behavior. */
+    private static final int TEXT_MODIFIERS = META_SHIFT_MASK | META_ALT_MASK | META_SYM_ON;
+
+    private SableKeyguardKeys() {}
+
+    /**
+     * The PIN digit a key types, or -1. {@code unicodeChar} is {@code KeyEvent.getUnicodeChar()}
+     * (with the event's Alt/Shift state applied: Alt+W on the Q25), {@code numberChar} is
+     * {@code KeyEvent.getNumber()} (the key map's phone-pad digit, used for plain presses only).
+     */
+    public static int digitFor(int unicodeChar, int numberChar, int metaState) {
+        if ((metaState & SHORTCUT_MODIFIERS) != 0) {
+            return -1;
+        }
+        if (unicodeChar >= '0' && unicodeChar <= '9') {
+            return unicodeChar - '0';
+        }
+        if ((metaState & TEXT_MODIFIERS) == 0 && numberChar >= '0' && numberChar <= '9') {
+            return numberChar - '0';
+        }
+        return -1;
+    }
+
+    // android.view.KeyEvent digit key codes.
+    static final int KEYCODE_0 = 7;
+    static final int KEYCODE_9 = 16;
+    static final int KEYCODE_NUMPAD_0 = 144;
+    static final int KEYCODE_NUMPAD_9 = 153;
+    /**
+     * BlackBerry-style phone pad on keyboards without a number row (Q25, Titan): W E R S D F
+     * Z X C are 1-9 (android.view.KeyEvent KEYCODE_W, E, R, S, D, F, Z, X, C).
+     */
+    private static final int[] PHONE_PAD_KEYCODES = {51, 33, 46, 47, 32, 34, 54, 52, 31};
+
+    /**
+     * The digit a key types into a PIN field, or -1: the number row and numpad by key code; else
+     * {@link #digitFor} (the key map's Alt digit or phone-pad number); else, for a plain or Alt
+     * press, the phone-pad letters by key code. The last step does not depend on the device key
+     * character map, which a keyboard layout overlay (Settings > Keyboard > layout) replaces
+     * key by key, dropping the Q25 map's number and alt digits. Shift and shortcut chords never
+     * give a digit from a letter.
+     */
+    public static int pinDigitFor(int keyCode, int unicodeChar, int numberChar, int metaState) {
+        if ((metaState & SHORTCUT_MODIFIERS) != 0) {
+            return -1;
+        }
+        if (keyCode >= KEYCODE_0 && keyCode <= KEYCODE_9) {
+            return keyCode - KEYCODE_0;
+        }
+        if (keyCode >= KEYCODE_NUMPAD_0 && keyCode <= KEYCODE_NUMPAD_9) {
+            return keyCode - KEYCODE_NUMPAD_0;
+        }
+        final int mapped = digitFor(unicodeChar, numberChar, metaState);
+        if (mapped >= 0) {
+            return mapped;
+        }
+        if ((metaState & (META_SHIFT_MASK | META_SYM_ON)) != 0) {
+            return -1;
+        }
+        for (int i = 0; i < PHONE_PAD_KEYCODES.length; i++) {
+            if (PHONE_PAD_KEYCODES[i] == keyCode) {
+                return i + 1;
+            }
+        }
+        return -1;
+    }
+
+    /** android.content.res.Configuration.KEYBOARD_QWERTY. */
+    static final int CONFIGURATION_KEYBOARD_QWERTY = 2;
+
+    /** Whether {@code Configuration.keyboard} reports a hardware QWERTY keyboard. */
+    public static boolean hasHardwareKeyboard(int configurationKeyboard) {
+        return configurationKeyboard == CONFIGURATION_KEYBOARD_QWERTY;
+    }
+
+    /** A character a password field accepts from this key, or 0. */
+    public static int textCharFor(int unicodeChar, int metaState) {
+        if ((metaState & SHORTCUT_MODIFIERS) != 0) {
+            return 0;
+        }
+        // Printable only: no controls, no space (a confirm key), no dead keys (COMBINING_ACCENT).
+        if (unicodeChar <= 0x20 || unicodeChar == 0x7f
+                || (unicodeChar >= 0x80 && unicodeChar < 0xa0)) {
+            return 0;
+        }
+        return unicodeChar;
+    }
+
+    /**
+     * Whether a key typed on the locked glance (no bouncer yet) should open the PIN or password
+     * field and be typed into it. Confirm, Back, Escape, Tab and delete keys keep their meaning
+     * (Enter and Space already open the field upstream); repeats and shortcuts never count.
+     */
+    public static boolean isTypeAheadKey(int keyCode, int metaState, int repeatCount,
+            int unicodeChar, int numberChar) {
+        if (repeatCount != 0) {
+            return false;
+        }
+        switch (keyCode) {
+            case KEYCODE_BACK:
+            case KEYCODE_DPAD_CENTER:
+            case KEYCODE_TAB:
+            case KEYCODE_SPACE:
+            case KEYCODE_ENTER:
+            case KEYCODE_DEL:
+            case KEYCODE_ESCAPE:
+            case KEYCODE_FORWARD_DEL:
+            case KEYCODE_NUMPAD_ENTER:
+                return false;
+            default:
+                break;
+        }
+        return pinDigitFor(keyCode, unicodeChar, numberChar, metaState) >= 0
+                || textCharFor(unicodeChar, metaState) != 0;
+    }
+
+    /** The lock screen hint for the user's credential type ({@code LockPatternUtils}). */
+    public static int hintFor(int credentialType) {
+        switch (credentialType) {
+            case CREDENTIAL_TYPE_PIN:
+                return HINT_PIN;
+            case CREDENTIAL_TYPE_PASSWORD:
+                return HINT_PASSWORD;
+            case CREDENTIAL_TYPE_NONE:
+                return HINT_ENTER;
+            default:
+                // Pattern (and anything new): Enter opens it, but nothing is typed.
+                return HINT_NONE;
+        }
+    }
+}
