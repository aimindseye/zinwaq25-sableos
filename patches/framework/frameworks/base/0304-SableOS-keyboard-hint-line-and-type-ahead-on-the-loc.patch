+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.keyguard.sable;
+
+/**
+ * Keys typed on the locked glance while the PIN or password field is still opening.
+ *
+ * <p>The first key opens the bouncer; it and any key typed before the field has focus are held
+ * here and handed to the field once, when it resumes. Entries are short-lived: they are dropped
+ * {@link #TIMEOUT_MS} after the last key, on {@link #clear()}, and when taken, and they never
+ * leave SystemUI or reach a log. Holding a few typed characters for the field the user is about
+ * to see is all this does: it never checks or submits a credential.
+ *
+ * <p>Main thread only in SystemUI; synchronized anyway. Pure Java, tested off-device.
+ */
+public final class SableKeyguardTypeAhead {
+    /** Entries older than this (since the last key) are dropped unseen. */
+    public static final long TIMEOUT_MS = 3000;
+    /** At most this many keys are held; later ones are dropped. */
+    public static final int MAX_KEYS = 64;
+
+    private static final SableKeyguardTypeAhead INSTANCE = new SableKeyguardTypeAhead();
+
+    private final int[] mDigits = new int[MAX_KEYS];
+    private final int[] mTextChars = new int[MAX_KEYS];
+    private int mCount;
+    private long mLastOfferMs;
+
+    /** The SystemUI-wide buffer shared by the key handler and the bouncer views. */
+    public static SableKeyguardTypeAhead get() {
+        return INSTANCE;
+    }
+
+    /**
+     * Holds one key: its PIN digit (or -1) and its password character (or 0), as
+     * {@link SableKeyguardKeys} computed them.
+     */
+    public synchronized void offer(int digit, int textChar, long nowMs) {
+        expire(nowMs);
+        if (mCount < MAX_KEYS) {
+            mDigits[mCount] = digit;
+            mTextChars[mCount] = textChar;
+            mCount++;
+        }
+        mLastOfferMs = nowMs;
+    }
+
+    /** Keys are held and not yet expired: the field is still opening. */
+    public synchronized boolean isPending(long nowMs) {
+        expire(nowMs);
+        return mCount > 0;
+    }
+
+    /** The held PIN digits, in order (keys without a digit skipped); empties the buffer. */
+    public synchronized int[] takeDigits(long nowMs) {
+        expire(nowMs);
+        int n = 0;
+        for (int i = 0; i < mCount; i++) {
+            if (mDigits[i] >= 0) n++;
+        }
+        final int[] digits = new int[n];
+        n = 0;
+        for (int i = 0; i < mCount; i++) {
+            if (mDigits[i] >= 0) digits[n++] = mDigits[i];
+        }
+        clear();
+        return digits;
+    }
+
+    /** The held password characters, in order (keys without one skipped); empties the buffer. */
+    public synchronized String takeText(long nowMs) {
+        expire(nowMs);
+        final StringBuilder text = new StringBuilder(mCount);
+        for (int i = 0; i < mCount; i++) {
+            if (mTextChars[i] != 0) text.appendCodePoint(mTextChars[i]);
+        }
+        clear();
+        return text.toString();
+    }
+
+    /** Drops everything held, overwriting it. */
+    public synchronized void clear() {
+        java.util.Arrays.fill(mDigits, 0, MAX_KEYS, -1);
+        java.util.Arrays.fill(mTextChars, 0, MAX_KEYS, 0);
+        mCount = 0;
+    }
+
+    private void expire(long nowMs) {
+        if (mCount > 0 && (nowMs - mLastOfferMs > TIMEOUT_MS || nowMs < mLastOfferMs)) {
+            clear();
+        }
+    }
+}
