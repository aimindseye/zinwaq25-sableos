+    /**
+     * Sable (LOCKSCREEN_SECURE_ENTRY_UX): typing on the locked glance goes straight into the PIN
+     * or password field. A printable key from a physical keyboard opens the primary bouncer, as
+     * Enter already does, and is held in [SableKeyguardTypeAhead] with any key typed before the
+     * field has focus; the PIN or password view takes them when it resumes. Nothing is checked or
+     * submitted here and no key path unlocks: the user still confirms with Enter.
+     */
+    private fun dispatchSableTypeAhead(event: KeyEvent): Boolean {
+        if (SceneContainerFlag.isEnabled || event.action != KeyEvent.ACTION_DOWN) return false
+        if (statusBarStateController.state != StatusBarState.KEYGUARD || !isDeviceAwake()) {
+            return false
+        }
+        if (
+            event.deviceId == KeyCharacterMap.VIRTUAL_KEYBOARD ||
+                !event.isFromSource(InputDevice.SOURCE_KEYBOARD)
+        ) {
+            return false
+        }
+        val unicodeChar = event.unicodeChar
+        val numberChar = event.number.code
+        if (
+            !SableKeyguardKeys.isTypeAheadKey(
+                event.keyCode,
+                event.metaState,
+                event.repeatCount,
+                unicodeChar,
+                numberChar,
+            )
+        ) {
+            return false
+        }
+        val typeAhead = SableKeyguardTypeAhead.get()
+        val now = SystemClock.uptimeMillis()
+        val bouncerOpening = statusBarKeyguardViewManager.primaryBouncerIsOrWillBeShowing()
+        // Once the field is up and focused it gets keys itself; until then keep collecting.
+        if (bouncerOpening && !typeAhead.isPending(now)) return false
+        if (!statusBarKeyguardViewManager.isSecure()) return false
+        typeAhead.offer(
+            SableKeyguardKeys.pinDigitFor(
+                event.keyCode,
+                unicodeChar,
+                numberChar,
+                event.metaState,
+            ),
+            SableKeyguardKeys.textCharFor(unicodeChar, event.metaState),
+            now,
+        )
+        if (!bouncerOpening) {
+            statusBarKeyguardViewManager.showPrimaryBouncer(
+                true,
+                "KeyguardKeyEventInteractor#dispatchSableTypeAhead",
+            )
+        }
+        return true
+    }
