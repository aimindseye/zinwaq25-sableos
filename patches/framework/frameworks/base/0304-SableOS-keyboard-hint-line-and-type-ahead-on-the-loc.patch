+    /**
+     * Sable (LOCKSCREEN_SECURE_ENTRY_UX): a keyboard hint line, "Type PIN · Enter unlocks", on
+     * phones with a hardware keyboard. Typing goes straight into the field (see
+     * KeyguardKeyEventInteractor); the hint only says so. Nothing shows without a keyboard.
+     */
+    private void updateLockScreenSableKeyboardHint(int userId) {
+        if (mContext.getResources().getConfiguration().keyboard
+                != Configuration.KEYBOARD_QWERTY) {
+            mRotateTextViewController.hideIndication(INDICATION_TYPE_SABLE_KEYBOARD_HINT);
+            return;
+        }
+        // The credential type is a LockSettings IPC: read it off the main thread.
+        mBackgroundExecutor.execute(() -> {
+            final int hint = SableKeyguardKeys.hintFor(
+                    mLockPatternUtils.getCredentialTypeForUser(userId));
+            mExecutor.execute(() -> {
+                final int hintRes;
+                switch (hint) {
+                    case SableKeyguardKeys.HINT_PIN:
+                        hintRes = R.string.sable_keyguard_hint_pin;
+                        break;
+                    case SableKeyguardKeys.HINT_PASSWORD:
+                        hintRes = R.string.sable_keyguard_hint_password;
+                        break;
+                    case SableKeyguardKeys.HINT_ENTER:
+                        hintRes = R.string.sable_keyguard_hint_enter;
+                        break;
+                    default:
+                        hintRes = 0;
+                        break;
+                }
+                if (hintRes != 0 && mKeyguardStateController.isShowing()) {
+                    mRotateTextViewController.updateIndication(
+                            INDICATION_TYPE_SABLE_KEYBOARD_HINT,
+                            new KeyguardIndication.Builder()
+                                    .setMessage(mContext.getString(hintRes))
+                                    .setTextColor(getInitialTextColorState())
+                                    .build(),
+                            false);
+                } else {
+                    mRotateTextViewController.hideIndication(INDICATION_TYPE_SABLE_KEYBOARD_HINT);
+                }
+            });
+        });
+    }
