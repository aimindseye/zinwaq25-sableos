@@ -404,6 +405,10 @@ public class KeyguardPasswordViewController
 
     @Override
     protected int getInitialMessageResId() {
+        // Sable: with a hardware keyboard, say that typing and Enter work.
+        if (SableKeyguardKeys.hasHardwareKeyboard(getResources().getConfiguration().keyboard)) {
+            return R.string.sable_keyguard_bouncer_password;
+        }
         return R.string.keyguard_enter_your_password;
     }
 }
