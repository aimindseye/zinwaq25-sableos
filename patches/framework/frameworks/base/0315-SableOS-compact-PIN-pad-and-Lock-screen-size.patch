+package com.android.keyguard.sable;
+
+/**
+ * Lock screen size and the compact PIN pad. Pure Java.
+ *
+ * <p>Settings > Display > Lock screen size stores a level in {@link #SETTING}: 0 Small, 1 Default,
+ * 2 Large, 3 Larger. The level scales the locked glance's text and the PIN pad's keys and digits.
+ *
+ * <p>On a short window (under {@link #COMPACT_BELOW_DP} tall, such as the Q25's 411 dp square
+ * screen) the PIN pad is compact: wide, short keys instead of 72 dp circles, a shorter PIN row and
+ * tighter gaps, so the message, the PIN row, all four rows of keys and the emergency button fit
+ * without clipping. Keys take the level's height unless that would overflow the window; then they
+ * take the tallest height that fits, never under {@link #MIN_KEY_DP}.
+ */
+public final class SableLockSize {
+    /** Settings.Secure key Settings writes and SystemUI reads. */
+    public static final String SETTING = "sable_lock_screen_size";
+
+    public static final int DEFAULT_LEVEL = 1;
+
+    /** Scale per level: Small, Default, Large, Larger. Same values as Settings' SableSizes. */
+    private static final float[] SCALES = {0.85f, 1.0f, 1.15f, 1.3f};
+
+    /** Windows shorter than this get the compact PIN pad. */
+    public static final int COMPACT_BELOW_DP = 560;
+
+    static final int KEY_DP = 44;
+    static final int MIN_KEY_DP = 32;
+    static final int GAP_DP = 6;
+    static final int ENTRY_DP = 40;
+    static final int MIN_ENTRY_DP = 32;
+    static final int DIGIT_DP = 22;
+    static final int SIDE_DP = 16;
+    static final int SECURITY_WIDTH_DP = 420;
+    static final float KEY_WIDTH_RATIO = 2.2f;
+    static final int ECA_DP = 40;
+    static final int ECA_MARGIN_DP = 6;
+    static final int FLOW_BOTTOM_DP = 8;
+    static final int MESSAGE_LINE_DP = 20;
+    static final int MESSAGE_PADDING_DP = 12;
+    static final int FALLBACK_LINE_DP = 18;
+
+    private SableLockSize() {}
+
+    /** A stored level, or Default when it is out of range. */
+    public static int clampLevel(int level) {
+        return level >= 0 && level < SCALES.length ? level : DEFAULT_LEVEL;
+    }
+
+    public static float scale(int level) {
+        return SCALES[clampLevel(level)];
+    }
+
+    public static boolean isCompact(int windowHeightDp) {
+        return windowHeightDp > 0 && windowHeightDp < COMPACT_BELOW_DP;
+    }
+
+    /** The PIN pad's sizes in dp. */
+    public static final class Pad {
+        public final int keyWidth;
+        public final int keyHeight;
+        public final int gap;
+        public final int entryHeight;
+        public final int digitSize;
+        public final int ecaMargin;
+
+        Pad(int keyWidth, int keyHeight, int gap, int entryHeight, int digitSize, int ecaMargin) {
+            this.keyWidth = keyWidth;
+            this.keyHeight = keyHeight;
+            this.gap = gap;
+            this.entryHeight = entryHeight;
+            this.digitSize = digitSize;
+            this.ecaMargin = ecaMargin;
+        }
+
+        /** Height the pad and what sits around it take, for a check against the window. */
+        public int totalHeight(float fontScale, boolean fallbackLine) {
+            return fixedHeight(fontScale, fallbackLine) + entryHeight + gap + 4 * keyHeight + 3 * gap;
+        }
+    }
+
+    /**
+     * The compact PIN pad for a window, or null when the window is tall enough for Android's own.
+     *
+     * @param level the Lock screen size level
+     * @param widthDp the window width
+     * @param heightDp the window height
+     * @param statusBarDp the status bar's height, which the bouncer does not draw over
+     * @param fontScale the text scale, which grows the message lines
+     * @param fallbackLine whether the "Software keyboard fallback" line shows (hardware keyboard)
+     */
+    public static Pad compactPad(int level, int widthDp, int heightDp, int statusBarDp,
+            float fontScale, boolean fallbackLine) {
+        if (!isCompact(heightDp)) {
+            return null;
+        }
+        float scale = scale(level);
+        int available = heightDp - Math.max(0, statusBarDp) - fixedHeight(fontScale, fallbackLine);
+        int entry = ENTRY_DP;
+        int wanted = Math.round(KEY_DP * scale);
+        int fits = (available - entry - GAP_DP - 3 * GAP_DP) / 4;
+        if (fits < MIN_KEY_DP) {
+            entry = MIN_ENTRY_DP;
+            fits = (available - entry - GAP_DP - 3 * GAP_DP) / 4;
+        }
+        int keyHeight = Math.max(MIN_KEY_DP, Math.min(wanted, fits));
+        int usable = Math.min(widthDp, SECURITY_WIDTH_DP) - 2 * SIDE_DP;
+        int fitWidth = (usable - 2 * GAP_DP) / 3;
+        int keyWidth = Math.max(keyHeight, Math.min(fitWidth, Math.round(keyHeight * KEY_WIDTH_RATIO)));
+        int digit = Math.min(Math.round(DIGIT_DP * scale), Math.round(keyHeight * 0.62f));
+        return new Pad(keyWidth, keyHeight, GAP_DP, entry, digit, ECA_MARGIN_DP);
+    }
+
+    /** The message lines, the emergency button and its margins, and the fallback line. */
+    static int fixedHeight(float fontScale, boolean fallbackLine) {
+        float text = Float.isNaN(fontScale) || fontScale <= 0f ? 1f : fontScale;
+        int message = Math.round(2 * MESSAGE_LINE_DP * text) + MESSAGE_PADDING_DP;
+        int eca = ECA_DP + 2 * ECA_MARGIN_DP;
+        int fallback = fallbackLine ? Math.round(FALLBACK_LINE_DP * text) : 0;
+        return message + eca + FLOW_BOTTOM_DP + fallback;
+    }
+}
