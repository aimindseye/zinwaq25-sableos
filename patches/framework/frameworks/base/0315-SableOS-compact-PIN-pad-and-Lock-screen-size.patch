+    /**
+     * SableOS: on a short window (the Q25's 411 dp square screen) the PIN pad gets wide, short keys
+     * sized by Settings > Display > Lock screen size, so the message, PIN row, keys and emergency
+     * button all fit. Sizes come from {@link SableLockSize}; taller windows keep Android's pad.
+     */
+    private void applySableCompactPad() {
+        if (mViews == null) {
+            return;
+        }
+        Configuration config = getResources().getConfiguration();
+        View fallbackLine = findViewById(R.id.sable_keyboard_fallback);
+        boolean fallback = fallbackLine != null
+                && config.keyboard == Configuration.KEYBOARD_QWERTY;
+        float density = getResources().getDisplayMetrics().density;
+        int level = Settings.Secure.getIntForUser(mContext.getContentResolver(),
+                SableLockSize.SETTING, SableLockSize.DEFAULT_LEVEL, UserHandle.USER_CURRENT);
+        SableLockSize.Pad pad = SableLockSize.compactPad(level, config.screenWidthDp,
+                config.screenHeightDp, Math.round(SystemBarUtils.getStatusBarHeight(mContext)
+                        / density), config.fontScale, fallback);
+        if (pad == null) {
+            return;
+        }
+        int keyWidth = px(pad.keyWidth, density);
+        int keyHeight = px(pad.keyHeight, density);
+        int gap = px(pad.gap, density);
+        for (int row = 1; row < 5; row++) {
+            for (int column = 0; column < 3; column++) {
+                View key = mViews[row][column];
+                if (key == null) {
+                    continue;
+                }
+                ViewGroup.LayoutParams params = key.getLayoutParams();
+                if (params instanceof ConstraintLayout.LayoutParams) {
+                    ConstraintLayout.LayoutParams lp = (ConstraintLayout.LayoutParams) params;
+                    lp.dimensionRatio = null;
+                    lp.matchConstraintMaxWidth = 0;
+                    lp.width = keyWidth;
+                    lp.height = keyHeight;
+                    lp.bottomMargin = 0;
+                    lp.rightMargin = 0;
+                    key.setLayoutParams(lp);
+                }
+                if (key instanceof NumPadKey) {
+                    ((NumPadKey) key).setSableDigitSize(pad.digitSize);
+                }
+            }
+        }
+        View flow = findViewById(R.id.flow1);
+        if (flow instanceof Flow) {
+            ((Flow) flow).setHorizontalGap(gap);
+            ((Flow) flow).setVerticalGap(gap);
+        }
+        View entry = findViewById(R.id.pinEntry);
+        if (entry != null) {
+            ViewGroup.LayoutParams lp = entry.getLayoutParams();
+            lp.height = px(pad.entryHeight, density);
+            entry.setLayoutParams(lp);
+            View row0 = findViewById(R.id.row0);
+            if (row0 != null) {
+                row0.setPadding(row0.getPaddingLeft(), row0.getPaddingTop(),
+                        row0.getPaddingRight(), gap);
+            }
+        }
+        if (mContainerMotionLayout != null) {
+            int ecaMargin = px(pad.ecaMargin, density);
+            for (int id : new int[] {R.id.single_constraints,
+                    R.id.half_folded_single_constraints, R.id.split_constraints}) {
+                ConstraintSet set = mContainerMotionLayout.getConstraintSet(id);
+                if (set == null) {
+                    continue;
+                }
+                for (int row = 1; row < 5; row++) {
+                    for (int column = 0; column < 3; column++) {
+                        View key = mViews[row][column];
+                        if (key == null) {
+                            continue;
+                        }
+                        set.setDimensionRatio(key.getId(), null);
+                        set.constrainMaxWidth(key.getId(), 0);
+                        set.constrainWidth(key.getId(), keyWidth);
+                        set.constrainHeight(key.getId(), keyHeight);
+                    }
+                }
+                set.setMargin(R.id.keyguard_selector_fade_container, ConstraintSet.TOP, ecaMargin);
+                set.setMargin(R.id.keyguard_selector_fade_container, ConstraintSet.BOTTOM,
+                        ecaMargin);
+                mContainerMotionLayout.updateState(id, set);
+            }
+        }
+    }
+
+    private static int px(int dp, float density) {
+        return Math.round(dp * density);
     }
 
