+package com.android.systemui.statusbar.notification.row
+
+import androidx.test.ext.junit.runners.AndroidJUnit4
+import androidx.test.filters.SmallTest
+import com.android.systemui.SysuiTestCase
+import org.junit.Assert.assertEquals
+import org.junit.Test
+import org.junit.runner.RunWith
+
+@SmallTest
+@RunWith(AndroidJUnit4::class)
+class SableNotificationKeyRouterTest : SysuiTestCase() {
+    private val focused =
+        SableNotificationKeyContext(
+            rowFocused = true,
+            textInputFocused = false,
+            hasModifiers = false,
+            isRepeat = false,
+            canExpand = true,
+            canReply = true,
+            canDismiss = true,
+            canOpenMenu = true,
+            hubAvailable = true,
+        )
+
+    private val letters =
+        listOf(
+            SableNotificationKey.Reply,
+            SableNotificationKey.Dismiss,
+            SableNotificationKey.Snooze,
+            SableNotificationKey.Mute,
+            SableNotificationKey.Settings,
+            SableNotificationKey.Hub,
+            SableNotificationKey.Space,
+        )
+
+    @Test
+    fun lettersMapToTheDesignCommands() {
+        assertEquals(SableNotificationCommand.Reply, route(SableNotificationKey.Reply))
+        assertEquals(SableNotificationCommand.Dismiss, route(SableNotificationKey.Dismiss))
+        assertEquals(SableNotificationCommand.Snooze, route(SableNotificationKey.Snooze))
+        assertEquals(SableNotificationCommand.DeliveryOptions, route(SableNotificationKey.Mute))
+        assertEquals(SableNotificationCommand.Settings, route(SableNotificationKey.Settings))
+        assertEquals(SableNotificationCommand.OpenInHub, route(SableNotificationKey.Hub))
+        assertEquals(SableNotificationCommand.ToggleExpand, route(SableNotificationKey.Space))
+    }
+
+    @Test
+    fun textInputAlwaysWins() {
+        val typing = focused.copy(textInputFocused = true)
+        (letters + SableNotificationKey.Enter + SableNotificationKey.Back).forEach { key ->
+            assertEquals(SableNotificationCommand.PassThrough, SableNotificationKeyRouter.route(key, typing))
+        }
+    }
+
+    @Test
+    fun commandsAreContextualNeverGlobal() {
+        val notOnRow = focused.copy(rowFocused = false)
+        letters.forEach { key ->
+            assertEquals(SableNotificationCommand.PassThrough, SableNotificationKeyRouter.route(key, notOnRow))
+        }
+    }
+
+    @Test
+    fun modifiedKeysAreNotCommands() {
+        letters.forEach { key ->
+            assertEquals(
+                SableNotificationCommand.PassThrough,
+                SableNotificationKeyRouter.route(key, focused.copy(hasModifiers = true)),
+            )
+        }
+    }
+
+    @Test
+    fun replyOnlyWhenTheSourceOffersRemoteInput() {
+        assertEquals(
+            SableNotificationCommand.Consume,
+            SableNotificationKeyRouter.route(SableNotificationKey.Reply, focused.copy(canReply = false)),
+        )
+    }
+
+    @Test
+    fun unavailableOrRepeatedCommandsAreSwallowedNotPassedOn() {
+        val nothing =
+            focused.copy(canExpand = false, canReply = false, canDismiss = false, canOpenMenu = false, hubAvailable = false)
+        listOf(
+            SableNotificationKey.Space,
+            SableNotificationKey.Reply,
+            SableNotificationKey.Dismiss,
+            SableNotificationKey.Snooze,
+            SableNotificationKey.Mute,
+            SableNotificationKey.Hub,
+        ).forEach { key ->
+            assertEquals(SableNotificationCommand.Consume, SableNotificationKeyRouter.route(key, nothing))
+        }
+        letters.forEach { key ->
+            assertEquals(
+                SableNotificationCommand.Consume,
+                SableNotificationKeyRouter.route(key, focused.copy(isRepeat = true)),
+            )
+        }
+    }
+
+    @Test
+    fun navigationOpenAndBackKeepExistingPaths() {
+        listOf(
+            SableNotificationKey.Up,
+            SableNotificationKey.Down,
+            SableNotificationKey.Left,
+            SableNotificationKey.Right,
+            SableNotificationKey.Enter,
+            SableNotificationKey.Back,
+            SableNotificationKey.Other,
+        ).forEach { key ->
+            assertEquals(SableNotificationCommand.PassThrough, route(key))
+        }
+    }
+
+    @Test
+    fun keyCodesMapToKeys() {
+        assertEquals(SableNotificationKey.Reply, SableNotificationKeyRouter.keyFor(46))
+        assertEquals(SableNotificationKey.Dismiss, SableNotificationKeyRouter.keyFor(32))
+        assertEquals(SableNotificationKey.Snooze, SableNotificationKeyRouter.keyFor(54))
+        assertEquals(SableNotificationKey.Mute, SableNotificationKeyRouter.keyFor(41))
+        assertEquals(SableNotificationKey.Settings, SableNotificationKeyRouter.keyFor(31))
+        assertEquals(SableNotificationKey.Hub, SableNotificationKeyRouter.keyFor(36))
+        assertEquals(SableNotificationKey.Space, SableNotificationKeyRouter.keyFor(62))
+        assertEquals(SableNotificationKey.Enter, SableNotificationKeyRouter.keyFor(66))
+        assertEquals(SableNotificationKey.Back, SableNotificationKeyRouter.keyFor(111))
+        assertEquals(SableNotificationKey.Other, SableNotificationKeyRouter.keyFor(29))
+    }
+
+    private fun route(key: SableNotificationKey) = SableNotificationKeyRouter.route(key, focused)
+}
