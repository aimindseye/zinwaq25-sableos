+package com.android.systemui.statusbar.notification.row
+
+import android.app.ActivityManager
+import android.content.Intent
+import android.os.UserHandle
+import android.provider.Settings
+import android.service.notification.StatusBarNotification
+import android.view.KeyEvent
+import android.view.View
+import android.view.ViewGroup
+import com.android.systemui.res.R
+import com.android.systemui.statusbar.notification.shared.NotificationBundleUi
+
+/**
+ * Executes [SableNotificationKeyRouter] commands on a focused [ExpandableNotificationRow].
+ *
+ * Every action goes through an existing SystemUI path: dismiss through the row's own dismiss,
+ * snooze and delivery options through the row's long-press menu (Android's NotificationInfo /
+ * NotificationSnooze), reply through the source's RemoteInput button (SystemUI's RemoteInput
+ * flow handles keyguard authentication), and Settings / Hub through NotificationActivityStarter,
+ * which dismisses the keyguard first. Nothing here changes notification policy.
+ */
+object SableNotificationKeyCommands {
+    private const val HUB_PACKAGE = "org.sableos.hub"
+    private const val ACTION_OPEN_IN_HUB = "org.sableos.hub.action.OPEN_NOTIFICATION"
+    private const val EXTRA_NOTIFICATION_KEY = "org.sableos.hub.extra.NOTIFICATION_KEY"
+    private const val EXTRA_APP_UID = "app_uid"
+    private const val MODIFIERS =
+        KeyEvent.META_ALT_MASK or KeyEvent.META_CTRL_MASK or KeyEvent.META_META_MASK or
+            KeyEvent.META_SHIFT_MASK or KeyEvent.META_SYM_ON or KeyEvent.META_FUNCTION_ON
+
+    @JvmStatic
+    fun onKeyDown(
+        row: ExpandableNotificationRow,
+        keyCode: Int,
+        event: KeyEvent,
+    ): Boolean {
+        val command = commandFor(row, keyCode, event)
+        return when (command) {
+            SableNotificationCommand.PassThrough -> false
+            SableNotificationCommand.Consume -> true
+            else -> execute(row, command)
+        }
+    }
+
+    /** Swallow the key-up of anything handled on key-down (Space would otherwise open the row). */
+    @JvmStatic
+    fun onKeyUp(
+        row: ExpandableNotificationRow,
+        keyCode: Int,
+        event: KeyEvent,
+    ): Boolean = commandFor(row, keyCode, event) != SableNotificationCommand.PassThrough
+
+    private fun commandFor(
+        row: ExpandableNotificationRow,
+        keyCode: Int,
+        event: KeyEvent,
+    ): SableNotificationCommand {
+        val key = SableNotificationKeyRouter.keyFor(keyCode)
+        if (key == SableNotificationKey.Other) return SableNotificationCommand.PassThrough
+        val sbn = sbnOf(row)
+        val context =
+            SableNotificationKeyContext(
+                rowFocused = row.isFocused,
+                textInputFocused = row.findFocus()?.onCheckIsTextEditor() == true,
+                hasModifiers = event.metaState and MODIFIERS != 0,
+                isRepeat = event.repeatCount > 0,
+                canExpand = row.isExpandable,
+                canReply = findReplyButton(row) != null,
+                canDismiss = row.canViewBeDismissed(),
+                canOpenMenu = row.provider != null,
+                hubAvailable = sbn != null && sbn.packageName != HUB_PACKAGE && hubResolves(row),
+            )
+        val command = SableNotificationKeyRouter.route(key, context)
+        return if (command == SableNotificationCommand.Settings && sbn == null) {
+            SableNotificationCommand.Consume
+        } else {
+            command
+        }
+    }
+
+    private fun execute(
+        row: ExpandableNotificationRow,
+        command: SableNotificationCommand,
+    ): Boolean {
+        when (command) {
+            SableNotificationCommand.ToggleExpand -> row.toggleExpansionState()
+            SableNotificationCommand.Reply -> findReplyButton(row)?.performClick()
+            SableNotificationCommand.Dismiss -> row.performDismiss(false)
+            SableNotificationCommand.Snooze -> row.performAccessibilityAction(R.id.action_snooze, null)
+            SableNotificationCommand.DeliveryOptions -> row.doLongClickCallback(row.width / 2, row.height / 2)
+            SableNotificationCommand.Settings -> sbnOf(row)?.let { openSettings(row, it) }
+            SableNotificationCommand.OpenInHub -> sbnOf(row)?.let { openInHub(row, it) }
+            SableNotificationCommand.PassThrough,
+            SableNotificationCommand.Consume,
+            -> Unit
+        }
+        return true
+    }
+
+    /** "C": the notification's Android channel (and conversation) page. */
+    private fun openSettings(
+        row: ExpandableNotificationRow,
+        sbn: StatusBarNotification,
+    ) {
+        val notification = sbn.notification
+        val intent =
+            Intent(Settings.ACTION_CHANNEL_NOTIFICATION_SETTINGS)
+                .putExtra(Settings.EXTRA_APP_PACKAGE, sbn.packageName)
+                .putExtra(Settings.EXTRA_CHANNEL_ID, notification.channelId)
+                .putExtra(EXTRA_APP_UID, sbn.uid)
+        notification.shortcutId?.let { intent.putExtra(Settings.EXTRA_CONVERSATION_ID, it) }
+        row.notificationActivityStarterForSable?.startNotificationGutsIntent(intent, sbn.uid, row)
+    }
+
+    /** "H": ask Hub; Hub decides whether it represents this source (it never includes one silently). */
+    private fun openInHub(
+        row: ExpandableNotificationRow,
+        sbn: StatusBarNotification,
+    ) {
+        val intent =
+            Intent(ACTION_OPEN_IN_HUB)
+                .setPackage(HUB_PACKAGE)
+                .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+                .putExtra(Settings.EXTRA_APP_PACKAGE, sbn.packageName)
+                .putExtra(EXTRA_APP_UID, sbn.uid)
+                .putExtra(EXTRA_NOTIFICATION_KEY, sbn.key)
+        // Hub aggregates the current user's profiles, so it runs in the current (parent) user.
+        val hubUid = UserHandle.getUid(ActivityManager.getCurrentUser(), android.os.Process.SYSTEM_UID)
+        row.notificationActivityStarterForSable?.startNotificationGutsIntent(intent, hubUid, row)
+    }
+
+    private fun hubResolves(row: ExpandableNotificationRow): Boolean =
+        row.context.packageManager
+            .queryIntentActivities(Intent(ACTION_OPEN_IN_HUB).setPackage(HUB_PACKAGE), 0)
+            .isNotEmpty()
+
+    private fun sbnOf(row: ExpandableNotificationRow): StatusBarNotification? =
+        if (NotificationBundleUi.isEnabled) row.entryAdapter.sbn else row.entryLegacy.sbn
+
+    /** The source's own RemoteInput action button, if the visible layout shows one. */
+    private fun findReplyButton(view: View): View? {
+        if (view.isShown && view.isEnabled && view.getTag(com.android.internal.R.id.remote_input_tag) != null) {
+            return view
+        }
+        if (view is ViewGroup) {
+            for (i in 0 until view.childCount) {
+                findReplyButton(view.getChildAt(i))?.let { return it }
+            }
+        }
+        return null
+    }
+}
