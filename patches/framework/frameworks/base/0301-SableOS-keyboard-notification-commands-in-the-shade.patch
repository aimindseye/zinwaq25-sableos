+package com.android.systemui.statusbar.notification.row
+
+/** Keys the Sable keyboard-first shade understands on a focused notification row. */
+enum class SableNotificationKey {
+    Up,
+    Down,
+    Left,
+    Right,
+    Enter,
+    Space,
+    Reply,
+    Dismiss,
+    Snooze,
+    Mute,
+    Settings,
+    Hub,
+    Back,
+    Other,
+}
+
+/** What the focused row can do right now, and what owns the key. */
+data class SableNotificationKeyContext(
+    /** The notification row itself has focus inside the shade. */
+    val rowFocused: Boolean,
+    /** A text editor (inline-reply RemoteInput, search) owns focus. */
+    val textInputFocused: Boolean,
+    /** Alt, Ctrl, Meta, Shift, Sym or Fn is held: the key means something else. */
+    val hasModifiers: Boolean,
+    val isRepeat: Boolean,
+    val canExpand: Boolean,
+    /** The source published a RemoteInput reply action that is shown for this row. */
+    val canReply: Boolean,
+    val canDismiss: Boolean,
+    /** The row's long-press menu (snooze, delivery options) exists. */
+    val canOpenMenu: Boolean,
+    /** Sable Hub is installed and may be asked about this notification. */
+    val hubAvailable: Boolean,
+)
+
+enum class SableNotificationCommand {
+    /** Not ours: default focus navigation, Back handling or the existing confirm-key path. */
+    PassThrough,
+
+    /** Ours, but nothing to do (unavailable action or key repeat); swallow it. */
+    Consume,
+    ToggleExpand,
+    Reply,
+    Dismiss,
+    Snooze,
+    DeliveryOptions,
+    Settings,
+    OpenInHub,
+}
+
+/**
+ * DESIGN-KF-A "Keyboard-first notification interaction".
+ *
+ * Single-letter commands are contextual to the focused notification row and never global, and
+ * text entry always wins: once an inline-reply editor owns focus, printable keys edit text.
+ * Up/Down/Left/Right use the default focus navigation (rows and action buttons), Enter keeps the
+ * existing open path, Back/Esc keep the existing close path.
+ */
+object SableNotificationKeyRouter {
+    // android.view.KeyEvent key codes (kept here so the router stays a pure function).
+    private const val KEYCODE_BACK = 4
+    private const val KEYCODE_DPAD_UP = 19
+    private const val KEYCODE_DPAD_DOWN = 20
+    private const val KEYCODE_DPAD_LEFT = 21
+    private const val KEYCODE_DPAD_RIGHT = 22
+    private const val KEYCODE_DPAD_CENTER = 23
+    private const val KEYCODE_C = 31
+    private const val KEYCODE_D = 32
+    private const val KEYCODE_H = 36
+    private const val KEYCODE_M = 41
+    private const val KEYCODE_R = 46
+    private const val KEYCODE_Z = 54
+    private const val KEYCODE_SPACE = 62
+    private const val KEYCODE_ENTER = 66
+    private const val KEYCODE_ESCAPE = 111
+    private const val KEYCODE_NUMPAD_ENTER = 160
+
+    @JvmStatic
+    fun keyFor(keyCode: Int): SableNotificationKey =
+        when (keyCode) {
+            KEYCODE_DPAD_UP -> SableNotificationKey.Up
+            KEYCODE_DPAD_DOWN -> SableNotificationKey.Down
+            KEYCODE_DPAD_LEFT -> SableNotificationKey.Left
+            KEYCODE_DPAD_RIGHT -> SableNotificationKey.Right
+            KEYCODE_ENTER, KEYCODE_NUMPAD_ENTER, KEYCODE_DPAD_CENTER -> SableNotificationKey.Enter
+            KEYCODE_SPACE -> SableNotificationKey.Space
+            KEYCODE_R -> SableNotificationKey.Reply
+            KEYCODE_D -> SableNotificationKey.Dismiss
+            KEYCODE_Z -> SableNotificationKey.Snooze
+            KEYCODE_M -> SableNotificationKey.Mute
+            KEYCODE_C -> SableNotificationKey.Settings
+            KEYCODE_H -> SableNotificationKey.Hub
+            KEYCODE_BACK, KEYCODE_ESCAPE -> SableNotificationKey.Back
+            else -> SableNotificationKey.Other
+        }
+
+    @JvmStatic
+    fun route(
+        key: SableNotificationKey,
+        context: SableNotificationKeyContext,
+    ): SableNotificationCommand {
+        // TEXT_INPUT_ALWAYS_WINS, then KEYBOARD_NOTIFICATION_COMMANDS_CONTEXTUAL.
+        if (context.textInputFocused || !context.rowFocused || context.hasModifiers) {
+            return SableNotificationCommand.PassThrough
+        }
+        return when (key) {
+            SableNotificationKey.Up,
+            SableNotificationKey.Down,
+            SableNotificationKey.Left,
+            SableNotificationKey.Right,
+            SableNotificationKey.Enter,
+            SableNotificationKey.Back,
+            SableNotificationKey.Other,
+            -> SableNotificationCommand.PassThrough
+
+            // Space is a confirm key in Android; here it expands/collapses and never opens.
+            SableNotificationKey.Space -> commandIf(context, context.canExpand, SableNotificationCommand.ToggleExpand)
+            SableNotificationKey.Reply -> commandIf(context, context.canReply, SableNotificationCommand.Reply)
+            SableNotificationKey.Dismiss -> commandIf(context, context.canDismiss, SableNotificationCommand.Dismiss)
+            SableNotificationKey.Snooze -> commandIf(context, context.canOpenMenu, SableNotificationCommand.Snooze)
+            SableNotificationKey.Mute ->
+                commandIf(context, context.canOpenMenu, SableNotificationCommand.DeliveryOptions)
+            SableNotificationKey.Settings -> commandIf(context, true, SableNotificationCommand.Settings)
+            SableNotificationKey.Hub -> commandIf(context, context.hubAvailable, SableNotificationCommand.OpenInHub)
+        }
+    }
+
+    private fun commandIf(
+        context: SableNotificationKeyContext,
+        available: Boolean,
+        command: SableNotificationCommand,
+    ): SableNotificationCommand =
+        if (available && !context.isRepeat) command else SableNotificationCommand.Consume
+}
