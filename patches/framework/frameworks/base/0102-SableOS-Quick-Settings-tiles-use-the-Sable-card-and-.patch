From 9042064cfeaf1e7f417bd1db3da1811a103bd085 Mon Sep 17 00:00:00 2001
From: SableOS <noreply@sableos.invalid>
Date: Fri, 9 Oct 2026 21:54:00 +0000
Subject: [PATCH 102/102] SableOS: Quick Settings tiles use the Sable card and
 control radii

Tiles morphed between a 50dp pill (inactive) and 24dp corners (active).
Use the DESIGN-KF-B shape tokens instead: 12dp for tiles (card radius) and
8dp for the active icon background (small control radius). Active and
inactive tiles keep the same outline, so state is carried by color and
the focus ring (which follows the tile shape) stays a stable rectangle.
Constants only; no behaviour, semantics or click handling changes.
---
 .../qs/panels/ui/compose/infinitegrid/CommonTile.kt         | 3 ++-
 .../systemui/qs/panels/ui/compose/infinitegrid/Tile.kt      | 6 ++++--
 2 files changed, 6 insertions(+), 3 deletions(-)

diff --git a/packages/SystemUI/res/values/shade_dimens.xml b/packages/SystemUI/res/values/shade_dimens.xml
index 01ba1d0..64092fa 100644
--- a/packages/SystemUI/res/values/shade_dimens.xml
+++ b/packages/SystemUI/res/values/shade_dimens.xml
@@ -28,11 +28,14 @@
     <dimen name="overlay_shade_panel_shape_radius">46dp</dimen>
 
     <!-- QS shade overlay common tiles -->
-    <dimen name="common_tile_default_active_icon_corner_radius">16dp</dimen>
-    <dimen name="common_tile_default_active_tile_corner_radius">24dp</dimen>
+    <!-- SableOS shape tokens (DESIGN-KF-B): small control 8dp, card 12dp. Active and inactive
+         tiles share one shape; state is shown by color, never by a shape change alone. -->
+    <dimen name="common_tile_default_active_icon_corner_radius">8dp</dimen>
+    <dimen name="common_tile_default_active_tile_corner_radius">12dp</dimen>
     <dimen name="common_tile_default_dual_target_end_padding">8dp</dimen>
     <dimen name="common_tile_default_icon_size">32dp</dimen>
-    <dimen name="common_tile_default_inactive_icon_corner_radius">50dp</dimen>
+    <!-- SableOS card radius (DESIGN-KF-B CARD_RADIUS=12dp) instead of the 50dp pill. -->
+    <dimen name="common_tile_default_inactive_icon_corner_radius">12dp</dimen>
     <dimen name="common_tile_default_inactive_tile_corner_radius">@dimen/common_tile_default_inactive_icon_corner_radius</dimen>
     <dimen name="common_tile_default_large_tile_icon_size">28dp</dimen>
     <dimen name="common_tile_default_start_padding">8dp</dimen>
-- 
