+package com.android.server.devicepolicy.sable;
+
+/**
+ * SableOS "Wipe after 10 failed tries" (BlackBerry style, off by default): when the owner turns
+ * it on in Settings > Security, the main user's tenth failed PIN or password in a row factory
+ * resets the phone. A stricter device admin policy still wins. Pure rules, unit-tested off the
+ * device; DevicePolicyManagerService reads the setting and does the wipe.
+ */
+public final class SableUnlockWipe {
+    /** Settings.Secure key, read for the system user only: 1 = on, anything else = off. */
+    public static final String SETTING = "sable_wipe_after_failed_unlocks";
+    /** Failed tries in a row before the wipe, as on BlackBerry. */
+    public static final int MAX_TRIES = 10;
+
+    private SableUnlockWipe() {
+    }
+
+    /**
+     * The limit the lock screen counts down to: the admin's limit (0 = none) or Sable's ten,
+     * whichever is stricter, for the main user with the switch on.
+     */
+    public static int effectiveMax(int adminMax, boolean mainUser, boolean on) {
+        if (!mainUser || !on) {
+            return adminMax;
+        }
+        return adminMax > 0 ? Math.min(adminMax, MAX_TRIES) : MAX_TRIES;
+    }
+
+    /**
+     * True when Sable itself must wipe: the switch is on for the main user, this try reaches
+     * ten, and no admin wipe is already happening for it.
+     */
+    public static boolean shouldWipe(int failedAttempts, boolean adminWipes, boolean mainUser,
+            boolean on) {
+        return mainUser && on && !adminWipes && failedAttempts >= MAX_TRIES;
+    }
+}
