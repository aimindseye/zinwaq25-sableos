<?xml version="1.0" encoding="utf-8"?>
<!-- SableOS branding for the LineageOS SetupWizard (DESIGN-KF-B "Branding"):
     the welcome title and logo say SableOS. LineageOS-owned pages (LineageOS
     features, its privacy policy, Lineage Recovery) keep naming LineageOS. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.sableos.overlay.setupwizard">
    <overlay
        android:targetPackage="org.lineageos.setupwizard"
        android:isStatic="true"
        android:priority="20" />
    <application android:hasCode="false" />
</manifest>
