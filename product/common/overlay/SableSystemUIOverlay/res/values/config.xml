<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- SableQuickSettingsTiles.DEFAULT: high-value keyboard-phone controls
         first. The first four (Wi-Fi/mobile data, Bluetooth, dark theme, Do Not
         Disturb) are the compact shade row of sable-quick-settings-titan2.
         SubScreen and AOD tiles are profile-gated and never default; there is
         no keyboard light tile (the Q25 keyboard firmware ignores host writes;
         Settings > System > Keyboard explains its own keys). Users can still
         edit the set. -->
    <string name="quick_settings_tiles_default" translatable="false">
        internet,bt,dark,dnd,battery,flashlight,hotspot,location,airplane
    </string>
    <!-- Lock screen clock alignment (frameworks/base patch 0305). The owner's
         BlackBerry 10 lock screen puts the clock at the start edge, and the owner
         chose that on 2026-11-06: true moves the large clock to the start edge
         with sable_keyguard_clock_margin_start (Panther UI6A). -->
    <bool name="config_sableKeyguardClockStartAligned">true</bool>
</resources>
