<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- First-boot system palette (SystemUI ThemeOverlayController, flag
         hardware_color_styles): seed the Material palette from Sable Blue
         (SableAccentTokens.Blue.seed) instead of the wallpaper, so Quick
         Settings, Settings and SetupWizard start in the Sable accent. After
         setup the Settings > Display > Accent choice rewrites
         THEME_CUSTOMIZATION_OVERLAY_PACKAGES with the chosen preset. -->
    <string-array name="theming_defaults" translatable="false">
        <item>*|TONAL_SPOT|#2E9BD6</item>
    </string-array>
    <!-- Sable 2.0 type (UI direction 2026-11-04): Source Sans 3, the named family
         "source-sans" that packages/overlays/Lineage patch 0101 adds to fonts_customization.xml.
         Settings, SystemUI, SetupWizard and other apps that read these
         configs use it; anything else keeps the default sans-serif. -->
    <string name="config_headlineFontFamily" translatable="false">source-sans</string>
    <string name="config_headlineFontFamilyMedium" translatable="false">source-sans-medium</string>
    <string name="config_bodyFontFamily" translatable="false">source-sans</string>
    <string name="config_bodyFontFamilyMedium" translatable="false">source-sans-medium</string>
</resources>
