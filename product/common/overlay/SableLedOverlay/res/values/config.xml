<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Q25 LED, measured on the phone (2026-10-22): the "red" and "green"
         GPIO LEDs both light green and only blue lights blue, so red and
         amber cannot be shown. While charging, a green blink comes from
         board hardware that neither the UPM6922 charger (STAT off) nor the
         MT6366 current sinks (ISINK off) control, so Android cannot stop it.
         Sable therefore uses blue for notifications and low battery, keeps
         its own light off while charging (the hardware blink already says
         so) and shows solid green when full.

         BlackBerry-style notification LED (Q25 status LED: red, green and
         blue GPIO LEDs, on/off only; device tree config_deviceLightCapabilities
         587 = RGB notification + RGB battery + pulsating + battery LED + no
         brightness control). The device FrameworksResOverlayQ25 already sets
         config_intrusiveNotificationLed true, so the notification light and the
         per-channel "Blink light" switch are available.

         An unread notification blinks blue: a short flash, a long pause, only
         while the screen is off (LineageSettings NOTIFICATION_LIGHT_SCREEN_ON
         defaults off), until the user unlocks or clears it. NotificationRecord
         uses these on/off times for every channel light; LineageNotificationLights
         uses the color when the channel names none, and LineageParts
         (Settings > Notifications > Notification light) shows both as the
         default it can change. LineageOS 23.2 ships #ffffffff, 500 and 2000. -->
    <color name="config_defaultNotificationColor">#ff0000ff</color>
    <integer name="config_defaultNotificationLedOn">250</integer>
    <integer name="config_defaultNotificationLedOff">2750</integer>

    <!-- Battery light (LineageBatteryLights, lineage-sdk 0504): low battery
         not charging flashes blue; charging below 100 % is black (Android's
         light off, the hardware green blink shows); a completely charged
         battery on the charger is solid green
         (config_notificationsBatteryFullARGB, 0xFF00FF00) and stays on while
         plugged in (BATTERY_LIGHT_FULL_CHARGE_DISABLED defaults to 0). A lit
         notification shows over the battery light. LineageOS 23.2 ships
         0xFFFF0000 for low and 0xFFFFFF00 for medium. -->
    <integer name="config_notificationsBatteryLowARGB">0xFF0000FF</integer>
    <integer name="config_notificationsBatteryMediumARGB">0xFF000000</integer>
    <integer name="config_notificationsBatteryFullARGB">0xFF00FF00</integer>
</resources>
