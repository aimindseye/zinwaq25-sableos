<?xml version="1.0" encoding="utf-8"?>
<!-- Sable 2.0: Source Sans 3 (SIL OFL 1.1, LICENSE.md beside this file) as two named
     families. Installed to /product/etc, the fonts to /product/fonts
     (scripts/stage-product.sh). SableFrameworkOverlay points the headline and body
     font configs at them; Sable apps ask for "source-sans" by name and fall back to
     sans-serif when it is missing. -->
<fonts-modification version="1">
    <family customizationType="new-named-family" name="source-sans">
        <font weight="400" style="normal">SourceSans3-Regular.ttf</font>
        <font weight="400" style="italic">SourceSans3-It.ttf</font>
        <font weight="500" style="normal">SourceSans3-Medium.ttf</font>
        <font weight="600" style="normal">SourceSans3-Semibold.ttf</font>
        <font weight="700" style="normal">SourceSans3-Bold.ttf</font>
        <font weight="700" style="italic">SourceSans3-BoldIt.ttf</font>
    </family>
    <family customizationType="new-named-family" name="source-sans-medium">
        <font weight="500" style="normal">SourceSans3-Medium.ttf</font>
        <font weight="700" style="normal">SourceSans3-Bold.ttf</font>
    </family>
</fonts-modification>
