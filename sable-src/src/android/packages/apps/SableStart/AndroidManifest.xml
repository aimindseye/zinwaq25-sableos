<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.sableos.launcher"
    android:versionCode="91">

    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Hub page Contacts tab: names, favourites and one number per person, read on the
         device and never stored. Granted once at first boot on the Q25
         (product/q25/permissions/default-permissions-sable-q25.xml); revocable in Settings,
         and the tab then asks again. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- All Apps privacy row (DESIGN-KF-D): read each profile's own permission
         state, hear runtime-permission changes, and hand uninstall to the
         system uninstaller (which confirms again). SableLauncher is
         platform-signed, so the signature permissions are granted. -->
    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS" />
    <uses-permission android:name="android.permission.OBSERVE_GRANT_REVOKE_PERMISSIONS" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Private Space in All Apps: see the private profile and lock or unlock
         it (quiet mode). The system asks for the private space credential
         itself when unlocking. -->
    <uses-permission android:name="android.permission.ACCESS_HIDDEN_PROFILES" />
    <uses-permission android:name="android.permission.ACCESS_HIDDEN_PROFILES_FULL" />
    <uses-permission android:name="android.permission.MODIFY_QUIET_MODE" />

    <!-- Active Frames (BB10 Home): every app's recent tasks, their last
         picture, resuming and closing them, as Launcher3 Quickstep does for
         Recents. Signature permissions, granted because SableLauncher is
         platform-signed. -->
    <uses-permission android:name="android.permission.REAL_GET_TASKS" />
    <uses-permission android:name="android.permission.REORDER_TASKS" />
    <uses-permission android:name="android.permission.REMOVE_TASKS" />
    <uses-permission android:name="android.permission.START_TASKS_FROM_RECENTS" />
    <uses-permission android:name="android.permission.READ_FRAME_BUFFER" />
    <!-- Phone's speed dial: which letters are assigned, and asking Phone to call one. -->
    <uses-permission android:name="org.sableos.permission.SPEED_DIAL" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <provider android:authorities="org.sableos.appearance" />
        <provider android:authorities="org.sableos.weather.snapshot" />
        <provider android:authorities="org.sableos.calendar.snapshot" />
        <provider android:authorities="org.sableos.hub.snapshot" />
        <provider android:authorities="org.sableos.hub.connected_apps" />
        <provider android:authorities="org.sableos.mail.snapshot" />
        <provider android:authorities="org.sableos.media.snapshot" />
        <provider android:authorities="org.sableos.dialer.speeddial" />
        <!-- The Hub page's Messages card and Contacts tab Message action. -->
        <package android:name="org.sableos.messages" />
    </queries>

    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SableLauncher">

        <activity
            android:name="org.sableos.start.SableStartActivity"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true">

            <intent-filter android:priority="10">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- Settings > Sable > Quick bar: opens Edit Home (Home apps and quick bar). -->
            <intent-filter>
                <action android:name="org.sableos.start.action.EDIT_QUICK_BAR" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- Settings > Sable Start > Home layout: opens Edit Home. -->
            <intent-filter>
                <action android:name="org.sableos.start.action.EDIT_HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- The Recents key and button (Launcher3QuickStep, setPackage org.sableos.launcher):
                 Active Frames instead of Android's overview. -->
            <intent-filter>
                <action android:name="org.sableos.start.action.SHOW_ACTIVE_FRAMES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- The one Hub: Start's Hub page (All · Messages · Calls · Contacts), optionally on
                 a tab (extra org.sableos.start.extra.HUB_FILTER). Sable Hub has no launcher entry. -->
            <intent-filter>
                <action android:name="org.sableos.start.action.SHOW_HUB" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Home screen style (BlackBerry 10 or BlackBerry 7), opened by Sable Setup and Start's menu. -->
        <activity
            android:name="org.sableos.start.HomeStyleActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="Home screen style">
            <intent-filter>
                <action android:name="org.sableos.start.action.CHOOSE_HOME_STYLE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
