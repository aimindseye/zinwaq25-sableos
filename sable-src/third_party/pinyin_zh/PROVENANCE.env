# Provenance for apps/titan2/platform/keyboard/src/main/assets/pinyin_zh.tsv  (D3 clean-corpus regeneration)
# Machine-readable; consumed by tools/gen_pinyin_dict.py, tools/gen_pinyin_license_bundle.py and
# build/titan2/qualify-c3b-product-source.sh. Replaces the earlier mixed-provenance corpus, which was REJECTED
# for shipment (history: docs/C3B_PRODUCT_KNOWN_LIMITATIONS.md, KL-027).
#
# Only the two inputs below may influence a shipped row. The generator is offline and deterministic:
#   python3 tools/gen_pinyin_dict.py apps/titan2/platform/keyboard/src/main/assets/pinyin_zh.tsv
#   python3 tools/gen_pinyin_license_bundle.py <NOTICE out> <LICENSES out>
# This records engineering provenance. It is not a general legal opinion or blanket legal clearance.

PINYIN_CORPUS_POLICY=CLEAR_REDISTRIBUTION_INPUTS_ONLY
PINYIN_CORPUS_SOURCE_COUNT=2
PINYIN_UNVERIFIED_SOURCE_COUNT=0
PINYIN_LICENSE_REVIEW=CLOSED_REGENERATED_FROM_APPROVED_INPUTS
PINYIN_GENERATED_CORPUS_LICENSE=CC-BY-SA-4.0_DERIVED
PINYIN_GENERATOR=tools/gen_pinyin_dict.py
PINYIN_GENERATOR_NETWORK_ACCESS=FORBIDDEN
NUMERIC_WEIGHT_IS_CORPUS_FREQUENCY=NO
RANKING_ALGORITHM=DETERMINISTIC
RANKING_RULE=weight 30 for a Unihan kTGHZ2013 reading, 20 for a Unihan kMandarin reading, 10 for a CC-CEDICT entry; highest weight wins per (pinyin,word); order by pinyin, weight descending, word code points ascending

# ---- Input A: CC-CEDICT snapshot (CC-BY-SA-4.0). The download URL is mutable, so the exact bytes are vendored.
CC_CEDICT_SOURCE=https://www.mdbg.net/chinese/export/cedict/cedict_1_0_ts_utf-8_mdbg.zip
CC_CEDICT_PROJECT=https://cc-cedict.org/
CC_CEDICT_SNAPSHOT=date=2026-10-01T23:26:37Z entries=125166 publisher=MDBG format=ts charset=UTF-8
CC_CEDICT_ARTIFACT=cedict_1_0_ts_utf-8_mdbg.zip
CC_CEDICT_ARTIFACT_PATH=third_party/pinyin_zh/inputs/cedict_1_0_ts_utf-8_mdbg.zip
CC_CEDICT_ZIP_SHA256=5a5ea3da98372bfba8f751b82f4fab62911dfb4c43d65b01ea95146e69b35d87
CC_CEDICT_MEMBER=cedict_ts.u8
CC_CEDICT_MEMBER_SHA256=e7e880a64c235f8f63023ef97839e63262891416d2571e6af2a9b8e507948323
CC_CEDICT_LICENSE=CC-BY-SA-4.0
CC_CEDICT_LICENSE_FILE=third_party/pinyin_zh/licenses/LICENSE.CC-BY-SA-4.0.txt
CC_CEDICT_LICENSE_SHA256=cde7883b9050a1104f4ac19a1572aafd6e5d7323b68351aaf51fbf4beba54966
CC_CEDICT_ACQUISITION=OPERATOR_SUPPLIED_ATTACHMENT
CC_CEDICT_OFFICIAL_ORIGIN_VERIFIED=PENDING_OPERATOR_HASH_COMPARISON

# ---- Input B: official numbered Unicode Unihan release (Unicode-3.0)
UNIHAN_VERSION=18.0.0
UNIHAN_SOURCE=https://www.unicode.org/Public/18.0.0/ucd/Unihan.zip
UNIHAN_ARTIFACT=Unihan.zip
UNIHAN_ARTIFACT_PATH=third_party/pinyin_zh/inputs/Unihan.zip
UNIHAN_ZIP_SHA256=4c93ea9c1f636451729a840978f1667a53886af37ba854fdcce109721c63d43e
UNIHAN_READINGS_PATH=Unihan_Readings.txt
UNIHAN_READINGS_SHA256=9d39995b5de714e8ce93716ed5d15eaa0792d68e407cdf8a0add2893b8f4150b
UNIHAN_READINGS_HEADER=Date: 2026-07-31 00:00:00 GMT [KL]; Unicode Version 18.0.0; (c) 2026 Unicode, Inc.
UNIHAN_ADMITTED_PROPERTIES=kMandarin,kTGHZ2013
UNIHAN_LICENSE=Unicode-3.0
UNIHAN_LICENSE_FILE=third_party/pinyin_zh/licenses/LICENSE.Unicode-3.0.txt
UNIHAN_LICENSE_SHA256=f7db81051789b729fea528a63ec4c938fdcb93d9d61d97dc8cc2e9df6d47f2a1
UNIHAN_ACQUISITION=OPERATOR_SUPPLIED_ATTACHMENT
UNIHAN_OFFICIAL_ORIGIN_VERIFIED=PENDING_OPERATOR_HASH_COMPARISON

# ---- Licence text provenance
# Verbatim SPDX texts (spdx/license-list-data 31ba1a50e5397e00a304dbadc76531740e89ee48), cross-checked by the
# product owner's attached OSI (Unicode-3.0) and Creative Commons (CC BY-SA 4.0 legal code) pages.
LICENSE_TEXT_SOURCE=spdx/license-list-data@31ba1a50e5397e00a304dbadc76531740e89ee48

# ---- Output pin (the previous corpus values are retired and are not acceptance values)
PINYIN_OUTPUT_ASSET=apps/titan2/platform/keyboard/src/main/assets/pinyin_zh.tsv
PINYIN_OUTPUT_ENTRIES=130552
PINYIN_OUTPUT_BYTES=2566376
PINYIN_OUTPUT_SHA256=ec19b68b6a281106078420332d4465f9affabe9d6c066c0a4028c9cec162696f
PINYIN_SIZE_MAX_ENTRIES=157000
PINYIN_SIZE_MAX_BYTES=3300000

# ---- Size bound (gated). Derived from the accepted corpus above: about +20% headroom on entries and +25% on bytes,
# rounded up. Entries and bytes drive IME-service heap (three parallel arrays) and the one-time background parse
# cost. A larger regeneration must be a deliberate, reviewed change to this file, not silent growth.
