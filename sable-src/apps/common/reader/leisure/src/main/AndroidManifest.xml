<?xml version="1.0" encoding="utf-8"?>
<!--
  Sable Reader product manifest.

  Privacy boundary (P5 v2.0): no INTERNET, ACCESS_NETWORK_STATE or CAMERA permission, ever. The final merged manifest
  is inspected by build/titan2/qualify-p5-reader.sh. Plain-text, OCR and share/process-text intents
  belong to Sable Text Reader and must not appear here.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools">

    <!-- Library tooling and dependencies must never reintroduce network or camera access. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <!--
      Lint suppression (scoped to this one element): PermissionImpliesUnsupportedChromeOsHardware fires for CAMERA
      because declaring it implies camera hardware. Here the element only REMOVES CAMERA from the merged manifest, so
      no hardware is implied and the warning does not apply.
    -->
    <uses-permission
            android:name="android.permission.CAMERA"
            tools:node="remove"
            tools:ignore="PermissionImpliesUnsupportedChromeOsHardware" />

    <!--
      Audiobook playback (P5D): a foreground media service, its notification, and a partial wake lock so playback
      continues with the screen off. Nothing here reaches the network. The list is pinned by the static gate.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- SableOS global appearance authority (Light/Dark/accent). -->
        <provider android:authorities="org.sableos.appearance" />
    </queries>

    <application
            android:name="org.vaachak.reader.leisure.SableReaderApplication"
            android:allowBackup="false"
            android:fullBackupContent="@xml/backup_rules"
            android:dataExtractionRules="@xml/data_extraction_rules"
            android:icon="@drawable/ic_sable_reader"
            android:roundIcon="@drawable/ic_sable_reader"
            android:label="@string/app_name"
            android:supportsRtl="true"
            android:usesCleartextTraffic="false"
            android:theme="@style/Theme.SableReader"
            tools:targetApi="31">

        <activity
                android:name="org.vaachak.reader.leisure.MainActivity"
                android:exported="true"
                android:hardwareAccelerated="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Lint suppression (scoped to each VIEW filter below): AppLinkUrlError checks http(s) App Link URLs. These
              filters open local documents only (content:/file: schemes plus a mime type or file suffix); there is no
              http/https scheme and no host, so the App Link rule does not apply.
            -->
            <intent-filter tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/epub+zip" />
                <data android:scheme="content" />
                <data android:scheme="file" />
            </intent-filter>

            <intent-filter tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:pathPattern=".*\\.epub" />
                <data android:pathPattern=".*\\..*\\.epub" />
            </intent-filter>

            <intent-filter tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
                <data android:scheme="content" />
                <data android:scheme="file" />
            </intent-filter>

            <intent-filter tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.comicbook+zip" />
                <data android:mimeType="application/x-cbz" />
                <data android:scheme="content" />
                <data android:scheme="file" />
            </intent-filter>

            <intent-filter tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:pathPattern=".*\\.cbz" />
                <data android:pathPattern=".*\\..*\\.cbz" />
            </intent-filter>

        </activity>

        <!--
          Local audiobook playback. Exported, because a MediaLibraryService is bound by media controllers outside this
          process (notification, lock screen, Bluetooth, system UI). Access is gated in
          AudioSessionCallback.onConnect: only this app and system-trusted controllers are accepted, every other
          controller is rejected. foregroundServiceType=mediaPlayback is required with
          FOREGROUND_SERVICE_MEDIA_PLAYBACK on Android 14+.
        -->
        <service
                android:name="org.sableos.reader.audio.AudiobookPlaybackService"
                android:exported="true"
                android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
            </intent-filter>
        </service>

    </application>

</manifest>
