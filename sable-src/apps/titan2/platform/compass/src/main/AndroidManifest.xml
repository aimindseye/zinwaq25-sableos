<?xml version="1.0" encoding="utf-8"?>
<!-- Sable Compass: the heading from the phone's own sensors, on a dial that tilts with the phone. True north
     is off until the user turns it on; then, and only then, it asks for a rough (coarse) location to correct
     for magnetic declination, computed on the phone. No internet, no backup. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.compass" android:required="false" />

    <!-- Only for true north, asked when the user turns it on. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <queries>
        <!-- The Sable appearance authority (Settings): the accent colour every Sable app uses. -->
        <provider android:authorities="org.sableos.appearance" />
    </queries>

    <application
        android:name="org.sableos.titan2.compass.CompassApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_sable_compass"
        android:roundIcon="@mipmap/ic_sable_compass_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".android.CompassActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|smallestScreenSize|screenLayout|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
