<?xml version="1.0" encoding="utf-8"?>
<!-- Secure Vault: the file layer of Private Space. Installed only in the private profile
     (product/q25/sysconfig/preinstalled-packages-sable-vault.xml). No network, no storage or media
     permissions, no backup: files live in this app's credential-encrypted storage in the private
     profile and lock with it. Import and export go through the system document picker the user drives;
     "Open" grants one file, read-only, to an app the user picks. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Lock now: quiet mode for this (private) profile. Privileged; allowlisted in
         product/q25/permissions/privapp-permissions-sable-q25.xml. -->
    <uses-permission android:name="android.permission.MODIFY_QUIET_MODE" tools:ignore="ProtectedPermissions" />

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <queries>
        <!-- The Sable appearance authority (Settings): the accent colour every Sable app uses. -->
        <provider android:authorities="org.sableos.appearance" />
    </queries>

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_sable_vault"
        android:roundIcon="@mipmap/ic_sable_vault_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".android.VaultActivity"
            android:exported="true"
            android:excludeFromRecents="false"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|smallestScreenSize|screenLayout|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="org.sableos.titan2.vault.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/vault_paths" />
        </provider>
    </application>
</manifest>
