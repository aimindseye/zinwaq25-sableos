<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No permissions. directBootAware so the keyboard works at the lockscreen before first unlock. -->
    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_sable_keyboard"
        android:roundIcon="@drawable/ic_sable_keyboard"
        android:directBootAware="true"
        android:label="@string/app_name"
        android:supportsRtl="true">

        <service
            android:name=".android.SableImeService"
            android:directBootAware="true"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/method" />
        </service>

        <activity
            android:name=".android.KeyboardSettingsActivity"
            android:directBootAware="true"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Diagnostic: shows the key events an ordinary app receives. -->
        <activity
            android:name=".android.KeyProbeActivity"
            android:exported="true"
            android:label="Sable Key Probe">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
