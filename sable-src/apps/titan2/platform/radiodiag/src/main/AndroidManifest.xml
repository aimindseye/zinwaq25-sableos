<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Read-only. READ_BASIC_PHONE_STATE is a normal permission (no runtime prompt) covering network type and data state. -->
    <uses-permission android:name="android.permission.READ_BASIC_PHONE_STATE" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <queries>
        <package android:name="com.android.phone" />
        <package android:name="com.android.server.telecom" />
        <package android:name="com.android.providers.telephony" />
        <package android:name="com.android.carrierconfig" />
        <package android:name="com.android.cellbroadcastreceiver" />
        <package android:name="com.android.stk" />
        <package android:name="com.android.mms.service" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_sable_radiodiag"
        android:roundIcon="@drawable/ic_sable_radiodiag"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name=".android.RadioActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
