<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Sable Tools (DESIGN-KF-C). Read-only by default: no INTERNET, no services, no shared UID, no
      accessibility service, no settings-write permission. core/PrivilegePolicy.kt is checked against this file
      by a unit test.
      Runtime permissions below are requested only when the user opens the tool that needs them
      (PERMISSION_REQUEST_AT_FEATURE_USE=YES): camera = Magnifier, microphone = Noise meter,
      location = Speedometer, activity recognition = Pedometer step counter.
      TRANSMIT_IR, READ_BASIC_PHONE_STATE, ACCESS_NETWORK_STATE and VIBRATE (attention test) are normal (install-time) permissions.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.TRANSMIT_IR" />
    <uses-permission android:name="android.permission.READ_BASIC_PHONE_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Nothing is required: capability gating hides what the device lacks. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.consumerir" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.compass" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.stepcounter" android:required="false" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <queries>
        <!-- Telephony packages the radio diagnostics report on (carried over from Sable Radio Diag). -->
        <package android:name="com.android.phone" />
        <package android:name="com.android.server.telecom" />
        <package android:name="com.android.providers.telephony" />
        <package android:name="com.android.carrierconfig" />
        <package android:name="com.android.cellbroadcastreceiver" />
        <package android:name="com.android.stk" />
        <package android:name="com.android.mms.service" />
        <!-- Hand-off owners: FM radio (Sable Media), app display profiles (DisplayCompat). -->
        <package android:name="org.sableos.media" />
        <package android:name="org.sableos.titan2.displaycompat" />
        <!-- Installed-app summary uses launcher-visible apps only, never QUERY_ALL_PACKAGES. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- To see whether a vendor factory-test app already answers the dialer code. -->
        <intent>
            <action android:name="android.telephony.action.SECRET_CODE" />
            <data android:scheme="android_secret_code" android:host="3377" />
        </intent>
        <intent>
            <action android:name="org.sableos.media.action.FM_RADIO" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_sable_tools"
        android:roundIcon="@mipmap/ic_sable_tools_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|smallestScreenSize|screenLayout"
            android:windowSoftInputMode="stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          One tool. Other Sable surfaces (Settings > Diagnostics, Sable Command, Sable Start pins) open a tool with
          org.sableos.tools.action.OPEN_TOOL + extra org.sableos.tools.extra.TOOL (a core Tool name), or resolve a
          query (friendly name or dialer code) with org.sableos.tools.action.SEARCH + extra
          org.sableos.tools.extra.QUERY. Everything it opens is read-only; gating is re-checked on arrival.
        -->
        <activity
            android:name=".ui.ToolActivity"
            android:exported="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|smallestScreenSize|screenLayout"
            android:windowSoftInputMode="stateHidden|adjustResize">
            <intent-filter>
                <action android:name="org.sableos.tools.action.OPEN_TOOL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="org.sableos.tools.action.SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          *#*#3377#*#* bridge. Disabled by default; the app enables it only when no vendor factory-test app answers
          the code (core/DialerCodes.receiverEnabled), so it never doubles up with a vendor surface.
        -->
        <receiver
            android:name=".android.SecretCodeReceiver"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telephony.action.SECRET_CODE" />
                <data android:scheme="android_secret_code" android:host="3377" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
