<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <queries>
        <provider android:authorities="org.sableos.appearance" />
        <!-- Start reads the snapshot; getPackagesForUid only names packages this app can see. -->
        <package android:name="org.sableos.launcher" />
        <!-- FM mode: the SableOS FM bridge in the LineageOS FM Radio app. -->
        <intent>
            <action android:name="org.sableos.fm.action.CONTROL" />
        </intent>
    </queries>

    <application
        android:name="org.sableos.media.MediaApplication"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_sable_media"
        android:roundIcon="@mipmap/ic_sable_media_round"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- FM mode, opened by Sable Tools and the FM playing notification. -->
            <intent-filter>
                <action android:name="org.sableos.media.action.FM_RADIO" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <provider
            android:name=".MediaSnapshotProvider"
            android:authorities="org.sableos.media.snapshot"
            android:exported="true"
            android:grantUriPermissions="false" />

        <service
            android:name=".PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>
</manifest>
